#include "../../workspaces"

// Scratch probe for the delete ordering: when the registry persistence fails,
// the workspace must stay in the live registry (and in the store), not vanish
// from memory while a stale record remains on disk.

passed = 0;
failed = 0;

check(name, cond) {
    if(cond) {
        passed++;
        std.print("PASS " + name);
    } else {
        failed++;
        std.print("FAIL " + name);
    }
}

root = __DIR__ + "/out/registry";
if(fileio.exists(root)) {
    for(f : fileio.files(root, true))
        try { fileio.remove(root + "/" + f); } catch(e) {}
    try { fileio.remove(root); } catch(e) {}
}

store = WorkspaceStore(root);
res = store.create("Ordering", "", "root", "delete ordering probe");
check("workspace created", std.is_json(res) && res.ok);

w = res.workspace;
manager = SessionManager(store, "", "");

ctx = WorkspaceRegistry("", "");
ctx.store = store;
ctx.manager = manager;
ctx.workspaces = [];
ctx.ensure(w);

// Make the registry write fail: the registry path becomes a directory.
try { fileio.remove(store.registry_path); } catch(e) {}
fileio.mkdir(store.registry_path);

del = ctx.delete(w.id);

check("delete reports persistence failure", std.is_json(del) && !del.ok);
check("workspace remains in the live registry", !std.is_none(ctx.get(w.id)));
check("workspace remains in the store", !std.is_none(store.get(w.id)));

std.print(std.string(passed) + " passed, " + std.string(failed) + " failed");
if(failed)
    std.exitprocess(1);
std.print("PASSED");
