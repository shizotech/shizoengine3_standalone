#include "../../megamind"

// Scratch probe for the legacy Megamind update path: a planned task must accept
// more than one update. Before the sweep fix the second update was swallowed by
// the nested `if(!user_updates)` block.

passed = 0;
failed = 0;

check(name, cond) {
    if(cond) {
        passed++;
        std.print("PASS " + name);
    } else {
        failed++;
        std.print("FAIL " + name);
    }
}

class StubWorker {
    model_config = [max_running_agents = 0];
    stopped = false;
    running = false;
    env = [signal_report = "", signal_event = ""];
    task_result = None;
    on_action = None;
    _slot_held = false;
    _slot_lent = false;

    should_stop() { return stopped; }
    clear_chat() {}
    set_reasoning_effort(e) {}
    stop() { stopped = true; }
    task_update(p) {
        if(!running)
            return None;
        stop();
        return None;
    }

    task(prompt, continue_task = false) {
        stopped = false;
        running = true;
        task_result = None;
        env.signal_report = "";
        env.signal_event = "";

        if(prompt.starts("# Instruction")) {
            task_result = [signal = "finished", result = "research done", from_tool = json.bool(true)];
        } else {
            task_result = [signal = "finished", result = "done: " + prompt.substr(0, 160), from_tool = json.bool(true)];
        }

        env.signal_report = std.string(task_result.result ?? "");
        env.signal_event = std.string(task_result.signal ?? "");
        running = false;
        return task_result;
    }
}

class StubReceptionist {
    model_config = [max_running_agents = 0];
    stopped = false;
    running = false;
    env = [signal_report = "", signal_event = ""];
    task_result = None;
    on_action = None;

    should_stop() { return stopped; }
    clear_chat() {}
    set_reasoning_effort(e) {}
    stop() { stopped = true; }
    task_update(p) { return None; }

    task(prompt, continue_task = false) {
        stopped = false;
        running = true;
        task_result = [signal = "finished", result = "stub turn", from_tool = json.bool(true)];
        env.signal_report = std.string(task_result.result ?? "");
        env.signal_event = std.string(task_result.signal ?? "");
        running = false;
        return task_result;
    }
}

class TestMind : Megamind {
    create_receptionist(cfg) { return StubReceptionist(); }
    create_worker(cfg, role = "adaptive") { return StubWorker(); }
}

cfg = ModelConfig();
mind = TestMind(cfg, cfg, 1);
mind.running = false;

id = mind.add_task("Repeated", "quick work");

ok1 = mind.update_task(id, "first update");
ok2 = mind.update_task(id, "second update");

check("first update accepted", ok1);
check("second update accepted", ok2);
check("both updates are stored on the planned task",
    std.is_json(mind.tasks_scheduled) && mind.tasks_scheduled.size() == 1 &&
    std.is_json(mind.tasks_scheduled[0].user_updates) &&
    mind.tasks_scheduled[0].user_updates.size() == 2);

std.print(std.string(passed) + " passed, " + std.string(failed) + " failed");
if(failed)
    std.exitprocess(1);
std.print("PASSED");
