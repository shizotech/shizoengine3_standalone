#include "../../miniagent"

stub_llm(agt, tag) {
	agt.llm_api = [
		tag = tag,
		stops = 0,
		runs = 0,
		prompts = [],
		stop = [agt]() { agt.llm_api.stops++; std.print("[", agt.llm_api.tag, "] STOP\n"); },
		task = [agt](prompt) {
			agt.llm_api.runs++;
			agt.llm_api.prompts.push_back(prompt);
			std.print("[", agt.llm_api.tag, "] TASK #", agt.llm_api.runs, " prompt=", std.string(prompt).substr(0, 40), "\n");
			return "stubbed answer";
		},
		add_tool = [](a, b, c, d) { },
	];
}

cfg = ModelConfig();
root = miniagent(cfg, "adaptive");
stub_llm(root, "root");

b = root.subagent("single_action/explorer");
stub_llm(b, "b");
std.print("registered children: ", root._child_agents.size(), "\n");
std.print("before task: runs=", b.llm_api.runs, "\n");
res = b.task("continue it");
std.print("after task: runs=", b.llm_api.runs, " prompts=", std.string(b.llm_api.prompts), "\n");
std.print("DONE\n");
