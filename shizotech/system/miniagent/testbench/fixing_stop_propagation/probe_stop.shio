// probe: how far does miniagent.stop() actually reach?
#include "../../miniagent"

stub_llm(agt, tag) {
	agt.llm_api = [
		tag = tag,
		stops = 0,
		runs = 0,
		stop = [agt]() { agt.llm_api.stops++; },
		task = [agt](prompt) { agt.llm_api.runs++; return "stubbed answer"; },
		add_tool = [](a, b, c, d) { },
	];
}

cfg = ModelConfig();

root = miniagent(cfg, "adaptive");
stub_llm(root, "root");

std.print("children after construction: ", root._child_agents.size(), "\n");

a = root.subagent("single_action/explorer");
stub_llm(a, "a");
std.print("after a: ", root._child_agents.size(), "\n");

b = root.subagent("single_action/explorer");
stub_llm(b, "b");
ga = a.subagent("single_action/explorer");
stub_llm(ga, "ga");
std.print("after b (a has a grandchild): ", root._child_agents.size(), "\n");

c = root.subagent("single_action/explorer");
stub_llm(c, "c");
std.print("after c: ", root._child_agents.size(), "\n");

root.stop();

std.print("stops: root=", root.llm_api.stops,
	" a=", a.llm_api.stops,
	" b=", b.llm_api.stops,
	" c=", c.llm_api.stops,
	" ga=", ga.llm_api.stops, "\n");

std.print("should_stop: root=", root.should_stop(),
	" a=", a.should_stop(),
	" b=", b.should_stop(),
	" c=", c.should_stop(), "\n");

// A child created while the parent is already stopped:
d = root.subagent("single_action/explorer");
stub_llm(d, "d");
res = d.task("do it");
std.print("late child: stopped=", d.stopped, " runs=", d.llm_api.runs, " res=", std.string(res), "\n");

// A child that is continued after the parent was stopped:
res2 = b.task("continue it");
std.print("resumed child: runs=", b.llm_api.runs, " res=", std.string(res2), "\n");

std.print("DONE\n");
