#include "../../workspaces"

// Current-behaviour probe: create, delete, reload, check initialisation.
tmp = fileio.absolute_path(std.user_path() + "/miniagent/ws_probe_" + std.random_hash(8));
if(fileio.exists(tmp))
    fileio.remove(tmp);

store = WorkspaceStore(tmp);
res = store.create("probe", "", "");
id = res.workspace.id;
path = res.workspace.path;

std.print("created " + id + " " + path);
std.print("agentspace before delete: " + std.string(fileio.is_directory(path + "/.agentspace")));

del = store.delete(id);
std.print("delete ok: " + std.string(del.ok));

// A deleted workspace's files stay on disk; remove .agentspace to detect a re-init.
if(fileio.exists(path + "/.agentspace"))
    fileio.remove(path + "/.agentspace");

store2 = WorkspaceStore(tmp);
std.print("reloaded contains id: " + std.string(!std.is_none(store2.get(id))));
std.print("agentspace recreated: " + std.string(fileio.is_directory(path + "/.agentspace")));
std.print("reloaded list size: " + std.string(store2.list().size()));

if(fileio.exists(tmp))
    fileio.remove(tmp);
