#include "../../workspaces"

path = fileio.absolute_path(__DIR__ + "/initdir");
store = WorkspaceStore();
w = store.find_by_path(path);

if(std.is_none(w)) {
    std.print("initdir is not registered");
} else {
    res = store.delete(w.id);
    std.print("cleanup initdir: " + std.string(res.ok) + " " + std.string(res.error ?? ""));
}
