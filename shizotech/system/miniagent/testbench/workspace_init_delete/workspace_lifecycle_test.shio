#include "../../workspaces"

passed = 0;
failed = 0;

check(cond, label) {
    if(cond) {
        passed++;
        std.print("ok " + label);
    } else {
        failed++;
        std.print("FAIL " + label);
    }
}

tmp = fileio.absolute_path(std.user_path() + "/miniagent/ws_lifecycle_" + std.random_hash(8));
if(fileio.exists(tmp))
    fileio.remove(tmp);

store = WorkspaceStore(tmp);

// --init mechanics: create a workspace with an explicit cwd path under root.
res = store.create("alpha", "", "");
check(res.ok && fileio.is_directory(res.workspace.path), "workspace create returns an existing directory");
id = res.workspace.id;
path = res.workspace.path;

check(fileio.is_directory(path + "/.megamind"), "new workspace has .megamind");
check(fileio.is_directory(path + "/.agentspace"), "new workspace has .agentspace");
check(fileio.exists(path + "/AGENTS.md"), "new workspace gets AGENTS.md");

agents_text = fileio.read_string(path + "/AGENTS.md");
check(agents_text.contains("Miniagent workspace") && agents_text.contains(".megamind/"), "AGENTS.md is a short useful project-agent note");

// A project's own AGENTS.md must win.
fileio.write_text(path + "/AGENTS.md", "custom project note\n");
ensure_agents_md(path);
check(fileio.read_string(path + "/AGENTS.md") == "custom project note\n", "ensure_agents_md does not overwrite an existing AGENTS.md");

// Reload keeps the registered workspace and its AGENTS.md.
reloaded = WorkspaceStore(tmp);
check(!std.is_none(reloaded.get(id)) && fileio.exists(path + "/AGENTS.md"), "reload keeps the registered workspace");

// --init reuses an already registered cwd instead of creating a duplicate.
reuse = store.create("alpha-again", path, "", "");
check(reuse.ok && reuse.reused && reuse.workspace.id == id, "already-registered cwd is reused");

// Delete must be durable, not only in memory.
del = store.delete(id);
check(del.ok, "workspace delete succeeds");
check(std.is_none(store.get(id)), "workspace is removed from the live store");

registry = fileio.read_json(tmp + "/workspaces.json", true);
found_in_file = false;
for(w : registry.workspaces) {
    if(w.id == id)
        found_in_file = true;
}
check(!found_in_file, "deleted workspace is absent from workspaces.json");

// The project files stay, but a deleted workspace must not be initialized again.
if(fileio.exists(path + "/.agentspace"))
    fileio.remove(path + "/.agentspace");

reloaded2 = WorkspaceStore(tmp);
check(std.is_none(reloaded2.get(id)), "reload does not restore the deleted registry entry");
check(!fileio.is_directory(path + "/.agentspace"), "reload does not recreate the deleted workspace's .agentspace");

// No scheduler is constructed for the deleted workspace.
reg = WorkspaceRegistry("", "");
reg.stop();
reg.store = reloaded2;
reg.manager = SessionManager(reloaded2, "", "");
reg.workspaces = [];
for(rec : reloaded2.list())
    reg.ensure(rec);
reg.start_all_schedulers();
check(std.is_none(reg.get(id)), "deleted workspace has no scheduler in the registry");
reg.stop();

if(fileio.exists(tmp))
    fileio.remove(tmp);

std.print("workspace_lifecycle_test: " + std.string(passed) + " passed, " + std.string(failed) + " failed");

if(failed)
    std.print("FAIL");

if(failed)
    std.exitprocess(1);

std.print("PASSED");
std.exitprocess(0);
