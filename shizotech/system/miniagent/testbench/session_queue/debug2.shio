#include "workspaces"

class FakeSessionManager : SessionManager {
    spawn_status = "waiting";
    spawn(sid) {
        sessions[sid].status = spawn_status;
        return true;
    }
}

root = std.user_path() + "/miniagent/session_queue_debug2_" + std.random_hash(10);
root = fileio.absolute_path(root);
if(fileio.exists(root)) fileio.remove(root);
store = WorkspaceStore(root);
store.set_settings(1);
ws = store.create("debug2", "", "");
manager = FakeSessionManager(store, "");
first = manager.create_session(ws.workspace.id, "first", "normal", "p1", "adaptive", "medium", "web");
second = manager.create_session(ws.workspace.id, "second", "normal", "p2", "adaptive", "medium", "web");
std.print("sessions before=" + manager.sessions.compact_string());
res = manager.delete_session(second.session.id);
std.print("delete ok=" + std.string(res.ok));
std.print("sessions after=" + manager.sessions.compact_string());
st = manager.stats();
std.print("stats=" + st.compact_string());
if(fileio.exists(root)) fileio.remove(root);
std.exitprocess(0);
