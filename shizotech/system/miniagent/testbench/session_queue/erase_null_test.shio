j = [];
j["a"] = [x = 1];
j["b"] = [x = 2];
j.erase("a");
std.print("after compact=" + j.compact_string() + " size=" + std.string(j.size()) + " has a=" + std.string(j.has("a")));
j["c"] = None;
std.print("with null compact=" + j.compact_string() + " size=" + std.string(j.size()) + " has c=" + std.string(j.has("c")));
std.exitprocess(0);
