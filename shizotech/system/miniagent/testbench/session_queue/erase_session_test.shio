s = [];
s["a"] = [id = "a", status = "queued"];
s["b"] = [id = "b", status = "running"];
std.print("before=" + s.compact_string() + " size=" + std.string(s.size()));
s.erase("a");
std.print("after=" + s.compact_string() + " size=" + std.string(s.size()));
m = std.json();
for(k, v : s) m[k] = v.status;
std.print("map=" + m.compact_string());
std.exitprocess(0);
