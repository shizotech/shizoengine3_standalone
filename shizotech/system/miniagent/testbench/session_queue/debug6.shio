#include "workspaces"

class FakeSessionManager : SessionManager {
    spawn_status = "waiting";
    spawn_count = 0;
    spawn(sid) {
        spawn_count++;
        sessions[sid].status = spawn_status;
        return true;
    }
}

root = std.user_path() + "/miniagent/session_queue_debug6_" + std.random_hash(10);
root = fileio.absolute_path(root);
if(fileio.exists(root)) fileio.remove(root);
store = WorkspaceStore(root);
store.set_settings(1);
ws = store.create("debug6", "", "");
config_path = ws.workspace.path + "/config.json";
fileio.write_json(config_path, [url = "", token = "", name = "", max_tokens = 128000, max_running_agents = 0], true, true);
manager = FakeSessionManager(store, config_path);

first = manager.create_session(ws.workspace.id, "first", "normal", "p1", "adaptive", "medium", "web");
second = manager.create_session(ws.workspace.id, "second", "normal", "p2", "adaptive", "medium", "web");
third = manager.create_session(ws.workspace.id, "third", "normal", "p3", "adaptive", "medium", "web");
std.print("before delete: first=" + manager.get_session(first.session.id).status + " second=" + manager.get_session(second.session.id).status + " third=" + manager.get_session(third.session.id).status);
st = manager.stats();
std.print("before stats: active=" + std.string(st.active_sessions) + " queued=" + std.string(st.queued_sessions) + " total=" + std.string(st.total_sessions) + " status=" + st.session_status.compact_string());
deleted_queued = manager.delete_session(second.session.id);
std.print("delete ok=" + std.string(deleted_queued.ok));
std.print("sessions after=" + manager.sessions.compact_string());
std.print("after delete: first=" + manager.get_session(first.session.id).status + " second=" + (std.is_none(manager.get_session(second.session.id)) ? "none" : manager.get_session(second.session.id).status) + " third=" + manager.get_session(third.session.id).status);
st = manager.stats();
std.print("after stats: active=" + std.string(st.active_sessions) + " queued=" + std.string(st.queued_sessions) + " total=" + std.string(st.total_sessions) + " status=" + st.session_status.compact_string());
manager.stop_session(first.session.id);
std.print("after stop first: third=" + manager.get_session(third.session.id).status);
st = manager.stats();
std.print("final stats: active=" + std.string(st.active_sessions) + " queued=" + std.string(st.queued_sessions) + " total=" + std.string(st.total_sessions));
if(fileio.exists(root)) fileio.remove(root);
std.exitprocess(0);
