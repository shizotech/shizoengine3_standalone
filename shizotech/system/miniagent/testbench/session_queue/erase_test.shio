j = [];
j["a"] = 1;
j["b"] = 2;
std.print("size before=" + std.string(j.size()) + " " + j.compact_string());
j.erase("a");
std.print("size after erase=" + std.string(j.size()) + " " + j.compact_string() + " has a=" + std.string(j.has("a")));
j.remove("b");
std.print("size after remove=" + std.string(j.size()) + " " + j.compact_string());
std.exitprocess(0);
