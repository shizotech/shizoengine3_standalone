// Scratch verification: the receptionist's read tools answer from the workspace
// root, not from the process cwd.
#include "../../miniagent"
#include "../../telegram_client"

cfg = ModelConfig();

ws = __DIR__ + "/out/workspace";
fileio.mkdir(ws);
fileio.write_text(ws + "/answer.md", "hello workspace\n");

owner = [
    workspace = [path = ws],
    client = [tg_current_chat = None],
];

recv = ClientReceptionist(cfg, owner);

fs = recv.agent.filesystem;
rf = recv.agent.llm_api.tools.tool_callbacks["read_file"]([path = "answer.md"]);

std.print("read_file ok: ", std.is_json(rf) && rf.ok);
std.print("content: ", std.string(rf.content ?? ""));
std.print("list_dir from cwd: ", std.string(fs.files(".", false)));

recv.stop();
fileio.remove(ws);
