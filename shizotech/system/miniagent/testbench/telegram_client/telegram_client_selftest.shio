// Telegram client scratch selftest: fake bot, fake workspace, stub receptionist.
// Run:
//   release/bundles/windows_x64/data/shz.exe release/shizotech/system/miniagent/testbench/telegram_client/telegram_client_selftest.shio
//
// It prints PASSED lines for each check and exits 1 if any check failed.

#include "../../telegram_client"

class FakeBot {
    sent = [];
    docs = [];
    drafts = [];
    on_any_message = None;

    __init__() {
        sent = [];
        docs = [];
        drafts = [];
    }

    send_rich(chat, payload) {
        sent.push_back([chat = chat, markdown = payload.markdown, at = std.millis()]);
        return true;
    }

    send_rich_draft(chat, draft_id, payload) {
        drafts.push_back([chat = chat, draft_id = draft_id, markdown = payload.markdown]);
        return true;
    }

    new_draft_id(chat) {
        return 1;
    }

    download_file(fileid) {
        return [content = "file-content-" + std.string(fileid)];
    }

    send_document(chat, path, opts) {
        content = "";

        if(fileio.exists(path))
            content = fileio.read_string(path);

        caption = "";

        if(std.is_json(opts) && opts.has("caption"))
            caption = std.string(opts.caption);

        docs.push_back([chat = chat, path = path, caption = caption, content = content]);
        return true;
    }
}

class FakeWorkspace {
    path = "";
    tasks = [];
    task_goals = [];
    file_cb = None;
    notify_cb = None;
    finished_cb = None;
    scheduler = None;

    __init__(_path = "") {
        path = std.string(_path);
        tasks = [];
        task_goals = [];
        file_cb = None;
        notify_cb = None;
        finished_cb = None;
        scheduler = None;
    }

    add_task(name, goal, role = "adaptive") {
        id = "task-" + std.random_hash(8);

        tasks.push_back([
            taskid = id,
            name = std.string(name),
            state = "running",
            active = json.bool(true),
            report = "",
            error = "",
            token_usage = 0,
            last_update_ms = std.millis(),
        ]);

        task_goals[id] = std.string(goal);

        return id;
    }

    get_overview() {
        active = [];
        done = [];
        failed = [];

        for(t : tasks) {
            if(t.active)
                active.push_back(t);
            else if(t.state == "finished")
                done.push_back(t);
            else
                failed.push_back(t);
        }

        return [
            tasks = active,
            tasks_scheduled = [],
            tasks_finished = done,
            tasks_failed = failed,
        ];
    }

    inspect_task(taskid) {
        for(t : tasks) {
            if(std.string(t.taskid) == std.string(taskid)) {
                return [
                    ok = true,
                    taskid = t.taskid,
                    name = t.name,
                    state = t.state,
                    active = t.active,
                    report = t.report,
                    error = t.error,
                    token_usage = 0,
                    last_update_ms = t.last_update_ms,
                ];
            }
        }

        return [
            ok = false,
            taskid = std.string(taskid),
            name = "",
            state = "lost",
            active = json.bool(false),
            report = "",
            error = "not found",
            token_usage = 0,
            last_update_ms = 0,
        ];
    }

    update_task(taskid, message) {
        for(t : tasks) {
            if(std.string(t.taskid) == std.string(taskid)) {
                task_goals[t.taskid] = std.string(task_goals[t.taskid]) + "\n" + std.string(message);
                return true;
            }
        }

        return false;
    }

    stop_task(taskid) {
        for(t : tasks) {
            if(std.string(t.taskid) == std.string(taskid)) {
                t.state = "stopped";
                t.active = json.bool(false);
                t.report = "The session was stopped.";
                return true;
            }
        }

        return false;
    }

    add_file_listener(cb) {
        file_cb = cb;
    }

    add_notify_listener(cb) {
        notify_cb = cb;
    }

    add_task_finished_listener(cb, owner = "") {
        finished_cb = cb;
    }

    remove_task_finished_listener(owner) {
        return true;
    }

    notify_user(msg) {
        if(notify_cb)
            notify_cb(msg);

        return [ok = true, message = std.string(msg)];
    }

    share_file(path, caption = "") {
        data = fileio.read_file(path);

        f = [
            name = fileio.file_name(path),
            bytes = data.size(),
            caption = std.string(caption),
            data = std.base64_encode(data),
        ];

        if(file_cb)
            file_cb(f);

        return [ok = true, name = f.name, bytes = f.bytes];
    }

    background_capacity() {
        return [workers = 1, busy = 0];
    }
}

class StubReceptionist {
    client = None;
    last_prompt = "";
    last_tid = "";
    mode = "plain";

    request(prompt) {
        last_prompt = std.string(prompt);

        if(mode == "task")
            last_tid = client.mind.add_task("FileTask", "Use the attached file", "adaptive");

        return [ok = true, reports = [[report = "Stub receptionist received: " + std.string(prompt)]]];
    }

    stop() {
        return true;
    }
}

passed = 0;
failed = 0;

check(name, ok) {
    if(ok) {
        passed++;
        std.print("PASSED " + name);
    }
    else {
        failed++;
        std.print("FAIL " + name);
    }
}

check_contains(name, text, needle) {
    check(name, std.string(text).contains(std.string(needle)));
}

outdir = __DIR__ + "/out";
fileio.mkdir(outdir);

trust1 = outdir + "/trusted_chats.json";
trust2 = outdir + "/fake_trusted_chats.json";

if(fileio.exists(trust1)) fileio.remove(trust1);
if(fileio.exists(trust2)) fileio.remove(trust2);

wsdir = outdir + "/workspace";

// ── isolated workspace creation ────────────────────────────────────────────

bot = FakeBot();

actual = TelegramClient(None, [
    workspace_dir = wsdir,
    trusted = trust1,
    work_start = 540,
    work_end = 1020,
    timezone = "UTC",
    coalesce_ms = 0,
], bot);

check("workspace object exists", std.is_class(actual, TelegramClient));
check("workspace directory exists", fileio.is_directory(wsdir));
check("workspace .megamind exists", fileio.is_directory(wsdir + "/.megamind"));
check("workspace .agentspace exists", fileio.is_directory(wsdir + "/.agentspace"));
check("workspace AGENTS.md exists", fileio.exists(wsdir + "/AGENTS.md"));

non_root = 0;

for(w : actual.store.list()) {
    if(w.id != "root")
        non_root++;
}

check("exactly one non-root workspace", non_root == 1);
check("workspace path is the requested directory", actual.workspace.path == fileio.absolute_path(wsdir));
check("registry root is isolated inside the client workspace", actual.store.root == fileio.absolute_path(wsdir + "/.client_registry"));

src = fileio.read_string(__DIR__ + "/../../telegram_client.shio");
check("no shizonet.server call in source", src.contains("shizonet.server(") == false);
check("no router_api include in source", src.contains("#include \"router_api\"") == false);
check("no Router base class in source", src.contains("class TelegramClient : Router") == false);

// ── trust bootstrap and commands ───────────────────────────────────────────

fake = FakeWorkspace(outdir + "/fake_workspace");
stub = StubReceptionist();
bot2 = FakeBot();

client = TelegramClient(None, [
    workspace_dir = outdir + "/fake_workspace",
    trusted = trust2,
    work_start = 540,
    work_end = 1020,
    timezone = "UTC",
    coalesce_ms = 0,
    clock = []() { return 20 * 3600; },
], bot2, fake, stub);

stub.client = client;

client.tg_handle_message([chatid = 101, text = "hello", username = "Alice"]);

check("first chat bootstrapped as trusted", client.tg_is_trusted(101));
check("bootstrap welcome was sent", bot2.sent.size() == 1);
check("trust file was written", fileio.exists(trust2));

client.tg_handle_message([chatid = 202, text = "stranger", username = "Bob"]);

check("stranger chat ignored", client.tg_chats.size() == 1 && bot2.sent.size() == 1);

client.tg_command([chatid = 101], "/allow 303 Bob");
check("/allow adds trusted chat", client.tg_is_trusted(303));

client.tg_command([chatid = 101], "/deny 303");
check("/deny removes trusted chat", client.tg_is_trusted(303) == false);

client.tg_command([chatid = 101], "/forget");
check("/forget removes the current chat", client.tg_is_trusted(101) == false);

client.tg_trust(101, "Alice");

// ── queue outside the window, dispatch inside ─────────────────────────────

client.tg_clock = []() { return 20 * 3600; };
check("window closed at 20:00", client.tg_window_open() == false);

queued_id = client.mind.add_task("QueuedWork", "Do the queued thing", "adaptive");

check("outside-window task is queued", std.string(queued_id).starts("queued-"));
check("queue has one request", client.mind.queue.size() == 1);
check("no worker task was started outside the window", fake.tasks.size() == 0);

client.tg_sync_window();

check("closed sync keeps the request queued", client.mind.queue.size() == 1 && fake.tasks.size() == 0);

client.tg_clock = []() { return 10 * 3600; };
check("window open at 10:00", client.tg_window_open() == true);

client.tg_sync_window();

check("queued request dispatched inside the window", fake.tasks.size() == 1 && client.mind.queue.size() == 0);
check("dispatched goal reaches the fake worker", std.string(fake.task_goals[fake.tasks[0].taskid]).contains("Do the queued thing"));

// ── stop at window close ───────────────────────────────────────────────────

client.tg_clock = []() { return 18 * 3600; };
check("window closed at 18:00", client.tg_window_open() == false);

client.tg_sync_window();

check("active worker task stopped at close", fake.tasks[0].state == "stopped");

// ── crossing midnight ─────────────────────────────────────────────────────

client.tg_window_start = 22 * 60;
client.tg_window_end = 6 * 60;

client.tg_clock = []() { return 23 * 3600; };
check("cross-midnight window open at 23:00", client.tg_window_open() == true);

client.tg_clock = []() { return 12 * 3600; };
check("cross-midnight window closed at 12:00", client.tg_window_open() == false);

client.tg_window_start = 540;
client.tg_window_end = 1020;

// ── file delivery from worker/receptionist send_file ──────────────────────

client.tg_clock = []() { return 10 * 3600; };

shared_path = outdir + "/shared.md";
fileio.write_text(shared_path, "Shared file content");

fake.share_file(shared_path, "shared caption");
client.tg_flush_out();

check("send_file document reached Telegram", bot2.docs.size() >= 1);
check("document caption reached Telegram", bot2.docs[bot2.docs.size() - 1].caption == "shared caption");
check_contains("document content reached Telegram", bot2.docs[bot2.docs.size() - 1].content, "Shared file content");

// ── long report attached as .md ───────────────────────────────────────────

longtxt = "";
for(i = 0; i < 3000; i++)
    longtxt += "x";

client.tg_send_report([chatid = 101], longtxt);

check("long report message says attachment exists", std.string(bot2.sent[bot2.sent.size() - 1].markdown).contains("the full report is attached"));
check("long report document delivered", bot2.docs.size() >= 2);
check("long report document has full text", bot2.docs[bot2.docs.size() - 1].content.length() == 3000);

// ── incoming file attached verbatim to the delegated task ─────────────────

stub.mode = "task";
client.tg_trust(101, "Alice");

incoming = [
    chatid = 101,
    text = "Use this file",
    document = [
        fileid = "f1",
        filename = "plan.md",
        mimetype = "text/markdown",
        filesize = 20,
    ],
];

client.tg_handle_message(incoming);

idx = client.tg_next_ready();

check("incoming message is ready", idx >= 0);

client.tg_run_item(idx);

check("incoming file shown to receptionist", std.string(stub.last_prompt).contains("file-content-f1"));
check("incoming file attached verbatim to task", std.string(fake.task_goals[stub.last_tid]).contains("file-content-f1"));
check("receptionist answer sent to chat", bot2.sent[bot2.sent.size() - 1].markdown.contains("Stub receptionist received"));

// ── client commands ──────────────────────────────────────────────────────

client.tg_command([chatid = 101], "/window");
check("/window command reports window", std.string(bot2.sent[bot2.sent.size() - 1].markdown).contains("Work window"));

client.tg_command([chatid = 101], "/tasks");
check("/tasks command lists tasks", std.string(bot2.sent[bot2.sent.size() - 1].markdown).contains("Tasks:"));

client.tg_command([chatid = 101], "/status");
check("/status command reports queue", std.string(bot2.sent[bot2.sent.size() - 1].markdown).contains("queued:"));

stop_tid = client.mind.add_task("StopCmd", "stop me", "adaptive");
client.tg_command([chatid = 101], "/stop " + stop_tid);
check("/stop command stops a task", client.mind.inspect_task(stop_tid).state == "stopped");

// ── summary ──────────────────────────────────────────────────────────────

std.print("PASSED SUMMARY: " + std.string(passed) + " checks, " + std.string(failed) + " failed");

if(failed)
    std.exitprocess(1);
