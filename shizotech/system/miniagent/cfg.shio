agent_space = std.wd() + "/" + AGENT_DIR;
agent_root = AGENT_ROOT_DIR;
agent_space_exists = fileio.exists(agent_space);

skip_first_command = false;

if(!fileio.exists(agent_space)) {
	create_new_space = std.input("Initialize persistant agent state (Y-create new agent space / N-run standalone) ? ");
	create_new_space = create_new_space.lowercase();
	
	if(create_new_space.starts("y")) {
		fileio.mkdir(agent_space);
		fileio.mkdir(agent_space + "skills");
		fileio.mkdir(agent_space + "roles");
		fileio.mkdir(agent_space + "todos");
		fileio.mkdir(agent_space + "dashboard");
	}
}

cfg_use_local = fileio.exists(agent_space + "config.json");
cfg_path = cfg_use_local ? agent_space + "config.json" : std.config_path("miniagent", "llmconfig");
cfg = fileio.read_json(cfg_path);

if(!cfg)
	std.print("No configuration found.");
	std.print("In order to use this you have to connect to an openai compatible endpoint (only vLLM is tested).");

if(cfg)
{
	//Always test
	std.cout("\ntesting... ", cfg.api, "...");

	try {
		//Test the api once
		gpt = generic_agent(cfg.api, None, None, cfg.token);
		test_result = gpt.text("This is a system test.\nAnswer with 'hello world'.\nDo not write anything else.");
		test_result = test_result.lowercase();
		if(test_result.find("hello world") < 0)
			std.cout("could not get an answer from the API!\n\n");
			std.print(test_result);
			cfg = None;
		else
			std.cout("online.\n\n");
	}
	catch(e) {
		cfg = None;
	}
}
	
for(!cfg)
{
	std.print("Please enter the full URL to the endpoint you want to use ( e.g. http://localhost:8000 )");
	api_url = std.input(">>> ");
	std.print("Please enter your auth token (can be empty for local)");
	auth_token = std.input(">>> ");
	
	api_url = api_url.removesuffix("/v1/");
	api_url = api_url.removesuffix("/v1");
	api_url = api_url.removesuffix("/");
	
	std.print("testing...");
	
	try {	
		//Test the api once
		gpt = generic_agent(api_url, None, None, auth_token);
		test_result = gpt.text("Answer with 'hello world'. Do not write anything else.");
		if(test_result.find("hello world") < 0)
			std.print("could not get an answer from the API.");
			continue;
			
		std.print("passed.");
		
		cfg.api = api_url;
		cfg.token = auth_token;
		
		cfg_write_path = agent_space_exists ? agent_space + "config.json" : cfg_path;
		fileio.write_json(cfg_write_path, cfg);
		std.print(cfg_write_path);
		break;
	}
	catch(e) {
		
	}
}