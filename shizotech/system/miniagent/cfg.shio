
cfg_path = std.config_path("miniagent", "llmconfig");
cfg = fileio.read_json(cfg_path);

if(!cfg)
	std.print("No configuration found.");
	std.print("In order to use this you have to connect to an openai compatible endpoint (only vLLM is tested).");

if(cfg)
{
	//Always test
	std.cout("\ntesting... ", cfg.api, "...");

	try {
		//Test the api once
		gpt = generic_agent(cfg.api, cfg.model_name, None, cfg.token);
		test_result = gpt.text("This is a system test.\nAnswer with 'hello world'.\nDo not write anything else.");
		std.sleep(500);
		if(test_result) {
			test_result = test_result.lowercase();
			if(test_result.find("hello world") < 0)
				std.cout("could not get an answer from the API!\n\n");
				std.print(test_result);
				cfg = None;
			else
				std.cout("online.\n\n");
			
			if(cfg.secondary_model_name) {
				//Test the api once
				gpt = generic_agent(cfg.api, cfg.secondary_model_name, None, cfg.token);
				test_result = gpt.text("This is a system test.\nAnswer with 'hello world'.\nDo not write anything else.");
				std.sleep(500);
				if(test_result) {
					test_result = test_result.lowercase();
					if(test_result.find("hello world") < 0)
						std.cout("could not get an answer from the API (secondary model)!\n\n");
						std.print(test_result);
						cfg.secondary_model_name = None;
					else
						std.cout("secondary model online.\n\n");
				}
			}
		}
	}
	catch(e) {
		cfg = None;
	}
}

get_auth_creds(api_url_text, auth_token_text, model_name_text, secondary_model_name_text = "") {
	
	api_url = "";
	auth_token = "";
	model_name = "";
	secondary_model_name = "";
	
	for(true)
	{
		if(api_url_text)
			std.print(api_url_text);
			api_url = std.input(">>> ");
		if(auth_token_text)
			std.print(auth_token_text);
			auth_token = std.input(">>> ");
		if(model_name_text)
			std.print(model_name_text);
			model_name = std.input(">>> ");
		if(secondary_model_name_text)
			std.print(secondary_model_name_text);
			secondary_model_name = std.input(">>> ");
		
		api_url = api_url.removesuffix("/v1/");
		api_url = api_url.removesuffix("/v1");
		api_url = api_url.removesuffix("/");
		
		std.print("testing...");
		
		try {	
			//Test the api once
			gpt = generic_agent(api_url, model_name, None, auth_token);
			test_result = gpt.text("Answer with 'hello world'. Do not write anything else. Answer directly.").lowercase();
			if(test_result.find("hello world") < 0)
				std.print("could not get an answer from the API.");
				continue;
				
			std.print("passed.");
			
			if(secondary_model_name)
				gpt = generic_agent(api_url, secondary_model_name, None, auth_token);
				test_result = gpt.text("Answer with 'hello world'. Do not write anything else. Answer directly.").lowercase();
				if(test_result.find("hello world") < 0)
					std.print("could not get an answer from the API (secondary model).");
					continue;			
				std.print("passed.");
			
			return [
				api_url = api_url,
				auth_token = auth_token,
				model_name = model_name,
				secondary_model_name = secondary_model_name,
			];
		}
		catch(e) {
			
		}
		
		std.print("Could not get an answer from the API.");
	}
}

if(!cfg) {
	creds = get_auth_creds(
			"Enter the full URL to the endpoint you want to use ( e.g. http://localhost:8000 )",
			"Enter your auth token (can be empty for local setups)",
			"Enter the PRIMARY 'planning' model name (can be empty for local setups)",
			"Enter the SECONDARY 'fast' model name (leave empty to use PRIMARY)"
		);

	cfg.api = creds.api_url;
	cfg.token = creds.auth_token;
	cfg.model_name = creds.model_name;
	cfg.secondary_model_name = creds.secondary_model_name;

	fileio.write_json(cfg_path, cfg);
	std.print(cfg_path);
}