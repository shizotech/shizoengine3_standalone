// ═════════════════════════════════════════════════════════════════════════════
//  model_config_selftest.shio — checks the shared model config CLI helpers
//
//  Usage:  shz model_config_selftest.shio
//
//  No LLM endpoint is contacted: every load/save uses connect = false.
// ═════════════════════════════════════════════════════════════════════════════

import tempfile;

#include "model_config_cli"

passed = 0;
failed = 0;

check(name, cond, info = "") {
	if(cond) {
		passed++;
		std.print("  PASS  ", name, "\n");
	}
	else {
		failed++;
		std.print("  FAIL  ", name, "  -> ", info, "\n");
	}
}

std.print("model_config_selftest\n\n");

// ── profile parsing ──────────────────────────────────────────────────────────

parts = model_config_split_profile("configs/endpoints.json#worker");
check("split_profile separates path", parts.path == "configs/endpoints.json", parts.path);
check("split_profile separates profile", parts.profile == "worker", parts.profile);

check("is_path detects ./path", model_config_is_path("./foo"), "");
check("is_path detects .json", model_config_is_path("foo.json"), "");
check("is_path rejects plain name", !model_config_is_path("foo"), "");

// ── flat save/load ───────────────────────────────────────────────────────────

tmp = tempfile.tempfile("shz_model_config", ".json");
path = tmp.path();

cfg = ModelConfig();
cfg.set("http://localhost:8000/v1/", "tok", "main-model", 32000, 3, false);

check("save flat config", cfg.save(path), path);
check("load flat config", cfg.load(path, false), path);
check("flat url normalized", cfg.url == "http://localhost:8000", cfg.url);
check("flat model loaded", cfg.name == "main-model", cfg.name);
check("flat context loaded", cfg.max_tokens == 32000, std.string(cfg.max_tokens));
check("flat agents loaded", cfg.max_running_agents == 3, std.string(cfg.max_running_agents));

// ── profile save/load in the same file ───────────────────────────────────────

worker_cfg = ModelConfig();
worker_cfg.set("http://localhost:8001", "wtok", "worker-model", 64000, 8, false);

check("save worker profile", worker_cfg.save_profile(path, "worker"), path);

loaded_worker = ModelConfig();
check("load worker profile", loaded_worker.load_profile(path, "worker", false), path);
check("worker profile url", loaded_worker.url == "http://localhost:8001", loaded_worker.url);
check("worker profile model", loaded_worker.name == "worker-model", loaded_worker.name);

loaded_default = ModelConfig();
check("default profile survives profile save", loaded_default.load_profile(path, "default", false), path);
check("default profile url", loaded_default.url == "http://localhost:8000", loaded_default.url);

// ── spec resolution with #profile ────────────────────────────────────────────

spec = path + "#worker";
resolved = model_config_resolve_existing(spec);
check("resolve_existing finds path#profile", resolved == path, std.string(resolved));

spec_cfg = ModelConfig();
check("load_spec path#profile", model_config_load_spec(spec_cfg, spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY, false), spec);
check("load_spec path#profile model", spec_cfg.name == "worker-model", spec_cfg.name);

// ── current working directory search ─────────────────────────────────────────

local_name = "__model_config_selftest_tmp";
local_path = std.wd() + "/" + local_name + ".json";

local_cfg = ModelConfig();
local_cfg.set("http://localhost:9000", "", "cwd-model", 12345, 2, false);
check("save cwd config", local_cfg.save(local_path), local_path);

found = model_config_resolve_existing(local_name);
check("plain name finds cwd config", found == local_path, std.string(found));

cwd_cfg = ModelConfig();
check("load_spec plain cwd name", model_config_load_spec(cwd_cfg, local_name, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY, false), local_name);
check("cwd config model", cwd_cfg.name == "cwd-model", cwd_cfg.name);

try {
	fileio.remove(local_path);
}
catch(e) {}

tmp.close();

std.print("\n", passed, " passed, ", failed, " failed\n");

if(failed == 0) {
	std.print("ALL PASSED\n");
}
else {
	std.runtime_error("model_config_selftest: " + std.string(failed) + " checks failed");
}
