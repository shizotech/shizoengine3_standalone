
// ═════════════════════════════════════════════════════════════════════════════
//  Mind run outcome tests (headless — no LLM endpoint required)
//
//  Run:  shz tests/mind_run_outcome_test.shio
//
//  The bug this file exists for: every Mind terminal tool (complete_goal,
//  fail_goal, block_goal, ask_user, wait_for, end_run) calls agent.stop().
//  miniagent.stop() aborts the stream, so llm_api.task() hands back the
//  streamed transcript — empty when the model only emitted the tool call — and
//  miniagent.task() reports that as ok=false ("Agent returned nothing (maybe
//  crashed)"). The dispatcher read ok=false as a crash and recorded EVERY run,
//  successful completions included, as failed. mind_run_end then emitted
//  mind.run_failed, which is a notify-class event, so a completed goal printed
//  "Completed" and, right next to it, "mind.run_failed".
//
//  The transcript is disposable; the durable record is the authority for how a
//  run ended. These tests pin that classification down, end to end through
//  mind_dispatcher_execute, and assert what the notification consumer sees.
//
//  This suite deliberately never calls mind_dispatcher_step/launch: those need
//  a root agent and a model endpoint.
// ═════════════════════════════════════════════════════════════════════════════

#include "../runtime/mind_dispatcher"

tests_passed = 0;
tests_failed = 0;
failures = [];

check(name, cond, detail = "") {
	if(cond) {
		tests_passed++;
		std.cout("  [ok]   ", name, "\n");
		return;
	}
	tests_failed++;
	failures.push_back(name + (detail ? " :: " + detail : ""));
	std.cout("  [FAIL] ", name, " ", detail, "\n");
}

section(title) {
	std.cout("\n== ", title, " ==\n");
}

// Notify every event of a Mind through the consumer and return the log entries
// that belong to it (the headless stand-in for "what the console printed").
notify_all(mind_id) {
	evs = mind_events(mind_id, 200);
	for(i = 0; i < evs.size(); i++)
		mind_dispatcher_notify(evs[i]);

	all = mind_dispatcher_notify_log(1000);
	out = [];
	for(i = 0; i < all.size(); i++)
		if(all[i].mind_id == mind_id)
			out.push_back(all[i]);
	return out;
}

log_has(entries, type, cls = "") {
	for(i = 0; i < entries.size(); i++) {
		if(entries[i].type != type)
			continue;
		if(cls && entries[i].class != cls)
			continue;
		return true;
	}
	return false;
}

// ─────────────────────────────────────────────────────────────────────────────

std.cout("\nMind run outcome tests\n");

test_root = ".agent/mind_test_outcome_" + std.random_hash(6) + "/";

mind_set_root(test_root);

// What miniagent.task() returns when a tool stopped the agent mid-run: the
// transcript is empty, so it reports ok=false. This is the input that used to
// be read as a crash.
nothing = [ok = false, error = "Agent returned nothing (maybe crashed).", execution_time_ms = 12];

section("Classification: a run ended by a terminal tool is finished, not failed");

idC = mind_spawn("Ship the 2.0 release notes", "", [request_id = "out_c"]).mind_id;
mind_set_state(idC, MIND_STATE_ACTIVE, "writing");
mind_report(idC, "completed", "notes published", "the release page shows the 2.0 notes", true);

oc = mind_dispatcher_run_outcome([stopped = true], idC, nothing, false, [stopped_by_tool = true]);
check("a completed run that stopped itself is finished", oc.status == MIND_RUN_FINISHED, std.string(oc));
check("the reason is the terminal report, not a crash", oc.reason == "terminal_report", std.string(oc));

idW = mind_spawn("Track the freezer", "", [request_id = "out_w"]).mind_id;
mind_set_state(idW, MIND_STATE_ACTIVE, "working");
mind_set_state(idW, MIND_STATE_WAITING, "waiting for worker result", [waiting_for = "worker_7 result"]);

ow = mind_dispatcher_run_outcome([stopped = true], idW, nothing, false, [stopped_by_tool = true]);
check("a run that ended with wait_for is finished", ow.status == MIND_RUN_FINISHED, std.string(ow));
check("the reason names the tool stop", ow.reason == "agent_stopped_by_tool", std.string(ow));

idB = mind_spawn("Watch the build server", "", [request_id = "out_b"]).mind_id;
mind_set_state(idB, MIND_STATE_ACTIVE, "watching");
mind_report(idB, "blocked", "the dashboard is unreachable", "", false, [needs = "access to the dashboard"]);

ob = mind_dispatcher_run_outcome([stopped = true], idB, nothing, false, [stopped_by_tool = true]);
check("a run that ended with block_goal is finished", ob.status == MIND_RUN_FINISHED, std.string(ob));

idS = mind_spawn("Index the archive", "", [request_id = "out_s"]).mind_id;
mind_set_state(idS, MIND_STATE_ACTIVE, "indexing");
mind_stop(idS, "user asked");

os = mind_dispatcher_run_outcome([stopped = true], idS, nothing, false, [stopped_by_tool = true]);
check("a run terminated after a stop request is stopped", os.status == MIND_RUN_STOPPED, std.string(os));
check("a stop is never recorded as a failure", os.status != MIND_RUN_FAILED, std.string(os));

idX = mind_spawn("Rotate the signing key", "", [request_id = "out_x"]).mind_id;
mind_set_state(idX, MIND_STATE_ACTIVE, "working");

ox = mind_dispatcher_run_outcome([stopped = false], idX, nothing, false, [stopped_by_tool = true]);
check("an agent that returned nothing and never stopped is failed", ox.status == MIND_RUN_FAILED, std.string(ox));
check("the reason is truthful", ox.reason == "agent_returned_nothing", std.string(ox));

ocx = mind_dispatcher_run_outcome([stopped = false], idX, [ok = false, reports = [[report = "boom"]]], true, [stopped_by_tool = true]);
check("an exception out of the agent call is a crash", ocx.status == MIND_RUN_FAILED && ocx.reason == "crashed", std.string(ocx));

ook = mind_dispatcher_run_outcome([stopped = false], idX, [ok = true, reports = [[report = "bounded step done"]]], false, [stopped_by_tool = true]);
check("a run that reported is finished", ook.status == MIND_RUN_FINISHED && ook.reason == "agent_reported", std.string(ook));

// An injected run is not the same case: send_prompt() stops the agent itself,
// so agent.stopped proves nothing there — only a durable outcome may save it.
oij = mind_dispatcher_run_outcome([stopped = true], idX, nothing, false, [stopped_by_tool = false]);
check("an injected run with no durable outcome is still failed", oij.status == MIND_RUN_FAILED, std.string(oij));

oijt = mind_spawn("Deploy the staging build", "", [request_id = "out_ijt"]).mind_id;
mind_set_state(oijt, MIND_STATE_ACTIVE, "deploying");
mind_report(oijt, "completed", "deployed", "staging reports build 42", true);
oijb = mind_dispatcher_run_outcome([stopped = true], oijt, nothing, false, [stopped_by_tool = false]);
check("an injected run that completed the goal is finished", oijb.status == MIND_RUN_FINISHED, std.string(oijb));

section("End to end: a completing Mind run emits no run_failed notification");

idE = mind_spawn("Publish the changelog", "notify me when it is published",
	[request_id = "out_e", notification_condition = "notify me when the changelog is published"]).mind_id;
mind_set_state(idE, MIND_STATE_ACTIVE, "publishing");

// Stand-in for the Mind subagent: complete_goal persists the outcome and stops
// the agent (roles/mind/ROLE.shio), and the transcript is empty afterwards.
agentE = [stopped = false];
agentE.task = [agentE, idE](p) {
	mind_report(idE, "completed", "changelog published", "the site serves the 2.0 changelog", true);
	agentE.stopped = true;
	return [ok = false, error = "Agent returned nothing (maybe crashed).", execution_time_ms = 25];
};

createdE = mind_events(idE, 50)[0];

runE = mind_run_start(idE, createdE.id, [trigger = "mind.created"]);
execE = mind_dispatcher_execute(agentE, idE, runE.run_id, createdE.id, "publish the changelog");

check("the completed run is recorded as finished", mind_run(runE.run_id).status == MIND_RUN_FINISHED, std.string(mind_run(runE.run_id)));
check("execute reports success", execE.ok == true && execE.status == MIND_RUN_FINISHED, std.string(execE));
check("the goal is completed", mind_get(idE).state == MIND_STATE_COMPLETED, std.string(mind_get(idE).state));
check("no failure was counted", mind_get(idE).counters.failures == 0, std.string(mind_get(idE).counters.failures));
check("the run summary is not the crash line", !std.string(mind_run(runE.run_id).summary).contains("crashed"),
	std.string(mind_run(runE.run_id).summary));

logE = notify_all(idE);

check("a completed goal produces no run_failed notification", !log_has(logE, "mind.run_failed"), std.string(logE));
check("the run end is recorded as mind.run_finished", log_has(logE, "mind.run_finished"));
check("mind.run_finished is routine, not a user notification", mind_notify_class("mind.run_finished") == "info");
check("the completion is the notification the user sees", log_has(logE, "mind.completed", "notify"));
check("the durable notification was discharged", mind_get(idE).notification.delivered == true);

section("End to end: a genuinely dead run is still recorded and notified as failed");

idF = mind_spawn("Reindex the archive", "", [request_id = "out_f"]).mind_id;
mind_set_state(idF, MIND_STATE_ACTIVE, "indexing");

agentF = [stopped = false];
agentF.task = [](p) {
	return [ok = false, error = "Agent returned nothing (maybe crashed).", execution_time_ms = 5];
};

runF = mind_run_start(idF, "", [trigger = "mind.created"]);
execF = mind_dispatcher_execute(agentF, idF, runF.run_id, "", "reindex the archive");

check("a run whose agent died is recorded as failed", mind_run(runF.run_id).status == MIND_RUN_FAILED, std.string(mind_run(runF.run_id)));
check("execute reports the failure", execF.ok == false && execF.status == MIND_RUN_FAILED, std.string(execF));
check("the failure is counted", mind_get(idF).counters.failures == 1, std.string(mind_get(idF).counters.failures));

logF = notify_all(idF);
check("a real failure is a user notification", log_has(logF, "mind.run_failed", "notify"), std.string(logF));

section("End to end: a run terminated by a stop request ends as stopped, not failed");

idG = mind_spawn("Watch the queue", "", [request_id = "out_g"]).mind_id;
mind_set_state(idG, MIND_STATE_ACTIVE, "watching");
mind_stop(idG, "user asked");

agentG = [stopped = false];
agentG.task = [agentG](p) {
	agentG.stopped = true;
	return [ok = false, error = "Agent returned nothing (maybe crashed).", execution_time_ms = 8];
};

runG = mind_run_start(idG, "", [trigger = "mind.created"]);
execG = mind_dispatcher_execute(agentG, idG, runG.run_id, "", "watch the queue");

check("the run ends as stopped", mind_run(runG.run_id).status == MIND_RUN_STOPPED, std.string(mind_run(runG.run_id)));
check("a stop is not counted as a failure", mind_get(idG).counters.failures == 0, std.string(mind_get(idG).counters.failures));
check("bookkeeping confirms the stop", mind_get(idG).state == MIND_STATE_STOPPED, std.string(mind_get(idG).state));

logG = notify_all(idG);
check("a stopped run emits no run_failed event", !log_has(logG, "mind.run_failed"), std.string(logG));
check("the stop is the notification the user sees", log_has(logG, "mind.stopped", "notify"));

section("End to end: an injected run keeps its honest outcome");

idH = mind_spawn("Deploy the staging build", "", [request_id = "out_h"]).mind_id;
mind_set_state(idH, MIND_STATE_ACTIVE, "deploying");

// A live agent that answers properly: the injected run is finished.
agentH = [stopped = false];
agentH.send_prompt = [idH](p) {
	mind_report(idH, "completed", "deploy stopped as instructed", "staging pipeline cancelled", true);
	return [ok = true, reports = [[report = "acknowledged: the deploy is stopped"]]];
};

runH = mind_run_start(idH, "", [trigger = "message_injected"]);
injH = mind_dispatcher_inject_run(agentH, idH, "msg_fake_h", "", runH.run_id, "stop the deploy");
check("a reported injection is finished", injH.status == MIND_RUN_FINISHED, std.string(injH));
check("the injected run is finished", mind_run(runH.run_id).status == MIND_RUN_FINISHED, std.string(mind_run(runH.run_id)));

// A live agent that dies with an empty transcript and no durable outcome:
// send_prompt() stopped it, which proves nothing, so this stays a failure.
idI = mind_spawn("Reindex the search index", "", [request_id = "out_i"]).mind_id;
mind_set_state(idI, MIND_STATE_ACTIVE, "indexing");

agentI = [stopped = true];
agentI.send_prompt = [](p) {
	return [ok = false, error = "Agent returned nothing (maybe crashed)."];
};

runI = mind_run_start(idI, "", [trigger = "message_injected"]);
injI = mind_dispatcher_inject_run(agentI, idI, "msg_fake_i", "", runI.run_id, "reindex last month");
check("an injection that produced nothing is failed", injI.status == MIND_RUN_FAILED, std.string(injI));
check("the injected run is failed", mind_run(runI.run_id).status == MIND_RUN_FAILED, std.string(mind_run(runI.run_id)));

std.cout("\n----------------------------------------\n");
std.cout("passed: ", tests_passed, "  failed: ", tests_failed, "\n");

if(tests_failed) {
	std.cout("failures:\n");
	for(i = 0; i < failures.size(); i++)
		std.cout("  - ", failures[i], "\n");
}

std.cout("----------------------------------------\n");

fileio.remove(test_root.removesuffix("/"));

std.exitprocess(tests_failed ? 1 : 0);
