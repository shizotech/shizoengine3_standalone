
// ═════════════════════════════════════════════════════════════════════════════
//  Receptionist tool-surface + turn-report tests (headless — no LLM endpoint)
//
//  Run:  shz tests/receptionist_tools_test.shio
//
//  Exercises the coordination tools through the real tool callbacks of a
//  miniagent built from roles/receptionist, with a stub node in env.mind, and
//  asserts contract C6 — the report path of one receptionist turn:
//
//    finish(summary)      fills receptionist.env.reports
//    megamind_turn_result folds them into the turn result (ok = true),
//                         turns an escaped exception into a crash report and a
//                         stopped turn into a stopped report, so every request
//                         ends with a human-readable report.
//
//  A node-side failure ("Goals are not enabled on this node: ...") is the
//  regression: the goal tool answers it, finish() reports it, the owner reads
//  it — never "Agent was stopped.".
//
//  No LLM run, no thread, no network: the tool callbacks are called directly
//  and the turn is simulated from the result shapes miniagent.task() produces.
//  The live turn itself runs in Megamind.receptionist_thread (node.shio).
// ═════════════════════════════════════════════════════════════════════════════

#include "../miniagent"
#include "../megamind"

tests_passed = 0;
tests_failed = 0;
failures = [];

check(name, cond, detail = "") {
	if(cond) {
		tests_passed++;
		std.cout("  [ok]   ", name, "\n");
		return;
	}
	tests_failed++;
	failures.push_back(name + (detail ? " :: " + detail : ""));
	std.cout("  [FAIL] ", name, " ", detail, "\n");
}

section(title) {
	std.cout("\n== ", title, " ==\n");
}

tool_names(agt) {
	names = [];
	tools = agt.llm_api.tools.tools;
	for(i = 0; i < tools.size(); i++)
		names.push_back(tools[i].function.name);
	return names;
}

has_tool(names, name) {
	for(i = 0; i < names.size(); i++)
		if(names[i] == name)
			return true;
	return false;
}

call(agt, name, args) {
	if(!agt.llm_api.tools.tool_callbacks.has(name))
		return [ok = false, error = "tool_not_registered", tool = name];
	return agt.llm_api.tools.tool_callbacks[name](args);
}

// the text the owner would show the user for one turn result
report_text(res) {
	if(!std.is_json(res) || !std.is_json(res.reports) || !res.reports.size())
		return "";
	return std.string(res.reports[0].report);
}

// what miniagent.task() hands back for a tool-call-only turn that ended in
// finish() -> agt.stop() (miniagent.shio:369-376, env.use_finalize never set)
stopped_turn_result() {
	return [ok = false, stopped = true, reports = [], error = "Agent was stopped.", execution_time_ms = 42];
}

// ─────────────────────────────────────────────────────────────────────────────

std.cout("\nReceptionist tool-surface + turn-report tests\n");

cfg = ModelConfig();

managed recv = miniagent(cfg, "receptionist");

// The stub node: the tools only ever call this surface of Megamind.
seen_notify = [];
added_tasks = [];
shared_files = [];
stub_mind = [
	//no .agentspace on this node -> every goal tool answers goal_tool_disabled()
	goals = None,
	get_overview = []() {
		return [tasks = [], tasks_scheduled = [], tasks_finished = [], tasks_failed = []];
	},
	add_task = [](name, goal) {
		added_tasks.push_back([name = name, goal = goal]);
		return "taskid_stub_1";
	},
	stop_task = [](taskid) { return true; },
	//only the task this stub node really has accepts an update: a finished or
	//unknown taskid must come back as "create a new task"
	update_task = [](taskid, message) { return taskid == "taskid_stub_1"; },
	inspect_task = [](taskid) { return [taskid = taskid, state = "planned"]; },
	notify_user = [](msg) {
		seen_notify.push_back(msg);
		return true;
	},
	share_file = [](path, caption) {
		shared_files.push_back([path = path, caption = caption]);
		return [ok = true, name = fileio.file_name(path)];
	},
];

recv.env.mind = stub_mind;

section("Tool surface: coordination + goals + finish (§4.1, §8)");

names = tool_names(recv);

check("get_overview registered", has_tool(names, "get_overview"));
check("get_last_actions registered", has_tool(names, "get_last_actions"));
check("inspect_task registered", has_tool(names, "inspect_task"));
check("start_task registered", has_tool(names, "start_task"));
check("stop_task registered", has_tool(names, "stop_task"));
check("update_task registered", has_tool(names, "update_task"));
check("notify registered", has_tool(names, "notify"));
check("finish registered", has_tool(names, "finish"));
check("goal tools registered",
	has_tool(names, "get_goals") && has_tool(names, "create_goal")
	&& has_tool(names, "update_goal") && has_tool(names, "set_goal_status")
	&& has_tool(names, "run_goal_now"));

forbidden = [
	"write_file", "append_text", "replace_string", "mkdir", "move", "copy", "rename", "remove",
	"read_file", "list_dir", "file_info", "file_line_count",
	"command_start", "command_read", "command_input", "command_kill", "command_wait", "command_list_sessions",
	"list_skills", "read_skill",
	"start_miniagent", "continue_task", "file_task_batch", "signal", "milestone", "finalize",
	"spawn_worker", "start_worker", "execute_plan", "execute_task", "delegate_task",
];

leaks = "";
for(i = 0; i < forbidden.size(); i++)
	if(has_tool(names, forbidden[i]))
		leaks += forbidden[i] + " ";

check("no file, command, skill, worker or task-execution tool is exposed", leaks.empty(), "leaked: " + leaks);
check("finish is the only turn-ending tool", has_tool(names, "finish") && !has_tool(names, "finalize"));

section("Coordination tools drive the node, never a Mind");

recv.env.last_actions = None;

start = call(recv, "start_task", [
	name = "Sexy-Sushi",
	task = "tonight, clean up the repository",
	summary = "one repository cleanup goal for tonight",
]);
check("start_task returns the taskid", start.taskid == "taskid_stub_1", std.string(start));
check("start_task forwards the goal to the node", added_tasks.size() == 1 && std.string(added_tasks[0].goal).contains("clean up the repository"));
check("start_task keeps the taskid out of the user text", std.string(start.suggestion).contains("private"));

stop = call(recv, "stop_task", [taskid = "taskid_stub_1", reason = "user changed their mind"]);
check("stop_task answers OK", stop == "OK", std.string(stop));

upd = call(recv, "update_task", [taskid = "taskid_stub_1", message = "make it 6am instead"]);
check("update_task answers OK", upd == "OK", std.string(upd));

gone = call(recv, "update_task", [taskid = "taskid_gone", message = "hello?"]);
check("update_task of a finished task says to create a new one", std.string(gone).contains("new task"), std.string(gone));

ovw = call(recv, "get_overview", []);
check("get_overview reaches the node", std.is_json(ovw) && ovw.has("tasks"));

insp = call(recv, "inspect_task", [taskid = "taskid_stub_1"]);
check("inspect_task reaches the node", insp.taskid == "taskid_stub_1", std.string(insp));

// notify: no last_actions yet (None) -> the tool must create the ring, not crash
note = call(recv, "notify", [message = "cleanup goal created for tonight"]);
check("notify answers OK with a missing last_actions ring", note == "OK", std.string(note));
check("notify reached the user", seen_notify.size() == 1 && std.string(seen_notify[0]).contains("tonight"));
check("notify recorded its action", std.string(recv.env.last_actions).contains("notify"));

acts = call(recv, "get_last_actions", [limit = 40]);
check("get_last_actions returns the ring newest first",
	std.is_json(acts) && acts.size() == 4 && acts[0].action == "notify", std.string(acts));
check("get_last_actions honours the limit", call(recv, "get_last_actions", [limit = 2]).size() == 2);

section("finish(summary) fills env.reports (C6)");

recv.env.reports = [];
recv.env.last_actions = [];

summary = "Goals are not enabled on this node: start it in a folder with an .agentspace.";

fin = call(recv, "finish", [summary = summary]);

check("finish answers OK", fin == "OK", std.string(fin));
check("finish pushed one report", std.is_json(recv.env.reports) && recv.env.reports.size() == 1, std.string(recv.env.reports));
check("the report carries the summary", report_text([reports = recv.env.reports]) == summary, report_text([reports = recv.env.reports]));
check("the report is stamped with time and time_str",
	recv.env.reports[0].has("time") && recv.env.reports[0].has("time_str"));
check("finish keeps the turn_summary action entry",
	recv.env.last_actions.size() == 1 && recv.env.last_actions[0].action == "turn_summary", std.string(recv.env.last_actions));
check("finish stops the agent", recv.stopped == true);

empty_fin = call(recv, "finish", [summary = "   "]);
check("an empty summary is refused", std.string(empty_fin).contains("must not be empty"), std.string(empty_fin));
check("the refused summary added no report", recv.env.reports.size() == 1);

section("The fold: a reported turn is a success (C6)");

res = megamind_turn_result(recv, stopped_turn_result(), "", 42);

check("the fold keeps the result a json", std.is_json(res));
check("a turn that reported is ok", res.ok == true, std.string(res));
check("the fold carries the reports of finish()", report_text(res) == summary, report_text(res));
check("a reported turn has no error", res.error == "", std.string(res.error));
check("the fold keeps the execution time", res.execution_time_ms == 42, std.string(res.execution_time_ms));
check("the fold never shows 'Agent was stopped.' for a reported turn", !std.string(report_text(res)).contains("Agent was stopped."));

section("A node-side failure reaches the owner (the regression)");

goals = call(recv, "get_goals", []);
check("get_goals reports the disabled goal system", goals.ok == false && std.string(goals.error).contains("Goals are not enabled on this node"), std.string(goals));

create = call(recv, "create_goal", [title = "tonight", instructions = "x", schedule_type = "once", window = "tonight"]);
check("create_goal is refused the same way", create.ok == false && std.string(create.error).contains("Goals are not enabled on this node"), std.string(create.error));

// the model reads the tool answer and reports it: that text must survive the turn
recv.env.reports = [];
call(recv, "finish", [summary = std.string(goals.error)]);

failed = megamind_turn_result(recv, stopped_turn_result(), "", 11);

check("the failed turn is reported, not swallowed", failed.ok == true, std.string(failed));
check("the report carries the tool's error text", report_text(failed).contains("Goals are not enabled on this node"), report_text(failed));
check("the report is not the generic stop message", report_text(failed) != "Agent was stopped.");

section("A crashing receptionist yields the crash report (C6)");

recv.env.reports = [];

crash = megamind_turn_result(recv, None, "Cannot load ROLE.md roles/mind/ROLE.md", 7);

check("the crash result is a json", std.is_json(crash));
check("the crash is not ok", crash.ok == false);
check("the crash carries the exception text as error", crash.error == "Cannot load ROLE.md roles/mind/ROLE.md", std.string(crash.error));
check("the crash report names the crash", report_text(crash).contains("The node's receptionist crashed:"), report_text(crash));
check("the crash report quotes the exception", report_text(crash).contains("Cannot load ROLE.md"), report_text(crash));
check("the crash carries the execution time", crash.execution_time_ms == 7, std.string(crash.execution_time_ms));

recv.env.reports = [[report = "half a report", time = std.millis(), time_str = std.timestamp()]];
crash_after = megamind_turn_result(recv, None, "boom", 1);
check("a crash wins over a report pushed before it", report_text(crash_after).contains("crashed: boom"), report_text(crash_after));

section("A stopped turn yields the stopped report (C6)");

recv.env.reports = [];

st = megamind_turn_result(recv, stopped_turn_result(), "", 42);

check("the stopped turn is not ok", st.ok == false);
check("the stopped turn keeps its stopped flag", st.stopped == true);
check("the stopped turn keeps its error", st.error == "Agent was stopped.", std.string(st.error));
check("the stopped turn carries a readable report", report_text(st) == "The receptionist turn was stopped.", report_text(st));

section("Every request ends with a human-readable report");

nothing = megamind_turn_result(recv, None, "", 3);
returned = megamind_turn_result(recv, [ok = false, error = "Agent returned nothing (maybe crashed).", execution_time_ms = 3], "", 3);
crash_res = megamind_turn_result(recv, [ok = false, error = "The task failed to execute correctly (crash)."], "", 3);

shapes = [
	["reported turn", res],
	["failed goal turn", failed],
	["crash", crash],
	["stopped", st],
	["no result at all", nothing],
	["returned nothing", returned],
	["miniagent crash", crash_res],
];

missing = "";
for(i = 0; i < shapes.size(); i++) {
	one = shapes[i];
	if(report_text(one[1]).empty())
		missing += one[0] + " ";
}
check("every turn result carries a report", missing.empty(), "no report: " + missing);

check("a result that is not a json becomes one", std.is_json(nothing) && nothing.ok == false, std.string(nothing));
check("the reason of a silent turn is kept in the report", report_text(returned).contains("Agent returned nothing"), report_text(returned));
check("the reason of a miniagent crash is kept in the report", report_text(crash_res).contains("crash"), report_text(crash_res));

section("send_file: a document for the owner's chat");

check("send_file registered", has_tool(tool_names(recv), "send_file"));
missing_file = call(recv, "send_file", [path = "testbench/no_such_file.html"]);
check("a missing file is a readable error", !missing_file.ok && std.string(missing_file.error).contains("not found"), std.string(missing_file));
check("a missing file is not handed to the node", shared_files.size() == 0, std.string(shared_files));

share_path = "receptionist_share_test.html";
fileio.write_string(share_path, "<h1>report</h1>");
shared = call(recv, "send_file", [path = share_path, caption = "the report"]);
check("send_file hands the file and the caption to the node", shared.ok && shared_files.size() == 1 &&
	shared_files[0].path == share_path && shared_files[0].caption == "the report", std.string(shared_files));
fileio.remove(share_path);

sub = recv.subagent("single_action/explorer");
check("a subagent finds the node through its parents", agt_find_mind(sub) == stub_mind, "");
lonely = miniagent(cfg, "single_action/explorer");
check("an agent without a node finds none", std.is_none(agt_find_mind(lonely)), "");

std.cout("\n----------------------------------------\n");
std.cout("passed: ", tests_passed, "  failed: ", tests_failed, "\n");

if(tests_failed) {
	std.cout("failures:\n");
	for(i = 0; i < failures.size(); i++)
		std.cout("  - ", failures[i], "\n");
}

std.cout("----------------------------------------\n");

std.exitprocess(tests_failed ? 1 : 0);
