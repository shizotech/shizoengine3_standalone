// ═════════════════════════════════════════════════════════════════════════════
//  read_file_utf16_test.shio — read_file must load UTF-16 .md files
//
//  Usage:  shz tests/read_file_utf16_test.shio     (from system/miniagent; no LLM)
// ═════════════════════════════════════════════════════════════════════════════

#include "../miniagent"

passed = 0;
failed = 0;

check(name, cond, info = "") {
    if(cond) {
        passed++;
        std.print("  PASS  ", name);
    }
    else {
        failed++;
        std.print("  FAIL  ", name, "  -> ", info);
    }
}

call(agt, name, args) {
    return agt.llm_api.tools.tool_callbacks[name](args);
}

std.print("read_file_utf16_test\n");

BASE = "testbench/read_file_utf16_test_" + std.random_hash(8);
fileio.mkdir(BASE);

// "# UTF16 doc\nline two\n" as UTF-16LE (FF FE + each code unit low byte, 0)
le = std.buffer();
le.push(255, 254,
    35, 0, 32, 0, 85, 0, 84, 0, 70, 0, 49, 0, 54, 0, 32, 0,
    100, 0, 111, 0, 99, 0, 10, 0,
    108, 0, 105, 0, 110, 0, 101, 0, 32, 0,
    116, 0, 119, 0, 111, 0, 10, 0);
LE_FILE = BASE + "/utf16le.md";
fileio.write_file(LE_FILE, le);

// same text as UTF-16BE (FE FF + each code unit 0, high byte)
be = std.buffer();
be.push(254, 255,
    0, 35, 0, 32, 0, 85, 0, 84, 0, 70, 0, 49, 0, 54, 0, 32,
    0, 100, 0, 111, 0, 99, 0, 10,
    0, 108, 0, 105, 0, 110, 0, 101, 0, 32,
    0, 116, 0, 119, 0, 111, 0, 10);
BE_FILE = BASE + "/utf16be.md";
fileio.write_file(BE_FILE, be);

managed agt = miniagent(ModelConfig(), "adaptive");

r = call(agt, "read_file", [path = LE_FILE, include_line_numbers = "false"]);
check("UTF-16LE .md is read as text", r.ok && !r.binary && std.string(r.content).contains("# UTF16 doc") &&
    std.string(r.content).contains("line two"), std.string(r));
check("UTF-16LE line count", r.total_lines == 2, std.string(r.total_lines));

r2 = call(agt, "read_file", [path = BE_FILE, include_line_numbers = "false"]);
check("UTF-16BE .md is read as text", r2.ok && !r2.binary && std.string(r2.content).contains("# UTF16 doc") &&
    std.string(r2.content).contains("line two"), std.string(r2));
check("UTF-16BE line count", r2.total_lines == 2, std.string(r2.total_lines));

count = call(agt, "file_line_count", [path = LE_FILE]);
check("file_line_count on UTF-16LE", count == 2, std.string(count));

fileio.remove(BASE);

std.print("\n", passed, " passed, ", failed, " failed\n");
if(failed)
    std.exitprocess(1);
