// temporary probe: is the configured LLM endpoint usable for a real e2e run?
#include "openai/generic_agent"
#include "model_config"

cfg = ModelConfig();
p = std.config_path("miniagent", "default_model");
std.print("load: ", std.string(cfg.load(p)), "\n");
std.print("url: ", cfg.url, " model: ", cfg.name, "\n");

g = generic_agent(cfg.url, cfg.name, "You are a test assistant. Answer with exactly the word READY. Do not think.", cfg.token);
g.set_reasoning_effort("low");
out = g.text("Reply with READY.");
std.print("answer: [", std.string(out), "]\n");
