
// ═════════════════════════════════════════════════════════════════════════════
//  Mind runtime contract tests (headless — no LLM endpoint required)
//
//  Run:  shz tests/mind_runtime_test.shio
//
//  Covers the Phase 1 exit criterion: the contracts must clearly distinguish a
//  logical Mind, one LLM run, a queued message and a lifecycle event, plus the
//  idempotency, stop and recovery semantics the Receptionist relies on.
// ═════════════════════════════════════════════════════════════════════════════

#include "../runtime/mind_runtime"

tests_passed = 0;
tests_failed = 0;
failures = [];

check(name, cond, detail = "") {
	if(cond) {
		tests_passed++;
		std.cout("  [ok]   ", name, "\n");
		return;
	}
	tests_failed++;
	failures.push_back(name + (detail ? " :: " + detail : ""));
	std.cout("  [FAIL] ", name, " ", detail, "\n");
}

section(title) {
	std.cout("\n== ", title, " ==\n");
}

// Fresh, isolated store for the whole run.
test_root() {
	return ".agent/mind_test_" + std.random_hash(6) + "/";
}

test_roots = [];

new_test_root() {
	root = test_root();
	test_roots.push_back(root);
	return root;
}

remove_test_roots() {
	for(i = 0; i < test_roots.size(); i++)
		fileio.remove(test_roots[i].removesuffix("/"));
	return test_roots.size();
}

// ─────────────────────────────────────────────────────────────────────────────

test_records_distinct() {
	section("Phase 1: Mind vs Run vs Message vs Event are distinct records");

	spawn = mind_spawn("Check the sensor every 15 minutes and report anomalies", "user asked in chat", [
		request_id = "req_distinct_1",
		notification_condition = "message me when the schedule is live",
	]);

	check("spawn_mind accepted", spawn.ok == true, std.string(spawn));
	check("spawn returns a stable mind id", (spawn.mind_id ?? "").starts("mind_"));
	check("new mind starts in 'starting'", spawn.state == MIND_STATE_STARTING);
	check("creation event id present", (spawn.event_id ?? "").starts("evt_"));
	check("notification condition registered at creation", mind_get(spawn.mind_id).notification.wanted == true);

	mind = mind_get(spawn.mind_id);
	check("mind record validates against the contract", mind_validate_mind(mind).size() == 0, std.string(mind_validate_mind(mind)));

	events = mind_events(spawn.mind_id);
	check("creation emitted exactly one event", events.size() == 1);

	ev = events[0];
	check("event is mind.created", ev.type == "mind.created");
	check("event envelope validates", mind_validate_event(ev).size() == 0, std.string(mind_validate_event(ev)));
	check("event has a store-assigned monotonic seq", ev.seq >= 1);
	check("event carries correlation id", ev.correlation_id == spawn.correlation_id);
	check("event is pending delivery", ev.delivery.status == MIND_DELIVERY_PENDING);
	check("creation event carries the creation-time snapshot, not a live alias",
		std.is_json(ev.data.mind) && ev.data.mind.mailbox.size() == 0);

	run = mind_run_start(spawn.mind_id, ev.id, [trigger = "mind.created"]);
	check("run start ok", run.ok == true);

	run_rec = mind_run(run.run_id);
	check("run record validates", mind_validate_run(run_rec).size() == 0, std.string(mind_validate_run(run_rec)));
	check("run is not the mind", run.run_id != spawn.mind_id);
	check("run references its triggering event", run_rec.event_id == ev.id);
	check("mind counts its runs", mind_get(spawn.mind_id).counters.runs == 1);
	check("mind tracks the active run", mind_get(spawn.mind_id).active_run == run.run_id);

	msg = mind_message(spawn.mind_id, "also mute the audible alarm", [kind = "instruction"]);
	check("message queued", msg.ok == true && msg.status == MIND_MESSAGE_QUEUED);

	msg_rec = mind_message_state(msg.message_id);
	check("message envelope validates", mind_validate_message(msg_rec).size() == 0, std.string(mind_validate_message(msg_rec)));
	check("queued message is not processed", msg_rec.status == MIND_MESSAGE_QUEUED && msg_rec.processed_ms == 0);
	check("message id differs from mind/run/event id",
		msg.message_id != spawn.mind_id && msg.message_id != run.run_id && msg.message_id != ev.id);
	check("message is in the mailbox of the mind", mind_get(spawn.mind_id).mailbox.size() == 1);

	ended = mind_run_end(run.run_id, MIND_RUN_FINISHED, "registered schedule, verified via scheduler read");
	check("run end ok", ended.ok == true);
	check("run is finished", mind_run(run.run_id).status == MIND_RUN_FINISHED);
	check("mind has no active run after the run ends", mind_get(spawn.mind_id).active_run == "");

	check("the mind record itself is untouched by run bookkeeping", mind_get(spawn.mind_id).state == MIND_STATE_STARTING);
}

test_idempotency() {
	section("Idempotency: duplicate requests must not duplicate Minds");

	spawn_a = mind_spawn("Fix all issues in this repository", "", [request_id = "req_dupe_1"]);
	spawn_b = mind_spawn("Fix all issues in this repository", "", [request_id = "req_dupe_1"]);

	check("first spawn created a mind", spawn_a.ok == true && spawn_a.deduplicated == false);
	check("second spawn is deduplicated", spawn_b.ok == true && spawn_b.deduplicated == true);
	check("dedup returns the same mind id", spawn_a.mind_id == spawn_b.mind_id);

	ov = mind_overview();
	found = 0;
	for(i = 0; i < ov.minds.size(); i++)
		if(ov.minds[i].id == spawn_a.mind_id)
			found++;
	check("exactly one mind exists for the request id", found == 1, "found=" + std.string(found));

	msg_a = mind_message(spawn_a.mind_id, "start with issue #12", [idempotency_key = "idem_msg_1"]);
	msg_b = mind_message(spawn_a.mind_id, "start with issue #12", [idempotency_key = "idem_msg_1"]);

	check("first message queued", msg_a.ok == true && msg_a.deduplicated == false);
	check("duplicate message deduplicated", msg_b.ok == true && msg_b.deduplicated == true);
	check("duplicate message did not grow the mailbox", mind_get(spawn_a.mind_id).mailbox.size() == 1);

	// Event delivery: at-least-once + idempotent handling.
	pending = mind_pending_events(spawn_a.mind_id);
	check("pending events exist for the new mind", pending.size() >= 1);

	claim = mind_claim_event(pending[0].id, "dispatcher");
	check("event claimed", claim.ok == true);

	claim_again = mind_claim_event(pending[0].id, "dispatcher");
	check("double claim refused", claim_again.ok == false && claim_again.status == "already_claimed");

	mark = mind_mark_event(pending[0].id, MIND_DELIVERY_PROCESSED, "dispatcher");
	check("event marked processed", mark.ok == true);

	claim_after = mind_claim_event(pending[0].id, "dispatcher");
	check("processed event is never delivered again", claim_after.ok == false && claim_after.status == "already_processed");
}

test_lifecycle() {
	section("Lifecycle: transitions are enforced by the runtime, not by prompts");

	spawn = mind_spawn("Send this message to Telegram", "", [request_id = "req_lifecycle_1"]);
	id = spawn.mind_id;

	res = mind_set_state(id, MIND_STATE_ACTIVE, "goal interpreted, one-shot taskroute selected");
	check("starting -> active", res.ok == true && res.state == MIND_STATE_ACTIVE);

	res = mind_set_state(id, MIND_STATE_WAITING, "waiting for gateway result");
	check("active -> waiting", res.ok == true);

	res = mind_set_state(id, MIND_STATE_ACTIVE, "gateway result arrived");
	check("waiting -> active", res.ok == true);

	res = mind_set_state(id, "exploded");
	check("unknown state rejected", res.ok == false && res.status == "rejected");

	res = mind_set_state(id, MIND_STATE_COMPLETED, "sent", [report = "sent", evidence = "message id 42", verified = true]);
	check("active -> completed", res.ok == true && res.terminal == true);

	res = mind_set_state(id, MIND_STATE_ACTIVE, "trying to continue");
	check("terminal -> active refused by the transition table", res.ok == false && res.status == "illegal_transition");

	react = mind_reactivate(id, "user asked to also send it to the second channel");
	check("explicit reactivation works", react.ok == true && react.state == MIND_STATE_ACTIVE);
	check("reactivation cleared the outcome", mind_get(id).outcome.status == "");

	// Completion requires verification evidence.
	spawn2 = mind_spawn("Rename the release branch", "", [request_id = "req_lifecycle_2"]);
	res = mind_report(spawn2.mind_id, "completed", "renamed", "", false);
	check("unverified completion refused", res.ok == false && res.status == "refused");

	res = mind_report(spawn2.mind_id, "completed", "renamed", "git branch -a shows release/2.0", true);
	check("verified completion accepted", res.ok == true && res.state == MIND_STATE_COMPLETED);
	check("outcome recorded", mind_get(spawn2.mind_id).outcome.verified == true);

	res = mind_report(spawn2.mind_id, "nonsense");
	check("unknown terminal status rejected", res.ok == false);
}

test_stop_semantics() {
	section("Stop semantics: stop_requested is not stopped and never completed");

	spawn = mind_spawn("Watch the build server and report failures", "", [request_id = "req_stop_1"]);
	id = spawn.mind_id;

	mind_set_state(id, MIND_STATE_ACTIVE, "watching");
	run = mind_run_start(id, "", [trigger = "mind.started"]);

	stop = mind_stop(id, "user asked to stop watching");
	check("stop returns stop_requested", stop.ok == true && stop.status == MIND_STATE_STOP_REQUESTED);
	check("stop is not confirmed", stop.confirmed == false);
	check("stop event emitted", (stop.event_id ?? "").starts("evt_"));

	stop_again = mind_stop(id, "user asked again");
	check("stop is idempotent", stop_again.ok == true && stop_again.status == MIND_STATE_STOP_REQUESTED);

	completion = mind_report(id, "completed", "all done", "no evidence", true);
	check("completion refused while stop_requested", completion.ok == false && completion.status == "refused");

	transition = mind_set_state(id, MIND_STATE_COMPLETED, "sneaky completion");
	check("stop_requested -> completed is an illegal transition", transition.ok == false && transition.status == "illegal_transition");

	mind_run_end(run.run_id, MIND_RUN_STOPPED, "run terminated after stop request");

	confirm = mind_confirm_stopped(id, "runner terminated, cleanup done");
	check("runtime confirms stopped", confirm.ok == true && confirm.state == MIND_STATE_STOPPED);

	check("goal not marked completed by a stop", mind_get(id).outcome.status == MIND_STATE_STOPPED);

	msg = mind_message(id, "and now also do X");
	check("terminal mind refuses new messages", msg.ok == false && msg.status == "mind_terminal");

	ov = mind_overview();
	state = "";
	for(i = 0; i < ov.minds.size(); i++)
		if(ov.minds[i].id == id)
			state = ov.minds[i].state;
	check("overview reports the confirmed state", state == MIND_STATE_STOPPED);
}

test_goal_state() {
	section("Goal state persistence (plan §5.3)");

	spawn = mind_spawn("Resolve repository issues one at a time with verification", "", [request_id = "req_state_1"]);
	id = spawn.mind_id;

	up = mind_update(id, [
		goal = "Resolve repository issues one at a time, verifying each change",
		success_criteria = ["every issue is fixed or explicitly deferred", "test suite passes"],
		execution_shape = "iterative",
		plan = [strategy = "one issue per bounded unit", next_step = "pick the oldest open issue"],
		taskroutes = [[id = "repo_issues", path = "taskroutes/fix_repository_issue.md", version = "1"]],
		decisions = ["isolation matters: one issue at a time"],
		blockers = [],
	], [summary = "goal interpreted, iterative workflow selected"]);

	check("goal state update accepted", up.ok == true, std.string(up));
	check("no fields rejected", up.rejected.size() == 0, std.string(up.rejected));

	mind = mind_get(id);
	check("goal persisted", mind.goal.starts("Resolve repository issues"));
	check("success criteria persisted", mind.success_criteria.size() == 2);
	check("execution shape persisted", mind.execution_shape == "iterative");
	check("taskroute reference persisted", mind.taskroutes[0].id == "repo_issues");
	check("plan next step persisted", mind.plan.next_step.starts("pick the oldest"));

	bad = mind_update(id, [execution_shape = "quantum_leaping", secret_lair = "nope"]);
	rejected_str = std.string(bad.rejected);
	check("invalid execution shape rejected", rejected_str.contains("quantum_leaping"), rejected_str);
	check("unknown field rejected", rejected_str.contains("secret_lair"), rejected_str);
	check("unknown field did not leak into the record", !mind_get(id).has("secret_lair"));

	ov = mind_overview();
	for(i = 0; i < ov.minds.size(); i++) {
		if(ov.minds[i].id == id) {
			check("overview exposes next step", (ov.minds[i].next_step ?? "").starts("pick the oldest"));
			check("overview exposes execution shape", ov.minds[i].execution_shape == "iterative");
		}
	}

	wait = mind_set_state(id, MIND_STATE_WAITING, "waiting for worker result", [waiting_for = "worker_42 result"]);
	check("mind can record what it waits for", wait.ok == true);
	check("waiting_for persisted", mind_get(id).waiting_for == "worker_42 result");
}

test_last_actions() {
	section("get_last_actions: compressed recent history for reference resolution");

	spawn = mind_spawn("Turn the living room lights red", "", [request_id = "req_actions_1"]);
	mind_message(spawn.mind_id, "make it strobe instead", [kind = "instruction"]);
	mind_stop(spawn.mind_id, "user changed their mind");

	res = mind_last_actions(10);
	check("last actions ok", res.ok == true);
	check("last actions returns entries", res.count >= 3);

	kinds = "";
	for(i = 0; i < res.actions.size(); i++)
		kinds += res.actions[i].kind + ",";

	check("spawn action recorded", kinds.contains("spawn_mind,"), kinds);
	check("message action recorded", kinds.contains("send_message,"), kinds);
	check("stop action recorded", kinds.contains("stop_mind,"), kinds);

	newest_first = res.actions[0].ts >= res.actions[res.actions.size() - 1].ts;
	check("actions are ordered newest first", newest_first);

	entry = res.actions[0];
	check("action identifies target mind", (entry.mind_id ?? "").starts("mind_"));
	check("action summary is clipped", entry.summary.size() <= 300);
	check("action carries no implementation log", !entry.has("content") && !entry.has("logs"));
}

test_overview_readonly() {
	section("get_overview must be read-only and must not wake a Mind");

	spawn = mind_spawn("Summarize the changelog of last week", "", [request_id = "req_ov_1"]);
	id = spawn.mind_id;

	before = mind_stats();
	ov = mind_overview();
	after = mind_stats();

	check("overview lists the mind", ov.total_minds >= 1);
	check("overview did not create runs", before.running_runs == after.running_runs);
	check("overview did not consume events", before.pending_events == after.pending_events);
	check("overview did not mutate the seq counter", before.seq == after.seq);
	check("overview states it does not wake minds", ov.note.contains("does not wake"));
	check("overview exposes the state", ov.minds[ov.minds.size() - 1].state == MIND_STATE_STARTING);
}

test_persistence_recovery() {
	section("Durability: checkpoint, journal replay and crash reconciliation");

	root = new_test_root();
	mind_set_root(root);

	spawn = mind_spawn("Water the plants when the soil sensor is dry", "", [request_id = "req_persist_1"]);
	id = spawn.mind_id;

	mind_set_state(id, MIND_STATE_ACTIVE, "selected taskroute soil_sensor_watering");
	mind_update(id, [plan = [strategy = "poll on event", next_step = "read sensor"], execution_shape = "recurring"]);
	msg = mind_message(id, "use rain water only", [kind = "instruction"]);

	// Simulate a crash: drop the in-memory store and reload from disk.
	g = std.global(MIND_GLOBAL_NAME);
	g.loaded = false;
	g.state = None;

	reloaded = mind_store();

	check("mind survives a restart", mind_exists(id));
	check("state survives a restart", mind_get(id).state == MIND_STATE_ACTIVE);
	check("plan survives a restart", mind_get(id).plan.next_step == "read sensor");
	check("mailbox survives a restart", mind_get(id).mailbox.size() == 1);
	check("message record survives a restart", mind_message_state(msg.message_id) ? true : false);
	check("event journal survives a restart", mind_events(id).size() >= 4);

	// Journal-only recovery: delete the checkpoint, the journal must rebuild.
	mind_persist();
	fileio.remove(mind_state_path());

	g2 = std.global(MIND_GLOBAL_NAME);
	g2.loaded = false;
	g2.state = None;

	rebuilt = mind_store();

	check("state rebuilt from the journal", mind_exists(id));
	check("rebuilt state is correct", mind_get(id).state == MIND_STATE_ACTIVE);
	check("rebuilt mailbox is correct", mind_get(id).mailbox.size() == 1);

	// In-flight reconciliation: a running run and a claimed event must not be
	// assumed successful after a restart.
	run = mind_run_start(id, "", [trigger = "mind.message_received"]);
	pending = mind_pending_events(id);
	claim = mind_claim_event(pending[0].id, "dispatcher");
	check("event claimed before the simulated crash", claim.ok == true);

	g3 = std.global(MIND_GLOBAL_NAME);
	g3.loaded = false;
	g3.state = None;

	mind_store();

	recovered_run = mind_run(run.run_id);
	check("in-flight run reconciled, not assumed successful",
		recovered_run.status == MIND_RUN_FAILED && recovered_run.summary.contains("reconciled"),
		std.string(recovered_run));
	check("claimed event returned to the queue", mind_event(pending[0].id).delivery.status == MIND_DELIVERY_PENDING);
	check("recovery emitted mind.recovered", mind_events(id).size() > 0);

	recovered_seen = false;
	evs = mind_events(id);
	for(i = 0; i < evs.size(); i++)
		if(evs[i].type == "mind.recovered")
			recovered_seen = true;
	check("recovery event is durable", recovered_seen);

	check("no active run left after reconciliation", mind_get(id).active_run == "");
}

test_contract_tables() {
	section("Contract tables are self-consistent");

	check("every state is in the transition table", MIND_TRANSITIONS.size() == MIND_STATES.size());

	ok_transitions = true;
	for(i = 0; i < MIND_STATES.size(); i++) {
		state = MIND_STATES[i];
		if(!MIND_TRANSITIONS.has(state))
			ok_transitions = false;
		targets = MIND_TRANSITIONS[state];
		for(j = 0; j < targets.size(); j++)
			if(!mind_is_state(targets[j]))
				ok_transitions = false;
	}
	check("all transition targets are valid states", ok_transitions);

	check("terminal states have no outgoing transitions",
		MIND_TRANSITIONS.completed.size() == 0 && MIND_TRANSITIONS.failed.size() == 0 && MIND_TRANSITIONS.stopped.size() == 0);
	check("stop_requested can never reach completed", !mind_allowed_transition(MIND_STATE_STOP_REQUESTED, MIND_STATE_COMPLETED));
	check("mind.created is a declared event type", mind_is_event_type("mind.created"));
	check("mind.message_received is a declared event type", mind_is_event_type("mind.message_received"));
	check("unknown event types are rejected", !mind_is_event_type("mind.yolo"));
	check("contract version is set", MIND_CONTRACT_VERSION >= 1);
}

// ─────────────────────────────────────────────────────────────────────────────

std.cout("\nMind runtime contract tests\n");

mind_set_root(new_test_root());

test_contract_tables();
test_records_distinct();
test_idempotency();
test_lifecycle();
test_stop_semantics();
test_goal_state();
test_last_actions();
test_overview_readonly();
test_persistence_recovery();

std.cout("\n----------------------------------------\n");
std.cout("passed: ", tests_passed, "  failed: ", tests_failed, "\n");

if(tests_failed) {
	std.cout("failures:\n");
	for(i = 0; i < failures.size(); i++)
		std.cout("  - ", failures[i], "\n");
}

std.cout("----------------------------------------\n");

remove_test_roots();

std.exitprocess(tests_failed ? 1 : 0);
