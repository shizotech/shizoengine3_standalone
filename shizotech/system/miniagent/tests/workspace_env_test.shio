// ═════════════════════════════════════════════════════════════════════════════
//  workspace_env_test.shio — workspace .env/vars loading and command inheritance
//
//  Usage:  shz tests/workspace_env_test.shio     (from system/miniagent, Linux /
//          macOS / Windows; no LLM)
// ═════════════════════════════════════════════════════════════════════════════

#include "../miniagent"
#include "../workspace_env"

passed = 0;
failed = 0;

check(name, cond, info = "") {
    if(cond) {
        passed++;
        std.print("  PASS  ", name);
    }
    else {
        failed++;
        std.print("  FAIL  ", name, "  -> ", info);
    }
}

call(agt, name, args) {
    return agt.llm_api.tools.tool_callbacks[name](args);
}

std.print("workspace_env_test\n");

BASE = fileio.absolute_path("testbench/workspace_env_test_" + std.random_hash(8));
fileio.mkdir(BASE);

// ── parser: KEY=VALUE, comments and blanks, one malformed line ──────────────
env_file = BASE + "/.env/vars";
fileio.write_text(env_file, "TEST_FOO=one\nTEST_BAR=two\n# comment\n\nTEST_MALFORMED\nTEST_EMPTY=\n");

r = workspace_env_load(BASE);
check("the file is found", r.ok && r.found, std.string(r));
check("three variables load", r.loaded == 3 && r.names.size() == 3, std.string(r.loaded));
check("names are TEST_FOO, TEST_BAR, TEST_EMPTY", std.string(r.names).contains("TEST_FOO") &&
    std.string(r.names).contains("TEST_BAR") && std.string(r.names).contains("TEST_EMPTY"), std.string(r.names));
check("one malformed line is skipped", r.skipped.size() == 1 &&
    std.string(r.skipped[0].line) == "TEST_MALFORMED", std.string(r.skipped));
check("comments and blank lines are skipped", !std.string(r.names).contains("#"), std.string(r.names));

// ── the command tools of SHARED.shio inherit the variables ──────────────────
managed agt = miniagent(ModelConfig(), "adaptive");

is_windows = std.os_platform().starts("windows");
cmd = is_windows
    ? "echo TEST_FOO=%TEST_FOO% TEST_BAR=%TEST_BAR%"
    : "echo TEST_FOO=$TEST_FOO TEST_BAR=$TEST_BAR";

out = call(agt, "command_start", [command = cmd, timeout = -1, cwd = BASE]);
check("command_start sees the workspace env vars", out.ok && std.string(out.output).contains("TEST_FOO=one") &&
    std.string(out.output).contains("TEST_BAR=two"), std.string(out));

// ── no file: silent and clean ──────────────────────────────────────────────
EMPTY = BASE + "/no_env";
fileio.mkdir(EMPTY);
r2 = workspace_env_load(EMPTY);
check("a missing .env/vars is not an error", r2.ok && !r2.found && r2.loaded == 0, std.string(r2));

fileio.remove(EMPTY);
fileio.remove(BASE);

std.print("\n", passed, " passed, ", failed, " failed\n");
if(failed)
    std.exitprocess(1);
