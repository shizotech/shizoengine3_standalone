// ═════════════════════════════════════════════════════════════════════════════
//  command_tools_test.shio — command_start with multi-line scripts, no temp files
//
//  Usage:  shz tests/command_tools_test.shio     (from system/miniagent, Linux /
//          macOS: sh and python; no LLM)
//
//  A multi-line command used to be written to ./.shz_cmd/shz_cmd_<id>.<ext> in the
//  working directory, a folder that stayed in every project. sh and python now get
//  the script as one argument (sh -c, python -c); only batch / PowerShell need a
//  file, and that goes to the system temp directory (Windows).
// ═════════════════════════════════════════════════════════════════════════════

#include "../miniagent"

passed = 0;
failed = 0;

check(name, cond, info = "") {
	if(cond) {
		passed++;
		std.print("  PASS  ", name);
	}
	else {
		failed++;
		std.print("  FAIL  ", name, "  -> ", info);
	}
}

call(agt, name, args) {
	return agt.llm_api.tools.tool_callbacks[name](args);
}

std.print("command_tools_test\n");

managed agt = miniagent(ModelConfig(), "adaptive");

WORK = "tests/_command_tools_tmp";
fileio.mkdir(WORK);

// ── a multi-line sh script: state carries from line to line ─────────────────
r = call(agt, "command_start", [
	command = "x=41\nx=$((x + 1))\necho \"answer $x\"\ncd ..\necho \"dir $(basename \"$PWD\")\"",
	timeout = -1,
	cwd = WORK,
]);
check("a multi-line sh script runs as one script", r.ok && r.state == "EXITED" && r.exit_code == 0 &&
	std.string(r.output).contains("answer 42"), std.string(r));
check("cwd is honoured", std.string(r.output).contains("dir tests"), std.string(r.output));
check("no .shz_cmd folder in the working directory", !fileio.exists(WORK + "/.shz_cmd"), "");
check("no .shz_cmd folder in the current directory", !fileio.exists(".shz_cmd"), "");

// ── quotes and a here document survive (the script is one argument) ─────────
r = call(agt, "command_start", [
	command = "cat <<EOF\nline 'one' \"two\"\nEOF\necho done",
	timeout = -1,
	cwd = WORK,
]);
check("quotes and a here document survive", r.ok && std.string(r.output).contains("line 'one' \"two\"") &&
	std.string(r.output).contains("done"), std.string(r));

// ── the exit code of the script is the exit code of its last command ────────
r = call(agt, "command_start", [command = "true\nexit 3", timeout = -1, cwd = WORK]);
check("the exit code of the script", r.ok && r.exit_code == 3, std.string(r));

// ── python ──────────────────────────────────────────────────────────────────
has_python = false;
probe = call(agt, "command_start", [command = "python -c \"print(1)\"", timeout = -1, cwd = WORK]);
has_python = probe.ok && probe.exit_code == 0;
if(has_python) {
	r = call(agt, "command_start", [
		command = "total = 0\nfor i in range(5):\n    total += i\nprint('total', total)",
		timeout = -1,
		cwd = WORK,
		script_type = "py",
	]);
	check("a multi-line python script", r.ok && r.exit_code == 0 && std.string(r.output).contains("total 10"), std.string(r));
}
else {
	std.print("  skip  python (no 'python' on the PATH)");
}

// ── a script that keeps running becomes a session ───────────────────────────
r = call(agt, "command_start", [command = "echo start\nsleep 1\necho end", timeout = 100, cwd = WORK]);
check("a running script becomes a session", r.ok && r.state == "RUNNING", std.string(r));
if(r.ok && r.state == "RUNNING") {
	w = call(agt, "command_wait", [session_id = r.session_id]);
	check("the session finishes with the rest of the output", w.ok && std.string(w.output).contains("end"), std.string(w));
}
check("still no .shz_cmd folder", !fileio.exists(WORK + "/.shz_cmd") && !fileio.exists(".shz_cmd"), "");

// ── a single line still goes to the shell as it is ──────────────────────────
r = call(agt, "command_start", [command = "echo one && echo two", timeout = -1, cwd = WORK]);
check("a single line goes to the shell", r.ok && std.string(r.output).contains("one") && std.string(r.output).contains("two"), std.string(r));

fileio.remove(WORK);

std.print("\n", passed, " passed, ", failed, " failed");
if(failed)
	std.exitprocess(1);
