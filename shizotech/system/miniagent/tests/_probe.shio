
// temporary probe: replicate the exact test sequence for journal-only recovery
#include "../runtime/mind_runtime"

root = ".agent/mind_probe4/";
mind_set_root(root);

spawn = mind_spawn("Water the plants when the soil sensor is dry", "", [request_id = "p4"]);
id = spawn.mind_id;
mind_set_state(id, MIND_STATE_ACTIVE, "selected taskroute soil_sensor_watering");
mind_update(id, [plan = [strategy = "poll on event", next_step = "read sensor"], execution_shape = "recurring"]);
msg = mind_message(id, "use rain water only", [kind = "instruction"]);

std.print("phase1: state=", std.string(mind_get(id).state), " mailbox=", std.string(mind_get(id).mailbox.size()), "\n");

g = std.global(MIND_GLOBAL_NAME);
g.loaded = false;
g.state = None;
mind_store();

std.print("phase2 (checkpoint reload): state=", std.string(mind_get(id).state), " mailbox=", std.string(mind_get(id).mailbox.size()), "\n");
std.print("phase2 events in memory: ", std.string(std.global(MIND_GLOBAL_NAME).state.events.size()), "\n");

mind_persist();
fileio.remove(mind_state_path());

std.print("--- journal after persist ---\n");
j = fileio.read_string(mind_journal_path());
lines = j.split("\n", -1, true);
for(i = 0; i < lines.size(); i++) {
	ev = std.json(lines[i], true);
	if(!std.is_json(ev) || !(ev.id ?? false))
		continue;
	std.print("  seq=", ev.seq, " type=", ev.type, " data.state=", std.string(ev.data.state ?? "-"), "\n");
}

g2 = std.global(MIND_GLOBAL_NAME);
g2.loaded = false;
g2.state = None;
mind_store();

m = mind_get(id);
std.print("phase3 (journal-only): exists=", std.string(m ? true : false),
	" state=", std.string(m.state ?? "?"),
	" mailbox=", std.string(m.mailbox.size()), "\n");

fileio.remove(root.removesuffix("/"));
