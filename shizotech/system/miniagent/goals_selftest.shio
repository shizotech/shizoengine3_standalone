section("definitions: edits, invalid edits, conflicts, pause");

ED = R"(---
id: edit-me
title: Edit me
schedule:
  type: recurring
  days: daily
  start: "12:00"
  end: "14:00"
  timezone: Europe/Berlin
---

Version one.
)";
write_goal_file("active", "edit-me", ED);
clk.t = at(ber, "2026-10-23", "11:00");
sch4.tick();
rev1 = sch4.defs["edit-me"].revision;

fileio.write_text(ROOT + "/goals/active/edit-me/goal.md", ED.replace("start: \"12:00\"", "start: \"99:00\""));
sch4.tick();
check("invalid edit: the last valid revision stays active", sch4.defs["edit-me"].revision == rev1 && sch4.defs["edit-me"].schedule.start == 12 * 3600, "");
check("invalid edit: one clear error event", has_event(sch4, "definition_invalid", "edit-me") && notes_with(host4, "edit is invalid") == 1, std.string(host4.notes));
sch4.tick();
check("invalid edit: reported once, not every tick", notes_with(host4, "edit is invalid") == 1, "");
check("overview flags the invalid edit", sch4.goal_summary("edit-me", sch4.defs["edit-me"]).invalid_edit, "");

fileio.write_text(ROOT + "/goals/active/edit-me/goal.md", ED.replace("Version one.", "Version two."));
sch4.tick();
rev2 = sch4.defs["edit-me"].revision;
check("valid edit applies a new revision", rev2 != rev1 && sch4.defs["edit-me"].body.contains("Version two"), "");
check("valid edit is audited", has_event(sch4, "definition_changed", "edit-me"), "");
check("diff shows the change", goal_line_diff(sch4.ledger.goal("edit-me").previous_text, sch4.ledger.goal("edit-me").text).contains("+ Version two."), "");

clk.t = at(ber, "2026-10-23", "12:00") + 5;
sch4.tick();
check("edited goal activates once", count_activations(sch4, "edit-me") == 1, "");
fileio.write_text(ROOT + "/goals/active/edit-me/goal.md", ED.replace("Version one.", "Version three."));
sch4.tick();
check("an edit during the window does not create a duplicate activation", count_activations(sch4, "edit-me") == 1, "");
check("the running activation keeps the revision it started with", sch4.ledger.activation("edit-me@" + gt_format_utc(at(ber, "2026-10-23", "12:00"))).revision == rev2, "");

cur = goal_text_revision(goal_read(ROOT + "/goals/active/edit-me/goal.md"));
wr = space.write_goal("edit-me", gfm_read_text(goal_read(ROOT + "/goals/active/edit-me/goal.md")).data, "Agent version.", "active", rev1);
check("a stale revision is refused (concurrent edit)", !wr.ok && gj(wr, "conflict", false), gfm_join(gj(wr, "errors", []), ";"));
wr = space.write_goal("edit-me", gfm_read_text(goal_read(ROOT + "/goals/active/edit-me/goal.md")).data, "Agent version.", "active", cur);
check("the current revision is accepted", wr.ok, gfm_join(gj(wr, "errors", []), ";"));
wr = space.write_goal("new-goal", [title = "New", schedule = [type = "manual"]], "Do.", "proposed");
check("write_goal creates a proposed goal", wr.ok && fileio.exists(ROOT + "/goals/proposed/new-goal/goal.md"), gfm_join(gj(wr, "errors", []), ";"));
wr = space.write_goal("bad-goal", [title = "Bad", schedule = [type = "once"]], "Do.", "proposed");
check("write_goal refuses an invalid goal and writes nothing", !wr.ok && !fileio.exists(ROOT + "/goals/proposed/bad-goal"), "");

res = space.move("edit-me", "paused");
sch4.tick();
check("pause moves the folder", res.ok && fileio.exists(ROOT + "/goals/paused/edit-me/goal.md"), "");
before = host4.tasks.size();
clk.t = at(ber, "2026-10-24", "12:00") + 5;
sch4.tick();
check("a paused goal starts no new window", count_activations(sch4, "edit-me") == 1 && host4.tasks.size() == before, "");
space.move("edit-me", "active");
clk.t = at(ber, "2026-10-25", "12:00") + 5;
sch4.tick();
check("resume: the next window activates", count_activations(sch4, "edit-me") == 2, std.string(count_activations(sch4, "edit-me")));
space.move("edit-me", "archived");
sch4.tick();

