section("agent tools (what the receptionist calls)");

ctx = goal_tool_list(sch4);
check("get_goals gives the time zone and the named windows", ctx.timezone == "Europe/Berlin" && ctx.windows.has("tonight") && ctx.now.length() > 0, std.string(ctx.timezone));

cr = goal_tool_create(sch4, [title = "Try a new app idea", instructions = "Explore an app idea for musicians.", schedule_type = "once", date = "2026-11-02", window = "tonight"]);
check("create_goal: 'tonight' becomes a once goal 04:00-10:00", cr.ok && cr.schedule.contains("04:00-10:00") && cr.schedule.contains("Europe/Berlin"), gj_str(cr, "error", std.string(cr)));
check("create_goal without activate is proposed", cr.ok && cr.status == "proposed" && fileio.exists(ROOT + "/goals/proposed/try-a-new-app-idea/goal.md"), "");

dup = goal_tool_create(sch4, [title = "Try a new app idea", instructions = "again", schedule_type = "once", date = "2026-11-03", window = "tonight"]);
check("create_goal refuses the same goal twice", !dup.ok && gj_str(dup, "duplicate_of", "") == "try-a-new-app-idea", gj_str(dup, "error", ""));

sim = goal_tool_create(sch4, [id = "app-idea-2", title = "Try new app idea", instructions = "Explore an app idea for musicians.", schedule_type = "once", date = "2026-11-03", window = "tonight"]);
check("create_goal refuses a near duplicate", !sim.ok && gj_str(sim, "duplicate_of", "") == "try-a-new-app-idea", gj_str(sim, "error", ""));

bad = goal_tool_create(sch4, [title = "Broken", instructions = "x", schedule_type = "recurring", days = "funday", start = "05:00"]);
check("create_goal reports validation errors and writes nothing", !bad.ok && gj_str(bad, "error", "").contains("funday") && !sch4.space.find("broken"), gj_str(bad, "error", ""));

hi = goal_tool_create(sch4, [title = "Release on Fridays", instructions = "Tag and publish a release.", schedule_type = "recurring", days = "friday", start = "16:00", end = "18:00", allow = "edit,release", activate = "yes"]);
check("a goal that may release stays proposed even with activate=yes", hi.ok && hi.status == "proposed", std.string(hi));

act = goal_tool_create(sch4, [title = "Fix GitHub issues", instructions = "Fix eligible issues.", schedule_type = "windowed", days = "weekdays", window = "tonight", start = "05:00", end = "10:00", activate = "yes"]);
check("an explicit 05:00-10:00 wins over 'tonight' and is active", act.ok && act.status == "active" && act.schedule.contains("05:00-10:00"), std.string(act));

ev = goal_tool_create(sch4, [title = "Check the server logs", instructions = "Read the last 200 lines of the server log.", schedule_type = "recurring", every = "2d", start = "06:00", duration = "30m", activate = "yes"]);
check("create_goal accepts every='2d'", ev.ok && ev.schedule.contains("every 2d"), gj_str(ev, "error", std.string(ev)));
check("create_goal writes 'every: 2d' into goal.md", ev.ok && goal_read(ROOT + "/goals/active/check-the-server-logs/goal.md").contains("every: 2d"), goal_read(ROOT + "/goals/active/check-the-server-logs/goal.md"));
check("create_goal with every previews interval windows", ev.ok && ev.next_windows.size() == 3, std.string(ev.next_windows));

up2 = goal_tool_update(sch4, [id = "check-the-server-logs", revision = ev.revision, days = "monday"]);
check("update_goal with days drops the interval", up2.ok && up2.schedule.contains("mon") && !goal_read(ROOT + "/goals/active/check-the-server-logs/goal.md").contains("every:"), gj_str(up2, "error", std.string(up2)));
up3 = goal_tool_update(sch4, [id = "check-the-server-logs", revision = up2.revision, every = "3d"]);
check("update_goal with every drops the weekday set", up3.ok && up3.schedule.contains("every 3d") && !goal_read(ROOT + "/goals/active/check-the-server-logs/goal.md").contains("days:"), gj_str(up3, "error", std.string(up3)));
goal_tool_set_status(sch4, [id = "check-the-server-logs", status = "archive"]);

up = goal_tool_update(sch4, [id = "fix-github-issues", revision = "stale", end = "09:00"]);
check("update_goal with a stale revision is refused", !up.ok && gj(up, "conflict", false), gj_str(up, "error", ""));
up = goal_tool_update(sch4, [id = "fix-github-issues", revision = act.revision, end = "09:00"]);
check("update_goal with the current revision changes only that field", up.ok && up.schedule.contains("05:00-09:00") && goal_read(ROOT + "/goals/active/fix-github-issues/goal.md").contains("Fix eligible issues."), gj_str(up, "error", std.string(up)));

st = goal_tool_set_status(sch4, [id = "fix-github-issues", status = "pause"]);
check("set_goal_status pause moves it to paused/", st.ok && st.to == "paused" && fileio.exists(ROOT + "/goals/paused/fix-github-issues/goal.md"), std.string(st));
rn = goal_tool_run_now(sch4, [id = "fix-github-issues"]);
check("run_goal_now refuses a paused goal", !rn.ok, std.string(rn));
goal_tool_set_status(sch4, [id = "fix-github-issues", status = "resume"]);
rn = goal_tool_run_now(sch4, [id = "fix-github-issues"]);
check("run_goal_now queues a run for the scheduler", rn.ok && fileio.files(ROOT + "/.runtime/requests", false).size() == 1, std.string(rn));
manual_runs(sch, goal) {
	n = 0;
	for(k, a : sch.ledger.data.activations) {
		if(a.goal == goal && a.kind == "manual")
			n++;
	}
	return n;
}
before = manual_runs(sch4, "fix-github-issues");
sch4.tick();
check("the scheduler starts the queued run", manual_runs(sch4, "fix-github-issues") == before + 1 && fileio.files(ROOT + "/.runtime/requests", false).size() == 0, std.string(manual_runs(sch4, "fix-github-issues")));

