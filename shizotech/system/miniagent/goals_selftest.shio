// ═════════════════════════════════════════════════════════════════════════════
section("the scheduler keeps an 'every 2d' cadence");

runs_of(sch, goal) {
	n = 0;
	for(k, a : sch.ledger.data.activations) {
		if(a.goal == goal)
			n += a.runs.size();
	}
	return n;
}

EVERY = R"(---
id: log-sweep
title: Check the server logs
priority: urgent
schedule:
  type: recurring
  every: 2d
  start: "06:00"
  duration: 30m
  timezone: Europe/Berlin
policy:
  max_attempts: 2
  retry_backoff: 5m
---

Read the last 200 lines of the server log.
)";

write_goal_file("active", "log-sweep", EVERY);

// the clock moves BEFORE the first scan: active_since (the interval phase) is
// the day the scheduler sees the goal, so set it to the day the cadence starts
clk.t = at(ber, "2026-11-01", "05:00");
finish_open(host4, sch4);
sch4.tick();
check("before the window: the interval goal has not started", count_activations(sch4, "log-sweep") == 0, std.string(count_activations(sch4, "log-sweep")));

clk.t = at(ber, "2026-11-01", "06:00") + 5;
sch4.tick();
check("day 1: the window activates and dispatches", count_activations(sch4, "log-sweep") == 1 && runs_of(sch4, "log-sweep") == 1, std.string(runs_of(sch4, "log-sweep")));
finish_open(host4, sch4);

clk.t = at(ber, "2026-11-02", "06:00") + 5;
sch4.tick();
check("day 2: no window (every 2 days, not every day)", count_activations(sch4, "log-sweep") == 1, std.string(count_activations(sch4, "log-sweep")));

clk.t = at(ber, "2026-11-03", "06:00") + 5;
sch4.tick();
check("day 3: the cadence continues", count_activations(sch4, "log-sweep") == 2 && runs_of(sch4, "log-sweep") == 2, std.string(count_activations(sch4, "log-sweep")));
check("the prompt carries the interval instructions", host4.tasks.size() && host4.tasks[host4.tasks.size() - 1].task.contains("Read the last 200 lines of the server log."), "");

sum = sch4.goal_summary("log-sweep", sch4.defs["log-sweep"]);
check("the summary renders the interval", sum.schedule.contains("every 2d"), sum.schedule);
check("the preview is on the interval phase (the open window of 11-03)", sum.next_window.starts("2026-11-03 06:00"), sum.next_window);

clk.t = at(ber, "2026-11-03", "07:00");
sch4.tick();
sum = sch4.goal_summary("log-sweep", sch4.defs["log-sweep"]);
check("after the window: the preview is the next phase day (11-05)", sum.next_window.starts("2026-11-05 06:00"), sum.next_window);

// a restart keeps the phase: the cadence does not slide to the restart day
host5 = FakeHost();
sch5 = GoalScheduler(ROOT, host5, [notify = true]);
sch5.clock = [clk]() { return clk.t; };
sch5.tick();
check("restart: the interval phase survives (no extra window on 11-03)", count_activations(sch5, "log-sweep") == 2, std.string(count_activations(sch5, "log-sweep")));
clk.t = at(ber, "2026-11-04", "06:00") + 5;
sch5.tick();
check("restart: day 4 stays quiet", count_activations(sch5, "log-sweep") == 2, std.string(count_activations(sch5, "log-sweep")));
clk.t = at(ber, "2026-11-05", "06:00") + 5;
sch5.tick();
check("restart: day 5 runs again", count_activations(sch5, "log-sweep") == 3, std.string(count_activations(sch5, "log-sweep")));

// ═════════════════════════════════════════════════════════════════════════════

fileio.remove(ROOT);

std.print("\n ", passed, " passed, ", failed, " failed\n");

if(failed == 0)
	std.print("\nALL PASSED\n");
else
	std.exitprocess(1);
