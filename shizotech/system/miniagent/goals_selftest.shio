// ═════════════════════════════════════════════════════════════════════════════
//  goals_selftest.shio — time zones, goal files and the scheduler, no LLM
//
//  Usage:  shz goals_selftest.shio
//
//  The scheduler runs against a fake host (records add_task / stop_task /
//  update_task, finishes tasks on demand) and a fake clock, in a throw-away
//  .agentspace under the current directory.
// ═════════════════════════════════════════════════════════════════════════════

#include "goal_tools"

passed = 0;
failed = 0;

check(name, cond, info = "") {
	if(cond) {
		passed++;
		std.print("  PASS  ", name);
	}
	else {
		failed++;
		std.print("  FAIL  ", name, "  -> ", info);
	}
}

section(name) {
	std.print("\n── ", name);
}

// local wall time in a zone -> UTC seconds
at(zone, date, clock) {
	return gt_local_to_utc(zone, gt_parse_date(date) * GT_DAY + gt_parse_clock(clock));
}

// ─────────────────────────────────────────────────────────────────────────────
//  Fakes
// ─────────────────────────────────────────────────────────────────────────────

class FakeClock {
	t = 0;
}

class FakeHost {
	tasks = [];
	stops = [];
	updates = [];
	notes = [];
	listeners = [];
	busy = 0;
	workers = 2;
	idle = 100000;
	refuse = false;

	add_task(name, goal) {
		if(refuse)
			return None;
		id = "t" + std.string(tasks.size() + 1);
		tasks.push_back([taskid = id, name = name, task = goal, state = "research", report = "", last_update_ms = std.millis()]);
		return id;
	}

	find(taskid) {
		for(t : tasks) {
			if(t.taskid == taskid)
				return t;
		}
		return None;
	}

	inspect_task(taskid) {
		t = find(taskid);
		if(!t)
			return "Not found.";
		return t;
	}

	stop_task(taskid) {
		stops.push_back(taskid);
		return true;
	}

	update_task(taskid, msg) {
		updates.push_back([taskid = taskid, message = msg]);
		return true;
	}

	notify_user(msg) {
		notes.push_back(msg);
	}

	add_task_finished_listener(cb) {
		listeners.push_back(cb);
	}

	background_capacity() {
		return [workers = workers, busy = busy, interactive_idle_secs = idle];
	}

	// the worker ends a task
	finish(taskid, state, report) {
		t = find(taskid);
		t.state = state;
		t.report = report;
		for(cb : listeners)
			cb(t);
	}

	open_tasks() {
		n = 0;
		for(t : tasks) {
			if(t.state == "research" || t.state == "implement")
				n++;
		}
		return n;
	}
}

ROOT = "goals_selftest_tmp_" + std.random_hash(6);
TEMPLATE = __DIR__ + "/agentspace_template";

write_goal_file(status, id, text) {
	dir = ROOT + "/goals/" + status + "/" + id;
	goal_mkdir(dir);
	fileio.write_text(dir + "/goal.md", text);
}

count_activations(sch, goal) {
	n = 0;
	for(k, a : sch.ledger.data.activations) {
		if(a.goal == goal)
			n++;
	}
	return n;
}

has_event(sch, kind, goal) {
	for(e : sch.ledger.data.events) {
		if(e.kind == kind && e.goal == goal)
			return true;
	}
	return false;
}

notes_with(host, needle) {
	n = 0;
	for(m : host.notes) {
		if(std.string(m).contains(needle))
			n++;
	}
	return n;
}

// the workers end every task that is still running
finish_open(host, sch) {
	for(t : host.tasks) {
		if(t.state == "research")
			host.finish(t.taskid, "finished", "done");
	}
	sch.tick();
}

std.print("goals_selftest\n");

// ═════════════════════════════════════════════════════════════════════════════
section("time zones");

ber = gt_zone("Europe/Berlin");
check("Europe/Berlin resolves", ber.ok && ber.has_dst, ber.error);

ber_builtin = gt_tz_parse_posix(GT_ZONES["Europe/Berlin"]);
check("built-in Berlin rule matches", ber_builtin.ok && ber_builtin.std_off == 3600 && ber_builtin.dst_off == 7200, ber_builtin.spec);

u = at(ber, "2026-03-29", "02:30");
check("spring gap 02:30 moves forward to 03:30 CEST", gt_format_local(ber, u).starts("2026-03-29 03:30 CEST"), gt_format_local(ber, u));

u = at(ber, "2026-10-25", "02:30");
check("autumn overlap takes the first 02:30 (CEST)", gt_format_utc(u) == "2026-10-25T00:30:00Z", gt_format_utc(u));

w = gt_window_on(ber, gt_parse_date("2026-10-24"), gt_parse_clock("22:00"), gt_parse_clock("06:00"));
check("22:00-06:00 across the fall back is 9 hours", w.end - w.start == 9 * 3600, std.string((w.end - w.start) / 3600));

w = gt_window_on(ber, gt_parse_date("2026-03-28"), gt_parse_clock("22:00"), gt_parse_clock("06:00"));
check("22:00-06:00 across the spring forward is 7 hours", w.end - w.start == 7 * 3600, std.string((w.end - w.start) / 3600));

w = gt_window_on(ber, gt_parse_date("2026-07-01"), gt_parse_clock("04:00"), gt_parse_clock("10:00"));
check("summer 04:00 Berlin is 02:00 UTC", gt_format_utc(w.start) == "2026-07-01T02:00:00Z", gt_format_utc(w.start));

syd = gt_tz_parse_posix(GT_ZONES["Australia/Sydney"]);
check("Sydney: January is daylight time (+11)", gt_offset_at(syd, at(ber, "2026-01-15", "12:00")) == 11 * 3600, "");
check("Sydney: July is standard time (+10)", gt_offset_at(syd, at(ber, "2026-07-15", "12:00")) == 10 * 3600, "");

ny = gt_tz_parse_posix(GT_ZONES["America/New_York"]);
check("New York switches on the 2nd Sunday of March", gt_is_dst(ny, gt_parse_date("2026-03-08") * GT_DAY + 8 * 3600) && !gt_is_dst(ny, gt_parse_date("2026-03-08") * GT_DAY + 6 * 3600), "");

check("half hour zone (Kolkata +05:30)", gt_tz_parse_posix(GT_ZONES["Asia/Kolkata"]).std_off == 19800, "");
check("unknown zone is an error", !gt_zone("Mars/Olympus").ok, "");
check("a POSIX rule is accepted directly", gt_zone("CET-1CEST,M3.5.0,M10.5.0/3").ok, "");
check("weekday of 2026-10-19 is Monday", gt_weekday(gt_parse_date("2026-10-19")) == 1, "");
check("weekday names (de/en)", gt_weekday_index("So") == 0 && gt_weekday_index("thursday") == 4 && gt_weekday_index("x") == -1, "");
check("durations", gt_parse_duration("1h30m") == 5400 && gt_parse_duration("45") == 2700 && std.is_none(gt_parse_duration("abc")), "");
check("clock 24:00 ok, 25:00 rejected", gt_parse_clock("24:00") == GT_DAY && std.is_none(gt_parse_clock("25:00")), "");
check("invalid date rejected", std.is_none(gt_parse_date("2026-02-30")), "");

// ═════════════════════════════════════════════════════════════════════════════
section("front matter");

doc = gfm_read_text("---\nid: a\nschedule:\n  type: recurring\n  days: [mon, \"tue\"]\n  start: \"05:00\"\nlist:\n  - x\n  - y: 1\n    z: 2\n---\n\n# Body\n");
check("parses nested maps and lists", doc.ok && doc.data.schedule.type == "recurring" && doc.data.schedule.days.size() == 2, doc.error);
check("parses list of maps", doc.ok && doc.data.list[1].z == 2, doc.error);
check("body follows the front matter", doc.body.starts("# Body"), doc.body);

bad = gfm_read_text("---\nid: a\n  oops: 1\n---\n");
check("bad indentation is an error with its file line", !bad.ok && bad.line == 3, bad.error + " line " + bad.line);

bad = gfm_read_text("---\nid: a\nid: b\n---\n");
check("duplicate keys are an error", !bad.ok && bad.error.contains("duplicate"), bad.error);

bad = gfm_read_text("---\nid: a\n");
check("unclosed front matter is an error", !bad.ok, "");

rt = gfm_read_text(gfm_compose(doc.data, doc.body));
check("compose -> parse round trip", rt.ok && rt.data.compact_string() == doc.data.compact_string(), rt.error);

// ═════════════════════════════════════════════════════════════════════════════
section("agentspace + validation");

space = GoalSpace(ROOT);
created = space.init(TEMPLATE);
check("init creates the tree from the template", fileio.exists(ROOT + "/preferences/scheduling.md") && fileio.is_directory(ROOT + "/goals/active") && created.size() > 3, std.string(created.size()));
check("init never overwrites", space.init(TEMPLATE).size() == 0, "");

prefs = space.preferences();
check("template preferences are valid", prefs.errors.size() == 0, gfm_join(prefs.errors, "; "));
// the tests pin the zone: the template says Europe/Berlin
check("template time zone is Europe/Berlin", gj_str(prefs, "timezone") == "Europe/Berlin", gj_str(prefs, "timezone"));
check("'tonight' means 04:00-10:00", gj_str(prefs.windows.tonight, "start") == "04:00" && gj_str(prefs.windows.tonight, "end") == "10:00", "");

for(f : space.folders()) {
	r = space.load(f, prefs);
	check("example goal " + f.id + " is valid", r.ok, gfm_join(r.errors, "; "));
}

v = goal_validate(std.json(), "", prefs, "x", "active");
check("empty front matter: title + schedule errors", !v.ok && v.errors.size() >= 2, gfm_join(v.errors, "; "));

v = goal_validate(gfm_read_text("---\ntitle: T\nschedule:\n  type: recurring\n  days: [funday]\n  start: \"25:00\"\n  timezone: Mars/X\npolicy:\n  stop_policy: explode\n---\nDo it\n").data, "Do it", prefs, "x", "active");
check("bad weekday / clock / zone / enum are all reported", !v.ok && v.errors.size() == 4, gfm_join(v.errors, "; "));

// The three requests of issue #477 as the interpreter would write them
tonight = goal_validate(gfm_read_text("---\ntitle: Explore a new app idea\nschedule:\n  type: once\n  date: 2026-10-20\n  window: tonight\n---\nExplore.\n").data, "Explore.", prefs, "app-idea", "active");
check("'tonight' goal: once, 04:00-10:00 from the preferences", tonight.ok && tonight.def.schedule.start == 4 * 3600 && tonight.def.schedule.end == 10 * 3600 && tonight.def.schedule.type == "once", gfm_join(tonight.errors, "; "));
tw = goal_next_windows(tonight.def, at(ber, "2026-10-19", "20:00"), 3);
check("'tonight' goal has exactly one window, 2026-10-20 04:00 CEST", tw.size() == 1 && gt_format_local(ber, tw[0].start).starts("2026-10-20 04:00"), tw.size() ? goal_window_text(tonight.def, tw[0]) : "none");

sunday = goal_validate(gfm_read_text("---\ntitle: Weekly repository maintenance\nschedule:\n  type: recurring\n  days: [sunday]\n  window: tonight\n---\nClean up.\n").data, "Clean up.", prefs, "weekly", "active");
sw = goal_next_windows(sunday.def, at(ber, "2026-10-19", "12:00"), 3);
check("'each Sunday' goal: weekly windows on Sundays", sunday.ok && sw.size() == 3 && gt_weekday(sw[0].day) == 0 && sw[1].day - sw[0].day == 7, "");

issues = goal_validate(gfm_read_text("---\ntitle: Fix GitHub issues\nschedule:\n  type: windowed\n  days: weekdays\n  window: tonight\n  start: \"05:00\"\n  end: \"10:00\"\n---\nFix.\n").data, "Fix.", prefs, "gh", "active");
check("'from 05:00 to 10:00' overrides the default window", issues.ok && issues.def.schedule.start == 5 * 3600 && issues.def.schedule.end == 10 * 3600, "");
check("windowed goals repeat inside their window", issues.def.policy.repeat_in_window && issues.def.policy.max_runs_per_window > 1, "");

// ═════════════════════════════════════════════════════════════════════════════
section("every N days (interval schedules)");

// "check the server logs every 2 days at 6:00 in the morning"
two = goal_validate(gfm_read_text("---\ntitle: Check the server logs\nschedule:\n  type: recurring\n  every: 2d\n  start: \"06:00\"\n  duration: 30m\n---\nRead the log.\n").data, "Read the log.", prefs, "log-check", "active");
check("every: 2d validates and normalises to 2 days", two.ok && two.def.schedule.every == 2 && two.def.schedule.days.size() == 0, gfm_join(two.errors, "; "));
check("the interval renders as 'every 2d'", goal_schedule_text(two.def).contains("every 2d"), goal_schedule_text(two.def));

anchor = gt_parse_date("2026-10-20");
iw = goal_next_windows(two.def, at(ber, "2026-10-20", "00:00"), 4, anchor);
check("the interval starts on the anchor day at 06:00", iw.size() == 4 && gt_format_local(ber, iw[0].start).starts("2026-10-20 06:00"), iw.size() ? goal_window_text(two.def, iw[0]) : "none");
check("windows are exactly 2 days apart", iw.size() == 4 && iw[1].day - iw[0].day == 2 && iw[2].day - iw[1].day == 2 && iw[3].day - iw[2].day == 2, iw.size() < 4 ? "too few windows" : std.string(iw[1].day - iw[0].day));
check("the interval window is 30 minutes", iw.size() && iw[0].end - iw[0].start == 1800, iw.size() ? std.string(iw[0].end - iw[0].start) : "none");
check("no anchor and no start_date: a stable epoch phase", goal_next_windows(two.def, at(ber, "2026-10-20", "00:00"), 2).size() == 2, "");

ph = goal_validate(gfm_read_text("---\ntitle: Phased\nschedule:\n  type: recurring\n  every: 3d\n  start_date: 2026-10-21\n  start: \"06:00\"\n  duration: 30m\n---\nWork.\n").data, "Work.", prefs, "phase", "active");
pw = goal_next_windows(ph.def, at(ber, "2026-10-20", "00:00"), 3, gt_parse_date("2026-10-30"));
check("start_date phases the interval (and wins over the anchor)", ph.ok && pw.size() == 3 && gt_format_local(ber, pw[0].start).starts("2026-10-21 06:00") && pw[1].day - pw[0].day == 3, pw.size() ? goal_window_text(ph.def, pw[0]) : "none");

wdw = goal_validate(gfm_read_text("---\ntitle: Windowed interval\nschedule:\n  type: windowed\n  every: 2d\n  start: \"05:00\"\n  end: \"10:00\"\n---\nWork.\n").data, "Work.", prefs, "wintr", "active");
check("every works for type windowed too", wdw.ok && wdw.def.schedule.every == 2 && wdw.def.policy.repeat_in_window, gfm_join(wdw.errors, "; "));

ntv = goal_validate(gfm_read_text("---\ntitle: Every 2 days tonight\nschedule:\n  type: recurring\n  every: 2d\n  window: tonight\n---\nWork.\n").data, "Work.", prefs, "niter", "active");
nw2 = goal_next_windows(ntv.def, at(ber, "2026-10-20", "00:00"), 3, gt_parse_date("2026-10-20"));
check("every combines with a named window", ntv.ok && ntv.def.schedule.start == 4 * 3600 && nw2.size() == 3 && nw2[1].day - nw2[0].day == 2 && gt_format_local(ber, nw2[0].start).starts("2026-10-20 04:00"), gfm_join(ntv.errors, "; ") + " " + (nw2.size() ? goal_window_text(ntv.def, nw2[0]) : "none"));

bnd = goal_validate(gfm_read_text("---\ntitle: Bounded interval\nschedule:\n  type: recurring\n  every: 2d\n  start: \"06:00\"\n  duration: 30m\n  end_date: 2026-10-25\n---\nWork.\n").data, "Work.", prefs, "bnd", "active");
bw = goal_next_windows(bnd.def, at(ber, "2026-10-20", "00:00"), 6, gt_parse_date("2026-10-20"));
check("end_date bounds the interval", bnd.ok && bw.size() == 3 && gt_format_local(ber, bw[2].start).starts("2026-10-24"), std.string(bw.size()));

both = goal_validate(gfm_read_text("---\ntitle: T\nschedule:\n  type: recurring\n  days: [monday]\n  every: 2d\n  start: \"06:00\"\n---\nWork.\n").data, "Work.", prefs, "x", "active");
check("days + every is refused", !both.ok && gfm_join(both.errors, "; ").contains("either days or every"), gfm_join(both.errors, "; "));

oncev = goal_validate(gfm_read_text("---\ntitle: T\nschedule:\n  type: once\n  date: 2026-10-25\n  every: 2d\n  start: \"06:00\"\n---\nWork.\n").data, "Work.", prefs, "x", "active");
check("every is refused for type once", !oncev.ok && gfm_join(oncev.errors, "; ").contains("recurring or windowed"), gfm_join(oncev.errors, "; "));

bare = goal_validate(gfm_read_text("---\ntitle: T\nschedule:\n  type: recurring\n  every: 2\n  start: \"06:00\"\n---\nWork.\n").data, "Work.", prefs, "x", "active");
check("a bare number is refused (in a duration it would mean minutes)", !bare.ok && gfm_join(bare.errors, "; ").contains("day unit"), gfm_join(bare.errors, "; "));

part = goal_validate(gfm_read_text("---\ntitle: T\nschedule:\n  type: recurring\n  every: 36h\n  start: \"06:00\"\n---\nWork.\n").data, "Work.", prefs, "x", "active");
check("a part-day interval is refused", !part.ok && gfm_join(part.errors, "; ").contains("whole days"), gfm_join(part.errors, "; "));

big = goal_validate(gfm_read_text("---\ntitle: T\nschedule:\n  type: recurring\n  every: 400d\n  start: \"06:00\"\n---\nWork.\n").data, "Work.", prefs, "x", "active");
check("an interval over a year is refused", !big.ok && gfm_join(big.errors, "; ").contains("365d"), gfm_join(big.errors, "; "));

// the trap: a key the scheduler does not read used to be dropped without a word
trap = goal_validate(gfm_read_text("---\ntitle: T\nschedule:\n  type: recurring\n  interval: 2d\n  start: \"06:00\"\n---\nWork.\n").data, "Work.", prefs, "x", "active");
check("an unknown schedule key warns (the silent daily degradation is visible)", trap.ok && gfm_join(trap.warnings, "; ").contains("schedule.interval"), gfm_join(trap.warnings, "; "));
check("the warned goal is still valid: warnings are not errors", trap.ok && std.is_none(trap.def.schedule.every) && trap.def.schedule.days.size() == 7, gfm_join(trap.errors, "; "));

polw = goal_validate(gfm_read_text("---\ntitle: T\nschedule:\n  type: recurring\n  start: \"06:00\"\npolicy:\n  max_paralell_workers: 2\n---\nWork.\n").data, "Work.", prefs, "x", "active");
check("a typo in a policy key is reported", polw.ok && gfm_join(polw.warnings, "; ").contains("policy.max_paralell_workers"), gfm_join(polw.warnings, "; "));

// ═════════════════════════════════════════════════════════════════════════════
section("scheduler: activation, idempotency, restart");

GH = R"(---
id: gh-issues
title: Resolve eligible GitHub issues
schedule:
  type: recurring
  days: weekdays
  start: "05:00"
  end: "10:00"
  timezone: Europe/Berlin
policy:
  max_attempts: 3
  retry_backoff: 5m
---

# Objective

Resolve eligible issues.
)";

write_goal_file("active", "gh-issues", GH);

clk = FakeClock();
clk.t = at(ber, "2026-10-19", "04:59");

host = FakeHost();
sch = GoalScheduler(ROOT, host, [notify = true]);
sch.clock = [clk]() { return clk.t; };

sch.tick();
check("before the window: nothing activated", count_activations(sch, "gh-issues") == 0 && host.tasks.size() == 0, "");

clk.t = at(ber, "2026-10-19", "05:00") + 20;
sch.tick();
check("window start: one activation", count_activations(sch, "gh-issues") == 1, "");
check("window start: one task dispatched", host.tasks.size() == 1 && host.tasks[0].name == "Goal-gh-issues", std.string(host.tasks.size()));
check("the prompt carries the instructions and the window", host.tasks.size() && host.tasks[0].task.contains("Resolve eligible issues.") && host.tasks[0].task.contains("05:00 CEST"), "");
check("the start is announced", notes_with(host, "Goal gh-issues starts") == 1, std.string(host.notes));

sch.tick();
sch.tick();
check("more ticks: still one activation, one task", count_activations(sch, "gh-issues") == 1 && host.tasks.size() == 1, "");

// restart: a new process, the host lost its in-memory tasks
clk.t = at(ber, "2026-10-19", "05:10");
host2 = FakeHost();
sch2 = GoalScheduler(ROOT, host2, [notify = true]);
sch2.clock = [clk]() { return clk.t; };
sch2.tick();
check("restart: no second activation for the same window", count_activations(sch2, "gh-issues") == 1, "");
check("restart: the interrupted run is recorded", has_event(sch2, "run_interrupted", "gh-issues"), "");
check("restart: the run is retried on the new host", host2.tasks.size() == 1, std.string(host2.tasks.size()));

sch2.tick();
check("restart: no duplicate retry", host2.tasks.size() == 1, std.string(host2.tasks.size()));

host2.finish("t1", "finished", "Fixed issue #12, tests pass.");
sch2.tick();
akey = "";
for(k, a : sch2.ledger.data.activations)
	akey = k;
act = sch2.ledger.data.activations[akey];
check("finished run closes the window (no repeat)", act.state == "done", act.state);
check("no new run after success", host2.tasks.size() == 1, "");
check("history.md got an entry", goal_read(ROOT + "/goals/active/gh-issues/history.md").contains("Fixed issue #12"), "");
check("the run records the definition revision", act.runs[act.runs.size() - 1].revision == act.revision && act.revision != "", "");

// ═════════════════════════════════════════════════════════════════════════════
section("scheduler: failures and retries");

clk.t = at(ber, "2026-10-20", "05:00") + 5;
sch2.tick();
check("next weekday: new activation", count_activations(sch2, "gh-issues") == 2 && host2.tasks.size() == 2, "");

host2.finish("t2", "failed", "build broke");
clk.t += 60;
sch2.tick();
check("a failure schedules a retry, not an immediate run", host2.tasks.size() == 2 && has_event(sch2, "retry_scheduled", "gh-issues"), "");
clk.t += 5 * 60;
sch2.tick();
check("the retry runs after the backoff", host2.tasks.size() == 3, std.string(host2.tasks.size()));
host2.finish("t3", "failed", "still broken");
clk.t += 60;
sch2.tick();
clk.t += 5 * 60;
sch2.tick();
check("the third attempt runs", host2.tasks.size() == 4, std.string(host2.tasks.size()));
host2.finish("t4", "failed", "broken again");
clk.t += 60;
sch2.tick();
clk.t += 10 * 60;
sch2.tick();
check("max_attempts ends the window as failed", host2.tasks.size() == 4 && notes_with(host2, "no attempts left") == 1, std.string(host2.tasks.size()));

// ═════════════════════════════════════════════════════════════════════════════
section("scheduler: window end and stop policy");

WIN = R"(---
id: nightly-fixes
title: Nightly fixes
schedule:
  type: windowed
  days: daily
  start: "22:00"
  end: "23:00"
  timezone: Europe/Berlin
policy:
  stop_policy: checkpoint
  checkpoint_grace: 10m
  min_remaining: 15m
---

Fix things repeatedly.
)";
write_goal_file("active", "nightly-fixes", WIN);

clk.t = at(ber, "2026-10-20", "22:00") + 5;
sch2.tick();
n0 = host2.tasks.size();
check("windowed goal dispatches", n0 == 5, std.string(n0));
host2.finish("t5", "finished", "fixed one");
clk.t += 60;
sch2.tick();
check("windowed goal repeats after a finished run", host2.tasks.size() == 6, std.string(host2.tasks.size()));
check("the next run sees the previous report", host2.tasks[5].task.contains("fixed one"), "");

clk.t = at(ber, "2026-10-20", "23:00") + 1;
sch2.tick();
check("window end asks the running task to checkpoint", host2.updates.size() == 1 && host2.updates[0].taskid == "t6", std.string(host2.updates.size()));
check("window end does not stop at once", host2.stops.size() == 0, "");
clk.t += 11 * 60;
sch2.tick();
check("after the grace the task is stopped", host2.stops.size() == 1 && host2.stops[0] == "t6", std.string(host2.stops));
host2.finish("t6", "stopped", "");
clk.t += 30;
sch2.tick();
nact = None;
for(k, a : sch2.ledger.data.activations) {
	if(a.goal == "nightly-fixes")
		nact = a;
}
check("a requested stop is not a failure: the window is done", nact.state == "done", nact.state);
check("nothing new is admitted after the window", host2.tasks.size() == 6, "");

// ═════════════════════════════════════════════════════════════════════════════
section("scheduler: misfire policies");

space.move("nightly-fixes", "paused");
space.move("gh-issues", "archived");

MIS = R"(---
id: mis-[ID]
title: Misfire [ID]
schedule:
  type: recurring
  days: daily
  start: "06:00"
  end: "09:00"
  timezone: Europe/Berlin
  misfire: [P]
---

Misfire test.
)";

// the goals exist (scheduler sees them) before their windows
clk.t = at(ber, "2026-10-21", "01:00");
write_goal_file("active", "mis-skip", MIS.replace("[ID]", "skip").replace("[P]", "skip"));
write_goal_file("active", "mis-run-if-open", MIS.replace("[ID]", "run-if-open").replace("[P]", "run_if_open"));
write_goal_file("active", "mis-catch-up", MIS.replace("[ID]", "catch-up").replace("[P]", "catch_up"));
sch2.tick();

// the scheduler is down from 01:00 until 07:00: the windows started without it
clk.t = at(ber, "2026-10-21", "07:00");
host3 = FakeHost();
sch3 = GoalScheduler(ROOT, host3, [notify = true]);
sch3.clock = [clk]() { return clk.t; };
sch3.tick();
check("misfire skip: a late window is skipped", has_event(sch3, "window_skipped", "mis-skip"), "");
check("misfire run_if_open: a late window still runs", has_event(sch3, "window_activated", "mis-run-if-open"), "");

// down for the whole next window
clk.t = at(ber, "2026-10-22", "10:00");
host4 = FakeHost();
sch4 = GoalScheduler(ROOT, host4, [notify = true]);
sch4.clock = [clk]() { return clk.t; };
sch4.tick();
check("a window missed entirely is recorded as missed", has_event(sch4, "window_missed", "mis-run-if-open"), "");
check("misfire catch_up runs the missed window once, now", has_event(sch4, "window_catch_up", "mis-catch-up") && count_activations(sch4, "mis-catch-up") >= 1, "");
nmissed = 0;
for(m : host4.notes) {
	if(std.string(m).contains("missed"))
		nmissed++;
}
check("missed windows are reported to the owner", nmissed >= 1, std.string(host4.notes));

for(id : ["mis-skip", "mis-run-if-open", "mis-catch-up"])
	space.move(id, "archived");
sch4.tick();
check("archived goals keep their running task (drain)", host4.open_tasks() > 0 && host4.stops.size() == 0, std.string(host4.open_tasks()));
finish_open(host4, sch4);
check("max_background_tasks is free again", sch4.background_running() == 0, std.string(sch4.background_running()));

