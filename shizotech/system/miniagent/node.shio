// ═════════════════════════════════════════════════════════════════════════════
//  node.shio — the command line of a Node (the class is in node_lib.shio)
//
//  Usage:   shz miniagent --node                       a node on ShizoNet (headless)
//           shz miniagent --node --web [--port 13337]  ... with the web interface
//           shz miniagent --node --webserver --port N  ... with the JSON API only
//           shz miniagent --node --interactive         ... with a console
//           shz miniagent --init [<dir>] [--name X]    register a directory as a
//                                                      workspace, then return
//           (shz miniagent.node ... is the same without the --node flag)
//
//  Options: --name <node name>  --description <text>
//           --config <name|path[#profile]>   the model of the workers
//           --workspace <dir>                register <dir> as a workspace at start
//                                            (may be given several times)
//           --api-token <t>                  token of the HTTP API / the web pages
//           --agentspace <dir> | --no-goals  the node's own scheduled goals
//           --data-dir <dir>                 storage root instead of
//                                            std.user_path()/miniagent
//           --no-gateway                     do not start the Telegram gateway
//                                            that is set up in the web interface
//           and the model config flags: --list-configs, --new-config,
//           --save-config, --config-url / -token / -model ...
//
//  A node uses the workspaces that are registered on this machine
//  (std.user_path()/miniagent/workspaces): --init, --workspace or the web
//  interface add one. A workspace created without a path gets a new folder
//  ./workspaces/<name> below the directory the node was started in.
// ═════════════════════════════════════════════════════════════════════════════

#include "node_lib"

node_flag_present(flag) {
    for(_i = 1; _i < std.argc(); _i++) {
        a = std.string(std.argv(_i) ?? "");

        if(a == flag || a.starts(flag + "="))
            return true;
    }

    return false;
}

// every value of a flag that may be given several times (--workspace a --workspace=b)
node_flag_values(flag) {
    out = [];

    for(_i = 1; _i < std.argc(); _i++) {
        a = std.string(std.argv(_i) ?? "");

        if(a.starts(flag + "=")) {
            out.push_back(a.substr(flag.length() + 1));
        } else if(a == flag && _i + 1 < std.argc()) {
            v = std.string(std.argv(_i + 1) ?? "");

            if(v && !v.starts("--"))
                out.push_back(v);
        }
    }

    return out;
}

// --init, --init <dir>, --init=<dir>: the directory ("" = the current one)
node_init_dir() {
    v = node_flag_values("--init");
    return v.size() ? std.string(v[0]) : "";
}

node_print_registered(res, how) {
    w = res.workspace;

    if(res.reused)
        std.print("Workspace already registered: " + std.string(w.name) + " [" + std.string(w.id) + "] " + std.string(w.path));
    else
        std.print("Workspace registered" + how + ": " + std.string(w.name) + " [" + std.string(w.id) + "] " + std.string(w.path));
}

node_value_flags() {
    return [
        "--name",
        "--description",
        "--port",
        "--api-token",
        "--max-workers",
        "--workers",
        "--agentspace",
        "--workspace",
        "--data-dir",
        "--init",
    ];
}

node_get_int_option(flag_a, flag_b = None, def = 0) {
    value = std.argvoption(flag_a);

    if(!value && flag_b)
        value = std.argvoption(flag_b);

    if(value)
        return std.int(value);

    return def;
}

// --web: the web interface (web_ui.shio), the JSON API is part of it
node_is_web_ui_mode() {
    return web_ui_parse(web_ui_args()).web;
}

// --webserver / --port without --web: the JSON API only
node_is_api_mode() {
    if(node_is_web_ui_mode())
        return false;

    if(model_config_cli_has_flag("--webserver"))
        return true;

    return std.argvoption("--port") ? true : false;
}

// Resolve a CLI config spec to an absolute file path plus its #profile.
node_config_spec(spec) {
    parts = model_config_split_profile(spec);
    path = model_config_resolve_existing(spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);

    if(!path)
        path = model_config_resolve(spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);

    abs = fileio.absolute_path(std.string(path));

    if(parts.profile)
        return abs + "#" + std.string(parts.profile);

    return abs;
}

last_state = "";

node_console_print(action) {
    if(action.text) {
        if(last_state != "text")
            last_state = "text";
            std.cout("\n");
        stdfcol("white");
        std.cout(action.text);
    }

    if(action.reasoning) {
        if(last_state != "reasoning")
            last_state = "reasoning";
            std.cout("\n");
        stdfcol("yellow");
        std.cout(action.reasoning);
    }

    if(action.tool_start) {
        last_state = "tool";
        stdfcol("yellow");
        std.cout("\n\n[TOOL] ", action.tool_start.name, "\n");
        stdfcol("white");
    }
}

// the .agentspace this node schedules goals from ("" = goals off)
node_goals_root() {
    if(model_config_cli_has_flag("--no-goals"))
        return "";

    r = std.argvoption("--agentspace");

    if(r)
        return std.string(r);

    return miniagent_node_agentspace();
}

node_print_goals(sch) {
    if(!sch) {
        std.cout("Goals are off (--no-goals).\n");
        return;
    }

    list = sch.overview();

    if(!list.size()) {
        std.cout("No goals in " + sch.space.root + "/goals/.\n");
        return;
    }

    for(g : list) {
        line = "[" + gj_str(g, "status", "") + "] " + gj_str(g, "id", "") + " - " + gj_str(g, "title", "");
        if(gj_str(g, "schedule", ""))
            line += "\n    " + g.schedule;
        if(gj_str(g, "active_window", ""))
            line += "\n    now: " + g.active_window + " (" + gj_str(g, "active_state", "") + ")";
        else if(gj_str(g, "next_window", "") && gj_str(g, "status", "") == "active")
            line += "\n    next: " + g.next_window;
        if(gj_str(g, "last_outcome", ""))
            line += "\n    last: " + g.last_outcome;
        if(gj(g, "invalid_edit", false))
            line += "\n    ! the file has an invalid edit: " + gfm_join(gj(g, "errors", []), "; ");
        std.cout(line + "\n");
    }
}

node_print_workspaces(node, current) {
    for(w : node.workspaces_summary()) {
        mark = (w.id == current) ? " *" : "  ";
        std.cout(mark + " " + std.string(w.name) + "  [" + std.string(w.id) + "]  " + std.string(w.path) + "\n");
    }
}

node_print_peers(node) {
    if(!node.peers) {
        std.cout("Not on ShizoNet.\n");
        return;
    }

    list = node.peers.list();

    if(!list.size()) {
        std.cout("No other AI node or gateway on the network right now.\n");
        return;
    }

    for(p : list)
        std.cout("  " + (p.online ? "online " : "offline") + "  " + std.string(p.kind) + "  " + std.string(p.name) + "  " + std.string(p.ip) + "  " + std.string(p.model) + "\n");
}

node_console_help() {
    std.cout(
        "\n/workspaces            the workspaces of this node (* = the current one)\n" +
        "/use <id|name>         the workspace plain text goes to (default: General)\n" +
        "/overview              the tasks of every workspace\n" +
        "/status                session statistics\n" +
        "/goals                 the node's scheduled goals\n" +
        "/nodes                 the other AI nodes and gateways on ShizoNet\n" +
        "/config  /configs      the model config, the configs there are\n" +
        "/exit                  quit\n\n" +
        "plain text is a task for a worker in the current workspace\n"
    );
}

// ─────────────────────────────────────────────────────────────────────────────
//  shz miniagent --init [<dir>] [--name X]
// ─────────────────────────────────────────────────────────────────────────────

if(node_flag_present("--init")) {
    res = node_register_workspace(node_init_dir(), std.string(std.argvoption("--name") ?? ""));

    if(!res.ok) {
        std.error("[miniagent] --init failed: ", res.error);
        std.exitprocess(1);
    }

    node_print_registered(res, "");
    w = res.workspace;

    if(fileio.exists(w.path + "/AGENTS.md"))
        std.print("Initialized .megamind and .agentspace; AGENTS.md is present.");
    else
        std.print("Initialized .megamind and .agentspace; AGENTS.md was not created.");

    std.print("Start the node with: shz miniagent --node [--web]");
    return;
}

// ─────────────────────────────────────────────────────────────────────────────
//  the model of the workers
// ─────────────────────────────────────────────────────────────────────────────

cfg = ModelConfig();

if(model_config_cli_handle_config_commands(
    MODEL_CONFIG_PACKAGE,
    MODEL_CONFIG_DEFAULT_KEY,
    ["worker-"]
))
    return;

// --config is the model of the node's workers; --worker-config is its old name
cfg_spec = std.argvoption("--config");
worker_spec = std.argvoption("--worker-config");

if(worker_spec)
    cfg_spec = worker_spec;

if(std.argvoption("--receptionist-config"))
    std.warn("--receptionist-config is ignored: a node has no receptionist agent any more, --config is the model of its workers.");

if(model_config_cli_has_endpoint_args("worker-")) {
    if(!model_config_cli_make(cfg, cfg_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY, "worker-", false, false))
        return;
} else if(!model_config_cli_get(cfg, cfg_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY, true, true, "Node", "config-")) {
    return;
}

save_spec = std.argvoption("--save-config");

if(!save_spec)
    save_spec = std.argvoption("--save-worker-config");

if(save_spec)
    model_config_save_spec(cfg, save_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);

model_config_cli_print_loaded("Model config", cfg, cfg_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);

max_workers = node_get_int_option("--max-workers", "--workers", 1);

if(max_workers <= 0)
    max_workers = 1;

worker_cfg_spec = node_config_spec(cfg_spec);

node = Node(cfg, worker_cfg_spec, max_workers, std.argvoption("--name"), std.argvoption("--description"));

// ── the workspaces of this machine + the node's own one ──────────────────────
node.ensure_workspace_registry();

for(dir : node_flag_values("--workspace")) {
    res = node_register_workspace(dir, "", node.registry.store);

    if(!res.ok) {
        std.error("[miniagent] --workspace " + dir + ": ", res.error);
        continue;
    }

    node.registry.ensure(res.workspace);
    node_print_registered(res, " (--workspace)");
}

// ── HTTP: the web interface or the JSON API alone ───────────────────────────
web_ui_mode = node_is_web_ui_mode();
api_mode = node_is_api_mode();
http_failed = false;

if(web_ui_mode) {
    opts = web_ui_parse(web_ui_args());
    ui = node.start_web(opts);

    if(ui)
        std.print("Web interface: http://127.0.0.1:" + opts.port + "/");
    else
        http_failed = true;
} else if(api_mode) {
    api_port = std.int(std.argvoption("--port"));

    if(api_port <= 0)
        api_port = 13337;

    if(node.start_api(api_port, std.string(std.argvoption("--api-token") ?? "")))
        std.print("Node JSON API: http://localhost:" + api_port + "/api/health");
    else
        http_failed = true;
}

if(http_failed) {
    std.error("Could not start the HTTP server (the port is in use?).");
    node.stop();
    std.exitprocess(1);
}

// ── ShizoNet: the AI node service, the peers, the API for the other nodes ───
node.start_shizonet();

// ── scheduled goals of the node (its own workspace) ─────────────────────────
goals_root = node_goals_root();

if(goals_root)
    node.start_node_goals(goals_root);
else
    node.disable_node_goals();

scheduler_count = 0;

for(w : node.registry.list()) {
    if(w.scheduler)
        scheduler_count++;
}

std.print("Workspaces: " + std.string(node.workspaces_summary().size()) + "  goal schedulers running: " + std.string(scheduler_count));
std.print("New workspaces without a path go to " + node.registry.store.projects_dir);

// ── the Telegram gateway that was set up in the web interface ───────────────
gateway = GatewayRunner(cfg_spec ? std.string(cfg_spec) : "");
node.gateway = gateway;

if(!model_config_cli_has_flag("--no-gateway"))
    gateway.autostart();

// ── console / headless ──────────────────────────────────────────────────────
if(model_config_cli_has_flag("--interactive")) {
    node_console_help();
    current = "node";

    for(1) {
        std.color("green");
        std.cout("\n>>> (" + current + ") ");

        cmd = std.input().strip();

        if(cmd == "exit" || cmd == "/exit")
            break;

        if(cmd.empty()) {
            std.sleep(100);
            continue;
        }

        if(cmd == "/help") {
            node_console_help();
            continue;
        }

        if(cmd == "/workspaces") {
            node_print_workspaces(node, current);
            continue;
        }

        if(cmd.starts("/use")) {
            want = cmd.removeprefix("/use").strip();
            w = node.resolve_workspace(want);

            if(!w)
                std.cout("No workspace '" + want + "'. /workspaces lists them.\n");
            else
                current = std.string(w.id);
            continue;
        }

        if(cmd == "/config") {
            model_config_cli_print_loaded("Model config", cfg, cfg_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);
            std.print("Worker config spec: ", node.worker_cfg_spec, "\n");
            continue;
        }

        if(cmd == "/configs") {
            model_config_cli_list(MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);
            continue;
        }

        if(cmd == "/goals") {
            node_print_goals(node.goals);
            continue;
        }

        if(cmd == "/nodes") {
            node_print_peers(node);
            continue;
        }

        if(cmd == "/overview") {
            std.print(std.string(node.get_overview()), "\n");
            continue;
        }

        if(cmd == "/status") {
            std.print(std.string(node.registry.manager.stats()), "\n");
            continue;
        }

        if(cmd.starts("/")) {
            std.cout("unknown command. /help\n");
            continue;
        }

        try {
            res = node.request(cmd, None, node_console_print, current);
            stdfcol("white");
            std.cout("\n\n" + std.string(res.reports[0].report) + "\n");
        } catch(e) {
            std.error("the request failed: ", e);
        }
    }
} else {
    std.print("AI node '" + node.node_name() + "' is running. Ctrl+C to stop.\n");

    for(node.running)
        std.sleep(250);
}

gateway.stop();
node.stop();
std.cout("\nNode stopped.\n");
