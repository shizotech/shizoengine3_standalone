
// ═════════════════════════════════════════════════════════════════════════════
//  Mind host — runnable entry point for the Receptionist + Mind runtime
//
//  Usage:   shz node.shio                       interactive (shizonet is on too)
//           shz node.shio --interactive --config gpu
//           shz node.shio --name Box --description "GPU box"   headless AI node
//           shz node.shio --webserver --port 13337             + JSON web API
//           shz node.shio --port 13337 --api-token secret
//
//  Model configs:
//           --config <name|path[#profile]>
//           --receptionist-config <name|path[#profile]>
//           --worker-config <name|path[#profile]>
//           --new-config <name|path[#profile]>
//           --new-receptionist-config <name|path[#profile]>
//           --new-worker-config <name|path[#profile]>
//           --save-config <name|path[#profile]>
//           --save-receptionist-config <name|path[#profile]>
//           --save-worker-config <name|path[#profile]>
//           --list-configs
//           --config-path
//
//  Non-interactive endpoint creation:
//           --config-url --config-token --config-model --config-context --config-agents
//           --receptionist-url ... / --worker-url ...
//
//  The host owns:
//    - one Receptionist agent (the router for user requests)
//    - the event dispatcher (runs Minds as short-lived LLM invocations)
//
//  ShizoNet is the de-facto transport: every node runs the AI node service
//  (shizonet_ai.shio, contract in router_api.md) so routers on the network can
//  delegate work, read the overview and receive ai_event pushes.
//
//  In --webserver / --port mode the node ALSO serves a headless JSON web API:
//  POST /api/request with {"prompt": "..."} and poll /api/request/poll for the
//  deltas. Every endpoint is documented in node_api.shio.
//
//  Host commands:
//    /overview            all Minds and their lifecycle states
//    /actions [n]         compressed recent action history
//    /status              dispatcher + store statistics
//    /mind <id>           full detail of one Mind
//    /message <id> <text> enqueue a message into a Mind's mailbox
//    /stop <id>           request a Mind to stop
//    /notify [level]      show/set event notification level: all | notify | off
//    /config              show receptionist + worker config paths
//    /configs             list model configs
//    /clear               clear the receptionist transcript
//    /help                this list
//    /exit                quit
// ═════════════════════════════════════════════════════════════════════════════

#include "megamind"
#include "mcp/mcp_server"
#include "node_api"
#include "shizonet_ai"
#include "model_config_cli"

node_value_flags() {
	return [
		"--name",
		"--description",
		"--port",
		"--api-token",
		"--max-workers",
		"--workers",
	];
}

node_get_int_option(flag_a, flag_b = None, def = 0) {
	value = std.argvoption(flag_a);

	if(!value && flag_b)
		value = std.argvoption(flag_b);

	if(value)
		return std.int(value);

	return def;
}

node_has_headless_identity() {
	name_opt = std.argvoption("--name");
	desc_opt = std.argvoption("--description");

	if(name_opt)
		return true;
	if(desc_opt)
		return true;

	return false;
}

node_is_web_mode() {
	if(model_config_cli_has_flag("--webserver"))
		return true;

	port_opt = std.argvoption("--port");

	if(port_opt)
		return true;

	return false;
}

node_is_interactive_mode() {
	if(model_config_cli_has_flag("--interactive"))
		return true;

	if(std.argc() == 1)
		return true;

	if(node_is_web_mode())
		return false;

	if(node_has_headless_identity())
		return false;

	prompt = model_config_cli_positional_prompt(node_value_flags());

	if(prompt)
		return false;

	return true;
}

node_same_spec(a, b) {
	sa = "";
	sb = "";

	if(a)
		sa = std.string(a);
	if(b)
		sb = std.string(b);

	return sa == sb;
}

last_state = "";

mind_host_print(action) {
	if(action.text) {
		if(last_state != "text")
			last_state = "text";
			std.cout("\n");
		stdfcol("white");
		std.cout(action.text);
	}

	if(action.reasoning) {
		if(last_state != "reasoning")
			last_state = "reasoning";
			std.cout("\n");
		stdfcol("yellow");
		std.cout(action.reasoning);
	}

	if(action.tool_start) {
		stdfcol("yellow");
		std.cout("\n\n[TOOL] ", action.tool_start.name, "\n");
		stdfcol("white");
	}
}

mind_host_report(agt) {
	std.cout("\nTOKEN USAGE:\n");
	token_usage_global = std.global("_global_token_usage");
	std.cout(token_usage_global["usage"]);
}

node_host_help() {
	std.cout(
		"\n/config                show receptionist + worker config paths\n" +
		"/configs               list model configs\n" +
		"/overview              all Minds and their lifecycle states\n" +
		"/status                dispatcher + store statistics\n" +
		"/clear                 clear the receptionist transcript\n" +
		"/exit                  quit\n\n" +
		"plain text is a request to the receptionist\n"
	);
}

// ─────────────────────────────────────────────────────────────────────────────

cfg = ModelConfig();
worker_cfg = ModelConfig();

if(model_config_cli_handle_config_commands(
	MODEL_CONFIG_PACKAGE,
	MODEL_CONFIG_DEFAULT_KEY,
	["receptionist-", "worker-"]
))
	return;

main_spec = std.argvoption("--config");
rec_spec = std.argvoption("--receptionist-config");
worker_spec = std.argvoption("--worker-config");

if(!rec_spec)
	rec_spec = main_spec;

if(!worker_spec)
	worker_spec = main_spec;

if(!model_config_cli_get(cfg, rec_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY, true, true, "Receptionist", "receptionist-"))
	return;

if(!node_same_spec(worker_spec, rec_spec)) {
	if(!model_config_cli_get(worker_cfg, worker_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY, true, true, "Worker", "worker-"))
		return;
}
else {
	worker_cfg.copy_from(cfg);
}

save_main = std.argvoption("--save-config");

if(save_main)
	model_config_save_spec(cfg, save_main, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);

save_rec = std.argvoption("--save-receptionist-config");

if(save_rec)
	model_config_save_spec(cfg, save_rec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);

save_worker = std.argvoption("--save-worker-config");

if(save_worker)
	model_config_save_spec(worker_cfg, save_worker, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);

model_config_cli_print_loaded("Receptionist config", cfg, rec_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);
model_config_cli_print_loaded("Worker config", worker_cfg, worker_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);

max_workers = node_get_int_option("--max-workers", "--workers", 1);

if(max_workers <= 0)
	max_workers = 1;

host = Megamind(cfg, worker_cfg, max_workers);
host.on_action(mind_host_print);

// ── shizonet AI node service: always on, the de-facto transport ─────────────
//  shizonet_ai.shio implements the router_api.md contract on this server:
//  ai_request / ai_overview / ai_task_* answers + ai_event pushes.
//  The JSON web API is opt-in and runs ALONGSIDE the shizonet node.

var node_name = std.argvoption("--name");
var node_desc = std.argvoption("--description");

node = shizonet.server(node_name);

ai = ai_node_attach(node, host, [
	name = node_name,
	description = node_desc,
	model = cfg.name,
]);

std.print("Shizonet AI node online: " + ai.node_name());

interactive_mode = node_is_interactive_mode();
web_mode = node_is_web_mode();
prompt = model_config_cli_positional_prompt(node_value_flags());

// ── interactive mode ────────────────────────────────────────────────────────

if(interactive_mode) {
	node_host_help();

	for(1) {
		std.color("green");
		std.cout("\n>>> (user) ");

		cmd = std.input().strip();

		if(cmd == "exit" || cmd == "/exit")
			break;

		if(cmd.empty()) {
			std.sleep(100);
			continue;
		}

		if(cmd == "/config") {
			model_config_cli_print_loaded("Receptionist config", cfg, rec_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);
			model_config_cli_print_loaded("Worker config", worker_cfg, worker_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);
			continue;
		}

		if(cmd == "/configs") {
			model_config_cli_list(MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);
			continue;
		}

		if(cmd == "/help") {
			node_host_help();
			continue;
		}

		if(cmd.starts("/")) {
			std.cout("unknown command. /help\n");
			continue;
		}

		try {
			host.request(cmd);
		}
		catch(e) {
			std.error("receptionist run failed: ", e);
		}

	}
}

// ── optional JSON web API, alongside shizonet ────────────────────────────────
else if(web_mode) {
	// ── headless JSON web API mode ───────────────────────────────────────────
	var port_opt = std.argvoption("--port");
	var token_opt = std.argvoption("--api-token");

	api_port = std.int(port_opt);
	api_token = "";

	if(api_port <= 0)
		api_port = 13337;

	if(token_opt)
		api_token = std.string(token_opt);

	std.print("Starting API server at " + api_port);

	api = node_api_start(host, cfg, api_port, api_token);

	if(!api)
		std.error("Could not start the API server on port ", api_port, ".");
	else {
		std.print("Node JSON API: http://localhost:" + api_port + "/api/health\n");

		for(host.running)
			std.sleep(250);

		api.stop();
	}
}

// ── single-shot request ──────────────────────────────────────────────────────
else if(prompt) {
	std.cout("\n>>> (user) ", prompt, "\n");

	try {
		host.request(prompt);
	}
	catch(e) {
		std.error("receptionist run failed: ", e);
	}

	host.running = false;
}

// ── headless AI node ─────────────────────────────────────────────────────────
else {
	std.print("Headless AI node. Ctrl+C to stop.\n");
	std.sleep(-1);
}

ai.stop();
std.cout("\nHost stopped.\n");
