// ═════════════════════════════════════════════════════════════════════════════
//  telegram_router.shio — the Telegram front end of the Router: the README
//  example built for real (class TelegramRouter : Router).
//
//  Usage:  shz telegram_router.shio --bot-token 123456:ABCDEF...
//                [--name TelegramRouter] [--role router] [--poll 1000]
//                [--stall 900000] [--trusted <path>] [--no-stream]
//                [--verbose-events]
//
//  What it does:
//    * plain text from a TRUSTED chat is ONE router-agent turn: the agent
//      (roles/router) reads get_nodes(), picks the node and delegates. The
//      answer of the turn is sent back to that chat.
//    * the chat stays quiet. The owner sees only what deserves attention:
//      the router agent's answer, and EVERY terminal fact about a task on any
//      node — FINISHED / FAILED / LOST / STOPPED / a node QUESTION — carrying
//      the node's report and, for a failure/loss/stop, the reason from the
//      event's `error` field (C1). A task that reported nothing says so, it
//      never ends in a bare line. A task that makes no progress for stall_ms
//      (default 15 min) arrives exactly once per episode as [stalled] (C2).
//      A notify from a node is its report or its question to the owner.
//      /nodes shows per node whether it runs a goal system (goals).
//      Node online/offline, queued/running transitions and tool calls are NOT
//      sent. --verbose-events restores the full event stream (tg_events = "all").
//    * access control: only chats listed in the trusted_chats json are served.
//      No file / empty list -> the FIRST chat that messages the bot becomes the
//      trusted chat and is written to the file (bootstrap). Every other chat is
//      ignored (console log only, the bot never answers strangers).
//
//  trusted_chats json (default: std.config_path("miniagent","trusted_chats")):
//
//      {"chats":[{"chatid":123456,"name":"Peter","added":1700000000000}]}
//
//    * follow-ups: messages a chat sends in quick succession (Telegram splits
//      long texts, people correct themselves) become ONE turn; messages that
//      arrive while a turn runs form the next turn. Every message is recorded
//      in the router's action ring, so get_last_actions resolves "make it 6am
//      instead" against the earlier request. A reply quotes the message it
//      answers.
//    * files: a text document (.md plan, .txt, .json, code, ...) is downloaded,
//      kept in telegram_inbox/ next to the trust file, shown to the router agent
//      and attached verbatim to the goal the turn delegates (Router
//      turn_attachments). The caption is the instruction.
//
//  Commands in a trusted chat:
//    /help /id /nodes /tasks [state] /status /goals [node]
//    /goal <run|pause|resume|cancel|archive> <id> [node]
//    /allow <chatid> [name]   /deny <chatid>   /forget
//
//  Subclass it the way the README shows (router_api.md §Events):
//
//      class MyBot : TelegramRouter {
//          __init__(cfg) {
//              super.__init__(cfg, [name = "MyBot"]);
//              attach_bot(telegram.bot(token));
//          }
//      }
//
//  Threading: the ai_event sink (Router.on_event) runs on the ShizoNet script
//  thread — it must not block, so events are queued (tg_out) and the bot's own
//  worker thread performs the Telegram HTTP calls. Inbound turns run in the same
//  worker thread, so a long LLM turn never blocks message intake.
// ═════════════════════════════════════════════════════════════════════════════

#include "router_api"
#include "model_config_cli"

import tgbot;

TG_TRUSTED_KEY = "trusted_chats";
TG_MAX_MSG = 3900;
TG_REPORT_CHARS = 2500;      // a report longer than this goes in full as an attached .md file
TG_NOTIFY_CHARS = 3500;      // the same for a notify
TG_CAPTION_CHARS = 1000;     // Telegram allows 1024 characters of caption
TG_DRAFT_MS = 3000;
TG_MAX_QUEUED_OUT = 100;
TG_DEDUPE_MS = 1500;
TG_COALESCE_MS = 1500;       // a chat's messages this close together are one turn
TG_FILE_MAX = 262144;        // bytes of a document that is read (larger: not read)
TG_FILE_PROMPT_CHARS = 12000;    // file text shown to the router agent
TG_TEXT_EXT = ["md", "markdown", "txt", "text", "json", "yaml", "yml", "toml", "ini", "csv", "tsv", "log",
    "xml", "html", "htm", "css", "js", "ts", "py", "shio", "c", "cc", "cpp", "h", "hpp", "cs", "java",
    "go", "rs", "sh", "bat", "ps1", "sql", "cmake", "diff", "patch"];

class TelegramRouter : Router
{
    tg_bot = None;
    tg_path = "";
    tg_chats = [];          // [{chatid, name, added}] — the trust list
    tg_queue = [];          // inbound turns: [chatdata, text]
    tg_out = [];            // outbound event texts, or [text, files] (never sent on the shizonet thread)
    tg_thread = None;
    tg_running = false;
    tg_active = None;       // the chat of the turn currently streaming
    tg_acc = "";            // streamed text of the current turn
    tg_draft = 0;
    tg_last_draft = 0;
    tg_stream = true;
    tg_draft_ms = TG_DRAFT_MS;
    tg_last_chat = 0;       // the last accepted message, for duplicate deliveries
    tg_last_text = "";
    tg_last_ms = 0;
    tg_events = "reports";  // "reports" = only what deserves attention (default)
                            // "all"    = every node event (the verbose stream)
    tg_lock = "telegram:chats";
    tg_coalesce_ms = TG_COALESCE_MS;
    tg_inbox = "";          // where received files are kept (next to the trust file)

    // ─────────────────────────────────────────────────────────────────────────
    //  cfg: ModelConfig
    //  opts: Router opts (name, role, description, capabilities, tags, poll_ms,
    //        stall_ms) plus: trusted_chats (path), stream (bool), draft_ms (int),
    //              events ("reports" | "all")
    //
    //  stall_ms is forwarded to the Router: an open task that makes no progress
    //  that long is announced in the chat once (0 = the Router default of
    //  ROUTER_TASK_STALL_MS, 15 min).
    // ─────────────────────────────────────────────────────────────────────────
    __init__(cfg, opts = None)
    {
        opts_name = "TelegramRouter";
        opts_role = "router";
        opts_path = "";
        opts_stream = true;
        opts_poll = 1000;
        opts_draft = TG_DRAFT_MS;
        opts_events = "reports";
        opts_stall = 0;

        if(opts) {
            if(opts.has("name") && opts.name) {
                opts_name = std.string(opts.name);
            }
            if(opts.has("role") && opts.role) {
                opts_role = std.string(opts.role);
            }
            if(opts.has("trusted_chats") && opts.trusted_chats) {
                opts_path = std.string(opts.trusted_chats);
            }
            if(opts.has("stream")) {
                opts_stream = opts.stream ? true : false;
            }
            if(opts.has("poll_ms") && opts.poll_ms > 0) {
                opts_poll = std.int(opts.poll_ms);
            }
            if(opts.has("stall_ms") && opts.stall_ms > 0) {
                opts_stall = std.int(opts.stall_ms);
            }
            if(opts.has("draft_ms") && opts.draft_ms >= 0) {
                opts_draft = std.int(opts.draft_ms);
            }
            if(opts.has("events") && opts.events) {
                opts_events = std.string(opts.events).strip().lowercase();
            }
            if(opts.has("coalesce_ms") && opts.coalesce_ms >= 0) {
                tg_coalesce_ms = std.int(opts.coalesce_ms);
            }
        }

        super.__init__(cfg, [
            name = opts_name,
            role = opts_role,
            description = "telegram front of the router fleet",
            poll_ms = opts_poll,
            stall_ms = opts_stall,
        ]);

        tg_stream = opts_stream;
        tg_draft_ms = opts_draft;
        tg_events = opts_events;
        tg_path = opts_path;

        if(!tg_path) {
            tg_path = std.config_path("miniagent", TG_TRUSTED_KEY);
        }

        tg_load();

        tg_inbox = fileio.file_dir(tg_path);
        if(!tg_inbox) {
            tg_inbox = ".";
        }
        tg_inbox += "/telegram_inbox";

        // the README hook: every node event of every node goes to the chat
        on_event([this](e) { this.tg_push_event(e); });
        on_action([this](a) { this.tg_stream_action(a); });

        tg_running = true;
        tg_thread = std.thread([this]() { this.tg_worker(); });
        tg_thread.run();
    }

    __deinit__()
    {
        tg_stop_worker();
        super.__deinit__();
    }

    // The transport. Pass a telegram.bot() (or any object with send_rich /
    // send_rich_draft / new_draft_id) — on_any_message is wired here.
    attach_bot(bot)
    {
        tg_bot = bot;

        if(tg_bot) {
            tg_bot.on_any_message = [this](chatdata) { this.tg_handle_message(chatdata); };
        }

        return tg_bot ? true : false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    //  trust list on disk
    // ─────────────────────────────────────────────────────────────────────────

    tg_load()
    {
        data = fileio.read_json(tg_path, true);
        list = [];

        if(std.is_json(data) && data.has("chats") && std.is_json(data.chats)) {
            for(i = 0; i < data.chats.size(); i++) {
                c = data.chats[i];
                if(std.is_json(c) && c.has("chatid") && std.int(c.chatid) != 0) {
                    list.push_back([
                        chatid = std.int(c.chatid),
                        name = std.string(c.name ?? ""),
                        added = std.int(c.added ?? 0),
                    ]);
                }
            }
        }

        cs = std.critical_section_named(tg_lock);
        tg_chats = list;
        cs.release();

        return tg_chats.size();
    }

    tg_save()
    {
        out = [chats = []];

        cs = std.critical_section_named(tg_lock);
        for(i = 0; i < tg_chats.size(); i++) {
            out.chats.push_back(tg_chats[i].copy());
        }
        cs.release();

        try {
            dir = fileio.file_dir(tg_path);
            if(dir && !fileio.exists(dir)) {
                fileio.mkdir(dir);
            }
        }
        catch(e) {}

        try {
            fileio.write_text(tg_path, std.string(out));
            return true;
        }
        catch(e) {
            std.error("[telegram] could not write ", tg_path, ": ", e);
            return false;
        }
    }

    tg_is_trusted(chatid)
    {
        want = std.int(chatid);
        found = false;

        cs = std.critical_section_named(tg_lock);
        for(i = 0; i < tg_chats.size(); i++) {
            if(std.int(tg_chats[i].chatid) == want) {
                found = true;
                break;
            }
        }
        cs.release();

        return found;
    }

    tg_trust(chatid, chat_name = "")
    {
        want = std.int(chatid);

        if(want == 0 || tg_is_trusted(want)) {
            return false;
        }

        cs = std.critical_section_named(tg_lock);
        tg_chats.push_back([chatid = want, name = std.string(chat_name), added = std.millis()]);
        cs.release();

        tg_save();

        return true;
    }

    tg_untrust(chatid)
    {
        want = std.int(chatid);
        removed = false;

        cs = std.critical_section_named(tg_lock);
        for(i = tg_chats.size() - 1; i >= 0; i--) {
            if(std.int(tg_chats[i].chatid) == want) {
                tg_chats.erase(i);
                removed = true;
            }
        }
        cs.release();

        if(removed) {
            tg_save();
        }

        return removed;
    }

    tg_chat_list()
    {
        out = [];

        cs = std.critical_section_named(tg_lock);
        for(i = 0; i < tg_chats.size(); i++) {
            out.push_back(tg_chats[i].copy());
        }
        cs.release();

        return out;
    }

    tg_trusted_text()
    {
        list = tg_chat_list();

        if(!list.size()) {
            return "none yet — the first chat that messages the bot becomes the trusted one";
        }

        out = "";
        for(i = 0; i < list.size(); i++) {
            out += "- " + std.string(list[i].chatid);
            if(list[i].name) {
                out += " (" + std.string(list[i].name) + ")";
            }
            out += "\n";
        }

        return out;
    }

    // ─────────────────────────────────────────────────────────────────────────
    //  inbound
    // ─────────────────────────────────────────────────────────────────────────

    // a json field without adding it (reading a missing member creates it)
    tg_get(obj, key, def = "")
    {
        if(!std.is_json(obj) || !obj.has(key)) {
            return def;
        }

        v = obj[key];

        if(std.is_none(v)) {
            return def;
        }

        return v;
    }

    tg_handle_message(chatdata)
    {
        if(!std.is_json(chatdata)) {
            std.print("[telegram] message without chatdata\n");
            return;
        }

        chat_id = std.int(tg_get(chatdata, "chatid", 0));
        txt = std.string(tg_get(chatdata, "text", "")).strip();

        if(chat_id == 0) {
            return;
        }

        if(!tg_is_trusted(chat_id)) {
            if(tg_chats.size() > 0) {
                std.print("[telegram] ignored message from untrusted chat ", chat_id, "\n");
                return;
            }

            // bootstrap: no trusted chat exists -> the first chat wins, on disk
            who = std.string(tg_get(chatdata, "username", ""));
            if(!who) {
                who = std.string(tg_get(chatdata, "first_name", ""));
            }

            tg_trust(chat_id, who);
            std.print("[telegram] bootstrap: chat ", chat_id, " (", who, ") is now trusted\n");
            tg_send(chatdata, tg_welcome_text());
        }

        // a document: the caption is the instruction, the file is read by the worker
        doc = None;
        d = tg_get(chatdata, "document", None);
        if(std.is_json(d) && std.string(tg_get(d, "fileid", ""))) {
            doc = d;
        }

        if(!txt) {
            txt = std.string(tg_get(chatdata, "caption", "")).strip();
        }

        // the message this one replies to (a correction of an earlier request)
        reply_text = "";
        r = tg_get(chatdata, "reply", None);
        if(std.is_json(r)) {
            reply_text = std.string(tg_get(r, "text", "")).strip();
            if(!reply_text) {
                reply_text = std.string(tg_get(r, "caption", "")).strip();
            }
            reply_text = tg_clip(reply_text, 600);
        }

        // A transport can deliver the same update twice (a getUpdates replay). One
		// message, one action: the identical text from the same chat inside a short
		// window is the same message, not a request to do it twice.
		dedupe_key = txt;
		if(doc) {
			dedupe_key += "#file:" + std.string(tg_get(doc, "fileuid", tg_get(doc, "fileid", "")));
		}

		if(chat_id == tg_last_chat && dedupe_key == tg_last_text && std.millis() - tg_last_ms < TG_DEDUPE_MS) {
			std.print("[telegram] duplicate delivery from chat ", chat_id, " ignored\n");
			return;
		}

		tg_last_chat = chat_id;
		tg_last_text = dedupe_key;
		tg_last_ms = std.millis();

		if(!txt && !doc) {
			if(tg_get(chatdata, "photo", None) || tg_get(chatdata, "voice", None) || tg_get(chatdata, "video", None)) {
				tg_send(chatdata, "I read text and text files (.md, .txt, .json, code). Photos, voice and video are not supported yet.");
			}
			return;
		}

		if(txt.starts("/") && !doc) {
			tg_command(chatdata, txt);
			return;
		}

		tg_enqueue(chatdata, txt, doc, reply_text);
	}

    tg_command(chatdata, txt)
    {
        chat_id = std.int(chatdata.chatid ?? 0);
        parts = txt.split(" ", 3, true);
        cmd = std.string(parts[0]).lowercase();
        arg = "";
        who = "";

        if(parts.size() > 1) {
            arg = std.string(parts[1]).strip();
        }
        if(parts.size() > 2) {
            who = std.string(parts[2]).strip();
        }

        if(cmd == "/help" || cmd == "/start") {
            tg_send(chatdata, tg_help_text());
            return;
        }

        if(cmd == "/id") {
            tg_send(chatdata, "This chat: " + std.string(chat_id) + "\nTrusted chats:\n" + tg_trusted_text() + "File: " + tg_path);
            return;
        }

        if(cmd == "/nodes") {
            tg_send(chatdata, tg_nodes_text());
            return;
        }

        if(cmd == "/tasks") {
            tg_send(chatdata, tg_tasks_text(arg));
            return;
        }

        if(cmd == "/status") {
            tg_send(chatdata, tg_status_text());
            return;
        }

        // these ask every node over the network: never on the bot's script thread
        if(cmd == "/goals" || cmd == "/goal") {
            tg_enqueue(chatdata, txt, None, "", "cmd");
            return;
        }

        if(cmd == "/allow") {
            if(!arg) {
                tg_send(chatdata, "usage: /allow <chatid> [name]");
                return;
            }

            new_id = std.int(arg);

            if(new_id == 0) {
                tg_send(chatdata, "Not a chat id: " + arg);
                return;
            }

            if(tg_trust(new_id, who)) {
                tg_send(chatdata, "Trusted " + std.string(new_id) + ".\nTrusted chats:\n" + tg_trusted_text());
            }
            else {
                tg_send(chatdata, "Already trusted: " + std.string(new_id));
            }
            return;
        }

        if(cmd == "/deny") {
            if(!arg) {
                tg_send(chatdata, "usage: /deny <chatid>");
                return;
            }

            if(tg_untrust(std.int(arg))) {
                tg_send(chatdata, "Dropped " + arg + ".\nTrusted chats:\n" + tg_trusted_text());
            }
            else {
                tg_send(chatdata, "Not trusted: " + arg);
            }
            return;
        }

        if(cmd == "/forget") {
            tg_untrust(chat_id);
            tg_send(chatdata, "This chat is no longer trusted. The bot ignores it until it is listed in " + tg_path + " again.");
            return;
        }

        tg_send(chatdata, "Unknown command. /help");
    }

    // kind: "turn" (a router-agent turn) | "cmd" (a slow command, run by the worker)
    tg_enqueue(chatdata, txt, doc = None, reply_text = "", kind = "turn")
    {
        cs = std.critical_section_named(tg_lock);
        tg_queue.push_back([
            chatdata = chatdata,
            chatid = std.int(tg_get(chatdata, "chatid", 0)),
            text = std.string(txt),
            doc = doc,
            reply = std.string(reply_text ?? ""),
            kind = kind,
            at = std.millis(),
        ]);
        cs.release();
    }

    // one worker thread: sends queued event notifications, then runs one
    // router-agent turn. Telegram HTTP never happens on the shizonet thread.
    tg_worker()
    {
        for(tg_running) {
            sent = tg_flush_out();

            idx = tg_next_ready();

            if(idx >= 0) {
                tg_run_item(idx);
                continue;
            }

            if(!sent) {
                std.sleep(50);
            }
        }
    }

    // The first queued item that may run now. A chat's turn waits until that
    // chat was quiet for tg_coalesce_ms, so a burst of messages is one turn;
    // other chats are not held up by it.
    tg_next_ready()
    {
        now = std.millis();
        found = -1;

        cs = std.critical_section_named(tg_lock);

        for(i = 0; i < tg_queue.size() && found < 0; i++) {
            it = tg_queue[i];

            if(it.kind != "turn") {
                found = i;
                break;
            }

            newest = it.at;
            for(j = i + 1; j < tg_queue.size(); j++) {
                if(tg_queue[j].kind == "turn" && tg_queue[j].chatid == it.chatid && tg_queue[j].at > newest) {
                    newest = tg_queue[j].at;
                }
            }

            if(now - newest >= tg_coalesce_ms) {
                found = i;
            }
        }

        cs.release();

        return found;
    }

    tg_run_item(idx)
    {
        cs = std.critical_section_named(tg_lock);
        first = tg_queue[idx];
        items = [];

        if(first.kind != "turn") {
            items.push_back(first);
            tg_queue.erase(idx);
        }
        else {
            // every queued message of this chat joins the turn, in order
            for(i = 0; i < tg_queue.size(); i++) {
                if(tg_queue[i].kind == "turn" && tg_queue[i].chatid == first.chatid) {
                    items.push_back(tg_queue[i]);
                    tg_queue.erase(i);
                    i--;
                }
            }
        }
        cs.release();

        if(first.kind == "cmd") {
            tg_send(first.chatdata, tg_slow_command(first.text));
            return;
        }

        tg_run_turn(items);
    }

    tg_run_turn(items)
    {
        chatdata = items[items.size() - 1].chatdata;
        parts = [];
        files = [];
        notes = [];

        for(it : items) {
            t = std.string(it.text);
            if(it.reply) {
                t += (t ? "\n" : "") + "(in reply to: \"" + it.reply + "\")";
            }
            if(t) {
                parts.push_back(t);
            }
            if(it.doc) {
                f = tg_fetch_document(it.doc);
                if(f.ok) {
                    files.push_back(f);
                }
                else {
                    notes.push_back("(The user attached '" + f.name + "'; it was not read: " + f.error + ")");
                }
            }
        }

        prompt = tg_turn_prompt(parts, files, notes);

        user_text = "";
        for(i, p : parts) {
            user_text += (i > 0 ? "\n" : "") + p;
        }
        names = [];
        for(f : files) {
            names.push_back(f.name);
        }
        _note_action("user_message", [chat = std.int(tg_get(chatdata, "chatid", 0)), text = tg_clip(user_text, 600), files = names]);

        tg_active = chatdata;
        tg_acc = "";
        tg_draft = 0;
        tg_last_draft = std.millis();

        att = [];
        for(f : files) {
            att.push_back([name = f.name, content = f.content]);
        }
        turn_attachments = att;

        res = None;
        try {
            res = route_task(prompt);
        }
        catch(e) {
            res = [ok = false, error = std.string(e)];
        }

        turn_attachments = [];
        tg_active = None;

        tg_send(chatdata, tg_answer_text(res));
    }

    // One message stays exactly the text the user typed. Several messages, a
    // reply or a file are put together so the agent sees what belongs together.
    tg_turn_prompt(parts, files, notes)
    {
        out = "";

        if(parts.size() == 1) {
            out = parts[0];
        }
        else if(parts.size() > 1) {
            out = "The user sent " + std.string(parts.size()) + " messages in a row; later ones correct or extend earlier ones:\n";
            for(i, p : parts) {
                out += "\n" + std.string(i + 1) + ". " + p;
            }
        }
        else if(files.size()) {
            out = "The user sent a file without a message. Find out from its content what they want done; ask if it is unclear.";
        }

        for(f : files) {
            out += "\n\nAttached file '" + f.name + "' (" + std.string(f.bytes) + " bytes, kept at " + f.path + "). It is attached verbatim to the task you delegate in this turn; do not copy it into the task text.\n````\n" + tg_clip(f.content, TG_FILE_PROMPT_CHARS) + "\n````";
        }

        for(n : notes) {
            out += "\n\n" + n;
        }

        return out;
    }

    tg_is_text_file(name, mime)
    {
        m = std.string(mime ?? "").lowercase();

        if(m.starts("text/") || m == "application/json" || m.ends("+json") || m.ends("xml") || m.contains("yaml") || m.contains("markdown")) {
            return true;
        }

        ext = std.string(fileio.file_ext(std.string(name))).lowercase();
        if(ext.starts(".")) {
            ext = ext.substr(1);
        }

        for(e : TG_TEXT_EXT) {
            if(e == ext) {
                return true;
            }
        }

        return false;
    }

    tg_safe_name(name)
    {
        out = "";
        for(c : std.string(name)) {
            ok = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "." || c == "-" || c == "_";
            out += ok ? c : "_";
        }
        if(!out || out.starts(".")) {
            out = "file" + out;
        }
        return out.length() > 80 ? out.substr(out.length() - 80) : out;
    }

    // download a document (worker thread) -> [ok, name, content, path, size, error]
    tg_fetch_document(doc)
    {
        name = std.string(tg_get(doc, "filename", "file"));
        size = std.int(tg_get(doc, "filesize", 0));
        mime = std.string(tg_get(doc, "mimetype", ""));
        //"bytes", not "size": a json literal drops a key named size (it is the size() method)
        fail = [ok = false, name = name, content = "", path = "", bytes = size, error = ""];

        if(size > TG_FILE_MAX) {
            fail.error = "too large (" + std.string(size / 1024) + " KB, the limit is " + std.string(TG_FILE_MAX / 1024) + " KB)";
            return fail;
        }

        if(!tg_is_text_file(name, mime)) {
            fail.error = "not a text file (send .md, .txt, .json, code ...)";
            return fail;
        }

        if(!tg_bot) {
            fail.error = "no bot attached";
            return fail;
        }

        got = None;
        try {
            got = tg_bot.download_file(std.string(tg_get(doc, "fileid", "")));
        }
        catch(e) {
            got = None;
        }

        content = std.is_json(got) ? std.string(tg_get(got, "content", "")) : "";

        if(!content) {
            fail.error = "the download failed";
            return fail;
        }

        if(content.length() > TG_FILE_MAX) {
            fail.error = "too large (the limit is " + std.string(TG_FILE_MAX / 1024) + " KB)";
            return fail;
        }

        path = tg_inbox + "/" + std.string(std.millis()) + "-" + tg_safe_name(name);

        try {
            if(!fileio.exists(tg_inbox)) {
                fileio.mkdir(tg_inbox);
            }
            fileio.write_text(path, content);
        }
        catch(e) {
            path = "(not saved: " + std.string(e) + ")";
        }

        return [ok = true, name = name, content = content, path = path, bytes = content.length(), error = ""];
    }

    // /goals [node] and /goal <action> <id> [node] (ask the nodes: worker thread)
    tg_slow_command(txt)
    {
        parts = std.string(txt).strip().split(" ");
        args = [];
        for(p : parts) {
            if(p.strip()) {
                args.push_back(p.strip());
            }
        }

        cmd = args[0].lowercase();

        if(cmd == "/goals") {
            return tg_goals_text(args.size() > 1 ? args[1] : "");
        }

        if(args.size() < 3) {
            return "usage: /goal <run|pause|resume|cancel|archive> <id> [node]";
        }

        action = args[1].lowercase();
        res = goal_action(action, args[2], args.size() > 3 ? args[3] : "");

        if(!std.is_json(res) || !res.ok) {
            return "Goal " + args[2] + ": " + std.string(std.is_json(res) ? tg_get(res, "error", "failed") : "failed");
        }

        if(action == "run") {
            return "Goal " + args[2] + " on " + std.string(tg_get(res, "node", "?")) + ": started (the node's scheduler picks it up within seconds).";
        }

        return "Goal " + args[2] + " on " + std.string(tg_get(res, "node", "?")) + ": " + std.string(tg_get(res, "from", "?")) + " -> " + std.string(tg_get(res, "to", "?"));
    }

    tg_goals_text(node_name = "")
    {
        list = goals(node_name);

        if(!list.size()) {
            return node_name ? "Node " + node_name + " is not online." : "No AI node is online right now.";
        }

        out = "";
        for(entry : list) {
            out += "*" + std.string(entry.node) + "*\n";

            if(!entry.ok) {
                out += "  " + std.string(tg_get(entry, "error", "no goals")) + "\n";
                continue;
            }

            if(!entry.goals.size()) {
                out += "  no goals\n";
                continue;
            }

            for(g : entry.goals) {
                out += "- " + std.string(tg_get(g, "id", "?")) + " [" + std.string(tg_get(g, "status", "?")) + "] " + std.string(tg_get(g, "title", "")) + "\n";
                if(tg_get(g, "schedule", "")) {
                    out += "  " + std.string(g.schedule) + "\n";
                }
                if(tg_get(g, "active_window", "")) {
                    out += "  now: " + std.string(g.active_window) + " (" + std.string(tg_get(g, "active_state", "")) + ")\n";
                }
                else if(tg_get(g, "next_window", "") && tg_get(g, "status", "") == "active") {
                    out += "  next: " + std.string(g.next_window) + "\n";
                }
                if(tg_get(g, "last_outcome", "")) {
                    out += "  last: " + std.string(g.last_outcome) + "\n";
                }
                if(tg_get(g, "invalid_edit", false)) {
                    out += "  ! invalid edit in goal.md, the last valid revision runs\n";
                }
            }
        }

        return out;
    }

    tg_flush_out()
    {
        n = 0;

        for(tg_out.size()) {
            cs = std.critical_section_named(tg_lock);
            item = tg_out[0];
            tg_out.erase(0);
            cs.release();

            if(std.is_json(item)) {
                tg_broadcast(std.string(item.text ?? ""));
                files = item.files ?? [];
                for(i = 0; i < files.size(); i++) {
                    tg_broadcast_file(files[i]);
                }
            }
            else {
                tg_broadcast(std.string(item));
            }
            n++;
        }

        return n;
    }

    tg_stop_worker()
    {
        tg_running = false;

        if(tg_thread) {
            try {
                tg_thread.join();
            }
            catch(e) {}
            tg_thread = None;
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    //  outbound
    // ─────────────────────────────────────────────────────────────────────────

    tg_send(chatdata, txt)
    {
        msg = tg_clip(txt);

        if(!tg_bot) {
            std.print("[telegram:", std.string(chatdata.chatid ?? 0), "] ", msg, "\n");
            return false;
        }

        try {
            tg_bot.send_rich(chatdata, [markdown = msg]);
            return true;
        }
        catch(e) {
            std.error("[telegram] send to ", std.string(chatdata.chatid ?? 0), " failed: ", e);
            return false;
        }
    }

    tg_broadcast(txt)
    {
        msg = tg_clip(txt);
        list = tg_chat_list();

        for(i = 0; i < list.size(); i++) {
            tg_send([chatid = std.int(list[i].chatid)], msg);
        }

        return list.size();
    }

    // a document for every trusted chat. f: [name, caption, text] (a long report) or [name, caption, data]
    // (base64, a file of a node's send_file). It is written next to the trust file, sent, and removed.
    tg_broadcast_file(f)
    {
        name = tg_safe_name(std.string(f.name ?? "file"));
        path = tg_inbox + "/out-" + std.string(std.millis()) + "-" + name;

        try {
            if(!fileio.exists(tg_inbox)) {
                fileio.mkdir(tg_inbox);
            }

            if(f.has("data")) {
                fileio.write_file(path, std.base64_decode(std.string(f.data)));
            }
            else {
                fileio.write_string(path, std.string(f.text ?? ""));
            }
        }
        catch(e) {
            std.error("[telegram] cannot write the attachment ", name, ": ", e);
            return 0;
        }

        caption = tg_clip(std.string(f.caption ?? ""), TG_CAPTION_CHARS);
        list = tg_chat_list();

        for(i = 0; i < list.size(); i++) {
            tg_send_file([chatid = std.int(list[i].chatid)], path, caption);
        }

        try {
            fileio.remove(path);
        }
        catch(e) {}

        return list.size();
    }

    tg_send_file(chatdata, path, caption = "")
    {
        if(!tg_bot) {
            std.print("[telegram:", std.string(chatdata.chatid ?? 0), "] (document) ", path, " ", caption, "\n");
            return false;
        }

        try {
            opts = [];
            if(caption) {
                opts.caption = caption;
            }
            tg_bot.send_document(chatdata, path, opts);
            return true;
        }
        catch(e) {
            std.error("[telegram] sending the document ", path, " to ", std.string(chatdata.chatid ?? 0), " failed: ", e);
            return false;
        }
    }

    // queue an event notification (safe from any thread, never blocks).
    // files: documents sent after the text (see tg_broadcast_file)
    tg_notify(txt, files = None)
    {
        cs = std.critical_section_named(tg_lock);
        if(files && files.size()) {
            tg_out.push_back([text = std.string(txt), files = files]);
        }
        else {
            tg_out.push_back(std.string(txt));
        }
        for(tg_out.size() > TG_MAX_QUEUED_OUT) {
            tg_out.erase(0);
        }
        cs.release();
    }

    tg_push_event(e)
    {
        msg = tg_render_event(e);

        if(!msg) {
            return;
        }

        tg_notify(msg, tg_event_files(e));
    }

    // What deserves the owner's attention. Every terminal state is in: a task
    // that stopped, and a node that asks a question, must not be silent
    // (router_api.md §Events). The Router de-duplicates the stream, so a state
    // listed here arrives at most once per fact.
    tg_is_report(kind, state)
    {
        if(kind == "task_finished") {
            return true;
        }

        if(kind == "notify") {
            return true;
        }

        // a document a node's agent sent with send_file
        if(kind == "file") {
            return true;
        }

        // C2: the stall watchdog emits ONE task_stalled per stall episode — the
        // chat has to hear it, that is the whole point of the watchdog.
        if(kind == "task_stalled") {
            return true;
        }

        if(kind == "task_state") {
            return state == "finished" || state == "failed" || state == "lost"
                || state == "stopped" || state == "question";
        }

        return false;
    }

    // The Router de-duplicates its event stream (router_api.md §Events), so a
    // finished task arrives exactly once — as task_finished (node push) or as
    // task_state -> finished (poller). Both render to the same one message.
    //
    // Rendering rules (the owner must learn WHY, never only THAT):
    //   [done]/[failed]/[lost]/[stopped]/[question] <node>: task <name> <state>
    //     + the node's report (clipped), when it sent one
    //     + "error: <reason>" for failed/lost/stopped, from the task_state
    //       event's `error` (C1) — next to the report when both exist, alone
    //       when the node reported nothing
    //     + "(the node reported nothing)" when there is neither
    //   [stalled] <node>: task <name> ... for <N> min (state <state>) ...
    //     from the C2 task_stalled event, once per stall episode
    // The documents that go with an event (tg_render_event says they are attached):
    //   a report longer than TG_REPORT_CHARS / a notify longer than TG_NOTIFY_CHARS, in full as .md,
    //   the file of a node's send_file (kind "file", base64 data).
    tg_event_files(e)
    {
        kind = std.string(e.kind ?? "");
        files = [];

        if(kind == "file") {
            if(e.data) {
                files.push_back([name = std.string(e.name ?? "file"), caption = std.string(e.caption ?? ""), data = std.string(e.data)]);
            }
            return files;
        }

        if(kind == "notify") {
            m = std.string(e.message ?? "");
            if(m.length() > TG_NOTIFY_CHARS) {
                files.push_back([name = "notify-" + std.string(e.node ?? "node") + ".md", caption = "", text = m]);
            }
            return files;
        }

        // only the messages that show the report (tg_render_event: a task that ended)
        st = std.string(e.state ?? "");
        ended = kind == "task_finished" || (kind == "task_state" && (st == "finished" || st == "failed" || st == "lost" || st == "stopped" || st == "question"));
        rep = std.string(e.report ?? "");
        if(ended && rep.length() > TG_REPORT_CHARS && tg_render_event(e)) {
            task_name = std.string(e.name ?? "task");
            files.push_back([
                name = "report-" + (task_name ? task_name : "task") + ".md",
                caption = std.string(e.node ?? "") + ": task " + task_name,
                text = rep,
            ]);
        }

        return files;
    }

    tg_render_event(e)
    {
        kind = std.string(e.kind ?? "event");
        node = std.string(e.node ?? "?");
        task_name = std.string(e.name ?? "");
        st = std.string(e.state ?? "");
        rep = std.string(e.report ?? "");
        err = std.string(e.error ?? "");

        if(tg_events != "all" && !tg_is_report(kind, st)) {
            return "";
        }

        if(kind == "task_finished" || (kind == "task_state" && (st == "finished" || st == "failed" || st == "lost" || st == "stopped" || st == "question"))) {
            label = "[done]";

            if(st == "failed") {
                label = "[failed]";
            }
            else if(st == "lost") {
                label = "[lost]";
            }
            else if(st == "stopped") {
                label = "[stopped]";
            }
            else if(st == "question") {
                label = "[question]";
            }

            out = label + " " + node + ": task " + task_name + " " + st;

            body = "";

            if(rep) {
                body = tg_clip(rep, TG_REPORT_CHARS);
                if(rep.length() > TG_REPORT_CHARS) {
                    body += "\n(the full report is attached)";
                }
            }

            // C1: the reason of the transition. A failure without a reason is
            // the bug this front end exists to fix.
            if(err && (st == "failed" || st == "lost" || st == "stopped")) {
                if(body) {
                    body += "\n";
                }
                body += "error: " + tg_clip(err, TG_REPORT_CHARS);
            }

            if(!body) {
                body = "(the node reported nothing)";
            }

            return out + "\n" + body;
        }

        // C2: the stall watchdog — an open task that says nothing for
        // stall_ms. idle_ms -> whole minutes, never less than one.
        if(kind == "task_stalled") {
            mins = std.int(e.idle_ms ?? 0) / 60000;

            if(mins < 1) {
                mins = 1;
            }

            return "[stalled] " + node + ": task " + task_name +
                " has made no progress for " + std.string(mins) +
                " min (state " + st + "). Ask it for status with a message, or /tasks.";
        }

        if(kind == "notify") {
            m = std.string(e.message ?? "");
            if(m.length() > TG_NOTIFY_CHARS) {
                m = tg_clip(m, TG_NOTIFY_CHARS) + "\n(the full message is attached)";
            }
            return "[notify] " + node + ": " + m;
        }

        if(kind == "file") {
            out = "[file] " + node + ": " + std.string(e.name ?? "file") + " (" + std.string(std.int(e.bytes ?? 0)) + " bytes)";
            if(e.caption) {
                out += "\n" + tg_clip(std.string(e.caption), TG_CAPTION_CHARS);
            }
            return out;
        }

        if(kind == "node_state") {
            if(e.online) {
                return "[node] " + node + " online";
            }

            return "[node] " + node + " offline";
        }

        if(kind == "task_state") {
            return "[" + st + "] " + node + ": task " + task_name;
        }

        return "[" + kind + "] " + node + " " + std.string(e.message ?? "");
    }

    // live progress of the current turn as a streaming draft (optional).
    // Streaming is a nicety: NOTHING in here may ever break the turn, so the
    // whole path is wrapped and any problem switches streaming off.
    tg_stream_action(action)
    {
        if(!tg_stream || !tg_bot || !tg_active) {
            return;
        }

        try {
            tg_stream_inner(action);
        }
        catch(e) {
            tg_stream = false;
            std.warn("[telegram] draft streaming disabled: ", e);
        }
    }

    // new_draft_id() has no documented return type and can hand back a number, a
    // string, a json wrapper, None or nothing at all (it only drafts private
    // chats). Extract a positive int from whatever shape arrives, 0 = unusable.
    tg_draft_id(v)
    {
        if(std.is_none(v)) {
            return 0;
        }

        if(std.is_json(v)) {
            if(v.has("draft_id")) {
                return tg_draft_id(v.draft_id);
            }
            if(v.has("draft")) {
                return tg_draft_id(v.draft);
            }
            if(v.has("id")) {
                return tg_draft_id(v.id);
            }
            if(v.size() == 1) {
                return tg_draft_id(v[0]);
            }
            return 0;
        }

        if(std.is_string(v)) {
            s = std.string(v).strip();

            if(!s) {
                return 0;
            }

            return std.int(s);
        }

        t = std.type(v);

        if(t == "int" || t == "float") {
            return std.int(v);
        }

        return 0;
    }

    tg_stream_inner(action)
    {
        // only the agent's own text: tool calls are plumbing, not news
        txt = "";

        if(action.text) {
            txt = std.string(action.text);
        }

        if(!txt) {
            return;
        }

        tg_acc += txt;

        if(std.millis() - tg_last_draft < tg_draft_ms) {
            return;
        }

        if(tg_draft <= 0) {
            cid = std.int(tg_active.chatid ?? 0);
            id = tg_bot.new_draft_id(cid);
            tg_draft = tg_draft_id(id);

            if(tg_draft <= 0) {
                tg_stream = false;
                std.warn("[telegram] no usable draft id for chat ", cid, " (got '", std.type(id), "') - streaming off");
                return;
            }
        }

        tg_bot.send_rich_draft(tg_active, tg_draft, [markdown = tg_clip(tg_acc)]);
        tg_last_draft = std.millis();
    }

    // ─────────────────────────────────────────────────────────────────────────
    //  text
    // ─────────────────────────────────────────────────────────────────────────

    tg_clip(txt, max_len = 3900)
    {
        s = std.string(txt ?? "");

        if(s.length() <= max_len) {
            return s;
        }

        return s.substr(0, max_len) + "\n... (truncated)";
    }

    tg_welcome_text()
    {
        return "This chat is now the trusted chat of router '" + name + "'.\n" +
            "Plain text is routed to the node my router agent picks. /help for the commands.\n" +
            "Trust list: " + tg_path;
    }

    tg_help_text()
    {
        return "Router '" + name + "' (role " + role + ")\n" +
            "plain text   one router-agent turn: I pick the node and delegate\n" +
            "/nodes       the fleet: name, capabilities, load, goals (does the node run a goal system)\n" +
            "/tasks [state]  routed tasks of ALL nodes (state: open, finished, failed, stopped, lost)\n" +
            "/status      router + trust state\n" +
            "/goals [node]   scheduled goals of the nodes (next window, last outcome)\n" +
            "/goal <run|pause|resume|cancel|archive> <id> [node]\n" +
            "Several messages in a row are read as one request (corrections welcome). Send a text file (.md plan, .txt, .json) with a caption and it is passed on verbatim.\n" +
            "/id          this chat id + the trust list\n" +
            "/allow <chatid> [name]   /deny <chatid>   /forget\n" +
            "/help        this list\n" +
            "You get a message when a task finishes, fails, is lost, is stopped or asks a question on a node: the node's report, and for a failure/loss/stop the reason as 'error: ...' (a node that reported nothing says so). A task that makes no progress for 15 minutes is announced once as [stalled]. A refused delegation is answered with its reason. Node online/offline, queued/running progress and tool calls stay out of this chat.";
    }

    tg_answer_text(res)
    {
        if(!std.is_json(res)) {
            return "The router agent turn returned nothing usable.";
        }

        out = std.string(res.answer ?? "");

		// a task was delegated: that is a success, whatever the turn result claims.
		// The completion arrives later as its own message - say so.
		if(res.routed && res.node) {
			if(!out.lowercase().contains("when it is done")) {
				out += (out ? "\n\n" : "") + "I'll write here when it is done (" + std.string(res.node) + ").";
			}
			return out;
		}

		if(!res.ok) {
			return "The router agent turn failed: " + std.string(res.error ?? "no details");
		}

		if(!out) {
			// the agent answered without routing a task (an arbitrary question is
			// not a job): a normal answer, not a routing failure
			out = "Nothing was routed. Ask me a job for the fleet, or use /nodes /tasks /status.";
		}

		return out;
    }

    tg_nodes_text()
    {
        list = nodes_summary();

        if(!list.size()) {
            return "No AI node is online right now — nothing can be routed.";
        }

        out = "Nodes (" + std.string(list.size()) + "):\n";

        for(i = 0; i < list.size(); i++) {
            n = list[i];
            out += "- " + std.string(n.name);
            if(n.description) {
                out += "  " + std.string(n.description);
            }
            out += "\n  capabilities: " + std.string(n.capabilities) +
                "  model: " + std.string(n.model) +
                "  busy: " + (n.busy ? "yes" : "no") +
                "  goals: " + (n.goals ? "yes" : "no") +
                "  running: " + std.string(n.tasks_running) +
                "  open: " + std.string(n.open_tasks) + "\n";
        }

        return out;
    }

    tg_tasks_text(filter = None)
    {
        want = std.string(filter ?? "").strip();
        list = tasks_summary(want);

        if(!list.size()) {
            if(want) {
                return "No routed tasks in state '" + want + "'.";
            }
            return "No routed tasks yet.";
        }

        out = "Tasks (" + std.string(list.size()) + "):\n";

        for(i = 0; i < list.size(); i++) {
            t = list[i];
            out += "- " + std.string(t.name) + " [" + std.string(t.state) + "] on " + std.string(t.node);
            if(t.report) {
                out += "\n  " + tg_clip(t.report, 160);
            }
            if(t.last_error) {
                out += "\n  error: " + tg_clip(t.last_error, 160);
            }
            out += "\n";
        }

        return out;
    }

    tg_status_text()
    {
        ov = get_overview();

        out = "Router " + std.string(ov.name) + " (role " + std.string(ov.role) + ")\n";
        out += "uptime: " + std.string(std.int(ov.uptime_ms / 1000)) + "s\n";
        out += "nodes online: " + std.string(ov.nodes_online) + "\n";
        out += "tasks open: " + std.string(ov.tasks_open) + "  mirrored: " + std.string(ov.remote_tasks.size()) + "\n";
        out += "trusted chats:\n" + tg_trusted_text();
        out += "trust file: " + tg_path + "\n";

        return out;
    }
}

// ─────────────────────────────────────────────────────────────────────────────
//  The runnable host. telegram_router.shio is a library first: including it
//  must not start a bot (the selftest includes it), so the host only runs when
//  this file is the entry point.
// ─────────────────────────────────────────────────────────────────────────────

tg_is_main()
{
    raw = std.argv(0);
    arg0 = "";

    if(raw) {
        arg0 = std.string(raw);
    }

    if(arg0.find("telegram_router_selftest") >= 0) {
        return false;
    }

    return arg0.find("telegram_router") >= 0;
}

// a value-less flag (--no-stream): argvoption only answers flags WITH a value
tg_has_flag(flag)
{
    for(i = 1; i < std.argc(); i++) {
        a = std.argv(i);
        if(a && std.string(a) == std.string(flag)) {
            return true;
        }
    }

    return false;
}

tg_host_get_cfg(cfg, cfg_spec)
{
	return model_config_cli_get(cfg, cfg_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY, true, true, "", "config-");
}

if(tg_is_main()) {
    cfg = ModelConfig();

    if(model_config_cli_handle_config_commands())
        return;

    cfg_spec = std.argvoption("--config");

    if(!tg_host_get_cfg(cfg, cfg_spec))
        return;

    save_spec = std.argvoption("--save-config");

    if(save_spec)
        model_config_save_spec(cfg, save_spec);

    model_config_cli_print_loaded("Telegram router config", cfg, cfg_spec);

    token_opt = std.argvoption("--bot-token");
    token = "";
    if(token_opt) {
        token = std.string(token_opt).strip();
    }
    name_opt = std.argvoption("--name");
    role_opt = std.argvoption("--role");
    poll_opt = std.argvoption("--poll");
    stall_opt = std.argvoption("--stall");
    trusted_opt = std.argvoption("--trusted");

    if(!token) {
        std.print("usage: shz telegram_router.shio --bot-token <token> [--config <name|path>] [--name X] [--role router] [--poll ms] [--stall ms] [--trusted <path>] [--no-stream] [--verbose-events] [--list-configs] [--new-config <name>]\n");
        return;
    }

    opts = [name = "TelegramRouter"];

    if(name_opt) {
        opts.name = std.string(name_opt);
    }
    if(role_opt) {
        opts.role = std.string(role_opt);
    }
    if(poll_opt) {
        opts.poll_ms = std.int(poll_opt);
    }
    if(stall_opt) {
        opts.stall_ms = std.int(stall_opt);
    }
    if(trusted_opt) {
        opts.trusted_chats = std.string(trusted_opt);
    }
    if(tg_has_flag("--no-stream")) {
        opts.stream = false;
    }
    if(tg_has_flag("--verbose-events")) {
        opts.events = "all";
    }

    bot = telegram.bot(token);

    rtr = TelegramRouter(cfg, opts);
    rtr.attach_bot(bot);

    std.print("Telegram router '", rtr.name, "' up (role: ", rtr.role, ", poll: ", rtr.poll_ms, "ms)\n");
    std.print("trusted chats: ", rtr.tg_chats.size(), "  file: ", rtr.tg_path, "\n");
    std.print("waiting for messages... (Ctrl+C to stop)\n");

    std.sleep(-1);

    rtr.tg_stop_worker();
    rtr.running = false;
    try { rtr.stop(); } catch(e) {}
    if(rtr.service) {
        try { rtr.service.stop(); } catch(e) {}
    }
}
