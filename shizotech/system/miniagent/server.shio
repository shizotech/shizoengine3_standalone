
// ═════════════════════════════════════════════════════════════════════════════
//  Mind host — runnable entry point for the Receptionist + Mind runtime
//
//  Usage:   shz runtime/mind_host.shio            (interactive)
//           shz runtime/mind_host.shio "your request"   (single request)
//
//  The host owns:
//    - one Receptionist agent (the router for user requests)
//    - the event dispatcher (runs Minds as short-lived LLM invocations)
//
//  Host commands:
//    /overview            all Minds and their lifecycle states
//    /actions [n]         compressed recent action history
//    /status              dispatcher + store statistics
//    /mind <id>           full detail of one Mind
//    /message <id> <text> enqueue a message into a Mind's mailbox
//    /stop <id>           request a Mind to stop
//    /notify [level]      show/set event notification level: all | notify | off
//    /clear               clear the receptionist transcript
//    /exit                quit
// ═════════════════════════════════════════════════════════════════════════════

#include "megamind"

cfg_path = std.config_path("miniagent", "default_model");

cfg = ModelConfig();

mind_host_get_cfg() {
	if(cfg.load(cfg_path))
		return true;

	api_url = "";
	auth_token = "";
	model_name = "";
	max_ctx = 128000;
	max_running_agents = 4;

	for(1) {
		std.print("Enter v1 url ( e.g. http://localhost:8000 )");
		api_url = std.input(">>> ");

		std.print("Enter model name (OPTIONAL)");
		model_name = std.input(">>> ");

		std.print("Enter auth token (OPTIONAL)");
		auth_token = std.input(">>> ");

		std.print("Enter model context length (OPTIONAL)");
		max_ctx_num = std.int(std.input(">>> "));
		if(max_ctx_num > 0)
			max_ctx = max_ctx_num;

		std.print("Enter max simultaneous agents (OPTIONAL)");
		max_running_agents = std.int(std.input(">>> "));

		api_url = api_url.removesuffix("/v1/");
		api_url = api_url.removesuffix("/v1");
		api_url = api_url.removesuffix("/");

		if(cfg.set(api_url, auth_token, model_name, max_ctx, max_running_agents))
			break;

		std.print("Could not get an answer from the API.");
	}

	cfg.save(cfg_path);

	return true;
}

last_state = "";

mind_host_print(action) {
	if(action.text) {
		if(last_state != "text")
			last_state = "text";
			std.cout("\n");
		stdfcol("white");
		std.cout(action.text);
	}

	if(action.reasoning) {
		if(last_state != "reasoning")
			last_state = "reasoning";
			std.cout("\n");
		stdfcol("yellow");
		std.cout(action.reasoning);
	}

	if(action.tool_start) {
		stdfcol("yellow");
		std.cout("\n\n[TOOL] ", action.tool_start.name, "\n");
		stdfcol("white");
	}
}

mind_host_report(agt) {
	std.cout("\nTOKEN USAGE:\n");
	token_usage_global = std.global("_global_token_usage");
	std.cout(token_usage_global["usage"]);
}

// ─────────────────────────────────────────────────────────────────────────────

mind_host_get_cfg();

host = Megamind(cfg);
host.on_action(mind_host_print);

//std.cout("\nmind dispatcher: ", start.status, "  store: ", mind_store_root(), "\n");

if(std.argc() >= 2) {
	request = "";
	for(i = 1; i < std.argc(); i++) {
		if(i > 1)
			request += " ";
		request += std.argv(i);
	}

	host.run(request);
	mind_host_report(host.receptionist);

	std.cout("\nThe request has been routed. Keep the host running to let Minds execute.\n");
}

for(1) {
	std.color("green");
	std.cout("\n>>> (user) ");

	cmd = std.input().strip();

	if(cmd == "exit" || cmd == "/exit")
		break;

	if(cmd.empty())
		continue;
	
	try {
		host.run(cmd);
	}
	catch(e) {
		std.error("receptionist run failed: ", e);
	}

}

std.cout("\nhost stopped.\n");
