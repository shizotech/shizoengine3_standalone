// ═════════════════════════════════════════════════════════════════════════════
//  telegram_gateway.shio — the Telegram gateway program
//
//      shz miniagent --telegram-gateway [--bot-token <token>] [--config <spec>]
//      shz miniagent.telegram_gateway ...           (the same)
//
//  The gateway is not a node: it owns no workspace and runs no work. It is a
//  router on ShizoNet that sees every AI node, passes each chat message to the
//  node and workspace it belongs to and brings the reports back to the chat.
//  The class and every option: telegram_router.shio.
//
//  Without --bot-token the token saved in the web interface of a node is used
//  (Settings > Telegram gateway, gateway_config.shio); a node with that setting
//  enabled starts this program by itself.
// ═════════════════════════════════════════════════════════════════════════════

#include "telegram_router"

tg_gateway_main();
