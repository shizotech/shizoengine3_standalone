

#include "miniagent"
#include "model_config_cli"

// ═════════════════════════════════════════════════════════════════════════════
//  shz miniagent — one command, three programs. The first flag picks one:
//
//    shz miniagent [prompt]              the console agent: one agent, this
//                                        directory, no network (below)
//    shz miniagent --node [--web]        a node: the workspaces of this machine
//                                        on ShizoNet; --web adds the web interface
//    shz miniagent --telegram-gateway    the Telegram gateway: no node, it routes
//                                        chat messages to the nodes on ShizoNet
//    shz miniagent --init [<dir>]        register a directory as a workspace of
//                                        the node, then return
//    shz miniagent --help                this overview with every option
//
//  node.shio / telegram_gateway.shio read the same command line.
// ═════════════════════════════════════════════════════════════════════════════

miniagent_cli_help() {
	std.print(
		"shz miniagent - the ShizoScript agent\n" +
		"\n" +
		"  shz miniagent [prompt]                 console agent in the current directory\n" +
		"                                         (no prompt: interactive, /clear /config /configs /load <file> /exit)\n" +
		"\n" +
		"  shz miniagent --node                   a node on ShizoNet: the workspaces registered on this machine,\n" +
		"                                         worker sessions, scheduled goals. Other nodes and gateways find it.\n" +
		"      --web [--port 13337]               + the web interface (all nodes of the network, workspaces, sessions,\n" +
		"                                           tasks, architecture) at http://127.0.0.1:13337/\n" +
		"      --webserver --port <n>             + the JSON API only\n" +
		"      --api-token <t>                    token for the web interface / the HTTP API\n" +
		"      --name <n> --description <text>    how the node shows on the network\n" +
		"      --workspace <dir>                  register <dir> as a workspace at start (repeatable)\n" +
		"      --interactive                      a console on the node (/workspaces /use /overview /goals /nodes)\n" +
		"      --agentspace <dir> | --no-goals    the node's own scheduled goals\n" +
		"      --data-dir <dir>                   storage root (default: <user path>/miniagent)\n" +
		"      --no-gateway                       do not start the Telegram gateway set up in the web interface\n" +
		"\n" +
		"  shz miniagent --init [<dir>] [--name <n>]   register <dir> (default: the current directory) as a\n" +
		"                                         workspace of the node on this machine, then return\n" +
		"\n" +
		"  shz miniagent --telegram-gateway       the Telegram gateway: not a node. Its router agent sends every\n" +
		"                                         chat request to a node + workspace on ShizoNet and reports back.\n" +
		"      --bot-token <token>                (default: the token saved in the web interface, Settings)\n" +
		"      --name <n> --trusted <path> --poll <ms> --stall <ms> --no-stream --verbose-events\n" +
		"\n" +
		"  model config (every mode): --config <name|path[#profile]>  --list-configs  --config-path\n" +
		"      --new-config <name>  --save-config <name>  --config-url <url> --config-token <t> --config-model <m>\n" +
		"      --config-context <tokens> --config-agents <n>\n" +
		"\n" +
		"  more: shz miniagent.goals <list|show|validate|run|pause|history>   scheduled goals\n" +
		"        README.md in the miniagent folder\n"
	);
}

miniagent_cli_has(flag) {
	for(_i = 1; _i < std.argc(); _i++) {
		arg = std.string(std.argv(_i) ?? "");
		if(arg == flag || arg.starts(flag + "="))
			return true;
	}
	return false;
}

if(miniagent_cli_has("--help") || miniagent_cli_has("-h")) {
	miniagent_cli_help();
	return;
}

if(miniagent_cli_has("--telegram-gateway")) {
	_gateway = std.module();
	_gateway.load_file(__DIR__ + "/telegram_gateway.shio");
	return;
}

if(miniagent_cli_has("--node") || miniagent_cli_has("--init") || miniagent_cli_has("--web") || miniagent_cli_has("--webserver")) {
	//--web / --webserver are options of a node: they still start one on their own
	if(!miniagent_cli_has("--node") && !miniagent_cli_has("--init"))
		std.print("(--web without --node: starting a node; the full form is 'shz miniagent --node --web')");

	_node = std.module();
	_node.load_file(__DIR__ + "/node.shio");
	return;
}

//Initialize agent

cfg = ModelConfig();

if(model_config_cli_handle_config_commands())
	return;

cfg_spec = std.argvoption("--config");

if(!model_config_cli_get(cfg, cfg_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY, true, true, "", "config-"))
	return;

save_spec = std.argvoption("--save-config");

if(save_spec)
	model_config_save_spec(cfg, save_spec);

model_config_cli_print_loaded("Config", cfg, cfg_spec);

planner = miniagent(cfg, "adaptive");

last_state = "";

planner.on_action = [&last_state](action) {
	if(action.text) {
		if(*last_state != "text")
			*last_state = "text";
			std.cout("\n");
		
		stdfcol("white");
		std.cout(action.text);
	}
	
	if(action.reasoning) {
		if(*last_state != "reasoning")
			*last_state = "reasoning";
			std.cout("\n");
		
		stdfcol("yellow");
		std.cout(action.reasoning);
	}
	
	if(action.tool) {
		if(*last_state != "tool")
			*last_state = "tool";
			std.cout("\n\n");
			
		stdfcol("yellow");
		std.cout("[TOOL] ");
		stdfcol("magenta");
		std.cout(action.tool.name + "()", action.tool.args.has("path") ? "> " + action.tool.args.path : "", "\n");
		stdfcol("white");
	}
};

prompt = model_config_cli_positional_prompt();

if(prompt) {
	//Run single prompt
	planner.task(prompt);
	return;
}

check_command(planner, cmd) {
	if(cmd == "/clear")
		planner.llm_api.context.clear();
		std.print("Cleared history.");
	else if(cmd == "/config")
		model_config_cli_print_path(cfg_spec, MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY, "Config path");
	else if(cmd == "/configs")
		model_config_cli_list(MODEL_CONFIG_PACKAGE, MODEL_CONFIG_DEFAULT_KEY);
	else if(cmd.starts("/dream"))
		cmd = cmd.removeprefix("/dream");
	
		loop_count = std.int(cmd.strip());
		loop_count = math.max(1, loop_count);
		
		std.print("Dreaming " + loop_count + " times.");
	
		for(dream_step = 0; dream_step < loop_count; dream_step++) {
	
			dreamer = planner.subagent("dreamer");
			dreamer.on_action = planner.on_action;
			fileio.write_string("mindmap.json", "{}");
			
			mindmap = fileio.read_json("mindmap.json");
			result = dreamer.task("Current mindmap:\n\n<mindmap>\n" + mindmap + "\n</mindmap>");
			txt = result.reports[0].report;
			entries = txt.extract_all("<new_entry>", "</new_entry>");		
			
			for(i = 0; i < entries.size(); i++) {
				new_entry = std.json(entries[i]);
				new_entry.status = "open";
				mindmap[new_entry.id] = new_entry;
			}
			
			fileio.write_json("mindmap.json", mindmap);
			
			fail_count = 0;
			for(fail_count < 3) {			
				try {
					result = planner.task("1. ***Read*** mindmap.json.\n\n2. Choose ***ONE OPEN*** task and execute it.\n\n3. ***Update*** mindmap.json by setting the task's status to either 'closed', 'failed' or 'disqualified' if the task would break structure.\n\nAlways check which step you are currently at.");
					if(!result.ok)
						std.print("ABORTED");
						break;
					fail_count = 0;
				}
				catch(e) { fail_count++; }
				
				still_open = false;
				for(i = 0; i < mindmap.size(); i++) {
					if(mindmap[i].status == "open")
						still_open = true;
						break;
				}
				
				if(!still_open)
					break;
			}
		}
		
	else
		std.print("unknown command.");
}

planner_prompt = "";
planner_stopped = false;

planner_thread() {
	for(1) {
		if(planner_prompt.empty())
			std.sleep(100);
			continue;
		
		try {
			planner.task(planner_prompt);
		}
		catch(e) {}
		
		std.cout("\nTOKEN USAGE:\n\n");
		token_usage_global = std.global("_global_token_usage");
		std.cout(token_usage_global["usage"]);
		
		planner_prompt = "";
		
		if(!planner_stopped)
			std.color("green");
			std.cout("\n\n");
			std.cout(">>> (user) ");
	}
}

pt = std.thread(planner_thread);

pt.run();

for(1) {
	if(!planner_prompt || planner_stopped)
		std.color("green");
		std.cout(">>> (user) ");
	
	planner_stopped = false;

	cmd = std.input().strip();

	//One fixed command, /load for loading prompt text files
	if(cmd.starts("/load")) {
		cmd = cmd.removeprefix("/load").strip();
		cmd = fileio.read_string(cmd);
	}
	else if(cmd == "exit" || cmd == "/exit")
		break;
	else if(cmd.starts("/"))
		check_command(planner, cmd);
		continue;
	
	if(planner_prompt) {
		//A new prompt while the agent is generating updates the running task
		//(task_update); it no longer stops the task and spawns a fresh one.
		if(!cmd) {
			planner.stop();
		}
		else {
			if(planner.running)
				planner.task_update(cmd);
			planner_prompt = cmd;
		}
		continue;
	}
	
	if(cmd.empty())
		continue;
	
	planner_prompt = cmd;
	
	std.cout("\n");
	
	stdfcol("magenta");
	std.cout("(miniagent) ");
}