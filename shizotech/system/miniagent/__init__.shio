
import webserver;
import leveldb;

#include "miniagent"

#include "cfg"

//#include "web_api"

//Initialize agent
planner = miniagent(cfg.api, cfg.model_name, "planner/orchestrator", cfg.token); //So that the local agent.space aswell as the global agent.space are visible
planner.env.secondary_model = cfg.secondary_model_name;

last_state = "";

planner.on_action = [&last_state](action) {
	if(action.text) {
		if(*last_state != "text")
			*last_state = "text";
			std.cout("\n");
		
		stdfcol("white");
		std.cout(action.text);
	}
	
	if(action.reasoning) {
		if(*last_state != "reasoning")
			*last_state = "reasoning";
			std.cout("\n");
		
		stdfcol("yellow");
		std.cout(action.reasoning);
	}
	
	if(action.tool) {
		if(*last_state != "tool")
			*last_state = "tool";
			std.cout("\n\n");
			
		stdfcol("yellow");
		std.cout("[TOOL] ");
		stdfcol("magenta");
		std.cout(action.tool.name + "()", action.tool.args.has("path") ? "> " + action.tool.args.path : "", "\n");
		stdfcol("white");
	}
};

if(std.argc() == 2) {
	//Run single prompt
	planner.task(std.argv(1));
	return;
}

check_command(planner, cmd) {
	if(cmd == "/clear")
		planner.llm_api.context.clear();
		std.print("Cleared history.");
	else if(cmd == "/config")
		std.print(cfg_path);
	else if(cmd.starts("/dream"))
		cmd = cmd.removeprefix("/dream");
	
		loop_count = std.int(cmd.strip());
		loop_count = math.max(1, loop_count);
		
		std.print("Dreaming " + loop_count + " times.");
	
		for(dream_step = 0; dream_step < loop_count; dream_step++) {
	
			dreamer = planner.subagent("dreamer");
			dreamer.on_action = planner.on_action;
			fileio.write_string("mindmap.json", "{}");
			
			mindmap = fileio.read_json("mindmap.json");
			result = dreamer.task("Current mindmap:\n\n<mindmap>\n" + mindmap + "\n</mindmap>");
			txt = result.reports[0].report;
			entries = txt.extract_all("<new_entry>", "</new_entry>");		
			
			for(i = 0; i < entries.size(); i++) {
				new_entry = std.json(entries[i]);
				new_entry.status = "open";
				mindmap[new_entry.id] = new_entry;
			}
			
			fileio.write_json("mindmap.json", mindmap);
			
			fail_count = 0;
			for(fail_count < 3) {			
				try {
					result = planner.task("1. ***Read*** mindmap.json.\n\n2. Choose ***ONE OPEN*** task and execute it.\n\n3. ***Update*** mindmap.json by setting the task's status to either 'closed', 'failed' or 'disqualified' if the task would break structure.\n\nAlways check which step you are currently at.");
					if(!result.ok)
						std.print("ABORTED");
						break;
					fail_count = 0;
				}
				catch(e) { fail_count++; }
				
				still_open = false;
				for(i = 0; i < mindmap.size(); i++) {
					if(mindmap[i].status == "open")
						still_open = true;
						break;
				}
				
				if(!still_open)
					break;
			}
		}
		
	else
		std.print("unknown command.");
}

for(1) {
	std.color("green");
	cmd = std.input(">>> (user) ").strip();

	//One fixed command, /load for loading prompt text files
	if(cmd.starts("/load")) {
		cmd = cmd.removeprefix("/load").strip();
		cmd = fileio.read_string(cmd);
	}
	else if(cmd == "exit" || cmd == "/exit")
		break;
	else if(cmd.starts("/"))
		check_command(planner, cmd);
		continue;
	
	if(cmd.empty())
		continue;
	
	std.cout("\n");
	
	stdfcol("magenta");
	std.cout("(miniagent) ");
	
	try {
		result = planner.task(cmd);
		if(result.ok && result.reports)
			std.cout(result.reports[0].report);
		fileio.remove(".plan");
		std.cout("\nTOKEN USAGE:\n\n");
		token_usage_global = std.global("_global_token_usage");
		std.cout(token_usage_global["usage"]);
	}
	catch(e) {
		
	}
	
	std.cout("\n");
	std.cout("\n");
}