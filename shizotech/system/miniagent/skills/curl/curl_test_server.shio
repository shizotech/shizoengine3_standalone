// ============================================================================
// curl_test_server.shio — local HTTP fixture for the curl skill selftests
//
//   #include "curl_test_server.shio"
//   server = curl_test_server_start(13357);
//   ...
//   server.stop();
//
// Routes:
//   GET  /plain                  -> "hello world"
//   *    /echo                   -> json {method, path, query, body, x_marker, content_type}
//   *    /status/<code>          -> answers with that http code
//   GET  /big/<n>                -> a body of at least n characters
//   GET  /redirect               -> 302 to /plain (tests redirect following)
//   GET  /stream/<count>/<ms>    -> chunk1..chunkN, <ms> apart, chunked
//   GET  /forever                -> ticks every 50 ms until the client stops it
//   POST /upload                 -> json report about the multipart body
// ============================================================================

import webserver;

curl_test_server_start(port) {
    server = webserver.http_server(std.int(port));

    server.route("GET", "^/plain$", [](req, writer) {
        return [
            status_code = 200,
            headers = ["Content-Type" = "text/plain"],
            body = "hello world",
        ];
    });

    server.route("HEAD", "^/plain$", [](req, writer) {
        return [
            status_code = 200,
            headers = ["Content-Type" = "text/plain", "X-Head" = "yes"],
            body = "",
        ];
    });

    server.route("*", "^/echo$", [](req, writer) {
        marker = req.headers.geti("x-marker");

        out = [
            method = std.string(req.method),
            path = std.string(req.path),
            query = std.string(req.query),
            body = std.string(req.body),
            x_marker = std.string(marker),
            content_type = std.string(req.content_type),
            query_params = req.query_params,
        ];

        return [
            status_code = 200,
            headers = ["Content-Type" = "application/json"],
            body = std.string(out),
        ];
    });

    server.route("*", "^/status/([0-9]+)$", [](req, writer) {
        code = std.int(req.matches[0]);

        return [
            status_code = code,
            headers = ["Content-Type" = "text/plain"],
            body = "status " + std.string(code),
        ];
    });

    server.route("GET", "^/big/([0-9]+)$", [](req, writer) {
        n = std.int(req.matches[0]);
        line = "0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz\n";
        s = "";

        for(s.length() < n)
            s += line;

        return [
            status_code = 200,
            headers = ["Content-Type" = "text/plain"],
            body = s,
        ];
    });

    server.route("GET", "^/redirect$", [](req, writer) {
        return [status_code = 302, headers = ["Location" = "/plain"], body = ""];
    });

    server.route("GET", "^/stream/([0-9]+)/([0-9]+)$", [](req, writer) {
        count = std.int(req.matches[0]);
        delay = std.int(req.matches[1]);

        if(!writer.write_header(200, "text/plain", ["Cache-Control" = "no-cache"]))
            return;

        for(i = 0; i < count; i++) {
            writer.write("chunk" + std.string(i + 1) + "\n");
            std.sleep(delay);
        }

        writer.end();
    });

    server.route("GET", "^/forever$", [](req, writer) {
        if(!writer.write_header(200, "text/plain", ["Cache-Control" = "no-cache"]))
            return;

        n = 0;

        for(writer.is_client_alive() && n < 200000) {
            writer.write("tick" + std.string(n) + "\n");
            n++;
            std.sleep(50);
        }

        writer.end();
    });

    server.route("POST", "^/upload$", [](req, writer) {
        body = std.string(req.body);
        parts = req.multipart.geti("parts");

        out = [
            is_multipart = req.multipart.geti("is_multipart"),
            fields = req.multipart.geti("fields"),
            parts = std.is_json(parts) ? parts.size() : 0,
            has_upload = json.bool(body.contains("UPLOADDATA")),
            has_filename = json.bool(body.contains("filename=")),
            bytes = body.length(),
            content_type = std.string(req.content_type),
        ];

        return [
            status_code = 200,
            headers = ["Content-Type" = "application/json"],
            body = std.string(out),
        ];
    });

    if(!server.start())
        return None;

    return server;
}
