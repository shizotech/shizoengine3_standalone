
add_tools(agt)
{
	agt.add_tool(
		"view_image",
		"Open an image.",
		[
			path = "&string(): File path to a local image.",
		],
		[](agt, args)
		{		
			scr = fileio.read_file(args.path);
			if(!scr)
				return "Cannot open image.";
			
			res = agt.inject_visual_prompt(scr);

			return res;
		}
	);
}
	