
shzdocs.load_all_modules();

test() {
	args = [path="std.thread.run", compact=false];

	res = shzdocs.get_namespace(args.path);

	if(res.found) {
		if(res.has("documentation"))
			res.erase("documentation");
		if(args.compact)
			res.remove_all_keys("description");
			res.remove_all_keys("params");
		std.print("FOUND NAMESPACE");
		return res;
	}

	res = shzdocs.get_class(args.path);

	if(res.found) {
		//std.print(res);
		if(res.has("documentation"))
			res.erase("documentation");
		if(args.compact)
			res.remove_all_keys("description");
			//res.remove_all_keys("params");
		std.print("FOUND CLASS");
		return res;
	}

	res = shzdocs.get_path(args.path);

	if(res.found) {
		//std.print(res);
		//if(res.has("documentation"))
		//	res.erase("documentation");
		if(res.has("owner_members"))
			res.erase("owner_members");
		if(args.compact)
			res.remove_all_keys("description");
			res.remove_all_keys("params");
		std.print("FOUND PATH");
		return res;
	}

	return [
		found = false,
		status = "The requested path does not exist.",
	];
}

std.print(test());

std.input();