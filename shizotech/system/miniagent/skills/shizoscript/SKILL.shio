
import tempfile;

add_tools(agt)
{
	local_dir = fileio.file_dir(std.local_executable());

	pkgs = fileio.dirs(local_dir + "/shizotech/packages", 0);

	for(i = 0; i < pkgs.size(); i++)
	{
		std.import(pkgs[i]);
	}

	shzdocs.load_all_modules();

	agt.add_tool(
		"shizoscript_all_docs",
		"Return all documentations available for shizoscript (modules, workflows, etc..)",
		None,
		[](agt, args)
		{		
			return fileio.files(__DIR__ + "/docs");
		}
	);

	agt.add_tool(
		"shizoscript_docs",
		"Return docs to specific topics.",
		[
			path = "&array(string): Docs paths for example 'kernels.md'",
		],
		[](agt, args)
		{		
			res = [];
			for(i = 0; i < args.path.size(); i++) {
				res[args.path[i]] = fileio.read_string(__DIR__ + "/docs/" + args.path[i]);
			}
		
			return res;
		}
	);
	
	agt.add_tool(
		"shizoscript_symbols",
		"Resolve docs for a namespaces, function, classes, objects or variable path (exact).\nHINT: This function auto-compacts when there are too many hits.\nCall this function again with a more specific path to get more detail.",
		[
			paths = "&array(string): A list of paths like 'std' or a dotted path like 'math.sin' or an object type like 'nanogui.widget' or 'std.thread' or member function like 'nanogui.widget.on_mouse_button' etc.",
			compact = "&int(0,1): Return compact representation (no parameter info, no description, just raw names).",
		],
		[](agt, args)
		{		
			std.print(args);
			res = [];
			if(std.is_json(args.paths)) {
				for(i = 0; i < args.paths.size(); i++) {
					res[args.paths[i]] = shzdocs.lookup(args.paths[i]);
				}
			}
			else
				res[args.paths] = shzdocs.lookup(args.paths);
			std.print(res);
			return res;
		}
	);
	
	agt.add_tool(
		"shizoscript_search_keywords",
		"Find namespaces|functions|variables|types and docs by keywords.",
		[
			keywords = "&string(): A comma separated list of keywords to seach for",
			require_all = "&int(0,1): Requires all keywords to be present in a type's description to be listed"
		],
		[](agt, args)
		{		
			return shzdocs.search(args.keywords, args.require_all);
		}
	);
		
	agt.add_tool(
		"shizoscript_resolve_include",
		"Resolve standard include files for scripts",
		[
			path = "&string(): Path of the included file"
		],
		[](agt, args)
		{		
			return std.resolve_source_file(args.path);
		}
	);
	
	agt.add_tool(
		"shizoscript_bin_path",
		"Returns the location of the shizoscript binary to be used to run shizoscript source files.",
		None,
		[](agt, args)
		{
			path = std.local_executable();
			
			managed tmp = tempfile.tempfile();
			
			std.system(path + " --help > " + tmp.path());
		
			help_docs = tmp.read();
			
			return [
				path = path,
				help = help_docs,
			];
		}
	);
}
	