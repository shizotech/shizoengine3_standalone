
// ============================================================================
// web_client_selftest.shio — tests of the web library (no LLM endpoint)
//
//   shz web_client_selftest.shio
//
// Offline part: url encode/decode, entities, html->text, parser fixtures.
// Online part:  jina fetch, direct fetch, search. Skipped when the machine has
//               no internet, so the offline contract is always verifiable.
// ============================================================================

#include "web_client.shio"

passed = 0;
failed = 0;

check(label, condition, detail = "")
{
	if(condition)
	{
		passed++;
		std.print("PASS ", label);
	}
	else
	{
		failed++;
		std.print("FAIL ", label, detail ? " -> " + std.string(detail) : "");
	}
}

// ----------------------------------------------------------------------------
// url encoding
// ----------------------------------------------------------------------------

check("url_encode keeps unreserved", web_url_encode("a-b_c.d~e") == "a-b_c.d~e", web_url_encode("a-b_c.d~e"));
check("url_encode space to +", web_url_encode("a b") == "a+b", web_url_encode("a b"));
check("url_encode reserved", web_url_encode("a&b=c?d") == "a%26b%3Dc%3Fd", web_url_encode("a&b=c?d"));
check("url_encode utf8", web_url_encode("é") == "%C3%A9", web_url_encode("é"));
check("url_encode roundtrip", web_url_decode(web_url_encode("café 中文 a+b?x=1&y=2")) == "café 中文 a+b?x=1&y=2",
	web_url_decode(web_url_encode("café 中文 a+b?x=1&y=2")));
check("url_decode plain", web_url_decode("https://x.com/a/b") == "https://x.com/a/b");
check("url_decode lower hex", web_url_decode("%c3%a9") == "é", web_url_decode("%c3%a9"));
check("url_decode upper hex", web_url_decode("%C3%A9") == "é", web_url_decode("%C3%A9"));
want = std.buffer();
want.append([1, 10, 15, 26, 255]);
check("url_decode all hex digits", web_url_decode("%01%0a%0F%1A%ff") == want.string(), web_url_decode("%01%0a%0F%1A%ff"));
check("url_decode trailing percent kept", web_url_decode("a%") == "a%", web_url_decode("a%"));
check("url_decode bad escape kept", web_url_decode("a%zzb") == "a%zzb", web_url_decode("a%zzb"));

// ----------------------------------------------------------------------------
// entities
// ----------------------------------------------------------------------------

check("decode named", web_decode_entities("a &amp; b") == "a & b", web_decode_entities("a &amp; b"));
check("decode numeric", web_decode_entities("&#65;&#66;") == "AB", web_decode_entities("&#65;&#66;"));
check("decode hex", web_decode_entities("&#x263A;") == "☺", web_decode_entities("&#x263A;"));
check("decode emoji cp", web_decode_entities("&#128512;") == "😀", web_decode_entities("&#128512;"));
check("decode nbsp", web_decode_entities("a&nbsp;b") == "a b", web_decode_entities("a&nbsp;b"));
check("decode unknown kept", web_decode_entities("&nope;") == "&nope;", web_decode_entities("&nope;"));
check("decode unterminated kept", web_decode_entities("a & b") == "a & b", web_decode_entities("a & b"));
check("decode tags", web_decode_entities("&lt;b&gt;") == "<b>", web_decode_entities("&lt;b&gt;"));
check("decode emdash", web_decode_entities("Erik M &mdash; we&#x27;re here") == "Erik M — we're here",
	web_decode_entities("Erik M &mdash; we&#x27;re here"));

// ----------------------------------------------------------------------------
// html -> text
// ----------------------------------------------------------------------------

check("html_to_text strips tags",
	web_html_to_text("<p>hello</p><p>world</p>") == "hello\nworld", web_html_to_text("<p>hello</p><p>world</p>"));

check("html_to_text drops script",
	web_html_to_text("<p>a</p><script>var x = '<b>';</script><p>b</p>") == "a\nb",
	web_html_to_text("<p>a</p><script>var x = '<b>';</script><p>b</p>"));

check("html_to_text drops style",
	web_html_to_text("<style>a{color:red}</style><p>ok</p>") == "ok",
	web_html_to_text("<style>a{color:red}</style><p>ok</p>"));

check("html_to_text drops comment",
	web_html_to_text("<p>a</p><!-- hidden --><p>b</p>") == "a\nb",
	web_html_to_text("<p>a</p><!-- hidden --><p>b</p>"));

check("html_to_text list items",
	web_html_to_text("<ul><li>one</li><li>two</li></ul>") == "- one\n- two",
	web_html_to_text("<ul><li>one</li><li>two</li></ul>"));

check("html_to_text br",
	web_html_to_text("a<br>b<br/>c") == "a\nb\nc", web_html_to_text("a<br>b<br/>c"));

check("html_to_text entities",
	web_html_to_text("<p>a &amp; b &#8212; c</p>") == "a & b — c", web_html_to_text("<p>a &amp; b &#8212; c</p>"));

check("html_to_text collapses",
	web_html_to_text("<div>   a   b   </div>\n\n\n<div>  c </div>") == "a b\nc",
	web_html_to_text("<div>   a   b   </div>\n\n\n<div>  c </div>"));

check("html_to_text nested quote in attribute",
	web_html_to_text("<a x=\"a>b\">link</a>") == "link", web_html_to_text("<a x=\"a>b\">link</a>"));

check("html_to_text unclosed tag",
	web_html_to_text("<p>a<p>b") == "a\nb", web_html_to_text("<p>a<p>b"));

check("html_to_text head dropped",
	web_html_to_text("<html><head><title>T</title><meta x=1></head><body>text</body></html>") == "text",
	web_html_to_text("<html><head><title>T</title><meta x=1></head><body>text</body></html>"));

check("inline_text single line",
	web_inline_text("<b>Shizo</b>script\n is <i>great</i>") == "Shizoscript is great",
	web_inline_text("<b>Shizo</b>script\n is <i>great</i>"));

big = "";
for(i = 0; i < 4000; i++)
	big += "<div class='x'><a href='http://e.com/1'>Link " + i + " &amp; x</a> text</div>";
big += "<script>var q = '<div>';</script>";
bt = std.millis();
bout = web_html_to_text(big);
check("html_to_text handles input past the regex limit",
	bout.size() > 1000 && bout.contains("Link 3999") && !bout.contains("<div") && !bout.contains("var q"),
	[size = bout.size(), ms = std.millis() - bt]);

// ----------------------------------------------------------------------------
// url helpers
// ----------------------------------------------------------------------------

check("absolute from root", web_absolute_url("https://a.com/p/q", "/x/y") == "https://a.com/x/y", web_absolute_url("https://a.com/p/q", "/x/y"));
check("absolute relative", web_absolute_url("https://a.com/p/q", "z") == "https://a.com/p/z", web_absolute_url("https://a.com/p/q", "z"));
check("absolute protocol free", web_absolute_url("https://a.com/", "//b.com/c") == "https://b.com/c", web_absolute_url("https://a.com/", "//b.com/c"));
check("absolute full", web_absolute_url("https://a.com/", "https://b.com/c") == "https://b.com/c");
check("host of url", web_host("https://User@www.Example.com:8080/a?b") == "www.example.com", web_host("https://User@www.Example.com:8080/a?b"));
check("is_http", web_is_http("http://a") && web_is_http("https://a") && !web_is_http("ftp://a") && !web_is_http("a"));
check("clean_url drops fragment", web_clean_url("https://a/b#frag") == "https://a/b", web_clean_url("https://a/b#frag"));

check("ddg unwrap uddg",
	web_ddg_unwrap("//duckduckgo.com/l/?uddg=https%3A%2F%2Fgithub.com%2Fshizotech&amp;rut=abc") == "https://github.com/shizotech",
	web_ddg_unwrap("//duckduckgo.com/l/?uddg=https%3A%2F%2Fgithub.com%2Fshizotech&amp;rut=abc"));

check("attr value quoted", web_attr_value("<a href=\"x/y\">t</a>", 7) == "x/y", web_attr_value("<a href=\"x/y\">t</a>", 7));
check("attr value single", web_attr_value("<a href='x/y'>t</a>", 7) == "x/y", web_attr_value("<a href='x/y'>t</a>", 7));
check("attr value bare", web_attr_value("<a href=x/y>t</a>", 7) == "x/y", web_attr_value("<a href=x/y>t</a>", 7));
check("attr value empty", web_attr_value("<a href=\"\">t</a>", 7) == "", web_attr_value("<a href=\"\">t</a>", 7));
check("attr value unterminated", web_attr_value("<a href=\"x/y>t</a>", 7) == "", web_attr_value("<a href=\"x/y>t</a>", 7));

// ----------------------------------------------------------------------------
// parser fixtures (offline, from real saved pages)
// ----------------------------------------------------------------------------

fixture = __DIR__ + "/ddg_lite.html";
if(fileio.exists(fixture))
{
	html = fileio.read_string(fixture);
	list = web_parse_ddg_lite(html);

	check("ddg fixture parses results", list.size() >= 5, list.size());

	if(list.size())
	{
		first = list[0];
		check("ddg first title", first.title.contains("shizoscript3"), first.title);
		check("ddg first url", first.url == "https://github.com/shizotech/shizoscript3", first.url);
		check("ddg first snippet", first.snippet.size() > 20, first.snippet);
		check("ddg first display", first.display.contains("github.com"), first.display);

		uniq = [];
		for(i = 0; i < list.size(); i++)
			uniq[list[i].url] = 1;
		check("ddg urls unique", uniq.size() == list.size(), [n = list.size(), u = uniq.size()]);

		all_http = true;
		for(i = 0; i < list.size(); i++)
			if(!web_is_http(list[i].url)) all_http = false;
		check("ddg all urls http", all_http, list);

		no_tags = true;
		for(i = 0; i < list.size(); i++)
			if(list[i].title.contains("<") || list[i].snippet.contains("<")) no_tags = false;
		check("ddg no tags in text", no_tags, list);
	}
}
else
	check("ddg fixture present", false, fixture);

// bing ck/a redirect urls
check("bing unwrap plain url", web_bing_unwrap("https://a.com/b") == "https://a.com/b", web_bing_unwrap("https://a.com/b"));
check("bing unwrap ck/a",
	web_bing_unwrap("https://www.bing.com/ck/a?!&&p=abc&ptn=3&u=a1aHR0cHM6Ly93d3cuZXhhbXBsZS5jb20v&ntb=1") == "https://www.example.com/",
	web_bing_unwrap("https://www.bing.com/ck/a?!&&p=abc&ptn=3&u=a1aHR0cHM6Ly93d3cuZXhhbXBsZS5jb20v&ntb=1"));
check("bing unwrap keeps fragment free",
	web_bing_unwrap("https://www.bing.com/ck/a?!&&u=a1aHR0cHM6Ly94LmNvbS9hI2ZyYWc&ntb=1") == "https://x.com/a",
	web_bing_unwrap("https://www.bing.com/ck/a?!&&u=a1aHR0cHM6Ly94LmNvbS9hI2ZyYWc&ntb=1"));
check("bing unwrap garbage falls back",
	web_bing_unwrap("https://www.bing.com/ck/a?!&&p=zzz&ntb=1").contains("bing.com"),
	web_bing_unwrap("https://www.bing.com/ck/a?!&&p=zzz&ntb=1"));

check("b64 decode padded", web_b64_decode("aHR0cHM6Ly93d3cuZm9vLmNvbS9iYXItYmF6") == "https://www.foo.com/bar-baz", web_b64_decode("aHR0cHM6Ly93d3cuZm9vLmNvbS9iYXItYmF6"));
check("b64 decode unpadded", web_b64_decode("aHR0cHM6Ly94") == "https://x", web_b64_decode("aHR0cHM6Ly94"));
check("b64 decode urlsafe", web_b64_decode("aHR0cHM6Ly94LXlfcA") == "https://x-y_p", web_b64_decode("aHR0cHM6Ly94LXlfcA"));
check("b64 decode garbage is empty", web_b64_decode("!!!not base64!!!") == "", web_b64_decode("!!!not base64!!!"));

// rss fixtures
rss_fixture = __DIR__ + "/bing_rss.xml";
if(fileio.exists(rss_fixture))
{
	rss = fileio.read_string(rss_fixture);
	rl = web_parse_rss(rss);

	check("bing rss fixture parses", rl.size() >= 3, rl.size());
	if(rl.size())
	{
		check("rss title", rl[0].title.size() > 3, rl[0].title);
		check("rss url direct (not ck/a)", web_is_http(rl[0].url) && !rl[0].url.contains("/ck/a"), rl[0].url);
		check("rss snippet", rl[0].snippet.size() > 10, rl[0].snippet);
		check("rss display host", rl[0].display.size() > 3, rl[0].display);
		check("rss date", rl[0].date.size() > 3, rl[0].date);

		clean = true;
		for(i = 0; i < rl.size(); i++)
			if(rl[i].title.contains("<") || rl[i].url.contains("&amp;")) clean = false;
		check("rss entities decoded", clean, rl);
	}
}
else
	check("bing rss fixture present", false, rss_fixture);

atom = R"(<?xml version="1.0"?><feed xmlns="http://www.w3.org/2005/Atom"><entry><title>Atom &amp; Title</title><link href="https://a.com/x"/><summary><![CDATA[Some <b>cdata</b> text]]></summary><updated>2026-01-01T00:00:00Z</updated></entry></feed>)";
al = web_parse_rss(atom);
check("atom entry parsed", al.size() == 1, al);
if(al.size() == 1)
{
	check("atom title decoded", al[0].title == "Atom & Title", al[0].title);
	check("atom link href", al[0].url == "https://a.com/x", al[0].url);
	check("atom cdata snippet", al[0].snippet == "Some cdata text", al[0].snippet);
	check("atom updated date", al[0].date.contains("2026"), al[0].date);
}

rssitem = "<rss><channel><item><title>A &amp; B</title><link>https://a.com/1</link><description>desc one</description></item><item><title>C</title><link>https://a.com/2</link><description>desc two</description></item><item><title>D</title><link>https://a.com/2</link><description>dup</description></item></channel></rss>";
il = web_parse_rss(rssitem);
check("rss items parsed", il.size() == 2, il);
check("rss duplicates dropped", il.size() == 2 && il[0].url == "https://a.com/1" && il[1].url == "https://a.com/2", il);
check("rss empty feed", web_parse_rss("<rss><channel></channel></rss>").size() == 0);
check("rss garbage input", web_parse_rss("not xml at all").size() == 0);

// ----------------------------------------------------------------------------
// relevance scoring
// ----------------------------------------------------------------------------

tk = web_query_tokens("shizoscript site:github.com creative -noise \"exact phrase\"");
check("tokens drop operators", !tk.has_value("site") && !tk.has_value("noise"), tk);
check("tokens keep words", tk.has_value("shizoscript") && tk.has_value("creative") && tk.has_value("phrase"), tk);
check("tokens drop stopwords", !web_query_tokens("the and for with from this that").size(), web_query_tokens("the and for with from this that"));
check("tokens dedupe", web_query_tokens("alpha alpha beta").size() == 2, web_query_tokens("alpha alpha beta"));

rel_results = [
	[title = "ShizoTech | Creative-Technical Hub", url = "https://shizotech.com", snippet = "Shizoscript is a creative coding language"],
	[title = "GitHub - shizotech/shizoscript3", url = "https://github.com/shizotech/shizoscript3", snippet = "Custom Programming language"],
	[title = "shizoscript docs", url = "https://shizotech.com/docs", snippet = "the shizoscript runtime"],
];
off_results = [
	[title = "Best Gutter Cleaning in Barrie", url = "https://yelp.ca", snippet = "gutter cleaning services"],
	[title = "Early Retirement pros and cons", url = "https://investopedia.com", snippet = "retirement planning"],
	[title = "Kara Peterson | LinkedIn", url = "https://linkedin.com", snippet = "profile"],
];

check("relevant results score high", web_relevance(rel_results, web_query_tokens("shizoscript")) == 100, web_relevance(rel_results, web_query_tokens("shizoscript")));
check("off topic results score 0", web_relevance(off_results, web_query_tokens("shizoscript")) == 0, web_relevance(off_results, web_query_tokens("shizoscript")));
check("mixed results score partial",
	web_relevance([rel_results[0], off_results[0]], web_query_tokens("shizoscript")) == 50,
	web_relevance([rel_results[0], off_results[0]], web_query_tokens("shizoscript")));
check("empty result list scores 0", web_relevance([], web_query_tokens("x")) == 0);
check("no tokens scores 100", web_relevance(off_results, []) == 100);
check("url match counts", web_relevance([[title = "x", url = "https://shizoscript.dev/a", snippet = ""]], web_query_tokens("shizoscript")) == 100);

check("trim keeps max", web_trim([1, 2, 3, 4], 2).size() == 2, web_trim([1, 2, 3, 4], 2));
check("trim leaves short lists", web_trim([1, 2], 5).size() == 2);

// ----------------------------------------------------------------------------
// online
// ----------------------------------------------------------------------------

online = false;
probe = web_http("GET", "https://example.com", "", None, 15000);
if(probe.ok && probe.http_code == 200)
	online = true;

check("web_http GET example", probe.ok && probe.http_code == 200 && probe.body.contains("Example Domain"), probe.http_code);
check("web_http reports content_type", probe.content_type.contains("text/html"), probe.content_type);

bad = web_http("GET", "http://no-such-host.invalid/x", "", None, 8000);
check("web_http dead host is ok=false with a reason", !bad.ok && bad.error.size() > 0, bad);

b404 = web_http("GET", "https://example.com/nope-404", "", None, 15000);
check("web_http 404 is ok=false", !b404.ok && b404.http_code == 404, b404.http_code);

if(online)
{
	f = web_fetch("https://en.wikipedia.org/wiki/DuckDuckGo", 4000, "markdown");
	check("web_fetch jina ok", f.ok, f);
	check("web_fetch jina provider", f.provider == "jina" || f.provider == "direct", f.provider);
	check("web_fetch jina title", f.title.contains("DuckDuckGo"), f.title);
	check("web_fetch jina content", f.content.size() > 500, f.content.size());
	check("web_fetch markdown has headings", f.content.contains("#") || f.content.contains("DuckDuckGo"), f.content.substr(0, 200));

	t = web_fetch("https://en.wikipedia.org/wiki/DuckDuckGo", 1200, "markdown");
	check("web_fetch truncates", t.truncated == 1 && t.content.size() <= 1200 && t.total > 1200, [c = t.content.size(), total = t.total]);

	raw = web_fetch("https://example.com", 5000, "html");
	check("web_fetch html mode", raw.ok && raw.content.contains("<html") , raw.content.substr(0, 80));

	txt = web_fetch("https://example.com", 5000, "text");
	check("web_fetch text mode", txt.ok && txt.content.contains("domain"), txt.content.substr(0, 120));

	nofetch = web_fetch("ftp://example.com");
	check("web_fetch rejects non http", !nofetch.ok, nofetch);

	emptyfetch = web_fetch("");
	check("web_fetch rejects empty url", !emptyfetch.ok, emptyfetch);

	// direct path (mode=text forces no jina only when jina fails; force with html)
	check("web_fetch adds scheme", web_fetch("example.com", 2000, "html").ok, "bare host");

	s = web_search("shizoscript programming language", [max_results = 5]);
	check("web_search returns results", s.ok && s.results.size() >= 3, s);
	if(s.results.size())
	{
		r0 = s.results[0];
		check("search result has title", r0.title.size() > 3, r0.title);
		check("search result has url", web_is_http(r0.url), r0.url);
		check("search result url not a proxy", !r0.url.contains("duckduckgo.com/l?") && !r0.url.contains("uddg="), r0.url);
	}

	site = web_search("shizoscript", [include_domains = "github.com", max_results = 5]);
	if(site.ok && !site.geti("warning").size())
	{
		only_gh = true;
		for(i = 0; i < site.results.size(); i++)
			if(!site.results[i].url.contains("github.com")) only_gh = false;
		check("include_domains restricts results", site.results.size() > 0 && only_gh, site.results);
	}
	else
		check("include_domains: guard rejects off-topic answers", site.geti("warning").size() > 0 || !site.ok, site);

	exc = web_search("shizoscript", [exclude_domains = "github.com", max_results = 5]);
	if(exc.ok && !exc.geti("warning").size())
	{
		none_gh = true;
		for(i = 0; i < exc.results.size(); i++)
			if(exc.results[i].url.contains("github.com")) none_gh = false;
		check("exclude_domains filters", exc.results.size() > 0 && none_gh, exc.results);
	}
	else
		check("exclude_domains: guard rejects off-topic answers", exc.geti("warning").size() > 0 || !exc.ok, exc);

	empty = web_search("   ");
	check("empty query is ok=false", !empty.ok, empty);

	nodata = web_search("zzxqvw12398777nodataatall", [max_results = 3]);
	check("no-result query is handled", nodata.has("ok"), nodata);

	page1 = web_search("shizoscript", [max_results = 5]);
	page2 = web_search("shizoscript", [max_results = 5, page = 2]);
	check("page 2 answers", page2.ok, page2);
	if(page1.ok && page2.ok)
	{
		overlap = 0;
		for(i = 0; i < page1.results.size(); i++)
		{
			for(k = 0; k < page2.results.size(); k++)
				if(page1.results[i].url == page2.results[k].url) overlap++;
		}
		check("page 2 differs from page 1", overlap == 0, [p1 = page1.results, p2 = page2.results]);
	}

	one = web_search("shizoscript", [max_results = 1]);
	check("max_results respected", one.ok && one.results.size() <= 1, one.results.size());

	// relevance guard: bing answers niche queries with generic localized junk;
	// the skill must label that, not present it as a normal answer
	bing_niche = web_search("shizoscript", [provider = "bing", min_relevance = 100]);
	check("low relevance is labelled",
		!bing_niche.ok || bing_niche.relevance < 100 || bing_niche.geti("warning").size() > 0,
		[rel = bing_niche.geti("relevance"), w = bing_niche.geti("warning")]);

	accept_any = web_search("shizoscript", [provider = "bing", min_relevance = 0]);
	check("min_relevance=0 accepts any answer", accept_any.ok && accept_any.results.size() > 0, accept_any);

	check("search reports relevance", s.has("relevance"), s);

	std.print("");
	std.print("providers used: search=", s.provider, " fetch=", f.provider);
}
else
	std.print("OFFLINE: network tests skipped");

std.print("");
std.print("WEB CLIENT SELFTEST: ", passed, " passed, ", failed, " failed");

if(failed)
	std.exitprocess(1);
std.exitprocess(0);
