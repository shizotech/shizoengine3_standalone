
#include "openai/generic_agent"

class ModelConfig {

	//Endpoint config
	url = "";
	token = "";

	//Model config
	name = "";
	max_tokens = 128000;

	//Generation config
	max_running_agents = 0;

	__init__() {

	}

	normalize_url(_url) {
		s = std.string(_url ?? "");
		s = s.strip();

		for(1) {
			if(s.ends("/v1/")) {
				s = s.removesuffix("/v1/");
				continue;
			}
			if(s.ends("/v1")) {
				s = s.removesuffix("/v1");
				continue;
			}
			if(s.ends("/")) {
				s = s.removesuffix("/");
				continue;
			}
			break;
		}

		return s;
	}

	from_json(cfg) {
		if(!std.is_json(cfg))
			return false;

		url = "";
		token = "";
		name = "";
		max_tokens = 128000;
		max_running_agents = 0;

		if(cfg.has("url"))
			url = std.string(cfg.url);
		if(cfg.has("token"))
			token = std.string(cfg.token);
		if(cfg.has("name"))
			name = std.string(cfg.name);
		if(cfg.has("max_tokens"))
			max_tokens = std.int(cfg.max_tokens);
		if(cfg.has("max_running_agents"))
			max_running_agents = std.int(cfg.max_running_agents);

		url = normalize_url(url);

		if(!max_tokens)
			max_tokens = 128000;

		return true;
	}

	to_json() {
		return [
			url = url,
			token = token,
			name = name,
			max_tokens = max_tokens,
			max_running_agents = max_running_agents,
		];
	}

	summary() {
		out = url;
		if(name)
			out += "  model=" + name;
		out += "  ctx=" + std.string(max_tokens);
		if(max_running_agents)
			out += "  agents=" + std.string(max_running_agents);
		return out;
	}

	set(_url, _token, _name, _max_tokens = 128000, _max_running_agents = 0, _connect = true) {
		url = normalize_url(_url);
		token = std.string(_token ?? "");
		name = std.string(_name ?? "");
		max_tokens = std.int(_max_tokens ?? 128000);
		max_running_agents = std.int(_max_running_agents ?? 0);

		if(!max_tokens)
			max_tokens = 128000;

		if(!_connect)
			return true;

		return connect();
	}

	load(path, _connect = true) {
		cfg = fileio.read_json(path, true);

		if(!from_json(cfg))
			return false;

		if(!_connect)
			return true;

		return connect();
	}

	// Loads one endpoint from a config file.
	//
	// Supported layouts:
	//   flat:        {"url": "...", "name": "..."}
	//   top profile: {"worker": {"url": "..."}, "receptionist": {...}}
	//   profiles:    {"profiles": {"worker": {...}}}
	load_profile(path, profile = "", _connect = true) {
		data = fileio.read_json(path, true);

		if(!std.is_json(data))
			return false;

		profile = std.string(profile ?? "").strip();

		if(profile) {
			if(data.has(profile) && std.is_json(data[profile])) {
				if(!from_json(data[profile]))
					return false;
			}
			else if(data.has("profiles") && std.is_json(data.profiles) && data.profiles.has(profile) && std.is_json(data.profiles[profile])) {
				if(!from_json(data.profiles[profile]))
					return false;
			}
			else if(profile == "default" && data.has("url")) {
				if(!from_json(data))
					return false;
			}
			else {
				return false;
			}
		}
		else {
			if(!from_json(data))
				return false;
		}

		if(!_connect)
			return true;

		return connect();
	}

	save(path) {
		ensure_parent_dir(path);
		return fileio.write_json(path, to_json());
	}

	save_profile(path, profile = "") {
		profile = std.string(profile ?? "").strip();
		ensure_parent_dir(path);

		if(!profile || profile == "default") {
			return fileio.write_json(path, to_json());
		}

		data = fileio.read_json(path, true);

		if(!std.is_json(data))
			data = [];

		if(data.has("url") && !data.has("profiles")) {
			old = data.copy();
			data = [profiles = [default = old]];
		}

		if(!data.has("profiles") || !std.is_json(data.profiles))
			data.profiles = [];

		data.profiles[profile] = to_json();

		return fileio.write_json(path, data);
	}

	copy_from(cfg) {
		url = cfg.url;
		token = cfg.token;
		name = cfg.name;
		max_tokens = cfg.max_tokens;
		max_running_agents = cfg.max_running_agents;
	}

	copy() {
		c = ModelConfig();
		c.copy_from(this);
		return c;
	}

	ensure_parent_dir(path) {
		try {
			dir = fileio.file_dir(std.string(path));
			if(dir && !fileio.exists(dir))
				fileio.mkdir(dir);
		}
		catch(e) {}
	}

	connect() {
		//Test connection
		//Try 3 times...

		if(!url)
			return false;

		std.cout("\ntesting... ", url, "...");

		for(i = 0; i < 3; i++) {
			try {
				//Test the api once
				gpt = generic_agent(url, name, None, token);
				test_result = gpt.text("This is a simple system test.\nAnswer with 'hello world'.\nDo not write anything else.\nDo not think, just execute.");
				if(test_result) {
					test_result = test_result.lowercase();
					if(test_result.find("hello world") >= 0) {

						//Try to get real max model len...
						model_ctx = gpt.context.get_context_size();

						std.cout("online.\n\n");

						if(model_ctx)
							std.cout("context size: ", model_ctx, ".\n\n");
							max_tokens = model_ctx;

						return true;
					}
				}
			}
			catch(e) {}
		}

		return false;
	}

}
