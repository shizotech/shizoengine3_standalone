
class ModelConfig {
	
	//Endpoint config
	url = "";
	token = "";
	
	//Model config
	name = "";
	max_tokens = 128000;

	//Generation config
	max_running_agents = 0;

	__init__() {
		
	}

	set(_url, _token, _name, _max_tokens = 128000, _max_running_agents = 0) {
		url = _url;
		token = _token;
		name = _name;
		max_tokens = _max_tokens;
		max_running_agents = _max_running_agents;
		
		if(!max_tokens)
			max_tokens = 128000;

		return connect();
	}

	load(path) {
		cfg = fileio.read_json(path);
		url = cfg.url;
		token = cfg.token;
		name = cfg.name;
		max_tokens = cfg.max_tokens;
		max_running_agents = cfg.max_running_agents;
		
		return connect();
	}
	
	save(path) {
		cfg = [
			url = url,
			token = token,
			name = name,
			max_tokens = max_tokens,
			max_running_agents = max_running_agents,
		];
		
		return fileio.write_json(path, cfg);
	}

	connect() {
		//Test connection
		//Try 3 times...
		
		if(!url)
			return false;
		
		std.cout("\ntesting... ", url, "...");
		
		for(i = 0; i < 3; i++) {
			try {
				//Test the api once
				gpt = generic_agent(url, name, None, token);
				test_result = gpt.text("This is a simple system test.\nAnswer with 'hello world'.\nDo not write anything else.\nDo not think, just execute.");
				if(test_result) {
					test_result = test_result.lowercase();
					if(test_result.find("hello world") >= 0) {
						
						//Try to get real max model len...
						model_ctx = gpt.context.get_context_size();
						
						std.cout("online.\n\n");
						
						if(model_ctx)
							std.cout("context size: ", model_ctx, ".\n\n");
							max_tokens = model_ctx;
											
						return true;
					}
				}
			}
			catch(e) {}
		}
		
		return false;
	}

}
