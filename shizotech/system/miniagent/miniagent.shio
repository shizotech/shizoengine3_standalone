
#include "openai/generic_agent"
#include "miniagent_defs"
#include "roles/SHARED"

#include "model_config"
#include "agent_slots"

//Helper functions to set console output color
stdfcol(col) {
	std.color(col, "black");
}
stdbcol(col) {
	std.color("white", col);
}

def create_miniagent(cfg, system_role);

class miniagent
{	
	//ModelConfig class
	model_config = ModelConfig();
	
	managed llm_api = None;
	managed skills = [];
	
	agent_id = std.random_hash();
	role = "";
	filesystem = None;
	filesystem_virtual = None; //For temporary agent artifacts, store in memory rather than cluttering the disk
	env = []; 			//Env for the current agent (unique for each agent)
	env_shared = []; 	//Shared across all (sub) agents
	
	compaction_treshold = 0.8;
	
	//Might be obsolete...
	action_history = [];
	modified_files = [];

	//Callbacks
	on_action = None;
	
	//helper
	added_tools = [];
	
	running = false;
	stopped = false;
	
	//The result of the task, usually set through finalize(), if the agent doesnt have/call finalize, its the returned text by the run itself.
	task_result = None;
	use_finalize = false; //Set true if this agent role uses the finalize exit point.
	
	//agent_slots.shio: this agent holds a max_running_agents slot / lent it to a child
	_slot_held = false;
	_slot_lent = false;
	
	__init__(_model_config, system_role = "adaptive")
	{
		model_config = _model_config;
	
		//Load main system skills		
		role = system_role;
		
		role_path = find_skill("roles", system_role);
		
		role_md_path = role_path + "/ROLE.md";
		role_code_path = role_path + "/ROLE.shio";
		
		role_md = fileio.read_string(role_md_path).strip();
		
		if(!role_md) {
			std.runtime_error("Cannot load ROLE.md ", role_md_path);
			return;
		}
		
		llm_api = generic_agent(model_config.url, model_config.name, role_md.replace([
			"{{OS}}" = std.os_platform(),
			"{{DATE}}" = std.date("%Y-%m-%d") + " (YYYY:MM:DD)",
		]), model_config.token);
		
		//Register default tools
		if(!fileio.exists(role_code_path)) {
			std.runtime_error("Cannot load ROLE.shio ", role_code_path);
			return;
		}
			
		//Prevent agent from escaping
		filesystem = fileio.container(".");
		filesystem_virtual = fileio.virtual();
		
		role_module = std.module();
		role_module.load_file(role_code_path);
		
		if(role_module.has("add_tools"))
			role_module.call("add_tools", this);
		else
			std.warn("ROLE.shio found but no tool entry point for: ", role);
		
		skills["role"] = [md = role_md, module = role_module];
		
		llm_api.on_text = [this](txt)
		{
			env["text"] += txt;
			env["text_capture"] += txt;
			
			if(std.is_function(on_action)) {
				on_action([
					text = txt,
				]);
			}
		};
		
		llm_api.on_tool = [this](toolname, toolargs)
		{
			if(std.is_function(on_action)) {
				on_action([
					tool = [
						name = toolname,
						args = toolargs,
					],
				]);
			}
		};
		
		llm_api.on_reason = [this](txt) {
			if(std.is_function(on_action)) {
				on_action([
					reasoning = txt,
				]);
			}
		};
		
		llm_api.on_usage = [this](usage) {
			ctx_perc = usage.total_tokens / std.float(model_config.max_tokens);
			if(ctx_perc >= compaction_treshold)
				std.print("compaction...");
				task_update("<!---SYTEM MESSAGE---!>\nYOUR CONTEXT IS ABOUT TO RUN OUT!\nYOU HAVE TO EXIT THE CURRENT TURN IMMEDIATELY.\nWRITE A HANDOVER TO CONTINUE WORK IN A NEW RUN _OR_ EXIT WITH A SHORT NOTICE.");
		};
		
		add_tool(
			"wait",
			"Sleep for a while.",
			[
				duration = "&int(1,600): Duration in *SECONDS*",
				//context = "&string(): Context for this action",
			],
			[](agt, args)
			{	
				//std.sleep() takes milliseconds, and the sleep must stay interruptible:
				//a stopped agent may not sit out the rest of a 600s nap.
				deadline = std.millis() + args.duration * 1000;

				for(1)
				{
					if(agt.should_stop())
						return "Interrupted: the agent was stopped. Stop now, do not continue.";

					remaining = deadline - std.millis();

					if(remaining <= 0)
						break;

					std.sleep(math.min(250, remaining));
				}

				return "Wake up!";
			}
		);
	}
	
	__deinit__() {
		
	}
	
	get_models() {
		return llm_api.get_models();
	}
	
	set_model(model) {
		llm_api.set_model(model);
	}
	
	find_skill(folder_name, skill_name) {
		//First check local .agent directory...
		skill_path = AGENT_DIR + folder_name + "/" + skill_name;
		
		//If not found, check default skills
		if(!fileio.exists(skill_path))
			skill_path = AGENT_ROOT_DIR + folder_name + "/" + skill_name;
		
		if(!fileio.exists(skill_path))
			//std.runtime_error("Agent skill does not exist: ", skill_name);
			return "";
		
		return skill_path;
	}
	
	load_skill(skill_name) {
		
		std.cout("\n\nLoading skill: " + skill_name + "\n\n");
		
		if(skills.has(skill_name))
			std.print("skill ", skill_name, " already loaded.");
			return skills[skill_name].md;
		
		skill_path = find_skill("skills", skill_name);
		
		if(!skill_path) {
			std.print("skill ", skill_name, " not found.");
			return "";
		}
		
		skill_md_path = skill_path + "/SKILL.md";
		skill_code_path = skill_path + "/SKILL.shio";
		
		skill_md = fileio.read_string(skill_md_path).strip();
		
		skill_module = None;
		
		if(fileio.exists(skill_code_path)) {
			skill_module = std.module();
			skill_module.load_file(skill_code_path);
			
			added_tools = [];
			
			if(skill_module.has("add_tools"))
				skill_module.call("add_tools", this);
			else
				std.warn("SKILL.shio found but no tool entry point for: ", skill_name);
		}
		
		if(added_tools)
			skill_md += "\n\n# Skill Tools\n\n" + std.string(added_tools);
		
		skills[skill_name] = [md = skill_md, module = skill_module, added_tools = added_tools];
		
		return skill_md;
	}
	
	list_skills() {
		local_skills = fileio.dirs(AGENT_DIR + "skills", false);
		root_skills = fileio.dirs(AGENT_ROOT_DIR + "skills", false);

		final_skills = [];

		add_skill = [&final_skills](name, base_dir) {
			for(i = 0; i < final_skills.size(); i++)
				if(final_skills[i].name == name)
					return;

			entry = [name = name];

			sum_path = base_dir + name + "/summary.md";
			if(fileio.exists(sum_path))
				entry.summary = fileio.read_string(sum_path);

			final_skills.push_back(entry);
		};

		for(i = 0; i < local_skills.size(); i++)
			add_skill(local_skills[i], AGENT_DIR + "skills/");

		for(i = 0; i < root_skills.size(); i++)
			add_skill(root_skills[i], AGENT_ROOT_DIR + "skills/");

		return final_skills;
	}
	
	set_reasoning_effort(effort) {
		llm_api.set_reasoning_effort(effort);
	}
	
	add_image_url(img_url) { return llm_api.add_image_url(img_url); }
	add_image_raw(raw_image_data, img_type = "png") { return llm_api.add_image_raw(raw_image_data, img_type); }
	add_image(path) { return llm_api.add_image(path); }
	
	task(prompt, continue_task = false)
	{
		//A stop from above survives: starting a run clears this agent's own stop
		//flag, never the stop of an ancestor. A subagent whose parent was stopped
		//must not start generating again.
		if(ancestor_stopped()) {
			return finalize_run("failed", "The agent was stopped by its parent before the task started.");
		}

		if(!continue_task)
			env.task = prompt;
			env.text = "";
			env.text_capture = "";

		initial_prompt = prompt;

		running = true;
		stopped = false;
		_injected_prompt = None;

		//First, check if chat history needs compaction
		if(model_config.max_tokens) {
			total_tokens = llm_api.context.token_count_prompt(prompt);
			if(total_tokens > model_config.max_tokens/2) {
				std.print("compacting...");
				
				handover = compact_handover();
				
				if(!handover)
					std.print("no handover.");
					return finalize_run("failed", "Cannot compact the chat history.");
						
				prompt = initial_prompt + "\n\n<---SYTEM MESSAGE--->\nThis is a handover for context:\n\n" + handover;				
			}
		}

		try
		{
			do_run = true;
			res = None;

			start_time = std.millis();

			//Since qwen models dont support images in tool responses (?) yet
			//Maybe switch to anthropic messages API...
			for(do_run && !stopped) {
				//Prepare run
				do_run = false;
				task_result = None;

				//Run
				res = llm_api.task(prompt);
				
				if(_injected_prompt && !stopped) {
					prompt = _injected_prompt;
					initial_prompt = prompt;
					_injected_prompt = None;
					do_run = true;
					continue;
				}

				if(_injected_image && !stopped) {
					add_image_raw(_injected_image.raw_image, _injected_image.image_type);
					prompt = _injected_image.prompt;
					_injected_image = None;
					do_run = true;
					continue;
				}

				if(use_finalize) {
					//One special failure case, the model might exit before emitting a finalize() tool call, in that case,
					//Call the model one more time to make sure it was not a transmission error
					if(!task_result && !stopped) {
						res = llm_api.task("<---SYTEM MESSAGE--->\nYou ended the turn without calling 'finalize()'. Always use 'finalize' at the end of a turn.");
						if(_injected_prompt && !stopped) {
							prompt = _injected_prompt;
							initial_prompt = prompt;
							_injected_prompt = None;
							do_run = true;
							continue;
						}
						
						//Still no task result could mean the max context length was reached, try to get a recovery handover...
						if(!task_result && !stopped) {
							std.print("recovery handover...");
							handover = compact_handover(1);				
							if(!handover)
								std.print("recovery failed.");
								return finalize_run("failed", "Cannot compact the chat history.");												
							prompt = initial_prompt + "\n\n<---SYTEM MESSAGE--->\nThis is a handover for context:\n\n" + handover;				
							do_run = true;
							continue;
						}
					}

					if(!task_result) {
						if(stopped)
							return finalize_run("failed", "Agent was stopped during its run.");
						return finalize_run("failed", "The agent did not report anything.");
					}

					//A 'continue' finalize is a hand-over: stop this generation, reset the
					//context and run the handover prompt inside the same task.
					if(task_result.signal == "continue" && task_result.from_tool && !ancestor_stopped()) {
						clear_chat();
						prompt = initial_prompt + "\n\n<---SYTEM MESSAGE--->\nThis is a handover task, work has already begun.\nNotes from the previous agent:\n\n" + std.string(task_result.result ?? "");
						task_result = None;
						stopped = false;
						running = true;
						do_run = true;
						continue;
					}

					//finished / failed / question: terminal, return the result below
					do_run = false;
				}
			}

			delta_time = std.millis() - start_time;

			//A finalize() result wins over the generic stop/finished fallback:
			//finalize_run() sets the stop flag, so a stopped check first would
			//overwrite the model's own signal.
			if(task_result) {
				task_result.execution_time_ms = delta_time;
				return task_result;
			}

			if(stopped) {
				return finalize_run("failed", "Agent was stopped during its run.");
			}

			return finalize_run("finished", res);
		}
		catch(e)
		{
			return finalize_run("failed", e);
		}
	}

	task_update(prompt) {
		if(!prompt)
			return None;
		if(!running) {
			std.error("Cannot update task - no task running.");
			return None;
		}
		_injected_prompt = prompt;
		//Ends the current generation only; the running task continues with the
		//injected prompt and its own task_result.
		stop(false);
		return None;
	}

	single_task(prompt) {
		result = task(prompt);
		if(std.is_json(result) && result.signal == "finished") {
			return std.string(result.result ?? "");
		}
		return "";
	}

	//Stop this agent and, top-down, the whole agent tree below it.
	//Every child created through subagent()/simple_agent() is registered in
	//_child_agents, and a child's own stop() recurses into its children, so one
	//call here reaches every descendant that can generate.
	stop(reset_states = true)
	{
		if(reset_states) {
			stopped = true;
			running = false;
		}
		
		try {
			if(llm_api && std.is_function(llm_api.stop))
				llm_api.stop();
		}
		catch(e) { }
		
		//Children are created and pruned from tool threads while a stop walks the
		//tree, so iterate over a snapshot taken under the tree lock: a concurrent
		//mutation must never make this loop skip a running child.
		children = [];
		cs = std.critical_section_named("miniagent_tree");
		children = _child_agents.copy();
		cs.release();
		
		for(i = 0; i < children.size(); i++) {
			try {
				if(children[i] && std.is_function(children[i].stop))
					children[i].stop();
			}
			catch(e) { }		
		}
	}
	
	compact_handover(start_stage = 0) {
		//This is multiple stages because compacting is not that straight forward:
		//1. First, try to make the AI write a normal handover
		//2. If that didnt work, the context is likely full, compact reasoning traces and tool calls and try again...
		//3. Finally, if that also didnt work, try to remove messages in between user messages (but keep those)
		//4. If that didnt work, the user's prompt are likely too long, exit
		
		if(use_finalize) {
			compaction_run = start_stage;
			for(1) {
				
				//TODO: check that this logic is right
				if(compaction_run == 1) {
					//Stage 1, truncate reasoning only
					m = llm_api.context.body.messages;
					for(i = 0; i < m.size(); i++) {
						if(m[i].role == "assistant" && m[i].reasoning_content) {
							if(m[i].reasoning_content.length() > 1024)
								m[i].reasoning_content = m[i].reasoning_content.substr(0,1024) + "...";
						}
					}
				}
				else if(compaction_run == 2) {
					//Compress tools?
					m = llm_api.context.body.messages;
					for(i = 0; i < m.size(); i++) {
						if(m[i].role == "tool" && m[i].content) {
							if(m[i].content.length() > 1024)
								m[i].content = m[i].content.substr(0,1024) + "...";
						}
					}
				}
				else if(compaction_run == 3)
					return None;
				
				compaction_chat = export_chat();
				res = llm_api.task("<!---SYTEM MESSAGE---!>\nWrite a handover for a fresh agent.\nInclude previous tasks and work done.\nThe new agent must understand what has happened so far.\nPass the handover via 'finalize' as report.");
				if(task_result && task_result.result) {
					res = std.string(task_result.result ?? "");
					clear_chat();
					task_result = None;
					return res;
				}
				
				//Reset chat
				import_chat(compaction_chat);						
				compaction_run++;
			}
		}
		else {
			//TODO: non-finalize variant (just take text response from the AI)
			std.print("compaction not implemented for this system-role.");
		}

		return None;
	}
	
	//Usually called by the agent itself, but can also be called from the outside.
	//Forcefully ends a turn with a signal and a result. from_tool distinguishes a
	//model's finalize()/finish() call from an external stop that ended the turn.
	finalize_run(signal, result, from_tool = false) {
		stop();
		task_result = [
			signal=signal,
			result=result,
			from_tool=json.bool(from_tool),
		];
		return task_result;
	}
	
	//True when any agent above this one in the tree was stopped.
	//A stop travels top-down: whoever stops the root stops every descendant, and
	//no descendant may be (re)started underneath a stopped ancestor.
	ancestor_stopped() {
		p = _parent;
		
		for(p) {
			if(!std.is_class(p, miniagent))
				break;
			
			if(p.stopped)
				return true;
			
			p = p._parent;
		}
		
		return false;
	}
	
	should_stop() {
		if(stopped)
			return true;
		
		return ancestor_stopped();
	}
	
	wait_finish() {
		for(running) {
			std.sleep(25);
		}
	}
	
	//This is supposed to be used from within tool calls only, injects a visual user prompt
	inject_visual_prompt(raw_image, image_type = "png", prompt = "Here is the requested image.") {
		_injected_image = [
			prompt = prompt,
			raw_image = raw_image,
			image_type = image_type,
		];
		
		stop();
		
		return "The user will provide you with the requested image.\nStop now and wait for the user to sent the image.";
	}
	
	add_tool(
		name,
		description,
		params, 
		callback,
	)
	{
		//Bridge
		llm_api.add_tool(name, description, params, [this, callback, name](agt, p) {
			
			toolid = std.random_hash();
			
			if(this.on_action) {
				this.on_action([
					tool_start=[
						id=toolid,
						args=p,
						name=name,
					]
				]);		
			}
			
			res = None;
			
			try {
				res = callback(this, p);
			}
			catch(e) {	
				res = [
					ok = false,
					error = "The tool call caused an unexpected exception.",
				];
			}
			
			if(this.on_action) {
				this.on_action([
					tool_end=[
						id=toolid,
						result=res,
						name=name,
					]
				]);		
			}
			
			return res;
		});
		
		added_tools[name] = [
			description = description,
		];
	}

	set_history(history) {
		llm_api.context.body.messages = history;
	}
	
	//Full history with system prompt
	history() {
		return llm_api.context.body.messages;
	}
	
	import_history(history) {
		llm_api.context.body.messages = history;
	}

	//Conversation only, keep system prompt
	export_chat() {
		if(!llm_api.context.body.messages)
			return None;
			
		tmp =  llm_api.context.body.messages.copy();
		tmp.erase(0);
		return tmp;
	}
	
	import_chat(chat) {
		if(!chat)
			llm_api.context.body.messages.resize(1);
			return;
	
		tmp = llm_api.context.body.messages[0];
		llm_api.context.body.messages = chat;
		llm_api.context.body.messages.insert(0, tmp);
	}
	
	clear_chat() {
		import_chat(None);
	}
	
	add_finalize(
		signals = ["continue", "finished", "failed", "question"],
		description = "Use this at the end of each turn: emit continue, finished, failed or question with the report.\nIf your context is exhausted or after long continous runs with alot of work left, call this tool with a 'continue' signal and a handover report to continue with a fresh context (erases all history including the user messages, must include the goal/initial user task when 'continue'!)."
	) {
		agt_add_finalize(this);
		use_finalize = true;
	}	
	add_read_tools() {
		agt_add_read_tools(this);
	}
	add_code_read_tools() {
		agt_add_code_read_tools(this);
	}
	add_write_tools() {
		agt_add_write_tools(this);
	}
	add_skill_tools() {
		agt_add_skill_tools(this);
	}
	add_command_tools() {
		agt_add_command_tools(this);
	}
	add_share_tools() {
		agt_add_share_tools(this);
	}
	
	subagent(system_role, log_actions = true, copy_config = false)
	{
		sub_agt = create_miniagent(model_config, system_role);
		if(on_action && log_actions) {
			sub_agt_id = sub_agt.agent_id;
			sub_agt.on_action = [this, sub_agt_id](action) {
				this.on_action([agent = [id=sub_agt_id, action=action]]);
			};
		}

		if(copy_config)
			sub_agt.model_config = ModelConfig();
			sub_agt.model_config.copy_from(model_config);

		//Prune dead entries only.
		//Live children MUST stay registered: stop() walks this list to reach every
		//running descendant. Dropping live children here (the old "clear old
		//entries" loop) left only the most recently created child reachable, so a
		//stop never reached the siblings a batch/fork had spawned and generation
		//kept running.
		//The tree is mutated from tool threads, so the bookkeeping runs under the
		//shared tree lock.
		cs = std.critical_section_named("miniagent_tree");
		
		for(i = 0; i < _child_agents.size(); i++) {
			if(!_child_agents[i]) {
				_child_agents.erase(i);
				i--;
			}
		}
		
		_child_agents.push_back(sub_agt);
		
		cs.release();
		
		sub_agt._parent = this;
		if(_parent_root)
			sub_agt._parent_root = _parent_root;
		else
			sub_agt._parent_root = this;
		
		sub_agt.env_shared = env_shared;
		sub_agt.filesystem = filesystem;
		sub_agt.filesystem_virtual = filesystem_virtual;
		
		//A child created under a stopped parent is born stopped: it must never
		//start generating, and stop() has already passed this point.
		if(stopped)
			sub_agt.stop();
		
		return sub_agt;
	}
	
	simple_agent(system_role, model_name = None) 
	{
		sub_agt = generic_agent(model_config.url, model_name ? model_name : model_config.name, system_role, model_config.token);
	
		//Prune dead entries only (live children stay: stop() needs them).
		//The old loop ran "i--" unconditionally, which spun forever on the first
		//live entry and dropped the children it was supposed to keep.
		cs = std.critical_section_named("miniagent_tree");
		
		for(i = 0; i < _child_agents.size(); i++) {
			if(!_child_agents[i]) {
				_child_agents.erase(i);
				i--;
			}
		}

		_child_agents.push_back(sub_agt);
		
		cs.release();
		
		//Same rule as subagent(): no generation below a stopped agent.
		if(stopped)
			sub_agt.stop();
		
		return sub_agt;
	}
	
	simple_rag(query, data, context = "", return_format = "") {
		managed rag_agt = subagent("simple_rag", false);
		
		//The order kind of matters for less token cache misses
		rag_prompt = "<rag_data>\n" + std.string(data) + "</rag_data>\n";
		
		if(context) {
			rag_prompt += "<rag_context>\n" + context + "</rag_context>\n";	
		}
		
		rag_prompt += "<rag_query>\n" + query + "</rag_query>\n";
		
		if(return_format) {
			rag_prompt += "<rag_return_format>\n" + return_format + "</rag_return_format>\n";	
		}
		
		return rag_agt.single_task(rag_prompt).strip();
	}
	
	report_back(txt)
	{
		if(std.is_function(on_action)) {
			on_action([
				text = txt,
			]);
		}
	}
	
	//Internally used by some tools
	_log_action(name, content) {
	
		entry = [
			name=name,
			content=content,
			time=std.timestamp(),
		];
		
		if(content.path)
			modified_files.push_back(content.path);
		if(content.src_path)
			modified_files.push_back([source=content.src_path, destination=content.dst_path]);
		
		/*
		base_path = fileio.exists(AGENT_DIR) ? AGENT_DIR : ".backup/";
		base_path += "action_logs/";

		backup_file_path = "";
		for(1) {
			ts = std.timestamp();
			ts = ts.replace("-", "_");
			ts = ts.replace(":", "_");
			ts = ts.replace(" ", "__");
			
			if(fileio.exists(base_path + ts + ".json"))
				std.sleep(10);
				continue;
			backup_file_path = base_path + ts + ".json";
			fileio.write_json(backup_file_path, entry);
			break;
		}
		
		entry.backup_file_path = backup_file_path;
		*/
		
		action_history.push_back(entry);
	}
	
	//For agent trees...
	_parent = None;
	_parent_root = None;
	managed _child_agents = [];
	
	get_root_agent() {
		if(_parent_root)
			return _parent_root;
		return this;
	}
	
	_injected_image = None;
	_injected_prompt = None;
}

create_miniagent(cfg, system_role)
{
	return miniagent(cfg, system_role);
}