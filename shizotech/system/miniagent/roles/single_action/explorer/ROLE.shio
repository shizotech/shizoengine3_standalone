
#include "../../../miniagent"

//Prompts are inside the function because global variables
//From a loaded module as called here dont workin
//Debug !!!! put task_select_prompt outside and debug its value...

add_tools(agt)
{
	agt.add_finalize_tool();
	
	//FILEIO
	agt.add_tool(
		"list_dir",
		"Query files in the current directory",
		[
			path = "&string(): Path to query, use '.' for the current working directory",
			recursive = ["true", "false"],
		],
		[](agt, args)
		{
			if(args.path.starts("/"))
				return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
			
			args.path = args.path.removesuffix("/");
		
			if(!agt.filesystem.exists(args.path))
				return "The directory does not exist.";
		
			dirs = agt.filesystem.dirs(args.path, args.recursive == "true"); 
			files = agt.filesystem.files(args.path, args.recursive == "true"); //Filter out large log files and other stuff
			
			dirs_cleaned = [];
			files_cleaned = [];
			
			//Filter out logfiles
			for(i = 0; i < dirs.size(); i++) {
				if(dirs[i].contains(".agent") || dirs[i].contains(".backup") || dirs[i].contains(".git"))
					continue;
				dirs_cleaned.push_back(dirs[i]);
			}
			for(i = 0; i < files.size(); i++) {
				
				if(files[i].contains(".agent") || files[i].contains(".backup") || files[i].contains(".git"))
					continue;
				files_cleaned[files[i]] = [size=agt.filesystem.size(args.path + "/" + files[i])];
			}
			
			has_files = files_cleaned ? "true" : "false";
			has_dirs = dirs_cleaned ? "true" : "false";
			
			return [
				has_files = has_files,
				has_directories = has_dirs,
				dirs = dirs_cleaned,
				files = files_cleaned,
			];
		}
	);

	agt.add_tool(
		"read",
		"Read a file",
		[
			path = "&string(): Path to the file",
			look_for = "string(): **OPTIONAL** look for something specific in the file (avoid context pollution).",
			should_return = ["exact", "summary"],
		],
		[](agt, args)
		{
			if(args.path.starts("/"))
				return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
			
			if(!agt.filesystem.exists(args.path)) {
				return [
					ok = false,
					error = "file doesnt exist",
				];
			}
			
			txt = agt.filesystem.read_text(args.path);
			
			if(!txt) {
				return [
					ok = true,
					status = "file is empty",
				];
			}
			
			if(args.look_for) {
				read_agt = agt.subagent("filereader");
				res = read_agt.single_task("<USER_SUPPLIED_TEXT>\n" + txt + "\n</USER_SUPPLIED_TEXT>\n\n<USER_INSTRUCTION>\n" + args.look_for + "\n</USER_INSTRUCTION>");
				std.free(read_agt);
				if(!res)
					std.print("filereader error!");
				txt = res;				
			}
			
			if(args.should_return == "summary") {
				sum_agt = agt.subagent("summarizer");
				res = sum_agt.single_task("<USER_SUPPLIED_TEXT>\n" + txt + "\n</USER_SUPPLIED_TEXT>");
				std.free(sum_agt);
				if(!res)
					std.print("summarizer error!");
				txt = res;
			}
			
			return [
				ok = true,
				content = txt,
			];
		}
	);	
	
	agt.add_tool(
		"list_skills",
		"List all available skills",
		None,
		[](agt, args)
		{
			skills = agt.list_skills();
			if(!skills) {
				return [
					ok = 0,
					error = "No skills available.",
				];
			}
			
			return [
				ok = true,
				skills = skills,
			];
		}
	);
	
	agt.add_tool(
		"read_skill",
		"Read a skill",
		[
			name = "&string(): Name of the skill",
		],
		[](agt, args)
		{
			md = agt.load_skill(args.name);
			
			if(!md) {
				return [
					ok = false,
					error = "No skill with that name was found.",
				];
			}
			
			return md;
		}
	);
}