
import tempfile;

//This is specifically for qwen models
output_format = R"(
Output the result(s) in the following JSON format and write nothing else:
```json
[
  {"bbox_2d": [x1, y1, x2, y2], "label": "type_of_component", "sub_label": "Reference_designator"},
  ...
]
```
)";

transform_bbox(img, bbox) {
	x1 = bbox[0] / 1000.0 * img.width();
	x2 = bbox[2] / 1000.0 * img.width();
	y1 = bbox[1] / 1000.0 * img.height();
	y2 = bbox[3] / 1000.0 * img.height();	
	return [x1,y1,x2,y2];
}

get_screenshot() {
	return "screenshot_ds.png";
}

take_screenshot() {
	win32.screenshot("screenshot.bmp");	
	tmp = bitmap.load("screenshot.bmp");
	//tmp.downsample();
	cs = win32.cursor_pos();
	tmp.draw_circle(cs.x, cs.y, 10, bitmap.rgb(255, 0, 0));
	tmp.save(get_screenshot());
}

remove_screenshot() {
	fileio.remove("screenshot.bmp");
	fileio.remove(get_screenshot());
}

class tmp_screenshot
{
	__init__() {
		take_screenshot();
	}
	__deinit__() {
		remove_screenshot();
	}
}

debug_bbox(bbox) {
	bmp = bitmap.load(get_screenshot());
	transformed = transform_bbox(bmp, bbox);
	bmp = bitmap.load(get_screenshot());
	bmp.draw_rectangle(transformed[0],transformed[1],transformed[2],transformed[3],bitmap.rgb(255, 0, 0));
	bmp.save(std.random_hash() + ".png");
}

move_mouse(agt, &args) {
	bmp = bitmap.load(get_screenshot());
	bbox = transform_bbox(bmp, [args.coordinates[0], args.coordinates[1], 0, 0]);			
	win32.set_cursor_pos(bbox[0] /** 2*/, bbox[1] /** 2*/); // * 2 because image was downsampled
	std.sleep(200);
}

add_tools(agt)
{
	agt.add_tool(
		"mouse_hover",
		"Hover over an UI element.\nUse this to inspect tooltips and autocompletes.",
		[
			bbox_2d = "&array(int, 4, 4): Bounding box coordinates of the target UI element with the format [x1, y1, x2, y2].",
			coordinates = "&array(int, 2, 2): Point coordinates for this action with the format [x, y].",
			intention = "&string(): The intention of the current action in one sentence.",
			//context = "&string(): Context for this action",
		],
		[](agt, args)
		{		
			std.print(args);
			
			if (args.coordinates[0] < args.bbox_2d[0] ||
				args.coordinates[0] > args.bbox_2d[2] ||
				args.coordinates[1] < args.bbox_2d[1] ||
				args.coordinates[1] > args.bbox_2d[3]) {
				return [
					ok = false,
					error = "The provided point coordinates are not within the bbox_2d of the target UI element.",
				];
			}
		
			debug_bbox(args.bbox_2d);
		
			move_mouse(agt, args);
			
			agt.env.current_step.history.push_back([
				type="action",
				action="mouse_hover",
				params = args,
				status = "FINISHED",
			]);	
	
			agt.env.next_required_action = "Check the last action:\n\n```\n" + agt.env.current_step.history[-1] + "\n```\n\nMake sure that the cursor position for this action is ***exactly*** on point and inside the bbox_2d coordinates of the target UI element.\nMake also sure that the new state image reflects the intention.\nThen either correct and try again __or__ continue with the next appropriate action that should follow this last action to progress the current step.\nAlways correct uneffective actions first.";
	
			agt.stop();
			
			return [
				ok = true,
				status = "Mouse moved.",
			];
		}
	);
	
	agt.add_tool(
		"mouse_click",
		"Perform a simple click event (button down & up)",
		[
			bbox_2d = "&array(int, 4, 4): Bounding box of the target UI element.",
			coordinates = "&array(int, 2, 2): Position the mouse before performing the action.",
			button = ["left", "right", "middle"],
			intention = "&string(): The intention of the current action in one sentence.",
		],
		[](agt, args)
		{		
			std.print(args);
			if(args.bbox_2d && args.coordinates) {
				if (args.coordinates[0] < args.bbox_2d[0] ||
					args.coordinates[0] > args.bbox_2d[2] ||
					args.coordinates[1] < args.bbox_2d[1] ||
					args.coordinates[1] > args.bbox_2d[3]) {
					return [
						ok = false,
						error = "The provided point coordinates are not within the bbox_2d of the target UI element.",
					];
				}
			}
			
			debug_bbox(args.bbox_2d);
			
			if(args.coordinates) {
				move_mouse(agt, args);
			}
		
			win32.mouse_click(args.button, 1);
			
			agt.env.current_step.history.push_back([
				type="action",
				action="mouse_click",
				params = args,
				status = "FINISHED",
			]);	

			agt.env.next_required_action = "Check the last action:\n\n```\n" + agt.env.current_step.history[-1] + "\n```\n\nMake sure that the cursor position for this action is ***exactly*** on point and inside the bbox_2d coordinates of the target UI element.\nMake also sure that the new state image reflects the intention.\nThen either correct and try again __or__ continue with the next appropriate action that should follow this last action to progress the current step.\nAlways correct uneffective actions first.";
	
			agt.stop();

			std.sleep(1000 * 2);

			return [
				ok = true,
				status = "Mouse event was sent.",
			];
		}
	);
	
	agt.add_tool(
		"mouse_double_click",
		"Perform a simple double-click event",
		[
			bbox_2d = "&array(int, 4, 4): Bounding box of the target UI element.",
			coordinates = "&array(int, 2, 2): Position the mouse before performing the action.",
			intention = "&string(): The intention of the current action in one sentence.",
		],
		[](agt, args)
		{		
			std.print(args);
			
			if(args.bbox_2d && args.coordinates) {
				if (args.coordinates[0] < args.bbox_2d[0] ||
					args.coordinates[0] > args.bbox_2d[2] ||
					args.coordinates[1] < args.bbox_2d[1] ||
					args.coordinates[1] > args.bbox_2d[3]) {
					return [
						ok = false,
						error = "The provided point coordinates are not within the bbox_2d of the target UI element.",
					];
				}
			}
		
			debug_bbox(args.bbox_2d);
		
			if(args.coordinates) {
				move_mouse(agt, args);
			}
		
			win32.mouse_click("left", 1);
			std.sleep(50);
			win32.mouse_click("left", 1);
			
			agt.env.current_step.history.push_back([
				type="action",
				action="mouse_double_click",
				params = args,
				status = "FINISHED",
			]);	

			agt.env.next_required_action = "Check the last action:\n\n```\n" + agt.env.current_step.history[-1] + "\n```\n\nMake sure that the cursor position for this action is ***exactly*** on point and inside the bbox_2d coordinates of the target UI element.\nMake also sure that the new state image reflects the intention.\nThen either correct and try again __or__ continue with the next appropriate action that should follow this last action to progress the current step.\nAlways correct uneffective actions first.";
	
			agt.stop();

			std.sleep(1000 * 2);

			return [
				ok = true,
				status = "Mouse event was sent.",
			];
		}
	);
	
	agt.add_tool(
		"mouse_drag",
		"Perform a mouse drag action using coordinates 'from' and 'to'",
		[
			source = [
				bbox_2d = "&array(int, 4, 4): Bounding box of the source UI element.",
				coordinates = "&array(int, 2, 2): Point position for the start click.",
			],
			target = [
				bbox_2d = "&array(int, 4, 4): Bounding box of the target UI element.",
				coordinates = "&array(int, 2, 2): Point position for the end click.",
			],
			button = ["left", "right", "middle"],
			intention = "&string(): The intention of the current action in one sentence.",
		],
		[](agt, args)
		{		
			std.print(args);

			if (!args.source.bbox_2d) {
				return [
					ok = false,
					error = "You have to provide the source.bbox_2d parameter, which is the 2D bounding box of the source UI element.",
				];
			}

			if (!args.target.bbox_2d) {
				return [
					ok = false,
					error = "You have to provide the target.bbox_2d parameter, which is the 2D bounding box of the target UI element.",
				];
			}

			if (!args.source.coordinates) {
				return [
					ok = false,
					error = "You have to provide the source.coordinates parameter, which is the mouse point coordinate for the start of the drag operation.",
				];
			}

			if (!args.target.coordinates) {
				return [
					ok = false,
					error = "You have to provide the target.coordinates parameter, which is the mouse point coordinate for the end of the drag operation.",
				];
			}

			if (args.source.coordinates[0] < args.source.bbox_2d[0] ||
				args.source.coordinates[0] > args.source.bbox_2d[2] ||
				args.source.coordinates[1] < args.source.bbox_2d[1] ||
				args.source.coordinates[1] > args.source.bbox_2d[3]) {
				return [
					ok = false,
					error = "The provided source.coordinates are not within source.bbox_2d.",
				];
			}

			if (args.target.coordinates[0] < args.target.bbox_2d[0] ||
				args.target.coordinates[0] > args.target.bbox_2d[2] ||
				args.target.coordinates[1] < args.target.bbox_2d[1] ||
				args.target.coordinates[1] > args.target.bbox_2d[3]) {
				return [
					ok = false,
					error = "The provided target.coordinates are not within target.bbox_2d.",
				];
			}
			
			debug_bbox(args.source.bbox_2d);
			debug_bbox(args.target.bbox_2d);

			args.coordinates = args.source.coordinates;
			move_mouse(agt, args);
			std.sleep(500);
			win32.mouse_down(args.button);

			args.coordinates = args.target.coordinates;
			move_mouse(agt, args);
			std.sleep(500);
			win32.mouse_up(args.button);

			agt.env.current_step.history.push_back([
				type = "action",
				action = "mouse_drag",
				params = args,
				status = "FINISHED",
			]);

			agt.env.next_required_action =
				"Check the last action:\n\n```\n" +
				agt.env.current_step.history[-1] +
				"\n```\n\nMake sure that the cursor position for this action is ***exactly*** on point and inside the bbox_2d coordinates of the target UI element.\nMake also sure that the new state image reflects the intention.\nThen either correct and try again __or__ continue with the next appropriate action that should follow this last action to progress the current step.\nAlways correct uneffective actions first.";

			agt.stop();

			std.sleep(1000 * 2);

			return [
				ok = true,
				status = "Mouse event was sent.",
			];
		}
	);
	
	agt.add_tool(
		"type_text",
		"Send a string as text input.",
		[
			bbox_2d = "&array(int, 4, 4): Bounding box of the target UI element.",
			coordinates = "array(int, 2, 2): OPTIONAL Position the mouse and perform a left-click before performing the action.",
			text = "&string(): Text to perform.",
			select_all = "&int(0,1): Send a ctrl+a before typing to erase previous values.",
			enter = "&int(0,1): Send ENTER key after typing to submit.",
			intention = "&string(): The intention of the current action in one sentence.",
		],
		[](agt, args)
		{		
			if(args.bbox_2d && args.coordinates) {
				if (args.coordinates[0] < args.bbox_2d[0] ||
					args.coordinates[0] > args.bbox_2d[2] ||
					args.coordinates[1] < args.bbox_2d[1] ||
					args.coordinates[1] > args.bbox_2d[3]) {
					return [
						ok = false,
						error = "The provided point coordinates are not within the bbox_2d of the target UI element.",
					];
				}
			}
			
			std.print(args);
			
			if(args.coordinates) {
				move_mouse(agt, args);
			}
			
			if(args.select_all)
				win32.send_keys("ctrl+a");
				std.sleep(250);
		
			win32.type_text(args.text, 25);
			
			if(args.enter)
				std.sleep(100);
				win32.send_keys("enter");

			agt.env.current_step.history.push_back([
				type="action",
				action="type_text",
				params = args,
				status = "FINISHED",
			]);	
			
			agt.env.next_required_action = "Check the last action:\n\n```\n" + agt.env.current_step.history[-1] + "\n```\n\nMake sure that the cursor position for this action is ***exactly*** on point and inside the bbox_2d coordinates of the target UI element.\nMake also sure that the new state image reflects the intention.\nThen either correct and try again __or__ continue with the next appropriate action that should follow this last action to progress the current step.\nAlways correct uneffective actions first.";
	
			agt.stop();

			std.sleep(1000);

			return [
				ok = true,
				status = "Text was sent",
			];
		}
	);
	
	agt.add_tool(
		"send_keys",
		"Send a key combination using human-readable string syntax.",
		[
			bbox_2d = "&array(int, 4, 4): Bounding box of the target UI element.",
			coordinates = "array(int, 2, 2): OPTIONAL Position the mouse and perform a left-click before performing the action.",
			combo = "&string(): Combination like 'ctrl+s', 'ctrl+shift+t', 'alt+f4', 'win+e', 'a', 'enter', 'backspace', 'f5' etc.",
			repeat = "int(): Repeat N times (optional).",
			intention = "&string(): The intention of the current action in one sentence.",
		],
		[](agt, args)
		{	
			if(args.bbox_2d && args.coordinates) {
				if (args.coordinates[0] < args.bbox_2d[0] ||
					args.coordinates[0] > args.bbox_2d[2] ||
					args.coordinates[1] < args.bbox_2d[1] ||
					args.coordinates[1] > args.bbox_2d[3]) {
					return [
						ok = false,
						error = "The provided point coordinates are not within the bbox_2d of the target UI element.",
					];
				}
			}
		
			if(args.coordinates) {
				move_mouse(agt, args);
			}
			//move_mouse(agt, args);
		
			//Force focusing on the element
			//win32.mouse_click("left", 1);
		
			args.repeat = math.max(args.repeat, 1);
			
			success = false;
			for(i = 0; i < args.repeat; i++) {
				success = win32.send_keys(args.combo);
			}
			
			agt.env.current_step.history.push_back([
				type="action",
				action="send_keys",
				params = args,
				status = "FINISHED",
			]);	
			
			agt.env.next_required_action = "Check the last action:\n\n```\n" + agt.env.current_step.history[-1] + "\n```\n\nMake sure that the cursor position for this action is ***exactly*** on point and inside the bbox_2d coordinates of the target UI element.\nMake also sure that the new state image reflects the intention.\nThen either correct and try again __or__ continue with the next appropriate action that should follow this last action to progress the current step.\nAlways correct uneffective actions first.";
	
			agt.stop();
			
			std.sleep(1000);
			
			return [
				ok = success,
			];
		}
	);
	
	agt.add_tool(
		"push_step",
		"Set the next immediate sequential objective",
		[
			title = "&string(): Title for the step",
			description = "&string(): Description for the step",
			success_condition = "&string(): Conditions that must be met to succeed the step",
			is_substep = "&int(0,1): Is this a new step to progress the task or is it a substep of the currently running step?",
		],
		[](agt, args)
		{		
			new_step = [
				type = "step",
				id = std.random_hash(8),
				title = args.title,
				description = args.description,
				success_condition = args.success_condition,
				status = "OPEN",
				history = [],
			];
			
			agt.env.next_required_action = "Execute the first action for the new current step.";
		
			if(!agt.env.steps) {
				agt.env.steps = [new_step];
				agt.env.current_step = &agt.env.steps[0];
				agt.stop();	
				return [
					ok=true
				];
			}
			
			if(args.is_substep) {
				if(*agt.env.current_step) {
					agt.env.current_step.history.push_back(new_step);
					agt.env.current_step = &agt.env.current_step.history[-1];
				}
				else {
					agt.env.steps.push_back(new_step);
					agt.env.current_step = &agt.env.steps[-1];
				}
			}
			else {
				
				if(*agt.env.current_step) {
					agt.env.current_step.history = "<truncated>";
					agt.env.current_step.status = "FINISHED";
					agt.env.current_step.erase("success_condition");
				}
				
				agt.env.steps.push_back(new_step);
				agt.env.current_step = &agt.env.steps[-1];
			}
			
			agt.stop();	
			
			return [
				ok=true
			];
		}
	);
	
	agt.add_tool(
		"task_finished",
		"Call this when the task is FULLY completed, or cannot continue after too many failures.",
		[
			status = ["SUCCESS", "FAIL"],
			report = "&string(): Full task report",
			//working_directory = "&string(): The working directory for the downstream agent.", 
		],
		[](agt, args)
		{				
			agt.env.task_finished = true;
			agt.env.task_report = args.report;
	
			agt.stop();
			
			return [
				ok=true
			];
		}
	);
}