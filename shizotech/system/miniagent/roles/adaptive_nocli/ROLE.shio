
#include "../../miniagent"

agent_prompt = R"(
AGENT TASK

Goal:
[GOAL]

Context:
[CONTEXT]

Contract:
[CONTRACT]

Constraints:
[CONSTRAINTS]

Task hierarchy:
[HIERACHY]
)";

continue_prompt = R"(
AGENT TASK (CONTINUED)

Goal:
[GOAL]

Context:
[CONTEXT]

Contract:
[CONTRACT]

Constraints:
[CONSTRAINTS]

Task hierarchy:
[HIERACHY]

Milestones:
[MILESTONES]

Previously:
[PREV]

Parent response:
[RESPONSE]
)";

build_task_hierachy(agt)
{
	if(agt._parent) {
		hierarchy = build_task_hierachy(agt._parent);

		if(agt.env.active_task ?? false)
			hierarchy.push_back(agt.env.active_task.name);

		return hierarchy;
	}

	return ["ROOT"];
}

format_task_hierachy(hierarchy)
{
	result = "";

	for(i = 0; i < hierarchy.size(); i++) {

		if(i > 0)
			result += "\n";

		for(j = 1; j < i; j++)
			result += "    ";

		if(i == 0)
			result += hierarchy[i];
		else
			result += "└── " + hierarchy[i];
	}

	return result;
}

add_tools(agt)
{
	agt.add_tool(
		"start_task",
		"Create/delegate work",
		[
			name = "&string(): Name of the task",
			goal = "&string(): Description of the task (detailed)",
			context = "&string(): Required context for the task",
			contract = "&string(): Contract for the task",
			constraints = "string(): OPTIONAL constraints",
		],
		[](agt, args)
		{		
			env = agt.env;
			
			if(!env.tasks)
				env.tasks = [];
		
			tasks = env.tasks;
		
			executor = agt.subagent("adaptive");
		
			parent_id = "";
			if(agt.env.active_task ?? false)
				parent_id = agt.env.active_task.id;
		
			tasks.push_back([
				agent = executor,
				parent_id = parent_id,
			
				id = "task_" + std.random_hash(6),
				name = args.name,
				goal = args.goal,
				context = args.context,
				contract = args.contract,
				constraints = args.constraints,
				
				finished = false,
				finish_reason = "",
				milestones = [],
				report = "",
			]);
		
			task = tasks[-1];
			
			executor.env.active_task = task;
			
			if(agt.on_action) {
				executor.on_action = [agt](act) {
					agt.on_action(act);
				};
			}
			
			hierarchy = format_task_hierachy(
				build_task_hierachy(executor)
			);
			
			if(!agt.env_shared.running_agent_count)
				agt.env_shared.running_agent_count = 0;
			
			if(agt.model_config.max_running_agents > 0) {
				first = true;
				for(agt.env_shared.running_agent_count >= agt.model_config.max_running_agents) {
					if(first)
						std.print("MAX PARALLEL AGENT COUNT!");
						first = false;
					std.sleep(10);
				}					
			}
			
			std.print("\n\n---NEW TASK---\n");
			
			agt.env_shared.running_agent_count += 1;
			
			for(!task.finished) {
				
				//TODO: build simple task hierachy based on _parent recursively (just task names no details)
				//To make it visible to the subagent where in the hiearchy it is
				
				prompt = agent_prompt.replace([
					"[GOAL]" = args.goal,
					"[CONTEXT]" = args.context,
					"[CONTRACT]" = args.contract,
					"[CONSTRAINTS]" = args.constraints,
					"[HIERACHY]" = hierarchy,
				]);
				
				try {
					step_result = executor.task(prompt);
				}
				catch(e) {
					//Todo: add fail counter
				}
			}
			
			agt.env_shared.running_agent_count -= 1;
			
			if(!task.report) {
				if(!task.milestones) {
					return [
						task_id = task.id,
						finish_reason = task.finish_reason,
						report = "The task did not emit any reports, furthermore no milestones are available.\nThat means that the task might have failed or crashed during execution.\nManual verification of the task's progress is required.",
					];
				}
				
				return [
					task_id = task.id,
					finish_reason = task.finish_reason,
					report = "The task did emit any reports.\nThat means that the task might have failed or crashed after the last milestones.\nFurther verification of the last steps and the actual tasks progress is required.",
				];
			}
			
			return [
				task_id = task.id,
				finish_reason = task.finish_reason,
				report = task.report,
			];
		}
	);
	
	agt.add_tool(
		"continue_task",
		"Continue a task run",
		[
			task_id = "&string(): ID of the task to continue",
			response = "&string(): Response for the task that issued a signal",
		],
		[](agt, args)
		{		
			env = agt.env;
			
			if(!env.tasks)
				env.tasks = [];
		
			tasks = env.tasks;
		
			task = None;
			
			for(i = 0; i < tasks.size(); i++) {
				if(tasks[i].id == args.task_id)
					task = tasks[i];
					break;
			}
		
			if(!task) {
				return "No task with the specified ID was found, cannot continue non existing task.";
			}
		
			executor = task.agent;
			
			task.finished = false;
			task.finish_reason = "";
			
			last_report = task.report;
			
			if(task.report) {
				if(!task.reports)
					task.reports = [];
				task.reports.push_back(task.report);
				task.report = "";
			}
			
			hierarchy = format_task_hierachy(
				build_task_hierachy(executor)
			);
			
			for(!task.finished) {
				
				//TODO: build simple task hierachy based on _parent recursively (just task names no details)
				//To make it visible to the subagent where in the hiearchy it is
				
				prompt = continue_prompt.replace([
					"[PREV]" = last_report,
					"[RESPONSE]" = args.response,
					"[MILESTONES]" = task.milestones,
					"[GOAL]" = task.goal,
					"[CONTEXT]" = task.context,
					"[CONTRACT]" = task.contract,
					"[CONSTRAINTS]" = task.constraints,
					"[HIERACHY]" = hierarchy,
				]);
				
				try {
					step_result = executor.task(prompt);
				}
				catch(e) {
					//Todo: add fail counter
				}
			}
			
			if(!task.report) {
				if(!task.milestones) {
					return [
						task_id = task.id,
						finish_reason = task.finish_reason,
						report = "The task did not emit a report, furthermore no milestones are available.\nThat means that the task might have failed or crashed during execution.\nManual verification of the task's progress is required.",
					];
				}
				
				return [
					task_id = task.id,
					finish_reason = task.finish_reason,
					report = "The task did not emit a report.\nThat means that the task might have failed or crashed after the last milestones.\nFurther verification of the last steps and the actual tasks progress is required.",
				];
			}
			
			return [
				task_id = task.id,
				finish_reason = task.finish_reason,
				report = task.report,
			];
		}
	);
	
	agt.add_tool(
		"signal",
		"Emit an event",
		[
			event = ["FINISHED", "FAILED", "QUESTION"],
			report = "&string(): What to signal",
		],
		[](agt, args)
		{		
			agt.stop();
			
			if(agt.env.active_task ?? false) {
				agt.env.active_task.finished = true;
				agt.env.active_task.finish_reason = args.event;
				agt.env.active_task.report = args.report;
			}
			
			return "Signal sent, exit and wait for further instructions.";
		}
	);
	
	agt.add_tool(
		"milestone",
		"Emit a milestone",
		[
			description = "&string(): Description of what was achieved",
		],
		[](agt, args)
		{		

			if(agt.env.active_task ?? false) {
				agt.env.active_task.milestones.push_back(args.description);
			}
			
			return "I've made the checkpoint; continue working.";
		}
	);
	
	agt.add_tool(
		"wait_for",
		"Sleep for a while, use this to wait a specific period, for example to wait for an event.",
		[
			seconds = "int(): OPTIONAL How many seconds to wait",
			minutes = "int(): OPTIONAL How many minutes to wait",
			hours = "int(): OPTIONAL How many hours to wait",
		],
		[](agt, args)
		{		
			period = 0;
			
			if(args.seconds)
				period += args.seconds * 1000;
			if(args.minutes)
				period += args.minutes * 60 * 1000;
			if(args.hours)
				period += args.hours * 60 * 60 * 1000;
		
			period = math.max(period, 0);
		
			std.sleep(period);
			
			return "Time after sleep: " + std.timestamp();
		}
	);

	agt.add_read_tools();
	agt.add_code_read_tools();
	agt.add_write_tools();
	agt.add_skill_tools();
}