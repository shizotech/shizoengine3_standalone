
#include "../../miniagent"

agent_prompt = R"(
AGENT TASK

Goal:
[GOAL]

Context:
[CONTEXT]

Contract:
[CONTRACT]

Constraints:
[CONSTRAINTS]

Task hierarchy:
[HIERACHY]
)";

continue_prompt = R"(
AGENT TASK (CONTINUED)

Goal:
[GOAL]

Context:
[CONTEXT]

Contract:
[CONTRACT]

Constraints:
[CONSTRAINTS]

Task hierarchy:
[HIERACHY]

Previously:
[PREV]

Parent response:
[RESPONSE]
)";

build_task_hierachy(agt)
{
	if(agt._parent) {
		hierarchy = build_task_hierachy(agt._parent);

		if(agt.env.active_task ?? false)
			hierarchy.push_back(agt.env.active_task.name);

		return hierarchy;
	}

	return ["ROOT"];
}

format_task_hierachy(hierarchy)
{
	result = "";

	for(i = 0; i < hierarchy.size(); i++) {

		if(i > 0)
			result += "\n";

		for(j = 1; j < i; j++)
			result += "    ";

		if(i == 0)
			result += hierarchy[i];
		else
			result += "└── " + hierarchy[i];
	}

	return result;
}

// The report of a child whose run threw. The exception used to be dropped, and the
// parent only learned that "the task did not emit a finalize() report".
task_crash_report(crash)
{
	return "The task crashed and did not report: " + std.string(crash).strip() + "\nWhat it changed before the crash is unverified: check it before you build on it, then continue the task or start a new one.";
}

// ─────────────────────────────────────────────────────────────────────────────
// Batch tasks (see batch_spec.md)
//
// task_batch is a WORKLOAD MULTIPLIER: one complete, independent child task per
// matched file. The agent supplies the workload, the harness resolves the target,
// creates and schedules the children, and aggregates the per-item results.
// ─────────────────────────────────────────────────────────────────────────────

batch_child_prompt = R"(
AGENT TASK

Goal:
[GOAL]

Context:
[CONTEXT]

Contract:
[CONTRACT]

Constraints:
[CONSTRAINTS]

Assigned item:
[ITEM]

Task hierarchy:
[HIERACHY]
)";

// Appended to every batch child so items stay isolated from each other.
batch_ownership_note = R"(

---

BATCH OWNERSHIP: this task is a single item of a batch.
The assigned item is the only file you own and are allowed to modify.
Do not modify any other project file unless the batch contract or the batch constraints explicitly allow it.
Inspect, implement, debug, test and verify the complete workload for the assigned item yourself.
)";

// Concurrency used when the model config does not limit running agents.
batch_default_concurrency = 4;

// Per-item report size returned to the parent (the full report stays in the task record).
batch_report_max_chars = 1500;

// Slots for parallel children: agent_slot(child, parent) in agent_slots.shio.
// The waiting parent lends its own slot to one child, further parallel
// children take pool slots (max_running_agents counts generating agents).

batch_max_parallel(agt)
{
	limit = batch_default_concurrency;

	if(agt.model_config.max_running_agents > 0)
		limit = agt.model_config.max_running_agents;

	return math.max(1, limit);
}

// Creates the executor for one batch item.
// IMPORTANT: must only be called from a single thread; the agent tree
// (subagent bookkeeping) is not thread safe. Running children may be threaded.
batch_create_child(agt, batch_goal, batch_context, batch_contract, batch_constraints, item, batch_id)
{
	env = agt.env;

	if(!env.tasks)
		env.tasks = [];

	tasks = env.tasks;

	executor = agt.subagent("adaptive");

	parent_id = "";
	if(agt.env.active_task ?? false)
		parent_id = agt.env.active_task.id;

	tasks.push_back([
		agent = executor,
		parent_id = parent_id,
		batch_id = batch_id,
		assigned_item = item,

		id = "task_" + std.random_hash(6),
		name = "batch item: " + item,
		goal = batch_goal,
		context = batch_context,
		contract = batch_contract,
		constraints = batch_constraints,

		finished = false,
		finish_reason = "",
		
		report = "",

		batch_done = false,
	]);

	// JSONs are reference counted: this shares the record with env.tasks.
	task = tasks[-1];

	//Is this a cyclic reference which could cause agent to never destroy?
	//But since subtasks are managed the agents are destroyed nonethless... ?
	executor.env.active_task = task;

	if(agt.on_action) {
		executor.on_action = [agt](act) {
			agt.on_action(act);
		};
	}

	hierarchy = format_task_hierachy(
		build_task_hierachy(executor)
	);

	executor.env.batch_prompt = batch_child_prompt.replace([
		"[GOAL]" = batch_goal,
		"[CONTEXT]" = batch_context,
		"[CONTRACT]" = batch_contract,
		"[CONSTRAINTS]" = batch_constraints + batch_ownership_note,
		"[ITEM]" = item,
		"[HIERACHY]" = hierarchy,
	]);

	executor.env.batch_runs = 0;

	return task;
}

// Drive one batch child until it reaches a terminal state (finished / failed / question).
batch_run_child(agt, task)
{
	executor = task.agent;

	res = None;

	managed _grd = agent_slot(executor, agt);

	//Stopped from above: tear the child down and publish a terminal state, so the
	//batch scheduler drains instead of queueing work that must never run.
	if(agt.should_stop()) {
		executor.stop();

		if(!task.finished) {
			task.finished = true;
			task.finish_reason = "failed";

			if(!task.report)
				task.report = "The batch was stopped by the parent agent before this item started.";
		}

		task.batch_done = true;
		return;
	}

	crash = "";

	try {
		res = executor.task(executor.env.batch_prompt);
	}
	catch(e) {
		res = None;
		crash = std.string(e);
	}
	
	executor.env.batch_runs++;
	
	//The child's finalize() result is this batch item's report now.
	if(std.is_json(executor.task_result)) {
		task.finished = true;
		task.finish_reason = std.string(executor.task_result.signal ?? "failed");
		task.report = std.string(executor.task_result.result ?? "");
	}
	
	//The parent was stopped while this item ran: the child goes down with it, and
	//whatever it produced is not a report the parent will ever read.
	if(agt.should_stop())
		executor.stop();
	
	// Ran out of runs without ever calling finalize().
	if(!task.finished) {
		task.finished = true;
		task.finish_reason = "failed";

		if(!task.report) {
			if(crash)
				task.report = task_crash_report(crash);
			else
				task.report = "The batch child returned nothing before calling finalize().\nManual verification of this item is required.";
		}
	}
	
	// Publish the terminal state to the scheduler.
	task.batch_done = true;
}

// ─────────────────────────────────────────────────────────────────────────────
// Blind tests
//
// An agent that writes the tests for its own implementation tests what the code
// does, not what it should do (and can make them pass either way). So the tests
// of non-trivial work are written by a separate agent that never sees the
// implementation: write_blind_tests hands the specification and the API
// (signatures, no bodies) to an agent of the role util/blind_tester.
//
// "Blind" is enforced by the harness, not by the prompt - as long as the test
// writer cannot run anything:
//   * the file tools of the test writer work on an fs_path_guard (roles/SHARED.shio)
//     instead of the workspace: it reads and writes test_path, reads
//     reference_paths, and every other path is refused;
//   * its role has no command, skill or share tools: nothing else reads files.
//
// With run_command it gets one more tool, run_tests, which runs exactly that
// command - and with it the guarantee is gone, by nature: the tests it wrote are
// code that runs with the access of the workspace. A test can open the
// implementation and print it, copy it, change it; a traceback quotes it. What the
// harness still does: a file a run created or changed inside test_path cannot be
// read by the test writer (blind_mark_run_files: no "copy it over and read it") and
// is named to the parent (files_changed_by_test_runs), and the output of a run is
// cut to blind_run_output_bytes. What a test prints is seen. So run_command is
// optional and off by default: without it the parent runs the tests itself and
// sends the findings back (continue_task), which keeps the test writer blind.
//
// The report comes back in fields: the test files (looked up on disk, not taken
// on trust), the test cases with the behaviour each checks, the ambiguities of
// the spec, what is not covered. The test writer is recorded as a task of the
// parent, so continue_task(task_id, feedback) reaches it later.
// ─────────────────────────────────────────────────────────────────────────────

blind_test_prompt = R"(
BLIND TEST TASK

Write tests for the unit described below. You have not seen its implementation and you cannot
read it: your file tools reach only the paths named here.

Specification (the only source of truth for the expected behaviour):
[SPEC]

API under test (everything you may assume about the implementation):
[API]

Test framework and conventions:
[FRAMEWORK]

Write the tests here (the only place where you may create or change files):
[TEST_PATH]

Reference files you may read:
[REFERENCES]

Running the tests:
[RUN]

Constraints:
[CONSTRAINTS]
)";

blind_feedback_prompt = R"(
FEEDBACK ON YOUR BLIND TESTS

The agent that implements the unit ran your tests and says:

[RESPONSE]

Judge every point against the SPECIFICATION and the API description of your task, not against
what the implementation does:
- the test contradicts the specification, checks something it does not promise, or is broken
  (setup, syntax, misuse of the framework): fix the test;
- the test states what the specification demands: keep it unchanged and say so, with the
  sentence of the specification it rests on;
- the specification does not decide the point: report it as a spec ambiguity. If the feedback
  settles it (a decision of the caller), follow that decision and say so.
The rules of your role still hold. End with finalize() and the complete, updated report.

Your task, unchanged (it is repeated because your earlier messages may have been compacted away):
[BRIEF]
)";

// One run of run_command may take this long (seconds), unless the caller says otherwise.
blind_run_timeout_s = 600;

// The test writer may call run_tests this often.
blind_max_runs = 20;

// Output of one run_tests call: enough for the failures, small enough that a
// runner that quotes source lines leaks little.
blind_run_output_bytes = 16000;

// A string or a list of strings as a list of the non-empty ones.
blind_string_list(value)
{
	var list = [];

	if(std.is_none(value))
		return list;

	if(std.is_string(value)) {
		if(value.strip())
			list.push_back(value.strip());
		return list;
	}

	if(std.is_json(value)) {
		for(var i = 0; i < value.size(); i++) {
			var entry = std.string(value[i]).strip();
			if(entry)
				list.push_back(entry);
		}
	}

	return list;
}

// The files below the test path with their size and time of the last write.
blind_snapshot(guard)
{
	var snap = [];

	for(var i = 0; i < guard.write_list.size(); i++) {
		var root = guard.write_list[i];

		if(!guard.base.exists(root))
			continue;

		if(!guard.base.is_directory(root)) {
			var one = guard.base.file_info(root);
			snap[root] = [size = one.size, time = one.last_write_time];
			continue;
		}

		var names = guard.base.files(root, true);

		for(var j = 0; j < names.size(); j++) {
			var file = root + "/" + std.string(names[j]);
			var info = guard.base.file_info(file);

			if(std.is_json(info))
				snap[file] = [size = info.size, time = info.last_write_time];
		}
	}

	return snap;
}

// After a run: what it created or changed inside the test path is not the test
// writer's own text any more (a run can copy the implementation there). Those files
// become unreadable for the test writer and are remembered for the parent.
// Returns their names.
blind_mark_run_files(guard, blind, before)
{
	var after = blind_snapshot(guard);
	var changed = [];

	for(var i = 0; i < after.size(); i++) {
		var file = after.key(i);
		var now = after[i];

		if(before.has(file) && before[file].size == now.size && before[file].time == now.time)
			continue;

		guard.set_foreign(file, "it was written by a run of the tests, not by you");
		changed.push_back(file);
		blind.run_files[file] = true;
	}

	return changed;
}

// The first `count` entries of a list.
blind_first(list, count)
{
	var out = [];

	for(var i = 0; i < list.size() && i < count; i++) {
		out.push_back(list[i]);
	}

	return out;
}

// run_tests of the test writer: exactly the command of the caller, nothing else.
blind_add_run_tool(tester, command, timeout_ms)
{
	tester.add_tool(
		"run_tests",
		"Run the tests with the command your caller configured (you cannot change it) and get the exit code and the output.\nCommand: " + command + "\nUse it to find mistakes in your TESTS: syntax, setup, misuse of the framework. A test that fails because the unit does not do what the specification says is a finding: keep it as it is. Never take expected values from this output.",
		[],
		[command, timeout_ms](agt, args)
		{
			var blind = agt.env.blind;

			if(blind.runs >= blind_max_runs)
				return agt_fail("run_tests was called " + std.string(blind.runs) + " times, that is the limit.", "Finish with what you have: report the state of the tests in finalize().");

			blind.runs++;

			var before = blind_snapshot(agt.env.fs_guard);

			var result = cmd_run_to_end(agt, command, ".", timeout_ms, blind_run_output_bytes);

			var run_files = blind_mark_run_files(agt.env.fs_guard, blind, before);

			if(run_files.size()) {
				result.files_changed_by_this_run = blind_first(run_files, 40);
				result.files_changed_note = std.string(run_files.size()) + " file(s) in the test path were created or changed by this run, not by you: you cannot read them. Remove what should not stay (output of the tests, caches).";
			}

			blind.last_run = [
				run = blind.runs,
				state = std.string(result.state ?? "NOT STARTED"),
				exit_code = result.has("exit_code") ? result.exit_code : None,
			];
			blind.last_run_writes = agt.env.fs_guard.writes;

			result.command = command;
			result.reminder = "Fix mistakes in your tests only. A test that states what the specification demands stays unchanged, also when it fails.";

			return result;
		}
	);
}

// What write_blind_tests / continue_task hand to the parent: the report of the
// test writer in fields, plus what the harness itself can see.
blind_tests_result(task, tester, crash = "")
{
	var guard = tester.env.fs_guard;
	var blind = tester.env.blind;

	var out = [
		ok = false,
		task_id = task.id,
		finish_reason = task.finish_reason,
	];

	var report = None;
	if(std.is_json(tester.task_result))
		report = tester.task_result.result;

	// The test files as they are on disk, not as the report claims them: what was written
	// through the restricted view and is still there, plus files the report names that
	// exist inside the view (tests the writer kept as they were).
	var files = [];
	var listed = [];
	var written = guard.touched_files();

	for(var i = 0; i < written.size(); i++) {
		listed[written[i]] = true;
		files.push_back([
			file = written[i],
			bytes = guard.base.size(written[i]),
		]);
	}

	if(std.is_json(report) && std.is_json(report.test_files)) {
		for(var j = 0; j < report.test_files.size(); j++) {
			var named = guard.tidy(report.test_files[j]);

			if(listed.has(named) || guard.access_error(named, "read") != "")
				continue;

			if(guard.base.exists(named) && !guard.base.is_directory(named)) {
				listed[named] = true;
				files.push_back([
					file = named,
					bytes = guard.base.size(named),
				]);
			}
		}
	}

	out.test_files = files;

	if(std.is_json(report) && report.has("summary")) {
		out.summary = report.summary;
		out.test_cases = report.test_cases;
		out.spec_ambiguities = report.spec_ambiguities;
		out.not_covered = report.not_covered;

		if(report.run_result ?? false)
			out.run_result = report.run_result;
	}
	else {
		out.report = crash ? task_crash_report(crash) : std.string(report ?? "");

		if(!out.report)
			out.report = "The test writer ended without a report: it may have crashed. Look at the test files that exist, then call write_blind_tests again.";
	}

	// what the harness saw of the last run_tests call (not what the test writer says about it)
	if(std.is_json(blind.last_run)) {
		out.last_test_run = blind.last_run.copy();
		out.last_test_run.tests_changed_afterwards = (guard.writes != blind.last_run_writes) ? true : false;
	}

	// files a run left in the test path (the test writer could not read them; it may have
	// removed or rewritten some since)
	if(std.is_json(blind.run_files) && blind.run_files.size()) {
		var left = [];

		for(var r = 0; r < blind.run_files.size(); r++) {
			var run_file = blind.run_files.key(r);

			if(guard.base.exists(run_file) && guard.access_error(run_file, "content") != "")
				left.push_back(run_file);
		}

		if(left.size()) {
			out.files_changed_by_test_runs = blind_first(left, 60);
			out.files_changed_by_test_runs_total = left.size();
			out.files_changed_by_test_runs_note = "Runs of the tests created or changed these files inside the test path (caches and test output are normal). Look at anything else: a test that copies or prints the implementation is not a blind test.";
		}
	}

	if(task.finish_reason == "finished" && files.size()) {
		out.ok = true;
		out.next_steps = "Run these tests against your implementation. A failing test means the implementation (or the specification) is wrong: fix the implementation. Do NOT edit, weaken, skip or delete the blind tests. A test you believe contradicts the specification goes back to the test writer: continue_task(task_id, <which test, why, the sentence of the specification>). Decide every entry of spec_ambiguities (or ask your parent) and send the decision with continue_task when tests have to change.";
	}
	else if(task.finish_reason == "question") {
		out.next_steps = "The test writer needs an answer before it can write the tests: answer with continue_task(task_id, <answer>).";
	}
	else {
		out.next_steps = "No usable tests came back. Read the reason, then fix the specification / API description or the paths and call write_blind_tests again, or answer with continue_task(task_id, ...).";
	}

	return out;
}

blind_tests_start(agt, args)
{
	var spec = (args.has("spec") && !std.is_none(args.spec)) ? std.string(args.spec).strip() : "";
	var api = (args.has("api") && !std.is_none(args.api)) ? std.string(args.api).strip() : "";

	if(!spec)
		return agt_fail("Missing 'spec': no test writer was started.", "Give the behaviour to test: what every operation does for valid input, at the boundaries, for invalid input and on errors. The test writer knows nothing else.");

	if(!api)
		return agt_fail("Missing 'api': no test writer was started.", "Give the signatures / the interface exactly as the tests call it: names, parameters, results, errors, how to import or include the unit.");

	var test_dir = agt_path_check(agt, args.test_path, "write", "test_path");
	if(!test_dir.ok)
		return test_dir;

	var fs = agt.filesystem;

	var references = [];
	var wanted = blind_string_list(args.reference_paths);

	for(var i = 0; i < wanted.size(); i++) {
		var reference = agt_path_check(agt, wanted[i], "read", "reference_paths");
		if(!reference.ok)
			return reference;

		if(!fs.exists(reference.path))
			return agt_fail("The reference path '" + reference.path + "' does not exist: no test writer was started.", "List existing files or directories only, or leave reference_paths out.");

		references.push_back(reference.path);
	}

	// The jail of the test writer. It refuses the working directory itself as a path:
	// that would open everything.
	var guard = None;

	try {
		guard = fs_path_guard(fs, [test_dir.path], references, "blind test writer",
			"the implementation is off limits: tests are written from the specification and the API description only");
	}
	catch(e) {
		return agt_fail("The restricted file view of the test writer could not be set up: " + std.string(e).strip(), "test_path and reference_paths have to be files or directories below the working directory, never the working directory itself.");
	}

	var run_command = (args.has("run_command") && !std.is_none(args.run_command)) ? std.string(args.run_command).strip() : "";

	var run_timeout_s = blind_run_timeout_s;
	if(args.run_timeout ?? false)
		run_timeout_s = math.max(1, std.int(args.run_timeout));

	var env = agt.env;

	if(!env.tasks)
		env.tasks = [];

	var tasks = env.tasks;

	var tester = agt.subagent("util/blind_tester");

	tester.filesystem = guard;			// the jail
	tester.env.fs_guard = guard;		// lets the file tools answer a refusal as a normal error
	tester.env.blind = [
		test_path = test_dir.path,
		reference_paths = references,
		run_command = run_command,
		runs = 0,
		last_run = None,
		last_run_writes = -1,
		run_files = std.json(),		// file -> true: created or changed by a run of the tests
	];

	if(run_command)
		blind_add_run_tool(tester, run_command, run_timeout_s * 1000);

	var parent_id = "";
	if(agt.env.active_task ?? false)
		parent_id = agt.env.active_task.id;

	tasks.push_back([
		agent = tester,
		parent_id = parent_id,
		kind = "blind_tests",

		id = "task_" + std.random_hash(6),
		name = "blind tests: " + test_dir.path,
		goal = "Write blind tests into " + test_dir.path,
		context = "",
		contract = "",
		constraints = "",

		finished = false,
		finish_reason = "",

		report = "",
	]);

	var task = tasks[-1];

	tester.env.active_task = task;

	if(agt.on_action) {
		tester.on_action = [agt](act) {
			agt.on_action(act);
		};
	}

	var framework = (args.has("framework") && !std.is_none(args.framework)) ? std.string(args.framework).strip() : "";
	var constraints = (args.has("constraints") && !std.is_none(args.constraints)) ? std.string(args.constraints).strip() : "";

	var run_text = "You cannot run the tests: there is no run_tests tool. Write them so that they are correct as they stand, and say in your report that they were not run.";
	if(run_command)
		run_text = "Call run_tests() to run: " + run_command + "\nYou cannot run anything else.";

	var prompt = blind_test_prompt.replace([
		"[SPEC]" = spec,
		"[API]" = api,
		"[FRAMEWORK]" = framework ? framework : "Not given: follow the tests and helpers that already exist in the test path and the reference files; if there are none, use the most common framework of the language and say which.",
		"[TEST_PATH]" = test_dir.path,
		"[REFERENCES]" = references.size() ? references.combine_string("\n").strip() : "None.",
		"[RUN]" = run_text,
		"[CONSTRAINTS]" = constraints ? constraints : "None.",
	]);

	// kept for continue_task: the feedback goes out with the task again (blind_feedback_prompt)
	task.blind_brief = prompt;

	managed _grd = agent_slot(tester, agt);

	if(agt.should_stop()) {
		tester.stop();
		return [
			task_id = task.id,
			stopped = true,
			finish_reason = task.finish_reason,
			report = "The agent was stopped before the test writer started.\nDo not continue, end the turn with finalize().",
		];
	}

	var crash = "";

	try {
		tester.task(prompt);
	}
	catch(e) {
		crash = std.string(e);
	}

	if(std.is_json(tester.task_result)) {
		task.finished = true;
		task.finish_reason = std.string(tester.task_result.signal ?? "failed");
		task.report = std.string(tester.task_result.result ?? "");
	}
	else if(crash) {
		task.finished = true;
		task.finish_reason = "failed";
		task.report = task_crash_report(crash);
	}

	if(agt.should_stop()) {
		tester.stop();
		return [
			task_id = task.id,
			stopped = true,
			finish_reason = task.finish_reason,
			report = "The agent was stopped while the test writer was running.\nDo not continue, end the turn with finalize().",
		];
	}

	return blind_tests_result(task, tester, crash);
}

add_tools(agt)
{
	agt.add_tool(
		"fork",
		"Fork yourself to save on context and on deterministic steps.\nThis creates copies of the current conversation and runs separate agents to work on different things in parallel.\nMake sure to tell your siblings what to do exactly so they dont continue on your path.\nYou will receive their aggregated results once they are finished.\nYour execution is paused until all forks finished.",
		[
			tasks = "&uarray(string): The tasks/messages to the siblings.",
		],
		[](agt, args)
		{		
			//No tasks: the old code returned an empty result list, which told the model nothing.
			if(!std.is_list(args.tasks) || !args.tasks.size())
				return agt_fail("Missing 'tasks': nothing was forked.", "Give a list with one message per sibling: what exactly that sibling has to do.");

			fork_results = [];
			
			for(i = 0; i < args.tasks.size(); i++) {
				fork_results.push_back([
					report = "Fork did not emit any reports.",
				]);
			}
		
			fork_thread = [agt, args, fork_results](task_index) {
				
				task = args.tasks[task_index];
				
				executor = agt.subagent(agt.role);
				
				if(agt.env.active_task)
					executor.env.active_task = agt.env.active_task.copy();
				
				history = agt.history().copy();
				
				//Manually build single fork tool call with result here...
				history[-1].tool_calls = [args.tool_call];
				history.push_back(
					[role = "tool", tool_call_id = args.tool_call.id, content = "forked_index: " + task_index]
				);
				
				executor.import_history(history);
				
				if(agt.on_action) {
					executor.on_action = [agt](act) {
						agt.on_action(act);
					};
				}
				
				managed _grd = agent_slot(executor, agt);

				//Stopped from above: this sibling must not start, and it is torn
				//down so nothing below it keeps generating.
				if(agt.should_stop()) {
					executor.stop();
					fork_results[task_index].report = "The fork was stopped before this sibling started.";
					return;
				}
				
				try {
					prompt = "You are forked sibling number " + task_index + ".\nFocus only on the following part of the task only, then immediately finish with finalize():\n\n" + task;
					executor.task(prompt);
					if(std.is_json(executor.task_result))
						fork_results[task_index].report = std.string(executor.task_result.result ?? "");
				}
				catch(e) {
					fork_results[task_index].report = "This sibling crashed and did not report: " + std.string(e).strip() + "\nWhat it changed before the crash is unverified.";
				}
				
				//The parent was stopped while this sibling ran: it goes down with
				//its own subagent tree, and its output is not a report anyone reads.
				if(agt.should_stop()) {
					executor.stop();
					fork_results[task_index].report = "The fork was stopped while this sibling was running.";
				}
			};
			
			fork_threads = [];
		
			for(i = 0; i < args.tasks.size(); i++) {
				t = std.thread(fork_thread);
				t.run(i);
				fork_threads.push_back(t);
			}
			
			for(i = 0; i < fork_threads.size(); i++) {
				fork_threads[i].join();
			}
		
			if(agt.should_stop()) {
				return [
					stopped = true,
					results = fork_results,
					note = "The agent was stopped. Do not continue, end the turn with finalize().",
				];
			}

			return [results = fork_results];
		}
	);
	
	agt.add_tool(
		"start_task",
		"Create/delegate work, 'effort' defines the reasoning effort. Very complex tasks: high, easy or clearly defined tasks: medium, Single quick instant actions: low.",
		[
			name = "&string(): Name of the task",
			goal = "&string(): Description of the task (detailed)",
			context = "&string(): Required context for the task",
			contract = "&string(): Contract for the task",
			effort = ["low", "medium", "high"],
			constraints = "string(): OPTIONAL constraints",
		],
		[](agt, args)
		{		
			//A child without a goal has nothing to do; it used to be started anyway.
			if(!args.has("goal") || std.is_none(args.goal) || std.string(args.goal).strip() == "")
				return agt_fail("Missing 'goal': no task was started.", "Give name, goal, context, contract and effort. The child knows nothing but what these fields say.");

			env = agt.env;
			
			if(!env.tasks)
				env.tasks = [];
		
			tasks = env.tasks;
		
			executor = agt.subagent("adaptive");

			//An effort the model API does not know would fail every request of the child:
			//anything but the three known values leaves the child on its default.
			effort = std.string(args.effort ?? "").strip().lowercase();
			if(effort == "low" || effort == "medium" || effort == "high")
				executor.set_reasoning_effort(effort);
		
			parent_id = "";
			if(agt.env.active_task ?? false)
				parent_id = agt.env.active_task.id;
		
			tasks.push_back([
				agent = executor,
				parent_id = parent_id,
			
				id = "task_" + std.random_hash(6),
				name = args.name,
				goal = args.goal,
				context = args.context,
				contract = args.contract,
				constraints = args.constraints,
				
				finished = false,
				finish_reason = "",
				
				report = "",
			]);
		
			task = tasks[-1];
			
			executor.env.active_task = task;
			
			if(agt.on_action) {
				executor.on_action = [agt](act) {
					agt.on_action(act);
				};
			}
			
			hierarchy = format_task_hierachy(
				build_task_hierachy(executor)
			);
			
			managed _grd = agent_slot(executor, agt);
			
			//A stop must end the turn: returning nothing here handed the model an
			//empty tool result and it simply kept generating.
			if(agt.should_stop()) {
				executor.stop();
				return [
					task_id = task.id,
					stopped = true,
					finish_reason = task.finish_reason,
					report = "The agent was stopped before this task started.\nDo not continue, end the turn with finalize().",
				];
			}
			
			prompt = agent_prompt.replace([
				"[GOAL]" = args.goal,
				"[CONTEXT]" = args.context,
				"[CONTRACT]" = args.contract,
				"[CONSTRAINTS]" = args.constraints,
				"[HIERACHY]" = hierarchy,
			]);

			crash = "";

			try {
				step_result = executor.task(prompt);
			}
			catch(e) {
				crash = std.string(e);
			}
			
			//The child's finalize() result is the task report now.
			if(std.is_json(executor.task_result)) {
				task.finished = true;
				task.finish_reason = std.string(executor.task_result.signal ?? "failed");
				task.report = std.string(executor.task_result.result ?? "");
			}
			else if(crash) {
				//The run threw: the parent gets the reason, not just "no report".
				task.finished = true;
				task.finish_reason = "failed";
				task.report = task_crash_report(crash);
			}
			
			//Stopped while the child ran: the child goes down with its own tree and
			//the parent gets a stop, not a report to continue from.
			if(agt.should_stop()) {
				executor.stop();
				return [
					task_id = task.id,
					stopped = true,
					finish_reason = task.finish_reason,
					report = "The agent was stopped while this task was running.\nDo not continue, end the turn with finalize().",
				];
			}
			
			if(!task.report) {
				return [
					task_id = task.id,
					finish_reason = task.finish_reason,
					report = "The task did not emit a finalize() report.\nThat means that the task might have failed or crashed during its run.\nFurther verification of the last steps and the actual task's progress is required.",
				];
			}
			
			return [
				task_id = task.id,
				finish_reason = task.finish_reason,
				report = task.report,
			];
		}
	);
	
	agt.add_tool(
		"continue_task",
		"Continue a task run",
		[
			task_id = "&string(): ID of the task to continue",
			response = "&string(): Response for the task that issued a finalize report",
		],
		[](agt, args)
		{		
			env = agt.env;
			
			if(!env.tasks)
				env.tasks = [];
		
			tasks = env.tasks;
		
			task = None;
			
			for(i = 0; i < tasks.size(); i++) {
				if(tasks[i].id == args.task_id)
					task = tasks[i];
					break;
			}
		
			if(!task) {
				known = [];
				for(i = 0; i < tasks.size(); i++)
					known.push_back(tasks[i].id + " (" + std.string(tasks[i].name) + ")");

				return [
					ok = false,
					error = "No task with the id '" + std.string(args.task_id) + "' exists: nothing was continued.",
					known_tasks = known,
					hint = known.size() ? "Use a task_id of a task you started (start_task, file_task_batch and write_blind_tests return it)." : "You have not started any task yet: use start_task.",
				];
			}
			
			//A stop is checked before any task state is touched: a stopped agent
			//must not resurrect a child and hand the model a fresh report.
			if(agt.should_stop()) {
				return [
					task_id = args.task_id,
					stopped = true,
					report = "The agent was stopped.\nDo not continue, end the turn with finalize().",
				];
			}

			executor = task.agent;
			
			task.finished = false;
			task.finish_reason = "";
			
			last_report = task.report;
			
			if(task.report) {
				if(!task.reports)
					task.reports = [];
				task.reports.push_back(task.report);
				task.report = "";
			}
			
			hierarchy = format_task_hierachy(
				build_task_hierachy(executor)
			);
			
			prompt = continue_prompt.replace([
				"[PREV]" = last_report,
				"[RESPONSE]" = args.response,
				"[GOAL]" = task.goal,
				"[CONTEXT]" = task.context,
				"[CONTRACT]" = task.contract,
				"[CONSTRAINTS]" = task.constraints,
				"[HIERACHY]" = hierarchy,
			]);

			//A blind test writer gets the feedback with its rules and its task again: the
			//continued turn may start on a cleared or compacted context (miniagent.task()
			//clears a chat that is over half full), and "judge it against the specification"
			//without the specification is a guess. It answers in the fields of its report.
			is_blind = std.string(task.kind ?? "") == "blind_tests";

			if(is_blind)
				prompt = blind_feedback_prompt.replace([
					"[RESPONSE]" = std.string(args.response ?? ""),
					"[BRIEF]" = std.string(task.blind_brief ?? "").strip(),
				]);
			
			managed _grd = agent_slot(executor, agt);
			
			if(agt.should_stop()) {
				executor.stop();
				return [
					task_id = task.id,
					stopped = true,
					finish_reason = task.finish_reason,
					report = "The agent was stopped before this task continued.\nDo not continue, end the turn with finalize().",
				];
			}
			
			crash = "";

			try {
				step_result = executor.task(prompt);
			}
			catch(e) {
				//Todo: add fail counter
				crash = std.string(e);
			}
			
			//The child's finalize() result is the task report now.
			if(std.is_json(executor.task_result)) {
				task.finished = true;
				task.finish_reason = std.string(executor.task_result.signal ?? "failed");
				task.report = std.string(executor.task_result.result ?? "");
			}
			else if(crash) {
				task.finished = true;
				task.finish_reason = "failed";
				task.report = task_crash_report(crash);
			}
			
			//Stopped while the child ran: the child goes down with its own tree.
			if(agt.should_stop()) {
				executor.stop();
				return [
					task_id = task.id,
					stopped = true,
					finish_reason = task.finish_reason,
					report = "The agent was stopped while this task was running.\nDo not continue, end the turn with finalize().",
				];
			}

			if(is_blind)
				return blind_tests_result(task, executor, crash);
			
			if(!task.report) {
				return [
					task_id = task.id,
					finish_reason = task.finish_reason,
					report = "The task did not emit a finalize() report.\nThat means that the task might have failed or crashed after the last progress notes.\nFurther verification of the last steps and the actual task's progress is required.",
				];
			}
			
			return [
				task_id = task.id,
				finish_reason = task.finish_reason,
				report = task.report,
			];
		}
	);
	
	agt.add_tool(
		"file_task_batch",
		"**ONLY CALL THIS TOOL ONE AT A TIME, NOT IN PARALLEL!**\nCreate one independent agent task for every item matched by a path selector.\n\nThe agent provides the workload, the harness resolves 'target' with glob() semantics, snapshots the file list, creates and schedules one child task per matched file, manages concurrency internally, and aggregates the per-item results.\n\nPath selector semantics: an exact path matches that file, a directory path matches the files inside it, '*' matches everything within one directory level, '**' matches recursively across directory levels, and '?' matches a single character. Examples: 'src/', 'src/**/*.cpp', 'src/shaders/*.frag'. The selector is resolved once at batch creation into a fixed snapshot; files created, deleted or renamed afterwards do not become new batch items.\n\nThis is a WORKLOAD multiplier, not an action multiplier: every child owns the complete workload (inspect, implement, debug, test, verify) for its assigned item. Never describe a sequence of trivial actions in 'goal' and never enumerate the files in 'goal'; the harness tells each child which file it owns.\n\nA failure or question of one child does not affect the other children. The batch returns only after every matched item reached finished, failed or question.\n\nAn empty target is not an error.",
		[
			target = "&string(): Path selector describing the files to process (exact path, directory, '*', '**', '?'). Resolved once into a fixed snapshot.",
			goal = "&string(): The workload every child must complete for its assigned file. Describe the desired result, not a list of actions and not a list of files.",
			context = "string(): OPTIONAL context shared with every child task.",
			contract = "string(): OPTIONAL contract every child must satisfy for its assigned item.",
			constraints = "string(): OPTIONAL restrictions applying to every child (e.g. do not modify unrelated files, preserve existing behavior).",
		],
		[](agt, args)
		{
			env = agt.env;

			if(!env.tasks)
				env.tasks = [];

			tasks = env.tasks;

			// A selector glob() does not take (absolute, "..", outside the working directory) is
			// ignored there, and the batch came back as "matched no files": say what is wrong with it.
			target_check = agt_path_check(agt, args.target, "read", "target");
			if(!target_check.ok)
				return target_check;

			// ── Target resolution: exactly once, fixed snapshot for this batch ──
			items = fileio.glob(args.target);

			if(!items)
				items = [];

			batch_id = "batch_" + std.random_hash(6);

			batch_goal = args.goal;
			batch_context = args.context ?? "";
			batch_contract = args.contract ?? "";
			batch_constraints = args.constraints ?? "";

			// ── Child creation (single threaded: the agent tree is not thread safe) ──
			children = [];

			for(i = 0; i < items.size(); i++) {
				item = items[i];

				task = batch_create_child(agt, batch_goal, batch_context, batch_contract, batch_constraints, item, batch_id);

				children.push_back(task);
			}
			
			// ── Empty target: a valid, successful batch ──
			if(!children.size()) {
				return [
					batch_id = batch_id,
					target = args.target,
					status = "BATCH finished",
					total = 0,
					finished = 0,
					failed = 0,
					questions = 0,
					results = [],
					note = "The target matched no files. This is not an error.",
				];
			}

			// Batch children use their own slot counter so that the internal
			// helper subagents of a child can still use the model_config slots.
			max_parallel = batch_max_parallel(agt);

			next_item = 0;
			batch_running = 0;

			batch_pool = [];

			batch_launch = [&next_item, &batch_running, &children, batch_pool, agt](max_parallel) {
				for(*next_item < children.size()) {

					//A stop drains the queue: nothing new is started below a stopped agent.
					if(agt.should_stop())
						break;

					if(batch_running >= max_parallel)
						break;

					batch_running++;
					task = children[*next_item];
					*next_item++;
					
					//The item by value (#521): with [&task] a thread that started after the next pass of this loop
					//ran the next item instead, so items ran twice and others never (reported as failed).
					batch_thread = std.thread([agt, task, &batch_running]() {
						batch_run_child(agt, task);
						batch_running--;
					});
					
					batch_pool.push_back(batch_thread);
					batch_thread.run();
				}
			};
			
			// ── Scheduling ──
			// Keep every slot busy: as soon as a child finishes, a pending item is started.
			batch_launch(max_parallel);
			
			for(next_item < children.size() || batch_running > 0) {
				if(agt.should_stop())
					break;
				std.sleep(25);
				batch_launch(max_parallel);
			}
			
			// ── Stop: tear the whole batch down ──
			// Every item of a batch is a child agent of this agent; a stop must
			// reach all of them, not just the one that happens to be scheduled.
			if(agt.should_stop()) {
				for(i = 0; i < children.size(); i++) {
					children[i].agent.stop();

					if(!children[i].finished) {
						children[i].finished = true;
						children[i].finish_reason = "failed";

						if(!children[i].report)
							children[i].report = "The batch was stopped by the parent agent before this item finished.";
					}
				}
			}
			
			for(i = 0; i < batch_pool.size(); i++) {
				batch_pool[i].join();
			}
			
			// ── Aggregate ──
			total = children.size();
			finished = 0;
			failed = 0;
			questions = 0;

			results = [];

			for(i = 0; i < children.size(); i++) {
				task = children[i];

				status = task.finish_reason;
				if(!status)
					status = "failed";

				if(status == "finished")
					finished++;
				else if(status == "question")
					questions++;
				else
					failed++;

				report = task.report ?? "";
				if(report.size() > batch_report_max_chars)
					report = report.substr(0, batch_report_max_chars) + "\n...[report truncated]...";

				results.push_back([
					item = task.assigned_item,
					task_id = task.id,
					status = status,
					report = report,
				]);
			}

			batch_status = "BATCH finished";

			if(agt.should_stop())
				batch_status = "BATCH stopped";

			result = [
				batch_id = batch_id,
				target = args.target,
				status = batch_status,
				total = total,
				finished = finished,
				failed = failed,
				questions = questions,
				results = results,
			];

			if(agt.should_stop()) {
				result.stopped = true;
				result.note = "The agent was stopped and the batch was torn down.\nDo not continue, end the turn with finalize().";
			}

			return result;
		}
	);

	agt.add_tool(
		"write_blind_tests",
		"Have the tests for your implementation written by a test writer that cannot see it: it gets 'spec' and 'api' only, its file tools reach 'test_path' (read and write) and 'reference_paths' (read) and nothing else, and it has no command tools.\nReturns the test files, the test cases with the behaviour each one checks, and the ambiguities it found in the specification. Then run the tests and fix the IMPLEMENTATION, not the tests; a test you believe is wrong goes back with continue_task(task_id, <which test and why>).\nBlocks until the test writer is done.",
		[
			spec = "&string(): The behaviour to test, complete and self-contained: what every operation does for valid input, at the boundaries, for invalid input and on errors. The task's demands, not a description of your code.",
			api = "&string(): Signatures / interface exactly as the tests call it: names, parameters, results, errors, how to import or include the unit. No bodies.",
			test_path = "&string(): File or directory (relative) the tests are written to. The test writer can read everything in it: where tests live next to the code, give the test file, not the directory.",
			framework = "string(): OPTIONAL test framework and conventions: language, runner, file naming.",
			reference_paths = "uarray(string): OPTIONAL files / directories the test writer may READ: public headers, interface docs, test helpers. Never the implementation.",
			run_command = "string(): OPTIONAL command that runs the tests; the test writer may then run exactly this command. Leave it out to keep it blind: tests that run can print, copy or change your code, so with it the blindness rests on the test writer following its rules. Without it you run the tests yourself and send what failed with continue_task.",
			run_timeout = "int(1): OPTIONAL seconds one run of run_command may take (default 600).",
			constraints = "string(): OPTIONAL restrictions: what not to test, allowed dependencies.",
		],
		[](agt, args)
		{
			return blind_tests_start(agt, args);
		}
	);

	agt.add_read_tools();
	agt.add_code_read_tools();
	agt.add_write_tools();
	agt.add_skill_tools();
	agt.add_share_tools();
	agt.add_command_tools();
	agt.add_finalize();
}