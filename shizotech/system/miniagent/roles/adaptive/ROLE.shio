
#include "../../miniagent"

agent_prompt = R"(
AGENT TASK

Goal:
[GOAL]

Context:
[CONTEXT]

Contract:
[CONTRACT]

Constraints:
[CONSTRAINTS]

Task hierarchy:
[HIERACHY]
)";

continue_prompt = R"(
AGENT TASK (CONTINUED)

Goal:
[GOAL]

Context:
[CONTEXT]

Contract:
[CONTRACT]

Constraints:
[CONSTRAINTS]

Task hierarchy:
[HIERACHY]

Previously:
[PREV]

Parent response:
[RESPONSE]
)";

build_task_hierachy(agt)
{
	if(agt._parent) {
		hierarchy = build_task_hierachy(agt._parent);

		if(agt.env.active_task ?? false)
			hierarchy.push_back(agt.env.active_task.name);

		return hierarchy;
	}

	return ["ROOT"];
}

format_task_hierachy(hierarchy)
{
	result = "";

	for(i = 0; i < hierarchy.size(); i++) {

		if(i > 0)
			result += "\n";

		for(j = 1; j < i; j++)
			result += "    ";

		if(i == 0)
			result += hierarchy[i];
		else
			result += "└── " + hierarchy[i];
	}

	return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// Batch tasks (see batch_spec.md)
//
// task_batch is a WORKLOAD MULTIPLIER: one complete, independent child task per
// matched file. The agent supplies the workload, the harness resolves the target,
// creates and schedules the children, and aggregates the per-item results.
// ─────────────────────────────────────────────────────────────────────────────

batch_child_prompt = R"(
AGENT TASK

Goal:
[GOAL]

Context:
[CONTEXT]

Contract:
[CONTRACT]

Constraints:
[CONSTRAINTS]

Assigned item:
[ITEM]

Task hierarchy:
[HIERACHY]
)";

// Appended to every batch child so items stay isolated from each other.
batch_ownership_note = R"(

---

BATCH OWNERSHIP: this task is a single item of a batch.
The assigned item is the only file you own and are allowed to modify.
Do not modify any other project file unless the batch contract or the batch constraints explicitly allow it.
Inspect, implement, debug, test and verify the complete workload for the assigned item yourself.
)";

// Concurrency used when the model config does not limit running agents.
batch_default_concurrency = 4;

// Per-item report size returned to the parent (the full report stays in the task record).
batch_report_max_chars = 1500;

// Slots for parallel children: agent_slot(child, parent) in agent_slots.shio.
// The waiting parent lends its own slot to one child, further parallel
// children take pool slots (max_running_agents counts generating agents).

batch_max_parallel(agt)
{
	limit = batch_default_concurrency;

	if(agt.model_config.max_running_agents > 0)
		limit = agt.model_config.max_running_agents;

	return math.max(1, limit);
}

// Creates the executor for one batch item.
// IMPORTANT: must only be called from a single thread; the agent tree
// (subagent bookkeeping) is not thread safe. Running children may be threaded.
batch_create_child(agt, batch_goal, batch_context, batch_contract, batch_constraints, item, batch_id)
{
	env = agt.env;

	if(!env.tasks)
		env.tasks = [];

	tasks = env.tasks;

	executor = agt.subagent("adaptive");

	parent_id = "";
	if(agt.env.active_task ?? false)
		parent_id = agt.env.active_task.id;

	tasks.push_back([
		agent = executor,
		parent_id = parent_id,
		batch_id = batch_id,
		assigned_item = item,

		id = "task_" + std.random_hash(6),
		name = "batch item: " + item,
		goal = batch_goal,
		context = batch_context,
		contract = batch_contract,
		constraints = batch_constraints,

		finished = false,
		finish_reason = "",
		milestones = [],
		report = "",

		batch_done = false,
	]);

	// JSONs are reference counted: this shares the record with env.tasks.
	task = tasks[-1];

	//Is this a cyclic reference which could cause agent to never destroy?
	//But since subtasks are managed the agents are destroyed nonethless... ?
	executor.env.active_task = task;

	if(agt.on_action) {
		executor.on_action = [agt](act) {
			agt.on_action(act);
		};
	}

	hierarchy = format_task_hierachy(
		build_task_hierachy(executor)
	);

	executor.env.batch_prompt = batch_child_prompt.replace([
		"[GOAL]" = batch_goal,
		"[CONTEXT]" = batch_context,
		"[CONTRACT]" = batch_contract,
		"[CONSTRAINTS]" = batch_constraints + batch_ownership_note,
		"[ITEM]" = item,
		"[HIERACHY]" = hierarchy,
	]);

	executor.env.batch_runs = 0;

	return task;
}

// Drive one batch child until it reaches a terminal state (finished / failed / question).
batch_run_child(agt, task)
{
	executor = task.agent;

	res = None;

	managed _grd = agent_slot(executor, agt);

	//Stopped from above: tear the child down and publish a terminal state, so the
	//batch scheduler drains instead of queueing work that must never run.
	if(agt.should_stop()) {
		executor.stop();

		if(!task.finished) {
			task.finished = true;
			task.finish_reason = "failed";

			if(!task.report)
				task.report = "The batch was stopped by the parent agent before this item started.";
		}

		task.batch_done = true;
		return;
	}

	try {
		res = executor.task(executor.env.batch_prompt);
	}
	catch(e) {
		res = None;
	}
	
	executor.env.batch_runs++;

	//The parent was stopped while this item ran: the child goes down with it, and
	//whatever it produced is not a report the parent will ever read.
	if(agt.should_stop())
		executor.stop();

	// Ran out of runs without ever signalling.
	if(!task.finished) {
	
		task.finished = true;
		task.finish_reason = "failed";

		if(!task.report)
			task.report = "The batch child crashed or returned nothing before emitting a signal.\nManual verification of this item is required.";

	}

	// Publish the terminal state to the scheduler.
	task.batch_done = true;
}

add_tools(agt)
{
	agt.add_tool(
		"fork",
		"Fork yourself to save on context and on deterministic steps.\nThis creates copies of the current conversation and runs separate agents to work on different things in parallel.\nMake sure to tell your siblings what to do exactly so they dont continue on your path.\nYou will receive their aggregated results once they are finished.\nYour execution is paused until all forks finished.",
		[
			tasks = "&uarray(string): The tasks/messages to the siblings.",
		],
		[](agt, args)
		{		
			fork_results = [];
			
			for(i = 0; i < args.tasks.size(); i++) {
				fork_results.push_back([
					report = "Fork did not emit any reports.",
				]);
			}
		
			fork_thread = [agt, args, fork_results](task_index) {
				
				task = args.tasks[task_index];
				
				executor = agt.subagent(agt.role);
				
				if(agt.env.active_task)
					executor.env.active_task = agt.env.active_task.copy();
				
				history = agt.history().copy();
				
				//Manually build single fork tool call with result here...
				history[-1].tool_calls = [args.tool_call];
				history.push_back(
					[role = "tool", tool_call_id = args.tool_call.id, content = "forked_index: " + task_index]
				);
				
				executor.import_history(history);
				
				if(agt.on_action) {
					executor.on_action = [agt](act) {
						agt.on_action(act);
					};
				}
				
				managed _grd = agent_slot(executor, agt);

				//Stopped from above: this sibling must not start, and it is torn
				//down so nothing below it keeps generating.
				if(agt.should_stop()) {
					executor.stop();
					fork_results[task_index].report = "The fork was stopped before this sibling started.";
					return;
				}
				
				std.print("\n\n---NEW FORK---\n");
				
				try {
					prompt = "You are forked sibling number " + task_index + ".\nFocus only on the following part of the task only, then immediately finish with signal():\n\n" + task;
					executor.task(prompt);
					fork_results[task_index].report = executor.env.signal_report;
				}
				catch(e) {
					fork_results[task_index].report = "This sibling died during execution.";
				}
				
				//The parent was stopped while this sibling ran: it goes down with
				//its own subagent tree, and its output is not a report anyone reads.
				if(agt.should_stop()) {
					executor.stop();
					fork_results[task_index].report = "The fork was stopped while this sibling was running.";
				}
			};
			
			fork_threads = [];
		
			for(i = 0; i < args.tasks.size(); i++) {
				t = std.thread(fork_thread);
				t.run(i);
				fork_threads.push_back(t);
			}
			
			for(i = 0; i < fork_threads.size(); i++) {
				fork_threads[i].join();
			}
		
			std.print("--- FORK finished ---");

			if(agt.should_stop()) {
				return [
					stopped = true,
					results = fork_results,
					note = "The agent was stopped. Do not continue, end the run with signal().",
				];
			}

			return [results = fork_results];
		}
	);
	
	agt.add_tool(
		"start_task",
		"Create/delegate work, 'effort' defines the reasoning effort. Very complex tasks: high, easy or clearly defined tasks: medium, Single quick instant actions: low.",
		[
			name = "&string(): Name of the task",
			goal = "&string(): Description of the task (detailed)",
			context = "&string(): Required context for the task",
			contract = "&string(): Contract for the task",
			effort = ["low", "medium", "high"],
			constraints = "string(): OPTIONAL constraints",
		],
		[](agt, args)
		{		
			env = agt.env;
			
			if(!env.tasks)
				env.tasks = [];
		
			tasks = env.tasks;
		
			executor = agt.subagent("adaptive");
			executor.set_reasoning_effort(args.effort);
		
			parent_id = "";
			if(agt.env.active_task ?? false)
				parent_id = agt.env.active_task.id;
		
			tasks.push_back([
				agent = executor,
				parent_id = parent_id,
			
				id = "task_" + std.random_hash(6),
				name = args.name,
				goal = args.goal,
				context = args.context,
				contract = args.contract,
				constraints = args.constraints,
				
				finished = false,
				finish_reason = "",
				milestones = [],
				report = "",
			]);
		
			task = tasks[-1];
			
			executor.env.active_task = task;
			
			if(agt.on_action) {
				executor.on_action = [agt](act) {
					agt.on_action(act);
				};
			}
			
			hierarchy = format_task_hierachy(
				build_task_hierachy(executor)
			);
			
			managed _grd = agent_slot(executor, agt);
			
			//A stop must end the turn: returning nothing here handed the model an
			//empty tool result and it simply kept generating.
			if(agt.should_stop()) {
				executor.stop();
				return [
					task_id = task.id,
					stopped = true,
					finish_reason = task.finish_reason,
					report = "The agent was stopped before this task started.\nDo not continue, end the run with signal().",
				];
			}
			
			std.print("\n\n---NEW TASK---\n");
			
			prompt = agent_prompt.replace([
				"[GOAL]" = args.goal,
				"[CONTEXT]" = args.context,
				"[CONTRACT]" = args.contract,
				"[CONSTRAINTS]" = args.constraints,
				"[HIERACHY]" = hierarchy,
			]);

			try {
				step_result = executor.task(prompt);
			}
			catch(e) {

			}
			
			//Stopped while the child ran: the child goes down with its own tree and
			//the parent gets a stop, not a report to continue from.
			if(agt.should_stop()) {
				executor.stop();
				return [
					task_id = task.id,
					stopped = true,
					finish_reason = task.finish_reason,
					report = "The agent was stopped while this task was running.\nDo not continue, end the run with signal().",
				];
			}
			
			if(!task.report) {
				if(!task.milestones) {
					return [
						task_id = task.id,
						finish_reason = task.finish_reason,
						report = "The task did not emit any reports, furthermore no milestones are available.\nThat means that the task might have failed or crashed during execution.\nManual verification of the task's progress is required.",
					];
				}
				
				return [
					task_id = task.id,
					finish_reason = task.finish_reason,
					report = "The task did emit any reports.\nThat means that the task might have failed or crashed during its run.\nFurther verification of the last steps and the actual tasks progress is required.",
				];
			}
			
			return [
				task_id = task.id,
				finish_reason = task.finish_reason,
				report = task.report,
			];
		}
	);
	
	agt.add_tool(
		"continue_task",
		"Continue a task run",
		[
			task_id = "&string(): ID of the task to continue",
			response = "&string(): Response for the task that issued a signal",
		],
		[](agt, args)
		{		
			env = agt.env;
			
			if(!env.tasks)
				env.tasks = [];
		
			tasks = env.tasks;
		
			task = None;
			
			for(i = 0; i < tasks.size(); i++) {
				if(tasks[i].id == args.task_id)
					task = tasks[i];
					break;
			}
		
			if(!task) {
				return "No task with the specified ID was found, cannot continue non existing task.";
			}
			
			//A stop is checked before any task state is touched: a stopped agent
			//must not resurrect a child and hand the model a fresh report.
			if(agt.should_stop()) {
				return [
					task_id = args.task_id,
					stopped = true,
					report = "The agent was stopped.\nDo not continue, end the run with signal().",
				];
			}

			executor = task.agent;
			
			task.finished = false;
			task.finish_reason = "";
			
			last_report = task.report;
			
			if(task.report) {
				if(!task.reports)
					task.reports = [];
				task.reports.push_back(task.report);
				task.report = "";
			}
			
			hierarchy = format_task_hierachy(
				build_task_hierachy(executor)
			);
			
			prompt = continue_prompt.replace([
				"[PREV]" = last_report,
				"[RESPONSE]" = args.response,
				"[GOAL]" = task.goal,
				"[CONTEXT]" = task.context,
				"[CONTRACT]" = task.contract,
				"[CONSTRAINTS]" = task.constraints,
				"[HIERACHY]" = hierarchy,
			]);
			
			managed _grd = agent_slot(executor, agt);
			
			if(agt.should_stop()) {
				executor.stop();
				return [
					task_id = task.id,
					stopped = true,
					finish_reason = task.finish_reason,
					report = "The agent was stopped before this task continued.\nDo not continue, end the run with signal().",
				];
			}
			
			try {
				step_result = executor.task(prompt);
			}
			catch(e) {
				//Todo: add fail counter
			}
			
			//Stopped while the child ran: the child goes down with its own tree.
			if(agt.should_stop()) {
				executor.stop();
				return [
					task_id = task.id,
					stopped = true,
					finish_reason = task.finish_reason,
					report = "The agent was stopped while this task was running.\nDo not continue, end the run with signal().",
				];
			}
			
			if(!task.report) {
				if(!task.milestones) {
					return [
						task_id = task.id,
						finish_reason = task.finish_reason,
						report = "The task did not emit a report, furthermore no milestones are available.\nThat means that the task might have failed or crashed during execution.\nManual verification of the task's progress is required.",
					];
				}
				
				return [
					task_id = task.id,
					finish_reason = task.finish_reason,
					report = "The task did not emit a report.\nThat means that the task might have failed or crashed after the last milestones.\nFurther verification of the last steps and the actual tasks progress is required.",
				];
			}
			
			return [
				task_id = task.id,
				finish_reason = task.finish_reason,
				report = task.report,
			];
		}
	);
	
	agt.add_tool(
		"signal",
		"Emit an event",
		[
			event = ["finished", "failed", "question"],
			report = "&string(): What to signal",
		],
		[](agt, args)
		{		
			agt.stop();
			
			if(agt.env.active_task ?? false) {
				agt.env.active_task.finished = true;
				agt.env.active_task.finish_reason = args.event;
				agt.env.active_task.report = args.report;
			}

			agt.env.signal_report = args.report;
			agt.env.signal_event = args.event;
			
			return "Signal sent, exit and wait for further instructions.";
		}
	);
	
	agt.add_tool(
		"milestone",
		"Emit a milestone to mark steps as finished.",
		[
			description = "&string(): Description of what was achieved so far",
		],
		[](agt, args)
		{		

			if(agt.env.active_task ?? false) {
				agt.env.active_task.milestones.push_back(args.description);
			}
			
			if(std.is_function(agt.on_action)) {
				agt.on_action([
					milestone = args.description,
				]);
			}
			
			return "I've made the checkpoint; continue working.";
		}
	);

	agt.add_tool(
		"file_task_batch",
		"**ONLY CALL THIS TOOL ONE AT A TIME, NOT IN PARALLEL!**\nCreate one independent agent task for every item matched by a path selector.\n\nThe agent provides the workload, the harness resolves 'target' with glob() semantics, snapshots the file list, creates and schedules one child task per matched file, manages concurrency internally, and aggregates the per-item results.\n\nPath selector semantics: an exact path matches that file, a directory path matches the files inside it, '*' matches everything within one directory level, '**' matches recursively across directory levels, and '?' matches a single character. Examples: 'src/', 'src/**/*.cpp', 'src/shaders/*.frag'. The selector is resolved once at batch creation into a fixed snapshot; files created, deleted or renamed afterwards do not become new batch items.\n\nThis is a WORKLOAD multiplier, not an action multiplier: every child owns the complete workload (inspect, implement, debug, test, verify) for its assigned item. Never describe a sequence of trivial actions in 'goal' and never enumerate the files in 'goal'; the harness tells each child which file it owns.\n\nA failure or question of one child does not affect the other children. The batch returns only after every matched item reached finished, failed or question.\n\nAn empty target is not an error.",
		[
			target = "&string(): Path selector describing the files to process (exact path, directory, '*', '**', '?'). Resolved once into a fixed snapshot.",
			goal = "&string(): The workload every child must complete for its assigned file. Describe the desired result, not a list of actions and not a list of files.",
			context = "string(): OPTIONAL context shared with every child task.",
			contract = "string(): OPTIONAL contract every child must satisfy for its assigned item.",
			constraints = "string(): OPTIONAL restrictions applying to every child (e.g. do not modify unrelated files, preserve existing behavior).",
		],
		[](agt, args)
		{
			env = agt.env;

			if(!env.tasks)
				env.tasks = [];

			tasks = env.tasks;
			// ── Target resolution: exactly once, fixed snapshot for this batch ──
			items = fileio.glob(args.target);

			if(!items)
				items = [];

			batch_id = "batch_" + std.random_hash(6);

			batch_goal = args.goal;
			batch_context = args.context ?? "";
			batch_contract = args.contract ?? "";
			batch_constraints = args.constraints ?? "";

			// ── Child creation (single threaded: the agent tree is not thread safe) ──
			children = [];

			for(i = 0; i < items.size(); i++) {
				item = items[i];

				task = batch_create_child(agt, batch_goal, batch_context, batch_contract, batch_constraints, item, batch_id);

				children.push_back(task);
			}
			
			// ── Empty target: a valid, successful batch ──
			if(!children.size()) {
				return [
					batch_id = batch_id,
					target = args.target,
					status = "BATCH finished",
					total = 0,
					finished = 0,
					failed = 0,
					questions = 0,
					results = [],
					note = "The target matched no files. This is not an error.",
				];
			}

			// Batch children use their own slot counter so that the internal
			// helper subagents of a child can still use the model_config slots.
			max_parallel = batch_max_parallel(agt);

			std.print("\n\n---NEW BATCH--- ", batch_id, " (", children.size(), " items, max parallel: ", max_parallel, ")\n");

			next_item = 0;
			batch_running = 0;

			batch_pool = [];

			batch_launch = [&next_item, &batch_running, &children, batch_pool, agt](max_parallel) {
				for(*next_item < children.size()) {

					//A stop drains the queue: nothing new is started below a stopped agent.
					if(agt.should_stop())
						break;

					if(batch_running >= max_parallel)
						break;

					batch_running++;
					task = children[*next_item];
					*next_item++;
					
					//The item by value (#521): with [&task] a thread that started after the next pass of this loop
					//ran the next item instead, so items ran twice and others never (reported as failed).
					batch_thread = std.thread([agt, task, &batch_running]() {
						batch_run_child(agt, task);
						batch_running--;
					});
					
					batch_pool.push_back(batch_thread);
					batch_thread.run();
				}
			};
			
			// ── Scheduling ──
			// Keep every slot busy: as soon as a child finishes, a pending item is started.
			batch_launch(max_parallel);
			
			for(next_item < children.size() || batch_running > 0) {
				if(agt.should_stop())
					break;
				std.sleep(25);
				batch_launch(max_parallel);
			}
			
			// ── Stop: tear the whole batch down ──
			// Every item of a batch is a child agent of this agent; a stop must
			// reach all of them, not just the one that happens to be scheduled.
			if(agt.should_stop()) {
				for(i = 0; i < children.size(); i++) {
					children[i].agent.stop();

					if(!children[i].finished) {
						children[i].finished = true;
						children[i].finish_reason = "failed";

						if(!children[i].report)
							children[i].report = "The batch was stopped by the parent agent before this item finished.";
					}
				}
			}
			
			for(i = 0; i < batch_pool.size(); i++) {
				batch_pool[i].join();
			}
			
			// ── Aggregate ──
			total = children.size();
			finished = 0;
			failed = 0;
			questions = 0;

			results = [];

			for(i = 0; i < children.size(); i++) {
				task = children[i];

				status = task.finish_reason;
				if(!status)
					status = "failed";

				if(status == "finished")
					finished++;
				else if(status == "question")
					questions++;
				else
					failed++;

				report = task.report ?? "";
				if(report.size() > batch_report_max_chars)
					report = report.substr(0, batch_report_max_chars) + "\n...[report truncated]...";

				results.push_back([
					item = task.assigned_item,
					task_id = task.id,
					status = status,
					report = report,
				]);
			}

			batch_status = "BATCH finished";

			if(agt.should_stop())
				batch_status = "BATCH stopped";

			result = [
				batch_id = batch_id,
				target = args.target,
				status = batch_status,
				total = total,
				finished = finished,
				failed = failed,
				questions = questions,
				results = results,
			];

			if(agt.should_stop()) {
				result.stopped = true;
				result.note = "The agent was stopped and the batch was torn down.\nDo not continue, end the run with signal().";
			}

			return result;
		}
	);

	agt.add_read_tools();
	agt.add_code_read_tools();
	agt.add_write_tools();
	agt.add_skill_tools();
	agt.add_share_tools();
	agt.add_command_tools();
}