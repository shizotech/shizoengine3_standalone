
// ═════════════════════════════════════════════════════════════════════════════
//  Role: Router  (router_api.md §"Router role surface")
//
//  The router agent of a gateway: for each message it decides which node and
//  which workspace own it, starts the work there as a worker session
//  (start_task) or passes the message into the session of an existing task
//  (update_task — a task is a thread, a finished one can be continued), and
//  reports what it did. Deliberately NOT registered: file, write, command, skill,
//  search or task-execution tools. The router cannot investigate, plan or
//  execute — the boundary is enforced by the runtime, not by prompt wording.
//
//  There is no agent on the node between the router and the worker any more
//  (the node's receptionist is gone): the request reaches the worker in the
//  user's own words (Router.turn_text), not as the paraphrase of a paraphrase.
//
//  Every tool call goes through the contracted Router methods only
//  (nodes_summary, node_overview, tasks_summary, add_task, update_task, stop_task,
//  inspect_task, notify_user) and returns immediately. Node events (task
//  finished / failed / question, notify, file) arrive later and are forwarded
//  to the owner by the host — nothing here polls, waits or blocks.
// ═════════════════════════════════════════════════════════════════════════════

ROUTER_NO_ROUTER = "No Router instance is attached to this agent (agt.env.router is empty).\nNothing can be routed. This is a host setup error: report it to the user and finish the turn.";

// The shared action ring buffer (Router.last_actions is aliased into env by router_api.shio)
router_actions(agt) {
	if(!agt.env.last_actions) {
		agt.env.last_actions = [];
	}
	return agt.env.last_actions;
}

// node names of the online nodes, straight from router.nodes_summary()
router_node_names(router) {
	names = [];

	if(!router) {
		return names;
	}

	summary = None;
	try {
		summary = router.nodes_summary();
	}
	catch(e) {
		summary = None;
	}

	if(!std.is_json(summary)) {
		return names;
	}

	for(i = 0; i < summary.size(); i++) {
		n = summary[i];
		if(std.is_json(n) && n.has("name") && n.name) {
			names.push_back(std.string(n.name));
		}
	}

	return names;
}

// canonical node name for a (case-insensitive) request, None if there is no such node
router_match_node(router, node) {
	want = std.string(node).strip().lowercase();
	names = router_node_names(router);

	for(i = 0; i < names.size(); i++) {
		if(names[i].lowercase() == want) {
			return names[i];
		}
	}

	return None;
}

router_node_hint(router) {
	names = router_node_names(router);

	if(!names.size()) {
		return "No AI node is online right now. Call get_nodes() to re-check. Never invent a node name.";
	}

	list = "";
	for(i = 0; i < names.size(); i++) {
		list += names[i];
		if(i + 1 < names.size()) {
			list += ", ";
		}
	}

	return "Valid node names: " + list + ". Pick exactly one of them (see get_nodes()).";
}

// The concrete reason of the last Router.add_task() failure (Router.add_task_error,
// router_api.md). Defensive: a host without that method (older Router, test stub)
// gives "" and the caller keeps its generic wording.
router_add_task_error(router) {
	why = "";

	if(!router) {
		return why;
	}

	try {
		reason = router.add_task_error();
		if(reason) {
			why = std.string(reason).strip();
		}
	}
	catch(e) {
		why = "";
	}

	return why;
}

// the user's own words of the current turn (Router.turn_text), "" when the host set none
router_turn_text(router) {
	txt = "";

	if(!router) {
		return txt;
	}

	try {
		txt = std.string(router.turn_text ?? "").strip();
	}
	catch(e) {
		txt = "";
	}

	return txt;
}

// the reason of the last Router.update_task() failure ("" when the host has none)
router_update_task_error(router) {
	why = "";

	if(!router) {
		return why;
	}

	try {
		why = std.string(router.update_task_error() ?? "").strip();
	}
	catch(e) {
		why = "";
	}

	return why;
}

// "name (id), name (id)": the workspaces a node published, "" when it published none
router_workspace_hint(router, node) {
	out = "";

	try {
		for(n : router.nodes_summary()) {
			if(std.string(n.name) != std.string(node) || !std.is_json(n.workspaces)) {
				continue;
			}
			for(w : n.workspaces) {
				out += (out ? ", " : "") + std.string(w.name ? w.name : w.id);
			}
		}
	}
	catch(e) {
		out = "";
	}

	return out;
}

// Does the node run a goal scheduler? true / false / None (None = the node did not
// report the field: an older node, so nothing is claimed about it).
router_node_goals(router, node) {
	if(!router || !node) {
		return None;
	}

	summary = None;
	try {
		summary = router.nodes_summary();
	}
	catch(e) {
		summary = None;
	}

	if(!std.is_json(summary)) {
		return None;
	}

	for(i = 0; i < summary.size(); i++) {
		n = summary[i];
		if(std.is_json(n) && n.has("name") && std.string(n.name) == std.string(node) && n.has("goals")) {
			return n.goals ? true : false;
		}
	}

	return None;
}

add_tools(agt)
{
	agt.add_tool(
		"get_nodes",
		"The routing table: every online AI node with name, description, model, load, open tasks, 'goals' (does this node run a goal scheduler, i.e. can it do work at set times?) and its 'workspaces' (id, name, description) - the places work can go to.\nRead-only. Use it to pick the node AND the workspace for new work.\nDo not call it repeatedly to watch progress: node events arrive later as system events.",
		None,
		[](agt, args)
		{
			if(!agt.env.router) {
				return ROUTER_NO_ROUTER;
			}

			res = None;
			try {
				res = agt.env.router.nodes_summary();
			}
			catch(e) {
				return "The router could not read the node table: " + std.string(e);
			}

			if(std.is_json(res) && !res.size()) {
				return "No AI node is online. Nothing can be routed right now. Tell the user; do not invent a node.";
			}

			return res;
		}
	);

	agt.add_tool(
		"get_node_overview",
		"Live overview of ONE node: its tasks and their states, as the node reports them.\nRead-only. Use it to find the task a user is referring to on a specific node.\n'node' must be a node name exactly as listed by get_nodes.",
		[
			node = "&string(): The node name, taken from get_nodes.",
		],
		[](agt, args)
		{
			if(!agt.env.router) {
				return ROUTER_NO_ROUTER;
			}

			node = router_match_node(agt.env.router, args.node);

			if(!node) {
				return "Unknown node: '" + std.string(args.node) + "'. " + router_node_hint(agt.env.router);
			}

			res = None;
			try {
				res = agt.env.router.node_overview(node);
			}
			catch(e) {
				return "The node '" + node + "' did not answer the overview request: " + std.string(e);
			}

			return res;
		}
	);

	agt.add_tool(
		"get_tasks",
		"List the routed tasks (threads) of the WHOLE fleet from the router's own task mirror: thread, taskid, node, workspace, name, state, turn, goal, last message, report, times.\nRead-only. Use it to answer 'what is running?' across all nodes and to find the task a message belongs to (inspect_task / update_task / stop_task take its thread label or taskid).\n'state' filters: open (queued + running), finished, failed, stopped, lost, question, all (default). 'node' restricts the list to one node name from get_nodes.\nDo not call it repeatedly to watch progress: node events arrive later as system events.",
		[
			state = "string(): OPTIONAL state filter: open | finished | failed | stopped | lost | question | all.",
			node = "string(): OPTIONAL node name, exactly as listed by get_nodes.",
		],
		[](agt, args)
		{
			if(!agt.env.router) {
				return ROUTER_NO_ROUTER;
			}

			res = None;
			try {
				res = agt.env.router.tasks_summary(args.state, args.node);
			}
			catch(e) {
				return "The router could not read its task table: " + std.string(e);
			}

			if(std.is_json(res) && !res.size()) {
				return "No routed tasks" + ((args.state ?? false) ? " in state '" + std.string(args.state) + "'" : "") + ((args.node ?? false) ? " on node '" + std.string(args.node) + "'" : "") + ". The router's task mirror is empty for that filter; do not invent a taskid.";
			}

			return res;
		}
	);

	agt.add_tool(
		"get_goals",
		"The scheduled goals (autonomous work at set times) of every node, or of one node: id, title, status, schedule, next window, last outcome.\nRead-only. Requests that create or change a schedule are routed with start_task to the node and workspace that should do the work; the worker there creates the goal.",
		[
			node = "string(): OPTIONAL node name from get_nodes (all nodes otherwise)",
		],
		[](agt, args)
		{
			if(!agt.env.router) {
				return ROUTER_NO_ROUTER;
			}

			node = "";
			if(args.has("node") && args.node) {
				node = router_match_node(agt.env.router, args.node);
				if(!node) {
					return "Unknown node: '" + std.string(args.node) + "'. " + router_node_hint(agt.env.router);
				}
			}

			res = None;
			try {
				res = agt.env.router.goals(node);
			}
			catch(e) {
				return "The goal request failed: " + std.string(e);
			}

			return res;
		}
	);

	agt.add_tool(
		"start_task",
		"Start NEW work: a worker session in one workspace of one node. Use it only for work that does not belong to an existing task (a follow-up, a correction or an answer goes to update_task).\n'node' and 'workspace' must be names from get_nodes / the context - never invent one. Work that belongs to no project goes to the workspace 'General' (also when 'workspace' is left out). If you cannot tell which workspace is meant, do NOT call this tool: ask the user with finish(report).\nThe worker gets the user's message verbatim (with attached files) unless 'task' is given: pass 'task' only when the message mixes several things, then pass exactly the part for this task, in the user's words.\nReturns promptly with the thread label, the task name, the node and the workspace. The work is NOT done when the call returns and you must not wait for it: completion arrives later as an event.\nScheduled work ('tonight', 'every Sunday') needs a node with goals=true.\nWhen the node refuses, this answer carries the concrete reason: relay that reason verbatim in finish(report).",
		[
			node = "&string(): Target node name, exactly as listed by get_nodes.",
			name = "&string(): Short task name, two or three words (like 'Login-Button').",
			workspace = "string(): OPTIONAL workspace name or id on that node, as listed by get_nodes. Left out: the node's 'General' workspace.",
			task = "string(): OPTIONAL the text for the worker. Left out: the user's message, verbatim.",
			summary = "string(): OPTIONAL one line about the task for the action log.",
		],
		[](agt, args)
		{
			if(!agt.env.router) {
				return ROUTER_NO_ROUTER;
			}

			node = router_match_node(agt.env.router, args.node);

			if(!node) {
				return "Unknown node: '" + std.string(args.node) + "'. " + router_node_hint(agt.env.router) + "\nNo task was routed.";
			}

			actions = router_actions(agt);

			task_text = std.string(args.task ?? "").strip();

			if(!task_text) {
				task_text = router_turn_text(agt.env.router);
			}

			if(!task_text) {
				return "No task text: pass 'task' with the user's request. No task was routed.";
			}

			workspace = std.string(args.workspace ?? "").strip();
			taskname = std.string(args.name).strip() + "-" + std.random_hash(6);

			taskid = None;
			try {
				taskid = agt.env.router.add_task(taskname, task_text, node, "worker", workspace);
			}
			catch(e) {
				taskid = None;
			}

			if(!taskid) {
				why = router_add_task_error(agt.env.router);

				if(why) {
					return "The task was NOT started. Reason: " + why + "\nPut that reason into finish(report) so the user knows why; do not claim the task is running.";
				}

				return "The node '" + node + "' did not accept the task (offline, unreachable or it refused).\nNo task was created. Report that to the user; do not claim the task is running.";
			}

			// what the mirror made of it: the thread label and the workspace name
			thread = "";
			where = workspace;
			try {
				info = agt.env.router.inspect_task(std.string(taskid));
				if(std.is_json(info)) {
					thread = std.string(info.thread ?? "");
					where = std.string(info.workspace_name ?? info.workspace ?? workspace);
				}
			}
			catch(e) {}

			//upside down for easier handling
			actions.insert(0, [
				action="start_task",
				node=node,
				workspace=where,
				thread=thread,
				name=taskname,
				summary=std.string(args.summary ?? ""),
				taskid=std.string(taskid),
			]);

			suggestion = "Tell the user the thread label, the workspace and the node; the result arrives later as its own message.";
			goals = router_node_goals(agt.env.router, node);

			if(goals === false) {
				suggestion += " This node has no goal system (goals=false): if the user asked for work at set times, say in finish(report) that this node cannot schedule it.";
			}

			return [thread=thread, taskid=std.string(taskid), name=taskname, node=node, workspace=where, suggestion=suggestion];
		}
	);

	agt.add_tool(
		"update_task",
		"Send a message into an EXISTING task: a follow-up, a correction, an addition, the answer to a question the task asked. The worker of that task has the whole conversation, so the message needs no explanation.\nWorks while the task runs (the message is injected into its turn) and after it has finished, failed, stopped or asked a question (the same session starts a new turn).\n'task' is the thread label (like T12) from the context / get_tasks, or a taskid.\nThe worker gets the user's message verbatim unless 'message' is given.\nReturns promptly; the result of the turn arrives later as an event. When the node refuses, the answer carries the reason: relay it.",
		[
			taskid = "&string(): The task: its thread label (T12) or taskid, from the context or get_tasks.",
			message = "string(): OPTIONAL the text for the worker. Left out: the user's message, verbatim.",
		],
		[](agt, args)
		{
			if(!agt.env.router) {
				return ROUTER_NO_ROUTER;
			}

			actions = router_actions(agt);

			msg = std.string(args.message ?? "").strip();

			if(!msg) {
				msg = router_turn_text(agt.env.router);
			}

			if(!msg) {
				return "No message text: pass 'message' with the user's words.";
			}

			ok = false;
			try {
				ok = agt.env.router.update_task(args.taskid, msg);
			}
			catch(e) {
				ok = false;
			}

			if(!ok) {
				why = router_update_task_error(agt.env.router);

				if(why) {
					return "The message was NOT delivered. Reason: " + why + "\nIf the task cannot be continued, start new work with start_task and say so; otherwise put the reason into finish(report).";
				}

				return "The task does not exist, or its node is offline / has no update channel for it.\nThe message was not delivered. If the work should go on, start a new task.";
			}

			//upside down for easier handling
			actions.insert(0, [
				action="update_task",
				message=msg.length() > 300 ? msg.substr(0, 300) + "..." : msg,
				taskid=std.string(args.taskid),
			]);

			return "OK - the message is in the task's conversation. Tell the user which task took it.";
		}
	);

	agt.add_tool(
		"stop_task",
		"Requests that a routed task on its node stops its work.\nReports only what the node confirmed: a confirmed stop is not the same as a stop request.",
		[
			taskid = "&string(): The task: its thread label (T12) or taskid, from the context or get_tasks.",
		reason = "string(): OPTIONAL short reason, kept in the router's task record.",
		],
		[](agt, args)
		{
			if(!agt.env.router) {
				return ROUTER_NO_ROUTER;
			}

			actions = router_actions(agt);

			ok = false;
			try {
				ok = agt.env.router.stop_task(args.taskid);
			}
			catch(e) {
				ok = false;
			}

			if(!ok) {
				return "The task does not exist anymore, is already finished, or its node did not confirm the stop.\nDo not claim it has stopped.";
			}

			//upside down for easier handling
			actions.insert(0, [
				action="stop_task",
				reason=args.reason,
				taskid=std.string(args.taskid),
			]);

			return "OK";
		}
	);

	agt.add_tool(
		"inspect_task",
		"Inspect one routed task: its mirrored state on the router (state, report, the turns of its thread) plus, when its node answers, the live remote task record.\nRead-only. Never call it repeatedly to watch progress: node events arrive later as system events.",
		[
			taskid = "&string(): The task: its thread label (T12) or taskid, from the context or get_tasks.",
		],
		[](agt, args)
		{
			if(!agt.env.router) {
				return ROUTER_NO_ROUTER;
			}

			res = None;
			try {
				res = agt.env.router.inspect_task(args.taskid);
			}
			catch(e) {
				return "The task could not be inspected: " + std.string(e);
			}

			return res;
		}
	);

	agt.add_tool(
		"get_last_actions",
		"Retrieve the compressed list of this router's recent actions, newest first: the user's recent messages (action 'user_message', from the chat front end), your routing actions and your turn reports.\nUse it to resolve follow-ups and corrections such as 'make it 6am instead', 'do that again' or 'the one from before' when the current message does not identify the work on its own.\nIt identifies the action, its taskid and its node; it is not a historical search and it contains no implementation logs.",
		[
			limit = "int(1,100): OPTIONAL number of recent actions to return (default 20)",
		],
		[](agt, args)
		{
			limit = (args.limit ?? false) ? args.limit : 20;

			actions = router_actions(agt).copy();

			//the ring is newest-first already, and resize() keeps the leading
			//(= newest) entries, so it only ever shrinks towards the request.
			if(actions.size() > limit) {
				actions.resize(limit);
			}

			return actions;
		}
	);

	agt.add_tool(
		"notify",
		"Send a notification to the user/owner (the router forwards it to telegram, CLI or web).",
		[
			message = "&string(): The message (short and snappy)",
		],
		[](agt, args)
		{
			if(!agt.env.router) {
				return ROUTER_NO_ROUTER;
			}

			actions = router_actions(agt);

			//upside down for easier handling
			actions.insert(0, [
				action="notify",
				message=args.message,
			]);

			try {
				agt.env.router.notify_user(args.message);
			}
			catch(e) {
				return "The notification could not be sent: " + std.string(e);
			}

			return "OK";
		}
	);

	agt.add_tool(
		"finish",
		"End the turn and report back to the owner. Every turn ends with this call - routing, listing, answering a question, all of it.\n'report' is the text the owner (telegram, CLI, web) shows the user verbatim: answer what they asked, do not just say 'done'. An empty report is refused.",
		[
			report = "&string(): The answer for the user: what was routed (task name + node) or the answer to their question. Never empty.",
		],
		[](agt, args)
		{
			actions = router_actions(agt);

			rep = std.string(args.report).strip();

			if(!rep) {
				return "The report must not be empty - the owner shows exactly this text to the user. Write the answer to the user's request and call finish(report) again.";
			}

			// The report IS the turn result the host shows: finalize_run() sets
			// the router agent's task_result, which Router uses as the answer.
			agt.finalize_run("finished", rep, true);

			//upside down for easier handling
			actions.insert(0, [
				action="turn_report",
				report=rep,
			]);

			return "OK";
		}
	);
}
