
add_tools(agt)
{
	agt.add_tool(
		"finalize",
		"Exit / Terminate execution.",
		[
			symbol_definition = "&string(): Full declaration-only code skeleton of the resolved symbol, including line mappings.",
			symbol_path = "&string(): The path to the file containing the symbol.",
		],
		[](agt, args)
		{
			//The resolved symbol is the task_result; SHARED reads it instead of env.
			agt.finalize_run("finished", [
				symbol_definition = args.symbol_definition,
				symbol_path = args.symbol_path,
			], true);

			return "Stop now.";
		}
	);

	agt.add_read_tools();
	agt.add_skill_tools();
}