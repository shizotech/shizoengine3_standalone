
// ═════════════════════════════════════════════════════════════════════════════
//  Role: Receptionist  (plan §4)
//
//  A thin, non-blocking router. Exactly the five coordination tools of §4.1
//  exist on this role. Deliberately NOT registered: file, write, command, skill,
//  search, taskroute, Worker or task-execution tools. The Receptionist cannot
//  investigate, plan or execute, because it has no tools to do it with —
//  the boundary is enforced by the runtime, not by prompt wording (§8).
//
//  Every tool call only writes durable runtime state and returns immediately.
//  Mind invocations happen in the dispatcher thread (runtime/mind_dispatcher).
// ═════════════════════════════════════════════════════════════════════════════

reverse_list(list) {
	res = [];
	for(i = list.size()-1; i >= 0; i--) {
		res.push_back(list[i]);
	}
	return res;
}

add_tools(agt)
{
	agt.add_tool(
		"get_overview",
		"Inspect the current system state: all Tasks and their lifecycle states.\nRead-only. Use it to identify the owner of existing work or to disambiguate a reference.\nThis call never wakes, invokes or runs a Mind, and it does not start anything.\nDo not call it repeatedly to watch progress: completion and failure arrive later as system events.",
		None,
		[](agt, args)
		{
			return agt.env.mind.get_overview();
		}
	);

	agt.add_tool(
		"get_last_actions",
		"Retrieve the compressed list of recent actions, newest first.\nUse it ONLY to resolve references such as 'do that again' or 'the one from before' when the current context does not already identify the action.\nIt identifies the action and its target Mind; it is not a historical search and it contains no implementation logs.",
		[
			limit = "int(1,100): OPTIONAL number of recent actions to return (default 20)",
		],
		[](agt, args)
		{
			limit = (args.limit ?? false) ? args.limit : 20;
			
			if(!agt.env.last_actions)
				agt.env.last_actions = [];
			
			actions = agt.env.last_actions.copy();
			actions.resize(limit);
			
			return reverse_list(actions);
		}
	);

	agt.add_tool(
		"start_task",
		"Create a task for a new substantive goal.\nForward the user's intent as given: do NOT pre-validate feasibility, do NOT research the task, do NOT inspect the repository first. The Mind investigates, plans, executes and reports.\nReturns promptly with a stable Mind ID and the confirmed creation state. The goal is NOT executed by this call and you must not wait for it.",
		[
			task = "&string(): Repeat the user's intention word-by-word.",
			summary = "&string(): Short summary of the task.",
		],
		[](agt, args)
		{
			if(!agt.env.last_actions)
				agt.env.last_actions = [];

			actions = agt.env.last_actions;
			
			taskid = agt.env.mind.add_task(args.task);
			
			//upside down for easier handling
			actions.insert(0, [
				action="start_task",
				summary=args.summary,
				taskid=taskid,
			]);

			return [taskid=taskid];
		}
	);

	agt.add_tool(
		"stop_task",
		"Stops a task immediately.",
		[
			taskid = "&string(): The taskid to stop.",
			reason = "string(): OPTIONAL short reason, forwarded to the Mind's record.",
		],
		[](agt, args)
		{
			if(!agt.env.last_actions)
				agt.env.last_actions = [];

			actions = agt.env.last_actions;
			
			taskid = args.taskid;
			
			agt.env.mind.stop_task(taskid);
			
			//upside down for easier handling
			actions.insert(0, [
				action="stop_task",
				reason=args.reason,
				taskid=taskid,
			]);

			return "OK";
		}
	);

	agt.add_tool(
		"update_task",
		"Forward a follow-up instruction, clarification or answer to an existing task.\n'relaxed' waits till the task has reached a safe checkpoint before the update is processed, 'urgent' interrupts the task and sends the message instantly.",
		[
			taskid = "&string(): The target Mind, taken from the current context or from get_overview.",
			message = "&string(): The instruction or answer to forward, phrased for the Mind that owns the goal.",
			kind = ["relaxed", "urgent"],
		],
		[](agt, args)
		{
			if(!agt.env.last_actions)
				agt.env.last_actions = [];

			actions = agt.env.last_actions;
			
			taskid = args.taskid;
			
			agt.env.mind.update_task(taskid, args.message, args.kind == "urgent");
			
			//upside down for easier handling
			actions.insert(0, [
				action="update_task",
				message=args.message,
				kind=args.kind,
				taskid=taskid,
			]);

			return "OK";
		}
	);
	
	agt.add_tool(
		"finish",
		"Finish the turn and exit.",
		[
			summary = "&string(): Summary of the current turn.",
		],
		[](agt, args)
		{
			if(!agt.env.last_actions)
				agt.env.last_actions = [];

			actions = agt.env.last_actions;
			
			//upside down for easier handling
			actions.insert(0, [
				action="turn_summary",
				summary=args.summary,
			]);
			
			agt.stop();
			return "OK";
		}
	);
}
