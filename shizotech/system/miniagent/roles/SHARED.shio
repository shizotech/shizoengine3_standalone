
import subprocess;

class local_file_lock
{
	path = "";
	local_files = None;
	
	__init__(path) {
		this.path = path;
		this.local_files = std.global("local_files");
		
		if(!local_files.locks)
			local_files.locks = [ticketid=0, current=0];
		
		ticketid = local_files.locks[path].ticketid;
		local_files.locks[path].ticketid++;
		
		for(local_files.locks[path].current != ticketid) {
			std.sleep(10);
		}
	}
	
	__deinit__() {
		local_files.locks[path].current++;
	}
}

agt_add_read_tools(agt) {

	agt.add_tool(
		"list_dir",
		"FILE OPERATION - Query files in the current directory",
		[
			path = "&string(): Path to query, use '.' for the current working directory",
			recursive = ["true", "false"],
		],
		[](agt, args)
		{
			if(args.path.starts("/"))
				return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
			
			fs = agt.filesystem;

			args.path = args.path.removesuffix("/");
		
			if(!fs.exists(args.path))
				return "The directory does not exist.";
		
			dirs = fs.dirs(args.path, args.recursive == "true"); 
			files = fs.files(args.path, args.recursive == "true"); //Filter out large log files and other stuff
			
			dirs_cleaned = [];
			files_cleaned = [];
			
			//Filter out logfiles
			for(i = 0; i < dirs.size(); i++) {
				//Kind of obsolete, also make the model know that there is a git folder, unless recursive
				
				if(dirs[i].contains(".git") && args.recursive == "true")
					continue;
				
				//if(dirs[i].contains(".agent") || dirs[i].contains(".backup") || dirs[i].contains(".git"))
				//	continue;
				dirs_cleaned.push_back(dirs[i]);
			}
			for(i = 0; i < files.size(); i++) {		
				//if(files[i].contains(".agent") || files[i].contains(".backup") || files[i].contains(".git"))
				//	continue;
				files_cleaned[files[i]] = [size=fs.size(args.path + "/" + files[i])];
			}
			
			truncated = false;
			total_files = files_cleaned.size();
			total_dirs = dirs_cleaned.size();
			
			if(args.recursive == "true") {
				for(files_cleaned.size() > 50) {
					files_cleaned.erase(files_cleaned.size()-1);
					truncated = true;
				}
				for(dirs_cleaned.size() > 50) {
					dirs_cleaned.erase(dirs_cleaned.size()-1);
					truncated = true;
				}
			}
			//Todo: find reasonable limits for non-recursive
			
			has_files = files_cleaned ? "true" : "false";
			has_dirs = dirs_cleaned ? "true" : "false";
			
			result = [
				has_files = has_files,
				has_directories = has_dirs,
				total_files = total_files,
				total_dirs = total_dirs,
				dirs = dirs_cleaned,
				files = files_cleaned,
			];
			
			if(truncated)
				result.truncation_warning = "Warning: file list was truncated due to too many entries.";
			
			return result;
		}
	);

	agt.add_tool(
	  "file_info",
	  "FILE OPERATION - Get file info",
	  [
		path = "&string(): Target file",
	  ],
	  [](agt, args)
	  {
		if(args.path.starts("/"))
		  return "Invalid path specified. Use './path/to/file' instead of absolute paths.";

		fs = agt.filesystem;

		return fs.file_info(args.path);
	  }
	);
	
	agt.add_tool(
	  "file_line_count",
	  "FILE OPERATION - Get file line count",
	  [
		path = "&string(): Target file",
	  ],
	  [](agt, args)
	  {
		if(args.path.starts("/"))
		  return "Invalid path specified. Use './path/to/file' instead of absolute paths.";

		fs = agt.filesystem;
	
		return fs.read_string(args.path).count("\n") + 1;
	  }
	);

	agt.add_tool(
	  "read_file",
	  "FILE OPERATION - Read raw file content",
	  [
		path = "&string(): Target file",
		include_line_numbers = ["true", "false"],
		start_line = "int(1): OPTIONAL start line",
		end_line = "int(1): OPTIONAL end line"
	  ],
	  [](agt, args)
	  {
		if(args.path.starts("/"))
		  return "Invalid path specified. Use './path/to/file' instead of absolute paths.";
		
		managed _lock = local_file_lock(args.path);
		
		fs = agt.filesystem;
		
		if(!fs.exists(args.path)) {
		  return [
			ok = false,
			error = "file doesnt exist"
		  ];
		}
		
		txt = fs.read_text(args.path);
		
		if(!txt) {
		  return [
			ok = true,
			status = "file is empty"
		  ];
		}

		txt = txt.replace("\r\n", "\n").replace("\r", "\n");

		has_line_numbers = args.include_line_numbers != "false";
		has_line_start = args.start_line ?? false;
		has_line_end = args.end_line ?? false;

		if(has_line_numbers || has_line_start || has_line_end) {

		  lines = txt.split("\n");
		  txt = "";

		  for(i = 0; i < lines.size(); i++) {

			if(has_line_start && (i+1) < args.start_line)
			  continue;

			if(has_line_end && (i+1) > args.end_line)
			  continue;

			if(has_line_numbers)
			  txt += (i+1) + "| ";

			txt += lines[i] + "\n";
		  }
		}
		
		num_lines = txt.count("\n") + 1;

		if(num_lines > 10000) {
			return [
			  ok = false,
			  error = "File is too big to be read at whole.",
		    ];
		}

		return [
		  ok = true,
		  content = txt
		];
	  }
	);
}

agt_add_code_read_tools(agt) {
	
	//Disabled, because these take too long with big models, enable again with a secondary smaller model...
	return;
	
	agt.add_tool(
	  "search_in_file",
	  "FILE OPERATION - Extract relevant parts of a file based on a natural language instructions\nNote: use return_format: 'signatures' for a compressed class/function overview without concrete implementation details or function bodies",
	  [
		path = "&string(): Target file",

		look_for = "string(): What to find or extract from the file",

		return_format = ["exact", "context", "structured", "summary", "signatures"],
		
		include_line_numbers = ["true", "false"],
	  ],
	  [](agt, args)
	  {
		if(args.path.starts("/"))
		  return "Invalid path specified. Use './path/to/file'.";
	
		fs = agt.filesystem;
	
		managed _lock = local_file_lock(args.path);
		
		if(!fs.exists(args.path)) {
		  return [
			ok = false,
			error = "file doesnt exist"
		  ];
		}
		txt = fs.read_text(args.path);
	
		if(!txt) {
		  return [
			ok = true,
			status = "file is empty"
		  ];
		}

		txt = txt.replace("\r\n", "\n").replace("\r", "\n");

		has_line_numbers = args.include_line_numbers != "false";

		lines = txt.split("\n");
		txt = "";

		if(lines.size() > 50000)
			std.error("File is being truncated");

		for(lines.size() > 50000) {
			lines.erase(lines.size()-1);
		}
		
		if(has_line_numbers) {
			for(i = 0; i < lines.size(); i++) {
				txt += (i+1) + " ";
				txt += lines[i] + "\n";
			}
		}

		managed search_agt = agt.subagent("util/filereader", true);

		prompt =
		  "<FILE>\n" + txt + "\n</FILE>\n\n" +
		  "<INSTRUCTION>\n" + args.look_for + "\n</INSTRUCTION>\n\n" +
		  "<RETURN_FORMAT>\n" + args.return_format + "\n</RETURN_FORMAT>";
		  
		if(has_line_numbers) {
			prompt += "\n\nInclude line numbers for any text from the file in your response.";
		}
		
		if(args.return_format == "signatures") {
			prompt += "\nReturn a signatures-only version of any functions/classes you may find and omit concrete implementation details and function bodies.\nInclude return and parameter types and other function signature data only";
		}

		res = search_agt.single_task(prompt);

		return [
		  ok = true,
		  content = res
		];
	  }
	);
	
	agt.add_tool(
		"resolve_symbol",
		"FILE OPERATION - Resolve functions/classes/variables across the entire codebase",
		[
			symbols = "&array(string): List of symbols to resolve",
			source_file = "string(): OPTIONAL Which source file the search should initially start from, to make it easier to find the symbol",
		],
		[](agt, args)
		{			
			fs = agt.filesystem;
		
			//Implement caching if source of symbol has not changed !
		
			local_files = std.global("local_files");

			if(!local_files.symbol_maps)
				local_files.symbol_maps = [];
			
			resolved_symbols = [];
			
			resolve_thread = [agt, &resolved_symbols, &local_files](symbol, source_file) {
				managed search_agt = agt.subagent("util/symbol_resolver", true);
				agent_prompt = "<symbol_name>" + symbol + "</symbol_name>";
				if(source_file)
					agent_prompt = "\n<source_file>" + source_file + "</source_file>";		
				
				search_agt.single_task(agent_prompt);
				
				resolved_symbols[symbol] = [
					definition = search_agt.env.symbol_definition,
					path = search_agt.env.symbol_path,
				];
				
				if(search_agt.env.symbol_path) {			
					local_files.symbol_maps[symbol] = [
						path = search_agt.env.symbol_path,
						hash = fileio.hash(search_agt.env.symbol_path),
						content = [
							definition = search_agt.env.symbol_definition,
							path = search_agt.env.symbol_path,
						]
					];
				}
			}
			
			rt = std.thread(resolve_thread);
			
			for(i = 0; i < args.symbols.size(); i++) {
				symbol = args.symbols[i];
				if(local_files.symbol_maps.has(symbol)) {
					cached_symbol = &local_files.symbol_maps[symbol];
					fh = fileio.hash(cached_symbol.path);
					if(cached_symbol.hash == fh) {
						resolved_symbols[symbol] = cached_symbol.content;
						continue;
					}
				}
				
				rt.run(symbol, args.source_file);
			}	
		
			rt.join();
			
			return resolved_symbols;
		}
	);

	agt.add_tool(
	  "read_source_map",
	  "FILE OPERATION - Read a source file of any kind as a skeleton overview with all classes and functions and their locations in the text file, without concrete implementation details\nALWAYS prefer this function over reading entire source files when possible.\nDO NOT use this function on non-programming or non-structured regular text files.",
	  [
		path = "&string(): Target file",
	  ],
	  [](agt, args)
	  {
		if(args.path.starts("/"))
		  return "Invalid path specified. Use './path/to/file' instead of absolute paths.";

		fs = agt.filesystem;

		managed _lock = local_file_lock(args.path);
		
		if(!fs.exists(args.path)) {
		  return [
			ok = false,
			error = "file doesnt exist"
		  ];
		}
		txt = fs.read_text(args.path);

		if(!txt) {
		  return [
			ok = true,
			status = "file is empty"
		  ];
		}

		txt = txt.replace("\r\n", "\n").replace("\r", "\n");

		lines = txt.split("\n");
		txt = "";

		for(i = 0; i < lines.size(); i++) {
			txt += (i+1) + " ";
			txt += lines[i] + "\n";
		}
			
		num_lines = txt.count("\n") + 1;

		if(num_lines > 30000) {
			return [
			  ok = false,
			  error = "File is too big for this operation.",
			];
		}
		
		local_files = std.global("local_files");

		if(!local_files.source_maps)
			local_files.source_maps = [];

		//Cache source maps each run...
		if(local_files.source_maps.has(args.path)) {
			fh = fileio.hash(args.path);
			if(local_files.source_maps[args.path].hash == fh) {
				return [
				  ok = true,
				  content = local_files.source_maps[args.path].content,
				];
			}
		}
		
		managed search_agt = agt.subagent("util/source_mapper", true);

		txt = search_agt.single_task(txt);

		if(!txt) {
		  return [
			ok = false,
			error = "Cannot create source map for this file."
		  ];
		}

		local_files.source_maps[args.path] = [
			hash = fileio.hash(args.path),
			content = txt,
		];
		
		//std.print(txt);
		
		return [
		  ok = true,
		  content = txt,
		];
	  }
	);
}

agt_add_write_tools(agt) {
	agt.add_tool(
		"write_file",
		"FILE OPERATION - Create a new file.",
		[
			path = "&string(): Target file",
			content = "&string(): Content of the new file",
		],
		[](agt, args)
		{
			if(args.path.starts("/")) {
				return [
					ok = false,
					error = "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !",
				];
			}
			
			fs = agt.filesystem;
			
			managed _lock = local_file_lock(args.path);
			
			if(!fs.empty(args.path)) {
				return [
					ok = false,
					error = "The file exists and is not empty.",
					next_steps = "Prefer to use 'replace_string' to make precise edits to files rather than rewriting the entire file from scratch.\nIf you are absolutely sure you want to overwrite the entire file (not recommended) because it is necessary, use 'remove' to remove the file first, then call this tool again.",
				];
			}
			
			file_content = args.content;
		
			agt._log_action("write", [
				path = args.path,
				prev_content = fs.read_text(args.path),
				new_content = file_content,
			]);
			
			fs.write_text(args.path, file_content);
			
			//std.print("Written file: ", args.path);
			
			return [
				ok = true,
				status = "Write was successful.",
			];
		}
	);
	
	agt.add_tool(
		"append_text",
		"FILE OPERATION - Append text at the end or insert text at the beginning of a file",
		[
			path = "&string(): Target file",
			insert_at = ["start", "end"],
			content = "&string(): Content to insert",
		],
		[](agt, args)
		{
			if(args.path.starts("/")) {
				return [
					ok = false,
					error = "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !",
				];
			}
			
			fs = agt.filesystem;

			managed _lock = local_file_lock(args.path);
		
			old_content = fs.exists(args.path) ? fs.read_text(args.path) : "<new file>";
				
			new_content = old_content;
			
			if(args.insert_at == "start")
				new_content = args.content + new_content;
			else
				new_content += args.content;
		
			agt._log_action("edit", [
				path = args.path,
				prev_content = old_content,
				new_content = new_content,
			]);
			
			fs.write_text(args.path, new_content);
			
			//std.print("Written file: ", args.path);
			
			return [
				ok = true,
				status = "Edit was successful.",
			];
		}
	);
	
	agt.add_tool(
		"replace_string",
		"FILE OPERATION - Replace one or multiple occurences of a given string within a text file\nMake sure to NOT include any line numbers returned by read functions!\nThis tool is mostly whitespace insensitive, but the text between the whitespaces must match 100% with what you want to replace.",
		[
			path = "&string(): Target file",
			target_text = "&string(): Exact text to locate. Must be copied byte-for-byte from the file.",
			replacement_text = "&string(): Text that will replace target_text (can be empty).",
			replace_all = ["true", "false"],
		],
		[](agt, args)
		{
			
			if(args.path.starts("/")) {
				return [
					ok = false,
					error = "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !",
				];
			}

			fs = agt.filesystem;

			managed _lock = local_file_lock(args.path);

			current_task = agt.env["task"];
			
			old_content = "";
				
			old_content = fs.read_text(args.path);
			
			if(!old_content) {
				return [
					ok = false,
					error = "Could not read the file: " + args.path,
				];
			}

			if(old_content.empty()) {
				return [
					ok = false,
					error = "File is empty: " + args.path,
				];
			}
			
			if(!args.target_text) {
				return [
					ok = false,
					error = "Empty 'target_text' parameter.",
				];
			}
			
			if(!args.replacement_text)
				args.replacement_text = ""; //Suppose the AI meant that?
			
			original = args.target_text.strip();
			edit = args.replacement_text.strip();
			
			agt.report_back("original\n```\n" + original + "\n```\nedit\n```\n" + edit + "\n```\n");

			if(original.empty()){
				std.print(args);
				std.print("\nNO_target_text");
				return [
					ok = false,
					error = "No 'target_text' argument given, make sure to use correct argument names.",
				];
			}
			
			if(args.replace_all == "false" && old_content.count(original) > 1)
			{
				std.print("\nMULTIPLE_CONTENTS");
				return [
					ok = false,
					error = "replace_all was set to false but there are more than one occurences to replace in the target file.\nEmit a bigger piece of the target text to replace and make it less ambigious.",
				];
			}
			
			if(!old_content.contains_ignoring_whitespaces(original)) {
				std.print("\nORIGINAL_NOT_FOUND");
				return [
					ok = false,
					error = "The original text provided was not found in the file.\nMake sure to copy the target text you want to replace exactly as it is in the file, without any line numbers.",
				];
			}
			
			new_content = old_content.replace_ignoring_whitespace(original, edit);
			
			agt._log_action("edit", [
				path = args.path,
				prev_content = fs.read_text(args.path),
				new_content = new_content,
			]);
			
			fs.write_text(args.path, new_content);
				
			return [
				ok = true,
				status = "Edit was applied successfully.",
			];
		}
	);
	
	agt.add_tool(
		"mkdir",
		"FILE OPERATION - Create a directory",
		[
			path = "&string(): Create a directory (and all sub-directories)",
		],
		[](agt, args)
		{
			if(args.path.starts("/")) {
				return [
					ok = false,
					error = "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !",
				];
			}
			
			fs = agt.filesystem;
			
			if(fs.mkdir(args.path)) {
				
				agt._log_action("mkdir", [
					path = args.path,
					existed_before = fs.exists(args.path),
				]);
				
				return "Success";
			}
			
			return "Failed to create directory.";
		}
	);
		
	agt.add_tool(
		"move",
		"FILE OPERATION - Move a file or directory.",
		[
			source = "&string(): Source path.",
			destination = "&string(): Destination path.",
		],
		[](agt, args)
		{
			if(args.source.starts("/"))
				return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
			
			fs = agt.filesystem;
			
			if(fs.move(args.source, args.destination)) {
				agt._log_action("move", [
					source = args.source,
					destination = args.destination,
					existed_before = fs.exists(args.destination),
				]);
				
				return "Success";
			}
			
			return "Failed to move file.";
		}
	);
	
	agt.add_tool(
		"copy",
		"FILE OPERATION - Copy a file or directory.",
		[
			source = "&string(): Source path.",
			destination = "&string(): Destination path.",
		],
		[](agt, args)
		{
			if(args.source.starts("/"))
				return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
			
			fs = agt.filesystem;
			
			if(fs.copy(args.source, args.destination)) {
				agt._log_action("copy", [
					source = args.source,
					destination = args.destination,
					existed_before = fs.exists(args.destination),
				]);
				
				return "Success";
			}
			
			return "Failed to copy file.";
		}
	);
	
	agt.add_tool(
		"rename",
		"FILE OPERATION - Rename a file or directory.",
		[
			source = "&string(): Source path.",
			destination = "&string(): Destination path.",
		],
		[](agt, args)
		{
			if(args.source.starts("/"))
				return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
			
			fs = agt.filesystem;
			
			if(fs.rename(args.source, args.destination)) {
				agt._log_action("rename", [
					source = args.source,
					destination = args.destination,
				]);
				
				return "Success";
			}
			
			return "Failed to rename file.";
		}
	);
	
	agt.add_tool(
		"remove",
		"FILE OPERATION - DANGEROUS Remove a file or directory. Only remove **one item at a time**",
		[
			path = "&string(): Source path.",
		],
		[](agt, args)
		{
			if(args.path.starts("/"))
				return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
			
			if(agt.env.removal_protection != args.path) {
				agt.env.removal_protection = args.path;
				return "Removal protection: to confirm the removal of the file, call this tool one more time.";
			}
			
			fs = agt.filesystem;
			
			if(!fs.exists(args.path)) {
				return "Success";
			}

			if(fs.remove(args.path)) {
				if(!fs.is_directory(args.path)) {
					agt._log_action("remove_file", [
						path = args.path,
						prev_content = fs.read_file(args.path),
					]);
				}
				
				return "Success";
			}
			
			return "Failed to remove the item.";
		}
	);
}

agt_add_skill_tools(agt) {
	agt.add_tool(
		"list_skills",
		"List all available skills",
		None,
		[](agt, args)
		{
			skills = agt.list_skills();
			if(!skills) {
				return [
					ok = 0,
					error = "No skills available.",
				];
			}
			
			return skills;
		}
	);
	
	agt.add_tool(
		"read_skill",
		"Read a skill",
		[
			name = "&string(): Name of the skill",
		],
		[](agt, args)
		{
			md = agt.load_skill(args.name);
			
			if(!md) {
				return [
					ok = false,
					error = "No skill with that name was found.",
				];
			}
			
			return md;
		}
	);
}

// ─────────────────────────────────────────────────────────────────────────────
// Command Sessions
//
// Non-blocking process execution for agents (see cli_spec.md).
// A command may continue running after a tool call returns. The agent can later
// inspect the process (command_read) or feed input (command_input) without
// restarting it. Each running command is identified by a session_id.
//
// Sessions are stored in the shared global "command_sessions" registry so that
// they survive across individual tool calls (and across the agent tree).
// ─────────────────────────────────────────────────────────────────────────────

// Bounded output buffer: cap how much console output is returned in a single
// read so a long-running process cannot repeatedly inject its whole history.
cmd_max_output_bytes = 40000;

cmd_sessions_store()
{
	store = std.global("command_sessions");

	if(!store.sessions)
		store.sessions = [];

	if(!store.meta)
		store.meta = [];

	if(!(store.next_id ?? false))
		store.next_id = 1;

	return store;
}

// Read currently available stdout+stderr from a process without blocking.
cmd_drain_output(proc)
{
	out = "";

	if(proc.read_ready("stdout"))
		out += proc.read("stdout", -1);

	if(proc.read_ready("stderr"))
		out += proc.read("stderr", -1);

	return out;
}

// Collect output for up to wait_ms milliseconds (negative = wait without limit).
// Stops early as soon as output appears OR the process exits.
// stop_check is an OPTIONAL predicate (a stopped agent must not sit in a wait).
// Returns [output, exited, exit_code, stopped].
cmd_wait_for_output(proc, wait_ms, stop_check = None)
{
	out = "";
	deadline = (wait_ms < 0) ? 9223372036854775807 : std.millis() + wait_ms;

	for(1)
	{
		if(stop_check && std.is_function(stop_check) && stop_check())
			return [output = out, exited = false, stopped = true];

		new_out = cmd_drain_output(proc);
		if(new_out)
			out += new_out;

		// status() reports the real process state. poll() only returns an exit code, which
		// looks identical to a failed query.
		st = proc.status();

		if(!st.running)
		{
			// Process exited: drain whatever is left in the pipes.
			out += cmd_drain_output(proc);
			return [output = out, exited = true, exit_code = (st.returncode ?? -1)];
		}

		// If we already have output, don't keep waiting for more.
		if(out && wait_ms != 0)
			return [output = out, exited = false];

		if(std.millis() >= deadline)
			return [output = out, exited = false];

		std.sleep(10);
	}
}

// Maximum amount of output cmd_wait_for_exit keeps buffered while it blocks.
cmd_max_collect_bytes = 200000;

// Hard ceiling for a timeout-less wait. A process that never exits must not be able to
// block an agent indefinitely: the call returns the session still RUNNING and the agent
// can simply wait again (output stays incremental, nothing is lost).
cmd_max_wait_ms = 1800000;

// Block until the process exits, collecting everything it prints while waiting.
// Unlike cmd_wait_for_output this does NOT return early when new output appears.
// max_ms < 0 waits without a caller timeout (bounded by cmd_max_wait_ms).
// stop_check is an OPTIONAL predicate: a stopped agent leaves the wait promptly,
// the process itself is left running (the session stays registered and usable).
// Returns [output, exited, exit_code, stopped].
cmd_wait_for_exit(proc, max_ms, stop_check = None)
{
	out = "";
	keep = cmd_max_collect_bytes - 60;

	deadline = (max_ms < 0) ? std.millis() + cmd_max_wait_ms : std.millis() + max_ms;

	for(1)
	{
		if(stop_check && std.is_function(stop_check) && stop_check())
			return [output = out, exited = false, stopped = true];

		out += cmd_drain_output(proc);

		// A chatty process must not grow the buffer without bound: drop the oldest output.
		if(out.size() > cmd_max_collect_bytes)
			out = "...[older output discarded]..." + out.substr(out.size() - keep, keep);

		st = proc.status();

		if(!st.running)
		{
			out += cmd_drain_output(proc);
			return [output = out, exited = true, exit_code = (st.returncode ?? -1)];
		}

		if(std.millis() >= deadline)
			return [output = out, exited = false];

		std.sleep(25);
	}
}

// Dispatch to the right waiting mode for a caller-supplied timeout.
// wait_ms < 0 requests a definitive wait until the process exits, collecting all output.
// wait_ms >= 0 returns early as soon as output appears (interactive use).
cmd_wait_for_process(proc, wait_ms, stop_check = None)
{
	if(wait_ms < 0)
		return cmd_wait_for_exit(proc, wait_ms, stop_check);

	return cmd_wait_for_output(proc, wait_ms, stop_check);
}

cmd_format_result(out)
{
	truncated = false;

	if(out.size() > cmd_max_output_bytes)
	{
		keep = cmd_max_output_bytes - 40;
		out = out.substr(0, keep) + "\n...[output truncated]...";
		truncated = true;
	}

	return [out = out, truncated = truncated];
}

// Interpreter used when a command is executed from a script file.
cmd_script_profile(kind)
{
	if(kind == "ps1")
		return [ext = "ps1", argv = ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]];

	if(kind == "sh")
		return [ext = "sh", argv = ["sh"]];

	if(kind == "py")
		return [ext = "py", argv = ["python"]];

	return [ext = "bat", argv = ["cmd.exe", "/C"]];
}

// Directory the command scripts are written to. Returns "" when it can not be created.
cmd_script_dir(cwd)
{
	dir = ((cwd && cwd != ".") ? cwd : ".") + "/.shz_cmd";

	if(!fileio.exists(dir))
		fileio.mkdir(dir);

	if(!fileio.exists(dir))
		return "";

	return fileio.absolute_path(dir);
}

// Builds the argv used to launch a command.
// A single line is handed to the shell as-is. A multi-line command would be collapsed into
// one shell statement, so it is written to a script file and executed line by line instead.
// Returns [argv: list, shell: bool, script: string, label: string].
cmd_prepare_command(session_id, command, cwd, kind)
{
	command = command.replace("\r\n", "\n");

	multi_line = command.count("\n") > 0;

	if(!multi_line && (!kind || kind == "auto"))
		return [argv = [command], shell = true, script = "", label = command];

	if(!kind || kind == "auto")
		kind = (subprocess.platform() == "windows") ? "bat" : "sh";

	profile = cmd_script_profile(kind);

	dir = cmd_script_dir(cwd);
	if(!dir)
		return [argv = [command], shell = true, script = "", label = command];

	script = dir + "/shz_cmd_" + std.string(session_id) + "." + profile.ext;

	if(subprocess.platform() == "windows")
		script = script.replace("/", "\\");

	written = fileio.write_text(script, command + "\n");

	if(written == None || !written)
		return [argv = [command], shell = true, script = "", label = command];

	argv = profile.argv;
	argv.push_back(script);

	return [argv = argv, shell = false, script = script, label = kind + " script: " + script];
}

// Removes a session from the registry, including its script file if it has one.
cmd_session_cleanup(store, key)
{
	store.sessions.erase(key);

	if(!store.meta.has(key))
		return false;

	script = store.meta[key].script ?? "";
	store.meta.erase(key);

	if(script)
		fileio.remove(script);

	return true;
}

agt_add_command_tools(agt)
{
	agt.add_tool(
		"command_start",
		"Start a new command session.\n\nStarts a process and waits until either the process exits or the timeout expires.\nIf the process exits, returns its final state, exit code and available console output.\nIf the timeout expires while the process is still running, the process is NOT terminated; instead the current state, output and a session_id are returned so the session can be continued with command_read / command_input.\nA timeout is not an error.\nPass a negative timeout to wait without any limit until the process exits (for commands that are certain to terminate, like build tools); in that case the full output is collected and no session is left behind.\n'command' may contain several lines: multi-line commands are stored in a script file and executed line by line, so batch/shell scripts work exactly as written.",
		[
			command = "&string(): Command line to execute. Multiple lines are allowed.",
			timeout = "&int(0): Maximum time in milliseconds to wait for the command during this call.",
			cwd = "string(): OPTIONAL working directory for the process.",
			script_type = ["auto", "bat", "ps1", "sh", "py"],
		],
		[](agt, args)
		{
			store = cmd_sessions_store();

			cwd = args.cwd ?? ".";

			// The id is reserved up front because a multi-line command is stored in a
			// script file named after the session.
			session_id = store.next_id;
			store.next_id++;
			key = std.string(session_id);

			launch = cmd_prepare_command(session_id, args.command, cwd, args.script_type ?? "auto");

			proc = subprocess.process();

			proc.terminate_on_destroy(true);

			// Enable pipes so read()/write() work on a live process.
			proc.pipes(true, true, true);

			proc.start(launch.argv, cwd, launch.shell);

			if(!proc.status().started)
			{
				if(launch.script)
					fileio.remove(launch.script);

				return [
					ok = false,
					error = "Failed to start command: " + args.command,
				];
			}

			wait_ms = args.timeout ?? 0;

			//A stopped agent must not block in a command wait: the process keeps
			//running, the session stays registered, only the wait ends.
			res = cmd_wait_for_process(proc, wait_ms, [agt]() { return agt.should_stop(); });
			fmt = cmd_format_result(res.output);

			if(res.exited)
			{
				if(launch.script)
					fileio.remove(launch.script);

				return [
					ok = true,
					state = "EXITED",
					exit_code = res.exit_code,
					output = fmt.out,
					truncated = fmt.truncated,
				];
			}

			// Still running: register the session and hand out its id.
			store.sessions[key] = proc;

			store.meta[key] = [
				command = launch.label,
				cwd = cwd,
				started_ms = std.millis(),
				script = launch.script,
			];

			return [
				ok = true,
				state = "RUNNING",
				session_id = session_id,
				output = fmt.out,
				truncated = fmt.truncated,
				stopped = (res.stopped ?? false),
				note = (res.stopped ?? false)
					? "The agent was stopped, so the wait ended early. The process was NOT terminated; the session is still registered under this id."
					: "Process is still running. Use command_read/command_input with this session_id. Do not restart it.",
			];
		}
	);

	agt.add_tool(
		"command_read",
		"Read output and state from an existing command session.\n\nReturns the current process state, new console output since the previous read (incremental), and the exit code when the process has exited.\nIf a timeout is given and no new output is produced and the process does not exit during that period, the current state is still returned.\nA timeout never terminates the process.",
		[
			session_id = "&int(1): Session returned by command_start.",
			timeout = "int(0): OPTIONAL maximum time in milliseconds to wait for additional output or process termination.",
		],
		[](agt, args)
		{
			store = cmd_sessions_store();
			key = std.string(args.session_id);

			if(!store.sessions.has(key))
			{
				return [
					ok = false,
					error = "No active command session with session_id " + key + ". The session may have already exited.",
				];
			}

			proc = store.sessions[key];

			wait_ms = (args.timeout ?? false) ? args.timeout : 0;

			res = cmd_wait_for_output(proc, wait_ms, [agt]() { return agt.should_stop(); });
			fmt = cmd_format_result(res.output);

			if(res.exited)
			{
				cmd_session_cleanup(store, key);

				return [
					ok = true,
					state = "EXITED",
					exit_code = res.exit_code,
					output = fmt.out,
					truncated = fmt.truncated,
				];
			}

			return [
				ok = true,
				state = "RUNNING",
				session_id = args.session_id,
				output = fmt.out,
				truncated = fmt.truncated,
				stopped = (res.stopped ?? false),
			];
		}
	);

	agt.add_tool(
		"command_wait",
		"Wait for an existing command session to finish.\n\nBlocks until the process exits and then returns its exit code and all console output produced since the previous read. Use this for commands that are certain to terminate on their own (builds, compilers, installers, test runners, one-shot scripts) instead of repeatedly polling with command_read.\nBy default there is NO timeout: the call waits as long as the process takes. A positive timeout can be passed as a safety bound for sessions that may never exit; if it elapses the process is NOT terminated and the session stays active.\nClosing stdin first (command_input with close_stdin) may be required for processes that block waiting for input.",
		[
			session_id = "&int(1): Session returned by command_start.",
			timeout = "int(-1): OPTIONAL maximum time in milliseconds to wait for the process to exit. Negative (default) waits without any limit.",
		],
		[](agt, args)
		{
			store = cmd_sessions_store();
			key = std.string(args.session_id);

			if(!store.sessions.has(key))
			{
				return [
					ok = false,
					error = "No active command session with session_id " + key + ". The session may have already exited.",
				];
			}

			proc = store.sessions[key];

			st = proc.status();

			// Already finished: report the final state instead of blocking.
			if(!st.running)
			{
				res = [
					output = cmd_drain_output(proc),
					exited = true,
					exit_code = (st.returncode ?? proc.returncode() ?? -1),
				];
				fmt = cmd_format_result(res.output);
				cmd_session_cleanup(store, key);

				return [
					ok = true,
					state = "EXITED",
					session_id = args.session_id,
					exit_code = res.exit_code,
					output = fmt.out,
					truncated = fmt.truncated,
					note = "The process had already exited before the wait request.",
				];
			}

			wait_ms = (args.timeout ?? false) ? args.timeout : -1;

			started_ms = std.millis();

			res = cmd_wait_for_exit(proc, wait_ms, [agt]() { return agt.should_stop(); });
			fmt = cmd_format_result(res.output);

			if(res.exited)
			{
				cmd_session_cleanup(store, key);

				return [
					ok = true,
					state = "EXITED",
					session_id = args.session_id,
					exit_code = res.exit_code,
					waited_ms = std.millis() - started_ms,
					output = fmt.out,
					truncated = fmt.truncated,
				];
			}

			// Timeout elapsed: the session stays alive and usable.
			return [
				ok = true,
				state = "RUNNING",
				session_id = args.session_id,
				waited_ms = std.millis() - started_ms,
				output = fmt.out,
				truncated = fmt.truncated,
				stopped = (res.stopped ?? false),
				note = (res.stopped ?? false)
					? "The agent was stopped, so the wait ended early. The process was NOT terminated; the session is still registered under this id."
					: "The process is still running after the wait timeout. It was not terminated; call command_wait again or use command_read.",
			];
		}
	);

	agt.add_tool(
		"command_input",
		"Send input to an existing command session.\n\nWrites the supplied input directly to the session's stdin.\nSet close_stdin to end the input: closing the pipe is the only reliable way to tell a process that there is nothing more to read (sending Ctrl+Z does not work).\nThe process remains running after the call unless the input itself causes it to exit.",
		[
			session_id = "&int(1): Session to send input to.",
			input = "&string(): Data written to the process stdin. May be empty when only closing stdin.",
			send_newline = "&int(0,1): Send a newline character after the command.",
			close_stdin = "int(0): OPTIONAL 1 to close the stdin pipe after writing (end of input).",
		],
		[](agt, args)
		{
			store = cmd_sessions_store();
			key = std.string(args.session_id);

			if(!store.sessions.has(key))
			{
				return [
					ok = false,
					error = "No active command session with session_id " + key + ". The session may have already exited.",
				];
			}

			proc = store.sessions[key];

			st = proc.status();

			if(!st.running)
			{
				cmd_session_cleanup(store, key);
				return [
					ok = false,
					error = "The process for this session has already exited.",
				];
			}
			
			if(args.send_newline)
				args.input += "\n";
			
			written = proc.write(args.input);

			if(written == None)
			{
				return [
					ok = false,
					error = "Failed to write to the stdin of the session.",
				];
			}

			close_stdin = (args.close_stdin ?? false) ? true : false;

			if(close_stdin)
			{
				if(!st.stdin_open)
					return [
						ok = false,
						error = "This session has no open stdin pipe to close.",
					];

				proc.close_stdin();
			}

			return [
				ok = true,
				status = "Input sent.",
				bytes_written = written,
				stdin_closed = close_stdin,
			];
		}
	);

	agt.add_tool(
		"command_kill",
		"Terminate or force-kill a running command session.\n\nUse 'graceful' mode (default) to request a clean shutdown (SIGTERM, Ctrl+C on Windows). Use 'force' mode to kill the process and everything it started.\nAfter killing, any remaining output from the process is returned.\nThe session is removed from the active session registry.",
		[
			session_id = "&int(1): Session to terminate.",
			mode = ["graceful", "force"],
			wait_ms = "int(0): OPTIONAL milliseconds to wait for the process to exit after sending the signal (default 3000).",
		],
		[](agt, args)
		{
			store = cmd_sessions_store();
			key = std.string(args.session_id);

			if(!store.sessions.has(key))
			{
				return [
					ok = false,
					error = "No active command session with session_id " + key + ". The session may have already exited.",
				];
			}

			proc = store.sessions[key];

			st = proc.status();

			if(!st.running)
			{
				rc = (st.returncode ?? proc.returncode()) ?? "unknown";

				cmd_session_cleanup(store, key);
				return [
					ok = true,
					state = "ALREADY_EXITED",
					session_id = args.session_id,
					exit_code = rc,
					note = "The process had already exited before the kill request.",
				];
			}

			mode = args.mode ?? "graceful";
			wait = (args.wait_ms ?? false) ? args.wait_ms : 3000;

			pid = proc.pid();

			// Send the appropriate signal
			if(mode == "force")
				proc.kill();
			else
				proc.terminate();

			// Wait briefly for the process to acknowledge the signal
			exited = false;
			exit_code = None;
			deadline = std.millis() + wait;

			for(std.millis() < deadline)
			{
				st = proc.status();
				if(!st.running)
				{
					exited = true;
					exit_code = st.returncode ?? "unknown";
					break;
				}
				std.sleep(20);
			}

			// If graceful termination did not work within the wait period, escalate to force kill
			if(!exited && mode == "graceful")
			{
				proc.kill();

				// Brief second wait after force kill
				for(std.millis() < deadline + 2000)
				{
					st = proc.status();
					if(!st.running)
					{
						exited = true;
						exit_code = st.returncode ?? "unknown";
						break;
					}
					std.sleep(20);
				}
			}

			// Drain any remaining output
			remaining_output = cmd_drain_output(proc);
			fmt = cmd_format_result(remaining_output);

			cmd_session_cleanup(store, key);

			if(exited)
			{
				return [
					ok = true,
					state = "KILLED",
					session_id = args.session_id,
					pid = pid,
					mode_used = mode,
					exit_code = exit_code,
					output = fmt.out,
					truncated = fmt.truncated,
				];
			}

			return [
				ok = false,
				state = "STILL_RUNNING",
				session_id = args.session_id,
				pid = pid,
				mode_used = mode,
				output = fmt.out,
				error = "The process did not exit within the specified wait time even after kill.",
			];
		}
	);

	agt.add_tool(
		"command_list_sessions",
		"List all currently active command sessions.\n\nReturns a summary of every registered session including its state (RUNNING or EXITED), process ID, command line, working directory, and uptime in seconds.\nExited sessions are automatically pruned from the registry during this call.\nUse this to identify runaway or orphaned command processes.",
		[],
		[](agt, args)
		{
			store = cmd_sessions_store();

			sessions_list = [];
			pruned_keys = [];

			for(i = 0; i < store.sessions.size(); i++)
			{
				key = store.sessions.key(i);
				proc = store.sessions[key];

				st = proc.status();

				if(!st.running)
				{
					// Session has exited — drain remaining output and prune
					cmd_drain_output(proc);
					pruned_keys.push_back(key);
				}
				else
				{
					// Still running — collect remaining output
					pending_out = cmd_drain_output(proc);

					entry = [
						session_id = std.int(key),
						pid = proc.pid(),
						state = "RUNNING",
						pending_output_bytes = pending_out.size(),
					];

					// Attach metadata if available
					if(store.meta.has(key))
					{
						m = store.meta[key];
						entry.command = m.command;
						entry.cwd = m.cwd;
						entry.uptime_seconds = (std.millis() - m.started_ms) / 1000;
					}

					sessions_list.push_back(entry);
				}
			}

			// Remove exited sessions from registry
			for(i = 0; i < pruned_keys.size(); i++)
				cmd_session_cleanup(store, pruned_keys[i]);

			pruned_ids = [];
			for(i = 0; i < pruned_keys.size(); i++)
				pruned_ids.push_back(std.int(pruned_keys[i]));

			result = [
				ok = true,
				total_sessions = sessions_list.size(),
				running_sessions = sessions_list,
			];

			if(pruned_ids.size())
				result.pruned_exited_sessions = pruned_ids;

			if(!sessions_list.size())
				result.note = "No active command sessions.";

			return result;
		}
	);
}
