
class local_file_lock
{
	path = "";
	local_files = None;
	
	__init__(path) {
		this.path = path;
		this.local_files = std.global("local_files");
		
		if(!local_files.locks)
			local_files.locks = [ticketid=0, current=0];
		
		ticketid = local_files.locks[path].ticketid;
		local_files.locks[path].ticketid++;
		
		for(local_files.locks[path].current != ticketid) {
			std.sleep(10);
		}
	}
	
	__deinit__() {
		local_files.locks[path].current++;
	}
}

agt_add_read_tools(agt) {

	agt.add_tool(
		"list_dir",
		"FILE OPERATION - Query files in the current directory",
		[
			path = "&string(): Path to query, use '.' for the current working directory",
			recursive = ["true", "false"],
		],
		[](agt, args)
		{
			if(args.path.starts("/"))
				return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
			
			args.path = args.path.removesuffix("/");
		
			if(!agt.filesystem.exists(args.path))
				return "The directory does not exist.";
		
			dirs = agt.filesystem.dirs(args.path, args.recursive == "true"); 
			files = agt.filesystem.files(args.path, args.recursive == "true"); //Filter out large log files and other stuff
			
			dirs_cleaned = [];
			files_cleaned = [];
			
			//Filter out logfiles
			for(i = 0; i < dirs.size(); i++) {
				//Kind of obsolete, also make the model know that there is a git folder, unless recursive
				
				if(dirs[i].contains(".git") && args.recursive == "true")
					continue;
				
				//if(dirs[i].contains(".agent") || dirs[i].contains(".backup") || dirs[i].contains(".git"))
				//	continue;
				dirs_cleaned.push_back(dirs[i]);
			}
			for(i = 0; i < files.size(); i++) {		
				//if(files[i].contains(".agent") || files[i].contains(".backup") || files[i].contains(".git"))
				//	continue;
				files_cleaned[files[i]] = [size=agt.filesystem.size(args.path + "/" + files[i])];
			}
			
			truncated = false;
			total_files = files_cleaned.size();
			total_dirs = dirs_cleaned.size();
			
			if(args.recursive == "true") {
				for(files_cleaned.size() > 50) {
					files_cleaned.erase(files_cleaned.size()-1);
					truncated = true;
				}
				for(dirs_cleaned.size() > 50) {
					dirs_cleaned.erase(dirs_cleaned.size()-1);
					truncated = true;
				}
			}
			//Todo: find reasonable limits for non-recursive
			
			has_files = files_cleaned ? "true" : "false";
			has_dirs = dirs_cleaned ? "true" : "false";
			
			result = [
				has_files = has_files,
				has_directories = has_dirs,
				total_files = total_files,
				total_dirs = total_dirs,
				dirs = dirs_cleaned,
				files = files_cleaned,
			];
			
			if(truncated)
				result.truncation_warning = "Warning: file list was truncated due to too many entries.";
			
			return result;
		}
	);

	agt.add_tool(
	  "file_info",
	  "FILE OPERATION - Get file info",
	  [
		path = "&string(): Target file",
	  ],
	  [](agt, args)
	  {
		if(args.path.starts("/"))
		  return "Invalid path specified. Use './path/to/file' instead of absolute paths.";

		return agt.filesystem.file_info(args.path);
	  }
	);
	
	agt.add_tool(
	  "file_line_count",
	  "FILE OPERATION - Get file line count",
	  [
		path = "&string(): Target file",
	  ],
	  [](agt, args)
	  {
		if(args.path.starts("/"))
		  return "Invalid path specified. Use './path/to/file' instead of absolute paths.";

		return agt.filesystem.read_string(args.path).count("\n") + 1;
	  }
	);

	agt.add_tool(
	  "read_file",
	  "FILE OPERATION - Read raw file content",
	  [
		path = "&string(): Target file",
		include_line_numbers = ["true", "false"],
		start_line = "int(1): OPTIONAL start line",
		end_line = "int(1): OPTIONAL end line"
	  ],
	  [](agt, args)
	  {
		if(args.path.starts("/"))
		  return "Invalid path specified. Use './path/to/file' instead of absolute paths.";

		if(!agt.filesystem.exists(args.path)) {
		  return [
			ok = false,
			error = "file doesnt exist"
		  ];
		}
		
		managed _lock = local_file_lock(args.path);

		txt = agt.filesystem.read_text(args.path);

		if(!txt) {
		  return [
			ok = true,
			status = "file is empty"
		  ];
		}

		txt = txt.replace("\r\n", "\n").replace("\r", "\n");

		has_line_numbers = args.include_line_numbers != "false";
		has_line_start = args.start_line ?? false;
		has_line_end = args.end_line ?? false;

		if(has_line_numbers || has_line_start || has_line_end) {

		  lines = txt.split("\n");
		  txt = "";

		  for(i = 0; i < lines.size(); i++) {

			if(has_line_start && (i+1) < args.start_line)
			  continue;

			if(has_line_end && (i+1) > args.end_line)
			  continue;

			if(has_line_numbers)
			  txt += (i+1) + "| ";

			txt += lines[i] + "\n";
		  }
		}
		
		num_lines = txt.count("\n") + 1;

		if(num_lines > 10000) {
			return [
			  ok = false,
			  error = "File is too big to be read at whole.",
		    ];
		}

		return [
		  ok = true,
		  content = txt
		];
	  }
	);

	agt.add_tool(
	  "read_source_map",
	  "FILE OPERATION - Read a source file of any kind as a skeleton overview with all classes and functions and their locations in the text file, without concrete implementation details\nALWAYS prefer this function over reading entire source files when possible.\nDO NOT use this function on non-programming or non-structured regular text files.",
	  [
		path = "&string(): Target file",
	  ],
	  [](agt, args)
	  {
		if(args.path.starts("/"))
		  return "Invalid path specified. Use './path/to/file' instead of absolute paths.";

		if(!agt.filesystem.exists(args.path)) {
		  return [
			ok = false,
			error = "file doesnt exist"
		  ];
		}
		
		managed _lock = local_file_lock(args.path);

		txt = agt.filesystem.read_text(args.path);

		if(!txt) {
		  return [
			ok = true,
			status = "file is empty"
		  ];
		}

		txt = txt.replace("\r\n", "\n").replace("\r", "\n");

		lines = txt.split("\n");
		txt = "";

		for(i = 0; i < lines.size(); i++) {
			txt += (i+1) + " ";
			txt += lines[i] + "\n";
		}
			
		num_lines = txt.count("\n") + 1;

		if(num_lines > 30000) {
			return [
			  ok = false,
			  error = "File is too big for this operation.",
			];
		}
		
		local_files = std.global("local_files");

		if(!local_files.source_maps)
			local_files.source_maps = [];

		//Cache source maps each run...
		if(local_files.source_maps.has(args.path)) {
			fh = fileio.hash(args.path);
			if(local_files.source_maps[args.path].hash == fh) {
				return [
				  ok = true,
				  content = local_files.source_maps[args.path].content,
				];
			}
		}

		managed search_agt = agt.subagent("util/source_mapper", true, agt.env.secondary_model);

		txt = search_agt.single_task(txt);

		if(!txt) {
		  return [
			ok = false,
			error = "Cannot create source map for this file."
		  ];
		}

		local_files.source_maps[args.path] = [
			hash = fileio.hash(args.path),
			content = txt,
		];
		
		//std.print(txt);
		
		return [
		  ok = true,
		  content = txt,
		];
	  }
	);

	agt.add_tool(
	  "search_in_file",
	  "FILE OPERATION - Extract relevant parts of a file based on a natural language instructions\nNote: use return_format: 'signatures' for a compressed class/function overview without concrete implementation details or function bodies",
	  [
		path = "&string(): Target file",

		look_for = "string(): What to find or extract from the file",

		return_format = ["exact", "context", "structured", "summary", "signatures"],
		
		include_line_numbers = ["true", "false"],
	  ],
	  [](agt, args)
	  {
		if(args.path.starts("/"))
		  return "Invalid path specified. Use './path/to/file'.";

		if(!agt.filesystem.exists(args.path)) {
		  return [
			ok = false,
			error = "file doesnt exist"
		  ];
		}

		managed _lock = local_file_lock(args.path);

		txt = agt.filesystem.read_text(args.path);
		
		if(!txt) {
		  return [
			ok = true,
			status = "file is empty"
		  ];
		}

		txt = txt.replace("\r\n", "\n").replace("\r", "\n");

		has_line_numbers = args.include_line_numbers != "false";

		lines = txt.split("\n");
		txt = "";

		if(lines.size() > 50000)
			std.error("File is being truncated");

		for(lines.size() > 50000) {
			lines.erase(lines.size()-1);
		}
		
		if(has_line_numbers) {
			for(i = 0; i < lines.size(); i++) {
				txt += (i+1) + " ";
				txt += lines[i] + "\n";
			}
		}

		managed search_agt = agt.subagent("util/filereader", true, agt.env.secondary_model);

		prompt =
		  "<FILE>\n" + txt + "\n</FILE>\n\n" +
		  "<INSTRUCTION>\n" + args.look_for + "\n</INSTRUCTION>\n\n" +
		  "<RETURN_FORMAT>\n" + args.return_format + "\n</RETURN_FORMAT>";
		  
		if(has_line_numbers) {
			prompt += "\n\nInclude line numbers for any text from the file in your response.";
		}
		
		if(args.return_format == "signatures") {
			prompt += "\nReturn a signatures-only version of any functions/classes you may find and omit concrete implementation details and function bodies.\nInclude return and parameter types and other function signature data only";
		}

		res = search_agt.single_task(prompt);

		return [
		  ok = true,
		  content = res
		];
	  }
	);

	agt.add_tool(
		"grep",
		"FILE OPERATION - Grep function",
		[
			query = "&string(): The query to search for",
			recursive = ["true", "false"],
			path = "string(): OPTIONAL Directory to limit search to, if not set this function operates from the current working directory",
			extensions = "array(string): OPTIONAL Limit to specific file extensions, e.g. [\".h\", \".cpp\"]", 
		],
		[](agt, args)
		{	
			res = agt.filesystem.grep(args.query, args.path ?? ".", false, args.recursive == "true", args.extensions ?? []);
			res_truncated = false;
			for(res.size() > 50) {
				res.erase(res.size()-1);
				res_truncated = true;
			}	

			if(res_truncated) {
				return [
					result = res,
					results_truncated = true,
				];
			}
			std.print(res);
			return res;
		}
	);
}

agt_add_code_read_tools(agt) {
	
	agt.add_tool(
		"resolve_symbol",
		"Resolve functions/classes/variables across the entire codebase",
		[
			symbols = "&array(string): List of symbols to resolve",
			source_file = "string(): OPTIONAL Which source file the search should initially start from, to make it easier to find the symbol",
		],
		[](agt, args)
		{			
			//Implement caching if source of symbol has not changed !
		
			local_files = std.global("local_files");

			if(!local_files.symbol_maps)
				local_files.symbol_maps = [];
			
			resolved_symbols = [];
			
			resolve_thread = [agt, &resolved_symbols, &local_files](symbol, source_file) {
				managed search_agt = agt.subagent("util/symbol_resolver", true, agt.env.secondary_model);
				agent_prompt = "<symbol_name>" + symbol + "</symbol_name>";
				if(source_file)
					agent_prompt = "\n<source_file>" + source_file + "</source_file>";		
				search_agt.single_task(agent_prompt);
				
				resolved_symbols[symbol] = [
					definition = search_agt.env.symbol_definition,
					path = search_agt.env.symbol_path,
				];
				
				if(search_agt.env.symbol_path) {			
					local_files.symbol_maps[symbol] = [
						path = search_agt.env.symbol_path,
						hash = fileio.hash(search_agt.env.symbol_path),
						content = [
							definition = search_agt.env.symbol_definition,
							path = search_agt.env.symbol_path,
						]
					];
				}
			}
			
			rt = std.thread(resolve_thread);
			
			for(i = 0; i < args.symbols.size(); i++) {
				symbol = args.symbols[i];
				if(local_files.symbol_maps.has(symbol)) {
					cached_symbol = &local_files.symbol_maps[symbol];
					fh = fileio.hash(cached_symbol.path);
					if(cached_symbol.hash == fh) {
						resolved_symbols[symbol] = cached_symbol.content;
						continue;
					}
				}
				
				rt.run(symbol, args.source_file);
			}	
		
			rt.join();
			
			return resolved_symbols;
		}
	);
}

agt_add_write_tools(agt) {
	agt.add_tool(
		"write_file",
		"FILE OPERATION - Create a new file.",
		[
			path = "&string(): Target file",
			intention = "&string(): Intention of the new file.",
			content = "&string(): Content of the new file",
		],
		[](agt, args)
		{
			if(args.path.starts("/")) {
				return [
					ok = false,
					error = "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !",
				];
			}
			
			managed _lock = local_file_lock(args.path);
			
			if(!agt.filesystem.empty(args.path)) {
				return [
					ok = false,
					error = "The file exists and is not empty.",
					next_steps = "Prefer to use 'replace_string' to make precise edits to files rather than rewriting the entire file from scratch.\nIf you are absolutely sure you want to overwrite the entire file (not recommended) because it is necessary, use 'remove' to remove the file first, then call this tool again.",
				];
			}
			
			file_content = args.content;
		
			//Evaluate possible changes
			//Always evaluate...
			//if(args.operation == "overwrite" || agt.filesystem.exists(args.path))
			if(1)
			{
				confirm_agent = R"(
System Prompt: Write Confirming Agent (Flexible)

You are a Write Confirming Agent. Your responsibility is to determine whether a file write operation correctly fulfills a given task.

You will receive:

- <OLD_CONTENT> – the content before modification (can be '<new_file>' if the file does not exist yet)
- <NEW_CONTENT> – the content after modification
- <FILENAME> - The file to write
- <TASK> – a description of the required change
- <INTENTION> – the intention of this action to satisfy the required change

Your job is to evaluate whether the New Content correctly implements and follows the task and is not invalid.  

IMPORTANT:

- Code, configuration files, JSON, YAML, or other structured data must be checked for correctness, syntax, logical consistency, and task compliance.
- Text-based artifacts such as task reports, logs, markdown summaries, or documentation should always be APPROVED regardless of their content (even if they indicate failure), as they are not “executable” code.
- For reports or failure reports, do not verify state. Always approve reports of any kind.

Evaluation Rules for Code/Data:

1. Task Compliance
   - The new content fully satisfies the task requirements.
   - No required elements and functions are missing or omitted (unless they will be implemented later).
   - The implementation matches the intent of the task.

2. Correctness
   - No syntax errors.
   - No obvious logical errors.
   - No broken references or inconsistencies introduced.

3. No Unjustified Writes
   - No unrelated writes outside the scope of the task.
   - No overwrite of important files with incorrect new code.

Evaluation Rules for Text/Reports:

- Always approve textual artifacts such as task reports, logs, or documentation.
- Do not reject based on content describing failure or errors.
- Only disapprove if the textual content is corrupted or wrong.
- Do not disapprove writes that are part of a bigger operation and where other required changes are not yet implemented.

Required Output Format:

You must respond exactly in the following structure:

<evaluation>
Concise explanation of why the patch can be approved.
</evaluation>
<statement>
APPROVED
</statement>

OR

<evaluation>
Concise explanation of why the patch cannot be approved.
</evaluation>
<statement>
DECLINED
</statement>

Rules:

- <evaluation>...</evaluation> must contain a brief, clear justification.
- <statement>...</statement> must contain only one word: APPROVED or DECLINED.
- Do not include any additional text outside these tags.
- Do not add commentary after the statement.
- Only ever let code be overwritten by new valid code, no placeholders, readme's or future instructions.

Special Cases:

- Make sure that existing code is not accidentally overwritten by readme/placeholder/instruction text.
- If <NEW_CONTENT> only contains instructions on how to create the required file type instead of the actual contents for the file type of <FILENAME>, return DECLINED.

Decision must be binary and final.				
)";
				
				agt.report_back("evaluating... ");
				
				current_task = agt.env["task"];
				
				old_content = agt.filesystem.exists(args.path) ? agt.filesystem.read_text(args.path) : "<new file>";
				
				new_content = file_content;
				
				managed tmp_agt = agt.simple_agent(confirm_agent);
				eval_result = tmp_agt.text("<OLD_CONTENT>\n" + old_content + "\n\n\n<NEW_CONTENT>\n" + new_content + "\n\n\n<FILENAME>\n" + args.path + "\n\n\n<TASK>\n" + current_task  + "\n\n\n<INTENTION>\n" + args.intention);
				
				eval = eval_result.extract("<evaluation>", "</evaluation>").strip();
				approve = eval_result.extract("<statement>", "</statement>").strip();
								
				agt.report_back(approve + "\n");
				
				if(approve.lowercase().find("decline") >= 0)
				{
					return [
						ok = false,
						error = "REJECTED:\n" + eval,
					];
				}
				
				if(agt.on_action) {
					agt.on_action([
						operation="write",
						old_content=old_content,
						new_content=new_content,
						path=fileio.absolute_path(args.path),
					]);
				}
			}
			
			
			agt._log_action("write", [
				path = args.path,
				prev_content = agt.filesystem.read_text(args.path),
				new_content = file_content,
			]);
			
			agt.filesystem.write_text(args.path, file_content);
			
			//std.print("Written file: ", args.path);
			
			return [
				ok = true,
				status = "Write was successful.",
			];
		}
	);
	
	agt.add_tool(
		"append_text",
		"FILE OPERATION - Append text at the end or insert text at the beginning of a file",
		[
			path = "&string(): Target file",
			insert_at = ["start", "end"],
			intention = "&string(): Intention for the file operation",
			content = "&string(): Content to insert",
		],
		[](agt, args)
		{
			if(args.path.starts("/")) {
				return [
					ok = false,
					error = "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !",
				];
			}
			
			managed _lock = local_file_lock(args.path);
		
			old_content = agt.filesystem.exists(args.path) ? agt.filesystem.read_text(args.path) : "<new file>";
				
			new_content = old_content;
			
			if(args.insert_at == "start")
				new_content = args.content + new_content;
			else
				new_content += args.content;
		
			//Evaluate possible changes
			//Always evaluate...
			//if(args.operation == "overwrite" || agt.filesystem.exists(args.path))
			if(1)
			{
				confirm_agent = R"(
System Prompt: File edit Confirming Agent (Flexible)

You are a file edit Confirming Agent. Your responsibility is to determine whether a file edit operation correctly fulfills a given task.

You will receive:

- <OLD_CONTENT> – the content before modification (can be '<new_file>' if the file does not exist yet)
- <NEW_CONTENT> – the content to be added
- <POSITION> - where the content should be inserted at
- <FILENAME> - The file to write
- <TASK> – a description of the required change
- <INTENTION> – the intention of this action to satisfy the required change

Your job is to evaluate whether the New Content correctly implements and follows the task and is not invalid.  

IMPORTANT:

- Code, configuration files, JSON, YAML, or other structured data must be checked for correctness, syntax, logical consistency, and task compliance.
- Text-based artifacts such as task reports, logs, markdown summaries, or documentation should always be APPROVED regardless of their content (even if they indicate failure), as they are not “executable” code.
- For reports or failure reports, do not verify state. Always approve reports of any kind.

Evaluation Rules for Code/Data:

1. Task Compliance
   - The new content fully satisfies the task requirements.
   - No required elements and functions are missing or omitted (unless they will be implemented later).
   - The implementation matches the intent of the task.

2. Correctness
   - No syntax errors.
   - No obvious logical errors.
   - No broken references or inconsistencies introduced.

3. No Unjustified Writes
   - No unrelated writes outside the scope of the task.
   - No overwrite of important files with incorrect new code.

Evaluation Rules for Text/Reports:

- Always approve textual artifacts such as task reports, logs, or documentation.
- Do not reject based on content describing failure or errors.
- Only disapprove if the textual content is corrupted or wrong.
- Do not disapprove writes that are part of a bigger operation and where other required changes are not yet implemented.

Required Output Format:

You must respond exactly in the following structure:

<evaluation>
Concise explanation of why the patch can be approved.
</evaluation>
<statement>
APPROVED
</statement>

OR

<evaluation>
Concise explanation of why the patch cannot be approved.
</evaluation>
<statement>
DECLINED
</statement>

Rules:

- <evaluation>...</evaluation> must contain a brief, clear justification.
- <statement>...</statement> must contain only one word: APPROVED or DECLINED.
- Do not include any additional text outside these tags.
- Do not add commentary after the statement.
- Only ever let code be overwritten by new valid code, no placeholders, readme's or future instructions.

Special Cases:

- Make sure that existing code is not accidentally overwritten by readme/placeholder/instruction text.
- If <NEW_CONTENT> only contains instructions on how to create the required file type instead of the actual contents for the file type of <FILENAME>, return DECLINED.

Decision must be binary and final.				
)";
				
				agt.report_back("evaluating... ");
				
				current_task = agt.env["task"];
				
				managed tmp_agt = agt.simple_agent(confirm_agent);
				eval_result = tmp_agt.text("<OLD_CONTENT>" + old_content + "</OLD_CONTENT>\n\n\n<NEW_CONTENT>" + args.content + "</NEW_CONTENT>\n\n\n<FILENAME>" + args.path + "</FILENAME>\n\n\n<TASK>" + current_task  + "</TASK>\n\n\n<INTENTION>" + args.intention + "</INTENTION>");
				
				eval = eval_result.extract("<evaluation>", "</evaluation>").strip();
				approve = eval_result.extract("<statement>", "</statement>").strip();
								
				agt.report_back(approve + "\n");
				
				if(approve.lowercase().find("decline") >= 0)
				{
					return [
						ok = false,
						error = "REJECTED:\n" + eval,
					];
				}
				
				if(agt.on_action) {
					agt.on_action([
						operation="edit",
						old_content=old_content,
						new_content=new_content,
						path=fileio.absolute_path(args.path),
					]);
				}
			}
			
			
			agt._log_action("edit", [
				path = args.path,
				prev_content = old_content,
				new_content = new_content,
			]);
			
			agt.filesystem.write_text(args.path, new_content);
			
			//std.print("Written file: ", args.path);
			
			return [
				ok = true,
				status = "Edit was successful.",
			];
		}
	);
	
	agt.add_tool(
		"replace_string",
		"FILE OPERATION - Replace one or multiple occurences of a given string within a text file\nMake sure to NOT include any line numbers returned by read functions!\nThis tool is mostly whitespace insensitive, but the text between the whitespaces must match 100% with what you want to replace.",
		[
			path = "&string(): Target file",
			target_text = "&string(): Exact text to locate. Must be copied byte-for-byte from the file.",
			replacement_text = "&string(): Text that will replace target_text (can be empty).",
			replace_all = ["true", "false"],
			intention = "&string(): Intention of the operation.",
		],
		[](agt, args)
		{
			
			if(args.path.starts("/")) {
				return [
					ok = false,
					error = "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !",
				];
			}

			managed _lock = local_file_lock(args.path);

			current_task = agt.env["task"];
			old_content = agt.filesystem.read_text(args.path);
			
			if(!old_content) {
				return [
					ok = false,
					error = "Could not read the file: " + args.path,
				];
			}

			if(old_content.empty()) {
				return [
					ok = false,
					error = "File is empty: " + args.path,
				];
			}
			
			if(!args.target_text) {
				return [
					ok = false,
					error = "Empty 'target_text' parameter.",
				];
			}
			
			if(!args.replacement_text)
				args.replacement_text = ""; //Suppose the AI meant that?
			
			original = args.target_text.strip();
			edit = args.replacement_text.strip();
			
			agt.report_back("original\n```\n" + original + "\n```\nedit\n```\n" + edit + "\n```\n");

			if(original.empty()){
				std.print(args);
				std.print("\nNO_target_text");
				return [
					ok = false,
					error = "No 'target_text' argument given, make sure to use correct argument names.",
				];
			}
			
			if(args.replace_all == "false" && old_content.count(original) > 1)
			{
				std.print("\nMULTIPLE_CONTENTS");
				return [
					ok = false,
					error = "replace_all was set to false but there are more than one occurences to replace in the target file.\nEmit a bigger piece of the target text to replace and make it less ambigious.",
				];
			}
			
			if(!old_content.contains_ignoring_whitespaces(original)) {
				std.print("\nORIGINAL_NOT_FOUND");
				return [
					ok = false,
					error = "The original text provided was not found in the file.\nMake sure to copy the target text you want to replace exactly as it is in the file, without any line numbers.",
				];
			}
			//Evaluate possible changes

			confirm_agent = R"(
System Prompt: Patch Confirming Agent (Chunk Replacement Mode - Forgiving)

You are a Patch Confirming Agent. Your responsibility is to determine whether a proposed code modification correctly fulfills a given task.

You will receive:

- <ORIGINAL_TEXT> – the full content before modification
- <TARGET_TEXT> – the exact chunk that should be replaced
- <REPLACE_WITH> – the new chunk that should substitute it
- <TASK> – a description of the required change
- <INTENTION> – the intention of this action to satisfy the required change

Your job is to evaluate whether the Replacement Code correctly satisfies the Task when applied as a replacement for the specified Code to Replace within the Original Code.

IMPORTANT:

- For code, configuration files, JSON, YAML, or other structured data, check correctness, syntax, logical consistency, and task compliance.
- Textual artifacts such as reports, logs, or documentation should always be APPROVED unless they corrupt a structured format.
- Do not allow placeholder comments or "do it later" mentality.

Evaluation Rules for Code/Data:

1. Task Compliance
   - The replacement fulfills the task requirements.
   - The intended change is implemented correctly.
   - If additional changes are required elsewhere to fully implement the task, this should **not** cause disapproval; instead, note them in the evaluation.

2. Replacement Accuracy
   - The Code to Replace exists exactly within the Original Code.
   - The Replacement Code is a valid substitute for that chunk.
   - The Replacement Code does not contain invalid characters at the beginning or the end which would not fit into the whole text.

3. Correctness
   - No syntax errors introduced.
   - No obvious logical errors.
   - No broken references or inconsistencies caused by the replacement.

4. No Unjustified Changes
   - Only the specified chunk is conceptually modified.
   - Additional correct changes are allowed but should be noted in the evaluation.

5. No Clear Regressions
   - Previously valid functionality is not broken unless explicitly required by the Task.

6. VERY IMPORTANT: Full replacement required
   - <REPLACE_WITH> MUST include every part of <TARGET_TEXT> that remains unchanged.
   - Only the intended modification may differ.
   - Do NOT output only the changed line(s), field(s), or token(s) unless the entire <TARGET_TEXT> is intentionally being replaced.
   - Before producing <REPLACE_WITH>, compare it against <TARGET_TEXT> and verify that no surrounding text, function calls, variables, arguments, attributes, imports, fields, formatting, or delimiters were accidentally removed.
   - Treat <REPLACE_WITH> as the final text that will overwrite <TARGET_TEXT> verbatim. The output will not be merged with <TARGET_TEXT> automatically.
   - If <TARGET_TEXT> is:
       foo(
           bar="x",
           status="open",
           baz="y"
       )
     and only `status` changes, then <REPLACE_WITH> must be:
       foo(
           bar="x",
           status="closed",
           baz="y"
       )
     NOT:
       status="closed"

	
Evaluation Rules for Text/Reports:

- Always APPROVE textual artifacts unless they break structural formatting.

Required Output Format:

<evaluation>
Concise explanation of why the patch can be approved, including notes on any additional changes that may be required.
</evaluation>
<statement>
APPROVED
</statement>

OR

<evaluation>
Concise explanation of why the patch cannot be approved, including notes on any additional changes that may be required.
</evaluation>
<statement>
DECLINED
</statement>

Rules:

- <evaluation> must contain a brief justification.
- <statement> must contain only one word: APPROVED or DECLINED.
- Do not include any additional text outside these tags.
- Decision must be binary and final.			
)";
			
			new_content = old_content.replace_ignoring_whitespace(original, edit);
			
			if(edit != original)
			{			
				agt.report_back("evaluating... ");
				
				managed tmp_agt = agt.simple_agent(confirm_agent);
				eval_result = tmp_agt.text("<ORIGINAL_TEXT>\n" + old_content + "\n</ORIGINAL_TEXT>\n\n\n<TARGET_TEXT>\n" + original + "\n</TARGET_TEXT>\n\n\n<REPLACE_WITH>\n" + edit + "\n</REPLACE_WITH>\n\n\n<TASK>\n" + current_task + "\n</TASK>\n\n\n<INTENTION>\n" + args.intention + "\n</INTENTION>");
				
				eval = eval_result.extract("<evaluation>", "</evaluation>").strip();
				approve = eval_result.extract("<statement>", "</statement>").strip();
				
				agt.report_back(approve + "\n");
				
				if(approve.lowercase().find("decline") >= 0)
				{
					return [
						ok = false,
						error = "The requested file change was not approved because:\n" + eval,
					];
				}
				
				if(agt.on_action) {
					agt.on_action([
						operation="edit",
						old_content=old_content,
						new_content=new_content,
						path=fileio.absolute_path(args.path),
					]);
				}
			}
			
			agt._log_action("edit", [
				path = args.path,
				prev_content = agt.filesystem.read_text(args.path),
				new_content = new_content,
			]);
			
			agt.filesystem.write_text(args.path, new_content);
				
			return [
					ok = true,
					status = "Edit was applied successfully.",
				];
		}
	);
	
	/* sounds good on paper, somewhat fails spectaculary
