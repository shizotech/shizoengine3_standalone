	agt.add_tool(
		"mkdir",
		"FILE OPERATION - Create a directory",
		[
			path = "&string(): Create a directory (and all sub-directories)",
		],
		[](agt, args)
		{
			if(args.path.starts("/")) {
				return [
					ok = false,
					error = "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !",
				];
			}
			
			if(agt.filesystem.mkdir(args.path)) {
				
				agt._log_action("mkdir", [
					path = args.path,
					existed_before = agt.filesystem.exists(args.path),
				]);
				
				return "Success";
			}
			
			return "Failed to create directory.";
		}
	);
		
	agt.add_tool(
		"move",
		"FILE OPERATION - Move a file or directory.",
		[
			src_path = "&string(): Source path.",
			dst_path = "&string(): Destination path.",
		],
		[](agt, args)
		{
			if(args.src_path.starts("/"))
				return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
			
			if(agt.filesystem.move(args.src_path, args.dst_path)) {
				agt._log_action("move", [
					src_path = args.src_path,
					dst_path = args.dst_path,
					existed_before = agt.filesystem.exists(args.dst_path),
				]);
				
				return "Success";
			}
			
			return "Failed to move file.";
		}
	);
	
	agt.add_tool(
		"copy",
		"FILE OPERATION - Copy a file or directory.",
		[
			src_path = "&string(): Source path.",
			dst_path = "&string(): Destination path.",
		],
		[](agt, args)
		{
			if(args.src_path.starts("/"))
				return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
			
			if(agt.filesystem.copy(args.src_path, args.dst_path)) {
				agt._log_action("copy", [
					src_path = args.src_path,
					dst_path = args.dst_path,
					existed_before = agt.filesystem.exists(args.dst_path),
				]);
				
				return "Success";
			}
			
			return "Failed to copy file.";
		}
	);
	
	agt.add_tool(
		"rename",
		"FILE OPERATION - Rename a file or directory.",
		[
			src_path = "&string(): Source path.",
			dst_path = "&string(): Destination path.",
		],
		[](agt, args)
		{
			if(args.src_path.starts("/"))
				return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
			
			if(agt.filesystem.rename(args.src_path, args.dst_path)) {
				agt._log_action("rename", [
					src_path = args.src_path,
					dst_path = args.dst_path,
				]);
				
				return "Success";
			}
			
			return "Failed to rename file.";
		}
	);
	
	agt.add_tool(
		"remove",
		"FILE OPERATION - DANGEROUS Remove a file or directory",
		[
			path = "&string(): Source path.",
			intention = "&string(): A clear and concise explanation *why* the file or directory needs to be removed.",
		],
		[](agt, args)
		{
			if(args.path.starts("/"))
				return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
		
			confirm_agent = R"(
System Prompt: Remove File Confirming Agent (Removing project files - Forgiving)

You are a File Removal Confirming Agent. Your responsibility is to determine whether a file can be safely deleted based on the given task and intention.

You will receive:

- <TASK> – a description of the current running task
- <INTENTION> – the intention why the file needs to be removed
- <ORIGINAL_FILE> – the full contents of the file to be removed

Your job is to evaluate whether the removal of the file is justified, given task and intention.

Required Output Format:

<evaluation>
Concise explanation of why the file can be removed safely and how the intention satisfies the task.
</evaluation>
<statement>
APPROVED
</statement>

OR

<evaluation>
Concise explanation of why the file cannot be removed safely and why the intention does not satisfy the task.
</evaluation>
<statement>
DECLINED
</statement>

Rules:

- <evaluation> must contain a brief justification.
- <statement> must contain only one word: APPROVED or DECLINED.
- Do not include any additional text outside these tags.
- Decision must be binary and final.			
)";
			
			if(!agt.filesystem.is_directory(args.path)) {
				agt.report_back("evaluating... ");
				
				current_task = agt.env["task"];
				old_content = agt.filesystem.read_text(args.path);
				if(old_content.empty())
					old_content = "<empty file>";
				
				tmp_agt = agt.simple_agent(confirm_agent);
				eval_result = tmp_agt.text("<TASK>\n" + current_task + "\n\n\n<INTENTION>\n" + args.intention + "\n\n\n<ORIGINAL_FILE>\n" + old_content);
				
				eval = eval_result.extract("<evaluation>", "</evaluation>").strip();
				approve = eval_result.extract("<statement>", "</statement>").strip();
				
				agt.report_back(approve + "\n");
				
				if(approve.lowercase().find("decline") >= 0)
				{
					return "The remove request could not be approved because:\n\n" + eval;
				}
			}
			else {
				if(agt.env.last_remove_check != args.path) {
					agt.env.last_remove_check = args.path;					
					return "Warning: a security check has been triggered. Please confirm that the removal of the directory is a required action and does not harm the integrity of the repo. Confirm that this action is legit and if so, call this function AGAIN with the exact same parameters to confirm this operation.";
				}				
			}
				
			if(agt.filesystem.remove(args.path)) {
				if(!agt.filesystem.is_directory(args.path)) {
					agt._log_action("remove_file", [
						path = args.path,
						prev_content = agt.filesystem.read_file(args.path),
					]);
				}
				
				return "Success";
			}
			
			return "Failed to remove.";
		}
	);
}

agt_add_skill_tools(agt) {
	agt.add_tool(
		"list_skills",
		"List all available skills",
		None,
		[](agt, args)
		{
			skills = agt.list_skills();
			if(!skills) {
				return [
					ok = 0,
					error = "No skills available.",
				];
			}
			
			return skills;
		}
	);
	
	agt.add_tool(
		"read_skill",
		"Read a skill",
		[
			name = "&string(): Name of the skill",
		],
		[](agt, args)
		{
			md = agt.load_skill(args.name);
			
			if(!md) {
				return [
					ok = false,
					error = "No skill with that name was found.",
				];
			}
			
			return md;
		}
	);
}