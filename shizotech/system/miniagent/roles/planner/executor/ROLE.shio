
add_tools(agt)
{
	//This is needed because some models tend to loop forever without an exit...
	agt.add_read_tools();
	agt.add_code_read_tools();
	agt.add_write_tools();
	agt.add_skill_tools();
	
	agt.add_tool(
		"task_list",
		"Returns all tasks from the task board.",
		None,
		[](agt, args)
		{	
			return [tasks=agt.env.taskboard];
		}
	);
	
	agt.add_tool(
		"task_start",
		"Starts an open task from the taskboard.",
		[
			task_id = "&string(): The ID of the task to start.",
		],
		[](agt, args)
		{	
			if(agt.stopped)
				return "Error";
		
			tb = agt.env.taskboard;
			
			for(i = 0; i < tb.size(); i++) {
				if(tb[i].status == "in_progress" || tb[i].status == "verify")
					if(tb[i].task_id == args.task_id)
						return "Task already started.";
					else
						return "Illegal operation: another task is still in progress or verification!\ntask_id: " + tb[i].task_id;
			}
			
			for(i = 0; i < tb.size(); i++) {
				if(tb[i].task_id == args.task_id)
					if(tb[i].status == "halted")
						return "Illegal operation: cannot explicitly start a halted task, as they are managed internally and only unblock once their dependent in_progress task is finished.";
					if(tb[i].status == "finished" || tb[i].status == "failed")
						return "Error: tried to start an already finished task. Make sure there are actual 'open' tasks left and if not, call 'plan_finished'.";
					
					tb[i].status = "in_progress";
					agt.env.task_id = tb[i].task_id;
					agt.stop();
					return "Task started.";
			}
			
			return "Error: task_id was not found.";
		}
	);
	
	agt.add_tool(
		"task_continue",
		"Records that progress was made.",
		[
			journal_entry = "&string(): Journal entry for all the changes made.",
		],
		[](agt, args)
		{	
			if(agt.stopped)
				return "Error";
			
			if(!args.journal_entry)
				return "Error: empty journal_entry parameter!";
			
			if(!agt.env.task_id)
				return "Error: there is currently no in_progress task active! Either start or create a new task to further complete the goal, or call plan_finished.";
			
			//No matter what error, its a failure mode we rather escape before it escalates
			agt.stop();
			
			task_id = agt.env.task_id;
			
			if(!agt.env.journals[task_id])
				agt.env.journals[task_id] = [];
			
			agt.env.journals[task_id].push_back([
				entry = args.journal_entry,
				timestamp = std.timestamp(),
			]);
			
			return "Terminate now.";
		}
	);
	
	agt.add_tool(
		"task_end",
		"Mark the currently active task as completely finished.",
		[
			status = ["finished", "failed"],
			journal_entry = "&string(): The final journal entry for this task.",
		],
		[](agt, args)
		{	
			if(agt.stopped)
				return "Error";
		
			if(!args.journal_entry)
				return "Error: empty journal_entry parameter!";
			
			if(!agt.env.task_id)
				return "Error: there is currently no in_progress task active! Either start or create a new task to further complete the goal, or call plan_finished.";
			
			//No matter what error, its a failure mode we rather escape before it escalates
			agt.stop();
			
			tb = agt.env.taskboard;

			check_task_stack = [agt, tb](){
				for(1) {
					if(!agt.env.task_stack)
						return;
					last_task_id = agt.env.task_stack[-1];
					agt.env.task_stack.erase(-1);
					for(i = 0; i < tb.size(); i++) {
						if(tb[i].task_id == last_task_id)
							tb[i].status = "in_progress";
							agt.env.task_id = last_task_id;
							return;
					}
				}
			};
			
			task_id = agt.env.task_id;
			
			for(i = 0; i < tb.size(); i++) {
				if(tb[i].task_id == task_id)
					if(!agt.env.journals[task_id])
						agt.env.journals[task_id] = [];					
					agt.env.journals[task_id].push_back([
						entry = args.journal_entry,
						timestamp = std.timestamp(),
					]);
					if(tb[i].status == "in_progress")
						tb[i].status = "verify";
					else
						tb[i].status = args.status;
						agt.env.task_id = None;
						check_task_stack();
					return "Task updated.";
			}
			
			return "Error: task was not found (internal error).";
		}
	);
	
	agt.add_tool(
		"create_task",
		"Creates a new task for work that needs to be done now or later, and thats not covered by the current task.",
		[
			name = "&string(): Name of the new task.",
			description = "&string(): Description of the new task.",
			priority = ["normal", "immediate"],
		],
		[](agt, args)
		{	
			tb = agt.env.taskboard;
			
			if(args.priority == "immediate" && agt.env.task_id) {
				for(i = 0; i < tb.size(); i++) {
					if(tb[i].task_id == agt.env.task_id)
						tb[i].status = "halted";
						agt.env.task_stack.push_back(agt.env.task_id);
				}
			}			
			
			task_id = "task_"+std.random_hash(6);
			status = "open";
			
			if(args.priority == "immediate") {
				agt.stop();
				status = "in_progress";
				agt.env.task_id = task_id;
			}
			
			tb.push_back([
				task_id = task_id,
				name = args.name,
				description = args.description,
				status = status,
			]);
			
			return "New task '" + task_id + "' created.";
		}
	);
	
	agt.add_tool(
		"replace_task",
		"Replaces the current task with a new task, in case goals or directions change.",
		[
			name = "&string(): Name of the new task.",
			description = "&string(): Description of the new task.",
		],
		[](agt, args)
		{	
			if(agt.stopped)
				return "Error";
			if(!agt.env.task_id)
				return "Error: there is no task in_progress at the moment.";
		
			tb = agt.env.taskboard;
			
			for(i = 0; i < tb.size(); i++) {
				if(tb[i].task_id == agt.env.task_id)
					tb.erase(i);
					break;
			}		
			
			task_id = "task_"+std.random_hash(6);

			agt.env.task_id = task_id;
			
			tb.push_back([
				task_id = task_id,
				name = args.name,
				description = args.description,
				status = "in_progress",
			]);
			
			agt.stop();
			
			return "New task '" + task_id + "' created.";
		}
	);
	
	agt.add_tool(
		"switch_task",
		"Switch to another task even when the current task is not yet finished.\nCan only switch to other 'open' tasks.",
		[
			task_id = "&string(): The ID of the task to switch to.",
		],
		[](agt, args)
		{	
			if(agt.stopped)
				return "Error";
		
			if(!agt.env.task_id)
				return "Error: cannot switch to another task when there is no active task currently. Did you mean to call task_start maybe?";
		
			tb = agt.env.taskboard;

			if(!agt.env.task_stack)
				agt.env.task_stack = [];
			
			for(i = 0; i < tb.size(); i++) {
				if(tb[i].task_id == args.task_id) {
					
					if(tb[i].status != "open")
						return "Illegal operation: cannot explicitly start a halted, finished or failed task.";
					
					for(j = 0; j < tb.size(); j++) {
						if(tb[j].task_id == agt.env.task_id)
							tb[j].status = "halted";
							agt.env.task_stack.push_back(agt.env.task_id);
					}
					
					tb[i].status = "in_progress";
					agt.env.task_id = tb[i].task_id;
					agt.stop();
					return "Terminate now.";
				}
			}
				
			return "Error: task_id not found.";
		}
	);
	
	agt.add_tool(
		"plan_finished",
		"Signals that the entire goal has completed.",
		None,
		[](agt, args)
		{	
			if(agt.stopped)
				return "Error";
		
			tb = agt.env.taskboard;
			
			if(!agt.env.exit_check) {
				for(i = 0; i < tb.size(); i++) {
					if(tb[i].status == "open" || tb[i].status == "in_progress" || tb[i].status == "verify")
						agt.env.exit_check = 1;
						return "Illegal operation: there are still tasks labeled as 'open', 'in_progress' or 'verify', make sure that all tasks are either 'finished' or 'failed'.\nIn case you are sure this is not a mistake and you want to exit because there were too many failures, then call this function exactly one more time."; 
				}
			}
		
			agt.stop();
			
			agt.env.plan_finished = true;
			
			return "Exit now.";
		}
	);
}