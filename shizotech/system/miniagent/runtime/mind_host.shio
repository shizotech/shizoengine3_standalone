
// ═════════════════════════════════════════════════════════════════════════════
//  Mind host — runnable entry point for the Receptionist + Mind runtime
//
//  Usage:   shz runtime/mind_host.shio            (interactive)
//           shz runtime/mind_host.shio "your request"   (single request)
//
//  The host owns:
//    - one Receptionist agent (the router for user requests)
//    - the event dispatcher (runs Minds as short-lived LLM invocations)
//
//  Host commands:
//    /overview            all Minds and their lifecycle states
//    /actions [n]         compressed recent action history
//    /status              dispatcher + store statistics
//    /mind <id>           full detail of one Mind
//    /message <id> <text> enqueue a message into a Mind's mailbox
//    /stop <id>           request a Mind to stop
//    /notify [level]      show/set event notification level: all | notify | off
//    /clear               clear the receptionist transcript
//    /exit                quit
// ═════════════════════════════════════════════════════════════════════════════

#include "../miniagent"
#include "mind_dispatcher"

cfg_path = std.config_path("miniagent", "default_model");

cfg = ModelConfig();

mind_host_get_cfg() {
	if(cfg.load(cfg_path))
		return true;

	api_url = "";
	auth_token = "";
	model_name = "";
	max_ctx = 128000;
	max_running_agents = 4;

	for(1) {
		std.print("Enter v1 url ( e.g. http://localhost:8000 )");
		api_url = std.input(">>> ");

		std.print("Enter model name (OPTIONAL)");
		model_name = std.input(">>> ");

		std.print("Enter auth token (OPTIONAL)");
		auth_token = std.input(">>> ");

		std.print("Enter model context length (OPTIONAL)");
		max_ctx_num = std.int(std.input(">>> "));
		if(max_ctx_num > 0)
			max_ctx = max_ctx_num;

		std.print("Enter max simultaneous agents (OPTIONAL)");
		max_running_agents = std.int(std.input(">>> "));

		api_url = api_url.removesuffix("/v1/");
		api_url = api_url.removesuffix("/v1");
		api_url = api_url.removesuffix("/");

		if(cfg.set(api_url, auth_token, model_name, max_ctx, max_running_agents))
			break;

		std.print("Could not get an answer from the API.");
	}

	cfg.save(cfg_path);

	return true;
}

last_state = "";

mind_host_print(action) {
	if(action.text) {
		if(last_state != "text")
			last_state = "text";
			std.cout("\n");
		stdfcol("white");
		std.cout(action.text);
	}

	if(action.reasoning) {
		if(last_state != "reasoning")
			last_state = "reasoning";
			std.cout("\n");
		stdfcol("yellow");
		std.cout(action.reasoning);
	}

	if(action.tool_start) {
		stdfcol("yellow");
		std.cout("\n\n[TOOL] ", action.tool_start.name, "\n");
		stdfcol("white");
	}
}

mind_host_report(agt) {
	std.cout("\nTOKEN USAGE:\n");
	token_usage_global = std.global("_global_token_usage");
	std.cout(token_usage_global["usage"]);

	std.cout("\nMINDS:\n");
	ov = mind_overview();
	for(i = 0; i < ov.minds.size(); i++) {
		m = ov.minds[i];
		std.cout("  ", m.id, "  ", m.state, "  ", m.title, "\n");
		if(m.next_step)
			std.cout("        next: ", m.next_step, "\n");
	}
	std.cout("pending events: ", ov.pending_events, "\n");
}

// ─────────────────────────────────────────────────────────────────────────────

mind_host_get_cfg();

receptionist = miniagent(cfg, "receptionist");

receptionist.on_action = [&last_state](action) {
	mind_host_print(action);
};

// The dispatcher is what executes Minds. Starting it here keeps the
// Receptionist strictly non-blocking: its tools only write to the store.
start = mind_ensure_dispatcher(receptionist);
std.cout("\nmind dispatcher: ", start.status, "  store: ", mind_store_root(), "\n");

if(std.argc() >= 2) {
	request = "";
	for(i = 1; i < std.argc(); i++) {
		if(i > 1)
			request += " ";
		request += std.argv(i);
	}

	receptionist.task(request);
	mind_host_report(receptionist);

	std.cout("\nThe request has been routed. Keep the host running to let Minds execute.\n");
}

for(1) {
	std.color("green");
	std.cout("\n>>> (user) ");

	cmd = std.input().strip();

	if(cmd == "exit" || cmd == "/exit")
		break;

	if(cmd.empty())
		continue;

	if(cmd.starts("/overview")) {
		std.cout(std.string(mind_overview()), "\n");
		continue;
	}

	if(cmd.starts("/actions")) {
		n = std.int(cmd.removeprefix("/actions").strip());
		if(n <= 0)
			n = 20;
		std.cout(std.string(mind_last_actions(n)), "\n");
		continue;
	}

	if(cmd.starts("/status")) {
		std.cout(std.string(mind_dispatcher_status()), "\n");
		std.cout(std.string(mind_stats()), "\n");
		continue;
	}

	if(cmd.starts("/mind")) {
		id = cmd.removeprefix("/mind").strip();
		std.cout(std.string(mind_detail(id)), "\n");
		continue;
	}

	if(cmd.starts("/message")) {
		rest = cmd.removeprefix("/message").strip();
		space = rest.find(" ");
		if(space < 0)
			std.cout("usage: /message <mind_id> <text>\n");
		else {
			res = mind_message(rest.substr(0, space), rest.substr(space + 1), [source = "user"]);
			if(res.ok) {
				del = mind_dispatcher_deliver(res.mind_id, res.message_id, res.event_id);
				res.delivery = del.status;
				res.delivery_note = del.note;
			}
			std.cout(std.string(res), "\n");
		}
		continue;
	}

	if(cmd.starts("/notify")) {
		rest = cmd.removeprefix("/notify").strip();
		if(rest)
			std.cout(std.string(mind_dispatcher_set_notify_level(rest)), "\n");
		else
			std.cout("notify level: ", mind_dispatcher_notify_level(), "\n");
		continue;
	}

	if(cmd.starts("/stop")) {
		id = cmd.removeprefix("/stop").strip();
		std.cout(std.string(mind_stop(id, "stopped by host user", [source = "user"])), "\n");
		continue;
	}

	if(cmd == "/clear") {
		receptionist.llm_api.context.clear();
		std.cout("Cleared receptionist history.\n");
		continue;
	}

	if(cmd.starts("/")) {
		std.cout("unknown command.\n");
		continue;
	}

	try {
		receptionist.task(cmd);
	}
	catch(e) {
		std.error("receptionist run failed: ", e);
	}

	mind_host_report(receptionist);
}

mind_dispatcher_stop();
std.cout("\nhost stopped.\n");
