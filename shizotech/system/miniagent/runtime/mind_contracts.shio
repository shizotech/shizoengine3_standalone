
// ═════════════════════════════════════════════════════════════════════════════
//  Mind System — Phase 1 Contracts
//
//  Machine readable counterpart of `mind_contracts.md`.
//  This file contains ONLY vocabulary and envelope builders: no I/O, no LLM,
//  no threading. Everything here is pure and can be unit tested headless.
//
//  Four distinct records, deliberately never merged:
//    Mind    — the durable goal owner (survives restarts)
//    Run     — one short-lived LLM invocation of a Mind
//    Message — an envelope sitting in a Mind's mailbox
//    Event   — an authoritative lifecycle transition emitted by the runtime
// ═════════════════════════════════════════════════════════════════════════════

MIND_CONTRACT_VERSION = 1;

// Durable store root, relative to the working directory of the host process.
MIND_STORE_DIR = ".agent/mind/";

MIND_STORE_STATE_FILE = "state.json";
MIND_STORE_JOURNAL_FILE = "events.jsonl";

// Name of the shared in-process store object (std.global) and of the named
// critical section guarding every mutation of it.
MIND_GLOBAL_NAME = "mind_store";
MIND_LOCK_NAME = "mind_store_lock";

// ─── Lifecycle states (plan §5.2) ───────────────────────────────────────────

MIND_STATE_STARTING = "starting";
MIND_STATE_ACTIVE = "active";
MIND_STATE_WAITING = "waiting";
MIND_STATE_BLOCKED = "blocked";
MIND_STATE_COMPLETED = "completed";
MIND_STATE_FAILED = "failed";
MIND_STATE_STOP_REQUESTED = "stop_requested";
MIND_STATE_STOPPED = "stopped";

MIND_STATES = [
	"starting",
	"active",
	"waiting",
	"blocked",
	"completed",
	"failed",
	"stop_requested",
	"stopped",
];

// States from which no further transition is possible without an explicit
// reactivation request.
MIND_TERMINAL_STATES = ["completed", "failed", "stopped"];

// Legal transitions. Enforced by the runtime, not by prompt wording (plan §8).
//
// Note the deliberate absence of "stop_requested" -> "completed": a stopped
// goal can never be marked as completed by construction (plan §6.4).
MIND_TRANSITIONS = [
	starting = ["active", "waiting", "blocked", "completed", "failed", "stop_requested", "stopped"],
	active = ["active", "waiting", "blocked", "completed", "failed", "stop_requested", "stopped"],
	waiting = ["active", "blocked", "completed", "failed", "stop_requested", "stopped"],
	blocked = ["active", "waiting", "completed", "failed", "stop_requested", "stopped"],
	stop_requested = ["stopped", "failed"],
	completed = [],
	failed = [],
	stopped = [],
];

// ─── Event types (plan §6.3) ────────────────────────────────────────────────

MIND_EVENT_TYPES = [
	"mind.created",
	"mind.started",
	"mind.waiting",
	"mind.progress",
	"mind.blocked",
	"mind.completed",
	"mind.failed",
	"mind.stop_requested",
	"mind.stopped",
	"mind.message_received",
	// runtime-internal transitions that still need to be durable
	"mind.run_started",
	"mind.run_finished",
	"mind.run_failed",
	"mind.recovered",
	"mind.reactivated",
];

// Event delivery bookkeeping (at-least-once delivery + idempotent handling).
MIND_DELIVERY_PENDING = "pending";
MIND_DELIVERY_CLAIMED = "claimed";
MIND_DELIVERY_PROCESSED = "processed";
MIND_DELIVERY_FAILED = "failed";

// ─── Message states (plan §6.2) ─────────────────────────────────────────────

MIND_MESSAGE_QUEUED = "queued";
MIND_MESSAGE_DELIVERED = "delivered";
MIND_MESSAGE_PROCESSED = "processed";

MIND_MESSAGE_KINDS = ["instruction", "info", "answer", "stop"];

// ─── Run states ─────────────────────────────────────────────────────────────

MIND_RUN_RUNNING = "running";
MIND_RUN_FINISHED = "finished";
MIND_RUN_FAILED = "failed";
MIND_RUN_STOPPED = "stopped";

// ─── Execution shapes (plan §2.5 / §5.5) ────────────────────────────────────

MIND_SHAPES = ["unknown", "one_shot", "recurring", "iterative"];

// ─── Helpers ────────────────────────────────────────────────────────────────

mind_new_id(prefix) {
	return prefix + "_" + std.random_hash(10);
}

mind_now_ms() {
	return std.millis();
}

mind_now_str() {
	return std.date("%Y-%m-%d %H:%M:%S");
}

mind_is_state(state) {
	for(i = 0; i < MIND_STATES.size(); i++)
		if(MIND_STATES[i] == state)
			return true;
	return false;
}

mind_is_terminal(state) {
	for(i = 0; i < MIND_TERMINAL_STATES.size(); i++)
		if(MIND_TERMINAL_STATES[i] == state)
			return true;
	return false;
}

mind_is_event_type(type) {
	for(i = 0; i < MIND_EVENT_TYPES.size(); i++)
		if(MIND_EVENT_TYPES[i] == type)
			return true;
	return false;
}

mind_allowed_transition(from, to) {
	if(!MIND_TRANSITIONS.has(from))
		return false;
	targets = MIND_TRANSITIONS[from];
	for(i = 0; i < targets.size(); i++)
		if(targets[i] == to)
			return true;
	return false;
}

// Clip text for compact views without relying on substr clamping behaviour.
mind_clip(text, max_chars) {
	text = std.string(text ?? "");
	if(max_chars <= 0)
		return "";
	if(text.size() <= max_chars)
		return text;
	return text.substr(0, max_chars) + "...[truncated]";
}

mind_clip_lines(text, max_chars) {
	text = std.string(text ?? "");
	nl = text.find("\n");
	if(nl >= 0)
		text = text.substr(0, nl);
	return mind_clip(text, max_chars);
}

// ─── Record builders ────────────────────────────────────────────────────────

// The Mind record: the durable goal owner. Field set = plan §5.3.
mind_new_mind(goal, context = "", opts = None) {
	opts = opts ?? [];
	now = mind_now_ms();
	id = (opts.id ?? "") ? opts.id : mind_new_id("mind");

	rec = [
		id = id,
		contract_version = MIND_CONTRACT_VERSION,

		created_ms = now,
		created_at = mind_now_str(),
		updated_ms = now,
		title = mind_clip_lines(opts.title ?? goal, 100),

		// Original request and the conversational context handed over by the
		// Receptionist. Never rewritten by the Mind.
		request = [
			text = std.string(goal ?? ""),
			context = std.string(context ?? ""),
			source = std.string(opts.source ?? "user"),
			request_id = std.string(opts.request_id ?? ""),
		],

		// Mind-owned interpretation of the request.
		goal = std.string(goal ?? ""),
		success_criteria = [],
		execution_shape = "unknown",
		plan = [strategy = "", next_step = ""],
		taskroutes = [],
		workflow = [],
		outstanding = [],
		decisions = [],
		assumptions = [],
		approvals = [],
		blockers = [],
		waiting_for = "",

		// Lifecycle
		state = MIND_STATE_STARTING,
		state_reason = "created",
		state_history = [],

		// Progress bookkeeping
		counters = [runs = 0, failures = 0, retries = 0, messages = 0, progress = 0],

		// Continuity: recent event/action references, bounded
		recent = [],

		// Durable completion notification condition (plan §5.8 / §6.6)
		notification = [
			wanted = (opts.notification_condition ?? false) ? true : false,
			condition = std.string(opts.notification_condition ?? ""),
			registered_ms = (opts.notification_condition ?? false) ? now : 0,
			delivered = false,
		],

		// Deduplication (plan §6.1)
		idempotency_key = std.string(opts.idempotency_key ?? opts.request_id ?? ""),

		// Causality chain
		correlation_id = std.string(opts.correlation_id ?? id),
		last_event_seq = 0,

		// Mailbox of queued messages (plan §6.2)
		mailbox = [],

		// Run ids owned by this Mind (a Mind is NOT a run)
		runs = [],
		active_run = "",

		// Terminal outcome
		outcome = [status = "", report = "", evidence = "", verified = false, ms = 0],
	];

	return rec;
}

// Event envelope (plan §6.3): stable id, timestamp, target mind, correlation
// and causation ids. Emitted from authoritative state transitions only.
mind_new_event(type, mind_id = "", data = None, opts = None) {
	opts = opts ?? [];
	now = mind_now_ms();

	return [
		id = (opts.id ?? "") ? opts.id : mind_new_id("evt"),
		seq = 0, // assigned by the store, monotonic
		ts = now,
		timestamp = mind_now_str(),
		type = std.string(type),
		mind_id = std.string(mind_id ?? ""),
		run_id = std.string(opts.run_id ?? ""),
		correlation_id = std.string(opts.correlation_id ?? ""),
		causation_id = std.string(opts.causation_id ?? ""),
		source = std.string(opts.source ?? "runtime"),
		data = data ?? [],
		delivery = [
			status = MIND_DELIVERY_PENDING,
			attempts = 0,
			claimed_ms = 0,
			processed_ms = 0,
			handler = "",
		],
	];
}

// Message envelope (plan §6.2). Acceptance into the queue is NOT proof of
// processing, so the envelope carries its own status separate from the event.
mind_new_message(mind_id, body, opts = None) {
	opts = opts ?? [];
	now = mind_now_ms();

	return [
		id = (opts.id ?? "") ? opts.id : mind_new_id("msg"),
		mind_id = std.string(mind_id),
		from = std.string(opts.source ?? "receptionist"),
		kind = std.string(opts.kind ?? "instruction"),
		body = std.string(body ?? ""),
		correlation_id = std.string(opts.correlation_id ?? ""),
		causation_id = std.string(opts.causation_id ?? ""),
		idempotency_key = std.string(opts.idempotency_key ?? ""),
		status = MIND_MESSAGE_QUEUED,
		queued_ms = now,
		queued_at = mind_now_str(),
		delivered_ms = 0,
		processed_ms = 0,
	];
}

// Run record: one LLM invocation. Deliberately separate from the Mind.
mind_new_run(mind_id, event_id = "", opts = None) {
	opts = opts ?? [];
	now = mind_now_ms();

	return [
		id = (opts.id ?? "") ? opts.id : mind_new_id("run"),
		mind_id = std.string(mind_id),
		event_id = std.string(event_id ?? ""),
		trigger = std.string(opts.trigger ?? ""),
		correlation_id = std.string(opts.correlation_id ?? ""),
		causation_id = std.string(event_id ?? ""),
		status = MIND_RUN_RUNNING,
		effort = std.string(opts.effort ?? "medium"),
		started_ms = now,
		started_at = mind_now_str(),
		ended_ms = 0,
		summary = "",
		actions = [],
	];
}

// Compressed action-history entry for get_last_actions (plan §4.1).
// Identifies action + target, never implementation logs.
mind_new_action(kind, summary, opts = None) {
	opts = opts ?? [];
	now = mind_now_ms();

	return [
		seq = 0,
		ts = now,
		timestamp = mind_now_str(),
		kind = std.string(kind),
		mind_id = std.string(opts.mind_id ?? ""),
		correlation_id = std.string(opts.correlation_id ?? ""),
		summary = mind_clip(summary, 240),
		target = mind_clip(opts.target ?? "", 160),
	];
}

// ─── Validators ─────────────────────────────────────────────────────────────
// Each returns a list of problems. Empty list == valid.

mind_required_fields() {
	return [
		"id", "contract_version", "created_ms", "updated_ms", "title",
		"request", "goal", "success_criteria", "execution_shape", "plan",
		"taskroutes", "workflow", "outstanding", "decisions", "assumptions",
		"approvals", "blockers", "waiting_for", "state", "state_reason",
		"state_history", "counters", "recent", "notification",
		"idempotency_key", "correlation_id", "last_event_seq", "mailbox",
		"runs", "active_run", "outcome",
	];
}

mind_validate_mind(rec) {
	problems = [];

	if(!std.is_json(rec)) {
		problems.push_back("mind record is not a json object");
		return problems;
	}

	required = mind_required_fields();
	for(i = 0; i < required.size(); i++)
		if(!rec.has(required[i]))
			problems.push_back("missing field: " + required[i]);

	if(rec.has("state") && !mind_is_state(rec.state))
		problems.push_back("unknown lifecycle state: " + std.string(rec.state));

	if(rec.has("execution_shape")) {
		found = false;
		for(i = 0; i < MIND_SHAPES.size(); i++)
			if(MIND_SHAPES[i] == rec.execution_shape)
				found = true;
		if(!found)
			problems.push_back("unknown execution shape: " + std.string(rec.execution_shape));
	}

	if(rec.has("state") && mind_is_terminal(rec.state) && !rec.has("outcome"))
		problems.push_back("terminal state without outcome record");

	return problems;
}

mind_required_event_fields() {
	return ["id", "seq", "ts", "timestamp", "type", "mind_id", "run_id",
		"correlation_id", "causation_id", "source", "data", "delivery"];
}

mind_validate_event(env) {
	problems = [];

	if(!std.is_json(env)) {
		problems.push_back("event envelope is not a json object");
		return problems;
	}

	required = mind_required_event_fields();
	for(i = 0; i < required.size(); i++)
		if(!env.has(required[i]))
			problems.push_back("missing field: " + required[i]);

	if(env.has("type") && !mind_is_event_type(env.type))
		problems.push_back("unknown event type: " + std.string(env.type));

	if(env.has("seq") && env.seq < 1)
		problems.push_back("event seq must be assigned by the store (>= 1)");

	return problems;
}

mind_required_message_fields() {
	return ["id", "mind_id", "from", "kind", "body", "correlation_id",
		"causation_id", "idempotency_key", "status", "queued_ms", "queued_at",
		"delivered_ms", "processed_ms"];
}

mind_validate_message(env) {
	problems = [];

	if(!std.is_json(env)) {
		problems.push_back("message envelope is not a json object");
		return problems;
	}

	required = mind_required_message_fields();
	for(i = 0; i < required.size(); i++)
		if(!env.has(required[i]))
			problems.push_back("missing field: " + required[i]);

	if(env.has("kind")) {
		found = false;
		for(i = 0; i < MIND_MESSAGE_KINDS.size(); i++)
			if(MIND_MESSAGE_KINDS[i] == env.kind)
				found = true;
		if(!found)
			problems.push_back("unknown message kind: " + std.string(env.kind));
	}

	return problems;
}

mind_required_run_fields() {
	return ["id", "mind_id", "event_id", "trigger", "correlation_id",
		"causation_id", "status", "effort", "started_ms", "started_at",
		"ended_ms", "summary", "actions"];
}

mind_validate_run(rec) {
	problems = [];

	if(!std.is_json(rec)) {
		problems.push_back("run record is not a json object");
		return problems;
	}

	required = mind_required_run_fields();
	for(i = 0; i < required.size(); i++)
		if(!rec.has(required[i]))
			problems.push_back("missing field: " + required[i]);

	return problems;
}
