
// ═════════════════════════════════════════════════════════════════════════════
//  Mind System — Runtime state owner (Phase 1 data model + Phase 2 semantics)
//
//  The runtime, not an LLM transcript, owns durable state (plan §13).
//  This module is pure shizoscript: no LLM, no network, no threads. It is
//  therefore fully testable headless (see tests/mind_runtime_test.shio).
//
//  Durability model:
//    .agent/mind/state.json    checkpoint (authoritative full state)
//    .agent/mind/events.jsonl  append-only lifecycle event journal
//
//  Crash recovery: load checkpoint, replay journal tail, reconcile in-flight
//  runs, re-deliver unprocessed events.
//
//  Concurrency: every mutation runs inside the named critical section
//  MIND_LOCK_NAME (recursive per task). Goal-state mutations are serialized
//  per Mind by the dispatcher (plan §11.4).
// ═════════════════════════════════════════════════════════════════════════════

#include "mind_contracts"

// Bounded sizes — nothing in this store grows without limit.
MIND_RECENT_MAX = 12;
MIND_ACTION_LOG_MAX = 300;
MIND_MAILBOX_MAX = 100;
MIND_EVENT_LOG_MAX = 4000;
MIND_MIND_RUNS_MAX = 50;
MIND_STATE_HISTORY_MAX = 40;
MIND_OVERVIEW_GOAL_CLIP = 220;

// Forward declarations: shizoscript resolves calls by source position, and the
// loader/replay path is mutually recursive.
def mind_load();
def mind_journal_append(ev);
def mind_compact_journal();
def mind_replay_journal();
def mind_replay_event(ev);
def mind_reconcile();
def mind_emit(type, mind_id, data, opts);
def mind_prune_events();
def mind_action(kind, summary, opts);
def mind_recent(mind_id, text);
def mind_mailbox_has(mind, message_id);

// ─────────────────────────────────────────────────────────────────────────────
// Store bootstrap
// ─────────────────────────────────────────────────────────────────────────────

mind_fresh_state() {
	return [
		version = MIND_CONTRACT_VERSION,
		seq = 0,
		checkpoint_seq = 0,
		created_ms = mind_now_ms(),
		minds = [],
		messages = [],
		runs = [],
		events = [],
		actions = [],
	];
}

mind_set_root(path) {
	g = std.global(MIND_GLOBAL_NAME);

	root = std.string(path);
	if(root.empty())
		root = MIND_STORE_DIR;
	if(!root.ends("/"))
		root += "/";

	g.root = root;
	g.loaded = false;
	g.state = None;
	g.journal = "";

	if(!fileio.exists(root))
		fileio.mkdir(root);

	return root;
}

mind_store_root() {
	g = std.global(MIND_GLOBAL_NAME);
	if(!(g.root ?? false))
		mind_set_root(MIND_STORE_DIR);
	return g.root;
}

mind_state_path() {
	return mind_store_root() + MIND_STORE_STATE_FILE;
}

mind_journal_path() {
	return mind_store_root() + MIND_STORE_JOURNAL_FILE;
}

// Load on demand and return the shared store object.
mind_store() {
	g = std.global(MIND_GLOBAL_NAME);
	if(!(g.loaded ?? false))
		mind_load();
	return g;
}

// Internal-only accessor: never triggers a load, so it is safe to use from
// inside the load/replay path (mind_load sets g.state before replaying).
mind_raw_store() {
	g = std.global(MIND_GLOBAL_NAME);
	if(!(g.state ?? false))
		g.state = mind_fresh_state();
	return g;
}

// Atomic write: tmp file, remove target, move tmp into place.
mind_write_atomic(path, text) {
	tmp = path + ".tmp";

	if(fileio.write_string(tmp, text) == None)
		return false;

	if(fileio.exists(path))
		fileio.remove(path);

	fileio.move(tmp, path);

	return fileio.exists(path);
}

mind_persist() {
	g = mind_raw_store();

	g.state.checkpoint_seq = g.state.seq;

	if(!mind_write_atomic(mind_state_path(), std.string(g.state)))
		std.error("mind runtime: could not write checkpoint ", mind_state_path());

	mind_compact_journal();

	if(!mind_write_atomic(mind_journal_path(), std.string(g.journal ?? "")))
		std.error("mind runtime: could not write journal ", mind_journal_path());

	return true;
}

// The journal is an append-only string in seq order: JSON map iteration order is
// not insertion order, so it must never be rebuilt from the event map.
mind_journal_append(ev) {
	g = mind_raw_store();

	if(!std.is_string(g.journal))
		g.journal = "";

	g.journal += std.string(ev.compact_string()) + "\n";

	return g.journal.size();
}

// Keep only the newest MIND_EVENT_LOG_MAX lines (a suffix stays seq-ordered).
mind_compact_journal() {
	g = mind_raw_store();

	if(!std.is_string(g.journal))
		return 0;

	lines = g.journal.split("\n", -1, true);
	count = lines.size();

	if(count <= MIND_EVENT_LOG_MAX)
		return count;

	start = count - MIND_EVENT_LOG_MAX;

	out = "";
	for(i = start; i < count; i++)
		out += lines[i] + "\n";

	g.journal = out;

	return out.size();
}

// Trim a json list from the front down to max_len entries.
mind_trim_front(list, max_len) {
	for(list.size() > max_len)
		list.erase(0);
	return list.size();
}

// ─────────────────────────────────────────────────────────────────────────────
// Load + crash recovery
// ─────────────────────────────────────────────────────────────────────────────

mind_load() {
	g = std.global(MIND_GLOBAL_NAME);

	if(!(g.root ?? false))
		g.root = MIND_STORE_DIR;

	if(!fileio.exists(g.root))
		fileio.mkdir(g.root);

	saved = fileio.read_json(mind_state_path(), true);

	if(std.is_json(saved) && saved.has("minds"))
		g.state = saved;
	else
		g.state = mind_fresh_state();

	if(!(g.state.seq ?? false))
		g.state.seq = 0;
	if(!(g.state.checkpoint_seq ?? false))
		g.state.checkpoint_seq = 0;

	fields = ["minds", "messages", "runs", "events", "actions"];
	for(i = 0; i < fields.size(); i++)
		if(!g.state.has(fields[i]))
			g.state[fields[i]] = [];

	// Set the loaded flag before replaying: the replay path emits events and
	// must not re-enter the loader.
	g.loaded = true;
	g.recovered = false;

	journal = fileio.read_string(mind_journal_path());
	if(!std.is_string(journal))
		journal = "";
	g.journal = journal;

	mind_replay_journal();
	mind_reconcile();

	g.recovered = true;

	return g;
}

mind_replay_journal() {
	g = mind_raw_store();

	journal = fileio.read_string(mind_journal_path());
	if(!std.is_string(journal) || journal.empty())
		return 0;

	lines = journal.split("\n", -1, true);
	replayed = 0;

	for(i = 0; i < lines.size(); i++) {
		ev = std.json(lines[i], true);
		if(!std.is_json(ev) || !(ev.id ?? false))
			continue;

		if((ev.seq ?? 0) > g.state.seq)
			g.state.seq = ev.seq;

		if(g.state.events.has(ev.id))
			continue;

		g.state.events[ev.id] = ev;

		if((ev.seq ?? 0) > (g.state.checkpoint_seq ?? 0)) {
			mind_replay_event(ev);
			replayed++;
		}
	}

	return replayed;
}

// Fold one post-checkpoint event into the state. Must stay idempotent.
//
// JSON is copy-on-write: never mutate a record through a reference that the
// event data also holds. Store copies and write through direct member chains.
mind_replay_event(ev) {
	g = mind_raw_store();

	mind_id = std.string(ev.mind_id ?? "");

	if(ev.type == "mind.created" && mind_id && !g.state.minds.has(mind_id)) {
		if(std.is_json(ev.data.mind))
			g.state.minds[mind_id] = ev.data.mind.copy();
		return true;
	}

	if(!mind_id || !g.state.minds.has(mind_id))
		return false;

	if(ev.data.has("state") && mind_is_state(ev.data.state)) {
		g.state.minds[mind_id].state = ev.data.state;
		g.state.minds[mind_id].updated_ms = ev.ts;
	}

	if(ev.type == "mind.message_received" && std.is_json(ev.data.message)) {
		msg = ev.data.message;

		if(!g.state.messages.has(msg.id))
			g.state.messages[msg.id] = msg.copy();

		if(!mind_mailbox_has(g.state.minds[mind_id], msg.id))
			g.state.minds[mind_id].mailbox.push_back(msg.id);
	}

	return true;
}

mind_mailbox_has(mind, message_id) {
	for(i = 0; i < mind.mailbox.size(); i++)
		if(mind.mailbox[i] == message_id)
			return true;
	return false;
}

// Reconcile in-flight work after a restart: never assume success, never blindly
// repeat an irreversible action (plan §6.5).
mind_reconcile() {
	g = mind_raw_store();

	recovered = [];

	for(i = 0; i < g.state.runs.size(); i++) {
		key = g.state.runs.key(i);
		run = &g.state.runs[key];

		if(run.status != MIND_RUN_RUNNING)
			continue;

		run.status = MIND_RUN_FAILED;
		run.ended_ms = mind_now_ms();
		run.summary = "interrupted by runtime restart (outcome unknown, reconciled)";

		if(g.state.minds.has(run.mind_id)) {
			mind = &g.state.minds[run.mind_id];
			if(mind.active_run == run.id)
				mind.active_run = "";
			mind.counters.failures++;
		}
	}

	// A claimed event means a run was in flight: hand it back for delivery.
	for(i = 0; i < g.state.events.size(); i++) {
		key = g.state.events.key(i);
		ev = &g.state.events[key];

		if(ev.delivery.status != MIND_DELIVERY_CLAIMED)
			continue;

		ev.delivery.status = MIND_DELIVERY_PENDING;
		ev.delivery.handler = "";

		if(g.state.minds.has(ev.mind_id))
			recovered.push_back([event_id = ev.id, mind_id = ev.mind_id, type = ev.type]);
	}

	for(i = 0; i < recovered.size(); i++) {
		entry = recovered[i];
		mind_emit("mind.recovered", entry.mind_id, [
			summary = "runtime restart: in-flight event returned to the queue",
			redelivered_event = entry.event_id,
			redelivered_type = entry.type,
		], [source = "runtime"]);
	}

	return recovered;
}

// ─────────────────────────────────────────────────────────────────────────────
// Events
// ─────────────────────────────────────────────────────────────────────────────

mind_state_event_type(state) {
	if(state == MIND_STATE_STARTING)
		return "mind.created";
	if(state == MIND_STATE_ACTIVE)
		return "mind.started";
	if(state == MIND_STATE_WAITING)
		return "mind.waiting";
	if(state == MIND_STATE_BLOCKED)
		return "mind.blocked";
	if(state == MIND_STATE_COMPLETED)
		return "mind.completed";
	if(state == MIND_STATE_FAILED)
		return "mind.failed";
	if(state == MIND_STATE_STOP_REQUESTED)
		return "mind.stop_requested";
	if(state == MIND_STATE_STOPPED)
		return "mind.stopped";
	return "mind.progress";
}

mind_emit(type, mind_id = "", data = None, opts = None) {
	g = mind_raw_store();
	opts = opts ?? [];

	ev = mind_new_event(type, mind_id, data, opts);

	g.state.seq++;
	ev.seq = g.state.seq;

	if(!(ev.correlation_id ?? false) && mind_id && g.state.minds.has(mind_id))
		ev.correlation_id = g.state.minds[mind_id].correlation_id;

	g.state.events[ev.id] = ev;

	mind_journal_append(ev);

	mind_prune_events();

	return ev;
}

mind_prune_events() {
	g = mind_raw_store();

	total = 0;
	for(i = 0; i < g.state.events.size(); i++)
		total++;

	drop = total - MIND_EVENT_LOG_MAX;
	if(drop <= 0)
		return 0;

	dropped = 0;
	for(i = 0; i < g.state.events.size() && dropped < drop; i++) {
		key = g.state.events.key(i);
		ev = g.state.events[key];
		if(ev.delivery.status != MIND_DELIVERY_PROCESSED)
			continue;
		g.state.events.erase(key);
		dropped++;
		i--;
	}

	return dropped;
}

mind_event(event_id) {
	g = mind_store();
	if(!g.state.events.has(event_id))
		return None;
	return g.state.events[event_id];
}

mind_events(mind_id = "", limit = 50) {
	g = mind_store();

	out = [];
	for(i = 0; i < g.state.events.size(); i++) {
		key = g.state.events.key(i);
		ev = g.state.events[key];
		if(mind_id && ev.mind_id != mind_id)
			continue;
		out.push_back(ev);
	}

	if(limit > 0)
		mind_trim_front(out, limit);

	return out;
}

mind_pending_events(mind_id = "") {
	g = mind_store();

	out = [];
	for(i = 0; i < g.state.events.size(); i++) {
		key = g.state.events.key(i);
		ev = g.state.events[key];
		if(ev.delivery.status != MIND_DELIVERY_PENDING)
			continue;
		if(!ev.mind_id)
			continue;
		if(mind_id && ev.mind_id != mind_id)
			continue;
		out.push_back(ev);
	}

	return out;
}

mind_claim_event(event_id, handler = "dispatcher") {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	g = mind_store();

	if(!g.state.events.has(event_id))
		return [ok = false, error = "event_not_found", event_id = event_id];

	ev = &g.state.events[event_id];

	// At-least-once delivery + idempotent handling: a processed event is never
	// delivered a second time.
	if(ev.delivery.status == MIND_DELIVERY_PROCESSED)
		return [ok = false, status = "already_processed", event_id = event_id, mind_id = ev.mind_id, type = ev.type];

	if(ev.delivery.status == MIND_DELIVERY_CLAIMED)
		return [ok = false, status = "already_claimed", event_id = event_id, mind_id = ev.mind_id, type = ev.type];

	ev.delivery.status = MIND_DELIVERY_CLAIMED;
	ev.delivery.attempts++;
	ev.delivery.claimed_ms = mind_now_ms();
	ev.delivery.handler = std.string(handler);

	mind_persist();

	return [ok = true, status = "claimed", event_id = event_id, mind_id = ev.mind_id, type = ev.type, seq = ev.seq];
}

mind_mark_event(event_id, status = MIND_DELIVERY_PROCESSED, handler = "") {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	g = mind_store();

	if(!g.state.events.has(event_id))
		return [ok = false, error = "event_not_found", event_id = event_id];

	ev = &g.state.events[event_id];

	if(status == MIND_DELIVERY_PROCESSED && ev.delivery.status == MIND_DELIVERY_PROCESSED)
		return [ok = true, status = "processed", event_id = event_id, note = "already marked processed (duplicate delivery)"];

	ev.delivery.status = std.string(status);

	if(status == MIND_DELIVERY_PROCESSED)
		ev.delivery.processed_ms = mind_now_ms();
	if(handler)
		ev.delivery.handler = std.string(handler);

	mind_persist();

	return [ok = true, status = std.string(status), event_id = event_id];
}

// ─────────────────────────────────────────────────────────────────────────────
// Action history (compressed, the backing store of get_last_actions)
// ─────────────────────────────────────────────────────────────────────────────

mind_action(kind, summary, opts = None) {
	g = mind_raw_store();
	opts = opts ?? [];

	entry = mind_new_action(kind, summary, opts);

	g.state.seq++;
	entry.seq = g.state.seq;

	g.state.actions.push_back(entry);

	mind_trim_front(g.state.actions, MIND_ACTION_LOG_MAX);

	return entry;
}

mind_last_actions(limit = 20) {
	g = mind_store();

	if(limit <= 0)
		limit = 20;

	total = g.state.actions.size();
	start = 0;
	if(total > limit)
		start = total - limit;

	ordered = [];
	for(i = total - 1; i >= start; i--)
		ordered.push_back(g.state.actions[i]);

	return [
		ok = true,
		count = ordered.size(),
		total_in_log = total,
		truncated = (total > ordered.size()),
		actions = ordered,
		note = "Compressed recent history for resolving references such as 'do that again'. Not a general historical search and not an implementation log.",
	];
}

// ─────────────────────────────────────────────────────────────────────────────
// Mind lifecycle
// ─────────────────────────────────────────────────────────────────────────────

mind_find_by_idempotency(key) {
	g = mind_store();

	if(!key)
		return None;

	for(i = 0; i < g.state.minds.size(); i++) {
		mkey = g.state.minds.key(i);
		rec = g.state.minds[mkey];
		if((rec.idempotency_key ?? "") == key)
			return rec;
	}

	return None;
}

mind_get(mind_id) {
	g = mind_store();
	if(!g.state.minds.has(mind_id))
		return None;
	return g.state.minds[mind_id];
}

mind_exists(mind_id) {
	return mind_get(mind_id) ? true : false;
}

mind_spawn(goal, context = "", opts = None) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	opts = opts ?? [];

	goal_text = std.string(goal ?? "").strip();
	if(goal_text.empty())
		return [ok = false, status = "rejected", error = "A Mind requires a non-empty goal."];

	g = mind_store();

	key = std.string(opts.idempotency_key ?? opts.request_id ?? "");

	// Duplicate delivery of the same request must not create duplicate Minds.
	if(key) {
		existing = mind_find_by_idempotency(key);
		if(existing)
			return [
				ok = true,
				deduplicated = true,
				mind_id = existing.id,
				status = "existing",
				state = existing.state,
				correlation_id = existing.correlation_id,
				created_at = existing.created_at,
				idempotency_key = key,
				note = "A Mind with this idempotency key already exists. No new Mind was created.",
			];
	}

	mind = mind_new_mind(goal_text, context, opts);
	mind.idempotency_key = key;

	g.state.minds[mind.id] = mind;

	// Goal creation and its initial event are one durable operation (plan §6.6).
	// data.mind is a copy: the journal must carry the creation-time snapshot, not
	// an alias of the live record, or replay would re-apply later mutations.
	ev = mind_emit("mind.created", mind.id, [
		mind = mind.copy(),
		goal = mind_clip_lines(mind.goal, 200),
		title = mind.title,
		request_id = mind.request.request_id,
		notification_wanted = mind.notification.wanted,
		summary = "Mind created",
	], [
		source = opts.source ?? "receptionist",
		correlation_id = mind.correlation_id,
	]);

	mind.last_event_seq = ev.seq;

	mind_action("spawn_mind", "Mind created for goal: " + mind_clip_lines(mind.goal, 160), [
		mind_id = mind.id,
		target = mind.title,
		correlation_id = mind.correlation_id,
	]);

	mind_persist();

	return [
		ok = true,
		deduplicated = false,
		mind_id = mind.id,
		status = "created",
		state = mind.state,
		event_id = ev.id,
		event_seq = ev.seq,
		correlation_id = mind.correlation_id,
		created_at = mind.created_at,
		title = mind.title,
		note = "The Mind was created and its initial event is queued. This call did NOT execute the goal.",
	];
}

mind_set_state(mind_id, state, reason = "", data = None, opts = None) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	g = mind_store();

	if(!mind_is_state(state))
		return [
			ok = false,
			status = "rejected",
			error = "unknown_lifecycle_state",
			state = std.string(state),
			allowed_states = MIND_STATES,
		];

	if(!g.state.minds.has(mind_id))
		return [ok = false, status = "not_found", mind_id = mind_id];

	mind = &g.state.minds[mind_id];
	from = mind.state;

	if(from == state)
		return [
			ok = true,
			status = "unchanged",
			mind_id = mind_id,
			state = state,
			previous_state = from,
			note = "The Mind is already in this state (idempotent).",
		];

	if(!mind_allowed_transition(from, state))
		return [
			ok = false,
			status = "illegal_transition",
			mind_id = mind_id,
			previous_state = from,
			state = std.string(state),
			allowed = MIND_TRANSITIONS[from],
			error = "Transition '" + std.string(from) + "' -> '" + std.string(state) + "' is not allowed by the lifecycle contract.",
		];

	opts = opts ?? [];
	now = mind_now_ms();

	mind.state = state;
	mind.state_reason = std.string(reason);
	mind.updated_ms = now;

	// The runtime owns waiting_for: entering waiting/blocked records what the
	// Mind waits for, any other transition clears it.
	if(std.is_json(data) && data.has("waiting_for"))
		mind.waiting_for = std.string(data.waiting_for);
	else
		mind.waiting_for = "";

	mind.state_history.push_back([state = state, from = from, reason = std.string(reason), ms = now]);
	mind_trim_front(mind.state_history, MIND_STATE_HISTORY_MAX);

	if(mind_is_terminal(state)) {
		outcome = std.is_json(data) ? data.copy() : [];
		outcome.status = state;
		outcome.ms = now;
		mind.outcome = outcome;
		mind.active_run = "";
	}

	ev_data = std.is_json(data) ? data.copy() : [];
	ev_data.state = state;
	ev_data.previous_state = from;
	ev_data.reason = std.string(reason);

	ev = mind_emit(mind_state_event_type(state), mind_id, ev_data, [
		source = opts.source ?? "runtime",
		correlation_id = opts.correlation_id ?? mind.correlation_id,
		causation_id = opts.causation_id ?? "",
		run_id = opts.run_id ?? "",
	]);

	mind.last_event_seq = ev.seq;

	mind_recent(mind_id, "state: " + std.string(from) + " -> " + state +
		(reason ? " (" + mind_clip_lines(reason, 120) + ")" : ""));

	mind_action("state:" + state, mind_clip_lines(reason ? reason : ("Mind entered state " + state), 160), [
		mind_id = mind_id,
		target = mind.title,
		correlation_id = mind.correlation_id,
	]);

	mind_persist();

	return [
		ok = true,
		status = "transitioned",
		mind_id = mind_id,
		state = state,
		previous_state = from,
		event_id = ev.id,
		event_seq = ev.seq,
		terminal = mind_is_terminal(state),
	];
}

mind_recent(mind_id, text) {
	g = mind_raw_store();

	if(!g.state.minds.has(mind_id))
		return false;

	mind = &g.state.minds[mind_id];
	mind.recent.push_back([ms = mind_now_ms(), timestamp = mind_now_str(), text = mind_clip(text, 200)]);
	mind_trim_front(mind.recent, MIND_RECENT_MAX);
	mind.updated_ms = mind_now_ms();

	return true;
}

// Mind-side goal state updates: goal, criteria, plan, taskroutes, decisions...
mind_update(mind_id, patch = None, opts = None) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	g = mind_store();

	if(!g.state.minds.has(mind_id))
		return [ok = false, status = "not_found", mind_id = mind_id];

	mind = &g.state.minds[mind_id];
	patch = patch ?? [];
	opts = opts ?? [];

	allowed = [
		"goal", "success_criteria", "execution_shape", "plan", "taskroutes",
		"workflow", "outstanding", "decisions", "assumptions", "approvals",
		"blockers", "waiting_for",
	];

	list_fields = ["success_criteria", "taskroutes", "workflow", "outstanding",
		"decisions", "assumptions", "approvals", "blockers"];

	accepted = [];
	rejected = [];

	for(i = 0; i < patch.size(); i++) {
		key = patch.key(i);

		found = false;
		for(j = 0; j < allowed.size(); j++)
			if(allowed[j] == key)
				found = true;

		if(!found) {
			rejected.push_back(key);
			continue;
		}

		value = patch[key];

		if(key == "goal") {
			mind.goal = std.string(value);
			accepted.push_back(key);
		}
		else if(key == "execution_shape") {
			shape = std.string(value);
			found_shape = false;
			for(j = 0; j < MIND_SHAPES.size(); j++)
				if(MIND_SHAPES[j] == shape)
					found_shape = true;
			if(!found_shape) {
				rejected.push_back("execution_shape:" + shape);
				continue;
			}
			mind.execution_shape = shape;
			accepted.push_back(key);
		}
		else if(key == "plan") {
			plan = std.is_json(value) ? value : [strategy = std.string(value)];
			if(plan.has("strategy"))
				mind.plan.strategy = std.string(plan.strategy);
			if(plan.has("next_step"))
				mind.plan.next_step = std.string(plan.next_step);
			accepted.push_back(key);
		}
		else {
			is_list_field = false;
			for(j = 0; j < list_fields.size(); j++)
				if(list_fields[j] == key)
					is_list_field = true;

			if(is_list_field && !std.is_json(value))
				mind[key] = [std.string(value)];
			else
				mind[key] = value;

			accepted.push_back(key);
		}
	}

	mind.updated_ms = mind_now_ms();
	mind.counters.progress++;

	summary = std.string(opts.summary ?? "");
	if(!summary)
		summary = "goal state updated: " + std.string(accepted);

	ev = mind_emit("mind.progress", mind_id, [
		updated = accepted,
		rejected = rejected,
		summary = mind_clip(summary, 240),
		goal = mind_clip_lines(mind.goal, 200),
		next_step = mind_clip_lines(mind.plan.next_step, 200),
	], [
		source = opts.source ?? "mind",
		run_id = opts.run_id ?? "",
		causation_id = opts.causation_id ?? "",
	]);

	mind.last_event_seq = ev.seq;
	mind_recent(mind_id, summary);

	mind_persist();

	return [
		ok = true,
		mind_id = mind_id,
		updated = accepted,
		rejected = rejected,
		event_id = ev.id,
		event_seq = ev.seq,
		state = mind.state,
	];
}

// Terminal reporting. A stop request can never be turned into a completion.
mind_report(mind_id, status, report = "", evidence = "", verified = false, opts = None) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	opts = opts ?? [];

	mind = mind_get(mind_id);
	if(!mind)
		return [ok = false, status = "not_found", mind_id = mind_id];

	if(status == "completed" && mind.state == MIND_STATE_STOP_REQUESTED)
		return [
			ok = false,
			status = "refused",
			mind_id = mind_id,
			state = mind.state,
			error = "A stop was requested for this Mind, so it cannot be reported as completed. Report 'failed' (terminated before the goal completed) and let the runtime confirm 'stopped'.",
		];

	if(status == "blocked")
		return mind_set_state(mind_id, MIND_STATE_BLOCKED, report, [
			summary = mind_clip(report, 2000),
			report = mind_clip(report, 2000),
			blockers = opts.blockers ?? [],
			needs = std.string(opts.needs ?? ""),
		], [source = opts.source ?? "mind", run_id = opts.run_id ?? "", causation_id = opts.causation_id ?? ""]);

	if(status != "completed" && status != "failed")
		return [
			ok = false,
			status = "rejected",
			given = std.string(status),
			error = "Terminal report status must be 'completed', 'failed' or 'blocked'.",
		];

	if(status == "completed" && !verified)
		return [
			ok = false,
			status = "refused",
			mind_id = mind_id,
			error = "A Mind may only report 'completed' with verification evidence: pass verified=true plus evidence stating what proves the completion criteria.",
		];

	res = mind_set_state(mind_id, status, report, [
		summary = mind_clip_lines(report, 240),
		report = mind_clip(report, 4000),
		evidence = mind_clip(evidence, 2000),
		verified = verified ? true : false,
	], [source = opts.source ?? "mind", run_id = opts.run_id ?? "", causation_id = opts.causation_id ?? ""]);

	if(res.ok)
		mind_action("report:" + status, mind_clip_lines(report, 160), [
			mind_id = mind_id,
			target = mind.title,
			correlation_id = mind.correlation_id,
		]);

	return res;
}

// ─────────────────────────────────────────────────────────────────────────────
// Messages (plan §6.2)
// ─────────────────────────────────────────────────────────────────────────────

mind_message(mind_id, body, opts = None) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	opts = opts ?? [];

	g = mind_store();

	if(!g.state.minds.has(mind_id))
		return [
			ok = false,
			status = "not_found",
			mind_id = mind_id,
			error = "No Mind with that id. Use get_overview to identify the responsible Mind.",
		];

	mind = &g.state.minds[mind_id];
	key = std.string(opts.idempotency_key ?? "");

	if(key) {
		for(i = 0; i < mind.mailbox.size(); i++) {
			msg_id = mind.mailbox[i];
			if(!g.state.messages.has(msg_id))
				continue;
			existing = g.state.messages[msg_id];
			if((existing.idempotency_key ?? "") == key)
				return [
					ok = true,
					deduplicated = true,
					message_id = existing.id,
					mind_id = mind_id,
					status = existing.status,
					note = "A message with this idempotency key is already in the mailbox.",
				];
		}
	}

	if(mind_is_terminal(mind.state))
		return [
			ok = false,
			status = "mind_terminal",
			mind_id = mind_id,
			state = mind.state,
			error = "This Mind is in a terminal state and no longer processes messages. Spawn a new Mind for independent follow-up work.",
		];

	msg = mind_new_message(mind_id, body, [
		source = opts.source ?? "receptionist",
		kind = opts.kind ?? "instruction",
		correlation_id = opts.correlation_id ?? mind.correlation_id,
		causation_id = opts.causation_id ?? "",
		idempotency_key = key,
	]);

	g.state.messages[msg.id] = msg;
	mind.mailbox.push_back(msg.id);

	mind_trim_front(mind.mailbox, MIND_MAILBOX_MAX);

	mind.counters.messages++;
	mind.updated_ms = mind_now_ms();

	ev = mind_emit("mind.message_received", mind_id, [
		summary = "message queued: " + mind_clip_lines(msg.body, 160),
		message_id = msg.id,
		kind = msg.kind,
		from = msg.from,
		preview = mind_clip_lines(msg.body, 200),
		message = msg,
		queue_depth = mind.mailbox.size(),
	], [
		source = opts.source ?? "receptionist",
		correlation_id = msg.correlation_id,
		causation_id = msg.causation_id,
	]);

	mind.last_event_seq = ev.seq;

	mind_action("send_message", "message queued for Mind: " + mind_clip_lines(msg.body, 160), [
		mind_id = mind_id,
		target = mind.title,
		correlation_id = msg.correlation_id,
	]);

	mind_persist();

	return [
		ok = true,
		deduplicated = false,
		message_id = msg.id,
		mind_id = mind_id,
		status = MIND_MESSAGE_QUEUED,
		queue_depth = mind.mailbox.size(),
		event_id = ev.id,
		event_seq = ev.seq,
		correlation_id = msg.correlation_id,
		note = "Queued into the Mind's mailbox only. This is not proof that the Mind processed it, nor that the requested action succeeded.",
	];
}

// Dispatcher side: hand the queued messages to a run and mark them delivered.
mind_mailbox_take(mind_id) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	g = mind_store();

	if(!g.state.minds.has(mind_id))
		return [];

	mind = &g.state.minds[mind_id];

	out = [];
	changed = false;

	for(i = 0; i < mind.mailbox.size(); i++) {
		msg_id = mind.mailbox[i];
		if(!g.state.messages.has(msg_id))
			continue;
		msg = g.state.messages[msg_id];
		if(msg.status == MIND_MESSAGE_QUEUED) {
			msg.status = MIND_MESSAGE_DELIVERED;
			msg.delivered_ms = mind_now_ms();
			changed = true;
		}
		out.push_back(msg);
	}

	if(changed)
		mind_persist();

	return out;
}

// Mark one queued message as delivered to a run/agent (plan §6.2 status chain).
mind_message_mark_delivered(message_id) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	g = mind_store();

	if(!g.state.messages.has(message_id))
		return [ok = false, error = "message_not_found", message_id = message_id];

	msg = g.state.messages[message_id];

	if(msg.status == MIND_MESSAGE_QUEUED) {
		msg.status = MIND_MESSAGE_DELIVERED;
		msg.delivered_ms = mind_now_ms();
		mind_persist();
	}

	return [ok = true, message_id = message_id, status = msg.status];
}

mind_message_mark_processed(message_id) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	g = mind_store();

	if(!g.state.messages.has(message_id))
		return [ok = false, error = "message_not_found", message_id = message_id];

	msg = g.state.messages[message_id];
	msg.status = MIND_MESSAGE_PROCESSED;
	msg.processed_ms = mind_now_ms();

	if(g.state.minds.has(msg.mind_id)) {
		mind = &g.state.minds[msg.mind_id];
		for(i = 0; i < mind.mailbox.size(); i++) {
			if(mind.mailbox[i] == message_id) {
				mind.mailbox.erase(i);
				break;
			}
		}
	}

	mind_persist();

	return [ok = true, message_id = message_id, status = MIND_MESSAGE_PROCESSED];
}

mind_message_state(message_id) {
	g = mind_store();
	if(!g.state.messages.has(message_id))
		return None;
	return g.state.messages[message_id];
}

// ─────────────────────────────────────────────────────────────────────────────
// Stop semantics (plan §6.4)
// ─────────────────────────────────────────────────────────────────────────────

mind_stop(mind_id, reason = "", opts = None) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	opts = opts ?? [];

	mind = mind_get(mind_id);
	if(!mind)
		return [ok = false, status = "not_found", mind_id = mind_id, confirmed = false, error = "No Mind with that id."];

	reason_text = std.string(reason ?? "");

	if(mind_is_terminal(mind.state))
		return [
			ok = true,
			status = mind.state,
			mind_id = mind_id,
			confirmed = true,
			idempotent = true,
			note = "The Mind is already in the terminal state '" + std.string(mind.state) + "'. No stop was needed.",
		];

	if(mind.state == MIND_STATE_STOP_REQUESTED)
		return [
			ok = true,
			status = MIND_STATE_STOP_REQUESTED,
			mind_id = mind_id,
			confirmed = false,
			idempotent = true,
			active_run = mind.active_run,
			note = "A stop was already requested. Termination is not confirmed yet.",
		];

	res = mind_set_state(mind_id, MIND_STATE_STOP_REQUESTED,
		reason_text ? reason_text : "stop requested", [
			summary = "stop requested",
			requested_by = opts.source ?? "receptionist",
			reason = reason_text,
			active_run = mind.active_run,
		], [source = opts.source ?? "receptionist", causation_id = opts.causation_id ?? ""]);

	if(!res.ok)
		return res;

	mind_action("stop_mind", "stop requested: " + mind_clip_lines(reason_text, 120), [
		mind_id = mind_id,
		target = mind.title,
		correlation_id = mind.correlation_id,
	]);

	mind_persist();

	return [
		ok = true,
		status = MIND_STATE_STOP_REQUESTED,
		confirmed = false,
		mind_id = mind_id,
		event_id = res.event_id,
		active_run = mind.active_run,
		note = "The stop request is recorded and the runner will be signalled. 'stopped' is confirmed by the runtime only once termination is established.",
	];
}

// Runtime-side confirmation, called by the dispatcher once the Mind is not
// running any more.
mind_confirm_stopped(mind_id, reason = "termination confirmed") {
	mind = mind_get(mind_id);
	if(!mind)
		return [ok = false, status = "not_found", mind_id = mind_id];

	if(mind.state != MIND_STATE_STOP_REQUESTED)
		return [ok = true, status = mind.state, mind_id = mind_id, confirmed = mind_is_terminal(mind.state)];

	res = mind_set_state(mind_id, MIND_STATE_STOPPED, reason, [
		summary = "Mind stopped (termination confirmed)",
		report = "Stopped before the goal necessarily completed.",
		evidence = "",
		verified = false,
		goal_completed = false,
	], [source = "runtime"]);

	if(res.ok)
		mind_action("stop_confirmed", "Mind stopped (termination confirmed)", [
			mind_id = mind_id,
			target = mind.title,
		]);

	return res;
}

// Explicit runtime operation: a terminal Mind is brought back. Not exposed to
// the Receptionist in this phase (plan §11.7).
mind_reactivate(mind_id, reason = "reactivated by user request") {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	g = mind_store();

	if(!g.state.minds.has(mind_id))
		return [ok = false, status = "not_found", mind_id = mind_id];

	mind = &g.state.minds[mind_id];

	if(!mind_is_terminal(mind.state))
		return [ok = true, status = "unchanged", mind_id = mind_id, state = mind.state];

	previous_outcome = mind.outcome.status;

	mind.state = MIND_STATE_ACTIVE;
	mind.state_reason = std.string(reason);
	mind.updated_ms = mind_now_ms();
	mind.active_run = "";
	mind.outcome = [status = "", report = "", evidence = "", verified = false, ms = 0];

	mind.state_history.push_back([state = MIND_STATE_ACTIVE, from = previous_outcome, reason = std.string(reason), ms = mind_now_ms()]);
	mind_trim_front(mind.state_history, MIND_STATE_HISTORY_MAX);

	ev = mind_emit("mind.reactivated", mind_id, [
		summary = "Mind reactivated from terminal state '" + std.string(previous_outcome) + "'",
		previous_outcome = previous_outcome,
		reason = std.string(reason),
	], [source = "runtime"]);

	mind.last_event_seq = ev.seq;

	mind_persist();

	return [
		ok = true,
		status = "reactivated",
		mind_id = mind_id,
		state = MIND_STATE_ACTIVE,
		previous_outcome = previous_outcome,
		event_id = ev.id,
		event_seq = ev.seq,
	];
}

// ─────────────────────────────────────────────────────────────────────────────
// Runs (one LLM invocation — never the Mind itself)
// ─────────────────────────────────────────────────────────────────────────────

mind_run_start(mind_id, event_id = "", opts = None) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	g = mind_store();

	if(!g.state.minds.has(mind_id))
		return [ok = false, status = "not_found", mind_id = mind_id];

	opts = opts ?? [];
	mind = &g.state.minds[mind_id];

	run = mind_new_run(mind_id, event_id, [
		trigger = opts.trigger ?? "",
		effort = opts.effort ?? "medium",
		correlation_id = mind.correlation_id,
	]);

	g.state.runs[run.id] = run;

	mind.runs.push_back(run.id);
	mind_trim_front(mind.runs, MIND_MIND_RUNS_MAX);

	mind.active_run = run.id;
	mind.counters.runs++;
	mind.updated_ms = run.started_ms;

	ev = mind_emit("mind.run_started", mind_id, [
		summary = "LLM run started (trigger: " + std.string(run.trigger) + ")",
		run_id = run.id,
		event_id = event_id,
		trigger = run.trigger,
	], [source = "runtime", run_id = run.id, causation_id = event_id]);

	mind.last_event_seq = ev.seq;

	mind_persist();

	return [ok = true, run_id = run.id, mind_id = mind_id, event_id = event_id, status = MIND_RUN_RUNNING, seq = ev.seq];
}

mind_run_end(run_id, status = MIND_RUN_FINISHED, summary = "", opts = None) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	g = mind_store();

	if(!g.state.runs.has(run_id))
		return [ok = false, status = "not_found", run_id = run_id];

	run = g.state.runs[run_id];

	if(run.status != MIND_RUN_RUNNING)
		return [ok = true, status = run.status, run_id = run_id, note = "run already ended (idempotent)"];

	opts = opts ?? [];

	run.status = std.string(status);
	run.ended_ms = mind_now_ms();
	run.summary = mind_clip(summary, 500);

	if(opts.actions)
		run.actions = opts.actions;

	if(g.state.minds.has(run.mind_id)) {
		mind = &g.state.minds[run.mind_id];
		if(mind.active_run == run_id)
			mind.active_run = "";
		if(status == MIND_RUN_FAILED)
			mind.counters.failures++;
		mind.updated_ms = run.ended_ms;
	}

	event_type = (status == MIND_RUN_FAILED) ? "mind.run_failed" : "mind.run_finished";

	ev = mind_emit(event_type, run.mind_id, [
		summary = mind_clip("run " + std.string(status), 200),
		run_id = run_id,
		event_id = run.event_id,
		status = run.status,
		duration_ms = run.ended_ms - run.started_ms,
	], [source = "runtime", run_id = run_id, causation_id = run.event_id]);

	if(g.state.minds.has(run.mind_id))
		g.state.minds[run.mind_id].last_event_seq = ev.seq;

	mind_persist();

	return [ok = true, run_id = run_id, status = run.status, event_id = ev.id];
}

mind_run(run_id) {
	g = mind_store();
	if(!g.state.runs.has(run_id))
		return None;
	return g.state.runs[run_id];
}

mind_runs(mind_id = "", limit = 20) {
	g = mind_store();

	out = [];
	for(i = 0; i < g.state.runs.size(); i++) {
		key = g.state.runs.key(i);
		run = g.state.runs[key];
		if(mind_id && run.mind_id != mind_id)
			continue;
		out.push_back(run);
	}

	if(limit > 0)
		mind_trim_front(out, limit);

	return out;
}

mind_run_active(mind_id) {
	mind = mind_get(mind_id);
	if(!mind || !mind.active_run)
		return None;
	run = mind_run(mind.active_run);
	if(!run || run.status != MIND_RUN_RUNNING)
		return None;
	return run;
}

// ─────────────────────────────────────────────────────────────────────────────
// Views
// ─────────────────────────────────────────────────────────────────────────────

mind_overview() {
	g = mind_store();

	minds = [];
	counts = [];

	for(i = 0; i < g.state.minds.size(); i++) {
		key = g.state.minds.key(i);
		m = g.state.minds[key];

		entry = [
			id = m.id,
			title = m.title,
			state = m.state,
			state_reason = mind_clip_lines(m.state_reason, 160),
			goal = mind_clip_lines(m.goal, MIND_OVERVIEW_GOAL_CLIP),
			execution_shape = m.execution_shape,
			next_step = mind_clip_lines(m.plan.next_step, 160),
			waiting_for = mind_clip_lines(m.waiting_for, 160),
			created_at = m.created_at,
			updated_ms = m.updated_ms,
			runs = m.counters.runs,
			failures = m.counters.failures,
			pending_messages = m.mailbox.size(),
			active_run = m.active_run,
			correlation_id = m.correlation_id,
			outcome_status = m.outcome.status,
		];

		if(m.outcome.report)
			entry.outcome_report = mind_clip_lines(m.outcome.report, 200);

		minds.push_back(entry);

		state_key = std.string(m.state);
		if(!counts.has(state_key))
			counts[state_key] = 0;
		counts[state_key]++;
	}

	return [
		ok = true,
		contract_version = MIND_CONTRACT_VERSION,
		store = mind_store_root(),
		seq = g.state.seq,
		generated_at = mind_now_str(),
		total_minds = minds.size(),
		states = counts,
		pending_events = mind_pending_events().size(),
		minds = minds,
		note = "Read-only snapshot of runtime state. This call does not wake, invoke or run any Mind.",
	];
}

mind_detail(mind_id) {
	mind = mind_get(mind_id);
	if(!mind)
		return [ok = false, status = "not_found", mind_id = mind_id];

	events = mind_events(mind_id, 20);
	compact_events = [];
	for(i = 0; i < events.size(); i++) {
		ev = events[i];
		compact_events.push_back([
			seq = ev.seq,
			timestamp = ev.timestamp,
			type = ev.type,
			delivery = ev.delivery.status,
			summary = mind_clip_lines(std.string(ev.data.summary ?? ev.data.reason ?? ev.data.state ?? ""), 160),
		]);
	}

	runs = mind_runs(mind_id, 10);
	compact_runs = [];
	for(i = 0; i < runs.size(); i++) {
		r = runs[i];
		compact_runs.push_back([
			id = r.id,
			status = r.status,
			trigger = r.trigger,
			started_at = r.started_at,
			summary = mind_clip_lines(r.summary, 160),
		]);
	}

	return [
		ok = true,
		mind = mind,
		events = compact_events,
		runs = compact_runs,
		validation = mind_validate_mind(mind),
	];
}

mind_stats() {
	g = mind_store();

	running = 0;
	for(i = 0; i < g.state.runs.size(); i++) {
		key = g.state.runs.key(i);
		if(g.state.runs[key].status == MIND_RUN_RUNNING)
			running++;
	}

	events_total = 0;
	for(i = 0; i < g.state.events.size(); i++)
		events_total++;

	return [
		ok = true,
		store = mind_store_root(),
		seq = g.state.seq,
		checkpoint_seq = g.state.checkpoint_seq,
		minds = g.state.minds.size(),
		runs = g.state.runs.size(),
		running_runs = running,
		messages = g.state.messages.size(),
		events = events_total,
		actions = g.state.actions.size(),
		pending_events = mind_pending_events().size(),
	];
}

// Durable completion-notification condition (plan §5.8 / §6.6).
mind_notify_register(mind_id, condition) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	g = mind_store();

	if(!g.state.minds.has(mind_id))
		return [ok = false, status = "not_found", mind_id = mind_id];

	mind = &g.state.minds[mind_id];
	mind.notification.wanted = true;
	mind.notification.condition = std.string(condition);
	mind.notification.registered_ms = mind_now_ms();
	mind.notification.delivered = false;

	ev = mind_emit("mind.progress", mind_id, [
		summary = "completion notification condition registered",
		condition = mind_clip(condition, 200),
	], [source = "runtime"]);

	mind.last_event_seq = ev.seq;

	mind_persist();

	return [ok = true, mind_id = mind_id, registered = true, event_id = ev.id];
}

mind_notify_mark_delivered(mind_id) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	g = mind_store();

	if(!g.state.minds.has(mind_id))
		return [ok = false, status = "not_found", mind_id = mind_id];

	mind = &g.state.minds[mind_id];
	mind.notification.delivered = true;

	mind_persist();

	return [ok = true, mind_id = mind_id, delivered = true];
}

// ─────────────────────────────────────────────────────────────────────────────
// Bounded invocation context (plan §7)
//
// Note: this hands the mailbox over to a run, so it marks queued messages as
// delivered. It is called by the dispatcher when a run is created, never by
// the Receptionist.
// ─────────────────────────────────────────────────────────────────────────────

mind_build_context(mind_id, event = None) {
	mind = mind_get(mind_id);
	if(!mind)
		return "No Mind with id " + std.string(mind_id) + ".";

	txt = "```goal_state\n" + std.string(mind.compact_string()) + "\n```\n\n";

	if(std.is_json(event)) {
		evt = [
			id = event.id,
			seq = event.seq,
			type = event.type,
			timestamp = event.timestamp,
			correlation_id = event.correlation_id,
			causation_id = event.causation_id,
			data = event.data,
		];
		txt += "```triggering_event\n" + std.string(evt.compact_string()) + "\n```\n\n";
	}

	messages = mind_mailbox_take(mind_id);
	if(messages.size())
		txt += "```mailbox\n" + std.string(messages.compact_string()) + "\n```\n\n";

	routes = "";
	for(i = 0; i < mind.taskroutes.size(); i++) {
		route = mind.taskroutes[i];
		path = std.string(route.path ?? "");
		if(!path || !fileio.exists(path))
			continue;
		routes += "--- taskroute: " + path + " ---\n" + fileio.read_string(path) + "\n\n";
	}

	if(routes)
		txt += routes;

	return txt;
}

// ─────────────────────────────────────────────────────────────────────────────
// Append one entry to a list field of a Mind (decisions, approvals, ...).
// ─────────────────────────────────────────────────────────────────────────────

mind_append_list(mind_id, field, entry, opts = None) {
	managed cs = std.critical_section(MIND_LOCK_NAME);

	opts = opts ?? [];

	g = mind_store();

	if(!g.state.minds.has(mind_id))
		return [ok = false, status = "not_found", mind_id = mind_id];

	allowed = ["success_criteria", "taskroutes", "workflow", "outstanding",
		"decisions", "assumptions", "approvals", "blockers"];

	ok_field = false;
	for(i = 0; i < allowed.size(); i++)
		if(allowed[i] == field)
			ok_field = true;

	if(!ok_field)
		return [ok = false, status = "rejected", field = std.string(field), allowed = allowed];

	mind = &g.state.minds[mind_id];

	list = mind[field].copy();
	list.push_back(entry);

	patch = [];
	patch[field] = list;

	return mind_update(mind_id, patch, [
		summary = opts.summary ? opts.summary : (std.string(field) + " appended"),
		source = opts.source ?? "mind",
		run_id = opts.run_id ?? "",
		causation_id = opts.causation_id ?? "",
	]);
}
