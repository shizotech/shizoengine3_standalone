// ═════════════════════════════════════════════════════════════════════════════
//  goal_time.shio — calendar math, IANA / POSIX time zones and work windows
//
//  #include "goal_time"
//
//  Everything here is plain arithmetic on epoch SECONDS (UTC). The runtime only
//  knows the machine's local time, so time zones are done in script:
//
//    * an IANA name (Europe/Berlin) is turned into its POSIX TZ rule
//      ("CET-1CEST,M3.5.0,M10.5.0/3"): first from the TZif file of the system
//      zoneinfo database (its footer holds the current rule), then from the
//      built-in table below (Windows has no zoneinfo).
//    * a POSIX TZ string is accepted directly as well.
//    * the rule gives the UTC offset of any instant, daylight saving included,
//      and turns a local wall time back into UTC (a time inside the spring
//      gap moves forward, a time inside the autumn overlap takes the first
//      occurrence).
//
//  Only the CURRENT rule of a zone is known (no historical transitions). That
//  is enough for scheduling, which only looks a few weeks around now.
//
//  Windows (schedule.start / end in local time):
//
//      gt_window_on(tz, days_since_epoch, "05:00", "10:00")  -> [start, end] UTC secs
//
//  An end at or before the start crosses midnight (22:00 - 06:00).
// ═════════════════════════════════════════════════════════════════════════════

GT_DAY = 86400;

GT_WEEKDAYS = ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"];
GT_WEEKDAYS_SHORT = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"];

// Fallback rules for systems without a zoneinfo database (Windows). The
// zoneinfo file wins when it exists, it is kept up to date by the OS.
GT_ZONES = [
	"UTC" = "UTC0",
	"Etc/UTC" = "UTC0",
	"GMT" = "GMT0",
	"Europe/Berlin" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/Vienna" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/Zurich" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/Paris" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/Amsterdam" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/Brussels" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/Madrid" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/Rome" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/Stockholm" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/Oslo" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/Copenhagen" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/Warsaw" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/Prague" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/Budapest" = "CET-1CEST,M3.5.0,M10.5.0/3",
	"Europe/London" = "GMT0BST,M3.5.0/1,M10.5.0",
	"Europe/Dublin" = "IST-1GMT0,M10.5.0,M3.5.0/1",
	"Europe/Lisbon" = "WET0WEST,M3.5.0/1,M10.5.0",
	"Europe/Helsinki" = "EET-2EEST,M3.5.0/3,M10.5.0/4",
	"Europe/Athens" = "EET-2EEST,M3.5.0/3,M10.5.0/4",
	"Europe/Kiev" = "EET-2EEST,M3.5.0/3,M10.5.0/4",
	"Europe/Kyiv" = "EET-2EEST,M3.5.0/3,M10.5.0/4",
	"Europe/Istanbul" = "<+03>-3",
	"Europe/Moscow" = "MSK-3",
	"America/New_York" = "EST5EDT,M3.2.0,M11.1.0",
	"America/Toronto" = "EST5EDT,M3.2.0,M11.1.0",
	"America/Chicago" = "CST6CDT,M3.2.0,M11.1.0",
	"America/Denver" = "MST7MDT,M3.2.0,M11.1.0",
	"America/Phoenix" = "MST7",
	"America/Los_Angeles" = "PST8PDT,M3.2.0,M11.1.0",
	"America/Vancouver" = "PST8PDT,M3.2.0,M11.1.0",
	"America/Anchorage" = "AKST9AKDT,M3.2.0,M11.1.0",
	"America/Mexico_City" = "CST6",
	"America/Sao_Paulo" = "<-03>3",
	"America/Argentina/Buenos_Aires" = "<-03>3",
	"Asia/Tokyo" = "JST-9",
	"Asia/Seoul" = "KST-9",
	"Asia/Shanghai" = "CST-8",
	"Asia/Hong_Kong" = "HKT-8",
	"Asia/Singapore" = "<+08>-8",
	"Asia/Bangkok" = "<+07>-7",
	"Asia/Jakarta" = "WIB-7",
	"Asia/Kolkata" = "IST-5:30",
	"Asia/Dubai" = "<+04>-4",
	"Australia/Sydney" = "AEST-10AEDT,M10.1.0,M4.1.0/3",
	"Australia/Melbourne" = "AEST-10AEDT,M10.1.0,M4.1.0/3",
	"Australia/Brisbane" = "AEST-10",
	"Australia/Perth" = "AWST-8",
	"Pacific/Auckland" = "NZST-12NZDT,M9.5.0,M4.1.0/3",
	"Africa/Johannesburg" = "SAST-2",
	"Africa/Cairo" = "EET-2EEST,M4.5.5/0,M10.5.4/24",
	"Africa/Lagos" = "WAT-1",
];

GT_ZONEINFO_DIRS = ["/usr/share/zoneinfo/", "/usr/lib/zoneinfo/", "/usr/share/lib/zoneinfo/", "/var/db/timezone/zoneinfo/"];

// ─────────────────────────────────────────────────────────────────────────────
//  Integer helpers (ints divide like C: toward zero)
// ─────────────────────────────────────────────────────────────────────────────

gt_floor_div(a, b) {
	q = a / b;

	if((a % b != 0) && ((a < 0) != (b < 0)))
		return q - 1;

	return q;
}

gt_mod(a, b) {
	return a - gt_floor_div(a, b) * b;
}

gt_pad2(n) {
	n = std.int(n);

	if(n < 10 && n >= 0)
		return "0" + std.string(n);

	return std.string(n);
}

gt_is_digit(c) {
	return c >= "0" && c <= "9" && c.length() == 1;
}

// "123" -> true, "" / "1a" / "-" -> false. Leading +/- allowed when signed.
gt_is_int_text(s, signed = false) {
	s = std.string(s);

	if(s.empty())
		return false;

	start = 0;
	if(signed && (s[0] == "-" || s[0] == "+"))
		start = 1;

	if(start >= s.length())
		return false;

	for(i = start; i < s.length(); i++) {
		if(!gt_is_digit(s[i]))
			return false;
	}

	return true;
}

// ─────────────────────────────────────────────────────────────────────────────
//  Civil calendar (proleptic Gregorian, H. Hinnant's algorithms)
// ─────────────────────────────────────────────────────────────────────────────

gt_is_leap(y) {
	return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
}

gt_month_days(y, m) {
	if(m == 2)
		return gt_is_leap(y) ? 29 : 28;

	if(m == 4 || m == 6 || m == 9 || m == 11)
		return 30;

	return 31;
}

// days since 1970-01-01
gt_days_from_civil(y, m, d) {
	if(m <= 2)
		y -= 1;

	era = gt_floor_div(y, 400);
	yoe = y - era * 400;
	mp = m > 2 ? m - 3 : m + 9;
	doy = (153 * mp + 2) / 5 + d - 1;
	doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;

	return era * 146097 + doe - 719468;
}

// -> [y, m, d]
gt_civil_from_days(z) {
	z += 719468;
	era = gt_floor_div(z, 146097);
	doe = z - era * 146097;
	yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
	y = yoe + era * 400;
	doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
	mp = (5 * doy + 2) / 153;
	d = doy - (153 * mp + 2) / 5 + 1;
	m = mp < 10 ? mp + 3 : mp - 9;

	if(m <= 2)
		y += 1;

	return [y, m, d];
}

// 0 = Sunday ... 6 = Saturday
gt_weekday(days) {
	return gt_mod(days + 4, 7);
}

// "monday" / "mon" / "Mo" / 1 -> 1, unknown -> -1
gt_weekday_index(name) {
	if(std.is_none(name))
		return -1;

	s = std.string(name).strip().lowercase();

	if(gt_is_int_text(s)) {
		n = std.int(s);
		if(n >= 0 && n <= 6)
			return n;
		if(n == 7)
			return 0;
		return -1;
	}

	for(i = 0; i < 7; i++) {
		if(s == GT_WEEKDAYS[i] || s == GT_WEEKDAYS_SHORT[i])
			return i;
	}

	// German / two-letter forms people write by hand
	alias = ["mo" = 1, "di" = 2, "tu" = 2, "mi" = 3, "we" = 3, "do" = 4, "th" = 4, "fr" = 5, "sa" = 6, "so" = 0, "su" = 0];
	if(alias.has(s))
		return alias[s];

	return -1;
}

// "2026-10-20" -> days, invalid -> None
gt_parse_date(text) {
	s = std.string(text ?? "").strip();
	parts = s.split("-");

	if(parts.size() != 3)
		return None;

	for(i = 0; i < 3; i++) {
		if(!gt_is_int_text(parts[i]))
			return None;
	}

	y = std.int(parts[0]);
	m = std.int(parts[1]);
	d = std.int(parts[2]);

	if(y < 1970 || y > 9999 || m < 1 || m > 12 || d < 1 || d > gt_month_days(y, m))
		return None;

	return gt_days_from_civil(y, m, d);
}

gt_format_date(days) {
	c = gt_civil_from_days(days);
	return std.string(c[0]) + "-" + gt_pad2(c[1]) + "-" + gt_pad2(c[2]);
}

// "05:00" / "5:00" / "05:00:30" / "24:00" -> seconds of the day, invalid -> None
gt_parse_clock(text) {
	s = std.string(text ?? "").strip();
	parts = s.split(":");

	if(parts.size() < 2 || parts.size() > 3)
		return None;

	for(i = 0; i < parts.size(); i++) {
		if(!gt_is_int_text(parts[i]) || parts[i].length() > 2)
			return None;
	}

	h = std.int(parts[0]);
	m = std.int(parts[1]);
	sec = parts.size() == 3 ? std.int(parts[2]) : 0;

	if(m > 59 || sec > 59)
		return None;

	if(h > 24 || (h == 24 && (m > 0 || sec > 0)))
		return None;

	return h * 3600 + m * 60 + sec;
}

gt_format_clock(secs) {
	secs = gt_mod(secs, GT_DAY);
	return gt_pad2(secs / 3600) + ":" + gt_pad2((secs % 3600) / 60);
}

// "90m" / "2h" / "1h30m" / "45" (minutes) / "1d" -> seconds, invalid -> None
gt_parse_duration(text) {
	if(std.is_none(text))
		return None;

	s = std.string(text).strip().lowercase().replace(" ", "");

	if(s.empty())
		return None;

	if(gt_is_int_text(s))
		return std.int(s) * 60;

	total = 0;
	num = "";
	any = false;

	for(c : s) {
		if(gt_is_digit(c)) {
			num += c;
			continue;
		}

		if(num.empty())
			return None;

		n = std.int(num);
		num = "";

		if(c == "d")
			total += n * GT_DAY;
		else if(c == "h")
			total += n * 3600;
		else if(c == "m")
			total += n * 60;
		else if(c == "s")
			total += n;
		else
			return None;

		any = true;
	}

	if(!num.empty())
		return None;

	return any ? total : None;
}

// ─────────────────────────────────────────────────────────────────────────────
//  POSIX TZ rules
//
//  zone = [ok, spec, std_name, std_off, has_dst, dst_name, dst_off, start, end, error]
//  offsets are seconds EAST of UTC (the POSIX text has the sign the other way).
//  start / end = [kind ("M" | "J" | "N"), month, week, wday, n, time]
// ─────────────────────────────────────────────────────────────────────────────

class gt_tz_reader {
	s = "";
	i = 0;
	error = "";

	__init__(text) {
		s = std.string(text);
		i = 0;
	}

	eof() {
		return i >= s.length();
	}

	peek() {
		if(i >= s.length())
			return "";
		return s[i];
	}

	is_alpha(c) {
		return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z");
	}

	name() {
		if(peek() == "<") {
			i++;
			out = "";
			for(!eof() && peek() != ">") {
				out += peek();
				i++;
			}
			if(peek() != ">") {
				error = "unterminated <name>";
				return None;
			}
			i++;
			return out;
		}

		out = "";
		for(!eof() && is_alpha(peek())) {
			out += peek();
			i++;
		}

		if(out.length() < 3) {
			error = "zone name needs 3+ letters";
			return None;
		}

		return out;
	}

	number() {
		out = "";
		for(!eof() && gt_is_digit(peek())) {
			out += peek();
			i++;
		}
		if(out.empty())
			return None;
		return std.int(out);
	}

	// [+|-]hh[:mm[:ss]] -> seconds (sign as written)
	hms(allow_sign = true) {
		sign = 1;
		if(allow_sign && (peek() == "+" || peek() == "-")) {
			if(peek() == "-")
				sign = -1;
			i++;
		}

		h = number();
		if(std.is_none(h)) {
			error = "expected hours";
			return None;
		}

		total = h * 3600;

		if(peek() == ":") {
			i++;
			m = number();
			if(std.is_none(m)) {
				error = "expected minutes";
				return None;
			}
			total += m * 60;

			if(peek() == ":") {
				i++;
				sec = number();
				if(std.is_none(sec)) {
					error = "expected seconds";
					return None;
				}
				total += sec;
			}
		}

		return sign * total;
	}

	// Mm.w.d | Jn | n, optional /time
	rule() {
		r = [kind = "M", month = 0, week = 0, wday = 0, n = 0, time = 7200];

		if(peek() == "M") {
			i++;
			r.month = number();
			if(peek() != ".") { error = "bad M rule"; return None; }
			i++;
			r.week = number();
			if(peek() != ".") { error = "bad M rule"; return None; }
			i++;
			r.wday = number();

			if(std.is_none(r.month) || std.is_none(r.week) || std.is_none(r.wday)
				|| r.month < 1 || r.month > 12 || r.week < 1 || r.week > 5 || r.wday < 0 || r.wday > 6) {
				error = "bad M rule";
				return None;
			}
		}
		else if(peek() == "J") {
			i++;
			r.kind = "J";
			r.n = number();
			if(std.is_none(r.n) || r.n < 1 || r.n > 365) { error = "bad J rule"; return None; }
		}
		else {
			r.kind = "N";
			r.n = number();
			if(std.is_none(r.n) || r.n > 365) { error = "bad day rule"; return None; }
		}

		if(peek() == "/") {
			i++;
			t = hms(true);
			if(std.is_none(t))
				return None;
			r.time = t;
		}

		return r;
	}
}

gt_tz_error(spec, msg) {
	return [ok = false, spec = spec, error = msg];
}

gt_tz_parse_posix(spec) {
	spec = std.string(spec ?? "").strip();

	if(spec.empty())
		return gt_tz_error(spec, "empty TZ rule");

	rd = gt_tz_reader(spec);

	std_name = rd.name();
	if(std.is_none(std_name))
		return gt_tz_error(spec, rd.error);

	std_raw = rd.hms(true);
	if(std.is_none(std_raw))
		return gt_tz_error(spec, rd.error);

	zone = [
		ok = true,
		spec = spec,
		std_name = std_name,
		std_off = -std_raw,
		has_dst = false,
		dst_name = "",
		dst_off = -std_raw,
		start = None,
		end = None,
		error = "",
	];

	if(rd.eof())
		return zone;

	dst_name = rd.name();
	if(std.is_none(dst_name))
		return gt_tz_error(spec, rd.error);

	zone.has_dst = true;
	zone.dst_name = dst_name;
	zone.dst_off = zone.std_off + 3600;

	if(!rd.eof() && rd.peek() != ",") {
		dst_raw = rd.hms(true);
		if(std.is_none(dst_raw))
			return gt_tz_error(spec, rd.error);
		zone.dst_off = -dst_raw;
	}

	if(rd.eof()) {
		// POSIX leaves the default rule to the implementation: the US one
		zone.start = [kind = "M", month = 3, week = 2, wday = 0, n = 0, time = 7200];
		zone.end = [kind = "M", month = 11, week = 1, wday = 0, n = 0, time = 7200];
		return zone;
	}

	if(rd.peek() != ",")
		return gt_tz_error(spec, "expected ',' before the DST start rule");
	rd.i++;

	zone.start = rd.rule();
	if(std.is_none(zone.start))
		return gt_tz_error(spec, rd.error);

	if(rd.peek() != ",")
		return gt_tz_error(spec, "expected ',' before the DST end rule");
	rd.i++;

	zone.end = rd.rule();
	if(std.is_none(zone.end))
		return gt_tz_error(spec, rd.error);

	if(!rd.eof())
		return gt_tz_error(spec, "unexpected text after the rule");

	// "all year DST" (start Jan 1 00:00, end Dec 31 24:00 + offset) is a fixed zone
	return zone;
}

// day (days since epoch) of a transition rule in a year
gt_rule_day(r, y) {
	if(r.kind == "J") {
		day = gt_days_from_civil(y, 1, 1) + r.n - 1;
		if(gt_is_leap(y) && r.n >= 60)
			day += 1;
		return day;
	}

	if(r.kind == "N")
		return gt_days_from_civil(y, 1, 1) + r.n;

	first = gt_days_from_civil(y, r.month, 1);
	day = first + gt_mod(r.wday - gt_weekday(first), 7) + 7 * (r.week - 1);
	last = first + gt_month_days(y, r.month) - 1;

	for(day > last)
		day -= 7;

	return day;
}

// UTC instants [start, end] of the DST period of a local year
gt_dst_bounds(zone, y) {
	s = gt_rule_day(zone.start, y) * GT_DAY + zone.start.time - zone.std_off;
	e = gt_rule_day(zone.end, y) * GT_DAY + zone.end.time - zone.dst_off;
	return [s, e];
}

gt_is_dst(zone, utc) {
	if(!zone.has_dst)
		return false;

	y = gt_civil_from_days(gt_floor_div(utc + zone.std_off, GT_DAY))[0];
	b = gt_dst_bounds(zone, y);

	if(b[0] < b[1])
		return utc >= b[0] && utc < b[1];

	// southern hemisphere: DST spans the new year
	return utc < b[1] || utc >= b[0];
}

gt_offset_at(zone, utc) {
	return gt_is_dst(zone, utc) ? zone.dst_off : zone.std_off;
}

gt_abbr_at(zone, utc) {
	return gt_is_dst(zone, utc) ? zone.dst_name : zone.std_name;
}

// local seconds since epoch (wall clock) -> UTC seconds
//   gap (spring forward): the wall time does not exist, it moves forward
//   overlap (fall back): the first occurrence wins
gt_local_to_utc(zone, local) {
	a = local - zone.std_off;
	b = local - zone.dst_off;

	ok_a = gt_offset_at(zone, a) == zone.std_off;
	ok_b = gt_offset_at(zone, b) == zone.dst_off;

	if(ok_a && ok_b)
		return math.min(a, b);
	if(ok_a)
		return a;
	if(ok_b)
		return b;

	// inside the gap: read the wall time with the offset that was valid before it
	return math.max(a, b);
}

// UTC -> [y, m, d, hour, minute, second, wday, offset, abbr, days]
gt_utc_to_local(zone, utc) {
	off = gt_offset_at(zone, utc);
	local = utc + off;
	days = gt_floor_div(local, GT_DAY);
	sod = local - days * GT_DAY;
	c = gt_civil_from_days(days);

	return [
		y = c[0], m = c[1], d = c[2],
		hour = sod / 3600, minute = (sod % 3600) / 60, second = sod % 60,
		wday = gt_weekday(days),
		offset = off,
		abbr = gt_abbr_at(zone, utc),
		days = days,
	];
}

gt_format_offset(off) {
	sign = off < 0 ? "-" : "+";
	a = off < 0 ? -off : off;
	return sign + gt_pad2(a / 3600) + ":" + gt_pad2((a % 3600) / 60);
}

// "2026-10-25 03:00 CET (+01:00)"
gt_format_local(zone, utc) {
	if(std.is_none(utc))
		return "-";

	l = gt_utc_to_local(zone, utc);
	return std.string(l.y) + "-" + gt_pad2(l.m) + "-" + gt_pad2(l.d) + " " + gt_pad2(l.hour) + ":" + gt_pad2(l.minute)
		+ " " + l.abbr + " (" + gt_format_offset(l.offset) + ")";
}

// "2026-10-25T01:00:00Z"
gt_format_utc(utc) {
	days = gt_floor_div(utc, GT_DAY);
	sod = utc - days * GT_DAY;
	return gt_format_date(days) + "T" + gt_pad2(sod / 3600) + ":" + gt_pad2((sod % 3600) / 60) + ":" + gt_pad2(sod % 60) + "Z";
}

// ─────────────────────────────────────────────────────────────────────────────
//  Zone lookup
// ─────────────────────────────────────────────────────────────────────────────

gt_safe_zone_name(name) {
	if(name.contains("..") || name.starts("/") || name.contains("\\"))
		return false;

	for(c : name) {
		ok = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || gt_is_digit(c) || c == "/" || c == "_" || c == "-" || c == "+";
		if(!ok)
			return false;
	}

	return true;
}

// The POSIX rule at the end of a TZif (v2+) file: "...\n<rule>\n"
gt_tzif_footer(path) {
	try {
		if(!fileio.exists(path) || fileio.is_directory(path))
			return "";

		data = fileio.read_string(path);

		if(!data.starts("TZif"))
			return "";

		if(!data.ends("\n"))
			return "";

		body = data.substr(0, data.length() - 1);
		nl = body.rfind("\n");

		if(nl < 0)
			return "";

		return body.substr(nl + 1).strip();
	}
	catch(e) {}

	return "";
}

// The machine's own zone: /etc/localtime on Linux / macOS, else a fixed offset
gt_system_zone() {
	footer = gt_tzif_footer("/etc/localtime");

	if(footer) {
		z = gt_tz_parse_posix(footer);
		if(z.ok) {
			z.name = "local";
			return z;
		}
	}

	// "+0200" -> fixed offset, daylight saving unknown
	off_text = std.date("%z");
	off = 0;

	if(off_text.length() == 5) {
		sign = off_text[0] == "-" ? -1 : 1;
		off = sign * (std.int(off_text.substr(1, 2)) * 3600 + std.int(off_text.substr(3, 2)) * 60);
	}

	z = [
		ok = true, spec = "", std_name = "LOCAL", std_off = off, has_dst = false,
		dst_name = "", dst_off = off, start = None, end = None, error = "",
		name = "local", fixed_guess = true,
	];

	return z;
}

// "Europe/Berlin" | "UTC" | "local" | a POSIX rule -> zone ([ok=false, error] on failure)
gt_zone(name) {
	n = std.string(name ?? "").strip();

	if(n.empty() || n.lowercase() == "local" || n.lowercase() == "system")
		return gt_system_zone();

	if(n == "UTC" || n == "Z" || n == "Etc/UTC" || n == "Etc/GMT" || n == "GMT") {
		z = gt_tz_parse_posix("UTC0");
		z.name = n;
		return z;
	}

	// a POSIX rule given directly: an offset digit, and no '/' outside of a
	// ",rule/time" part (IANA names never contain ',')
	has_digit = false;
	for(c : n) {
		if(gt_is_digit(c)) {
			has_digit = true;
			break;
		}
	}

	if(has_digit && (!n.contains("/") || n.contains(","))) {
		z = gt_tz_parse_posix(n);
		z.name = n;
		return z;
	}

	if(!gt_safe_zone_name(n))
		return gt_tz_error(n, "invalid time zone name '" + n + "'");

	for(dir : GT_ZONEINFO_DIRS) {
		footer = gt_tzif_footer(dir + n);
		if(footer) {
			z = gt_tz_parse_posix(footer);
			if(z.ok) {
				z.name = n;
				z.source = "zoneinfo";
				return z;
			}
		}
	}

	if(GT_ZONES.has(n)) {
		z = gt_tz_parse_posix(GT_ZONES[n]);
		z.name = n;
		z.source = "builtin";
		return z;
	}

	return gt_tz_error(n, "unknown time zone '" + n + "' (use an IANA name like Europe/Berlin, UTC, or a POSIX TZ rule)");
}

// ─────────────────────────────────────────────────────────────────────────────
//  Windows
// ─────────────────────────────────────────────────────────────────────────────

// The window that STARTS on local day `days`: [start, end] in UTC seconds.
// end_secs <= start_secs crosses midnight. end_secs None = duration_secs long.
gt_window_on(zone, days, start_secs, end_secs, duration_secs = None) {
	start_local = days * GT_DAY + start_secs;
	start = gt_local_to_utc(zone, start_local);
	end = start;

	if(!std.is_none(end_secs)) {
		end_day = days;
		if(end_secs <= start_secs)
			end_day += 1;
		end = gt_local_to_utc(zone, end_day * GT_DAY + end_secs);
	}
	else {
		dur = duration_secs ?? 3600;
		end = start + dur;
	}

	return [start = start, end = end, day = days];
}

gt_now() {
	return std.millis() / 1000;
}
