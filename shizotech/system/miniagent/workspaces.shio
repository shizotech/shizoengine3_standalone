// ═══════════════════════════════════════════════════════════════════════════
//  workspaces.shio — workspace tree, sessions and per-workspace mind state
//  issue #907: every workspace owns its own .megamind, sessions, architecture
//  and goals below std.user_path()/miniagent/workspaces.
//
//      #include "workspaces"
//      registry = workspaces_api_register(server, cfg, api_token[, registry]);
//      store = registry.store;
//      manager = registry.manager;
// ═══════════════════════════════════════════════════════════════════════════

#include "node_api"
#include "architecture"
#include "goal_engine"
#include "goal_tools"
#include "model_config_cli"

import webserver;
import subprocess;

WS_SETTINGS_FILE = "settings.json";
WS_REGISTRY_FILE = "workspaces.json";
WS_DEFAULT_MAX_SESSIONS = 2;
WS_MAX_SESSIONS_LIMIT = 64;
// issue #907 always-retry: no attempt cap; backoff is capped at 30 s.
WS_RETRY_BACKOFF_MAX_MS = 30000;
WS_EVENT_KEPT = 300;
WS_NOTIFY_KEPT = 100;
WS_STREAM_POLL_MS = 100;
WS_STREAM_PING_MS = 15000;
WS_LIVE_TICK_MS = 250;          // how often the live feed looks for a change
WS_LIVE_GOALS_MS = 1000;        // ... and at the goals of a watched workspace
WS_LIVE_WATCH_MS = 30000;       // a workspace stays watched this long after its last request
WS_LIVE_WAIT_MAX_MS = 25000;    // longest long-poll (a ShizoNet get has to outlast it)
WS_EVENTS_WAIT_MAX_MS = 10000;
WS_SAVE_DELTA_MS = 1000;        // session.json is rewritten at most this often while tokens stream
WS_EVENT_RESULT_MAX = 16000;    // characters of a tool result kept in an event (chat.json has all of it)
WS_TURN_ITEMS_MAX = 600;        // items of the running turn kept for a page that opens the session
WS_TURN_TEXT_MAX = 400000;      // characters of one text / reasoning item of the running turn

// ── small helpers ──────────────────────────────────────────────────────────
ws_str(v, def = "") {
    if(std.is_none(v))
        return def;
    return std.string(v);
}

// Canonical config spec for a workspace subprocess: an absolute path plus the
// optional #profile suffix. Empty stays empty, which means "use the default".
ws_config_spec_absolute(spec) {
    s = ws_str(spec);
    if(!s)
        return "";

    parts = model_config_split_profile(s);
    raw = ws_str(parts.path);

    if(!raw)
        return "";

    path = fileio.absolute_path(raw);

    if(parts.profile)
        return path + "#" + std.string(parts.profile);

    return path;
}

ws_spec_profile(spec) {
    parts = model_config_split_profile(ws_str(spec));
    return std.string(parts.profile);
}

ws_valid_reasoning_effort(value) {
    effort = ws_str(value).lowercase();
    return effort == "low" || effort == "medium" || effort == "high";
}

ws_slug(text) {
    s = ws_str(text).lowercase().strip();
    out = "";

    for(c : s) {
        if((c >= "a" && c <= "z") || (c >= "0" && c <= "9"))
            out += c;
        else
            out += "_";
    }

    if(out.length() > 48)
        out = out.substr(0, 48);

    if(!out)
        out = "workspace";

    return out;
}

// a title inferred from the first prompt / goal, so "+" sessions get a real name
ws_title_from(text, n = 48) {
    s = ws_str(text).strip().replace("\r", " ").replace("\n", " ");

    for(s.length() > n)
        s = s.substr(0, n);

    for(s.ends(" "))
        s = s.substr(0, s.length() - 1);

    if(!s)
        s = "New session";

    return s;
}

ws_chat_from_events(events) {
    chat = [];
    assistant_text = "";
    assistant_report = "";

    for(event : events) {
        if(!std.is_json(event))
            continue;

        if(event.type == "user") {
            if(assistant_report || assistant_text) {
                content = assistant_report ? assistant_report : assistant_text;
                chat.push_back([role = "assistant", content = content]);
            }

            assistant_text = "";
            assistant_report = "";
            user_text = ws_str(event.text);

            if(user_text)
                chat.push_back([role = "user", content = user_text]);
        }
        else if(event.type == "delta") {
            action = event.action;

            if(std.is_json(action) && action.has("text"))
                assistant_text += ws_str(action.text);
        }
        else if(event.type == "done") {
            assistant_report = ws_str(event.report);
            content = assistant_report ? assistant_report : assistant_text;

            if(content)
                chat.push_back([role = "assistant", content = content]);

            assistant_text = "";
            assistant_report = "";
        }
    }

    if(assistant_report || assistant_text) {
        content = assistant_report ? assistant_report : assistant_text;
        chat.push_back([role = "assistant", content = content]);
    }

    return chat;
}

// A tool result in the event window is for the eyes of the owner: a huge one (a
// whole file, a long command output) is cut to its head and tail there. The
// agent's own copy in chat.json is not touched.
ws_clip_event_action(action) {
    if(!std.is_json(action) || !action.has("tool_end") || !std.is_json(action.tool_end))
        return action;

    te = action.tool_end;

    if(!te.has("result") || std.is_none(te.result))
        return action;

    text = std.is_json(te.result) ? te.result.compact_string() : std.string(te.result);
    n = text.length();

    if(n <= WS_EVENT_RESULT_MAX)
        return action;

    head = WS_EVENT_RESULT_MAX * 3 / 4;
    tail = WS_EVENT_RESULT_MAX - head;

    out = action.copy();
    out.tool_end = te.copy();
    out.tool_end.result = text.substr(0, head) + "\n… [" + std.string(n - head - tail) + " characters left out] …\n" + text.substr(n - tail);
    out.tool_end.result_truncated = json.bool(true);
    out.tool_end.result_chars = n;

    return out;
}

// A short project-agent note for every real workspace. Generic and never
// overwrites an existing file: a project's own AGENTS.md is the authority.
ensure_agents_md(path) {
    p = ws_str(path);
    if(!p)
        return false;

    target = p + "/AGENTS.md";
    if(fileio.exists(target))
        return true;

    text = "# AGENTS.md\n\nThis is a Miniagent workspace.\n\n" +
           "- `.megamind/` holds sessions and architecture.\n" +
           "- `.agentspace/` holds goals and scheduling preferences.\n" +
           "- Register or inspect it with `shz miniagent --init` and the node web UI.\n";
    if(fileio.write_text(target, text))
        return true;

    std.error("[workspaces] could not write AGENTS.md at ", target);
    return false;
}

// ═══════════════════════════════════════════════════════════════════════════
//  WorkspaceStore — physical directory tree + registry + settings
// ═══════════════════════════════════════════════════════════════════════════

class WorkspaceStore {
    root = "";
    registry_path = "";
    settings_path = "";
    projects_dir = "";      // where a workspace created without a path gets its folder
    items = [];

    __init__(_root = "", _projects_dir = "") {
        base = ws_str(_root);

        if(base) {
            for(base.length() > 1 && (base.ends("/") || base.ends("\\")))
                base = base.substr(0, base.length() - 1);

            root = fileio.absolute_path(base);
        } else {
            root = fileio.absolute_path(miniagent_workspaces_root());
        }
        registry_path = root + "/" + WS_REGISTRY_FILE;
        settings_path = root + "/" + WS_SETTINGS_FILE;
        items = [];
        set_projects_dir(_projects_dir);

        load();
    }

    // New projects without a path are created below this folder:
    // <the directory the node was started in>/workspaces/<name>, so a project can
    // be started from the web interface or a chat without typing a path. A store
    // made with its own root (a test, an isolated client) keeps them in that root.
    set_projects_dir(dir) {
        d = ws_str(dir).strip();

        if(d) {
            projects_dir = fileio.absolute_path(d);
            return projects_dir;
        }

        if(root == fileio.absolute_path(miniagent_workspaces_root()))
            projects_dir = fileio.absolute_path(ws_str(std.wd(), ".") + "/workspaces");
        else
            projects_dir = root;

        return projects_dir;
    }

    root_workspace() {
        return [
            id = "root",
            name = "Workspaces",
            path = root,
            parent = "",
            created = std.millis(),
            description = "",
        ];
    }

    ensure_megamind(path) {
        meg = path + "/.megamind";
        fileio.mkdir(meg);
        fileio.mkdir(meg + "/sessions");
        fileio.mkdir(meg + "/architecture");

        // A workspace that already had the old .agentspace/architecture.json
        // keeps that graph when the per-workspace .megamind is created.
        arch = meg + "/architecture/architecture.json";
        legacy = path + "/.agentspace/architecture.json";

        if(!fileio.exists(arch) && fileio.exists(legacy)) {
            try {
                fileio.write_text(arch, fileio.read_string(legacy));
            } catch(e) {
                std.error("[workspaces] architecture import failed: ", e);
            }
        }

        return meg;
    }

    migrate_legacy_goal_space(path, template) {
        legacy = path + "/.megamind/tasks";
        target = path + "/.agentspace";
        if(!fileio.is_directory(legacy))
            return true;

        for(f : fileio.files(legacy, true)) {
            src = legacy + "/" + f;
            dst = target + "/" + f;
            text = goal_read(src);

            if(fileio.exists(dst)) {
                template_file = template + "/" + f;
                if(f.starts("preferences/") && fileio.exists(template_file) && goal_read(dst) == goal_read(template_file)) {
                    if(!fileio.write_text(dst, text)) {
                        std.error("[workspaces] could not import legacy goal preferences from ", src);
                        return false;
                    }
                }
                continue;
            }

            goal_mkdir(fileio.file_dir(dst));
            if(!fileio.write_text(dst, text)) {
                std.error("[workspaces] could not import legacy goal data from ", src);
                return false;
            }
        }
        return true;
    }

    ensure_agentspace(path) {
        template = __DIR__ + "/agentspace_template";
        if(!fileio.is_directory(template)) {
            std.error("[workspaces] goal-engine template is missing: ", template);
            return false;
        }

        if(!migrate_legacy_goal_space(path, template))
            return false;

        space = GoalSpace(path + "/.agentspace");
        space.init(template);
        if(!space.exists() || !fileio.exists(path + "/.agentspace/preferences/scheduling.md")) {
            std.error("[workspaces] could not initialize goal engine at ", path + "/.agentspace");
            return false;
        }
        return true;
    }

    save() {
        fileio.mkdir(root);

        try {
            ok = fileio.write_json(registry_path, [workspaces = items], true, true);

            if(!ok)
                std.error("[workspaces] could not persist workspace registry at ", registry_path);

            return ok;
        } catch(e) {
            std.error("[workspaces] could not persist workspace registry: ", e);
            return false;
        }
    }

    load() {
        fileio.mkdir(root);

        if(!fileio.exists(settings_path))
            fileio.write_json(settings_path, [max_sessions = WS_DEFAULT_MAX_SESSIONS], true, true);

        data = fileio.read_json(registry_path, true);

        if(!std.is_json(data))
            data = [workspaces = []];

        if(!data.has("workspaces") || !std.is_json(data.workspaces))
            data.workspaces = [];

        items = data.workspaces.copy();

        has_root = false;

        for(w : items) {
            if(w.id == "root")
                has_root = true;
        }

        if(!has_root) {
            items.push_back(root_workspace());
            save();
        }

        for(w : items) {
            if(!w.path)
                continue;
            ensure_megamind(w.path);
            if(w.id != "root") {
                ensure_agents_md(w.path);
                if(!ensure_agentspace(w.path))
                    return false;
            }
        }

        return true;
    }

    settings() {
        if(!fileio.exists(settings_path))
            fileio.write_json(settings_path, [max_sessions = WS_DEFAULT_MAX_SESSIONS], true, true);

        data = fileio.read_json(settings_path, true);

        if(!std.is_json(data))
            data = [max_sessions = WS_DEFAULT_MAX_SESSIONS];

        max_sessions = WS_DEFAULT_MAX_SESSIONS;

        if(data.has("max_sessions"))
            max_sessions = std.int(data.max_sessions);

        if(max_sessions <= 0)
            max_sessions = WS_DEFAULT_MAX_SESSIONS;

        if(max_sessions > WS_MAX_SESSIONS_LIMIT)
            max_sessions = WS_MAX_SESSIONS_LIMIT;

        return [max_sessions = max_sessions];
    }

    set_settings(max_sessions) {
        cs = std.critical_section_named("workspace_store");

        n = std.int(max_sessions);

        if(n <= 0) {
            cs.release();
            return [ok = false, error = "max_sessions must be at least 1"];
        }

        if(n > WS_MAX_SESSIONS_LIMIT)
            n = WS_MAX_SESSIONS_LIMIT;

        fileio.write_json(settings_path, [max_sessions = n], true, true);

        cs.release();

        return [ok = true, settings = [max_sessions = n]];
    }

    list() {
        return items.copy();
    }

    get(id) {
        id = ws_str(id);
        for(w : items) {
            if(w.id == id)
                return w.copy();
        }
        return None;
    }

    find_by_path(path) {
        p = fileio.absolute_path(ws_str(path));

        for(w : items) {
            if(w.path == p)
                return w.copy();
        }

        return None;
    }

    create(name, path = "", parent = "", description = "") {
        cs = std.critical_section_named("workspace_store");

        name = ws_str(name).strip();
        path = ws_str(path).strip();
        parent = ws_str(parent).strip();

        if(!parent)
            parent = "root";

        if(!name)
            name = "Workspace-" + std.random_hash(6);

        base = root;

        if(parent) {
            p = get(parent);

            if(!p) {
                cs.release();
                return [ok = false, error = "unknown parent workspace"];
            }

            base = p.path;
        }

        phys = "";

        if(path) {
            phys = fileio.absolute_path(path);
        } else if(parent == "root") {
            // no path: a new project folder below the node's working directory
            fileio.mkdir(projects_dir);
            phys = fileio.absolute_path(projects_dir + "/" + ws_slug(name));
        } else {
            // a sub-workspace without a path lives inside its parent
            phys = fileio.absolute_path(base + "/" + ws_slug(name));
        }

        if(fileio.exists(phys) && !fileio.is_directory(phys)) {
            cs.release();
            return [ok = false, error = "path is not a directory"];
        }

        existing = find_by_path(phys);

        if(existing) {
            cs.release();
            return [ok = true, workspace = existing, reused = true];
        }

        fileio.mkdir(phys);
        ensure_megamind(phys);
        ensure_agents_md(phys);
        if(!ensure_agentspace(phys)) {
            cs.release();
            return [ok = false, error = "could not initialize the workspace goal engine"];
        }

        id = std.random_hash(16);

        if(phys == root)
            id = "root";

        w = [
            id = id,
            name = name,
            path = phys,
            parent = parent,
            created = std.millis(),
            description = ws_str(description),
        ];

        items.push_back(w);

        if(!save()) {
            items.erase(items.size() - 1);
            cs.release();
            return [ok = false, error = "could not persist the workspace registry"];
        }

        cs.release();

        return [ok = true, workspace = w.copy(), reused = false];
    }

    delete(id) {
        cs = std.critical_section_named("workspace_store");

        id = ws_str(id);

        if(id == "root") {
            cs.release();
            return [ok = false, error = "the root workspace cannot be deleted"];
        }

        w = get(id);

        if(!w) {
            cs.release();
            return [ok = false, error = "unknown workspace"];
        }

        for(c : items) {
            if(c.parent == id) {
                cs.release();
                return [ok = false, error = "workspace has children"];
            }
        }

        removed = None;

        for(i = 0; i < items.size(); i++) {
            if(items[i].id == id) {
                removed = items[i].copy();
                items.erase(i);
                break;
            }
        }

        if(!save()) {
            if(removed)
                items.push_back(removed);

            cs.release();
            return [ok = false, error = "could not persist the workspace registry"];
        }

        cs.release();

        return [ok = true, workspace = w];
    }

    tree_node(w) {
        node = w.copy();
        node.children = [];

        for(c : items) {
            if(c.parent == w.id)
                node.children.push_back(tree_node(c));
        }

        return node;
    }

    tree() {
        root_node = None;

        for(w : items) {
            if(!w.parent) {
                root_node = w;
                break;
            }
        }

        if(!root_node)
            return [workspaces = []];

        return tree_node(root_node);
    }
}

// ═══════════════════════════════════════════════════════════════════════════
//  SessionManager — subprocess sessions with JSON-line stdio
// ═══════════════════════════════════════════════════════════════════════════

class SessionManager {
    store = None;
    cfg_spec = "";
    token = "";
    sessions = [];
    queue = [];             // session ids accepted while every slot is busy, FIFO
    live_texts = [];
    live_text_seqs = [];
    procs = [];
    pump_active = [];
    deleting_sessions = [];
    listeners = [];
    listener_owners = [];    // parallel to listeners: the owner that registered it
    notifications = [];
    notify_listeners = [];
    file_listeners = [];
    workspace_paths = [];
    stop_requested = [];
    terminal_reported = [];
// Last owner request (std.millis). The goal scheduler yields to it through
    // background_capacity(); a goal dispatch itself must not count as interactive.
    last_interactive_ms = 0;
    saved_at = [];          // session id -> std.millis_steady() of the last session.json write
    turn_logs = [];         // session id -> the running turn as items (see turn_log_add)

    __init__(_store, _cfg_spec, _token = "") {
        store = _store;
        cfg_spec = ws_config_spec_absolute(_cfg_spec);
        token = ws_str(_token);
        sessions = [];
        queue = [];
        live_texts = [];
        live_text_seqs = [];
        procs = [];
        pump_active = [];
        deleting_sessions = [];
        listeners = [];
        listener_owners = [];
        notifications = [];
        notify_listeners = [];
        file_listeners = [];
        workspace_paths = [];
        stop_requested = [];
        terminal_reported = [];
// Last owner request (std.millis). The goal scheduler yields to it through
        // background_capacity(); a goal dispatch itself must not count as interactive.
        last_interactive_ms = 0;
        saved_at = [];
        turn_logs = [];
        load_sessions();

        // sessions accepted before the restart and still queued run again
        dispatch_queue();
    }

    // A Workspace registers its physical directory before any session is created.
    // The node's own Workspace lives outside the userspace registry, so the shared
    // manager must know its path too.
    register_workspace(id, path) {
        id = ws_str(id);
        path = ws_str(path);

        if(!id || !path)
            return false;

        workspace_paths[id] = path;
        return true;
    }

    workspace_path(id) {
        id = ws_str(id);

        if(workspace_paths.has(id))
            return ws_str(workspace_paths[id]);

        w = store.get(id);

        if(!w)
            return "";

        return ws_str(w.path);
    }

    // Restarting the node must not hide the sessions that were saved in each
    // workspace's .megamind/sessions. They are shown with their chat history;
    // non-terminal sessions are marked stopped because their process is gone.
    load_sessions() {
        for(w : store.list())
            load_workspace_sessions(w.path, w.id);

        // The node's own Workspace is outside the userspace registry.
        node_path = miniagent_node_root();
        if(fileio.is_directory(node_path + "/.megamind/sessions"))
            load_workspace_sessions(node_path, "node");
    }

    load_workspace_sessions(path, workspace_id) {
        path = ws_str(path);
        workspace_id = ws_str(workspace_id);
        register_workspace(workspace_id, path);

        dir = path + "/.megamind/sessions";

        if(!fileio.is_directory(dir))
            return 0;

        loaded = 0;

        for(d : fileio.dirs(dir, false)) {
            sid = fileio.file_name(d);
            path = dir + "/" + sid + "/session.json";
            data = fileio.read_json(path, true);

            if(!std.is_json(data))
                continue;

            s = data.copy();
            s.id = sid;
            s.workspace_id = ws_str(s.workspace_id, workspace_id);
            s.title = ws_str(s.title, "Session");
            s.mode = ws_str(s.mode, "normal");
            s.role = ws_str(s.role, "adaptive");
            s.origin = ws_str(s.origin);
            s.reasoning_effort = ws_str(s.reasoning_effort, "medium");
            if(!ws_valid_reasoning_effort(s.reasoning_effort))
                s.reasoning_effort = "medium";
            s.status = ws_str(s.status, "stopped");
            s.prompt = ws_str(s.prompt);
            s.report = ws_str(s.report);
            s.error = ws_str(s.error);
            s.token_usage = std.int(s.token_usage);
            s.created = std.int(s.created);
            s.updated = std.int(s.updated);
            s.seq = std.int(s.seq);
            s.attempts = std.int(s.attempts);

            if(!s.events || !std.is_json(s.events))
                s.events = [];

            live_texts[s.id] = "";
            live_text_seqs[s.id] = 0;
            stop_requested[s.id] = false;
            terminal_reported[s.id] = false;
            s.chat_history_size_at_prompt = std.int(s.chat_history_size_at_prompt);
            restarted = false;

            if(s.status == "queued" || s.status == "starting" || s.status == "running" || s.status == "waiting") {
                recovered = recovered_turn(dir + "/" + sid, s);

                if(std.is_json(recovered)) {
                    s.status = recovered.status == "finished" ? "done" : recovered.status;
                    s.report = recovered.report;
                    s.error = recovered.status == "failed" ? s.report : "";
                    s.token_usage = recovered.token_usage;
                    s.updated = recovered.completed;
                    if(!s.updated) s.updated = std.millis();
                    push_event(s, "done", [
                        ok = json.bool(recovered.status == "finished"),
                        status = recovered.status,
                        report = s.report,
                        token_usage = s.token_usage,
                    ]);
                    restarted = true;
                } else {
                    s.status = "failed";
                    s.error = "the session process exited without a terminal result";
                    s.report = s.error;
                    s.updated = std.millis();
                    push_event(s, "done", [
                        ok = json.bool(false),
                        status = "failed",
                        report = s.report,
                        token_usage = s.token_usage,
                    ]);
                    restarted = true;
                }
            }

            sessions[s.id] = s;
            loaded++;

            if(s.status == "queued" && !queue_contains(s.id))
                queue.push_back(s.id);

            if(restarted)
                save_session(sid);
        }

        return loaded;
    }

    max_sessions() {
        return store.settings().max_sessions;
    }

    active_count() {
        n = 0;

        for(k, s : sessions) {
            if(s && (s.status == "starting" || s.status == "running" || s.status == "waiting"))
                n++;
        }

        return n;
    }

    queued_count() {
        n = 0;

        for(k, s : sessions) {
            if(s && s.status == "queued")
                n++;
        }

        return n;
    }

    session_record(sid) {
        sid = ws_str(sid);

        // sessions[sid] on a missing key creates a null entry; use has() so a
        // deleted session really leaves the map (and stats).
        if(!sessions.has(sid))
            return None;

        return sessions[sid];
    }

    dequeue(sid) {
        sid = ws_str(sid);

        for(i = 0; i < queue.size(); i++) {
            if(ws_str(queue[i]) == sid) {
                queue.erase(i);
                return true;
            }
        }

        return false;
    }

    queue_contains(sid) {
        sid = ws_str(sid);

        for(q : queue) {
            if(ws_str(q) == sid)
                return true;
        }

        return false;
    }    session_dir(sid) {
        s = session_record(sid);

        if(!s)
            return "";

        path = workspace_path(s.workspace_id);

        if(!path)
            return "";

        return path + "/.megamind/sessions/" + sid;
    }

    session_path(sid) {
        dir = session_dir(sid);

        if(!dir)
            return "";

        return dir + "/session.json";
    }

    // A terminal result written by the worker before it exited. It must match the
    // current prompt and add history, so an old result is not mistaken for this turn.
    recovered_turn(dir, s) {
        path = dir + "/chat.json.result.json";

        if(!fileio.exists(path))
            return None;

        result = None;

        try {
            result = fileio.read_json(path, true);
        } catch(e) {
            return None;
        }

        if(!std.is_json(result))
            return None;

        status = ws_str(result.status);

        if(status != "finished" && status != "failed" && status != "question")
            return None;

        if(ws_str(result.prompt) != ws_str(s.prompt))
            return None;

        if(std.int(result.history_size) <= std.int(s.chat_history_size_at_prompt))
            return None;

        return [
            status = status,
            report = ws_str(result.report),
            token_usage = std.int(result.token_usage),
            completed = std.int(result.completed),
        ];
    }

    // ── the running turn, for a page that opens the session in the middle of it ──
    //
    // The event window holds the last WS_EVENT_KEPT events, which is a few seconds of
    // streamed tokens, and chat.json is only written at a tool call and at the end of
    // a turn. So a page that opened a running session saw the reasoning and the tool
    // calls of the turn only from the moment it connected. The turn log is the same
    // stream folded into items as it arrives:
    //     [kind = "user", text]                 the prompt (also one sent while it runs)
    //     [kind = "reasoning", text]            consecutive reasoning deltas, joined
    //     [kind = "text", text]                 consecutive text deltas, joined
    //     [kind = "tool", id, name, args, state = running|ok|failed, result, sub]
    //     [kind = "milestone" | "notice" | "error", text]
    // GET /api/sessions/<id> answers it as `turn` together with `turn_seq`, the seq of
    // the last event that is in it: the page draws the items and takes the stream from
    // there. It is memory only; a finished turn is read from chat.json.
    turn_log_reset(sid, prompt = "") {
        items = [];

        if(ws_str(prompt))
            items.push_back([kind = "user", text = ws_str(prompt)]);

        turn_logs[sid] = items;
    }

    turn_log(sid) {
        if(!turn_logs.has(sid))
            return [];

        return turn_logs[sid].copy();
    }

    turn_log_push(sid, item) {
        if(!turn_logs.has(sid))
            turn_logs[sid] = [];

        items = turn_logs[sid];
        items.push_back(item);

        // too many: the oldest go (the prompt at the front stays)
        for(items.size() > WS_TURN_ITEMS_MAX)
            items.erase(items[0].kind == "user" ? 1 : 0);
    }

    turn_log_text(sid, kind, text) {
        text = ws_str(text);

        if(!text)
            return;

        if(turn_logs.has(sid) && turn_logs[sid].size()) {
            items = turn_logs[sid];
            last = items[items.size() - 1];

            if(last.kind == kind) {
                last.text = ws_str(last.text) + text;

                if(last.text.length() > WS_TURN_TEXT_MAX)
                    last.text = "…" + last.text.substr(last.text.length() - WS_TURN_TEXT_MAX + 1000);

                return;
            }
        }

        turn_log_push(sid, [kind = kind, text = text]);
    }

    // one streamed action of the session's agent (sub = it came from a sub-agent)
    turn_log_add(sid, action, sub = false) {
        if(!std.is_json(action))
            return;

        // the actions of a sub-agent arrive wrapped: [agent = [id, action]]
        if(action.has("agent") && std.is_json(action.agent)) {
            if(std.is_json(action.agent.action))
                turn_log_add(sid, action.agent.action, true);
            return;
        }

        if(action.has("tool_start") && std.is_json(action.tool_start)) {
            t = action.tool_start;
            args = std.json();

            if(std.is_json(t.args)) {
                for(k, v : t.args) {
                    // what the harness adds to the arguments is not a parameter
                    if(std.string(k) != "tool_call" && std.string(k) != "tool_call_index")
                        args[std.string(k)] = v;
                }
            }

            turn_log_push(sid, [
                kind = "tool",
                id = ws_str(t.id),
                name = ws_str(t.name, "tool"),
                args = args,
                state = "running",
                result = None,
                sub = json.bool(sub),
            ]);
            return;
        }

        if(action.has("tool_end") && std.is_json(action.tool_end)) {
            t = action.tool_end;
            id = ws_str(t.id);

            if(!turn_logs.has(sid))
                return;

            items = turn_logs[sid];

            for(i = items.size() - 1; i >= 0; i--) {
                if(items[i].kind == "tool" && ws_str(items[i].id) == id) {
                    res = t.result;
                    failed = false;

                    if(std.is_json(res) && res.has("ok") && !res.ok && res.has("error"))
                        failed = true;

                    items[i].state = failed ? "failed" : "ok";
                    items[i].result = res;

                    if(t.has("result_truncated"))
                        items[i].result_truncated = json.bool(true);
                    break;
                }
            }
            return;
        }

        // the text and the reasoning of sub-agents would interleave: only their tools show
        if(sub)
            return;

        if(action.has("reasoning") && !std.is_none(action.reasoning)) {
            turn_log_text(sid, "reasoning", action.reasoning);
            return;
        }

        if(action.has("text") && !std.is_none(action.text)) {
            turn_log_text(sid, "text", action.text);
            return;
        }

        if(action.has("milestone") && !std.is_none(action.milestone))
            turn_log_push(sid, [kind = "milestone", text = ws_str(action.milestone)]);
    }

    // While tokens stream, an event arrives every few milliseconds; writing the whole
    // session.json for each of them made the disk the slowest part of a turn. A
    // streamed delta is saved at most every WS_SAVE_DELTA_MS, everything else (a tool
    // call, a status, the end of the turn) at once.
    save_session_lazy(sid) {
        now = std.millis_steady();

        if(saved_at.has(sid) && now - std.int(saved_at[sid]) < WS_SAVE_DELTA_MS)
            return false;

        return save_session(sid);
    }

    save_session(sid) {
        path = session_path(sid);

        if(!path)
            return false;

        saved_at[sid] = std.millis_steady();

        cs = std.critical_section_named("workspace_session_save:" + path);
        s = session_record(sid);

        if(!s) {
            cs.release();
            return false;
        }

        saved = [
            id = s.id,
            workspace_id = s.workspace_id,
            title = s.title,
            mode = s.mode,
            reasoning_effort = s.reasoning_effort,
            status = s.status,
            prompt = s.prompt,
            events = s.events.copy(),
            chat_history_size_at_prompt = std.int(s.chat_history_size_at_prompt),
            token_usage = s.token_usage,
            created = s.created,
            updated = s.updated,
            role = s.role,
            origin = ws_str(s.origin),
            report = s.report,
            error = s.error,
            seq = s.seq,
        ];

        result = fileio.write_json(path, saved, true, true);
        cs.release();
        return result;
    }

    push_event(s, type, payload) {
        s.seq++;
        e = payload.copy();
        e.seq = s.seq;
        e.type = type;
        s.events.push_back(e);

        for(s.events.size() > WS_EVENT_KEPT)
            s.events.erase(0);

        return e;
    }

    host_state(status) {
        if(status == "queued")
            return "queued";
        if(status == "done")
            return "finished";
        if(status == "failed")
            return "failed";
        if(status == "question")
            return "question";
        if(status == "starting")
            return "planned";
        if(status == "running" || status == "waiting")
            return "running";
        if(status == "stopped")
            return "stopped";
        return "planned";
    }

    session_view(sid) {
        s = session_record(sid);

        if(!s)
            return None;

        out = s.copy();
        p = procs[sid];
        out.process_running = json.bool(p && p.running());
        out.active = json.bool(s.status == "starting" || s.status == "running" || s.status == "waiting");

        return out;
    }

    get_session(sid) {
        return session_view(sid);
    }

    delete_session(sid) {
        sid = ws_str(sid);
        s = session_record(sid);

        if(!s)
            return [ok = false, error = "unknown session"];

        guard = std.critical_section_named("workspace_sessions");
        if(deleting_sessions[sid]) {
            guard.release();
            return [ok = false, error = "session deletion is already in progress"];
        }
        deleting_sessions[sid] = true;
        guard.release();

        if(s.status == "queued" || s.status == "starting" || s.status == "running" || s.status == "waiting")
            stop_session(sid);

        dir = session_dir(sid);
        save_lock = std.critical_section_named("workspace_session_save:" + dir + "/session.json");
        removed = fileio.remove(dir);
        if(!removed) {
            save_lock.release();
            guard = std.critical_section_named("workspace_sessions");
            deleting_sessions.erase(sid);
            guard.release();
            return [ok = false, error = "could not remove session files: " + dir];
        }

        guard = std.critical_section_named("workspace_sessions");
        sessions.erase(sid);
        live_texts.erase(sid);
        live_text_seqs.erase(sid);
        procs.erase(sid);
        pump_active.erase(sid);
        stop_requested.erase(sid);
        terminal_reported.erase(sid);
        deleting_sessions.erase(sid);
        saved_at.erase(sid);
        turn_logs.erase(sid);
        guard.release();
        save_lock.release();

        return [ok = true, removed = sid];
    }

    session_live_state(sid) {
        return [text = ws_str(live_texts[sid]), seq = std.int(live_text_seqs[sid])];
    }

    session_chat_history(sid) {
        dir = session_dir(sid);

        if(!dir)
            return None;

        path = dir + "/chat.json";

        if(!fileio.exists(path))
            return [];

        history = None;

        for(i = 0; i < 5; i++) {
            try {
                history = fileio.read_json(path, true);
            } catch(e) {
                history = None;
            }

            if(std.is_list(history))
                return history;

            std.sleep(50);
        }

        return None;
    }

    list_sessions(workspace_id) {
        out = [];

        for(k, s : sessions) {
            if(s.workspace_id == workspace_id)
                out.push_back(session_view(k));
        }

        return out;
    }

    session_events(sid) {
        s = session_record(sid);

        if(!s)
            return [];

        return s.events.copy();
    }

    inspect_task(taskid) {
        s = session_record(taskid);

        if(!s) {
            return [
                ok = false,
                taskid = ws_str(taskid),
                name = "",
                state = "lost",
                active = json.bool(false),
                report = "",
                error = "not found",
                token_usage = 0,
                last_update_ms = 0,
            ];
        }

        return [
            ok = true,
            taskid = s.id,
            workspace_id = s.workspace_id,
            name = s.title,
            role = s.role,
            mode = s.mode,
            origin = ws_str(s.origin),
            state = host_state(s.status),
            active = json.bool(s.status == "starting" || s.status == "running" || s.status == "waiting"),
            report = s.report,
            error = s.error,
            token_usage = s.token_usage,
            last_update_ms = s.updated,
        ];
    }

    host_tasks(workspace_id) {
        out = [];

        for(k, s : sessions) {
            if(s.workspace_id == workspace_id)
                out.push_back(inspect_task(k));
        }

        return out;
    }

    spawn(sid) {
        s = session_record(sid);

        if(!s)
            return false;

        stop_requested[sid] = false;
        terminal_reported[sid] = false;

        path = workspace_path(s.workspace_id);

        if(!path)
            return false;

        dir = session_dir(sid);
        fileio.mkdir(dir);

        history_path = dir + "/chat.json";

        if(!fileio.exists(history_path) && std.is_json(s.events) && s.events.size()) {
            legacy_chat = ws_chat_from_events(s.events);

            if(legacy_chat.size() && !fileio.write_json(history_path, legacy_chat, true, true)) {
                s.error = "Cannot migrate session chat history: " + history_path;
                save_session(sid);
                return false;
            }
        }

        p = subprocess.process();
        p.pipes(true, true, true);

        args = [
            ws_str(std.local_executable()),
            __DIR__ + "/workspace_agent.shio",
            "--workspace", path,
            "--config-spec", cfg_spec,
            "--session-id", sid,
            "--history-file", history_path,
            "--reasoning-effort", ws_str(s.reasoning_effort, "medium"),
            "--role", s.role,
            "--mode", s.mode,
        ];

        started = false;

        try {
            started = p.start(args, path, false);
        } catch(e) {
            s.error = ws_str(e);
            s.status = "starting";
            save_session(sid);
            return false;
        }

        if(!started) {
            s.error = ws_str(p.error());
            s.status = "starting";
            save_session(sid);
            return false;
        }

        procs[sid] = p;
        return true;
    }

    // FIFO dispatcher: a queued session consumes the next free slot. Called after
    // every terminal/stopped/deleted session and after max_sessions is raised.
    dispatch_queue() {
        started = 0;

        for(1) {
            cs = std.critical_section_named("workspace_sessions");

            if(active_count() >= max_sessions()) {
                cs.release();
                break;
            }

            sid = "";

            for(q : queue) {
                s = session_record(q);

                if(s && s.status == "queued") {
                    sid = ws_str(q);
                    break;
                }
            }

            if(!sid) {
                // stopped or deleted ids are stale, not queue entries
                for(i = queue.size() - 1; i >= 0; i--) {
                    s = session_record(queue[i]);

                    if(!s || s.status != "queued")
                        queue.erase(i);
                }

                cs.release();
                break;
            }

            dequeue(sid);
            s = session_record(sid);
            s.status = "starting";
            s.attempts = 0;
            s.report = "";
            s.error = "";
            s.updated = std.millis();
            cs.release();

            if(!spawn(sid)) {
                s = session_record(sid);

                if(s) {
                    s.status = "failed";
                    s.error = s.error ? s.error : "the session could not be started";
                    s.report = s.error;
                    finish_terminal(s, "failed", s.report, s.error, false);
                }

                started++;
                continue;
            }

            if(ws_str(s.prompt)) {
                send_json(sid, [type = "prompt", text = s.prompt, reasoning_effort = s.reasoning_effort]);
                if(s.status == "starting")
                    s.status = "running";
                turn_log_reset(sid, s.prompt);
                push_event(s, "status", [status = s.status]);
            } else {
                turn_log_reset(sid, "");
            }

            s.updated = std.millis();
            save_session(sid);
            pump_active[sid] = true;

            std.thread([this, sid]() {
                this.pump(sid);
            }).run();

            started++;
        }

        return started;
    }

    send_json(sid, obj) {
        p = procs[sid];

        if(!p || !p.running())
            return false;

        return p.write_line(obj.compact_string());
    }

// origin: who started the session ("web" the web interface, "net" another node or a
    // gateway over ShizoNet, "goal" a scheduled goal, "" unknown). It travels with the
    // task-finished event, so a chat gateway can stay quiet about turns the owner is
    // watching in the web interface.
    create_session(workspace_id, title = "", mode = "normal", prompt = "", role = "adaptive", reasoning_effort = "medium", origin = "") {
        path = workspace_path(workspace_id);

        if(!path)
            return [ok = false, error = "unknown workspace"];

        mode = ws_str(mode);
        if(mode != "goal")
            mode = "normal";

        role = ws_str(role);
        if(!role)
            role = "adaptive";

        reasoning_effort = ws_str(reasoning_effort, "medium").lowercase();
        if(!ws_valid_reasoning_effort(reasoning_effort))
            return [ok = false, error = "reasoning_effort must be low, medium, or high"];

        title = ws_str(title).strip();
        prompt = ws_str(prompt).strip();

        if(!title) {
            if(prompt) {
                title = ws_title_from(prompt, 48);
            } else {
                n = 0;
                for(k, s : sessions) {
                    if(s.workspace_id == workspace_id)
                        n++;
                }
                title = "Session " + std.string(n + 1);
            }
        }

        // a session a person asked for (the web interface, a gateway) is interactive use
        origin = ws_str(origin);
        if(origin == "web" || origin == "net")
            last_interactive_ms = std.millis();

        cs = std.critical_section_named("workspace_sessions");

        // Every task is accepted. When every slot is busy it becomes a queued
        // session; dispatch_queue() starts it as soon as a slot frees.
        full = active_count() >= max_sessions();

        sid = std.random_hash(16);

        s = [
            id = sid,
            workspace_id = workspace_id,
            title = title,
            mode = mode,
            reasoning_effort = reasoning_effort,
            status = full ? "queued" : "starting",
            prompt = prompt,
            events = [],
            chat_history_size_at_prompt = 0,
            token_usage = 0,
            created = std.millis(),
            updated = std.millis(),
            role = role,
            origin = ws_str(origin),
            report = "",
            error = "",
            seq = 0,
            attempts = 0,
        ];

        sessions[sid] = s;
        if(full)
            queue.push_back(sid);
        live_texts[sid] = "";
        live_text_seqs[sid] = 0;
        stop_requested[sid] = false;
        terminal_reported[sid] = false;
        cs.release();

        dir = session_dir(sid);
        fileio.mkdir(dir);
        save_session(sid);

        if(full) {
            if(prompt) {
                turn_log_reset(sid, prompt);
                push_event(s, "user", [text = prompt]);
                push_event(s, "status", [status = "queued"]);
                save_session(sid);
            }

            dispatch_queue();
            return [ok = true, session = session_view(sid)];
        }

        if(!spawn(sid)) {
            sessions.erase(sid);
            dequeue(sid);
            return [ok = false, error = s.error];
        }

        if(prompt) {
            send_json(sid, [type = "prompt", text = prompt, reasoning_effort = s.reasoning_effort]);
            // a spawn hook may already have set the status (a test fake); do not overwrite it
            if(s.status == "starting")
                s.status = "running";
            turn_log_reset(sid, prompt);
            push_event(s, "user", [text = prompt]);
            push_event(s, "status", [status = s.status]);
        }

        s.updated = std.millis();
        save_session(sid);

        pump_active[sid] = true;

        std.thread([this, sid]() {
            this.pump(sid);
        }).run();

        return [ok = true, session = session_view(sid)];
    }

// interactive = false: the prompt comes from the node itself (a goal run that is
    // told to wrap up, an architecture job), not from a person
    send_prompt(sid, prompt, reasoning_effort = None, interactive = true) {
        s = session_record(sid);

        if(!s)
            return [ok = false, error = "unknown session"];

        if(interactive)
            last_interactive_ms = std.millis();

        if(deleting_sessions[sid])
            return [ok = false, error = "session deletion is in progress"];

        prompt = ws_str(prompt).strip();

        if(!prompt)
            return [ok = false, error = "empty prompt"];

        if(!std.is_none(reasoning_effort)) {
            reasoning_effort = ws_str(reasoning_effort).lowercase();
            if(!ws_valid_reasoning_effort(reasoning_effort))
                return [ok = false, error = "reasoning_effort must be low, medium, or high"];
            s.reasoning_effort = reasoning_effort;
        }

        // "+" creates an empty session with a placeholder title.
        // prompt names it from the request text.
        if(!s.title || s.title.starts("Session ")) {
            s.title = ws_title_from(prompt, 48);
        }

        history = session_chat_history(sid);

        if(!std.is_list(history))
            return [ok = false, error = "Cannot read session chat history"];

        p = procs[sid];

        // A prompt while the subprocess is generating updates its running task
        // (miniagent.task_update); an interrupt would stop that task instead.
        if(p && p.running()) {
            send_json(sid, [type = "prompt", text = prompt, reasoning_effort = s.reasoning_effort]);

            s.prompt = prompt;
            live_texts[sid] = "";
            live_text_seqs[sid] = s.seq;
            s.chat_history_size_at_prompt = history.size();
            s.status = "running";
            s.updated = std.millis();
            if(interactive)
                last_interactive_ms = std.millis();
            turn_log_reset(sid, prompt);
            push_event(s, "user", [text = prompt]);
            push_event(s, "status", [status = "running"]);
            save_session(sid);

            return [ok = true, session = session_view(sid)];
        }

        // The session is accepted but not started yet: the follow-up is part of the
        // same task and is appended to the prompt that will run when a slot frees.
        if(s.status == "queued") {
            s.prompt = ws_str(s.prompt) ? ws_str(s.prompt) + "\n\n" + prompt : prompt;
            s.chat_history_size_at_prompt = history.size();
            s.updated = std.millis();
            if(!queue_contains(sid))
                queue.push_back(sid);

            turn_log_reset(sid, s.prompt);
            push_event(s, "user", [text = prompt]);
            push_event(s, "status", [status = "queued"]);
            save_session(sid);

            dispatch_queue();
            return [ok = true, session = session_view(sid)];
        }

        cs = std.critical_section_named("workspace_sessions");

        if(active_count() >= max_sessions()) {
            s.status = "queued";
            s.prompt = prompt;
            s.attempts = 0;
            s.report = "";
            s.error = "";
            s.chat_history_size_at_prompt = history.size();
            s.updated = std.millis();
            if(!queue_contains(sid))
                queue.push_back(sid);
            cs.release();

            turn_log_reset(sid, prompt);
            push_event(s, "user", [text = prompt]);
            push_event(s, "status", [status = "queued"]);
            save_session(sid);

            dispatch_queue();
            return [ok = true, session = session_view(sid)];
        }

        cs.release();

        s.status = "starting";
        s.attempts = 0;
        s.report = "";
        s.error = "";

        if(!spawn(sid)) {
            sessions.erase(sid);
            dequeue(sid);
            return [ok = false, error = s.error];
        }

        if(!pump_active[sid]) {
            pump_active[sid] = true;
            std.thread([this, sid]() {
                this.pump(sid);
            }).run();
        }

        send_json(sid, [type = "prompt", text = prompt, reasoning_effort = s.reasoning_effort]);

        s.prompt = prompt;
        live_texts[sid] = "";
        live_text_seqs[sid] = s.seq;
        s.chat_history_size_at_prompt = history.size();
        s.status = "running";
        s.updated = std.millis();
        if(interactive)
            last_interactive_ms = std.millis();
        turn_log_reset(sid, prompt);
        push_event(s, "user", [text = prompt]);
        push_event(s, "status", [status = "running"]);
        save_session(sid);

        return [ok = true, session = session_view(sid)];
    }

    set_mode(sid, mode) {
        s = session_record(sid);

        if(!s)
            return [ok = false, error = "unknown session"];

        if(deleting_sessions[sid])
            return [ok = false, error = "session deletion is in progress"];

        mode = ws_str(mode);

        if(mode != "goal")
            mode = "normal";

        s.mode = mode;
        s.updated = std.millis();
        send_json(sid, [type = "mode", mode = mode]);
        push_event(s, "status", [status = s.status, mode = mode]);
        save_session(sid);

        return [ok = true, session = session_view(sid)];
    }

    set_reasoning_effort(sid, effort) {
        s = session_record(sid);

        if(!s)
            return [ok = false, error = "unknown session"];

        if(deleting_sessions[sid])
            return [ok = false, error = "session deletion is in progress"];

        effort = ws_str(effort).lowercase();

        if(!ws_valid_reasoning_effort(effort))
            return [ok = false, error = "reasoning_effort must be low, medium, or high"];

        s.reasoning_effort = effort;
        s.updated = std.millis();
        push_event(s, "status", [status = s.status, reasoning_effort = effort]);
        save_session(sid);

        return [ok = true, session = session_view(sid)];
    }

    stop_session(sid) {
        s = session_record(sid);

        if(!s)
            return false;

        dequeue(sid);

        if(s.status == "done" || s.status == "failed" || s.status == "question" || s.status == "stopped") {
            stop_requested[sid] = true;
            return true;
        }

        // Mark the intent before touching the process: a pump that sees the exit
        // in between must report the stop, not a failure.
        stop_requested[sid] = true;
        s.status = "stopped";
        s.report = "The session was stopped.";
        s.error = "";
        s.updated = std.millis();
        push_event(s, "status", [status = "stopped"]);
        save_session(sid);
        emit_finished_task(s);

        p = procs[sid];

        if(p && p.running()) {
            send_json(sid, [type = "stop"]);
            p.stop();
            std.sleep(200);

            if(p.running())
                p.terminate();
            std.sleep(200);

            if(p.running())
                p.kill();
        }

        // the stopped session frees its slot: a queued task can start now
        dispatch_queue();

        return true;
    }

    pump(sid) {
        for(1) {
            s = session_record(sid);

            if(!s)
                break;

            if(s.status == "done" || s.status == "failed" || s.status == "question" || s.status == "stopped")
                break;

            p = procs[sid];

            if(!p)
                break;

            // Drain stdout before checking running(): the child can exit after
            // writing its final delta and done line, while both remain buffered.
            line = p.read_line("stdout", 100);

            if(line.empty()) {
                err = p.read_line("stderr", 0);

                if(err && s.status == "starting") {
                    s.error = err;
                    push_event(s, "error", [message = err]);
                    save_session(sid);
                }

                if(!p.running()) {
                    s.attempts++;

                    if(stop_requested[sid]) {
                        finish_terminal(s, "stopped", s.report ?? "The session was stopped.", "");
                        break;
                    }

                    recovered = recovered_turn(session_dir(sid), s);

                    if(std.is_json(recovered)) {
                        s.token_usage = recovered.token_usage;
                        finish_terminal(
                            s,
                            recovered.status,
                            recovered.report,
                            recovered.status == "failed" ? recovered.report : ""
                        );
                        break;
                    }

                    s.report = err ? "the session process exited without a terminal result: " + err
                        : "the session process exited without a terminal result";
                    s.error = s.report;
                    push_event(s, "error", [message = s.error]);
                    finish_terminal(s, "failed", s.report, s.error);
                    break;
                }

                std.sleep(20);
                continue;
            }

            // A stop intent wins over a late delta/error line.
            if(stop_requested[sid] && s.status == "stopped")
                break;

            data = None;

            try {
                data = std.json(line, true);
            } catch(e) {
                data = None;
            }

            if(!std.is_json(data))
                continue;

            type = ws_str(data.type);

            if(type == "ready") {
                s.status = s.prompt ? "running" : "waiting";
                s.updated = std.millis();
                push_event(s, "status", [status = s.status]);
                save_session(sid);
            }
            else if(type == "delta") {
                action = data.action;

                if(!std.is_json(action))
                    action = std.json();

                s.status = "running";
                s.updated = std.millis();
                clipped = ws_clip_event_action(action);
                e = push_event(s, "delta", [action = clipped]);
                turn_log_add(sid, clipped);
                streamed = !std.is_none(action.text) || !std.is_none(action.reasoning);

                if(!std.is_none(action.text)) {
                    live_texts[sid] = ws_str(live_texts[sid]) + ws_str(action.text);
                    live_text_seqs[sid] = e.seq;
                }

                if(streamed)
                    save_session_lazy(sid);
                else
                    save_session(sid);
            }
            else if(type == "stats") {
                s.token_usage = std.int(data.token_usage);
                live_texts[sid] = "";
                s.updated = std.millis();
                e = push_event(s, "stats", [token_usage = s.token_usage]);
                live_text_seqs[sid] = e.seq;
                save_session(sid);
            }
            else if(type == "file") {
                f = [
                    name = ws_str(data.name),
                    bytes = std.int(data.bytes),
                    caption = ws_str(data.caption),
                    data = ws_str(data.data),
                ];

                s.updated = std.millis();
                // (the event says that a file went out, not the file: the data is megabytes)
                push_event(s, "file", [name = f.name, bytes = f.bytes, caption = f.caption]);
                turn_log_push(sid, [kind = "notice", text = "sent the file " + f.name + " (" + std.string(f.bytes) + " bytes)" + (f.caption ? ": " + f.caption : "")]);
                save_session(sid);
                file_event(f);
            }
            else if(type == "notify") {
                msg = ws_str(data.message);

                s.updated = std.millis();
                push_event(s, "notify", [message = msg]);
                turn_log_push(sid, [kind = "notice", text = "notification: " + msg]);
                save_session(sid);
                notify_user(msg);
            }
            else if(type == "error") {
                s.error = ws_str(data.message);
                if(!s.error)
                    s.error = "Agent reported an unspecified error";
                s.updated = std.millis();
                push_event(s, "error", [message = s.error]);

                if(stop_requested[sid])
                    finish_terminal(s, "stopped", s.error, "");
                else
                    finish_terminal(s, "failed", s.error, s.error);

                break;
            }
            else if(type == "done") {
                status = ws_str(data.status, "failed");

                if(status != "finished" && status != "failed" && status != "question" && status != "stopped")
                    status = "failed";

                if(stop_requested[sid])
                    status = "stopped";

                s.report = ws_str(data.report);
                s.token_usage = std.int(data.token_usage);
                s.error = status == "failed" ? s.report : "";

                finish_terminal(s, status, s.report, s.error);
                break;
            }
        }

        pump_active[sid] = false;
    }

    notify(msg) {
        return notify_user(msg);
    }

    notify_user(msg) {
        msg = ws_str(msg);
        notifications.push_back([message = msg, time = std.millis()]);

        for(notifications.size() > WS_NOTIFY_KEPT)
            notifications.erase(0);

        sent = 0;

        for(cb : notify_listeners) {
            try {
                cb(msg);
                sent++;
            } catch(e) {
                std.error("[workspaces] notify listener failed: ", e);
            }
        }

        return [ok = true, listeners = sent, message = msg];
    }

    add_notify_listener(cb) {
        if(std.is_function(cb))
            notify_listeners.push_back(cb);
    }

    add_file_listener(cb) {
        if(std.is_function(cb))
            file_listeners.push_back(cb);
    }

    file_event(f) {
        if(!std.is_json(f))
            return 0;

        sent = 0;

        for(cb : file_listeners) {
            try {
                cb(f);
                sent++;
            } catch(e) {
                std.error("[workspaces] file listener failed: ", e);
            }
        }

        return sent;
    }

    share_file(path, caption = "") {
        path = ws_str(path);

        if(!path || !fileio.exists(path))
            return [ok = false, error = "file not found: " + path];

        data = fileio.read_file(path);
        f = [
            name = fileio.file_name(path),
            bytes = data.size(),
            caption = ws_str(caption),
            data = std.base64_encode(data),
        ];

        sent = file_event(f);

        if(!sent)
            return [ok = false, error = "no chat is connected to this workspace manager"];

        return [ok = true, name = f.name, bytes = f.bytes];
    }

    overview(workspace_id) {
        workspace_id = ws_str(workspace_id);
        active_tasks = [];
        tasks_scheduled = [];
        tasks_finished = [];
        tasks_failed = [];

        for(k, s : sessions) {
            if(s.workspace_id != workspace_id)
                continue;

            info = inspect_task(k);
            info.workspace_id = workspace_id;

            state = ws_str(info.state);

            if(state == "running")
                active_tasks.push_back(info);
            else if(state == "planned" || state == "queued")
                tasks_scheduled.push_back(info);
            else if(state == "finished")
                tasks_finished.push_back(info);
            else
                tasks_failed.push_back(info);
        }

        return [
            tasks = active_tasks,
            tasks_scheduled = tasks_scheduled,
            tasks_finished = tasks_finished,
            tasks_failed = tasks_failed,
        ];
    }

    tasks(workspace_id) {
        ov = overview(workspace_id);
        out = [];

        for(t : ov.tasks)
            out.push_back(t);
        for(t : ov.tasks_scheduled)
            out.push_back(t);
        for(t : ov.tasks_finished)
            out.push_back(t);
        for(t : ov.tasks_failed)
            out.push_back(t);

        return out;
    }

    stop_workspace(workspace_id) {
        workspace_id = ws_str(workspace_id);
        stopped = 0;

        for(k, s : sessions) {
            if(s.workspace_id != workspace_id)
                continue;

            if(s.status == "queued" || s.status == "starting" || s.status == "running" || s.status == "waiting") {
                try {
                    if(stop_session(k))
                        stopped++;
                } catch(e) {
                    std.error("[workspaces] session stop failed: ", e);
                }
            }
        }

        return stopped;
    }

    add_task_finished_listener(cb, owner = "") {
        if(!std.is_function(cb))
            return false;

        cs = std.critical_section_named("workspace_listeners");
        listeners.push_back(cb);
        listener_owners.push_back(ws_str(owner));
        cs.release();

        return true;
    }

    // A workspace scheduler / architecture board unregisters its listener when
    // the workspace is stopped. Otherwise the manager would call a listener whose
    // captured `this` was released, which throws "class not valid".
    remove_task_finished_listener(owner) {
        owner = ws_str(owner);

        if(!owner)
            return false;

        cs = std.critical_section_named("workspace_listeners");
        removed = false;

        for(i = 0; i < listeners.size(); i++) {
            if(listener_owners[i] == owner) {
                listeners.erase(i);
                listener_owners.erase(i);
                removed = true;
                i--;
            }
        }

        cs.release();
        return removed;
    }

    // One terminal event per task turn. The durable result is written first,
    // the SSE `done` event follows, and listeners are notified at most once.
    finish_terminal(s, status, report, error = "", dispatch_next = true) {
        if(terminal_reported[s.id])
            return false;

        s.status = status == "finished" ? "done" : status;
        s.report = ws_str(report);
        s.error = ws_str(error);
        s.updated = std.millis();

        e = push_event(s, "done", [
            ok = json.bool(status == "finished"),
            status = status,
            report = s.report,
            token_usage = s.token_usage,
        ]);
        live_text_seqs[s.id] = e.seq;
        save_session(s.id);
        emit_finished_task(s);

        // A terminal turn frees its slot: the next accepted task starts now.
        if(dispatch_next)
            dispatch_queue();

        return true;
    }

    emit_finished_task(s) {
        if(terminal_reported[s.id])
            return;

        terminal_reported[s.id] = true;

        task = [
            taskid = s.id,
            workspace_id = s.workspace_id,
            name = s.title,
            origin = ws_str(s.origin),
            state = host_state(s.status),
            report = s.report,
            error = s.error,
            token_usage = s.token_usage,
            last_update_ms = s.updated,
        ];

        cs = std.critical_section_named("workspace_listeners");
        current_listeners = listeners.copy();
        cs.release();

        for(cb : current_listeners) {
            try {
                cb(task);
            } catch(e) {
                std.error("[workspaces] finished listener failed: ", e);
            }
        }
    }

    // What the goal scheduler asks before it starts background work.
    // interactive_idle_secs: seconds since a person last asked for something, a huge
    // number when nobody has since the node started. (It was a constant 0, which the
    // scheduler read as "someone is typing right now": with the template's
    // yield_after_interactive = 10m no scheduled goal ever started, only urgent ones.)
    capacity() {
        idle = 1000000000;

        if(last_interactive_ms)
            idle = math.max(0, std.int((std.millis() - last_interactive_ms) / 1000));

        return [
            workers = max_sessions(),
            busy = active_count(),
            queued = queued_count(),
            interactive_idle_secs = idle,
        ];
    }

    stats() {
        active = 0;
        running = 0;
        total = 0;
        tokens = [];
        session_status = std.json();

        for(k, s : sessions) {
            if(!s)
                continue;

            total++;
            session_status[k] = s.status;
            if(s.status == "starting" || s.status == "running" || s.status == "waiting")
                active++;

            p = procs[k];

            if(p && p.running())
                running++;

            tokens[k] = s.token_usage;
        }

        return [
            active_sessions = active,
            queued_sessions = queued_count(),
            total_sessions = total,
            running_processes = running,
            token_usage = tokens,
            session_status = session_status,
            max_sessions = max_sessions(),
        ];
    }
}

// ═══════════════════════════════════════════════════════════════════════════
//  Workspace — one task executor, its scheduler and architecture board
// ═══════════════════════════════════════════════════════════════════════════

class Workspace {
    id = "";
    name = "";
    path = "";
    parent = "";
    record = [];
    manager = None;
    scheduler = None;
    board = None;
    cfg_spec = "";
    token = "";

    __init__(_record, _manager, _cfg_spec, _token = "") {
        record = std.is_json(_record) ? _record.copy() : [];
        manager = _manager;
        cfg_spec = ws_str(_cfg_spec);
        token = ws_str(_token);

        id = ws_str(record.id);
        name = ws_str(record.name, "Workspace");
        path = ws_str(record.path);
        parent = ws_str(record.parent);
        scheduler = None;
        board = None;

        // The synthetic root is a container; it has no project scheduler and no
        // .agentspace. The node's own scheduler is attached later by Node.
        if(id && id != "root" && path) {
            space = GoalSpace(path + "/.agentspace");

            if(!space.exists())
                space.init(__DIR__ + "/agentspace_template");

            try {
                scheduler = GoalScheduler(space, this, [workspace_id = id]);
                scheduler.start();
            } catch(e) {
                std.error("[workspaces] goal scheduler failed: ", e);
                scheduler = None;
            }

            try {
                board = ArchitectureBoard(this, path + "/.megamind/architecture", "adaptive");
            } catch(e) {
                std.error("[workspaces] architecture board failed: ", e);
                board = None;
            }
        }
    }

    add_task(name, goal, role = "adaptive", origin = "") {
        role = ws_str(role, "adaptive");
        if(!role)
            role = "adaptive";

res = manager.create_session(id, ws_str(name), "normal", ws_str(goal), role, "medium", ws_str(origin));

        if(res.ok && std.is_json(res.session))
            return ws_str(res.session.id);

        return "";
    }

    // (the workspace's own callers: its goal scheduler and architecture board;
    // a person's follow-up goes through SessionManager.send_prompt directly)
    update_task(taskid, message) {
        res = manager.send_prompt(ws_str(taskid), ws_str(message), None, false);
        return res.ok ? true : false;
    }

    stop_task(taskid) {
        return manager.stop_session(ws_str(taskid));
    }

    inspect_task(taskid) {
        info = manager.inspect_task(ws_str(taskid));

        if(std.is_json(info))
            info.workspace_id = id;

        return info;
    }

    get_overview() {
        return manager.overview(id);
    }

    tasks() {
        return manager.tasks(id);
    }

    goals() {
        if(!scheduler)
            return [];

        try {
            return scheduler.overview();
        } catch(e) {
            std.error("[workspaces] goals overview failed: ", e);
            return [];
        }
    }

    add_task_finished_listener(cb, owner = "") {
        manager.add_task_finished_listener(cb, owner);
    }

    remove_task_finished_listener(owner) {
        return manager.remove_task_finished_listener(owner);
    }

    add_notify_listener(cb) {
        manager.add_notify_listener(cb);
    }

    add_file_listener(cb) {
        manager.add_file_listener(cb);
    }

    notify_user(msg) {
        return manager.notify_user(msg);
    }

    share_file(path, caption = "") {
        return manager.share_file(path, caption);
    }

    background_capacity() {
        return manager.capacity();
    }

    stop() {
        stopped = 0;

        if(scheduler) {
            try {
                scheduler.stop();
            } catch(e) {}
            scheduler = None;
            stopped++;
        }

        if(board) {
            try {
                board.stop();
            } catch(e) {}
            board = None;
            stopped++;
        }

        stopped += manager.stop_workspace(id);

        return stopped;
    }

    __deinit__() {
        if(scheduler) {
            try { scheduler.stop(); } catch(e) {}
        }
        if(board) {
            try { board.stop(); } catch(e) {}
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════════
//  LiveFeed — one change counter for the web interface (GET /api/live)
//
//  The dashboard used to ask for the stats, the notifications and the task list
//  on timers and to rebuild what it showed. Now it holds one long-poll per node:
//  the feed looks at the state every WS_LIVE_TICK_MS and counts `rev` up when
//  something the dashboard shows has changed (a session's status / title /
//  tokens, the workspace list, the settings, a notification, the goals of a
//  workspace that is being watched). The request returns as soon as `rev` differs
//  from the one the page has, so the page redraws only then, and only what
//  changed. It works the same through the ShizoNet tunnel (ai_api), which is how
//  the dashboard of one node follows the others.
// ═══════════════════════════════════════════════════════════════════════════

class LiveFeed {
    registry = None;
    running = true;
    thread = None;
    rev = 1;
    base_sig = "";
    tree_rev = 1;
    tree_sig = "";
    notify_count = 0;
    goals = [];         // workspace id -> [rev, sig, seen, checked]
    extra = None;       // a function -> json merged into every answer (Node: the peers)
    extra_sig = "";

    __init__(_registry) {
        registry = _registry;
        running = true;
        rev = 1;
        base_sig = "";
        tree_rev = 1;
        tree_sig = "";
        notify_count = 0;
        goals = [];
        extra = None;
        extra_sig = "";

        // the first look is not a change: the state at the start is rev 1
        try {
            tick();
        } catch(e) {}
        rev = 1;

        t = std.thread([this]() { this.loop(); });
        t.run();
        thread = t;
    }

    stop() {
        running = false;

        if(thread) {
            try {
                thread.join();
            } catch(e) {}
            thread = None;
        }

        return true;
    }

    // what the sidebar shows of a session; `updated` is left out on purpose (it
    // moves with every streamed token)
    sessions() {
        out = [];

        for(k, s : registry.manager.sessions) {
            out.push_back([
                id = s.id,
                workspace_id = s.workspace_id,
                title = s.title,
                status = s.status,
                mode = s.mode,
                token_usage = s.token_usage,
                created = s.created,
            ]);
        }

        return out;
    }

    watch(workspace_id) {
        id = ws_str(workspace_id);

        if(!id)
            return 0;

        if(!goals.has(id))
            goals[id] = [rev = 1, sig = "", seen = std.millis_steady(), checked = 0];

        goals[id].seen = std.millis_steady();

        if(!goals[id].checked)
            check_goals(id);

        return std.int(goals[id].rev);
    }

    check_goals(id) {
        g = goals[id];
        g.checked = std.millis_steady();
        sig = "";

        try {
            sch = registry.scheduler(id);

            if(sch)
                sig = std.string(sch.overview());
        } catch(e) {
            sig = "error: " + ws_str(e);
        }

        if(sig != g.sig) {
            g.sig = sig;
            g.rev = std.int(g.rev) + 1;
            return true;
        }

        return false;
    }

    tick() {
        changed = false;

        // the workspace list: its own counter, the page reloads the tree on it
        tsig = std.string(registry.store.list());

        if(tsig != tree_sig) {
            tree_sig = tsig;
            tree_rev++;
            changed = true;
        }

        sig = std.string(sessions()) + std.string(registry.store.settings()) + std.string(registry.manager.notifications.size());

        if(extra) {
            try {
                sig += std.string(extra());
            } catch(e) {}
        }

        if(sig != base_sig) {
            base_sig = sig;
            changed = true;
        }

        now = std.millis_steady();
        drop = [];

        for(id, g : goals) {
            if(now - std.int(g.seen) > WS_LIVE_WATCH_MS) {
                drop.push_back(id);
                continue;
            }

            if(now - std.int(g.checked) >= WS_LIVE_GOALS_MS) {
                if(check_goals(id))
                    changed = true;
            }
        }

        for(id : drop)
            goals.erase(id);

        if(changed)
            rev++;

        return changed;
    }

    loop() {
        for(this.running) {
            try {
                tick();
            } catch(e) {
                std.error("[workspaces] live feed failed: ", e);
            }

            std.sleep(WS_LIVE_TICK_MS);
        }
    }

    snapshot(workspace_id = "") {
        out = [
            rev = rev,
            tree_rev = tree_rev,
            sessions = sessions(),
            stats = registry.manager.stats(),
            settings = registry.store.settings(),
            notifications = registry.manager.notifications.size(),
            goals_rev = 0,
        ];

        id = ws_str(workspace_id);

        if(id && goals.has(id))
            out.goals_rev = std.int(goals[id].rev);

        if(extra) {
            try {
                add = extra();

                if(std.is_json(add)) {
                    for(k, v : add)
                        out[k] = v;
                }
            } catch(e) {}
        }

        return out;
    }

    // Blocks until the state differs from `since` (or wait_ms passed).
    wait(since, wait_ms, workspace_id = "", alive = None) {
        since = std.int(since);
        wait_ms = std.int(wait_ms);

        if(wait_ms > WS_LIVE_WAIT_MAX_MS)
            wait_ms = WS_LIVE_WAIT_MAX_MS;

        watch(workspace_id);
        deadline = std.millis_steady() + wait_ms;

        for(this.running && rev == since && std.millis_steady() < deadline) {
            if(alive && !alive())
                break;

            std.sleep(50);
        }

        watch(workspace_id);
        return snapshot(workspace_id);
    }
}

// ═══════════════════════════════════════════════════════════════════════════
//  WorkspaceRegistry — all workspaces, one SessionManager, one store
// ═══════════════════════════════════════════════════════════════════════════

class WorkspaceRegistry {
    store = None;
    manager = None;
    workspaces = [];
    cfg_spec = "";
    token = "";
    live = None;        // LiveFeed, made by the first /api/live request
    adopted = [];       // id -> record of a workspace outside the store (the node's own)

    __init__(_cfg_spec, _token = "", _root = "", _projects_dir = "") {
        cfg_spec = ws_config_spec_absolute(_cfg_spec);
        token = ws_str(_token);

        store = WorkspaceStore(_root, _projects_dir);
        manager = SessionManager(store, cfg_spec, token);
        workspaces = [];
        live = None;
        adopted = [];

        for(rec : store.list())
            ensure(rec);

        start_all_schedulers();
    }

    ensure(record) {
        rec = std.is_json(record) ? record.copy() : [];
        id = ws_str(rec.id);

        if(!id)
            return None;

        if(workspaces.has(id))
            return workspaces[id];

        w = Workspace(rec, manager, cfg_spec, token);
        workspaces[id] = w;

        return w;
    }

    // A workspace that is not in the store (the node's own one, id "node"): it gets
    // sessions, goals, an architecture board and every API route like the others,
    // but it is not part of the project tree and cannot be removed.
    adopt(record) {
        rec = std.is_json(record) ? record.copy() : [];
        id = ws_str(rec.id);

        if(!id || !ws_str(rec.path))
            return None;

        adopted[id] = rec;
        return ensure(rec);
    }

    // the record of a workspace by id: a project of the store or an adopted one
    record(id) {
        id = ws_str(id);
        rec = store.get(id);

        if(rec)
            return rec;

        if(adopted.has(id))
            return adopted[id].copy();

        return None;
    }

    get(id) {
        id = ws_str(id);

        if(workspaces.has(id))
            return workspaces[id];

        return None;
    }

    list() {
        out = [];

        for(k, w : workspaces)
            out.push_back(w);

        return out;
    }

    tree() {
        return store.tree();
    }

    create(name, path = "", parent = "", description = "") {
        res = store.create(name, path, parent, description);

        if(!res.ok)
            return None;

        return ensure(res.workspace);
    }

    delete(id) {
        id = ws_str(id);

        if(id == "root")
            return [ok = false, error = "the root workspace cannot be deleted", code = 409];

        if(adopted.has(id))
            return [ok = false, error = "the node's own workspace cannot be removed", code = 409];

        w = get(id);

        if(!w)
            return [ok = false, error = "unknown workspace", code = 404];

        for(c : store.list()) {
            if(c.parent == id)
                return [ok = false, error = "workspace has children", code = 409];
        }

        sessions = manager.list_sessions(id);
        removed_sessions = [];

        for(s : sessions) {
            res = manager.delete_session(s.id);

            if(!res.ok) {
                return [
                    ok = false,
                    error = "could not delete session " + ws_str(s.id) + ": " + ws_str(res.error, "failed"),
                    code = 409,
                    sessions_removed = removed_sessions,
                ];
            }

            removed_sessions.push_back(ws_str(s.id));
        }

        res = store.delete(id);

        if(!res.ok)
            return [
                ok = false,
                error = ws_str(res.error, "failed"),
                code = 409,
                sessions_removed = removed_sessions,
            ];

        w.stop();
        workspaces.erase(id);

        return [
            ok = true,
            removed = id,
            sessions_removed = removed_sessions,
            files_kept = true,
        ];
    }

    scheduler(id) {
        w = get(id);

        if(!w)
            return None;

        return w.scheduler;
    }

    board(id) {
        w = get(id);

        if(!w)
            return None;

        return w.board;
    }

    start_all_schedulers() {
        started = 0;

        for(k, w : workspaces) {
            if(!w.scheduler)
                continue;

            try {
                w.scheduler.start();
                started++;
            } catch(e) {
                std.error("[workspaces] scheduler start failed: ", e);
            }
        }

        return started;
    }

    live_feed() {
        if(!live)
            live = LiveFeed(this);

        return live;
    }

    stop() {
        stopped = 0;

        if(live) {
            try {
                live.stop();
            } catch(e) {}
            live = None;
        }

        for(k, w : workspaces)
            stopped += w.stop();

        workspaces = [];

        return stopped;
    }
}

// compatibility helpers for the old adapter routes
workspaces_get_host(ctx, workspace_id) {
    return ctx.get(workspace_id);
}

workspaces_get_board(ctx, workspace_id) {
    return ctx.board(workspace_id);
}

workspaces_get_scheduler(ctx, workspace_id) {
    return ctx.scheduler(workspace_id);
}

workspaces_start_all_schedulers(ctx) {
    return ctx.start_all_schedulers();
}

workspaces_board_reply(res) {
    if(std.is_json(res) && res.has("ok") && !res.ok)
        return node_api_err(ws_str(res.error, "failed"), 409);

    return node_api_ok(res);
}

// Remove a workspace and every session that belongs to it. Project files stay
// on disk. Children are refused before sessions are deleted, so a refused delete
// leaves the workspace and its sessions intact.
workspaces_delete_workspace(ctx, workspace_id) {
    return ctx.delete(ws_str(workspace_id));
}

// Activate / pause / cancel a goal of this workspace (the task menu).
// clear_dry_run only applies when activating: it edits the goal file policy so
// the scheduler dispatches workers instead of writing a prompt to history.md.
workspaces_goal_status(ctx, workspace_id, goal_id, status, clear_dry_run = false) {
    scheduler = workspaces_get_scheduler(ctx, workspace_id);

    if(!scheduler) {
        return [ok = false, error = "goal scheduler unavailable"];
    }

    if(clear_dry_run && status == "active") {
        f = scheduler.space.find(goal_id);

        if(f) {
            r = scheduler.space.load(f);

            if(r.ok && r.def.policy.dry_run) {
                upd = goal_tool_update(scheduler, [
                    id = goal_id,
                    revision = r.revision,
                    dry_run = "no",
                ]);

                if(!upd.ok) {
                    return [
                        ok = false,
                        error = "could not clear dry_run: " + gj_str(upd, "error", ""),
                    ];
                }
            }
        }
    }

    res = scheduler.space.move(goal_id, status);

    if(res.ok) {
        try {
            scheduler.rescan();
            scheduler.write_overview();
        } catch(e) {
            std.error("[workspaces] goal rescan failed: ", e);
        }
    }

    return res;
}

// Delete a goal: remove every folder copy and let the scheduler notice the
// removal (it stops open runs, keeps project files).
workspaces_delete_goal(ctx, workspace_id, goal_id) {
    scheduler = workspaces_get_scheduler(ctx, workspace_id);

    if(!scheduler) {
        return [ok = false, error = "goal scheduler unavailable"];
    }

    removed = scheduler.space.remove(goal_id);

    if(!removed) {
        return [ok = false, error = "no goal '" + goal_id + "'"];
    }

    try {
        scheduler.rescan();
        scheduler.write_overview();
    } catch(e) {
        std.error("[workspaces] goal rescan failed: ", e);
    }

    return [ok = true, removed = goal_id];
}

// ═══════════════════════════════════════════════════════════════════════════
//  HTTP API
// ═══════════════════════════════════════════════════════════════════════════

workspaces_api_register(server, cfg, api_token, registry = None) {
    if(!registry) {
        spec = "";

        if(std.is_string(cfg)) {
            spec = std.string(cfg);
        } else if(std.is_json(cfg)) {
            if(cfg.has("spec"))
                spec = ws_str(cfg.spec);
            else if(cfg.has("name"))
                spec = ws_str(cfg.name);
        }

        registry = WorkspaceRegistry(spec, api_token);
    }

    registry.token = ws_str(api_token);
    store = registry.store;
    manager = registry.manager;
    token = registry.token;
    ctx = registry;

    // ── global routes ──────────────────────────────────────────────────────
    server.route("GET", "^/api/workspaces$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        return node_api_ok([
            tree = ctx.store.tree(),
            workspaces = ctx.store.list(),
            settings = ctx.store.settings(),
            stats = ctx.manager.stats(),
            projects_dir = ctx.store.projects_dir,
            general = ctx.record("node"),
        ]);
    });

    // GET /api/tasks/overview: the goals and the sessions of every workspace of this
    // node in one answer (the "All tasks" view; one call per node instead of one per
    // workspace, which matters when the node is asked over ShizoNet).
    server.route("GET", "^/api/tasks/overview$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        out = [];

        for(w : ctx.list()) {
            if(w.id == "root")
                continue;

            goals = [];

            if(w.scheduler) {
                try {
                    goals = w.scheduler.overview();
                } catch(e) {
                    std.error("[workspaces] goals overview failed: ", e);
                }
            }

            out.push_back([
                id = w.id,
                name = w.name,
                goals = goals,
                sessions = ctx.manager.host_tasks(w.id),
            ]);
        }

        return node_api_ok([workspaces = out]);
    });

    // GET /api/live?since=<rev>&wait=<ms>&workspace=<id>: the change feed (LiveFeed).
    // Answers at once when the page is behind, otherwise when something changes.
    server.route("GET", "^/api/live$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        since = node_api_int(req.query_params, "since", 0);
        wait_ms = node_api_int(req.query_params, "wait", 0);
        workspace_id = node_api_get(req.query_params, "workspace");

        return node_api_ok(ctx.live_feed().wait(since, wait_ms, workspace_id));
    });

    server.route("POST", "^/api/workspaces$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        body = node_api_body(req);

        if(std.is_none(body))
            return node_api_err("Invalid request body");

        name = node_api_get(body, "name");

        if(name.strip().empty())
            return node_api_err("Missing 'name'");

        path = node_api_get(body, "path");
        parent = node_api_get(body, "parent");
        description = node_api_get(body, "description");

        res = ctx.store.create(name, path, parent, description);

        if(!res.ok)
            return node_api_err(res.error, 400);

        ctx.ensure(res.workspace);
        workspaces_get_scheduler(ctx, res.workspace.id);

        return node_api_ok(res.workspace);
    });

    server.route("GET", "^/api/settings$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        return node_api_ok(ctx.store.settings());
    });

    server.route("PUT", "^/api/settings$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        body = node_api_body(req);

        if(std.is_none(body))
            return node_api_err("Invalid request body");

        max_sessions = node_api_int(body, "max_sessions", 0);

        if(max_sessions <= 0)
            return node_api_err("Missing 'max_sessions'");

        res = ctx.store.set_settings(max_sessions);

        if(!res.ok)
            return node_api_err(res.error, 400);

        return node_api_ok(res.settings);
    });

    server.route("GET", "^/api/stats$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        return node_api_ok(ctx.manager.stats());
    });

    // ── workspace routes ───────────────────────────────────────────────────
    server.route("GET", "^/api/workspaces/([0-9a-zA-Z_-]+)$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        w = ctx.record(workspace_id);

        if(!w)
            return node_api_err("unknown workspace", 404);

        board = workspaces_get_board(ctx, workspace_id);
        scheduler = workspaces_get_scheduler(ctx, workspace_id);

        architecture = None;
        goals = [];

        if(board) {
            try {
                architecture = board.state();
            } catch(e) {
                std.error("[workspaces] architecture state failed: ", e);
            }
        }

        if(scheduler) {
            try {
                goals = scheduler.overview();
            } catch(e) {
                std.error("[workspaces] goals overview failed: ", e);
            }
        }

        return node_api_ok([
            workspace = w,
            sessions = ctx.manager.list_sessions(workspace_id),
            architecture = architecture,
            goals = goals,
            tasks = ctx.manager.host_tasks(workspace_id),
        ]);
    });

    server.route("DELETE", "^/api/workspaces/([0-9a-zA-Z_-]+)$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        res = workspaces_delete_workspace(ctx, workspace_id);

        if(!res.ok)
            return node_api_err(res.error, res.code);

        return node_api_ok([
            removed = res.removed,
            sessions_removed = res.sessions_removed,
            files_kept = res.files_kept,
        ]);
    });

    server.route("GET", "^/api/workspaces/([0-9a-zA-Z_-]+)/sessions$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);

        if(!ctx.record(workspace_id))
            return node_api_err("unknown workspace", 404);

        return node_api_ok(ctx.manager.list_sessions(workspace_id));
    });

    server.route("POST", "^/api/workspaces/([0-9a-zA-Z_-]+)/sessions$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);

        if(!ctx.record(workspace_id))
            return node_api_err("unknown workspace", 404);

        body = node_api_body(req);

        if(std.is_none(body))
            return node_api_err("Invalid request body");

        title = node_api_get(body, "title");
        mode = node_api_get(body, "mode", "normal");
        prompt = node_api_get(body, "prompt");
        role = node_api_get(body, "role", "adaptive");
        reasoning_effort = node_api_get(body, "reasoning_effort", "medium");

        if(!workspaces_get_scheduler(ctx, workspace_id))
            return node_api_err("workspace goal scheduler unavailable", 409);

        res = ctx.manager.create_session(workspace_id, title, mode, prompt, role, reasoning_effort, "web");

        if(!res.ok)
            return node_api_err(res.error, 409);

        return node_api_ok(res.session);
    });

    // ── architecture routes ────────────────────────────────────────────────
    server.route("GET", "^/api/workspaces/([0-9a-zA-Z_-]+)/architecture$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        board = workspaces_get_board(ctx, workspace_id);

        if(!board)
            return node_api_err("unknown workspace or architecture board", 404);

        return node_api_ok(board.state());
    });

    server.route("POST", "^/api/workspaces/([0-9a-zA-Z_-]+)/architecture/analyze$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        board = workspaces_get_board(ctx, workspace_id);

        if(!board)
            return node_api_err("unknown workspace or architecture board", 404);

        return workspaces_board_reply(board.analyze());
    });

    server.route("POST", "^/api/workspaces/([0-9a-zA-Z_-]+)/architecture/edits$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        board = workspaces_get_board(ctx, workspace_id);

        if(!board)
            return node_api_err("unknown workspace or architecture board", 404);

        body = node_api_body(req);

        if(std.is_none(body))
            return node_api_err("Invalid request body");

        return workspaces_board_reply(board.add_edit(body));
    });

    server.route("DELETE", "^/api/workspaces/([0-9a-zA-Z_-]+)/architecture/edits/([0-9a-zA-Z_-]+)$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        board = workspaces_get_board(ctx, workspace_id);

        if(!board)
            return node_api_err("unknown workspace or architecture board", 404);

        n = board.remove_edit(std.string(req.matches[1]));

        if(!n)
            return node_api_err("unknown edit", 404);

        return node_api_ok([removed = n]);
    });

    server.route("POST", "^/api/workspaces/([0-9a-zA-Z_-]+)/architecture/discard$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        board = workspaces_get_board(ctx, workspace_id);

        if(!board)
            return node_api_err("unknown workspace or architecture board", 404);

        return node_api_ok([removed = board.discard_edits()]);
    });

    server.route("POST", "^/api/workspaces/([0-9a-zA-Z_-]+)/architecture/layout$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        board = workspaces_get_board(ctx, workspace_id);

        if(!board)
            return node_api_err("unknown workspace or architecture board", 404);

        body = node_api_body(req);

        if(std.is_none(body) || !body.has("positions"))
            return node_api_err("Missing 'positions'");

        return node_api_ok([moved = board.set_layout(body.positions)]);
    });

    server.route("POST", "^/api/workspaces/([0-9a-zA-Z_-]+)/architecture/plan$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        board = workspaces_get_board(ctx, workspace_id);

        if(!board)
            return node_api_err("unknown workspace or architecture board", 404);

        body = node_api_body(req);

        if(std.is_none(body))
            return node_api_err("Invalid request body");

        return workspaces_board_reply(board.review_plan(node_api_get(body, "feedback")));
    });

    server.route("POST", "^/api/workspaces/([0-9a-zA-Z_-]+)/architecture/apply$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        board = workspaces_get_board(ctx, workspace_id);

        if(!board)
            return node_api_err("unknown workspace or architecture board", 404);

        return workspaces_board_reply(board.apply());
    });

    // ── per-workspace task routes ──────────────────────────────────────────
    server.route("GET", "^/api/workspaces/([0-9a-zA-Z_-]+)/tasks$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);

        if(!ctx.record(workspace_id))
            return node_api_err("unknown workspace", 404);

        scheduler = workspaces_get_scheduler(ctx, workspace_id);
        goals = [];

        if(scheduler) {
            try {
                goals = scheduler.overview();
            } catch(e) {
                std.error("[workspaces] goals overview failed: ", e);
            }
        }

        templates = [];

        if(scheduler) {
            try {
                for(f : fileio.files(scheduler.space.root + "/templates", false)) {
                    templates.push_back([
                        name = fileio.file_name(f),
                        path = scheduler.space.root + "/templates/" + f,
                    ]);
                }
            } catch(e) {
                std.error("[workspaces] template list failed: ", e);
            }
        }

        return node_api_ok([
            goals = goals,
            sessions = ctx.manager.host_tasks(workspace_id),
            templates = templates,
        ]);
    });

    server.route("POST", "^/api/workspaces/([0-9a-zA-Z_-]+)/tasks$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);

        if(!ctx.record(workspace_id))
            return node_api_err("unknown workspace", 404);

        body = node_api_body(req);

        if(std.is_none(body))
            return node_api_err("Invalid request body");

        goal = node_api_get(body, "goal");

        if(goal.strip().empty())
            return node_api_err("Missing 'goal'");

        name = node_api_get(body, "name");
        role = node_api_get(body, "role", "adaptive");
        mode = node_api_get(body, "mode", "normal");

        if(name.strip().empty())
            name = "Task-" + std.random_hash(6);

        if(!workspaces_get_scheduler(ctx, workspace_id))
            return node_api_err("workspace goal scheduler unavailable", 409);

        res = ctx.manager.create_session(workspace_id, name, mode, goal, role, "medium", "web");

        if(!res.ok)
            return node_api_err(res.error, 409);

        return node_api_ok([
            taskid = res.session.id,
            name = name,
            state = "planned",
        ]);
    });

    // ── goal routes: the task menu can create / activate scheduled tasks ───
    server.route("POST", "^/api/workspaces/([0-9a-zA-Z_-]+)/goals$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);

        if(!ctx.record(workspace_id))
            return node_api_err("unknown workspace", 404);

        scheduler = workspaces_get_scheduler(ctx, workspace_id);

        if(!scheduler)
            return node_api_err("goal scheduler unavailable", 409);

        body = node_api_body(req);

        if(std.is_none(body))
            return node_api_err("Invalid request body");

        res = goal_tool_create(scheduler, body);

        if(!res.ok)
            return node_api_err(res.error, 400);

        try {
            scheduler.rescan();
            scheduler.write_overview();
        } catch(e) {
            std.error("[workspaces] goal rescan failed: ", e);
        }

        return node_api_ok(res);
    });

    server.route("POST", "^/api/workspaces/([0-9a-zA-Z_-]+)/goals/([0-9a-zA-Z_-]+)/run$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        goal_id = std.string(req.matches[1]);

        if(!ctx.record(workspace_id))
            return node_api_err("unknown workspace", 404);

        scheduler = workspaces_get_scheduler(ctx, workspace_id);
        if(!scheduler)
            return node_api_err("goal scheduler unavailable", 409);

        scheduler.rescan();
        res = scheduler.request_run(goal_id);
        if(!res.ok)
            return node_api_err(res.error, 409);

        return node_api_ok([goal_id = goal_id, queued = true]);
    });

    server.route("POST", "^/api/workspaces/([0-9a-zA-Z_-]+)/goals/([0-9a-zA-Z_-]+)/status$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        goal_id = std.string(req.matches[1]);

        if(!ctx.record(workspace_id))
            return node_api_err("unknown workspace", 404);

        body = node_api_body(req);

        if(std.is_none(body))
            return node_api_err("Invalid request body");

        status = node_api_get(body, "status", "active");
        clear = node_api_get(body, "clear_dry_run", "0").lowercase();
        clear_dry_run = clear == "yes" || clear == "true" || clear == "1";

        res = workspaces_goal_status(ctx, workspace_id, goal_id, status, clear_dry_run);

        if(!res.ok)
            return node_api_err(res.error, 409);

        return node_api_ok(res);
    });

    server.route("DELETE", "^/api/workspaces/([0-9a-zA-Z_-]+)/goals/([0-9a-zA-Z_-]+)$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        goal_id = std.string(req.matches[1]);

        if(!ctx.record(workspace_id))
            return node_api_err("unknown workspace", 404);

        res = workspaces_delete_goal(ctx, workspace_id, goal_id);

        if(!res.ok)
            return node_api_err(res.error, 404);

        return node_api_ok(res);
    });

    server.route("GET", "^/api/workspaces/([0-9a-zA-Z_-]+)/tasks/([0-9a-zA-Z_-]+)$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        taskid = std.string(req.matches[1]);
        s = ctx.manager.get_session(taskid);

        if(!s || s.workspace_id != workspace_id)
            return node_api_err("unknown task", 404);

        info = ctx.manager.inspect_task(taskid);

        if(std.is_string(info))
            return node_api_err(info, 404);

        return node_api_ok(info);
    });

    server.route("PUT", "^/api/workspaces/([0-9a-zA-Z_-]+)/tasks/([0-9a-zA-Z_-]+)$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        taskid = std.string(req.matches[1]);
        s = ctx.manager.get_session(taskid);

        if(!s || s.workspace_id != workspace_id)
            return node_api_err("unknown task", 404);

        body = node_api_body(req);

        if(std.is_none(body))
            return node_api_err("Invalid request body");

        message = node_api_get(body, "message");

        if(message.strip().empty())
            return node_api_err("Missing 'message'");

        res = ctx.manager.send_prompt(taskid, message);

        if(!res.ok)
            return node_api_err(res.error, 409);

        return node_api_ok([taskid = taskid, state = "updated"]);
    });

    server.route("DELETE", "^/api/workspaces/([0-9a-zA-Z_-]+)/tasks/([0-9a-zA-Z_-]+)$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        workspace_id = std.string(req.matches[0]);
        taskid = std.string(req.matches[1]);
        s = ctx.manager.get_session(taskid);

        if(!s || s.workspace_id != workspace_id)
            return node_api_err("unknown task", 404);

        ctx.manager.stop_session(taskid);

        return node_api_ok([taskid = taskid, state = "stopped"]);
    });

    // ── session routes ─────────────────────────────────────────────────────
    server.route("DELETE", "^/api/sessions/([0-9a-zA-Z_-]+)$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        sid = std.string(req.matches[0]);
        res = ctx.manager.delete_session(sid);
        if(!res.ok)
            return node_api_err(res.error, res.error == "unknown session" ? 404 : 409);
        return node_api_ok([removed = sid]);
    });

    server.route("GET", "^/api/sessions/([0-9a-zA-Z_-]+)$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        sid = std.string(req.matches[0]);
        s = ctx.manager.get_session(sid);

        if(!s)
            return node_api_err("unknown session", 404);

        history = ctx.manager.session_chat_history(sid);

        if(!std.is_list(history)) {
            std.error("[workspaces] session chat history unavailable: ", sid);
            history = [];
        }

        // after the file read (it suspends): the turn log and the seq of one moment
        live = ctx.manager.session_live_state(sid);
        now_s = ctx.manager.get_session(sid);
        s.chat_history = history;
        s.live_text = live.text;
        s.live_text_seq = live.seq;
        s.turn = ctx.manager.turn_log(sid);
        s.turn_seq = now_s ? now_s.seq : s.seq;
        s.status = now_s ? now_s.status : s.status;
        return node_api_ok(s);
    });

    server.route("POST", "^/api/sessions/([0-9a-zA-Z_-]+)/prompt$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        sid = std.string(req.matches[0]);
        body = node_api_body(req);

        if(std.is_none(body))
            return node_api_err("Invalid request body");

        prompt = node_api_get(body, "prompt");
        reasoning_effort = node_api_get(body, "reasoning_effort", None);

        if(prompt.strip().empty())
            return node_api_err("Missing 'prompt'");

        res = ctx.manager.send_prompt(sid, prompt, reasoning_effort);

        if(!res.ok)
            return node_api_err(res.error, 409);

        return node_api_ok([session_id = sid, status = res.session.status]);
    });

    server.route("POST", "^/api/sessions/([0-9a-zA-Z_-]+)/mode$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        sid = std.string(req.matches[0]);
        body = node_api_body(req);

        if(std.is_none(body))
            return node_api_err("Invalid request body");

        mode = node_api_get(body, "mode", "normal");

        res = ctx.manager.set_mode(sid, mode);

        if(!res.ok)
            return node_api_err(res.error, 409);

        return node_api_ok([session_id = sid, mode = res.session.mode]);
    });

    server.route("POST", "^/api/sessions/([0-9a-zA-Z_-]+)/effort$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        sid = std.string(req.matches[0]);
        body = node_api_body(req);

        if(std.is_none(body))
            return node_api_err("Invalid request body");

        reasoning_effort = node_api_get(body, "reasoning_effort");

        res = ctx.manager.set_reasoning_effort(sid, reasoning_effort);

        if(!res.ok)
            return node_api_err(res.error, 409);

        return node_api_ok(res.session);
    });

    server.route("POST", "^/api/sessions/([0-9a-zA-Z_-]+)/stop$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        sid = std.string(req.matches[0]);

        if(!ctx.manager.stop_session(sid))
            return node_api_err("unknown session", 404);

        return node_api_ok([session_id = sid, status = "stopped"]);
    });

    // GET /api/sessions/<id>/events?since=<seq>&wait=<ms>: the events after `since` as
    // JSON. The twin of /stream for a caller without a streaming connection: the
    // dashboard of another node asks through ShizoNet. With `wait` the answer is held
    // back until there is an event or the session ends.
    server.route("GET", "^/api/sessions/([0-9a-zA-Z_-]+)/events$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token))
            return node_api_err("Unauthorized", 401);

        sid = std.string(req.matches[0]);
        since = node_api_int(req.query_params, "since", 0);
        wait_ms = node_api_int(req.query_params, "wait", 0);

        if(wait_ms > WS_EVENTS_WAIT_MAX_MS)
            wait_ms = WS_EVENTS_WAIT_MAX_MS;

        deadline = std.millis_steady() + wait_ms;

        for(1) {
            s = ctx.manager.get_session(sid);

            if(!s)
                return node_api_err("unknown session", 404);

            out = [];

            for(e : ctx.manager.session_events(sid)) {
                if(e.seq > since)
                    out.push_back(e);
            }

            terminal = s.status == "done" || s.status == "failed" || s.status == "question" || s.status == "stopped";

            if(out.size() || terminal || std.millis_steady() >= deadline) {
                return node_api_ok([
                    session_id = sid,
                    status = s.status,
                    seq = s.seq,
                    terminal = json.bool(terminal),
                    events = out,
                ]);
            }

            std.sleep(WS_STREAM_POLL_MS);
        }
    });

    api_route_stream(server, "GET", "^/api/sessions/([0-9a-zA-Z_-]+)/stream$", [ctx, token](req, writer) {
        if(!node_api_authorized(req, token)) {
            writer.write_header(401, "application/json; charset=utf-8", node_api_headers());
            writer.write(std.string([ok = json.bool(false), error = "Unauthorized"]));
            writer.end();
            return;
        }

        sid = std.string(req.matches[0]);
        s = ctx.manager.get_session(sid);

        if(!s) {
            writer.write_header(404, "application/json; charset=utf-8", node_api_headers());
            writer.write(std.string([ok = json.bool(false), error = "Unknown session"]));
            writer.end();
            return;
        }

        if(!writer.write_header(200, "text/event-stream", node_api_headers([
            "Content-Type" = "text/event-stream; charset=utf-8",
            "Cache-Control" = "no-cache",
            "Connection" = "keep-alive",
            "X-Accel-Buffering" = "no",
        ])))
            return;

        writer.write_sse(std.string([session_id = sid, status = "connected"]), "status");

        last_seq = node_api_int(req.query_params, "since", 0);
        last_ping = std.millis();

        for(1) {
            if(!writer.is_client_alive())
                break;

            s = ctx.manager.get_session(sid);

            if(!s)
                break;

            events = ctx.manager.session_events(sid);
            sent = false;

            for(e : events) {
                if(e.seq > last_seq) {
                    last_seq = e.seq;
                    payload = e.copy();
                    payload.erase("type");
                    writer.write_sse(payload.compact_string(), std.string(e.type));
                    sent = true;
                }
            }

            if(s.status == "done" || s.status == "failed" || s.status == "question" || s.status == "stopped")
                break;

            if(!sent && std.millis() - last_ping > WS_STREAM_PING_MS) {
                writer.write(": ping\n\n");
                last_ping = std.millis();
            }

            std.sleep(WS_STREAM_POLL_MS);
        }

        writer.end();
    });

    return registry;
}
