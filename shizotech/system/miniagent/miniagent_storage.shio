// ═══════════════════════════════════════════════════════════════════════════
//  miniagent_storage.shio — the ONE global storage root of miniagent
//
//  A node and its web UI must not depend on the directory they were started
//  from. Goals, sessions, architecture and workspace data live below
//  std.user_path()/miniagent:
//
//      std.user_path()/miniagent/node/          the node's own mind + .agentspace
//      std.user_path()/miniagent/workspaces/   the workspace registry (root)
//
//  A project workspace below the registry owns its own .agentspace,
//  .megamind/sessions and .megamind/architecture; the sandbox/root workspace
//  does not get a project goal store.
// ═══════════════════════════════════════════════════════════════════════════

MINIAGENT_HOME_NAME = "miniagent";

miniagent_home() {
    base = std.string(std.user_path() ?? "");

    if(!base)
        base = std.string(std.wd() ?? "");

    return fileio.absolute_path(base + "/" + MINIAGENT_HOME_NAME);
}

miniagent_node_root() {
    return miniagent_home() + "/node";
}

miniagent_node_agentspace() {
    return miniagent_node_root() + "/.agentspace";
}

miniagent_node_architecture() {
    return miniagent_node_root() + "/.megamind/architecture";
}

miniagent_workspaces_root() {
    return miniagent_home() + "/workspaces";
}
