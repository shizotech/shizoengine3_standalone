// ═════════════════════════════════════════════════════════════════════════════
//  web_ui.shio — the web interface of a Node: shz miniagent --node --web
//
//      shz miniagent --node --web [--port 13337] [--api-token secret]
//
//  One HTTP server on the Node:
//    /                       the dashboard (web/index.html): the nodes of the
//                            network, their workspaces, sessions, tasks and
//                            architecture graphs
//    /api/...                the Node JSON API (node_api.shio, node_api.md)
//    /api/workspaces...      WorkspaceRegistry routes (workspaces.shio)
//    /api/nodes              this node and the other AI nodes on ShizoNet
//    /api/nodes/<id>/api/... the same API of another node: the request goes to
//                            that node over ShizoNet (ai_api), never over HTTP
//
//  Every page works offline: no CDN, everything is in web/.
//  With --api-token the pages ask for the token once (kept in the browser).
//
//      #include "web_ui"
//      opts = web_ui_parse(web_ui_args());       // [web, port, api_token]
//      ui = web_ui_start(node, cfg, opts, registry);  // [server, board, runtime] | None
// ═════════════════════════════════════════════════════════════════════════════
 
#include "node_api"
#include "workspaces"
#include "node_peers"
#include "gateway_config"

WEB_UI_DEFAULT_PORT = 13337;
WEB_UI_ROOT = __DIR__ + "/web";

// The dashboard is web/index.html. The old chat and tasks pages are no longer
// part of the web UI; deny them at the static root. The architecture editor is
// still embedded by the dashboard's Architecture tab, so it must be served.
web_ui_protect(req) {
	p = std.string(req.path ?? "");
	if(p == "/chat" || p.starts("/chat/") || p == "/tasks" || p.starts("/tasks/"))
		return false;
	return true;
}

// the command line as a list (index 0, the script, left out)
web_ui_args() {
	args = [];
	for(i = 1; i < std.argc(); i++) {
		a = std.argv(i);
		args.push_back(a ? std.string(a) : "");
	}
	return args;
}

web_ui_value(args, flag) {
	for(i = 0; i < args.size(); i++) {
		a = std.string(args[i]);
		if(a == flag && i + 1 < args.size())
			return std.string(args[i + 1]);
		if(a.starts(flag + "="))
			return a.substr(flag.length() + 1);
	}
	return "";
}

web_ui_has(args, flag) {
	for(a : args) {
		if(std.string(a) == flag)
			return true;
	}
	return false;
}

// -> [web, port, api_token]
//    web: --web (also --web=<port>); port: --port, else 13337
web_ui_parse(args) {
	web = web_ui_has(args, "--web");
	port = WEB_UI_DEFAULT_PORT;

	inline = web_ui_value(args, "--web");
	if(inline && !inline.starts("--") && std.int(inline) > 0) {
		web = true;
		port = std.int(inline);
	}

	p = web_ui_value(args, "--port");
	if(p && std.int(p) > 0)
		port = std.int(p);

	return [
		web = web,
		port = port,
		api_token = web_ui_value(args, "--api-token"),
	];
}

// ─────────────────────────────────────────────────────────────────────────────
//  The other nodes: /api/nodes and the proxy /api/nodes/<id>/api/...
//
//  The page talks to its own node only. A call for another node is handed to
//  that node over ShizoNet (NodePeers.call -> ai_api) and its answer goes back
//  unchanged, so every route of the API works for every node on the network:
//  workspaces, sessions, tasks, goals, the architecture graph.
//  These routes are HTTP only (they are not in the ApiRouter table): a node
//  does not forward calls for a third node.
// ─────────────────────────────────────────────────────────────────────────────

WEB_UI_REMOTE_EVENTS_WAIT_MS = 3000;    // long-poll of a remote session's events
WEB_UI_REMOTE_EVENTS_FAILS = 5;         // failed polls in a row that end a remote stream
WEB_UI_SESSION_LOAD_TIMEOUT_MS = 60000; // GET /api/sessions/<id> reads the whole chat history

web_ui_node_self(node, cfg) {
    name = "Node";
    description = "";
    model = "";
    goals = false;
    running = 0;

    try { name = node.node_name(); } catch(e) {
        try { name = std.string(node.name ?? "Node"); } catch(e2) {}
    }
    try { description = std.string(node.description ?? ""); } catch(e) {}
    try { model = std.string(cfg.name ?? ""); } catch(e) {}
    try { goals = node.goals ? true : false; } catch(e) {}
    try { running = node.get_overview().tasks.size(); } catch(e) {}

    return [
        id = "local",
        name = name,
        kind = "node",
        local = json.bool(true),
        online = json.bool(true),
        ip = "",
        description = description,
        model = model,
        busy = json.bool(running > 0),
        tasks_running = running,
        goals = json.bool(goals),
        api = json.bool(true),
    ];
}

web_ui_peers(node) {
    try {
        if(node && !std.is_none(node.peers))
            return node.peers;
    } catch(e) {}

    return None;
}

web_ui_reply(code, text) {
    return [status_code = code, headers = node_api_headers(), body = std.string(text)];
}

// GET /api/nodes/<id>/api/sessions/<sid>/stream: the events of a session of another
// node as server sent events. The node is asked for the events after the last one
// (a long-poll over ShizoNet), so the page uses the same EventSource for every node.
web_ui_remote_stream(peers, node_id, sid, req, writer) {
    if(!writer.write_header(200, "text/event-stream", node_api_headers([
        "Content-Type" = "text/event-stream; charset=utf-8",
        "Cache-Control" = "no-cache",
        "Connection" = "keep-alive",
        "X-Accel-Buffering" = "no",
    ])))
        return;

    writer.write_sse(std.string([session_id = sid, status = "connected"]), "status");

    since = node_api_int(req.query_params, "since", 0);
    fails = 0;
    last_ping = std.millis();

    for(writer.is_client_alive()) {
        r = peers.call(node_id, "GET", "/api/sessions/" + sid + "/events",
            None, [since = std.string(since), wait = std.string(WEB_UI_REMOTE_EVENTS_WAIT_MS)],
            WEB_UI_REMOTE_EVENTS_WAIT_MS + AI_TIMEOUT_CONTROL);

        data = None;

        if(r.ok && r.status_code == 200) {
            try {
                parsed = std.json(r.body, true);

                if(std.is_json(parsed) && parsed.ok && std.is_json(parsed.data))
                    data = parsed.data;
            } catch(e) {
                data = None;
            }
        }

        if(!data) {
            // the session is gone: nothing more will come
            if(r.status_code == 404) {
                writer.write_sse(std.string([message = "The session does not exist on that node any more."]), "error");
                break;
            }

            fails++;

            if(fails >= WEB_UI_REMOTE_EVENTS_FAILS) {
                writer.write_sse(std.string([message = "The node does not answer any more."]), "error");
                break;
            }

            std.sleep(500);
            continue;
        }

        fails = 0;
        sent = false;

        if(std.is_json(data.events)) {
            for(e : data.events) {
                if(e.seq > since)
                    since = e.seq;

                payload = e.copy();
                payload.erase("type");
                writer.write_sse(payload.compact_string(), std.string(e.type));
                sent = true;
            }
        }

        if(data.terminal)
            break;

        if(!sent && std.millis() - last_ping > WS_STREAM_PING_MS) {
            writer.write(": ping\n\n");
            last_ping = std.millis();
        }
    }

    writer.end();
}

// http: the raw webserver object (the proxy routes are not part of the API table)
web_ui_node_routes(http, node, cfg, api_token) {
    http.route("GET", "^/api/nodes$", [node, cfg, api_token](req, writer) {
        if(!node_api_authorized(req, api_token))
            return node_api_err("Unauthorized", 401);

        list = [web_ui_node_self(node, cfg)];
        peers = web_ui_peers(node);
        rev = 0;

        if(peers) {
            for(p : peers.list())
                list.push_back(p);

            rev = peers.rev;
        }

        return node_api_ok([nodes = list, rev = rev]);
    });

    http.route("*", "^/api/nodes/([0-9a-zA-Z_-]+)(/api/.*)$", [node, api_token](req, writer) {
        if(std.string(req.method) == "OPTIONS")
            return web_ui_reply(204, "");

        if(!node_api_authorized(req, api_token))
            return node_api_err("Unauthorized", 401);

        node_id = std.string(req.matches[0]);
        path = std.string(req.matches[1]);
        peers = web_ui_peers(node);

        if(!peers)
            return web_ui_reply(503, [ok = json.bool(false), error = "This node is not on ShizoNet."]);

        // the one streaming route: the events of a session, as on the node itself
        if(path.starts("/api/sessions/") && path.ends("/stream")) {
            sid = path.removeprefix("/api/sessions/").removesuffix("/stream");

            if(sid && !sid.contains("/")) {
                web_ui_remote_stream(peers, node_id, sid, req, writer);
                return;
            }
        }

        body = None;
        raw = std.string(req.body ?? "");

        if(raw.strip())
            body = raw;

        // a long-poll (/api/live, .../events) may hold the answer back: give it time
        timeout = AI_TIMEOUT_API;
        wait_ms = node_api_int(req.query_params, "wait", 0);

        if(wait_ms > 0) {
            timeout = wait_ms + AI_TIMEOUT_CONTROL;
        } else if(std.string(req.method) == "GET" && path.starts("/api/sessions/") && !path.ends("/events")) {
            // opening a session reads its whole chat history: a long one can take much
            // longer than a normal API call
            timeout = WEB_UI_SESSION_LOAD_TIMEOUT_MS;
        }

        // the query of the page, without the token of THIS node
        query = std.json();

        if(std.is_json(req.query_params)) {
            for(k, v : req.query_params) {
                if(std.string(k) != "token")
                    query[std.string(k)] = std.string(v);
            }
        }

        r = peers.call(node_id, std.string(req.method), path, body, query, timeout);
        return web_ui_reply(std.int(r.status_code), r.body);
    });
}

// ─────────────────────────────────────────────────────────────────────────────
//  Workspace boards are served by workspaces_api_register; no node-level
//  /api/architecture routes here.
// ─────────────────────────────────────────────────────────────────────────────

// -> [server, board, runtime], None when the port cannot be bound
//    server: the ApiRouter around the HTTP server (api_router.shio)
//    registry: the WorkspaceRegistry to serve; defaults to node.registry.
//    board: the Node workspace's board (compatibility for node.shio); no legacy
//           node-level ArchitectureBoard is created here.
web_ui_start(node, cfg, opts, registry = None) {
	port = std.int(opts.port ?? WEB_UI_DEFAULT_PORT);
	token = std.string(opts.api_token ?? "");

	if(std.is_none(registry)) {
		try {
			registry = node.registry;
		} catch(e) {
			registry = None;
		}
	}

	server = node_api_start(node, cfg, port, token, WEB_UI_ROOT, web_ui_protect);
	if(!server)
		return None;

	web_ui_node_routes(server.server, node, cfg, token);

	runtime = workspaces_api_register(server, cfg, token, registry);
	gateway_api_register(server, node, token);

	board = None;
	try {
		if(node && !std.is_none(node.node_workspace) && !std.is_none(node.node_workspace.board))
			board = node.node_workspace.board;
	} catch(e) {}

	return [server = server, board = board, runtime = runtime];
}
