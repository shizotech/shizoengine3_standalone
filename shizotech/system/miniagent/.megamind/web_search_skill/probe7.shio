// probe7: byte-level string semantics + table building

std.print("--- utf8 byte indexing ---");
s = "aé€b";
std.print("size=", s.size());
for(i = 0; i < s.size(); i++)
{
	c = s.substr(i, 1);
	std.print(i, "=[", c, "] len=", c.size());
}

std.print("--- buffer roundtrip 0..255 ---");
b = std.buffer();
vals = [];
for(i = 0; i < 256; i++)
	vals.push_back(i);
b.append(vals);
tab = b.string();
std.print("tab size=", tab.size());
std.print("find A: ", tab.find("A"), " find eurobyte E2: ", tab.find(std.buffer([226]).string()));
std.print("substr(65,1)=[", tab.substr(65, 1), "]");
std.print("find nul: ", tab.find(std.buffer([0]).string()));

std.print("--- hexpairs ---");
hp = "";
for(i = 0; i < 256; i++)
	hp += "0123456789ABCDEF".substr(i / 16, 1) + "0123456789ABCDEF".substr(i % 16, 1);
std.print("hp size=", hp.size(), " [", hp.substr(0, 8), "] [", hp.substr(20 * 2, 2), "]");

std.print("--- decode %C3%A9 ---");
out = std.buffer();
out.append([195, 169]);
std.print("[", out.string(), "]");

std.print("--- global write from function ---");
g_test = "init";
setter() { g_test = "changed"; }
setter();
std.print(g_test);

lazy = "";
init_lazy() { lazy = "set"; return 1; }
getv() { if(lazy == "") init_lazy(); return lazy; }
std.print(getv(), " ", getv());

std.print("--- html size of big page scan speed ---");
html = fileio.read_string(__DIR__ + "/ddg_lite.html");
std.print("html size=", html.size());
t = std.millis();
cnt = 0;
p = 0;
for(1) {
	p = html.find("result-snippet", p);
	if(p < 0) break;
	cnt++;
	p += 5;
}
std.print("snippets=", cnt, " ms=", std.millis() - t);

std.print("--- 577KB scan ---");
big = "";
for(i = 0; i < 3000; i++)
	big += "<div class='x'><a href='http://e.com/1'>Link " + i + " &amp; x</a> text here</div>";
std.print("big=", big.size());
t2 = std.millis();
acc = std.buffer();
i = 0;
n = big.size();
for(i < n)
{
	c = big.substr(i, 1);
	if(c == "<")
	{
		e = big.find(">", i);
		if(e < 0) { break; }
		i = e + 1;
		continue;
	}
	acc.append(c);
	i++;
}
std.print("scan ms=", std.millis() - t2, " out=", acc.size());
