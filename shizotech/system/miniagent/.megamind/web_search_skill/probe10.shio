// probe10: chunked html->text scanner performance

big = "";
for(i = 0; i < 6000; i++)
	big += "<div class='x'><a href='http://e.com/1'>Link " + i + " &amp; x</a> some text here &lt;b&gt;</div>";
big += "<script>var q = '<div>';</script><style>.a{color:red}</style>";
std.print("input size=", big.size());

t = std.millis();

out = std.buffer();
i = 0;
n = big.size();
for(i < n)
{
	lt = big.find("<", i);
	if(lt < 0)
	{
		out.append(big.substr(i, n - i));
		break;
	}
	if(lt > i)
		out.append(big.substr(i, lt - i));

	if(big.find("<!--", i) == lt)
	{
		e = big.find("-->", lt + 4);
		i = e < 0 ? n : e + 3;
		continue;
	}

	gt = big.find(">", lt + 1);
	if(gt < 0) { i = n; break; }

	tag = big.substr(lt + 1, gt - lt - 1).lowercase();
	if(tag.find("script") == 0)
	{
		e = big.find("</script", gt);
		i = e < 0 ? n : e + 9;
		continue;
	}
	if(tag.find("style") == 0)
	{
		e = big.find("</style", gt);
		i = e < 0 ? n : e + 8;
		continue;
	}
	out.append(" ");
	i = gt + 1;
}

res = out.string();
std.print("scan ms=", std.millis() - t, " out size=", res.size());

t2 = std.millis();
std.print("compress ms=", res.compress_whitespace().size(), " ", std.millis() - t2);

std.print("=== entity decode ===");
ent = "a &amp; b &#39;c&#39; &quot;d&quot; &#x263A; &nbsp; &lt;e&gt; &#128512; &unknown; &#;";
std.print(ent);

std.print("hex table: ");
tb = std.buffer();
vals = [];
for(v = 0; v < 256; v++)
	vals.push_back(v);
tb.append(vals);
hexs = std.buffer();
hx = [];
for(v = 0; v < 256; v++)
{
	hx.push_back(std.int("0x" + "0123456789ABCDEF".substr(v / 16, 1)));
	hx.push_back(std.int("0x" + "0123456789ABCDEF".substr(v % 16, 1)));
}
hexs.append(hx);
hextab = hexs.string();
std.print("hextab size=", hextab.size(), " [", hextab.substr(20 * 2, 2), "] [", hextab.substr(255 * 2, 2), "]");
onebyte = std.buffer();
onebyte.append([226]);
std.print("bytetab find A=", tb.find("A"), " find 0xE2=", tb.find(onebyte.string()));

std.print("=== utf8 encode 128512 ===");
cp = 128512;
b4 = std.buffer();
b4.append([240 + cp / 0x40000, 128 + (cp / 0x1000) % 0x40, 128 + (cp / 0x40) % 0x40, 128 + cp % 0x40]);
std.print("[", b4.string(), "]");
cp2 = 8364;
b3 = std.buffer();
b3.append([224 + cp2 / 0x1000, 128 + (cp2 / 0x40) % 0x40, 128 + cp2 % 0x40]);
std.print("[", b3.string(), "]");

std.print("=== url encode ===");
q = "shizoscript & café 中文";
enc = "";
for(k = 0; k < q.size(); k++)
{
	ch = q.substr(k, 1);
	v = tb.find(ch);
	if(v >= 0)
	{
		if((v >= 65 && v <= 90) || (v >= 97 && v <= 122) || (v >= 48 && v <= 57) || v == 45 || v == 46 || v == 95 || v == 126)
			enc += ch;
		else if(v == 32)
			enc += "+";
		else
			enc += "%" + hextab.substr(v * 2, 2);
	}
}
std.print("[", enc, "]");
