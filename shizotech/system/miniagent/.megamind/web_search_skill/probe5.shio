s = "a<b>c<b>d";
std.print("find first: ", s.find("<b>"));
std.print("find from 3: ", s.find("<b>", 3));
std.print("find missing: ", s.find("zz"));
std.print("substr(2,3): [", s.substr(2, 3), "]");
std.print("substr(-3): [", s.substr(-3), "]");
std.print("size: ", s.size());

std.print("--- json helpers ---");
j = [a = 1, b = "x"];
std.print(j.has("a"), " ", j.key(0), " ", j.size());
std.print(j.geti("c"));
std.print(j.has("c"));

std.print("--- list ---");
l = [3, 1, 2];
std.print(l.size(), " ", l.has_value(3));
l.sort();
std.print(l);

std.print("--- int to string concat ---");
std.print("n=" + 5);
std.print(std.string(5));

std.print("--- split ---");
p = "a,b,c".split(",");
std.print(p.size(), " ", p[1], " ", std.type(p));

std.print("--- json string of list ---");
std.print(std.string([1, 2, 3]));

std.print("--- entity map replace ---");
t = "a &amp; b &#39;c&#39; &quot;d&quot; &nbsp; &#x263A;";
std.print(t.replace(["&amp;" = "&", "&lt;" = "<"]));

std.print("--- char codes ---");
std.print(std.string(65), " ", std.int("65"), " ", std.int("0x41"));

std.print("--- types ---");
std.print(std.type(5), " ", std.type("5"), " ", std.type(5.5), " ", std.type([]), " ", std.type([a=1]));

std.print("--- exitprocess/type of None member ---");
n = None;
std.print(std.type(n));

std.print("--- string index ---");
std.print("abc".substr(1, 1));

std.print("--- push_back on json list ---");
o = [];
o.push_back(1);
o.push_back([k = 2]);
std.print(std.string(o));

std.print("--- erase ---");
o.erase(0);
std.print(std.string(o));

std.print("--- critical section ---");
cs = std.critical_section("web_skill");
std.print("locked");
cs.release();

std.print("--- config path ---");
std.print(std.config_path("miniagent", "websearch"));
std.print(fileio.exists(std.config_path("miniagent", "websearch")));
