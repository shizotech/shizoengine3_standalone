// probe17: dump bing rss + marginalia old + bing html ck/a

import curl;

c = curl.curl();
UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36";
H = ["User-Agent" = UA, "Accept-Language" = "en-US,en;q=0.9"];

r = c.get("https://www.bing.com/search?q=shizoscript+programming&format=rss", H, 25000);
fileio.write_string(__DIR__ + "/bing_rss.xml", std.string(r.body));
std.print("bing rss code=", r.geti("http_code"), " size=", std.string(r.body).size());

r2 = c.get("https://old-search.marginalia.nu/search?query=shizoscript", H, 25000);
fileio.write_string(__DIR__ + "/marginalia_old.html", std.string(r2.body));
std.print("marg old code=", r2.geti("http_code"), " size=", std.string(r2.body).size());

r3 = c.get("https://www.bing.com/search?q=shizoscript+programming&setlang=en&cc=en-US&count=20", H, 25000);
fileio.write_string(__DIR__ + "/bing_en.html", std.string(r3.body));
std.print("bing en code=", r3.geti("http_code"), " size=", std.string(r3.body).size());

std.print("--- bing rss item sample ---");
b = std.string(r.body);
i = b.find("<item>");
std.print(i >= 0 ? b.substr(i, 900) : "NO ITEMS");

std.print("--- marginalia old result sample ---");
m = std.string(r2.body);
j = m.find("<h2");
std.print(j >= 0 ? m.substr(j - 300, 1400) : "NO H2");

std.print("--- bing en b_algo sample ---");
e = std.string(r3.body);
k = e.find("b_algo");
p = e.find("<h2", k);
std.print(p >= 0 ? e.substr(p, 700) : "NO H2");

std.print("--- base64 pad test ---");
u = "aHR0cHM6Ly93d3cuZm9vLmNvbS9iYXItYmF6";
std.print("len=", u.size(), " mod4=", u.size() % 4);
pad = u;
for(1) { if(pad.size() % 4 == 0) break; pad += "="; }
d = std.base64_decode(pad);
std.print("decoded [", std.string(d), "] type=", std.type(d));

u2 = "a1aHR0cHM6Ly93d3cubGlua2VkaW4uY29t";
std.print("with a1 prefix: [", std.string(std.base64_decode(u2 + "==")), "]");
