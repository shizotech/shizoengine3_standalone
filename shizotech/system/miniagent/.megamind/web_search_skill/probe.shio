// Probe the builtin web APIs. Throwaway investigation script.

c = curl.curl();

std.print("=== version ===");
std.print(c.version());

std.print("=== get httpbin json ===");
r = c.get("http://localhost:9/mcp");
std.print(r);

std.print("=== get https example ===");
r2 = c.get("https://example.com");
std.print(r2);

std.print("=== last_error ===");
std.print(c.last_error());

std.print("=== bad host ===");
r3 = c.get("http://no-such-host.invalid/x", [], 3000);
std.print(r3);
std.print("last_error: ", c.last_error());

std.print("=== 404 ===");
r4 = c.get("https://example.com/definitely-not-here");
std.print(r4);

std.print("=== std.web_get ===");
w = std.web_get("https://example.com");
std.print(std.type(w), " size=", std.string(w).size());
std.print(std.string(w).substr(0, 200));

std.print("=== web_get failure ===");
try {
	bad = std.web_get("http://no-such-host.invalid/x");
	std.print("returned: ", std.type(bad), " [", std.string(bad), "]");
}
catch(e) {
	std.print("threw: ", e);
}

std.print("=== headers echo (httpsbin?) ===");
r5 = c.request("GET", "https://example.com", "", [X-Test = "yes"], 8000, false);
std.print(r5);

std.print("=== regex limits on big html ===");
html = "<html><body><script>var x = 1;</script><p>hello &amp; world</p></body></html>";
std.print(html.regex_replace("<[^>]+>", " "));
std.print(html.regex_replace("&amp;", "&"));
