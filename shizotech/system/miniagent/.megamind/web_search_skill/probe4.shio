// Dump DDG lite HTML + test UA-sensitive endpoints. Throwaway.

import curl;

c = curl.curl();

UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36 miniagent-web/1.0";

r = c.get("https://lite.duckduckgo.com/lite/?q=shizoscript+programming+language", ["User-Agent" = UA], 20000);
fileio.write_string(".megamind/web_search_skill/ddg_lite.html", std.string(r.body));
std.print("lite size=", std.string(r.body).size(), " code=", r.http_code);

r2 = c.post("https://lite.duckduckgo.com/lite/", "q=shizoscript programming language", ["User-Agent" = UA, "Content-Type" = "application/x-www-form-urlencoded"], 20000);
fileio.write_string(".megamind/web_search_skill/ddg_lite_post.html", std.string(r2.body));
std.print("post size=", std.string(r2.body).size(), " code=", r2.http_code);

w = c.get("https://en.wikipedia.org/w/api.php?action=opensearch&search=shizo&limit=5&format=json", ["User-Agent" = UA], 20000);
std.print("wiki code=", w.http_code, " body=", std.string(w.body).substr(0, 400));

m = c.get("https://www.mojeek.com/search?q=shizoscript", ["User-Agent" = UA], 20000);
fileio.write_string(".megamind/web_search_skill/mojeek.html", std.string(m.body));
std.print("mojeek size=", std.string(m.body).size());

b = c.get("https://www.bing.com/search?q=shizoscript", ["User-Agent" = UA], 20000);
fileio.write_string(".megamind/web_search_skill/bing.html", std.string(b.body));
std.print("bing size=", std.string(b.body).size());
