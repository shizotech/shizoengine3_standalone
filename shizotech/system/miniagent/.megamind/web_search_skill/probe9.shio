// probe9: DDG lite POST reliability, filters, pagination.

import curl;

c = curl.curl();

UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36";
H = ["User-Agent" = UA, "Content-Type" = "application/x-www-form-urlencoded", "Accept" = "text/html"];

post(label, body)
{
	std.print("=== ", label, " ===");
	r = c.post("https://lite.duckduckgo.com/lite/", body, H, 20000);
	b = std.string(r.body);
	n = b.count("result-link");
	sn = b.count("result-snippet");
	std.print("code=", r.geti("http_code"), " size=", b.size(), " links=", n, " snippets=", sn);
	if(n == 0)
		std.print("HEAD: ", b.substr(0, 300).replace("\n", " "));
	std.print("");
}

post("plain", "q=shizoscript");
post("with df=m", "q=shizoscript&df=m");
post("with kl=de-de", "q=shizoscript&kl=de-de");
post("with df=w kl=us-en", "q=shizoscript&df=w&kl=us-en");
post("page2 s=10 dc=11", "q=shizoscript&s=10&dc=11&v=l");
post("empty q", "q=");
post("garbage", "q=zzzqqxx12398777nodata");
post("site: filter", "q=shizoscript+site:github.com");
post("quoted", "q=%22creative+coding%22");

std.print("=== GET plain repeated 3x ===");
for(i = 0; i < 3; i++)
{
	r = c.get("https://lite.duckduckgo.com/lite/?q=shizoscript+i+test+" + i, ["User-Agent" = UA], 20000);
	b = std.string(r.body);
	std.print(i, " code=", r.geti("http_code"), " size=", b.size(), " links=", b.count("result-link"));
}

std.print("=== 202 challenge body sample ===");
r2 = c.get("https://lite.duckduckgo.com/lite/?q=shizoscript&o=json", ["User-Agent" = UA], 20000);
b2 = std.string(r2.body);
std.print("code=", r2.geti("http_code"), " size=", b2.size());
std.print("anomaly marker present: ", b2.find("anomaly") >= 0, " challenge: ", b2.find("challenge") >= 0);
std.print("body: ", b2.substr(0, 1200).replace("\n", " "));
