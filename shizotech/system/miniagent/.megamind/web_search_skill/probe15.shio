// probe15: DDG lite retry + marginalia + bing parse anchors + searx instances

import curl;

c = curl.curl();

UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36";
H = ["User-Agent" = UA];

post(label, body, hdrs = ["User-Agent" = UA, "Content-Type" = "application/x-www-form-urlencoded"])
{
	r = c.post("https://lite.duckduckgo.com/lite/", body, hdrs, 25000);
	b = std.string(r.body);
	std.print(label, ": code=", r.geti("http_code"), " size=", b.size(), " links=", b.count("result-link"), " snippets=", b.count("result-snippet"));
	return b;
}

std.print("--- ddg lite POST retry ---");
post("post1", "q=shizoscript");
std.sleep(2000);
post("post2", "q=creative coding language");
std.sleep(2000);
g = c.get("https://lite.duckduckgo.com/lite/?q=libcurl", H, 25000);
std.print("get: code=", g.geti("http_code"), " links=", std.string(g.body).count("result-link"));

std.print("--- marginalia anchors ---");
m = c.get("https://search.marginalia.nu/search?query=shizoscript", H, 25000);
mb = std.string(m.body);
fileio.write_string(__DIR__ + "/marginalia.html", mb);
std.print("size=", mb.size(), " result-title=", mb.count("result-title"), " title-card=", mb.count("title-card"), " h2=", mb.count("<h2"));

std.print("--- bing anchors ---");
b = c.get("https://www.bing.com/search?q=shizoscript&count=20", H, 25000);
bb = std.string(b.body);
fileio.write_string(__DIR__ + "/bing2.html", bb);
std.print("size=", bb.size(), " b_algo=", bb.count("b_algo"), " h2=", bb.count("<h2"));

std.print("--- searx json instances ---");
insts = ["https://searx.be", "https://search.bus-hit.me", "https://priv.au", "https://searxng.site", "https://search.inetol.net", "https://baresearch.org", "https://opnxng.com"];
for(i = 0; i < insts.size(); i++)
{
	r = c.get(insts[i] + "/search?q=shizoscript&format=json", H, 15000);
	s = std.string(r.body);
	std.print(insts[i], " code=", r.geti("http_code"), " size=", s.size(), " has results=", s.find("\"results\"") >= 0);
}

std.print("--- ddg html endpoint ---");
h = c.post("https://html.duckduckgo.com/html/", "q=shizoscript", ["User-Agent" = UA, "Content-Type" = "application/x-www-form-urlencoded"], 25000);
hb = std.string(h.body);
std.print("html.ddg code=", h.geti("http_code"), " size=", hb.size(), " result__a=", hb.count("result__a"), " snippets=", hb.count("result__snippet"));
