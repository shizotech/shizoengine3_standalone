// probe20: bing rss relevance + ddg cooldown

import curl;

c = curl.curl();
UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36";
H = ["User-Agent" = UA, "Accept-Language" = "en-US,en;q=0.9"];

rss(label, q, extra = "")
{
	r = c.get("https://www.bing.com/search?q=" + q + "&format=rss&setlang=en" + extra, H, 25000);
	b = std.string(r.body);
	std.print("=== ", label, " [", q, "] code=", r.geti("http_code"), " items=", b.count("<item>"), " ===");
	p = 0;
	n = 0;
	for(1) {
		i = b.find("<item>", p);
		if(i < 0) break;
		e = b.find("</item>", i);
		it = b.substr(i, e - i);
		t = it.find("<title>");
		l = it.find("<link>");
		std.print("  ", n + 1, ". ", t >= 0 ? it.substr(t + 7, it.find("</title>", t) - t - 7) : "?");
		std.print("     ", l >= 0 ? it.substr(l + 6, it.find("</link>", l) - l - 6) : "?");
		p = e;
		n++;
		if(n >= 5) break;
	}
	std.print("");
}

rss("common", "python+programming+language");
rss("specific", "shizoscript+creative+coding");
rss("news", "openai+gpt+release");
rss("docs", "rust+book+ownership");
rss("site", "shizoscript+site:github.com");
rss("quoted", "%22shizoscript%22");
rss("libcurl", "libcurl+http+post");

std.print("=== ddg lite after long cooldown ===");
g = c.get("https://lite.duckduckgo.com/lite/?q=python+programming+language", ["User-Agent" = UA], 25000);
gb = std.string(g.body);
std.print("GET code=", g.geti("http_code"), " links=", gb.count("result-link"), " size=", gb.size());

p = c.post("https://lite.duckduckgo.com/lite/", "q=python+programming+language", ["User-Agent" = UA, "Content-Type" = "application/x-www-form-urlencoded"], 25000);
pb = std.string(p.body);
std.print("POST code=", p.geti("http_code"), " links=", pb.count("result-link"), " size=", pb.size());

std.print("=== ddg html endpoint ===");
h = c.post("https://html.duckduckgo.com/html/", "q=python+programming+language", ["User-Agent" = UA, "Content-Type" = "application/x-www-form-urlencoded"], 25000);
hb = std.string(h.body);
std.print("code=", h.geti("http_code"), " result__a=", hb.count("result__a"), " size=", hb.size());

std.print("=== brave html parse anchors ===");
b = c.get("https://search.brave.com/search?q=python+programming+language", H, 25000);
bb = std.string(b.body);
std.print("code=", b.geti("http_code"), " size=", bb.size(), " results=", bb.count("search-result"), " h2=", bb.count("<h2"));
