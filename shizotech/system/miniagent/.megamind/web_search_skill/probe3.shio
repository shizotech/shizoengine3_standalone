// Probe search endpoints + binary mode. Throwaway.

import curl;

c = curl.curl();

UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36";

test(label, url, headers = [], timeout = 15000)
{
	std.print("=== ", label, " ===");
	r = c.get(url, headers, timeout);
	if(!r.ok) {
		std.print("FAIL ok=0 ", r);
		return;
	}
	b = std.string(r.body);
	std.print("code=", r.http_code, " ct=", r.content_type, " size=", b.size());
	std.print("head: ", b.substr(0, 400).replace("\n", " "));
	std.print("");
}

test("ddg lite", "https://lite.duckduckgo.com/lite/?q=shizoscript", ["User-Agent" = UA]);
test("ddg html", "https://html.duckduckgo.com/html/?q=shizoscript", ["User-Agent" = UA]);
test("ddg html no ua", "https://html.duckduckgo.com/html/?q=shizoscript");
test("bing", "https://www.bing.com/search?q=shizoscript", ["User-Agent" = UA]);
test("wikipedia api", "https://en.wikipedia.org/w/api.php?action=opensearch&search=shizo&limit=5&format=json");
test("startpage", "https://www.startpage.com/sp/search?query=shizoscript", ["User-Agent" = UA]);
test("searx", "https://searx.be/search?q=shizoscript&format=json", ["User-Agent" = UA]);
test("mojeek", "https://www.mojeek.com/search?q=shizoscript", ["User-Agent" = UA]);

std.print("=== binary retest ===");
r7 = c.request("GET", "https://www.google.com/favicon.ico", "", [], 8000, 1);
std.print("full: ", r7);
std.print("type body: ", std.type(r7.body));

std.print("=== binary via post_file? no. try request with binary true on text ===");
r8 = c.request("GET", "https://example.com", "", [], 8000, 1);
std.print("ok=", r8.geti("ok"), " code=", r8.geti("http_code"), " type=", std.type(r8.geti("body")));

std.print("=== ddg lite POST ===");
p = c.post("https://lite.duckduckgo.com/lite/", "q=shizoscript", ["User-Agent" = UA, "Content-Type" = "application/x-www-form-urlencoded"]);
std.print("code=", p.http_code, " size=", std.string(p.body).size());

std.print("=== timing 577KB page ===");
t = std.millis();
g = c.get("http://github.com", [], 20000);
std.print("fetch ms=", std.millis() - t, " size=", std.string(g.body).size());
