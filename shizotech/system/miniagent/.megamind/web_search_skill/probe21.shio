// probe21: public searxng json instances + bing relevance guard data

import curl;

c = curl.curl();
UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36";
H = ["User-Agent" = UA, "Accept" = "application/json"];

insts = [
	"https://searx.be", "https://search.inetol.net", "https://priv.au",
	"https://searxng.site", "https://baresearch.org", "https://opnxng.com",
	"https://search.bus-hit.me", "https://northboot.xyz", "https://paulgo.io",
	"https://search.sapti.me", "https://searx.tiekoetter.com", "https://search.hbubli.cc",
	"https://searx.perennialte.ch", "https://search.rhscz.eu", "https://searxng.world",
];

for(i = 0; i < insts.size(); i++)
{
	u = insts[i] + "/search?q=shizoscript&format=json";
	r = c.get(u, H, 12000);
	b = std.string(r.body);
	okj = b.find("\"results\"") >= 0;
	std.print(insts[i], " code=", r.geti("http_code"), " ct=", r.geti("content_type"), " size=", b.size(), " json=", okj);
	if(okj)
	{
		p = b.find("title");
		std.print("   ", b.substr(0, 260).replace("\n", " "));
	}
}

std.print("");
std.print("=== searxng html (no json) ===");
for(i = 0; i < 4; i++)
{
	u = insts[i] + "/search?q=shizoscript";
	r = c.get(u, ["User-Agent" = UA], 12000);
	b = std.string(r.body);
	std.print(insts[i], " code=", r.geti("http_code"), " size=", b.size(), " article=", b.count("<article"));
}
