// probe19: jina UA sensitivity, ddg cooldown, bing rss stability

import curl;

c = curl.curl();
BROWSER = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36";

show(label, url, hdrs = None)
{
	std.print("=== ", label, " ===");
	h = [];
	if(std.is_json(hdrs))
		h = hdrs;
	r = c.get(url, h, 25000);
	b = std.string(r.body);
	std.print("code=", r.geti("http_code"), " ct=", r.geti("content_type"), " size=", b.size());
	std.print("head: ", b.substr(0, 300).replace("\n", " | "));
	std.print("");
}

show("jina no hdrs", "https://r.jina.ai/https://example.com");
show("jina empty auth", "https://r.jina.ai/https://example.com", ["Authorization" = ""]);
show("jina default ua", "https://r.jina.ai/https://example.com", ["User-Agent" = "shizoscript-miniagent/1.0"]);
show("jina browser ua", "https://r.jina.ai/https://example.com", ["User-Agent" = BROWSER]);
show("jina github", "https://r.jina.ai/https://github.com/shizotech/shizoscript3");
show("jina with timeout hdr", "https://r.jina.ai/https://en.wikipedia.org/wiki/DuckDuckGo", ["x-timeout" = "15"]);
show("jina respond text", "https://r.jina.ai/https://example.com", ["x-respond-with" = "text"]);
show("jina no cache", "https://r.jina.ai/https://example.com", ["x-no-cache" = "true"]);

std.print("=== ddg lite after cooldown ===");
g = c.get("https://lite.duckduckgo.com/lite/?q=libcurl+http", ["User-Agent" = BROWSER], 25000);
std.print("GET code=", g.geti("http_code"), " links=", std.string(g.body).count("result-link"));

p = c.post("https://lite.duckduckgo.com/lite/", "q=libcurl+http", ["User-Agent" = BROWSER, "Content-Type" = "application/x-www-form-urlencoded"], 25000);
std.print("POST code=", p.geti("http_code"), " links=", std.string(p.body).count("result-link"));

std.print("=== bing rss repeated ===");
for(i = 0; i < 3; i++)
{
	r = c.get("https://www.bing.com/search?q=shizoscript+language&format=rss&setlang=en", ["User-Agent" = BROWSER, "Accept-Language" = "en-US,en;q=0.9"], 25000);
	b = std.string(r.body);
	std.print(i, " code=", r.geti("http_code"), " items=", b.count("<item>"), " size=", b.size());
}

std.print("=== bing rss with browser UA absent ===");
r2 = c.get("https://www.bing.com/search?q=shizoscript+language&format=rss&setlang=en", [], 25000);
std.print("no hdrs code=", r2.geti("http_code"), " items=", std.string(r2.body).count("<item>"));

std.print("=== mojeek / marginalia parse anchors ===");
m = c.get("https://www.mojeek.com/search?q=shizoscript", ["User-Agent" = BROWSER], 25000);
mb = std.string(m.body);
std.print("mojeek size=", mb.size(), " results=", mb.count("class=\"title\""), " h2=", mb.count("<h2"), " ck=", mb.count("href=\"http"));
std.print(mb.substr(mb.find("<h2") - 100, 600));
