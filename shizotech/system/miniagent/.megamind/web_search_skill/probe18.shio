// probe18: bing rss language/params + marginalia old + ck/a decode

import curl;

c = curl.curl();
UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36";
H = ["User-Agent" = UA, "Accept-Language" = "en-US,en;q=0.9"];

show(label, url, hdrs = H)
{
	std.print("=== ", label, " ===");
	r = c.get(url, hdrs, 25000);
	b = std.string(r.body);
	std.print("code=", r.geti("http_code"), " ct=", r.geti("content_type"), " size=", b.size(), " items=", b.count("<item>"));
	i = b.find("<item>");
	if(i >= 0) std.print("first item: ", b.substr(i, 420).replace("\n", " "));
	std.print("");
}

show("rss setlang=en", "https://www.bing.com/search?q=shizoscript+programming&format=rss&setlang=en");
show("rss cc=US", "https://www.bing.com/search?q=shizoscript+programming&format=rss&cc=US");
show("rss en+US", "https://www.bing.com/search?q=shizoscript+programming&format=rss&setlang=en&cc=US");
show("rss en+US+count", "https://www.bing.com/search?q=shizoscript+programming&format=rss&setlang=en&cc=US&count=30");
show("rss site filter", "https://www.bing.com/search?q=shizoscript+site:github.com&format=rss&setlang=en&cc=US");
show("rss first=11", "https://www.bing.com/search?q=shizoscript&format=rss&setlang=en&cc=US&first=11");
show("rss freshness", "https://www.bing.com/search?q=shizoscript&format=rss&setlang=en&cc=US&filters=ex1:ez3");
show("rss no hdrs", "https://www.bing.com/search?q=shizoscript+programming&format=rss&setlang=en&cc=US", []);
show("rss default ua", "https://www.bing.com/search?q=shizoscript+programming&format=rss&setlang=en&cc=US", ["User-Agent" = "miniagent-web/1.0"]);

std.print("=== marginalia old ===");
m = c.get("https://old-search.marginalia.nu/search?query=shizoscript", H, 25000);
mb = std.string(m.body);
std.print("code=", m.geti("http_code"), " size=", mb.size(), " h2=", mb.count("<h2"), " a href=", mb.count("href=\"https://"));
std.print(mb.substr(0, 997));

std.print("=== ck/a decode ===");
u = "a1aHR0cHM6Ly93d3cud2lraXBlZGlhLmRlLw";
std.print("strip a1: ", std.string(std.base64_decode(u.substr(2, u.size() - 2) + "==")));
u2 = "a1aHR0cHM6Ly93d3cubGlua2VkaW4uY29tL2NvbXBhbnkveXVoYWF2aWF0YW0tb2Ytc2FuLW1hbnVlbC1uYXRpb24";
pad = u2.substr(2, u2.size() - 2);
for(1) { if(pad.size() % 4 == 0) break; pad += "="; }
std.print("pad: ", std.string(std.base64_decode(pad)));
