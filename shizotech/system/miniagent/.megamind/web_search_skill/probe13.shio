// probe13: jina without custom UA, search endpoint, options.

import curl;

c = curl.curl();

show(label, url, headers = [], timeout = 30000)
{
	std.print("=== ", label, " ===");
	r = c.get(url, headers, timeout);
	b = std.string(r.body);
	std.print("ok=", r.geti("ok"), " code=", r.geti("http_code"), " ct=", r.geti("content_type"), " size=", b.size());
	if(!r.geti("ok")) std.print("ERR: ", r);
	std.print("head: ", b.substr(0, 900).replace("\n", " | "));
	std.print("");
}

show("r.jina no hdrs", "https://r.jina.ai/https://example.com");
show("r.jina default ua", "https://r.jina.ai/https://en.wikipedia.org/wiki/DuckDuckGo", ["User-Agent" = "miniagent-web/1.0"]);
show("r.jina github", "https://r.jina.ai/https://github.com/shizotech/shizoscript3");
show("r.jina wiki", "https://r.jina.ai/https://en.wikipedia.org/wiki/Shizo");
show("s.jina encoded", "https://s.jina.ai/shizoscript%20programming%20language");
show("s.jina encoded auth empty", "https://s.jina.ai/shizoscript%20programming%20language", ["Authorization" = ""]);
show("r.jina with respond-with", "https://r.jina.ai/https://example.com", ["x-respond-with" = "markdown"]);
show("r.jina with respond-with json", "https://r.jina.ai/https://example.com", ["x-respond-with" = "json"]);
show("r.jina with timeout", "https://r.jina.ai/https://example.com", ["x-timeout" = "10"]);
show("r.jina with no-cache", "https://r.jina.ai/https://example.com", ["x-no-cache" = "true"]);
show("r.jina with retain-images", "https://r.jina.ai/https://example.com", ["x-with-generated-alt" = "true"]);
show("r.jina bad target", "https://r.jina.ai/not-a-url");
show("r.jina 404 target", "https://r.jina.ai/https://example.com/definitely-not-here-404");
show("r.jina json target", "https://r.jina.ai/https://httpbin.org/json");

std.print("=== timing ===");
t = std.millis();
r = c.get("https://r.jina.ai/https://github.com/shizotech/shizoscript3", [], 30000);
std.print("ms=", std.millis() - t, " code=", r.geti("http_code"), " size=", std.string(r.body).size());

std.print("=== rate limit probe: 5 rapid ===");
for(i = 0; i < 5; i++)
{
	t2 = std.millis();
	x = c.get("https://r.jina.ai/https://example.com/?i=" + i, [], 30000);
	std.print(i, " code=", x.geti("http_code"), " size=", std.string(x.body).size(), " ms=", std.millis() - t2);
}
