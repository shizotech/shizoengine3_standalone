// probe8: DDG lite JSON mode, pagination, region/time filters, fallbacks.

import curl;

c = curl.curl();

UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36";

show(label, url, headers = ["User-Agent" = UA], timeout = 20000)
{
	std.print("=== ", label, " ===");
	r = c.get(url, headers, timeout);
	b = std.string(r.body);
	std.print("ok=", r.geti("ok"), " code=", r.geti("http_code"), " ct=", r.geti("content_type"), " size=", b.size());
	std.print("head: ", b.substr(0, 500).replace("\n", " "));
	std.print("");
}

show("lite o=json", "https://lite.duckduckgo.com/lite/?q=shizoscript&o=json");
show("lite o=json v=l", "https://lite.duckduckgo.com/lite/?q=shizoscript&o=json&v=l");
show("d.js ia", "https://duckduckgo.com/?q=shizoscript&format=json&no_html=1&skip_disambig=1");
show("html.duckduckgo o=json", "https://html.duckduckgo.com/html/?q=shizoscript&o=json");
show("lite df=m kl=de-de", "https://lite.duckduckgo.com/lite/?q=shizoscript&df=m&kl=de-de");
show("lite dc=11 page2", "https://lite.duckduckgo.com/lite/?q=shizoscript&dc=11&s=10");
show("mojeek json", "https://www.mojeek.com/search?q=shizoscript&format=json");
show("brave", "https://search.brave.com/search?q=shizoscript");
show("ecosia", "https://www.ecosia.org/search?q=shizoscript");
show("qwant", "https://api.qwant.com/v3/search/web?q=shizoscript&count=10&locale=en_US");
show("marginalia", "https://search.marginalia.nu/search?query=shizoscript");
show("wikipedia opensearch", "https://en.wikipedia.org/w/api.php?action=opensearch&search=shizo&limit=5&format=json");
show("wikipedia search api", "https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=shizoscript&format=json&srlimit=5");

std.print("=== POST lite with o=json ===");
p = c.post("https://lite.duckduckgo.com/lite/", "q=shizoscript&o=json", ["User-Agent" = UA, "Content-Type" = "application/x-www-form-urlencoded"], 20000);
std.print("code=", p.geti("http_code"), " ct=", p.geti("content_type"), " size=", std.string(p.body).size());
