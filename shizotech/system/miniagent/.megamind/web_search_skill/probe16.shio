// probe16: RSS search endpoints + bing ck/a decoding

import curl;

c = curl.curl();
UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36";
H = ["User-Agent" = UA, "Accept-Language" = "en-US,en;q=0.9"];

show(label, url, hdrs = H)
{
	std.print("=== ", label, " ===");
	r = c.get(url, hdrs, 25000);
	b = std.string(r.body);
	std.print("code=", r.geti("http_code"), " ct=", r.geti("content_type"), " size=", b.size());
	std.print("head: ", b.substr(0, 800).replace("\n", " | "));
	std.print("");
}

show("bing rss", "https://www.bing.com/search?q=shizoscript+programming&format=rss");
show("bing rss setlang", "https://www.bing.com/search?q=shizoscript+programming&format=rss&setlang=en&cc=US");
show("bing html setlang", "https://www.bing.com/search?q=shizoscript+programming&setlang=en&cc=en-US&count=20");
show("ddg lite rss", "https://lite.duckduckgo.com/lite/?q=shizoscript&format=rss");
show("ddg rss", "https://duckduckgo.com/?q=shizoscript&format=rss");
show("marginalia rss", "https://search.marginalia.nu/search?query=shizoscript&format=rss");
show("marginalia old", "https://old-search.marginalia.nu/search?query=shizoscript");
show("marginalia url search", "https://url.marginalia.nu/search?query=shizoscript");
show("brave rss", "https://search.brave.com/search?q=shizoscript&format=rss");
show("startpage rss", "https://www.startpage.com/sp/search?query=shizoscript&format=rss");

std.print("=== b64 decode ck/a u param ===");
u = "aHR0cHM6Ly93d3cubGlua2VkaW4uY29tL2NvbXBhbnkveXVoYWF2aWF0YW0tb2Ytc2FuLW1hbnVlbC1uYXRpb24";
std.print("len=", u.size(), " mod4=", u.size() % 4);
pad = u;
for(u.size() % 4 != 0)
	pad += "=";
std.print("pad len=", pad.size());
d = std.base64_decode(pad);
std.print("decoded: [", std.string(d), "]");

std.print("=== base64url chars ===");
u2 = "aHR0cHM6Ly93d3cuZm9vLmNvbS9iYXItYmF6_p-x";
std.print("has - _ : ", u2.find("-") >= 0, " ", u2.find("_") >= 0);
