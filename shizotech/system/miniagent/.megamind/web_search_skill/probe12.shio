// probe12: utf8 encode math + entity decode + url encode/decode roundtrip

tb = std.buffer();
vals = [];
for(v = 0; v < 256; v++)
	vals.push_back(v);
tb.append(vals);
bytetab = tb.string();
std.print("bytetab size=", bytetab.size(), " find A=", bytetab.find("A"));

hx = [];
for(v = 0; v < 256; v++)
{
	hx.push_back(std.int("0x" + "0123456789ABCDEF".substr(v / 16, 1)));
	hx.push_back(std.int("0x" + "0123456789ABCDEF".substr(v % 16, 1)));
}
hb = std.buffer();
hb.append(hx);
hextab = hb.string();
std.print("hextab size=", hextab.size(), " [20]=" + hextab.substr(40, 2), " [255]=" + hextab.substr(510, 2));

std.print("--- utf8 ---");
enc(cp)
{
	b = std.buffer();
	if(cp < 128) b.append([cp]);
	else if(cp < 2048) b.append([192 + cp / 64, 128 + cp % 64]);
	else if(cp < 65536) b.append([224 + cp / 4096, 128 + (cp / 64) % 64, 128 + cp % 64]);
	else b.append([240 + cp / 262144, 128 + (cp / 4096) % 64, 128 + (cp / 64) % 64, 128 + cp % 64]);
	return b.string();
}
std.print("65=[", enc(65), "] 233=[", enc(233), "] 8364=[", enc(8364), "] 128512=[", enc(128512), "] 12363=[", enc(12363), "]");

std.print("--- url encode ---");
urlencode(s)
{
	out = "";
	for(k = 0; k < s.size(); k++)
	{
		ch = s.substr(k, 1);
		v = bytetab.find(ch);
		if(v < 0) { out += ch; continue; }
		if((v >= 65 && v <= 90) || (v >= 97 && v <= 122) || (v >= 48 && v <= 57) || v == 45 || v == 46 || v == 95 || v == 126)
			out += ch;
		else if(v == 32)
			out += "+";
		else
			out += "%" + hextab.substr(v * 2, 2);
	}
	return out;
}
q = "shizoscript & café 中文 a+b?c=d&e";
std.print("[", urlencode(q), "]");

std.print("--- url decode ---");
urldecode(s)
{
	out = std.buffer();
	k = 0;
	n = s.size();
	for(k < n)
	{
		ch = s.substr(k, 1);
		if(ch == "%" && k + 2 < n)
		{
			out.append([std.int("0x" + s.substr(k + 1, 2))]);
			k += 3;
			continue;
		}
		if(ch == "+") { out.append([32]); k++; continue; }
		out.append(ch);
		k++;
	}
	return out.string();
}
enc2 = urlencode(q);
std.print("[", urldecode(enc2), "]");
std.print("roundtrip equal: ", urldecode(enc2) == q);
std.print("decode uddg: ", urldecode("https%3A%2F%2Fgithub.com%2Fshizotech%2Fshizoscript3"));

std.print("--- entity decode ---");
named = [
	"amp" = "&", "lt" = "<", "gt" = ">", "quot" = "\"", "apos" = "'",
	"nbsp" = " ", "ndash" = "–", "mdash" = "—", "hellip" = "…",
	"middot" = "·", "lsquo" = "'", "rsquo" = "'", "ldquo" = "\"", "rdquo" = "\"",
	"copy" = "©", "reg" = "®", "trade" = "™", "deg" = "°", "plusmn" = "±",
	"times" = "×", "divide" = "÷", "frac12" = "½", "bull" = "•", "dagger" = "†",
	"larr" = "←", "rarr" = "→", "uarr" = "↑", "darr" = "↓", "harr" = "↔",
	"eacute" = "é", "uuml" = "ü", "szlig" = "ß", "infin" = "∞", "minus" = "−",
];

decode_entities(s)
{
	out = "";
	i = 0;
	n = s.size();
	for(i < n)
	{
		amp = s.find("&", i);
		if(amp < 0) { out += s.substr(i, n - i); break; }
		if(amp > i) out += s.substr(i, amp - i);
		sc = s.find(";", amp + 1);
		if(sc < 0 || sc - amp > 10) { out += "&"; i = amp + 1; continue; }
		body = s.substr(amp + 1, sc - amp - 1);
		if(body.substr(0, 1) == "#")
		{
			hex = body.substr(1, 1) == "x" || body.substr(1, 1) == "X";
			digits = hex ? body.substr(2, body.size() - 2) : body.substr(1, body.size() - 1);
			cp = std.int(hex ? "0x" + digits : digits);
			if(cp > 0) out += enc(cp);
			else out += s.substr(amp, sc - amp + 1);
		}
		else if(named.has(body))
			out += named[body];
		else
			out += s.substr(amp, sc - amp + 1);
		i = sc + 1;
	}
	return out;
}
std.print("[", decode_entities("a &amp; b &#39;c&#39; &quot;d&quot; &#x263A; &nbsp; &lt;e&gt; &#128512; &unknown; &#; &mdash; &copy; 2026"), "]");
std.print("[", decode_entities("ShizoTech is the home of Erik M — we&#x27;ve built tools"), "]");
