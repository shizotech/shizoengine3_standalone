// probe14: byte-level access to strings

s = "aé€中文b";
std.print("s=", s, " size=", s.size());
std.print("substr(1,1) size=", s.substr(1, 1).size());
std.print("substr(2,1) size=", s.substr(2, 1).size());

b = std.buffer();
b.append(s);
std.print("buffer size=", b.size());
std.print("read u8 0=", b.read("u8", 0));
std.print("read u8 1=", b.read("u8", 1));
std.print("read u8 2=", b.read("u8", 2));
std.print("read u8 last=", b.read("u8", b.size() - 1));
std.print("buffer string roundtrip equal: ", b.string() == s);

std.print("--- buffer read out of bounds ---");
try { std.print(b.read("u8", 9999)); } catch(e) { std.print("threw: ", e); }

std.print("--- perf: read u8 loop over 500KB ---");
big = "";
for(i = 0; i < 50000; i++)
	big += "abcdefghij";
bb = std.buffer();
bb.append(big);
t = std.millis();
cnt = 0;
for(i = 0; i < bb.size(); i++)
	if(bb.read("u8", i) == 97) cnt++;
std.print("ms=", std.millis() - t, " cnt=", cnt);

std.print("--- perf: substr scan over 500KB ---");
t2 = std.millis();
cnt2 = 0;
for(i = 0; i < big.size(); i++)
	if(big.substr(i, 1) == "a") cnt2++;
std.print("ms=", std.millis() - t2, " cnt=", cnt2);

std.print("--- url encode via buffer bytes ---");
hx = [];
for(v = 0; v < 256; v++)
{
	hx.push_back(std.int("0x" + "0123456789ABCDEF".substr(v / 16, 1)));
	hx.push_back(std.int("0x" + "0123456789ABCDEF".substr(v % 16, 1)));
}
hb = std.buffer();
hb.append(hx);
hextab = hb.string();
std.print("hextab size=", hextab.size(), " [0x20]=", hextab.substr(64, 2), " [0xff]=", hextab.substr(510, 2));

urlencode(s)
{
	buf = std.buffer();
	buf.append(s);
	out = "";
	for(k = 0; k < buf.size(); k++)
	{
		v = buf.read("u8", k);
		if((v >= 65 && v <= 90) || (v >= 97 && v <= 122) || (v >= 48 && v <= 57) || v == 45 || v == 46 || v == 95 || v == 126)
			out += hextab.substr(v * 2, 2);
		else if(v == 32)
			out += "+";
		else
			out += "%" + hextab.substr(v * 2, 2);
	}
	return out;
}
std.print("[", urlencode("shizoscript & café 中文 a+b?c=d&e"), "]");
