std.print("hex_to_char: ", std.hex_to_char("41"), " -> [", std.string(std.hex_to_char("41")), "]");
bb = std.buffer();
bb.append([226, 130, 172]);
std.print("utf8 euro via buffer bytes: [", bb.string(), "]");
std.print("int from hex: ", std.int("26"), " ", std.int("0x1a"));
std.print("int of bad: [", std.int("abc"), "] ", std.int(""));

std.print("--- load/save config ---");
std.print(std.config_path("miniagent", "websearch"));
c = std.load_config("miniagent", "websearch");
std.print("loaded: ", c, " type=", std.type(c));

std.print("--- std.string with multiple args ---");
std.print(std.string("a", 1, "b"));

std.print("--- json .key(i) ---");
j = [x = 1, y = 2];
std.print(j.key(0), " ", j.key(1));

std.print("--- string compare/assign on None ---");
n = None;
s = std.string(n);
std.print("[", s, "] size=", s.size());

std.print("--- substr beyond end ---");
std.print("[", "abc".substr(1, 99), "]");
std.print("[", "abc".substr(5, 2), "]");

std.print("--- find with start beyond size ---");
std.print("abc".find("b", 10));

std.print("--- std.len on string ---");
std.print(std.len("abcd"));

std.print("--- json list index out of range ---");
l = [1];
std.print(l[5]);

std.print("--- std.is_none ---");
std.print(std.is_none(None), " ", std.is_none(0));

std.print("--- string += in loop perf ---");
t = std.millis();
acc = "";
for(i = 0; i < 20000; i++)
	acc += "abcdefghij";
std.print("ms=", std.millis() - t, " size=", acc.size());

std.print("--- buffer append perf ---");
t2 = std.millis();
buf = std.buffer();
for(i = 0; i < 20000; i++)
	buf.append("abcdefghij");
std.print("ms=", std.millis() - t2, " size=", buf.size());

std.print("--- compress_whitespace ---");
std.print("[", "a  \n\t b    c".compress_whitespace(), "]");

std.print("--- split_words ---");
std.print(std.string("a b  c".split_words()));

std.print("--- std.string(buffer) ---");
b = std.buffer();
b.append("hi");
std.print("[", std.string(b), "]");

std.print("--- json .push on [] ---");
q = [];
q.push(1);
q.push(2);
std.print(std.string(q));

std.print("--- std.timestamp ---");
std.print(std.timestamp());

std.print("--- os_platform ---");
std.print(std.os_platform());
