// Probe the builtin web APIs. Throwaway investigation script.

import curl;

c = curl.curl();

std.print("=== version ===");
std.print(c.version());

std.print("=== get https example ===");
r2 = c.get("https://example.com");
std.print(r2);

std.print("=== last_error ===");
std.print(c.last_error());

std.print("=== bad host ===");
r3 = c.get("http://no-such-host.invalid/x", [], 3000);
std.print(r3);
std.print("last_error: ", c.last_error());

std.print("=== 404 ===");
r4 = c.get("https://example.com/definitely-not-here");
std.print(r4);

std.print("=== std.web_get ===");
w = std.web_get("https://example.com");
std.print(std.type(w), " size=", std.string(w).size());
std.print(std.string(w).substr(0, 200));

std.print("=== web_get failure ===");
try {
	bad = std.web_get("http://no-such-host.invalid/x");
	std.print("returned: ", std.type(bad), " [", std.string(bad), "]");
}
catch(e) {
	std.print("threw: ", e);
}

std.print("=== custom header ===");
r5 = c.request("GET", "https://example.com", "", ["X-Test" = "yes"], 8000, false);
std.print(r5);

std.print("=== redirects / headers? ===");
r6 = c.get("http://github.com");
std.print("code=", r6.http_code, " ct=", r6.content_type, " ok=", r6.ok, " size=", std.string(r6.body).size());

std.print("=== binary ===");
r7 = c.request("GET", "https://www.google.com/favicon.ico", "", [], 8000, true);
std.print("ok=", r7.ok, " type=", std.type(r7.body), " size=", std.string(r7.body).size());

std.print("=== regex on html ===");
html = "<html><body><script>var x = 1;</script><style>a{}</style><p>hello &amp; world</p></body></html>";
std.print("[", html.regex_replace("<[^>]+>", " "), "]");

std.print("=== big html regex timing ===");
big = "";
for(i = 0; i < 400; i++)
	big += "<div class='x'><a href='http://example.com/a'>Link number " + i + " &amp; more</a></div>";
std.print("size=", big.size());
t = std.millis();
out = big.regex_replace("<[^>]+>", " ");
std.print("regex ms=", std.millis() - t, " outsize=", out.size());

std.print("=== 1 MB regex ===");
huge = "";
for(i = 0; i < 20000; i++)
	huge += "<p>some text here number " + i + "</p>";
std.print("huge size=", huge.size());
t2 = std.millis();
try {
	o2 = huge.regex_replace("<[^>]+>", " ");
	std.print("ok ms=", std.millis() - t2, " out=", o2.size());
}
catch(e) {
	std.print("threw after ", std.millis() - t2, "ms: ", e);
}
