// probe11: jina reader + search endpoints.

import curl;

c = curl.curl();

UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36";

show(label, url, headers = ["User-Agent" = UA], timeout = 25000)
{
	std.print("=== ", label, " ===");
	r = c.get(url, headers, timeout);
	b = std.string(r.body);
	std.print("ok=", r.geti("ok"), " code=", r.geti("http_code"), " ct=", r.geti("content_type"), " size=", b.size());
	if(!r.geti("ok")) std.print("ERR: ", r);
	std.print("head: ", b.substr(0, 700).replace("\n", " | "));
	std.print("");
}

show("r.jina.ai example", "https://r.jina.ai/https://example.com");
show("r.jina.ai ddg docs", "https://r.jina.ai/https://en.wikipedia.org/wiki/DuckDuckGo");
show("s.jina.ai search", "https://s.jina.ai/shizoscript programming language");
show("r.jina.ai with x-respond-with", "https://r.jina.ai/https://example.com", ["User-Agent" = UA, "x-respond-with" = "markdown"]);
show("r.jina.ai with no-markdown", "https://r.jina.ai/https://example.com", ["User-Agent" = UA, "x-respond-with" = "text"]);
show("r.jina.ai with selector", "https://r.jina.ai/https://example.com", ["User-Agent" = UA, "x-target-selector" = "body"]);
show("r.jina.ai with timeout hdr", "https://r.jina.ai/https://example.com", ["User-Agent" = UA, "x-timeout" = "10"]);
show("r.jina.ai bad url", "https://r.jina.ai/https://no-such-host.invalid/x");
show("r.jina.ai 404", "https://r.jina.ai/https://example.com/nope-404");
show("s.jina.ai with num results", "https://s.jina.ai/shizoscript?num=5");
show("r.jina.ai with auth none", "https://r.jina.ai/https://example.com", ["Authorization" = ""]);
show("r.jina.ai github", "https://r.jina.ai/https://github.com/shizotech/shizoscript3");

std.print("=== timing r.jina.ai ===");
t = std.millis();
r = c.get("https://r.jina.ai/https://en.wikipedia.org/wiki/Shizoscript", ["User-Agent" = UA], 30000);
std.print("ms=", std.millis() - t, " code=", r.geti("http_code"), " size=", std.string(r.body).size());
