// ═════════════════════════════════════════════════════════════════════════════
//  web_ui_selftest.shio — the web interface of a node keeps answering
//
//  Usage:  shz web_ui_selftest.shio      (from system/miniagent, no LLM)
//
//  web_ui_start() on a stub host whose request turn takes 2 s, then what a
//  browser does: the pages and their files, the polling of every page, a request
//  turn with its /poll loop, many requests in a row and at the same time, a
//  keep-alive connection that is reused (curl with several URLs). After every step the server must still answer
//  quickly (shizotech/shizoscript3 PR #9: "after the first request the webserver
//  hangs").
//  Then the parts of issue #1015: the live feed (GET /api/live answers at once
//  when the page is behind and holds the answer while nothing changes), the node
//  list, the gateway settings, and the API of ANOTHER node through this one: a
//  second stub node on ShizoNet with a route table, asked through
//  /api/nodes/<id>/api/... (JSON and the session stream), no HTTP between them.
//  Exits with code 0 when every check passes.
// ═════════════════════════════════════════════════════════════════════════════

#include "web_ui"

import curl;

TEST_PORT = 13347;
ROOT = __DIR__ + "/.selftest_web_ui";

passed = 0;
failed = 0;

check(name, cond, info = "") {
	if(cond) {
		passed++;
		std.print("  PASS  ", name);
	}
	else {
		failed++;
		std.print("  FAIL  ", name, "  -> ", info);
	}
}

// the Megamind surface web_ui / node_api / the board use; a turn takes 2 s
class StubHost {
	running = true;
	_receptionist_active = false;
	request_queue = [];
	worker_threads = [];
	receptionist = None;
	tasks = [];
	tasks_scheduled = [];
	tasks_finished = [];
	tasks_failed = [];
	listeners = [];
	turns = 0;
	peers = None;		// NodePeers: the other nodes (set below)
	gateway = None;
	name = "StubNode";
	description = "the node of the self-test";

	on_notify(cb) {}
	on_task_finished(cb) {}
	add_task_finished_listener(cb) { listeners.push_back(cb); }

	request(prompt, on_finish_cb = None, on_action_cb = None) {
		turns++;
		_receptionist_active = true;
		if(on_action_cb) {
			on_action_cb([text = "thinking about " + prompt]);
			on_action_cb([tool = [name = "start_task", args = [name = "Job"]]]);
			on_action_cb([tool_start = [id = "1", name = "start_task", args = [name = "Job"]]]);
		}
		std.sleep(2000);
		if(on_action_cb)
			on_action_cb([text = " done"]);
		_receptionist_active = false;
		return [ok = true, reports = [[report = "done"]]];
	}

	get_overview() {
		return [tasks = tasks, tasks_scheduled = tasks_scheduled, tasks_finished = tasks_finished, tasks_failed = tasks_failed];
	}

	add_task(name, goal, role = "adaptive") {
		id = std.random_hash(16);
		tasks_scheduled.push_back([name = name, task = goal, taskid = id, state = "planned", role = role]);
		return id;
	}

	stop_task(taskid) { return false; }
	update_task(taskid, message) { return false; }
	inspect_task(taskid) {
		return [
			ok = false,
			taskid = taskid,
			name = "",
			state = "lost",
			active = json.bool(false),
			report = "",
			error = "not found",
			token_usage = 0,
			last_update_ms = 0,
		];
	}
}

base = "http://127.0.0.1:" + std.string(TEST_PORT);

http(method, path, body = "", timeout_ms = 5000) {
	managed c = curl.curl();
	t0 = std.millis();
	res = c.request(method, base + path, std.string(body), ["Content-Type" = "application/json"], timeout_ms);
	res.ms = std.millis() - t0;
	return res;
}

// the server answers a fresh request within a second
alive(tag) {
	r = http("GET", "/api/health", "", 3000);
	check("still answers: " + tag, r.http_code == 200 && r.ms < 1000, std.string(r.http_code) + " in " + std.string(r.ms) + " ms");
}

if(fileio.exists(ROOT)) {
	for(f : fileio.files(ROOT, true))
		try { fileio.remove(ROOT + "/" + f); } catch(e) {}
}

host = StubHost();
cfg = [url = "http://127.0.0.1:9", name = "stub-model", token = "", max_tokens = 8000, max_running_agents = 0];
// the workspaces of the test live in its own folder, not in the user's storage
registry = WorkspaceRegistry("", "", ROOT + "/workspaces", ROOT + "/projects");
ui = web_ui_start(host, cfg, [port = TEST_PORT, api_token = ""], registry);

if(!ui) {
	std.print("FAIL: the web interface did not start");
	std.exitprocess(1);
}
check(!std.is_none(ui.runtime) && !std.is_none(ui.runtime.store) && !std.is_none(ui.runtime.manager), "web_ui_start returns the workspace runtime");
std.sleep(300);

std.print("\n── the pages and their files ──");
for(p : ["/", "/dashboard.js", "/dashboard.css", "/components/nodeapi.js", "/components/minimd.js", "/components/icons.css", "/components/theme.css",
	"/architecture/index.html", "/architecture/graph.js", "/architecture/style.css"]) {
	r = http("GET", p);
	check("GET " + p, r.http_code == 200 && std.string(r.body).length() > 50, std.string(r.http_code));
}
r = http("GET", "/chat/index.html");
check("old chat page is denied", (r.http_code == 403 || r.http_code == 404) && r.ms < 1000, std.string(r.http_code));
r = http("GET", "/tasks/index.html");
check("old tasks page is denied", (r.http_code == 403 || r.http_code == 404) && r.ms < 1000, std.string(r.http_code));
r = http("GET", "/favicon.ico");
check("a missing file is answered (403 / 404), not a hang", (r.http_code == 404 || r.http_code == 403) && r.ms < 1000, std.string(r.http_code));
alive("after the pages");

std.print("\n── the polling of every page, 30 times in a row ──");
bad = 0;
slow = 0;
for(i = 0; i < 30; i++) {
	for(p : ["/api/status", "/api/notifications", "/api/tasks", "/api/events", "/api/health"]) {
		r = http("GET", p);
		if(r.http_code != 200)
			bad++;
		if(r.ms > 1000)
			slow++;
	}
}
check("150 polls answered", bad == 0 && slow == 0, std.string(bad) + " failed, " + std.string(slow) + " slow");
alive("after the polling");

std.print("\n── a request turn (2 s) while the pages poll ──");
r = http("POST", "/api/request", [prompt = "hello"]);
rid = std.string(std.json(std.string(r.body), true).data.request_id ?? "");
check("the request turn starts", r.http_code == 200 && rid, std.string(r.body));
text = "";
tools = 0;
state = "";
during = [n = 0, slow = 0];
t0 = std.millis();
for(std.millis() - t0 < 6000) {
	p = http("POST", "/api/request/poll", [request_id = rid]);
	j = std.json(std.string(p.body), true).data;
	state = std.string(j.status);
	if(j.has("delta")) {
		if(j.delta.has("text"))
			text += std.string(j.delta.text);
		if(j.delta.has("tool_start"))
			tools++;
	}
	q = http("GET", "/api/status");
	during.n++;
	if(q.http_code != 200 || q.ms > 1000)
		during.slow++;
	if(state == "done")
		break;
	std.sleep(50);
}
check("the turn ends with done", state == "done", state);
check("the answer arrived", text.contains("thinking about hello") && text.contains("done"), text);
check("the tool call arrived once", tools == 1, std.string(tools));
check("the other pages were answered during the turn", during.n > 5 && during.slow == 0, std.string(during));
alive("after the request turn");

std.print("\n── a second and third turn ──");
for(k = 0; k < 2; k++) {
	r = http("POST", "/api/request", [prompt = "again " + std.string(k)]);
	rid = std.string(std.json(std.string(r.body), true).data.request_id ?? "");
	state = "";
	t0 = std.millis();
	for(std.millis() - t0 < 6000 && state != "done") {
		state = std.string(std.json(std.string(http("POST", "/api/request/poll", [request_id = rid]).body), true).data.status);
		std.sleep(100);
	}
	check("turn " + std.string(k + 2) + " ends", state == "done", state);
}
check("three turns ran", host.turns == 3, std.string(host.turns));
alive("after three turns");

std.print("\n── 20 requests at the same time ──");
res = [ok = 0, n = 0];
for(i = 0; i < 20; i++) {
	std.thread([res, i]() {
		r = http("GET", i % 2 ? "/api/status" : "/api/tasks");
		if(r.http_code == 200)
			res.ok++;
		res.n++;
	}).run();
}
t0 = std.millis();
for(res.n < 20 && std.millis() - t0 < 10000)
	std.sleep(20);
check("20 parallel requests answered", res.ok == 20, std.string(res));
alive("after the parallel requests");

std.print("\n── keep-alive ──");
// curl reuses one connection for several URLs (what a browser does)
// (static files answer "Connection: close", the API keeps the connection)
urls = ["/api/health", "/api/status", "/api/status", "/api/tasks", "/api/health"];
cmd = "curl -s -H \"Connection: keep-alive\" -w \"%{http_code} %{num_connects};\"";
for(u : urls)
	cmd += " -o " + (std.os_platform() == "windows" ? "NUL" : "/dev/null") + " " + base + u;
out = "";
try {
	out = std.string(std.system(cmd, true));
}
catch(e) {
	out = "";
}
if(out.contains("200")) {
	// num_connects is 0 for a request that reused the connection
	check("five requests on one keep-alive connection", out.split("200").size() == 6 && out.split(" 0;").size() == 5, out);
}
else {
	std.print("  (no curl command line: keep-alive check skipped) ", out);
}
alive("with keep-alive connections open");

std.print("\n── the live feed (GET /api/live) ──");
r = http("GET", "/api/live?since=0&wait=5000");
live = std.json(std.string(r.body), true).data;
check("a page that is behind is answered at once", r.http_code == 200 && r.ms < 1500 && std.int(live.rev) > 0, std.string(r.ms) + " ms " + std.string(r.body).substr(0, 200));
check("the live answer carries what the sidebar shows", live.has("sessions") && live.has("stats") && live.has("settings") && live.has("tree_rev"), std.string(live));
rev = std.int(live.rev);
r = http("GET", "/api/live?since=" + std.string(rev) + "&wait=1200");
check("nothing changed: the answer is held for the wait", r.http_code == 200 && r.ms >= 1000 && r.ms < 3000 && std.int(std.json(std.string(r.body), true).data.rev) == rev, std.string(r.ms) + " ms");
// a change while a page waits ends the wait
res_live = [ms = -1, rev = 0];
std.thread([res_live, rev]() {
	q = http("GET", "/api/live?since=" + std.string(rev) + "&wait=8000", "", 12000);
	res_live.rev = std.int(std.json(std.string(q.body), true).data.rev);
	res_live.ms = q.ms;
}).run();
std.sleep(400);
r = http("PUT", "/api/settings", [max_sessions = 7]);
check("settings saved", r.http_code == 200, std.string(r.body));
t0 = std.millis();
for(res_live.ms < 0 && std.millis() - t0 < 9000)
	std.sleep(20);
check("a change ends the wait early", res_live.ms >= 0 && res_live.ms < 4000 && res_live.rev > rev, std.string(res_live));
r = http("POST", "/api/workspaces", [name = "Live Probe"]);
made = std.json(std.string(r.body), true).data;
check("a workspace without a path goes below the projects folder", r.http_code == 200 && std.string(made.path) == fileio.absolute_path(ROOT + "/projects/live_probe"), std.string(r.body));
r = http("GET", "/api/live?since=" + std.string(res_live.rev) + "&wait=3000");
live2 = std.json(std.string(r.body), true).data;
check("a new workspace moves tree_rev", std.int(live2.tree_rev) > std.int(live.tree_rev) && r.ms < 2500, std.string(live2.tree_rev) + " after " + std.string(live.tree_rev));

// the tasks of all workspaces in one answer (the "All tasks" view)
r = http("GET", "/api/tasks/overview");
ov = std.json(std.string(r.body), true);
ov_probe = None;
if(ov.ok) {
	for(w : ov.data.workspaces) {
		if(std.string(w.id) == std.string(made.id))
			ov_probe = w;
	}
}
check("GET /api/tasks/overview lists every workspace with its goals and sessions", r.http_code == 200 && ov.ok && !std.is_none(ov_probe) && ov_probe.name == "Live Probe" && ov_probe.has("goals") && ov_probe.has("sessions"), std.string(r.body).substr(0, 300));
alive("after the live feed");

std.print("\n── the node list, the gateway settings ──");
r = http("GET", "/api/nodes");
nodes = std.json(std.string(r.body), true).data.nodes;
check("the node itself is listed", r.http_code == 200 && nodes.size() == 1 && nodes[0].id == "local" && nodes[0].name == "StubNode", std.string(r.body));
r = http("GET", "/api/nodes/nobody/api/workspaces");
check("no ShizoNet: a call for another node is refused with a reason", r.http_code == 503 && std.string(r.body).contains("ShizoNet"), std.string(r.http_code) + " " + std.string(r.body));
r = http("GET", "/api/gateway");
gw = std.json(std.string(r.body), true).data;
check("the gateway settings are served without the token", r.http_code == 200 && gw.has("settings") && !gw.settings.has("bot_token") && gw.settings.has("token_set"), std.string(r.body));

std.print("\n── another node through this one (ShizoNet, no HTTP) ──");
// node B: a stub host with a route table, on ShizoNet as an AI node
class RemoteHost {
	running = true;
	name = "RemoteBox";
	api_table = None;
	api_token = "";
	polls = 0;

	get_overview() { return [tasks = [], tasks_scheduled = [], tasks_finished = [], tasks_failed = []]; }
	add_notify_listener(cb) {}
	add_file_listener(cb) {}
	add_task_finished_listener(cb) {}
	workspaces_summary(limit = 64) { return [[id = "w1", name = "Remote Project", description = "", path = "/remote/w1", parent = ""]]; }
}

remote = RemoteHost();
table = ApiRouter();
table.route("GET", "^/api/workspaces$", [](req, writer) {
	return node_api_ok([where = "remote", since = node_api_get(req.query_params, "since", "none"), token = node_api_get(req.query_params, "token", "none")]);
});
table.route("POST", "^/api/workspaces$", [](req, writer) {
	b = node_api_body(req);
	return node_api_ok([created = node_api_get(b, "name")]);
});
table.route("DELETE", "^/api/workspaces/([0-9a-zA-Z_-]+)$", [](req, writer) {
	return node_api_err("workspace has children: " + std.string(req.matches[0]), 409);
});
// a session with three events, the last one ends it
table.route("GET", "^/api/sessions/([0-9a-zA-Z_-]+)/events$", [remote](req, writer) {
	remote.polls++;
	since = node_api_int(req.query_params, "since", 0);
	if(std.string(req.matches[0]) != "s1")
		return node_api_err("unknown session", 404);
	all = [
		[seq = 1, type = "user", text = "hi"],
		[seq = 2, type = "delta", action = [text = "hello from far away"]],
		[seq = 3, type = "done", ok = json.bool(true), status = "finished", report = "all good"],
	];
	out = [];
	for(e : all) {
		// one event per poll: the stream has to ask again
		if(e.seq > since && !out.size())
			out.push_back(e);
	}
	last = out.size() ? out[0].seq : since;
	return node_api_ok([session_id = "s1", status = last >= 3 ? "done" : "running", seq = last, terminal = json.bool(last >= 3), events = out]);
});
remote.api_table = table;

net_a = shizonet.server("StubNode");
net_b = shizonet.server("RemoteBox");
svc_b = ai_node_attach(net_b, remote, [name = "RemoteBox", description = "far away", model = "big"]);
host.peers = NodePeers(net_a, "StubNode");

found = "";
t0 = std.millis();
for(std.millis() - t0 < 15000 && !found) {
	for(p : host.peers.list()) {
		if(p.name == "RemoteBox" && p.online && p.api)
			found = std.string(p.id);
	}
	std.sleep(100);
}
check("the other node is found on ShizoNet", found, std.string(host.peers.list()));

r = http("GET", "/api/nodes");
nodes = std.json(std.string(r.body), true).data.nodes;
// (another node of some other test on this machine may be in the list as well)
remote_rec = None;
for(n : nodes) {
	if(n.name == "RemoteBox")
		remote_rec = n;
}
check("the node list has this node first and the other node", nodes.size() >= 2 && nodes[0].id == "local" && !std.is_none(remote_rec) && remote_rec.kind == "node" && remote_rec.model == "big" && remote_rec.workspaces == 1, std.string(r.body));

r = http("GET", "/api/nodes/" + found + "/api/workspaces?since=7&token=secret");
j = std.json(std.string(r.body), true);
check("GET reaches the other node's API", r.http_code == 200 && j.ok && j.data.where == "remote" && j.data.since == "7", std.string(r.body));
check("the token of this node is not passed on", j.data.token == "none", std.string(r.body));
r = http("POST", "/api/nodes/" + found + "/api/workspaces", [name = "Far Project"]);
j = std.json(std.string(r.body), true);
check("POST with a body reaches it", r.http_code == 200 && j.data.created == "Far Project", std.string(r.body));
r = http("DELETE", "/api/nodes/" + found + "/api/workspaces/w9");
j = std.json(std.string(r.body), true);
check("an error of the other node comes back with its status and text", r.http_code == 409 && !j.ok && std.string(j.error).contains("w9"), std.string(r.http_code) + " " + std.string(r.body));
r = http("GET", "/api/nodes/" + found + "/api/nothing/here");
check("an unknown route of the other node is a 404", r.http_code == 404, std.string(r.http_code) + " " + std.string(r.body));
r = http("GET", "/api/nodes/who-0000/api/workspaces");
check("an unknown node is a 404 with a reason", r.http_code == 404 && std.string(r.body).contains("unknown node"), std.string(r.http_code) + " " + std.string(r.body));

// the session stream of the other node as server sent events
r = http("GET", "/api/nodes/" + found + "/api/sessions/s1/stream?since=0", "", 20000);
sse = std.string(r.body);
check("the stream of a remote session arrives as events", r.http_code == 200 && sse.contains("event: user") && sse.contains("hello from far away") && sse.contains("event: done") && sse.contains("all good"), sse);
check("the stream asked the node once per event", remote.polls == 3, std.string(remote.polls));
check("the stream ends with the session", r.ms < 10000, std.string(r.ms));
r = http("GET", "/api/nodes/" + found + "/api/sessions/gone/stream?since=0", "", 20000);
check("a session that does not exist ends the stream with an error event", std.string(r.body).contains("event: error"), std.string(r.body));
alive("after the remote calls");

host.peers.stop();
svc_b.stop();

ui.server.stop();
registry.stop();
if(fileio.exists(ROOT)) {
	for(f : fileio.files(ROOT, true))
		try { fileio.remove(ROOT + "/" + f); } catch(e) {}
	try { fileio.remove(ROOT); } catch(e) {}
}

std.print("\n", passed, " passed, ", failed, " failed\n");
std.exitprocess(failed ? 1 : 0);
