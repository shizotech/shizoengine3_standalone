// ═══════════════════════════════════════════════════════════════════════════
//  workspace_env.shio — workspace-local environment variables
//
//  Every workspace session agent reads <workspace>/.env/vars when it exists and
//  exports every KEY=VALUE line with std.set_env before the first turn starts.
//  The command tools of SHARED.shio run as child processes of the session agent,
//  so they inherit these variables.
//
//  Format:
//      ENV_VAR=Something
//      ENV_VAR2=SomethingElse
//
//  Blank lines and lines starting with '#' are ignored. The name is the text
//  before the first '='; name and value are trimmed. The file is read once per
//  session start; changing it does not affect a running session.
// ═══════════════════════════════════════════════════════════════════════════

WORKSPACE_ENV_FILE = ".env/vars";

workspace_env_path(dir) {
    var base = std.string(dir ?? "").strip();

    if(!base)
        base = std.wd();

    return base + "/" + WORKSPACE_ENV_FILE;
}

// Loads <workspace>/.env/vars into the process environment.
// Returns [ok, path, found, loaded, names, skipped, error].
workspace_env_load(dir) {
    var path = workspace_env_path(dir);

    if(!fileio.exists(path))
        return [ok = true, path = path, found = false, loaded = 0, names = [], skipped = []];

    var text = fileio.read_text(path);

    if(!std.is_string(text))
        return [ok = false, path = path, found = true, loaded = 0, names = [], skipped = [], error = "Cannot read " + path];

    var lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n");
    var names = [];
    var skipped = [];
    var loaded = 0;

    for(var i = 0; i < lines.size(); i++) {
        var line = lines[i].strip();

        if(!line || line.starts("#"))
            continue;

        var eq = line.find("=");

        if(eq <= 0) {
            skipped.push_back([line = line, error = "missing NAME=VALUE"]);
            continue;
        }

        var name = line.substr(0, eq).strip();
        var value = line.substr(eq + 1, line.size() - eq - 1).strip();

        if(!name) {
            skipped.push_back([line = line, error = "empty variable name"]);
            continue;
        }

        try {
            std.set_env(name, value);
            loaded++;
            names.push_back(name);
        } catch(e) {
            skipped.push_back([line = line, error = std.string(e)]);
        }
    }

    return [ok = true, path = path, found = true, loaded = loaded, names = names, skipped = skipped];
}
