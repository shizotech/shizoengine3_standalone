
#include "codeeditor"

std.print(std.argc());

open_files = [];

if(std.argc() > 1) {
	for(i = 1; i < std.argc(); i++) {
		open_files.push_back(std.argv(i));
	}
}

if(open_files) {
	try {
		std.cd(fileio.file_dir(open_files[0]));
	}
	catch(e) {
		
	}
}
else {
	//Default user/documents
	try {
		std.cd(std.home());
	}
	catch(e) {
		
	}
}

//Load all available modules to get their docs... (possible minor security problem for third party packages)

local_dir = fileio.file_dir(std.local_executable());

pkgs = fileio.dirs(local_dir + "/shizotech/packages", 0);

for(i = 0; i < pkgs.size(); i++)
{
	std.print("Importing: ", pkgs[i]);
	std.import(pkgs[i]);
}

shzdocs.load_all_modules();

ctx = nanogui.context();
screen = ctx.screen("Shizoscript Editor");
editor_container = screen.widget().anchor(0);
editor_container.size(screen.screen_size());
edit = codeeditor(editor_container);

if(open_files) {
	edit.open(open_files[0]);
}

edit.filebrowser.on_directory_change([this](path) {
	std.print("changing to: ", path);
	std.cd(path);
});
		

std.sleep(-1);