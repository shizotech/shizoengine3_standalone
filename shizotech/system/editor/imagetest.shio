
#include "miniagent/miniagent"

agt = miniagent("http://shizo:8000");

last_state = "";

agt.on_action = [](action) {
	if(action.text) {
		if(*last_state != "text")
			*last_state = "text";
			std.cout("\n");
		stdfcol("white");
		std.cout(action.text);
	}
	else if(action.reasoning) {
		
		if(*last_state != "reasoning")
			*last_state = "reasoning";
			std.cout("\n");
		
		stdfcol("magenta");
		std.cout(action.text);
	}
};

//win32.screenshot("screenshot.bmp", false, true);

base64_img = std.base64_encode(fileio.read_file("screenshot.bmp"));

prompt = [
	[
		"type" = "image_url",
		"image_url" = [
			"url" = "data:image/bmp;base64," + base64_img,
		]
	],
	[
		"type" = "text",
		"text" = "Put the mouse on the tab 'app.shs' in notepad++"
	]
];

agt.add_tool(
	"click_at",
	"Sets mouse cursor to the given position and executes a click event",
	[
		x = "&int(): X-Position",
		y = "&int(): Y-Position",
	],
	[](agt, args)
	{
		//args.x = (args.x / 1000.0) * 2048.0;
		//args.y = (args.y / 1000.0) * 1152.0;
		
		std.print(args);
		
		win32.set_cursor_pos(args.x, args.y);
		
		return [
			ok = true;
		];
	}
);

agt.task(prompt);

std.input();