
#include "mcp/mcp_server"

import tempfile;


server_port = 13338;
server = mcpserver("Shizoscript DOCS", server_port);


local_dir = fileio.file_dir(std.local_executable());

pkgs = fileio.dirs(local_dir + "/shizotech/packages", 0);

for(i = 0; i < pkgs.size(); i++)
{
	std.import(pkgs[i]);
}

shzdocs.load_all_modules();

server.tools.add_tool(
	"shizoscript_help",
	"This is the first tool you should call.\nReturns an overview how shizoscript and its syntax work.",
	None,
	[](svr, args)
	{		
		return fileio.read_string(fileio.find_file("miniagent/skills/shizoscript/SKILL.MD"));
	}
);

server.tools.add_tool(
	"shizoscript_docs",
	"Resolve docs for a namespaces, function, classes, objects or variable path (exact).",
	[
		path = "&string(): A namespace like 'std' or a dotted path like 'math.sin' or 'math.sin()' or an object type like 'nanogui.widget'",
		compact = "&int(0,1): Show compact output only, without descriptions or parameters (to save context on unspecific lookups)"
	],
	[](svr, args)
	{		
		res = shzdocs.get_namespace(args.path);
		
		if(res.found) {
			std.print(res);
			if(res.has("documentation"))
				res.erase("documentation");
			if(args.compact)
				res.remove_all_keys("description");
				res.remove_all_keys("params");
			return res;
		}
		
		res = shzdocs.get_class(args.path);
		
		if(res.found) {
			//std.print(res);
			if(res.has("documentation"))
				res.erase("documentation");
			if(args.compact)
				res.remove_all_keys("description");
				res.remove_all_keys("params");
			return res;
		}
		
		res = shzdocs.get_path(args.path);
		
		if(res.found) {
			//std.print(res);
			if(res.has("documentation"))
				res.erase("documentation");
			if(res.has("owner_members"))
				res.erase("owner_members");
			if(args.compact)
				res.remove_all_keys("description");
				res.remove_all_keys("params");
			return res;
		}
	
		return [
			found = false,
			status = "The requested path does not exist.",
		];
	}
);

server.tools.add_tool(
	"shizoscript_search_keywords",
	"Find namespaces|functions|variables|types and docs by keywords.",
	[
		keywords = "&string(): A comma separated list of keywords to seach for",
		require_all = "&int(0,1): Requires all keywords to be present in a type's description to be listed"
	],
	[](svr, args)
	{		
		res = shzdocs.search_keywords(args.keywords, args.require_all);
		
		res.erase("query");
		
		for(res.results && res.results.size() > 20) {
			res.results.erase(res.results.size()-1);
			res.truncated_results = true;
		}
		
		return res;
	}
);


server.tools.add_tool(
	"shizoscript_resolve_include",
	"Input a file with include directives, outputs the complete file with all include directives replaced with their respective include files.",
	[
		path = "&string(): Path of the file"
	],
	[](svr, args)
	{		
		return std.resolve_source_file(args.path);
	}
);

server.tools.add_tool(
	"shizoscript_syntax_checker",
	"Check the syntax of a script file, without running it",
	[
		path = "&string(): Path of the script file to check",
	],
	[](svr, args)
	{
		managed tmp = tempfile.tempfile();
		
		std.system("shz --check " + args.path + " > " + tmp.path());
		
		return tmp.read();
	}
);

server.tools.add_tool(
	"shizoscript_debugger",
	"Debug a script file by running it",
	[
		path = "&string(): Path of the script file to check",
		run_duration = "&int(1,60): Duration that the script should run for this test",
	],
	[](svr, args)
	{
		captured_out = "";
		
		managed tmp = tempfile.tempfile();
		
		std.system("shz --testrun " + args.run_duration + " " + args.path + " > " + tmp.path());
	
		return tmp.read();
	}
);

server.tools.add_tool(
	"shizoscript_system_paths",
	"Returns the paths for standard include files, system modules and project directories.",
	None,
	[](svr, args)
	{
		return [
			[
				system_path = std.path(),
				description = "Root path of the shizoscript installation.\nThis path includes the standard include files '.../includes', the default system modules like 'shz docs' in '.../system', and native importable packages in '.../packages'.", 
			],
			[
				user_path = std.user_path(),
				description = "This path points to user-specific app and script configurations, custom installed apps and user projects.", 
			],
		];
	}
);

// Keep server running
std.sleep(-1);