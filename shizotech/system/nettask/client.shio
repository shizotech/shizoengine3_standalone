// ============================================================
// nettask_client.shio — CLI client for nettask daemon
// Connects via shizonet and provides interactive control.
// ============================================================

DAEMON_PORT = 9100;

std.print("=== nettask client ===");
std.print("Connecting to nettask daemon on port", DAEMON_PORT, "...");

net = shizonet.server("nettask-client", DAEMON_PORT);

// Wait for daemon to appear
std.print("Waiting for daemon...");
connected = false;

net.on_connect([](device)
{
    if(device.name == "nettask-daemon")
    {
        std.print("Connected to daemon:", device.name, "(", device.ip, ")");
        connected = true;
    }
});

// Wait until connected
for(!connected)
{
    std.sleep(500);
}

// --- Helper: send GET to daemon and return result ---
daemon_get(command, data = None)
{
    if(data == None)
        return net.get(command);
    else
        return net.get(command, data);
}

// --- Print help ---
print_help()
{
    std.print("");
    std.print("Available commands:");
    std.print("  list              — Show all managed apps and their status");
    std.print("  status <name>     — Show status of a specific app");
    std.print("  start <name>      — Start an app");
    std.print("  stop <name>       — Stop an app");
    std.print("  restart <name>    — Restart an app");
    std.print("  ping              — Health check the daemon");
    std.print("  help              — Show this help");
    std.print("  exit              — Quit the client");
    std.print("");
}

// --- Print app list table ---
print_app_list(apps_data)
{
    if(apps_data.size() == 0)
    {
        std.print("  (no apps managed)");
        return;
    }

    std.print("  #   DIR                   PATH               STATUS");
    std.print("  --- --------------------- ------------------ --------");

    for(i = 0; i < apps_data.size(); i++)
    {
        app = apps_data[i];
        status_str = "STOPPED";
        if(app.running)
            status_str = "RUNNING";

        std.print(" ", i, "  ", app.dir, "  ", app.path, "  ", status_str);
    }
}

// --- Print a result message ---
print_result(result)
{
    if(result.message != None)
        std.print(" =>", result.message);
    else(result.error != None)
        std.print(" => ERROR:", result.error);
    else
        std.print(result);
}

// --- Main interactive loop ---
print_help();

for(1)
{
    line = std.input("nettask> ");

    if(line.empty())
        continue;

    // Split command and argument
    parts = line.split(" ");
    cmd = parts[0];
    arg = "";
    if(parts.size() > 1)
        arg = parts[1];

    if(cmd == "exit" || cmd == "quit")
    {
        std.print("Goodbye.");
        break;
    }
    else(cmd == "help")
    {
        print_help();
    }
    else(cmd == "ping")
    {
        result = daemon_get("ping");
        std.print(" => Daemon says:", result);
    }
    else(cmd == "list" || cmd == "ls")
    {
        result = daemon_get("list");
        print_app_list(result);
    }
    else(cmd == "status")
    {
        if(arg.empty())
        {
            std.print(" => Usage: status <app_name>");
            continue;
        }
        result = daemon_get("status", arg);
        print_result(result);
    }
    else(cmd == "start")
    {
        if(arg.empty())
        {
            std.print(" => Usage: start <app_name>");
            continue;
        }
        result = daemon_get("start", arg);
        print_result(result);
    }
    else(cmd == "stop")
    {
        if(arg.empty())
        {
            std.print(" => Usage: stop <app_name>");
            continue;
        }
        result = daemon_get("stop", arg);
        print_result(result);
    }
    else(cmd == "restart")
    {
        if(arg.empty())
        {
            std.print(" => Usage: restart <app_name>");
            continue;
        }
        result = daemon_get("restart", arg);
        print_result(result);
    }
    else
    {
        std.print(" => Unknown command:", cmd, " — type 'help' for options.");
    }
}