
#include "openai"

using std;

last_state = "";

output_format = R"(
Output the result(s) in the following JSON format:
```json
[
  {"bbox_2d": [x1, y1, x2, y2], "label": "type_of_component", "sub_label": "Reference_designator"},
  ...
]
```
)";


transform_bbox(img, bbox) {
		x1 = bbox[0] / 1000.0 * img.width();
		x2 = bbox[2] / 1000.0 * img.width();
		y1 = bbox[1] / 1000.0 * img.height();
		y2 = bbox[3] / 1000.0 * img.height();
		return [x1,y1,x2,y2];
	}

for(1) {
	api = openai_api("http://shizo:8000");

	api.on_reason = [](txt)
	{
		if(last_state != "reason")
			last_state = "reason";
			std.cout("\n\nReasoning:\n");
		std.cout(txt);
	};
	api.on_text = [](txt)
	{
		if(last_state != "text")
			last_state = "text";
			std.cout("\n\nText:\n");
		std.cout(txt);
	};

	ts = toolset();

	ts.add_tool("mouse_click", "Call this for testing", 
		[
			coordinates = "&array(2,2): Coordinates for this action"
		],
		[](args)
		{
			bmp = fileio.exists("variant2.png") ? bitmap.load("variant2.png") : bitmap.load("variant.png");
			
			bbox = transform_bbox(bmp, [args.coordinates[0], args.coordinates[1], 0, 0]);
			std.print(bbox);	
			bmp.draw_circle(bbox[0], bbox[1], 20, bitmap.rgb(255, 0, 0));
			
			bmp.save("variant2.png");
			return "Tool was called successfully.";
		}
	);

	api.add_image("variant.png");
	res = api.task("Locate the color select icon in paint.\n" + output_format, ts);

	std.input();

	bbox = std.json(res.extract("```json","```"));

	std.print("TEST: ", bbox);

	mid_x = (bbox[0].bbox_2d[0] + bbox[0].bbox_2d[2]) / 2.0;
	mid_y = (bbox[0].bbox_2d[1] + bbox[0].bbox_2d[3]) / 2.0;

	bmp = fileio.exists("variant2.png") ? bitmap.load("variant2.png") : bitmap.load("variant.png");
	bmp.draw_circle(mid_x/1000.0 * bmp.width(), (mid_y) / 1000.0 * bmp.height(),20,bitmap.rgb(255, 0, 0));
	
	transformed = transform_bbox(bmp, bbox[0].bbox_2d);
	bmp.draw_rectangle(transformed[0],transformed[1],transformed[2],transformed[3],bitmap.rgb(255, 0, 0));
	
	bmp.save("variant2.png");

}

std.input();