for(1) {
	length_per_step = 100;
			
	max_repeat = repetition_check == 0 ? 1000 : 50; 
std.print(max_repeat);
	std.print(repetition_check, " : ",loop_detect(
			loop_test, 
			100, 
			10000, max_repeat));

	repetition_check++;
		
	std.input();
}
		
