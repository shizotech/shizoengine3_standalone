
#include "openai"

class generic_agent
{
	managed context = None;
	
	api_base_url 	= "";
	tools 			= toolset();
	interfaces 		= None; //Use like interfaces["memory"] etc to add other functionalities
	
	//Callbacks
	on_analysis = None;
	on_reason = None;
	on_text = None;
	on_tool = None;
	
	__init__(
		api_url = "http://localhost:8000",
		model_name = None, 
		system_prompt = None,
		auth_token = "none",
	)
	{
		api_base_url = api_url;
		
		context = openai_api(api_url, model_name, system_prompt, auth_token);
		
		context.on_reason = [this](txt)
		{
			if(std.is_function(on_analysis))
				return on_analysis(txt);
			if(std.is_function(on_reason))
				return on_reason(txt);
		};
		context.on_text = [this](txt)
		{
			if(std.is_function(on_text))
				return on_text(txt);
		};
		context.on_tool = [this](toolname, toolargs)
		{
			if(std.is_function(on_tool))
				return on_tool(toolname, toolargs);
		};
	}
	
	add_image_url(img_url) { return context.add_image_url(img_url); }
	add_image_raw(raw_image_data, img_type = "png") { return context.add_image_raw(raw_image_data, img_type); }
	add_image(path) { return context.add_image(path); }
	
	text(prompt)
	{
		return context.ask(prompt);
	}
	
	task(prompt)
	{
		return context.task(prompt, tools);
	}
	
	get_json(prompt, schema) 
	{
		return context.get_json(prompt, schema);
	}
	
	set_pre_answer(pre_answer)
	{
		this.context.pre_answer = pre_answer;
	}
	
	set_temperature(temp)
	{
		context.set_temperature(temp);
	}
	
	add_tool(
		name,
		description,
		params, 
		callback,
	)
	{	
		tools.add_tool(
			name,
			description,
			params,
			[this, callback](args) {
				return callback(this, args);
			}
		);
		
		//Update context in case we're running a task which loads new tools dynamically...
		context.set_tools(tools);
	}

	stop() {
		context.stop();
	}
}
