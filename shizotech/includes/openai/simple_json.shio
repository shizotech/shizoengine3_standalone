simple_json(json)
{
	if(!std.is_json(json))
		return [];
	
	json_schema = [type = "object"];

	for(i = 0; i < json.size(); i++)
	{
		json_key = json.key(i);
		
		if(std.is_string(json[i]))
		{
			json_prop = &json_schema.properties[json_key];
			
			json_value = json[i];
			
			if(json_value[0] == "&")
				json_schema.required.push(json_key);
				json_value = json_value.substr(1);
			
			comment_split = json_value.split(":", 2, true);
			
			paramdef_str = comment_split[0];
			desc_str = comment_split.size() == 2 ? comment_split[1] : "";
			
			param_defs = paramdef_str.extract("(",")").split(",", -1, true);
			
			if(!param_defs[0])
				param_defs.clear();
			
			if(desc_str)
				json_prop.description = desc_str.strip();
			
			if(paramdef_str.starts("string"))
			{
				json_prop.type = "string";
				if(param_defs.size() >= 1)
					json_prop.minLength = std.int(param_defs[0]);
				if(param_defs.size() >= 2)
					json_prop.maxLength = std.int(param_defs[1]);
			}
			else(paramdef_str.starts("int"))
			{
				json_prop.type = "integer";
				if(param_defs.size() >= 1)
					json_prop.minimum = std.int(param_defs[0]);
				if(param_defs.size() >= 2)
					json_prop.maximum = std.int(param_defs[1]);
			}
			else(paramdef_str.starts("float"))
			{
				json_prop.type = "float";
				if(param_defs.size() >= 1)
					json_prop.minimum = std.float(param_defs[0]);
				if(param_defs.size() >= 2)
					json_prop.maximum = std.float(param_defs[1]);
			}
			else(paramdef_str.starts("array"))
			{
				json_prop.type = "array";
				if(param_defs.size() >= 1)
					json_prop.items.type = param_defs[0];
				if(param_defs.size() >= 2)
					json_prop.minItems = std.int(param_defs[1]);
				if(param_defs.size() >= 3)
					json_prop.maxItems = std.int(param_defs[2]);
			}
			else(paramdef_str.starts("uarray"))
			{
				json_prop.type = "array";
				//json_prop.uniqueItems = 1; //Not supported by xgrammar
				if(param_defs.size() >= 1)
					json_prop.items.type = param_defs[0];
				if(param_defs.size() >= 2)
					json_prop.minItems = std.int(param_defs[1]);
				if(param_defs.size() >= 3)
					json_prop.maxItems = std.int(param_defs[2]);
			}
			else(paramdef_str.starts("enum"))
			{
				json_prop.type = "string";
				json_prop.enum = param_defs; //Dont need to copy since this is a new variable
			}
			else
				std.error("Unknown: " + paramdef_str);
		}
		else(std.is_list(json[i]))
		{
			json_schema.required.push(json_key);
			json_schema.properties[json_key].type = "string";
			json_schema.properties[json_key].enum = json[i].copy(); //Need to copy
		}
		else(std.is_json(json[i]))
		{
			json_schema.required.push(json_key);
			json_schema.properties[json_key] = simple_json(json[i]);
		}
	}
	
	return json_schema;
}
