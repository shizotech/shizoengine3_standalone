

repeat_detect(&str, repeat_len, stop_treshold = -1)
{
	if(str.length() <= repeat_len)
		return 0;
	if(repeat_len <= 0)
		return 0;

	repeat_str = str.substr(str.length() - repeat_len);
	
	repeat_count = 0;
	
	for(i = str.length() - repeat_len * 2; i >= 0; i -= repeat_len)
	{
		valid_seq = true;
		for(j = 0; j < repeat_len; j++) {
			if(str[i+j] != repeat_str[j])
				valid_seq = false;
				break;
		}
		
		if(stop_treshold > 0 && repeat_count >= stop_treshold) break;
		if(!valid_seq) break;
		
		repeat_count++;
	}
	
	return repeat_count;
}

loop_detect(&str, min_length=1, max_length=100, stop_treshold=-1)
{
	range_start = math.max(1, min_length);
	range_end = math.min(str.length(), max_length);
	max_repeat = 0;
	
	for(i = range_start; i < range_end; i++) {
		max_repeat = math.max(max_repeat, repeat_detect(str, i, stop_treshold));
		if(stop_treshold > 0 && max_repeat >= stop_treshold)
			break;
	}
	
	return std.int(max_repeat);
}
