
import curl;

//http://localhost:8020/v1/audio/transcriptions for example

class whisper_api
{
	api_url = "";
	
	__init__(api_url) {
		this.api_url = api_url;
	}
	
	transcribe_file(path) {
		stream_curl = curl.curl();	
		result = std.json(stream_curl.post_file(api_url, path, "file"));
		text = std.json(result.body).text;
		return text;
	}

	transcribe_data(filename, data) {
		stream_curl = curl.curl();	
		result = std.json(stream_curl.post_file_data(api_url, data, filename, "file"));
		text = std.json(result.body).text;
		return text;
	}
}