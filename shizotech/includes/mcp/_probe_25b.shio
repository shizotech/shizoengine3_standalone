// temporary probe v2: full HTTP handshake against the 25 server
#include "mcp_server_25"
import curl;

svr = mcpserver("Probe25HTTP", 39003);

svr.tools.add_tool("echo", "Echo a message", [message = "&string(): Message to echo"],
    [](s, args) { return "echo:" + std.string(args.geti("message")); });

std.sleep(400);

base = "http://localhost:39003";
shared = [get_body = "", get_code = 0];

t = std.thread([shared]() {
    c = curl.curl();
    r = c.get(base + "/", [], 6000);
    *shared.get_code = r.http_code;
    *shared.get_body = r.body;
});
t.run();

std.sleep(1000);

// find the session id the server registered for the SSE connection
sid = "";
for(i = 0; i < svr.clients.size(); i++) {
    sid = svr.clients.key(i);
}
std.print("session id found: ", sid != "" ? "yes" : "no");

c2 = curl.curl();
h = ["Content-Type" = "application/json", "Accept" = "application/json, text/event-stream"];

init_json = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\",\"clientInfo\":{\"name\":\"probe\",\"version\":\"1\"},\"capabilities\":{}}}";

r = c2.post(base + "/mcp?sessionid=" + sid, init_json, h, 4000);
std.print("--- POST /mcp?sessionid=... initialize ---");
std.print("code=", r.http_code, " ct=", r.content_type);
std.print("body=[", r.body, "]");

r2 = c2.post(base + "/mcp?sessionid=" + sid, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{}}", h, 4000);
std.print("--- POST tools/list ---");
std.print("code=", r2.http_code, " body=[", r2.body, "]");

r3 = c2.post(base + "/mcp?sessionid=" + sid, "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"message\":\"hi\"}}}", h, 4000);
std.print("--- POST tools/call ---");
std.print("code=", r3.http_code, " body=[", r3.body, "]");

t.join();
std.print("--- GET / (SSE stream content) ---");
std.print("code=", shared.get_code);
std.print("body=[");
std.print(shared.get_body);
std.print("]");

std.print("PROBE25HTTP DONE");
