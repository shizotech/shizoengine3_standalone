// ============================================================================
// mcp_types.shio — MCP Protocol constants, types, and JSON-RPC helpers
// ============================================================================

// MCP Protocol version
MCP_VERSION = "2026-07-28";

// JSON-RPC version
JSONRPC_VERSION = "2.0";

INIT_METHOD = "initialize";

SERVER_DISCOVER_METHOD = "server/discover";

TOOLS_LIST_METHOD = "tools/list";
TOOLS_CALL_METHOD = "tools/call";

RESOURCES_LIST_METHOD = "resources/list";
RESOURCES_READ_METHOD = "resources/read";

PROMPTS_LIST_METHOD = "prompts/list";
PROMPTS_GET_METHOD = "prompts/get";

PING_METHOD = "ping";

// JSON-RPC error codes
JSONRPC_PARSE_ERROR = -32700;
JSONRPC_INVALID_REQUEST = -32600;
JSONRPC_METHOD_NOT_FOUND = -32601;
JSONRPC_INVALID_PARAMS = -32602;
JSONRPC_INTERNAL_ERROR = -32603;
JSONRPC_TOOL_NOT_FOUND = -32001;
JSONRPC_TOOL_ERROR = -32002;
JSONRPC_RESOURCE_NOT_FOUND = -32003;
JSONRPC_PROMPT_NOT_FOUND = -32004;

// ============================================================================
// Helper: parse JSON string into json object
// ============================================================================
parse_json(str)
{
    return std.json(str);
}

// ============================================================================
// Helper: create a JSON-RPC 2.0 success response
// Parameters: id (any — request id), result (json object or string)
// ============================================================================
create_jsonrpc_response(id, result)
{
    resp = [jsonrpc=JSONRPC_VERSION, result=result];
    if (!std.is_none(id))
        resp.id = id;
    return resp;
}

create_jsonrpc_tool_response(id, result)
{
	resp = [jsonrpc=JSONRPC_VERSION, result = [content = [[type="text", text=std.string(result)]]]];

    if (!std.is_none(id))
        resp.id = id;
    return resp;
}

// ============================================================================
// Helper: create a JSON-RPC 2.0 error response
// Parameters: id (any), code (int), message (string), extra (json, optional)
// ============================================================================
create_jsonrpc_error(id, code, message, extra = None)
{
    err_obj = [code=code, message=message];
    if (extra)
        err_obj.data = extra;

    resp = [jsonrpc=JSONRPC_VERSION, error=err_obj];
    if (!std.is_none(id))
        resp.id = id;
    return resp;
}

// ============================================================================
// Helper: create a JSON-RPC notification (no id field)
// Parameters: method (string), params (json)
// ============================================================================
create_notification(method, params)
{
    notif = [jsonrpc=JSONRPC_VERSION, method=method];
    if (params)
        notif.params = params;
    return notif;
}

// ============================================================================
// Resource registry: holds MCP file-based resources (e.g. skill .md files)
// Modeled on the toolset class style from the openai standard include
// ============================================================================
class resource_registry
{
	resources = [];
	
	add_resource(
		uri,
		name,
		description,
		mimeType,
		file_path
	)
	{
		//Check if it already exists and if so, overwrite silently
		found_resource = false;
		for(i = 0; i < resources.size(); i++)
		{
			if(resources[i].uri == uri)
			{
				resources[i] = [
					uri = uri,
					name = name,
					description = description,
					mimeType = mimeType,
					path = file_path,
				];
				found_resource = true;
				break;
			}
		}
		
		if(!found_resource) {
			resources.push_back([
				uri = uri,
				name = name,
				description = description,
				mimeType = mimeType,
				path = file_path,
			]);
		}
	}
	
	find_resource(uri) {
		for(i = 0; i < resources.size(); i++)
		{
			if(resources[i].uri == uri) {
				return resources[i];
			}
		}
		
		return None;
	}
	
	add_static_resource(
		uri,
		name,
		description,
		mimeType,
		text
	)
	{
		//Check if it already exists and if so, overwrite silently
		found_resource = false;
		for(i = 0; i < resources.size(); i++)
		{
			if(resources[i].uri == uri)
			{
				resources[i] = [
					uri = uri,
					name = name,
					description = description,
					mimeType = mimeType,
					text = text,
					path = None,
					callback = None,
				];
				found_resource = true;
				break;
			}
		}
		
		if(!found_resource) {
			resources.push_back([
				uri = uri,
				name = name,
				description = description,
				mimeType = mimeType,
				text = text,
				path = None,
				callback = None,
			]);
		}
	}
	
	add_resource_callback(
		uri,
		name,
		description,
		mimeType,
		callback
	)
	{
		//Check if it already exists and if so, overwrite silently
		found_resource = false;
		for(i = 0; i < resources.size(); i++)
		{
			if(resources[i].uri == uri)
			{
				resources[i] = [
					uri = uri,
					name = name,
					description = description,
					mimeType = mimeType,
					text = None,
					path = None,
					callback = callback,
				];
				found_resource = true;
				break;
			}
		}
		
		if(!found_resource) {
			resources.push_back([
				uri = uri,
				name = name,
				description = description,
				mimeType = mimeType,
				text = None,
				path = None,
				callback = callback,
			]);
		}
	}
}

// ============================================================================
// Prompt registry: holds MCP prompt templates
// Mirrors the resource_registry / toolset pattern:
// prompts is the list of prompt entry jsons, prompt_callbacks maps name -> callback
// ============================================================================
class prompt_registry
{
	prompts = [];
	prompt_callbacks = None;

	__init__()
	{
		prompt_callbacks = [];
	}

	add_prompt(
		name,
		description,
		arguments,
		callback
	)
	{
		//Check if it already exists and if so, overwrite silently
		found_prompt = false;
		for(i = 0; i < prompts.size(); i++)
		{
			if(prompts[i].name == name)
			{
				prompts[i] = [
					name = name,
					description = description,
					arguments = arguments,
				];
				prompt_callbacks[name] = callback;
				found_prompt = true;
				break;
			}
		}

		if(!found_prompt) {
			prompts.push_back([
				name = name,
				description = description,
				arguments = arguments,
			]);
			prompt_callbacks[name] = callback;
		}
	}

	find_prompt(name) {
		for(i = 0; i < prompts.size(); i++)
		{
			if(prompts[i].name == name) {
				return prompts[i];
			}
		}

		return None;
	}
}
