// ============================================================================
// mcp_types.shio — MCP Protocol constants, types, and JSON-RPC helpers
// ============================================================================

// MCP Protocol version
MCP_VERSION = "2024-11-05";

// JSON-RPC version
JSONRPC_VERSION = "2.0";

// MCP method names
INIT_METHOD = "initialize";
TOOLS_LIST_METHOD = "tools/list";
TOOLS_CALL_METHOD = "tools/call";
PING_METHOD = "ping";

// JSON-RPC error codes
JSONRPC_PARSE_ERROR = -32700;
JSONRPC_INVALID_REQUEST = -32600;
JSONRPC_METHOD_NOT_FOUND = -32601;
JSONRPC_INVALID_PARAMS = -32602;
JSONRPC_INTERNAL_ERROR = -32603;
JSONRPC_TOOL_NOT_FOUND = -32001;
JSONRPC_TOOL_ERROR = -32002;

// ============================================================================
// Helper: parse JSON string into json object
// ============================================================================
parse_json(str)
{
    return std.json(str);
}

// ============================================================================
// Helper: create a JSON-RPC 2.0 success response
// Parameters: id (any — request id), result (json object or string)
// ============================================================================
create_jsonrpc_response(id, result)
{
    resp = [jsonrpc=JSONRPC_VERSION, result=result];
    if (id)
        resp.id = id;
    return resp;
}

create_jsonrpc_tool_response(id, result)
{
	resp = [jsonrpc=JSONRPC_VERSION, result = [content = [[type="text", text=std.string(result)]]]];

    if (id)
        resp.id = id;
    return resp;
}

// ============================================================================
// Helper: create a JSON-RPC 2.0 error response
// Parameters: id (any), code (int), message (string), extra (json, optional)
// ============================================================================
create_jsonrpc_error(id, code, message, extra = None)
{
    err_obj = [code=code, message=message];
    if (extra)
        err_obj.data = extra;

    resp = [jsonrpc=JSONRPC_VERSION, error=err_obj];
    if (id)
        resp.id = id;
    return resp;
}

// ============================================================================
// Helper: create a JSON-RPC notification (no id field)
// Parameters: method (string), params (json)
// ============================================================================
create_notification(method, params)
{
    notif = [jsonrpc=JSONRPC_VERSION, method=method];
    if (params)
        notif.params = params;
    return notif;
}
