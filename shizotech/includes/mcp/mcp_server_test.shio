
#include "mcp_server_25"

server_port = 3001;
server = mcpserver("Test", server_port);

server.tools.add_tool(
"test_tool",
"Execute a plan",
[
	manifest = "&string(): Plan manifest",
	state = "&string(): Initial state",
	taskboard = "&string(): Taskboard manifest",
	num = "&int(): number",
	//working_directory = "&string(): The working directory for the downstream agent.", 
],
[](svr, args)
{	
 	std.print(args);
 	
 	return "Ok worked!";
 });

 server.resources.add_resource(
 "file:///skills/shizoscript.md",
 "ShizoScript skill",
 "Skill instructions for working with ShizoScript",
 "text/markdown",
 "docs/shizoscript.md"
 );

 server.resources.add_resource(
  "file:///notes/welcome.txt",
  "Welcome",
  "Example plain text resource",
  "text/plain",
  "docs/welcome.txt"
  );
 
 server.prompts.add_prompt(
  "welcome",
  "Welcome a user by name",
  [
  	[name = "user", description = "Name of the user"],
  ],
  [](svr, args)
  {
  	return "Welcome, " + std.string(args.geti("user")) + "!";
  });

  server.set_instructions("Test MCP server exposing tools, resources and prompts.");

  // Keep server running
  std.sleep(-1);