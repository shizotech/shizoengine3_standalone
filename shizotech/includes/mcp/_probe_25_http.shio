// temporary probe: full HTTP handshake against the 25 server, as a real client would do
#include "mcp_server_25"
import curl;

svr = mcpserver("Probe25HTTP", 39002);

svr.tools.add_tool("echo", "Echo a message", [message = "&string(): Message to echo"],
    [](s, args) { return "echo:" + std.string(args.geti("message")); });

std.sleep(400);

base = "http://localhost:39002";
shared = [get_body = "", get_code = 0];

// open the SSE stream the way an MCP client would
t = std.thread([shared]() {
    c = curl.curl();
    r = c.get(base + "/", [], 4000);
    *shared.get_code = r.http_code;
    *shared.get_body = r.body;
});
t.run();

std.sleep(1200);

// POST without a session id (what a plain streamable-http client does)
c2 = curl.curl();
h = ["Content-Type" = "application/json", "Accept" = "application/json, text/event-stream"];

r = c2.post(base + "/mcp", "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\",\"clientInfo\":[name=\"probe\",version=\"1\"],\"capabilities\":[]}}", h, 4000);
std.print("--- POST /mcp without session ---");
std.print("code=", r.http_code, " ct=", r.content_type);
std.print("body=[", r.body, "]");

// wait for the GET thread to finish so we can see what the SSE stream carried
t.join();
std.print("--- GET / (SSE) ---");
std.print("code=", shared.get_code);
std.print("body=[", shared.get_body, "]");

std.print("PROBE25HTTP DONE");
