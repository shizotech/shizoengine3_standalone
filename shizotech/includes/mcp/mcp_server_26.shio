server.add_prompt(
	"implement_feature",

	"Implement a ShizoScript feature using the standard development workflow.",

	[
		[
			name = "goal",
			description = "The feature that should be implemented.",
			required = true
		]
	],

	[](svr, args)
	{
		goal = args.goaltostring();


		return "
You are implementing a feature in ShizoScript.

Follow the ShizoScript development workflow.

Before implementation:

- Inspect the existing code.
- Read relevant documentation.
- Read relevant skill resources.
- Reuse existing APIs where possible.

After implementation:

- Verify the change.
- Check for compilation/runtime errors.
- Do not leave the task in an ambiguous state.

Feature to implement:

" + goal;
	}
);


