// ============================================================================
// mcp_selftest.shio — Self-test entry for the Streamable HTTP MCP server
// Starts a server on a test port, then uses curl to exercise every endpoint.
// ============================================================================

#include "mcp_server_25"

import curl;

// Start the test server
server_port = 34567;
server = mcpserver("SelfTest", server_port);

// One tool: echo a message (callback returns the argument)
server.tools.add_tool(
"echo",
"Echo a message",
[
	message = "&string(): Message to echo",
],
[](svr, args)
{
	return std.string(args.geti("message"));
});

// One resource: plain text welcome file
server.resources.add_resource(
"file:///notes/welcome.txt",
"Welcome",
"Example plain text resource",
"text/plain",
"docs/welcome.txt"
);

// Server instructions shown in the initialize result
server.set_instructions("Test MCP server exposing tools, resources and prompts.");

// One prompt: greet the user by name
server.prompts.add_prompt(
"welcome",
"Greet the user by name",
[
	[name = "user", description = "Name of the user", required = true],
],
[](svr, args)
{
	return "Welcome, " + std.string(args.geti("user")) + "!";
});

// Give the server a moment to bind the port
std.sleep(500);

base_url = "http://localhost:" + std.string(server_port) + "/mcp";

// One curl client for all requests
c = curl.curl();

// Standard headers for MCP JSON-RPC requests
headers = [
	"Accept" = "application/json",
	"Content-Type" = "application/json",
];

// Send a POST JSON-RPC request and print the http_code + body
post_and_print(label, json_string)
{
	resp = c.post(base_url, json_string, headers, 5000);
	std.print(label);
	std.print(resp.http_code);
	std.print(resp.body);
}

// 1) initialize — expect 200 + protocolVersion 2025-03-26 + correct capabilities
post_and_print("[1] initialize",
	"{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-03-26\"}}");

// 2) notifications/initialized — expect 202, empty body
post_and_print("[2] notifications/initialized",
	"{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}");

// 3) tools/list — expect 200 + tools array with the tool
post_and_print("[3] tools/list",
	"{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{}}");

// 4) tools/call — expect 200 + content
post_and_print("[4] tools/call",
	"{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"message\":\"hi\"}}}");

// 5) prompts/list — expect 200 + prompts
post_and_print("[5] prompts/list",
	"{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"prompts/list\",\"params\":{}}");

// 6) prompts/get — expect 200 + messages wrapped
post_and_print("[6] prompts/get",
	"{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"prompts/get\",\"params\":{\"name\":\"welcome\",\"arguments\":{\"user\":\"Alice\"}}}");

// 7) resources/list — expect 200
post_and_print("[7] resources/list",
	"{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"resources/list\",\"params\":{}}");

// 8) resources/read — expect 200 + contents text
post_and_print("[8] resources/read",
	"{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"resources/read\",\"params\":{\"uri\":\"file:///notes/welcome.txt\"}}");

// 9) ping — expect 200 + empty result object {}
post_and_print("[9] ping",
	"{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"ping\",\"params\":{}}");

// 10) unknown method — expect 200 + error -32601 METHOD_NOT_FOUND
post_and_print("[10] unknown method",
	"{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"does/not/exist\",\"params\":{}}");

// 11) malformed body — expect 400 + -32700 PARSE_ERROR
post_and_print("[11] malformed body",
	"not json");

// Allow the last response to be flushed before exiting
std.sleep(500);

std.print("SELFTEST DONE");
