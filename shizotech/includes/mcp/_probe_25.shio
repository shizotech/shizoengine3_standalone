// temporary probe: exercise the 25 server handlers directly (no HTTP)
#include "mcp_server_25"

std.print("=== MCP_VERSION =", MCP_VERSION);

svr = mcpserver("Probe25", 39001);

svr.tools.add_tool("echo", "Echo a message", [message = "&string(): Message to echo"],
    [](s, args) { return "echo:" + std.string(args.geti("message")); });

// 1) initialize result shape
init = svr.handle_initialize([protocolVersion = "2025-11-25"]);
std.print("--- initialize ---");
std.print(init.compact_string());

// 2) tools/list shape
std.print("--- tools/list ---");
tl = svr.handle_tools_list([]);
std.print(tl.compact_string());

// 3) tools/call with the documented [](svr, args) callback signature
std.print("--- tools/call (svr,args) ---");
tc = svr.handle_tools_call([name = "echo", arguments = [message = "hi"]], 7);
std.print(tc.compact_string());

// 4) tools/call unknown tool
std.print("--- tools/call unknown ---");
tc2 = svr.handle_tools_call([name = "nope", arguments = []], 8);
std.print(tc2.compact_string());

// 5) ping result shape (spec says empty object)
std.print("--- ping ---");
pingres = [status = "ok"];
std.print(pingres.compact_string());

// 6) notification response shape (no id)
std.print("--- notification fallback ---");
std.print(create_notification("tools/list/result", tl).compact_string());

// 7) id = 0 truthiness check
std.print("--- id 0 handling ---");
std.print(create_jsonrpc_response(0, [a = 1]).compact_string());

std.print("PROBE25 DONE");
