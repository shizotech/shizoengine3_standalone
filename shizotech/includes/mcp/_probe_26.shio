// temporary probe: HTTP behaviour of the 26 (2026-07-28) server
#include "mcp_server_26"
import curl;

svr = mcpserver("Probe26", 39004);

svr.tools.add_tool("echo", "Echo a message", [message = "&string(): Message to echo"],
    [](args) { return "echo:" + std.string(args.geti("message")); });

std.sleep(400);

base = "http://localhost:39004/mcp";

post(label, body, headers) {
    c = curl.curl();
    r = c.post(base, body, headers, 4000);
    std.print("--- ", label, " ---");
    std.print("code=", r.http_code, " ct=", r.content_type);
    std.print("body=[", r.body, "]");
}

discover = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"server/discover\",\"params\":{}}";

// 1) exactly as the code documents the headers (mixed case)
post("server/discover, documented header casing", discover,
    ["Content-Type" = "application/json",
     "MCP-Protocol-Version" = "2026-07-28",
     "Mcp-Method" = "server/discover"]);

// 2) same request, lowercase header names (what the webserver actually stores)
post("server/discover, lowercase header names", discover,
    ["Content-Type" = "application/json",
     "mcp-protocol-version" = "2026-07-28",
     "mcp-method" = "server/discover"]);

// 3) no headers at all
post("server/discover, no mcp headers", discover, ["Content-Type" = "application/json"]);

// 4) tools/call with lowercase headers + Mcp-Name
post("tools/call lowercase",
    "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"echo\",\"arguments\":{\"message\":\"hi\"}}}",
    ["Content-Type" = "application/json",
     "mcp-protocol-version" = "2026-07-28",
     "mcp-method" = "tools/call",
     "mcp-name" = "echo"]);

// 5) what a normal MCP client sends today (2025-06-18 style)
post("initialize as a real client sends it",
    "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"clientInfo\":{\"name\":\"probe\",\"version\":\"1\"},\"capabilities\":{}}}",
    ["Content-Type" = "application/json",
     "MCP-Protocol-Version" = "2025-06-18"]);

std.print("PROBE26 DONE");
