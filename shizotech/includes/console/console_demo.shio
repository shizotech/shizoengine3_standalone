// A tour of console.shio. Run: shz console_demo.shio
// Flags: --plain (no colours), --ascii (no unicode frames)

#include "console/console"

if (std.argvflag("--plain"))
	console.colors(false);
if (std.argvflag("--ascii"))
	console.unicode(false);

console.title("ShizoScript console", "colours, boxes, tables, progress bars, spinners");
console.newline();

console.success("Connected to the device");
console.info("3 universes found");
console.warn("Universe 7 is not patched");
console.error("No answer from 10.0.0.12");
console.newline();

console.print(console.style("bold red on_white", "bold red on_white") + "  " + console.style("#ff8800", "#ff8800") + "  " +
	console.underline("underline") + "  " + console.rainbow("rainbow text") + "  " + console.gradient("gradient text"));
console.newline();

console.rule("Boxes");
console.box("A box with a title,\nround corners and padding.", [title = "Round", color = "cyan"]);
console.box("double frame, centered", [style = "double", color = "magenta", align = "center", width = 40]);
console.newline();

console.rule("Table");
console.table([
	[name = "Wash 1", universe = 1, channels = 16, state = console.green("online")],
	[name = "Spot left", universe = 1, channels = 24, state = console.green("online")],
	[name = "LED bar", universe = 2, channels = 192, state = console.red("offline")],
]);
console.newline();

console.rule("Key / value and tree");
console.kv([version = "3.0", platform = std.os_platform(), script = "console_demo.shio"]);
console.newline();
console.tree([inputs = [audio = "on", midi = ["APC40", "nanoKONTROL"]], outputs = [artnet = 3, spout = "off"]], "Project");
console.newline();

console.rule("Progress");
console.step(1, 2, "Copying files");
bar = console.progress("Files", 40);
for (i = 0; i <= 40; i++) {
	bar.update(i);
	std.sleep(15);
}
bar.done();

console.step(2, 2, "Waiting for the network");
sp = console.spinner("Connecting").start(); // animates while this task sleeps
std.sleep(1200);
sp.done("Connected");
