// Self-test of console.shio. Run: shz console_selftest.shio
// Passes when it prints "ALL PASSED" and exits with code 0.

// Globals of the script with the names of local variables of the library: it must not change them
out = "kept";
w = "kept";
c = "kept";

#include "console/console"

ok = true;
check(name, got, expected) {
	if (got != expected) {
		std.print("FAIL", name, "got", got, "expected", expected);
		ok = false;
	}
}

// every line of a block as wide as the first one
same_width(name, lines) {
	if (lines.size() == 0) {
		check(name + ": lines", 0, 1);
		return;
	}
	var w = console.visible_length(lines[0]);
	for (i, l : lines)
		check(name + ": line " + i + " width", console.visible_length(l), w);
}

// --- styles ------------------------------------------------------------------------------------------------------
check("style", console.style("x", "bold red"), "\x1b[1;31mx\x1b[0m");
check("style background", console.style("x", "on_blue"), "\x1b[44mx\x1b[0m");
check("style 24 bit", console.style("x", "#ff8800"), "\x1b[38;2;255;136;0mx\x1b[0m");
check("style short hex", console.style("x", "on_#f80"), "\x1b[48;2;255;136;0mx\x1b[0m");
check("unknown style words are ignored", console.style("x", "sparkly"), "x");
check("rgb", console.rgb("x", 1, 2, 300), "\x1b[38;2;1;2;255mx\x1b[0m");

// --- text helpers ------------------------------------------------------------------------------------------------
styled = console.bold(console.red("abc")) + "äö";
check("strip", console.strip(styled), "abcäö");
check("visible_length counts characters, not bytes or escapes", console.visible_length(styled), 5);
check("gradient keeps the text", console.strip(console.gradient("hello")), "hello");
check("rainbow keeps the text", console.strip(console.rainbow("a b c")), "a b c");
check("pad left", console.pad(console.red("ab"), 4), console.red("ab") + "  ");
check("pad right", console.pad("ab", 4, "right"), "  ab");
check("pad center", console.pad("ab", 5, "center"), " ab  ");
check("pad longer text", console.pad("abcdef", 3), "abcdef");
check("truncate", console.truncate("abcdef", 4), "abc…");
check("truncate short text", console.truncate("abc", 4), "abc");
check("repeat", console.repeat("ab", 3), "ababab");
check("duration s", console.duration(42), "42s");
check("duration m", console.duration(125), "2m 05s");
check("duration h", console.duration(3720), "1h 02m");
check("hex_color", std.string(console.hex_color("#0a0B0c")), std.string([10, 11, 12]));
check("hex_color invalid", console.hex_color("#zz0000"), None);

// --- blocks ------------------------------------------------------------------------------------------------------
box = console.box_lines("one\nlonger line", [title = "T"]);
check("box: lines", box.size(), 4);
same_width("box", box);
check("box: top", console.strip(box[0]), "╭─ T ─────────╮");
check("box: text", console.strip(box[1]), "│ one         │");
check("box: bottom", console.strip(box[3]), "╰─────────────╯");
same_width("box with a fixed width", console.box_lines("cut this text off", [width = 8, style = "double"]));
check("box: cut", console.strip(console.box_lines("cut this text off", [width = 8])[1]), "│ cut thi… │");

rows = [[name = "a", n = 5], [name = "bcd", n = 123]];
table = console.table_lines(rows);
check("table: lines", table.size(), 6);
same_width("table", table);
check("table: header", console.strip(table[1]), "│ name │   n │");
check("table: numbers right aligned", console.strip(table[3]), "│ a    │   5 │");
check("table: text left aligned", console.strip(table[4]), "│ bcd  │ 123 │");
check("table from lists without header", console.table_lines([[1, "x"], [22, "yy"]]).size(), 4);
same_width("table with a missing cell", console.table_lines([["a", "b"], ["c"]], [header = ["A", "B"]]));
check("empty table", console.table_lines([]).size(), 0);

kv = console.kv_lines([a = 1, long_key = "v"]);
check("kv", console.strip(kv[0]), "a         1");

tree = console.tree_lines([x = [y = 1, z = [2, 3]], w = "s"], "root");
check("tree: lines", tree.size(), 7);
check("tree: root", console.strip(tree[0]), "root");
check("tree: branch", console.strip(tree[1]), "├── x");
check("tree: leaf", console.strip(tree[2]), "│   ├── y: 1");
check("tree: list entry", console.strip(tree[5]), "│       └── 3");
check("tree: last", console.strip(tree[6]), "└── w: s");

// --- without colours, ASCII ------------------------------------------------------------------------------------
console.colors(false);
check("colors(false): style is plain", console.style("x", "bold red"), "x");
check("colors(false): gradient is plain", console.gradient("xy"), "xy");
check("colors(false): no escapes in a table", console.table_lines(rows)[1].contains("\x1b"), 0);
check("colors(false): erase_line", console.erase_line(), "");
console.unicode(false);
check("unicode(false): ASCII frame", console.box_lines("a")[0], "+---+");
check("unicode(false): symbols", console.symbol("success"), "+");
check("unicode(false): truncate", console.truncate("abcdef", 4), "abc.");
check("settings read back", console.colors() + console.unicode(), 0);
console.width(40);
check("width", console.width(), 40);
console.colors(true).unicode(true).width(80);

// --- progress bar ------------------------------------------------------------------------------------------------
console.colors(false);
bar = console.progress("Load", 10, [width = 10]);
bar.update(5);
check("progress: half", bar.line().starts("Load █████░░░░░  50%"), 1);
bar.update(99);
check("progress: clamped", bar.value, 10);
bar.done();
check("progress: done", bar.finished, 1);
sp = console.spinner("Wait");
sp.tick().tick();
check("spinner: frame", sp.frame, 2);
sp.done("Fine");
check("spinner: done", sp.finished, 1);
console.colors(true);

check("globals of the script are not changed", out + w + c, "keptkeptkept");

if (ok)
	std.print("ALL PASSED");
else
	std.runtime_error("console_selftest: failures above");
