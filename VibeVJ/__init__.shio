
#include "src/defs"
#include "src/displays"
#include "engine/migrate/migrate"
#include "engine/interfaces/aiinterface"
#include "engine/patch/dmx"
#include "engine/patch/patch_ai"
#include "engine/patch/desk_runtime"
#include "engine/interfaces/ai_capture"
#include "engine/blackout"
#include "src/menu/menu"

import nanogui;
using eigen;

//todo: asset browser trigger in top bar mit ":::" (open close "sidebar")

//std.input();

class shizoengine
{
	ctx = None;
	screen = None;
	menu = None;
	style = [];
	project = [];
	env = [];
	timeline = [];
	filebrowser = None;

	generators = [];
	generators_pre_callbacks = [];
	generators_post_callbacks = [];
	
	net = None;
	artnet_callbacks = [];
	
	//Devices > Fixtures: holds the controls of every lamp (they write its DMX channels)
	fixture_menu = None;
	
	//The patch: lamps, groups, nodes added by hand (engine/patch/patch.shio). Pure data, saved as fixture_setup.json.
	//Managed: a lamp that is deleted is gone for every holder of its JSON
	managed patch = patch_new();
	//Goes up with every change of the patch: the fixture menu, the Phaser and the LEDMapper rebuild what they took from it
	patch_revision = 0;
	//A change of the patch from another thread (an AI query): patch_changed() runs at the end of the frame
	patch_change_pending = false;
	//What else sends DMX (the LEDMappers), to find channels written twice (engine/patch/dmx.shio)
	dmx_users = [];
	dmx_revision = 0;
	//The fixture setup for AI agents: queries on the patch, live_path "fixture_setup" (engine/patch/patch_ai.shio)
	managed patch_ai = None;
	//The lighting desk (#719, engine/patch/desk_runtime.shio): programmer, palettes, cue stacks; desk.json
	managed desk = None;
	//Pictures for AI agents: the screen, a generator, a camera after a lamp test (engine/interfaces/ai_capture.shio)
	managed ai_capture = None;
	
	load_hooks = [];
	save_hooks = [];
	
	//Store these as global engine vars for convenience
	project_width = None;
	project_height = None;
	project_size_source = None; //Settings > Project > Output size: 0 from the output displays, 1 by hand (#593)

	//The connected displays, their role (Control / Output) and resolution (src/displays.shio, Settings > Display)
	displays = None;
	
	//Specifically for the ai agent (global states)
	ai_last_interface = None; //Contains the last focused item which implements an assistant interface
	ai_interfaces = []; //Every live AIInterface (id -> interface), see engine/interfaces/aiinterface.shio
	ai_interfaces_revision = 0; //Changes when an interface or its queries change (the MCP server rebuilds its tools)
	ai_activity = []; //Last write of an AI caller (Chat / MCP): caller, query, target, time
	main_generator_view = None; //Direct link to the main view

	managed blackout = None; //the switch that takes all outputs to black (#538, engine/blackout.shio)

	//Autosave (AUTOSAVE_DIR): minutes between two autosaves, 0 is off (Settings > Project, kept in the style file)
	autosave_minutes = AUTOSAVE_DEFAULT;
	autosave_last = 0;      //std.millis() of the last save, autosave or load
	autosave_ready = false; //only after the start up asked about an old autosave: before, it must not be overwritten

	__init__() {
		autosave_last = std.millis();
	
		engine_global = std.global("engine");
		engine_global.set(this);

		//In engine.ai_interfaces from the start: the Chat and the MCP server can change the fixture setup
		patch_ai = patch_ai_create(this);
		desk = desk_runtime(this);
		ai_capture = AICapture(this);
	
		//The network cards Art-Net and ShizoNet use (#501): picked in Devices > Network > Network cards, kept in the
		//style file (personal). Before the server starts, so its first ArtPoll already goes to the right cards
		try {
			net_style = fileio.read_json(STYLE_FILE);
			if(net_style && net_style.has("network_interfaces"))
				shizonet.use_interfaces(net_style.network_interfaces);
		}
		catch(e) {}

		net = shizonet.server("SHIZOV3");
	
		ctx = nanogui.context();
		screen = ctx.screen("ShizoEngineX - VVJ");
		style = fileio.read_json(STYLE_FILE);
		//The window as it was left (place, size, maximized or full screen; save_window_state). Without one the defaults
		saved_window = style.has("window") ? style.window : None;
		saved_state = saved_window && saved_window.has("state") ? saved_window.state : "";
		//macOS: the title bar of macOS lies under the top bar, with the traffic lights at its left end (the top bar
		//places them again with its own height). The window starts zoomed, as Mac programs do, not in a full screen Space
		mac_frame = screen.native_frame(48);
		if(mac_frame)
			screen.window_title("VibeVJ"); //the Window menu, Mission Control and the Dock name it
		if(!mac_frame) {
			screen.decorated(0);
			//No OS frame, so the outer 5 px of the screen resize the window instead (not while maximized)
			screen.resize_border(5);
		}
		//Where it was, also on another monitor; a monitor that is gone gives the primary one (place_window)
		if(saved_window && saved_window.has("w"))
			screen.place_window(vec2f(saved_window.x, saved_window.y), vec2f(saved_window.w, saved_window.h));
		if(saved_state == "normal") {
			//Its own size: out of the full screen Windows gives a borderless window by itself
			if(screen.fill_monitor())
				screen.fill_monitor(false);
			if(saved_window.has("w"))
				screen.place_window(vec2f(saved_window.x, saved_window.y), vec2f(saved_window.w, saved_window.h));
		}
		else if(saved_state == "maximized")
			screen.maximized(true);
		//The full screen: what VibeVJ starts in on Windows and Linux, over the taskbar or panel. On Windows the screen
		//gets there by itself once the frame is gone, unless place_window above took it out again (a rect kept from an
		//earlier start); on Linux the window manager is asked for it, where it has a full screen. On a Mac only when it
		//was left there (its own Space)
		else if(saved_state == "full" || (!mac_frame && saved_state == "")) {
			if(screen.fill_monitor_available() && !screen.fill_monitor())
				screen.fill_monitor(true);
		}
		else if(mac_frame)
			screen.maximized(true);

		//ctx.widget_debug(true);

		screen.theme().from_json(style);
		//Interface size (Appearance): on top of the system scale, before anything is laid out. Until it is chosen (or
		//when it is "auto"), the size that suits the screen (auto_ui_scale: a 4K screen at 100 % gets more than 100 %)
		screen.ui_scale(has_ui_scale(style) ? style.ui_scale : auto_ui_scale());
		//Where the window is now decides which display is the one of the operator (Control)
		displays = displays_manager(this);
		//Smaller than this the bars and the sidebar no longer fit; on a smaller screen the window fills it
		screen.min_size(vec2f(960, 600));
		//Calm notches (Shizo UI): "everywhere" (default) or "clipview", set in Appearance
		nanogui.calm_notches(style.has("calm_notches") ? style.calm_notches : "everywhere");
		//Linked notches (Shizo UI): "open" (default) or "edge", set in Appearance
		nanogui.linked_notches(style.has("linked_notches") ? style.linked_notches : "open");
		//Area headers (#347): "always" (default) or "auto_hide", set in Appearance
		env.area_headers_auto_hide = (style.has("area_headers") && style.area_headers == "auto_hide") ? 1 : 0;
		//Move areas with (#347): "alt" (default), "ctrl+alt" or "none", set in Appearance
		nanogui.grab_modifier(style.has("grab_modifier") ? style.grab_modifier : "alt");
		//Autosave: minutes, set in Settings > Project
		if(style.has("autosave_minutes"))
			autosave_minutes = std.int(style.autosave_minutes);

		blackout = blackout_switch(this);
		menu = main_menu(this);
		//The settings exist now: a new project without a saved size takes the one of the output displays (#593)
		displays.apply_project_size();
		
		//update style file
		style.merge(screen.theme().to_json());
		fileio.write_json(STYLE_FILE, style);
		
		net.on_artnet([this](uni, data) {
			
			if(load_in_progress)
				return;

			//Art-Net learn and the Art-Net mappings of the controls (Devices > Network > Art-Net)
			nanogui.artnet_input(uni, data);
			
			for(i = 0; i < this.artnet_callbacks.size(); i++) {
				if(!this.artnet_callbacks[i].generator || !this.artnet_callbacks[i].callback)
					this.artnet_callbacks.erase(i);
					i--;
					continue;
				this.artnet_callbacks[i].callback(uni, data);
			}
		});
		
		screen.pre_render_callback([this, screen, ctx](){

			//The fade of the blackout goes on while a project loads
			if(this.blackout)
				this.blackout.tick();
		
			if(load_in_progress)
				return;
		
			//Do this here for better frame-timing consistency
			this.net.artnet_sync_now();
		
			pos_delta = 0.0;
			if(this.timeline.play_btn.value())
				cur_pos = this.timeline.cursor_pos.value();
				cur_pos += (this.timeline.bpm_ctrl.value() * this.timeline.nudge_factor) / (60.0 * ctx.real_fps());
				pos_delta = cur_pos - this.timeline.cursor_pos.value();
				this.timeline.nudge_factor = 1.0; //Reset
				this.timeline.cursor_pos.value(cur_pos);
			
			//The loops turn with the main timeline and tell nanogui where they are (#273): before the sync, so
			//controls that follow a loop get its position of this frame
			if(this.timeline.loops)
				this.timeline.loops.update(pos_delta);

			//Sync all midicontrols to timeline which are sync enabled
			nanogui.sync_update(this.timeline.cursor_pos.value(), pos_delta);
			
			//The performance overlay (#537) measures each generator while it is on
			perf = this.env.perf;
			measure = perf && perf.on;
			for(i = 0; i < this.generators_pre_callbacks.size(); i++) {
				if(!this.generators_pre_callbacks[i] || !this.generators_pre_callbacks[i].module || !this.generators_pre_callbacks[i]._pre_callback)
					this.generators_pre_callbacks.erase(i);
					i--;
					continue;
					
				try {
					t0 = measure ? nanogui.micros() : 0;
					this.generators_pre_callbacks[i]._pre_callback(this.generators_pre_callbacks[i], this.timeline.cursor_pos.value(), pos_delta);
					if(measure)
						perf.add(this.generators_pre_callbacks[i], nanogui.micros() - t0);
				}
				catch(e) {
					this.generators_pre_callbacks.erase(i);
					i--;	
				}
			}
			
		});
		
		screen.should_close([this](){
			//Closing the window behaves exactly like Exit: an unnamed project is asked about first (#314)
			if(this.confirm_quit())
				std.exitprocess(0);
			
			//The engine logs an error when this callback returns falsy, and a cancelled quit is no error
			return true;
		});
		
		ctx.on_frame_finished([this](){

			//Errors and warnings to the toasts and the Log (#539), also while a project loads
			if(this.menu && this.menu.log)
				this.menu.log.poll();
			
			//Synthetic input of a test over MCP (debug_input in configs/mcp_server.json, #552): one event per frame
			if(this.env.debug_input)
				this.env.debug_input.tick();

			//A project load / save of the MCP server (vibevj_load_project, vibevj_save_project, #634)
			if(this.env.mcp_render_step)
				vibevj_mcp_project_tick(this);
			
			if(load_in_progress)
				return;
			
			//An AI agent changed the patch (its queries run on other threads): the fixture menu and the rest follow here
			if(this.patch_change_pending) {
				this.patch_change_pending = false;
				this.patch_changed();
			}

			//The Projects tab of the sidebar rebuilds its lists here (#479). clear_children() deletes the widgets
			//immediately, so that must never run inside a widget event callback (#315).
			if(this.env.recent_dirty) {
				this.env.recent_dirty = false;
				if(this.env.refresh_recent)
					this.env.refresh_recent();
			}

			this.autosave_tick();

			//Displays plugged in or out: the roles, the project size and Settings > Display follow (#593)
			if(this.displays)
				this.displays.tick();

			//The shader preview of the Assets tab opens once the mouse rested on a shader (#536)
			if(this.env.shader_preview)
				this.env.shader_preview.tick();

			perf = this.env.perf;
			measure = perf && perf.on;
			if(measure)
				perf.frame();
			for(i = 0; i < this.generators_post_callbacks.size(); i++) {
				if(!this.generators_post_callbacks[i] || !this.generators_post_callbacks[i].module || !this.generators_post_callbacks[i]._post_callback)
					this.generators_post_callbacks.erase(i);
					i--;
					continue;
					
				try {
					t0 = measure ? nanogui.micros() : 0;
					this.generators_post_callbacks[i]._post_callback(this.generators_post_callbacks[i]);
					if(measure)
						perf.add(this.generators_post_callbacks[i], nanogui.micros() - t0);
				}
				catch(e) {
					this.generators_post_callbacks.erase(i);
					i--;	
				}
			}

			//The lighting desk sends its cue stacks and the programmer after the generators (the Phaser): on top of them
			//in the same frame (fx_contribute)
			if(this.desk)
				this.desk.tick();
		});
			
		//An autosave that is still there: VibeVJ did not close properly last time. Restore it, or the last project
		if(!restore_autosave() && fileio.exists("engine/last_project.dat"))
			load_project(fileio.read_string("engine/last_project.dat"));
		autosave_last = std.millis();
		autosave_ready = true;
	}
	
	__deinit__() {
		shutdown();
	}

	save_project(name = None) {
		
		project_env = std.global("project");
		
		//The label belongs to the if: without a name argument the project keeps its name (#314)
		if(name) {
			project_env.name = name;
			project_env.label.text(name);
		}
		
		if(!project_env.name)
			return;
		
		if(save_in_progress || load_in_progress)
			return;
		
		screen.status_overlay("Saving...");
		save_in_progress = true;

		fileio.write_string("engine/last_project.dat", project_env.name);

		//#386: a project folder of an older format keeps its files once before they are written in the current one
		project_dir = "projects/" + project_env.name;
		old_format = project_format(project_dir);
		if(old_format < PROJECT_FORMAT && fileio.exists(project_dir + "/generators.json"))
			backup_project_files(project_dir, old_format);

		write_project(project_dir);

		/*
		fileio.write_json("projects/" + project_env.name + "/ui_settings.json", [
			filebrowser_scale = this.scale_widget.scale(),
		]);
		*/

		//The project on disk is up to date: the autosave is not needed any more
		autosave_remove();
		autosave_last = std.millis();

		screen.status_overlay("");
		save_in_progress = false;
	}

	//Writes every file of the open project into dir: the patch, one file per save hook, the controls and the format.
	//Save writes into projects/<name>, the autosave into AUTOSAVE_DIR
	write_project(dir) {
		if(patch)
			fileio.write_json(dir + "/fixture_setup.json", patch);

		for(i = 0; i < save_hooks.size(); i++) {
			hook_name = save_hooks.key(i);
			try {
				hook_data = save_hooks[i]();
				fileio.write_json(dir + "/" + hook_name + ".json", hook_data);
			}
			catch(e) {
				std.error("Cannot run save hook: " + save_hooks.key(i) + ": " + e);
			}
		}

		fileio.write_json(dir + "/controls.json", nanogui.serialize_controls());
		write_project_format(dir);
	}

	// Autosave
	//The open project, named or not, goes to AUTOSAVE_DIR every autosave_minutes. It is written into a folder of its
	//own first and takes the place of the old autosave only when it is complete: a crash while writing keeps the old
	//one. autosave.json in it names the project ("" for a project without a name) and the time

	//Called at the end of every frame
	autosave_tick() {
		if(!autosave_ready || autosave_minutes <= 0 || save_in_progress || load_in_progress)
			return;
		//Not in show mode: the show is built, it is only played, and a save there could make a frame late. The time
		//starts again, so the first autosave comes a full interval after leaving show mode
		if(nanogui.show_mode()) {
			autosave_last = std.millis();
			return;
		}
		if(std.millis() - autosave_last < autosave_minutes * 60000)
			return;
		autosave_now();
	}

	autosave_now() {
		autosave_last = std.millis();
		if(save_in_progress || load_in_progress)
			return false;
		save_in_progress = true;
		ok = false;
		next = AUTOSAVE_DIR + "_next";
		try {
			started = std.millis();
			fileio.remove(next);
			write_project(next);
			fileio.write_json(next + "/autosave.json", [name = std.global("project").name ?? "", time = std.date("%Y-%m-%d %H:%M")]);
			fileio.remove(AUTOSAVE_DIR);
			ok = fileio.rename(next, AUTOSAVE_DIR) ? true : false;
			env.last_autosave_ms = std.millis() - started;
			std.print("Autosave took ", env.last_autosave_ms, " ms");
		}
		catch(e) {
			std.warn("Autosave failed: " + e);
		}
		save_in_progress = false;
		return ok;
	}

	autosave_remove() {
		try {
			fileio.remove(AUTOSAVE_DIR);
			fileio.remove(AUTOSAVE_DIR + "_next");
		}
		catch(e) {}
	}

	//Start up: an autosave that is still there is offered. true when it was loaded
	restore_autosave() {
		info_file = AUTOSAVE_DIR + "/autosave.json";
		if(!fileio.exists(info_file))
			return false;
		info = [];
		try {
			info = fileio.read_json(info_file);
		}
		catch(e) {}
		name = info.name ?? "";
		what = name ? "of the project " + name : "of a project without a name";
		question = "VibeVJ did not close properly. Restore the autosave " + what + (info.time ? " from " + info.time : "") + "?\n" +
			"No deletes it" + (name ? " and opens the project as it was last saved." : ".");
		res = "no";
		try {
			res = screen.modal_yes_no(question, "Restore autosave");
		}
		catch(e) {}
		if(res != "yes") {
			autosave_remove();
			return false;
		}
		//It stays until the next save: VibeVJ can stop again before that
		return load_project(name, "projects", AUTOSAVE_DIR);
	}
	
	//The interface size that suits the monitor the window of VibeVJ is on, until one is chosen in Settings > Appearance.
	//Only a screen as dense as 4K gets more: at least 2000 rows at 100 % of the system (a 4K screen without system
	//scaling, mostly on Linux). It gets the largest size of the list that still leaves 1920 x 1080 (turned round for an
	//upright one). The rows decide, not the width: an ultrawide (3440 x 1440, 5120 x 1440) is wide, not dense, and got
	//150 % or 200 % when the width decided (#593)
	auto_ui_scale() {
		try {
			//No monitor reported (a display that sleeps): the size of the system
			count = ctx.monitor_count();
			if(count < 1)
				return 1.0;
			index = 0;
			try {
				index = screen.monitor_index();
			}
			catch(e) {}
			if(index < 0 || index >= count)
				index = 0;
			info = ctx.monitor_info(index);
			scale = info.has("scale") && info.scale > 0 ? info.scale : 1.0;
			//Logical units at 100 %: points on a Mac, pixels divided by the system scale elsewhere
			mac = std.os_platform() == "macos";
			w = mac ? info.width : info.pixel_width / scale;
			h = mac ? info.height : info.pixel_height / scale;
			long_side = math.max(w, h);
			short_side = math.min(w, h);
			if(short_side < 2000)
				return 1.0;
			sizes = [2.0, 1.5, 1.25];
			for(s : sizes) {
				if(long_side / s >= 1920 && short_side / s >= 1080)
					return s;
			}
		}
		catch(e) {}
		return 1.0;
	}

	//A size chosen in Settings > Appearance (a number); "auto" or none: auto_ui_scale()
	has_ui_scale(style) {
		return style.has("ui_scale") && std.type(style.ui_scale) != "string" && style.ui_scale > 0;
	}

	//Keeps where the window is, for the next start (__init__): its state, and the place and size it has when it is
	//neither maximized nor in the full screen
	save_window_state() {
		try {
			st = fileio.read_json(STYLE_FILE);
			state = screen.fill_monitor() ? "full" : (screen.maximized() ? "maximized" : "normal");
			w = st.has("window") ? st.window : [state = state];
			w.state = state;
			if(state == "normal") {
				pos = screen.window_position();
				size = screen.window_size();
				w.x = pos.x;
				w.y = pos.y;
				w.w = size.x;
				w.h = size.y;
			}
			st.window = w;
			fileio.write_json(STYLE_FILE, st);
		}
		catch(e) {}
	}

	//Whether VibeVJ may quit now (Exit, the close button, Cmd + Q): a named project is saved, an unnamed one asked about
	confirm_quit() {
		ok = this.confirm_quit_project();
		if(ok)
			this.save_window_state();
		return ok;
	}

	confirm_quit_project() {
		
		project_env = std.global("project");
		
		if(project_env.name) {
			this.save_project();
			return true;
		}
		
		if(save_in_progress || load_in_progress)
			return false;
		
		res = None;
		try {
			res = screen.modal_yes_no_cancel("Save the new project before quitting?", "Quit");
		}
		catch(e) {
			return false;
		}
		
		if(res == "no") {
			//Don't save: quit and lose the unnamed project, on purpose. Its autosave goes too, the next start does
			//not offer it. (A save removes the autosave by itself)
			autosave_remove();
			return true;
		}
		
		if(res != "yes")
			return false; //Cancel
		
		//Save: the existing "Save as…" dialog of the asset browser (no second save-as implementation)
		if(!this.env.save_project_as)
			return false;
		
		try {
			this.env.save_project_as();
		}
		catch(e) {}
		
		//Only quit when the project really got a name (the form was not cancelled)
		return project_env.name ? true : false;
	}
	
	//folder: where the project is read from. "templates" (#425) loads a template as a new project without a name:
	//Save asks for one, so the template itself is never overwritten
	//from_dir: read the files from this folder instead (the autosave), the project is called name ("": no name)
	load_project(name, folder = "projects", from_dir = None) {
		if(save_in_progress || load_in_progress)
			return false;

		//Nothing is changed before the project folder has been checked (#315): loading a name that
		//does not exist used to keep the old content on screen under the new name, and the next Save
		//wrote that content into a new folder with that name.
		if(!name && !from_dir)
			return false;

		is_template = folder != "projects";
		project_dir = from_dir ? from_dir : folder + "/" + name;
		//A template and an autosave of a project without a name come in without a name
		unnamed = is_template || !name;
		
		if(!fileio.is_directory(project_dir)) {
			std.error((is_template ? "Template" : "Project") + " not found: " + name);
			//nanogui has no plain "OK" box: modal_yes_no is the only cross-platform, user-dismissible
			//message dialog (status_overlay cannot be closed by the user, std.messagebox is Windows only)
			try {
				screen.modal_yes_no("Project " + name + " not found", "Load project");
			}
			catch(e) {}
			return false;
		}
		
		//#386: a project of a newer VibeVJ is not loaded half; an older one is brought to the current format on load
		format = project_format(project_dir);
		if(format > PROJECT_FORMAT) {
			std.error("Project " + name + " has format " + format + ", this VibeVJ reads up to " + PROJECT_FORMAT);
			try {
				screen.modal_yes_no("Project " + name + " was saved by a newer VibeVJ (format " + format + "). Update VibeVJ to open it.", "Load project");
			}
			catch(e) {}
			return false;
		}

		std.print("Loading: " + name + (format < PROJECT_FORMAT ? " (format " + format + ", migrated to " + PROJECT_FORMAT + ")" : ""));
		
		tmp_fps = ctx.fps();
		ctx.fps(-1);
		
		project_env = std.global("project");
		
		//A template comes in without a name: the start up keeps opening the last real project
		project_env.name = unnamed ? None : name;
		project_env.label.text(unnamed ? "<New Project>" : name);

		if(!unnamed)
			fileio.write_string("engine/last_project.dat", name);
		
		screen.status_overlay("Loading...");
		
		load_in_progress = true;
		
		load_timer = std.millis();
		if(blackout)
			blackout.loading = true;
		
		try {
			//A project without lamps starts with an empty patch, not with the lamps of the project before
			if(fileio.exists(project_dir + "/fixture_setup.json"))
				patch = patch_normalize(migrate_project_file("fixture_setup", fileio.read_json(project_dir + "/fixture_setup.json"), format));
			else
				patch = patch_new();
			patch_changed();
			
			managed load_threads = [];
			
			for(i = 0; i < load_hooks.size(); i++) {
				hook = load_hooks[i];
				hook_name = load_hooks.key(i);
				thread = std.thread([this, project_dir, hook, hook_name, format]() {
					try {
						hook_data = migrate_project_file(hook_name, fileio.read_json(project_dir + "/" + hook_name + ".json"), format);
						hook(hook_data);
					}
					catch(e) {
						std.error("Cannot load hook: " + hook_name + ": " + e);
					}
				});
				
				load_threads.push_back(thread);
				thread.run();
			}
			
			for(i = 0; i < load_threads.size(); i++) {
				load_threads[i].join();
			}
			
			controls = migrate_project_file("controls", fileio.read_json(project_dir + "/controls.json"), format);
			nanogui.deserialize_controls(controls);
			//The project size from the output displays, once every control has its saved value (#593)
			if(displays)
				displays.project_loaded(controls);
			
			/*
			ui_settings = fileio.read_json(project_dir + "/ui_settings.json");
			if(ui_settings.filebrowser_scale)
				this.scale_widget.scale(ui_settings.filebrowser_scale);
			*/
		}
		catch(e) {}
		
		//The Blackout button was saved with the project: the outputs stay as they were before the load
		if(blackout) {
			blackout.loading = false;
			blackout.sync();
		}
		std.print("Loading took: ", (std.millis() - load_timer) / 1000.0, " seconds.");
		//The first autosave of this project comes a full interval later
		autosave_last = std.millis();
		
		screen.status_overlay("");
		
		//Not needed, as deserialize_controls will set TargetFPS midi control...
		//ctx.fps(tmp_fps);
		
		load_in_progress = false;
		
		return true;
	}

	//A change of the patch from outside the UI thread (AI queries): patch_changed() at the end of the frame. The revision
	//goes up right away, so a query that follows sees the change
	patch_changed_soon() {
		patch_revision++;
		patch_change_pending = true;
	}

	//Call after any change of the patch (lamps, addresses, groups, nodes)
	patch_changed() {
		patch_revision++;
		//Nodes added by hand by their IP: known to shizonet, so data is sent to them before (or without) an ArtPoll reply
		for(i = 0; i < patch.nodes.size(); i++) {
			node = patch.nodes[i];
			if(!node.ip)
				continue;
			try {
				dev = net.add_artnet_device(node.ip, node.name ?? "", node.mac ?? "");
				if(dev && !node.mac && dev.mac())
					node.mac = dev.mac();
			}
			catch(e) {
				std.warn("Cannot add the Art-Net node " + node.ip + ": " + e);
			}
		}
		if(fixture_menu)
			fixture_menu.build_fixture_menu();
	}

	get_style(name, default_value) {
		if(!style.has(name))
			style[name] = default_value;
		return style[name];
	}
	
	shutdown() {
		std.print("Shutting down ..");
	}
	
	register_artnet_callback(generator, callback) {
		artnet_callbacks.push_back([generator=generator, callback=callback]);
	}
	
	load_in_progress = false;
	save_in_progress = false;
}

engine = shizoengine();

std.sleep(-1);
