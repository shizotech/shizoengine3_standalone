
#include "src/defs"
#include "src/menu/menu"

import nanogui;
using eigen;

//todo: asset browser trigger in top bar mit ":::" (open close "sidebar")

class shizoengine
{
	ctx = None;
	screen = None;
	menu = None;
	style = [];
	project = [];
	env = [];
	timeline = [];
	
	generators = [];
	generators_pre_callbacks = [];
	generators_post_callbacks = [];
	
	net = None;
	artnet_callbacks = [];
	
	//Quick link as its used widely, primarily holds links to the actual "physical" controls for this fixture
	fixture_menu = None;
	
	//Needs to be managed so all json objects are invalidated everywhere when fixtures are deleted
	//Holds fixture layout information only, can be serialized, pure information
	managed fixtures = [];
	
	load_hooks = [];
	save_hooks = [];
	
	//Store these as global engine vars for convenience
	project_width = None;
	project_height = None;
	
	//Specifically for the ai agent (global states)
	ai_last_interface = None; //Contains the last focused item which implements an assistant interface
	main_generator_view = None; //Direct link to the main view
	
	__init__() {
	
		engine_global = std.global("engine");
		engine_global.set(this);
	
		net = shizonet.server("SHIZOV3");
	
		ctx = nanogui.context();
		screen = ctx.screen("ShizoEngineX");
		screen.decorated(0);

		//ctx.widget_debug(true);

		style = fileio.read_json(STYLE_FILE);
		screen.theme().from_json(style);
		
		menu = main_menu(this);
		
		//update style file
		style.merge(screen.theme().to_json());
		fileio.write_json(STYLE_FILE, style);
		
		net.on_artnet([this](uni, data) {
			for(i = 0; i < this.artnet_callbacks.size(); i++) {
				if(!this.artnet_callbacks[i].generator || !this.artnet_callbacks[i].callback)
					this.artnet_callbacks.erase(i);
					i--;
					continue;
				this.artnet_callbacks[i].callback(uni, data);
			}
		});
		
		screen.pre_render_callback([this, screen, ctx](){
		
			//Do this here for better frame-timing consistency
			this.net.artnet_sync_now();
		
			pos_delta = 0.0;
			if(this.timeline.play_btn.value())
				cur_pos = this.timeline.cursor_pos.value();
				cur_pos += (this.timeline.bpm_ctrl.value() * this.timeline.nudge_factor) / (60.0 * ctx.real_fps());
				pos_delta = cur_pos - this.timeline.cursor_pos.value();
				this.timeline.nudge_factor = 1.0; //Reset
				this.timeline.cursor_pos.value(cur_pos);
			
			//Sync all midicontrols to timeline which are sync enabled
			nanogui.sync_update(this.timeline.cursor_pos.value(), pos_delta);
			
			for(i = 0; i < this.generators_pre_callbacks.size(); i++) {
				if(!this.generators_pre_callbacks[i] || !this.generators_pre_callbacks[i].module || !this.generators_pre_callbacks[i]._pre_callback)
					this.generators_pre_callbacks.erase(i);
					i--;
					continue;
					
				try {
					this.generators_pre_callbacks[i]._pre_callback(this.generators_pre_callbacks[i], this.timeline.cursor_pos.value(), pos_delta);
				}
				catch(e) {
					this.generators_pre_callbacks.erase(i);
					i--;	
				}
			}
			
		});
		
		screen.should_close([this](){
			this.save_project();
			std.exitprocess(0);
		});
		
		ctx.on_frame_finished([this](){
			
			for(i = 0; i < this.generators_post_callbacks.size(); i++) {
				if(!this.generators_post_callbacks[i] || !this.generators_post_callbacks[i].module || !this.generators_post_callbacks[i]._post_callback)
					this.generators_post_callbacks.erase(i);
					i--;
					continue;
					
				try {
					this.generators_post_callbacks[i]._post_callback(this.generators_post_callbacks[i]);
				}
				catch(e) {
					this.generators_post_callbacks.erase(i);
					i--;	
				}
			}
		});
			
		if(fileio.exists("engine/last_project.dat"))
			env.load_project(fileio.read_string("engine/last_project.dat"));
	}
	
	__deinit__() {
		shutdown();
	}

	save_project(name = None) {
		
		project_env = std.global("project");
		
		if(name)
			project_env.name = name;
		
		return env.save_project();
	}
	
	load_project(name) {
		return env.load_project(name);
	}

	get_style(name, default_value) {
		if(!style.has(name))
			style[name] = default_value;
		return style[name];
	}
	
	shutdown() {
		std.print("Shutting down engine...");
	}
	
	register_artnet_callback(generator, callback) {
		artnet_callbacks.push_back([generator=generator, callback=callback]);
	}
}

engine = shizoengine();

std.sleep(-1);
