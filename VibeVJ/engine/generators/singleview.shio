
#include "generatoritem"

class singleview
{
	managed area = None;
	managed item = None;
	managed info_label = None;
	
	__init__(parent)
	{		
		//option_bar = parent.widget_solid();
		//option_bar.anchor_left(0).anchor_right(0).anchor_top(0).fixed_height(30);
		
		area = parent.scrollarea().anchor(0).fit_mode(true).zoom_on_scroll(false);
		area.anchor_left(0).anchor_right(0).anchor_top(0).anchor_bottom(0);
		
		area.fixed_size(vec2f(16999,16999));
		
		area.on_dragdrop_hover([this](payload, pos) {
			return true;
		});
		
		area.on_dragdrop([this, area](payload, pos) {
			path = fileio.relative_path_cwd(payload.path);	
			this.add_generator(area,path);
			//Handle payload.paths for multi-file later...
			
			return true;
		});
		
		info_label = area.label("Place Views or Assets here...").font_size(30);
	}

	dispatch(cmd, value) {
		if(!item)
			return None;
		return item.dispatch(cmd, value);
	}

	add_generator(parent, path, guid = "") {	
	
		try {
			if(info_label)
				info_label = None; //Remove info label
	
			this.item = generator(parent, path, vec2f(0,0), guid);
			item_guid = item.guid;
			
			if(!this.item || !item_guid) {
				if(this.item)
					std.free(this.item);
				return None;
			}
			
			this.item.window.anchor(0);
			
			this.item.window.header_enabled(false);
			this.item.window.resizable(false);
			this.item.window.movable(false);
			
			return this.item;
		}
		catch(e) {
			return None;
		}	
	}

	save_state() {
		if(!item)
			return [];
		return [
			item = item.save_state(),
			item_scale = area.scale(),
		];
	}

	load_state(state) {
		if(item)
			std.free(item);
			
		if(!state)
			return;
		
		// Very special function, this avoids reloading same project GUID's while the current objects may not be destroyed yet
		for(!area.screen().garbage_cleared()) {
			std.sleep(0);
		}

		try {
			if(state.item_scale)
				area.scale(state.item_scale);
			item = add_generator(area, state.item.path, state.item.guid);
			if(item)
				item.load_state(state.item);
		}
		catch(e) {}	
	}
}