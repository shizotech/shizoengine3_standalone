
#include "generatoritem"

class generatorview
{
	managed area = None;
	managed items = [];
	
	grid_size = 0.0;
	
	managed info_label = None;
	
	__init__(parent)
	{		
		//option_bar = parent.widget_solid();
		//option_bar.anchor_left(0).anchor_right(0).anchor_top(0).fixed_height(30);
		
		area = parent.scrollarea();
		area.anchor_left(0).anchor_right(0).anchor_top(0).anchor_bottom(0);
		
		area.content().fixed_size(vec2f(16999,16999));
		
		area.content().on_dragdrop_hover([this](payload, pos) {
			return true;
		});
		
		area.content().on_dragdrop([this, area](payload, pos) {
			path = fileio.relative_path_cwd(payload.path);	
			this.add_generator(area,path,pos);
			//Handle payload.paths for multi-file later...
			
			return true;
		});
		
		info_label = area.content().label("Place assets here...").font_size(30);
	}

	dispatch(cmd, value) {
		for(i = 0; i < items.size(); i++) {
			try {
				items[i].dispatch(cmd, value);
			}
			catch(e) {}
		}
		return None;
	}

	add_generator(parent, path, pos, guid = "") {	
	
		try {
			if(info_label)
				info_label = None; //Remove info label
	
			item = generator(parent, path, pos, guid);
			item_guid = item.guid;
			
			if(!item || !item_guid) {
				if(item)
					std.free(item);
				return None;
			}
			
			this.items[item_guid] = item;
			
			item.on_close = [this, item_guid]() {
				if(this.items.has(item_guid)) {
					item = this.items[item_guid];
					this.items.erase(item_guid);
					std.free(item);
				}
			};
			
			adjust_item = [this, item]() {
				
				gs = this.grid_size;
				
				if(gs <= 0.0)
					return;
				
				pos = item.window.position();
				pos.x = std.int(pos.x / gs);
				pos.y = std.int(pos.y / gs);
				item.window.position(pos * gs);
				
				size = item.window.size();
				size.x = std.int(size.x / gs);
				size.y = std.int(size.y / gs);
				item.window.size(size * gs);
				
				size = item.window.fixed_size();
				size.x = std.int(size.x / gs);
				size.y = std.int(size.y / gs);
				item.window.fixed_size(size * gs);
			};
			
			item.window.on_move_finished([adjust_item](p1,p2){
				adjust_item();
			});
			item.window.on_resize([adjust_item](p1,p2){
				adjust_item();
			});
			//std.print("GUID: " + item_guid);
			
			return item;
		}
		catch(e) {
			return None;
		}	
	}

	save_state() {
		states = [];
		
		for(i = 0; i < this.items.size(); i++) {
			item = this.items[i];
			try {
				states.push_back(item.save_state());
			}
			catch(e) {}
		}
		
		//std.print(states);
		
		return states;
	}

	load_state(states) {
		for(i = 0; i < this.items.size(); i++) {
			try {
				if(this.items[i])
					std.free(this.items[i]);
			}
			catch(e) {}
		}
		
		this.items.clear();
		
		// Very special function, this avoids reloading same project GUID's while the current objects may not be destroyed yet
		for(!area.screen().garbage_cleared()) {
			std.sleep(0);
		}
		
		area.lock_controls(false);
		
		for(i = 0; i < states.size(); i++) {
			state = &states[i];
			try {
				item = add_generator(area, state.path, vec2f(state.x, state.y), state.guid);
				item.load_state(states[i]);
			}
			catch(e) {}
		}
	}
}