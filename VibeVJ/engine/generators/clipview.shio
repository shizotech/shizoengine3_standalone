
#include "generatoritem"
#include "engine/interfaces/aiinterface"

using eigen;

CLIP_KEY_DELETE = 261;    //GLFW key codes
CLIP_KEY_BACKSPACE = 259;

class clipview
{
	managed cnt_area = None;
	managed grid = None;
	managed items = [];
	
	managed preview_area = None;
	managed layer_area = None;
	
	//Oder statt per row list einfach alle aktiven cells in einer liste und durchiterieren bis richtige row gefunden wurde ?? einfach
	//Und moven funktioniert besser ?
	
	managed composition_shader = None;
	
	managed input_ctrl = None;
	managed out_ctrl = None;
	
	managed livemode = None;
	
	active_preview = None;
	active_cells = [];
	
	layer_controls = [];
	
	reset_active_state = false;
	link_shaders_lazy = false;
	
	on_change_callback = None; //callback(item, row, col) If item == None that means the cell was removed...
	//Undo / redo (#350): engine.env.clip_views finds this view by its uid; clip_recording: a user action on clips runs
	uid = "";
	listed = false;
	clip_recording = false;
	
	__init__(parent)
	{		
		uid = std.random_hash();
		enlist();
		cnt_area = parent.widget().anchor(0);
		
		cnt = cnt_area.widget().anchor(0).anchor_bottom(25);
		
		grid = cnt.gridview()
			.anchor(0)
			.anchor_bottom(200)
			.header_left_width(230)
			.rows(0).cols(0)
			.show_grid(true);

		livemode = grid.add_item(-1,-1).pushbutton("Live").tooltip("Locks the grid for playing: no [[clip]] can be moved or selected. Starting clips keeps working.\n[[wiki:Clipview#live]]").anchor(0);
		livemode.on_change([this, grid](v){
			for(i = 0; i < grid.rows(); i++) {
				for(j = 0; j < grid.cols(); j++) {
					item = grid.get_item_at(i,j);
					if(item)
						item.attr.preview_btn.visible(!v);
						item.attr.hidden_label.visible(v);
						item.attr.trigger_btn.hide_config_menu(true);
						item.attr.trigger_btn.anchor_bottom(v ? 0 : 20);
						item.refresh_layout();
				}
			}
			grid.dragdrop_enabled(!v);
		});

		preview_area = cnt.window("Preview").anchor_left(0).anchor_right(0.5, "percent").fixed_height(200).anchor_bottom(0).movable_y(true).clamp_move(false).resizable_right(true);
		layer_area = cnt.window("Layer").anchor_left(0.5,"percent").anchor_right(0).fixed_height(200).anchor_bottom(0).movable_y(true).clamp_move(false).resizable_left(true);
	
		preview_area.on_move([cnt, grid, preview_area, layer_area](pos, old_pos){
			grid.anchor_bottom(cnt.height() - preview_area.y());
			preview_area.fixed_height(cnt.height() - preview_area.y());
			if(preview_area.y() < 0)
				preview_area.anchor_top(2);
			else
				preview_area.clear_anchor_top();
			
			layer_area.y(pos.y);
			layer_area.fixed_height(preview_area.fixed_height());
		});

		layer_area.on_move([cnt, grid, preview_area, layer_area](pos, old_pos){
			grid.anchor_bottom(cnt.height() - layer_area.y());
			layer_area.fixed_height(cnt.height() - layer_area.y());
			if(layer_area.y() < 0)
				layer_area.anchor_top(2);
			else
				layer_area.clear_anchor_top();
			
			preview_area.y(pos.y);
			preview_area.fixed_height(layer_area.fixed_height());
		});
		
		preview_area.on_resize([cnt, preview_area, layer_area](new_size, old_size) {
			perc = new_size.x / cnt.width();
			preview_area.anchor_right(1.0 - perc, "percent");
			layer_area.anchor_left(perc, "percent");
		});
		
		layer_area.on_resize([cnt, preview_area, layer_area](new_size, old_size) {
			perc = new_size.x / cnt.width();
			preview_area.anchor_right(perc, "percent");
			layer_area.anchor_left(1.0 - perc, "percent");
		});
		
		grid.dragdrop_enabled(true);
		
		//What the grid does not take (#346: a generator, an area, a drag without a path) gets the red outline of the
		//screen and is not dropped
		grid.content().on_dragdrop_hover([this, grid](payload, pos) {
			return grid.dragdrop_enabled() && this.takes_drop(payload);
		});
		
		grid.on_cell_drop([this, grid](payload, row, col) {	
			if(!this.takes_drop(payload))
				return false;

			//A clip dragged from a cell (Ctrl: a copy)
			if(this.is_clip_payload(payload))
			{	
				//A layer (the head of a row, column < 0) is not moved into the grid (#428)
				if(payload.cell.col() < 0)
					return false;

				cell = grid.get_item_at(row, col);
				
				if(cell && cell.row() == payload.cell.row() && cell.col() == payload.cell.col())
					return true;

				//One step of the undo history (#350): the cell it lands in and, for a move, the one it leaves
				copy = grid.screen().modifier_ctrl();
				cells = [[view = this, row = row, col = col]];
				source = this.clip_view_of(payload.item);
				if(!copy && source)
					cells.insert(0, [view = source, row = payload.cell.row(), col = payload.cell.col()]);
				name = copy ? "Copy clip" : (cell ? "Add to clip" : "Move clip");
				this.clip_step(name, cells, [this, payload, row, col, copy](){
					this.drop_clip(payload, row, col, copy);
				});
				return true;
			}
			
			//An asset: a new clip, or one more entry of the clip in that cell
			path = fileio.relative_path_cwd(payload.path);	
			cell = grid.get_item_at(row, col);
			this.clip_step(cell ? "Add to clip" : "Add clip", [[view = this, row = row, col = col]], [this, path, row, col](){
				this.drop_asset(path, row, col);
			});
			return true;
		});
		
		
		//Delete (or Backspace, the delete key of a Mac) deletes the selected clip (#374), while the grid has the focus.
		//The name tag of a clip has its own handler (add_generator): a button without children keeps every key
		grid.on_keyboard([this, grid](key, scancode, action, mods){
			if(this.delete_key(key, action, mods))
				return true;
			return grid.keyboard_default(key, scancode, action, mods);
		});

		input_ctrl = cnt_area.control("IN", "default_io").caption("In").anchor_left(0).anchor_bottom(0).fixed_height(25).fixed_width(50);
		out_ctrl = cnt_area.control("OUT", "default_io").caption("Out").anchor_right(0).anchor_bottom(0).fixed_height(25).fixed_width(60).as_output(true);
		
		add_composition_shader();
		
		set_size(3,4);
		
		input_ctrl.callback([this](v){
			this.link_shaders();
		});
	}

	dispatch(cmd, value) {	
		for(i = 0; i < items.size(); i++) {
			if(cmd == "active" && value) {
				//Do not set clips within the grid to active ! Only the layers
				//Active should only be active_preview and active_cells and transit_b
				if(items[i].extra_widgets && items[i].extra_widgets.cell && items[i].extra_widgets.cell.row() >= 0)
					continue;
			}
			
			items[i].dispatch(cmd, value);
		}
		
		if(cmd == "active" && value) {
			if(active_preview)
				active_preview.attr.set_active(true);
			for(i = 0; i < active_cells.size(); i++) {
				if(active_cells[i])
					active_cells[i].attr.set_active(true);
			}
			for(i = 0; i < layer_controls.size(); i++) {
				if(layer_controls[i].transit_b)
					layer_controls[i].transit_b.attr.set_active(true);
			}
		}
		
		return None;
	}

	set_size(rows, cols) {
		
		set_size_in_progress = true;
		
		old_rows = grid.rows();
		old_cols = grid.cols();
		
		grid.rows(rows).cols(cols);
		
		active_cells.resize(rows);
		layer_controls.resize(rows);
		
		//DOESNT WORK YET ?
		/*
		managed load_threads = [];

		for(i = old_rows; i < grid.rows(); i++) {
			layer_controls[i] = [];
			t = std.thread(this.add_layer_shader);
			load_threads.push_back(t);
			t.run(i);
		}
		
		for(i = 0; i < load_threads.size(); i++) {
			load_threads[i].join();
		}*/
		
		
		for(i = old_rows; i < grid.rows(); i++) {
			layer_controls[i] = [];
			this.add_layer_shader(i);
		}

		for(i = old_cols; i < grid.cols(); i++) {
			if(grid.get_header_top_item(i))
				continue;
			trigger_btn = grid.add_header_top_item(i).controlbutton("COLUMN"+(i+1), "layer_trigger_"+i).caption("Column " + (i+1)).anchor(0).hide_config_menu();
			trigger_btn.get_button().icon(nanogui.icon("play")).tooltip("Start every [[clip]] in [[column]] " + (i+1)); //the small play icon says it triggers
			trigger_btn.callback([this, i](v){
				if(!v)
					return;
				for(r = 0; r < this.grid.rows(); r++) {
					item = grid.get_item_at(r, i);
					if(item && item.attr.trigger_btn)
						cb = item.attr.trigger_btn.callback();
						cb(true);
					else
						cb = this.layer_controls[r].stop_btn.callback();
						cb(true);
				}
			});
		}
		
		//Also reset render callbacks, because load_state etc will override them
		try {
			for(i = 0; i < layer_controls.size(); i++) {
				ctrls = layer_controls[i];
				if(ctrls.layer_item) {
					item = ctrls.layer_item.dispatch("get_item", 0);
					if(item) {
						item.dispatch("set_render_callback", ctrls.render_callback);
					}
				}
			}
		}
		catch(e) {}
		
		set_size_in_progress = false;
		
	}

	link_shaders() {
		
		if(load_in_progress || set_size_in_progress)
			return;
		
		//std.print("linking shaders...");
		for(i = 0; i < active_cells.size(); i++) {
			
			try {
			
				if(!grid.get_header_left_item(i) || i >= layer_controls.size()) //the head of this row is gone
					continue; //the other rows and the composition go on (#574)
				
				cell = active_cells[i];
				cell_item = cell ? cell.attr.item : None;
				
				layer = grid.get_header_left_item(i);
				layer_item = layer ? layer.attr.item : None;
				
				cell_out = cell_item ? cell_item.dispatch("get_default_output") : None;
				
				layer_in = layer_item ? layer_item.dispatch("get_default_input") : None;
				layer_out = layer_item ? layer_item.dispatch("get_default_output") : None;
				
				last_layer_index = i+layer_controls[i].layer_input_offset.value();
				//The control is a row OFFSET (1 = the row below, -1 = the row above), so row 0 ("Layer 1")
				//is a valid target: the lower bound is >= 0, not > 0 (#312).
				last_layer_item = last_layer_index >= 0 && last_layer_index < layer_controls.size() ? layer_controls[last_layer_index].layer_item : None;
				last_layer_out = last_layer_item ? last_layer_item.dispatch("get_default_output").value() : None;
				
				layer_transit_item = layer_controls[i].transit_b ? layer_controls[i].transit_b.attr.item : None;
				//layer_transit_in = layer_transit_item ? layer_transit_item.dispatch("get_default_input") : None;
				layer_transit_out = layer_transit_item ? layer_transit_item.dispatch("get_default_output") : None;

				//No clip runs on this layer: it passes the layers below through, whatever its blend mode
				//(layerblend.glsl). With No Blend an empty Layer 1 made the whole output black (#574)
				if(layer_item)
					layer_item.dispatch("set_uniform", [
						name = "LAYER_EMPTY",
						value = cell_out ? 0 : 1,
						index = 0,
					]);

				//Link row active cell output to iChannel0 of the row layer shader, and the previous layer output into iChannel1 for mixing...
				try {
					
					layer_in.value(cell_out ? cell_out.value() : None);
					
					for(j = 0; j < cell.attr.inputs.size(); j++) {
						in = cell.attr.inputs[j];
						if(in.ctrl.value() != 0) {
							target_layer_index = in.ctrl.value();
							if(in.type.value() == 0) //Rel layer index: a row offset
								target_layer_index += i;
							else
								target_layer_index -= 1; //Absolute: the layer NUMBER, so 1 is the first row
							
							//Index convention (#312, #374):
							//  Relative (type 0): the value is a row OFFSET added to this row, so -1 is the row above
							//  and the target can be row 0 ("Layer 1"); 0 means "off" (handled by the if above).
							//  Absolute (type 1): the value is the layer number, 1-based: 1 = "Layer 1" (row 0),
							//  2 = "Layer 2", and 0 = "off", the same 0 = off rule as Relative. Before #374 it was the
							//  0-based row index, which made Absolute 1 pick Layer 2 and left Layer 1 out of reach.
							//  Projects saved with the old numbers get +1 in migrate_3_to_4 (engine/migrate/migrate.shio),
							//  so an existing Absolute link stays on the layer it was wired to.
							//Both bounds are >= 0, the old > 0 excluded Layer 1.
							target_layer_item = target_layer_index >= 0 && target_layer_index < layer_controls.size() ? layer_controls[target_layer_index].layer_item : None;
							target_layer_out = target_layer_item ? target_layer_item.dispatch("get_default_output").value() : None;
							if(cell.attr.has_default_input)
								cell_item.dispatch("get_default_input").value(target_layer_out);
							else
								cell_item.dispatch("set_input", [name=in.name, value=target_layer_out]);
						}
						else {
							
							if(cell.attr.has_default_input)
								cell_item.dispatch("get_default_input").value(None);
							else
								cell_item.dispatch("set_input", [name=in.name, value=None]);
						}
					}
		
					layer_item.dispatch("set_input", [
						name = "iChannel1",
						value = last_layer_out,
						index = 0,
					]);

					transit_out_value = layer_transit_out ? layer_transit_out.value() : None;
					layer_item.dispatch("set_input", [
						name = "iChannel2",
						value = transit_out_value,
						index = 0,
					]);
				
				}
				catch(e) {
					layer_in.value(None);
				}
				//std.print(cell_item.dispatch("get_default_input"));
			}
			catch(e) {
				this.active_cells[i] = None;
				this.layer_controls[i].transit_b = None;
				this.layer_controls[i].transit_c = None;
			}
		}
	
		layer = grid.get_header_left_item(0);
		layer_item = layer.attr.item;
		layer_out = layer_item.dispatch("get_default_output").value();
			
		composition_shader.dispatch("get_default_input").value(layer_out);
	}

	//A control of the shader of a layer (layerblend.glsl, the first item of its stack), by the name of its uniform
	layer_uniform_control(layer, name) {
		try {
			gen = layer.dispatch("get_item", 0);
			if(!gen || !gen.node)
				return None;
			paths = gen.node.get_control_paths(true);
			for(i = 0; i < paths.size(); i++) {
				//The uniforms of a shader are in its "Controls": "uniforms.uniforms@Controls.<name>"
				if(paths[i].starts("uniforms") && paths[i].ends("." + name))
					return gen.node.get_control_by_path(paths[i]);
			}
		}
		catch(e) {}
		return None;
	}

	add_layer_shader(row) {
		if(grid.get_header_left_item(row))
			return;
		
		layer = add_generator("engine/assets/layerblend.glsl", row, -1, "layer_shader_"+row, false);
		layer.dispatch("no_delete", true);
		layer.dispatch("set_first_name", "LayerBlend");
		
		cell = grid.get_header_left_item(row);
		cell.attr.row = row; //This is a bit confusing, since header widgets internally only store (-1000,-1000) we have to store it extra
		cell.attr.preview_btn.anchor_right(0.5,"percent").caption("Layer "+(row+1));
		
		ctrl_cnt = cell.widget().anchor(0).anchor_left(0.5, "percent");
		
		master_ctrl = ctrl_cnt.controlslider("MASTER", "layer_ctrls_"+row).tooltip("Brightness of the whole [[layer]]\n[[wiki:Clipview#layers]]").caption("Master").anchor_left(0).anchor_top(0).anchor_right(0).fixed_height(20);
		mix_ctrl = ctrl_cnt.controlslider("MIX", "layer_ctrls_"+row).tooltip("How strongly the [[clip]] of this [[layer]] is blended over the layers below").caption("Mix").anchor_left(0).anchor_top(20).anchor_right(0).fixed_height(20);
		trans_ctrl = ctrl_cnt.controlslider("TRANSITION", "layer_ctrls_"+row).tooltip("[[transition|Transition]]: how long the fade to a new [[clip]] takes, in seconds. 0: a hard cut.").caption("Transition").unit("s").anchor_left(0).anchor_top(40).anchor_right(0).fixed_height(20).max(60);
		
		cell.attr.master_ctrl = master_ctrl;
		cell.attr.mix_ctrl = mix_ctrl;
		cell.attr.trans_ctrl = trans_ctrl;

		//The blend mode of the layer in the layer cell itself (#428), above its preview. The value stays in the BLEND
		//control of the layer shader (saved with it, MIDI mappings of it keep working): this one sets it, and follows it
		//in the render callback when it is changed there
		shader_blend = layer_uniform_control(layer, "BLEND");
		blend_ctrl = None;
		if(shader_blend) {
			cell.attr.shader_view.anchor_top(20);
			blend_ctrl = cell.controlcombo("BLEND", "layer_ctrls_"+row).items(shader_blend.items())
				.tooltip("How this [[layer]] is laid over the layers below it\n[[wiki:Clipview#layers]]")
				.anchor_left(0).anchor_top(0).anchor_right(0.5, "percent").fixed_height(18);
			blend_ctrl.value(shader_blend.value(), false);
			blend_ctrl.callback([shader_blend](v){
				//The layer shader can be gone first (the view is freed, a project loads): nothing to set then
				try {
					if(shader_blend.value() != v)
						shader_blend.value(v);
				}
				catch(e) {}
			});
		}
		
		points = trans_ctrl.envelope().points();
		points.insert(1,[1,0.0,0.5]);
		trans_ctrl.envelope().points(points);
		
		autoplay_backward = ctrl_cnt.controlbutton("<<<", "layer_autoplay_start_"+row).anchor_left(0.0, "percent").anchor_top(60).anchor_right(0.7,"percent").fixed_height(18).hide_config_menu().push(1);
		autoplay_random = ctrl_cnt.controlbutton("RND", "layer_autoplay_random_"+row).anchor_left(0.3,"percent").anchor_top(60).anchor_right(0.3,"percent").fixed_height(18).hide_config_menu().push(1);
		autoplay_forward = ctrl_cnt.controlbutton(">>>", "layer_autoplay_start_"+row).anchor_left(0.7,"percent").anchor_top(60).anchor_right(0.0,"percent").fixed_height(18).hide_config_menu().push(1);
		
		stop_btn = ctrl_cnt.controlbutton("STOP", "layer_autoplay_stop_"+row).anchor_top(80).anchor_left(0.3,"percent").anchor_right(0.3,"percent").fixed_height(18).hide_config_menu();
		autoplay_prev = ctrl_cnt.controlbutton("<", "layer_autoplay_prev_"+row).anchor_left(0,"percent").anchor_top(80).anchor_right(0.7,"percent").fixed_height(18).hide_config_menu();
		autoplay_next = ctrl_cnt.controlbutton(">", "layer_autoplay_next_"+row).anchor_left(0.7,"percent").anchor_top(80).anchor_right(0).fixed_height(18).hide_config_menu();
		
		//Autoplay runs the show, it is no edit: no steps of the undo history (#350)
		autoplay_backward.undoable(false);
		autoplay_random.undoable(false);
		autoplay_forward.undoable(false);

		//Transport glyphs as icons; the control names stay the same, MIDI mappings and saved projects use them
		autoplay_backward.get_button().caption("").icon(nanogui.icon("backward")).tooltip("[[autoplay|Autoplay]] backwards");
		autoplay_random.get_button().caption("").icon(nanogui.icon("random")).tooltip("[[autoplay|Autoplay]] random");
		autoplay_forward.get_button().caption("").icon(nanogui.icon("forward")).tooltip("[[autoplay|Autoplay]] forwards");
		autoplay_prev.get_button().caption("").icon(nanogui.icon("step_backward")).tooltip("Previous [[clip]]");
		autoplay_next.get_button().caption("").icon(nanogui.icon("step_forward")).tooltip("Next [[clip]]");
		stop_btn.get_button().caption("").icon(nanogui.icon("stop")).tooltip("Stop the [[layer]]: no clip is [[live]], and [[autoplay]] goes off");

		cell.attr.stop_btn = stop_btn;
		
		autoplay_backward.callback([autoplay_random, autoplay_forward](v) {
			if(!v)
				return;
			autoplay_random.value(0, false);
			autoplay_forward.value(0, false);
		});
		autoplay_random.callback([this, autoplay_backward, autoplay_forward, row](v) {
			if(!v)
				return;
			autoplay_backward.value(0, false);
			autoplay_forward.value(0, false);
			this.layer_controls[row].autoplay_list = [];
		});
		autoplay_forward.callback([autoplay_random, autoplay_backward](v) {
			if(!v)
				return;
			autoplay_random.value(0, false);
			autoplay_backward.value(0, false);
		});
		
		autoplay_next.callback([this, row](v){
			if(!v)
				return;
			//No clip live: the first clip of the row is next, not the second (#374)
			cur_col = this.active_cells[row] ? this.active_cells[row].col() : -1;
			for(i = cur_col+1; i < this.grid.cols(); i++)
				if(grid.get_item_at(row, i) && !grid.get_item_at(row, i).attr.autoplay_exclude.value() && grid.get_item_at(row, i).attr.trigger_mode.value() == 0)
					trigger = grid.get_item_at(row, i).attr.trigger_btn.callback();
					trigger(true);
					has_trigger = true;
					return;
			for(i = 0; i < this.grid.cols(); i++)
				if(grid.get_item_at(row, i) && !grid.get_item_at(row, i).attr.autoplay_exclude.value() && grid.get_item_at(row, i).attr.trigger_mode.value() == 0)
					trigger = grid.get_item_at(row, i).attr.trigger_btn.callback();
					trigger(true);
					return;
		});
		
		autoplay_prev.callback([this, row](v){
			if(!v)
				return;
			cur_col = this.active_cells[row] ? this.active_cells[row].col() : 0;
			for(i = cur_col-1; i >= 0; i--)
				if(grid.get_item_at(row, i) && !grid.get_item_at(row, i).attr.autoplay_exclude.value() && grid.get_item_at(row, i).attr.trigger_mode.value() == 0)
					trigger = grid.get_item_at(row, i).attr.trigger_btn.callback();
					trigger(true);
					return;
			for(i = this.grid.cols()-1; i >= 0; i--)
				if(grid.get_item_at(row, i) && !grid.get_item_at(row, i).attr.autoplay_exclude.value() && grid.get_item_at(row, i).attr.trigger_mode.value() == 0)
					trigger = grid.get_item_at(row, i).attr.trigger_btn.callback();
					trigger(true);
					return;
		});
		
		stop_btn.callback([this, row, autoplay_forward, autoplay_backward, autoplay_random](v){
			if(!v)
				return;
			
			autoplay_forward.value(0);
			autoplay_backward.value(0);
			autoplay_random.value(0);
			
			cur_cell = this.active_cells[row];
			cur_transit = this.layer_controls[row].transit_b;
			
			this.active_cells[row] = None;
			
			if(this.layer_controls[row].transit_b)
				this.layer_controls[row].transit_b.outline(false);
			this.layer_controls[row].transit_b = None;
			
			if(this.layer_controls[row].transit_c)
				this.layer_controls[row].transit_c.outline(false);
			this.layer_controls[row].transit_c = None;
			
			if(cur_cell)
				cur_cell.attr.set_active(false);
			if(cur_transit)
				cur_transit.attr.set_active(false);
			
			this.link_shaders();
		});
		
		settings_area = layer.dispatch("get_settings_area", "Layer Settings").content().layout(nanogui.layout_vertical());
		layer_name = settings_area.controltext("layer_name", "layer_name_"+row).caption("Name");
		layer_input_offset = settings_area.controlint("Layer input from", "layer_input_"+row).tooltip("Which [[layer]] this one is laid over. 1: the layer below.\n[[wiki:Clipview#layers]]").value(1);
		autoplay_vec = settings_area.controlvector("Autoplay", "autoplay_settings_"+row).content().layout(nanogui.layout_vertical());
		autoplay_duration = autoplay_vec.controlfloat("DurationBeats", "autoplay_settings_"+row).tooltip("How long each [[clip]] plays during [[autoplay]], in [[beat|beats]]").caption("Duration").unit("beats").value(64);
		macro_vec = settings_area.controlvector("Macros", "macro_settings_"+row).content().layout(nanogui.layout_vertical());
		map_to_clip_macros = macro_vec.controlbutton("MAP TO CLIP MACROS").tooltip("The [[macro|macros]] of the [[layer]] play the macros of the [[clip]] that is [[live]]").caption("Map to clip macros").push(true);
		
		//No way this should fail, given how the headers are initialized, this should be fine.
		for(row >= layer_controls.size())
			layer_controls.push_back([]);
		
		layer_macros = [];
		
		layer_controls[row] = [
			name=layer_name,
			transition = trans_ctrl,
			transition_time = 0.0,
			last_autoplay_time = 0.0,
			transit_b = None,
			transit_c = None,
			layer_item = layer,
			row = row,
			autoplay_random = autoplay_random,
			autoplay_forward = autoplay_forward,
			autoplay_backward = autoplay_backward,
			autoplay_list = [],
			stop_btn = stop_btn,
			layer_input_offset=layer_input_offset,
			macros = layer_macros,
			map_to_clip_macros = map_to_clip_macros,
			blend = blend_ctrl,
			shader_blend = shader_blend,
		];
		
		for(i = 0; i < 8; i++) {
			layer_macros.push_back(macro_vec.controlslider("MACRO " + (i+1)).caption("Macro " + (i+1)));
			layer_macros[-1].callback([this, row, i, map_to_clip_macros](v){
				if(!map_to_clip_macros.value())
					return;
				ctrls = layer_controls[row];
				if(ctrls.macro_cell)
					ctrls.macro_cell.attr.macros[i].value(v);
			});
		}
		
		//Create local ref, do not lambda capture to avoid cyclic references?
		ctrls = layer_controls[row];
		ctrls.start_transition = [this](cell, item) {
			row = cell.row();
			ctrls = this.layer_controls[row]; //Dont lambda capture it to avoid cyclic refs
			
			transition_value = ctrls.transition.value();
			
			if(cell.attr.trigger_mode.value() == 0)
				ctrls.last_active_cell = cell;
			
			if(this.active_cells[row])
				custom_transition = this.active_cells[row].attr.transition.value();
				if(custom_transition >= 0.0)
					transition_value = custom_transition;
			
			if(cell)
				custom_transition = cell.attr.transition.value();
				if(custom_transition >= 0.0)
					transition_value = custom_transition;
			
			layer_macros = layer_controls[row];
			if(layer_macros.map_to_clip_macros.value()) {
				layer_macros.macro_cell = cell;
				for(i = 0; i < layer_macros.macros.size(); i++){
					layer_macros.macros[i].value(cell.attr.macros[i].value());
				}
			}
			else
				layer_macros.macro_cell = None;
			
			//Simple case
			if(transition_value == 0) {
				if(this.active_cells[row] && this.active_cells[row] != cell)
					active_cell = this.active_cells[row];
					this.active_cells[row] = None;
					active_cell.attr.set_active(false);
				this.active_cells[row] = cell;
				cell.attr.set_active(true);
				return;
			}

			//Avoid multi triggers...
			
			if(this.active_cells[row] && this.active_cells[row] == cell) {
				//A bit confusing, but if transit B is set and this cell is triggered again, its likely it is in a transition and the user wants to go back to that cell
				//So it makes sense to make the cell "transit_c" even tho it is currently active...
				if(!ctrls.transit_b)
					return;
			}
			
			if(ctrls.transit_b && ctrls.transit_b == cell) {
				if(ctrls.transit_c)
					ctrls.transit_c.outline(false); //the queued clip is dropped: clear its Next state
				ctrls.transit_c = None; //Reset next transition to C because we want to stay on this cell here...
				return;
			}
			
			if(ctrls.transit_c && ctrls.transit_c == cell)
				return;
				
			if(ctrls.transit_b) {
				if(ctrls.transit_c)
					ctrls.transit_c.outline(false);
				ctrls.transit_c = cell;
				cell.state("next"); //queued after the running transition: cue ring and Next badge
			}
			else {
				ctrls.transition_time = transition_value;
				ctrls.transit_b = cell;
				cell.attr.set_active(true);
				cell.attr.item.dispatch("transition", [
							value = 0.0,
							other = this.active_cells[row],
							is_transit_a = false,
							is_transit_b = true,
						]);
				ctrls.layer_item.dispatch("set_uniform", [
					name = "TRANSITION",
					value = 0.0,
					index = 0,
				]);
			}
			
		};
		
		layer_name.callback([this, cell, row](v){
			cell.attr.preview_btn.caption(v);
			if(this.on_change_callback) {
				this.on_change_callback(cell.attr.item, row, -1);
			}
		});
		
		cell.attr.layer_name = layer_name;
		
		layer_input_offset.callback([this](v){
			link_shaders_lazy = true;
		});
		
		master_ctrl.callback([layer](v){
			layer.dispatch("set_uniform", [
				name = "MASTER",
				value = v,
				index = 0,
			]);
		});
		
		mix_ctrl.callback([layer](v){
			layer.dispatch("set_uniform", [
				name = "MIX",
				value = v,
				index = 0,
			]);
		});
		
		trans_ctrl.callback([layer, ctrls](v){
			ctrls.transition_time = math.min(v, ctrls.transition_time);
		});
		
		master_ctrl.value(1.0);
		mix_ctrl.value(0.5);
		
		layer_name.value("Layer "+(row+1));
		
		timeline = std.global("timeline");
		
		ctrls.render_callback = [this, layer, row,
			timeline, autoplay_forward, autoplay_random, autoplay_backward, autoplay_duration](){
			
			if(load_in_progress)
				return;
				
			if(this.active_cells.size() < row)
				this.active_cells.resize(row+1);
			
			if(row == 0)
				if(link_shaders_lazy)
					link_shaders_lazy = false;
					link_shaders();
			
			try {
				ctrls = this.layer_controls[row]; //Dont lambda capture it to avoid cyclic refs, and other weird things

				//The blend mode was changed in the layer shader (its Controls, a MIDI mapping, a project load)
				if(ctrls.blend && ctrls.shader_blend) {
					try {
						if(ctrls.blend.value() != ctrls.shader_blend.value())
							ctrls.blend.value(ctrls.shader_blend.value(), false);
					}
					catch(e) {}
				}
				
				transit_a = this.active_cells[row];
				
				//Sanity checks. A clip of this row that is gone is taken out of the row here;
				//dead_input says that happened, and the row is linked again below (#574).
				//The && on the old value: a row without a transition is already None, that is not a death.
				dead_input = false;
				if(std.vtype(transit_a) != "nanogui.gridview_item" && transit_a)
					transit_a = None;
					this.active_cells[row] = None;
					dead_input = true;
				if(transit_a && !transit_a.attr.item)
					transit_a = None;
					this.active_cells[row] = None;
					dead_input = true;
					
				if(std.vtype(ctrls.transit_b) != "nanogui.gridview_item" && ctrls.transit_b)
					ctrls.transit_b = None;
					dead_input = true;
				if(ctrls.transit_b && !ctrls.transit_b.attr.item)
					ctrls.transit_b = None;
					dead_input = true;
				
				if(std.vtype(ctrls.transit_c) != "nanogui.gridview_item" && ctrls.transit_c)
					ctrls.transit_c = None;
					dead_input = true;
				if(ctrls.transit_c && !ctrls.transit_c.attr.item)
					ctrls.transit_c = None;
					dead_input = true;
				
				//link_shaders only walks the cells and transits it still has, so a clip that goes leaves
				//the layer input to itself: the layer keeps the picture of the gone clip and shows black
				//(#574). Not here every frame: only when a clip was taken out above.
				if(dead_input)
					link_shaders();
				
				//Autoplay
				if(autoplay_forward.value()||autoplay_backward.value()||autoplay_random.value())
				{	
					t = timeline.cursor_pos.value();
					dur = autoplay_duration.value();
					
					if(this.active_cells[row])
						custom_dur = this.active_cells[row].attr.duration.value();
						if(custom_dur >= 0.0)
							dur = custom_dur;
					
					if(t < ctrls.last_autoplay_time)
						ctrls.last_autoplay_time = t;
					
					beat_due = (t - ctrls.last_autoplay_time) >= dur;
					
					if(beat_due)
					{	
						ctrls.last_autoplay_time = t;
						
						//No clip live: forwards starts with the first clip of the row, backwards with the last (#374)
						cur_col = this.active_cells[row] ? this.active_cells[row].col() : -1;
						
						if(autoplay_forward.value())
							has_trigger = false;
							for(i = cur_col+1; i < this.grid.cols(); i++)
								if(grid.get_item_at(row, i) && !grid.get_item_at(row, i).attr.autoplay_exclude.value() && grid.get_item_at(row, i).attr.trigger_mode.value() == 0)
									trigger = grid.get_item_at(row, i).attr.trigger_btn.callback();
									trigger(true);
									has_trigger = true;
									break;
							if(!has_trigger)
								for(i = 0; i < this.grid.cols(); i++)
									if(grid.get_item_at(row, i) && !grid.get_item_at(row, i).attr.autoplay_exclude.value() && grid.get_item_at(row, i).attr.trigger_mode.value() == 0)
										trigger = grid.get_item_at(row, i).attr.trigger_btn.callback();
										trigger(true);
										break;
						else if(autoplay_backward.value())
							has_trigger = false;
							for(i = cur_col-1; i >= 0; i--)
								if(grid.get_item_at(row, i) && !grid.get_item_at(row, i).attr.autoplay_exclude.value() && grid.get_item_at(row, i).attr.trigger_mode.value() == 0)
									trigger = grid.get_item_at(row, i).attr.trigger_btn.callback();
									trigger(true);
									has_trigger = true;
									break;
							if(!has_trigger)
								for(i = this.grid.cols()-1; i >= 0; i--)
									if(grid.get_item_at(row, i) && !grid.get_item_at(row, i).attr.autoplay_exclude.value() && grid.get_item_at(row, i).attr.trigger_mode.value() == 0)
										trigger = grid.get_item_at(row, i).attr.trigger_btn.callback();
										trigger(true);
										break;
						else if(autoplay_random.value())
							if(!ctrls.autoplay_list)
								full_list = [];
								rnd_list = [];
								for(i = 0; i < grid.cols(); i++)
									full_list.push_back(i);
								for(full_list.size())
									rnd_index = math.random_int(0, full_list.size()-1);
									rnd_list.push_back(full_list[rnd_index]);
									full_list.erase(rnd_index);
								ctrls.autoplay_list = rnd_list;
							for(ctrls.autoplay_list.size())
								i = ctrls.autoplay_list[0];
								ctrls.autoplay_list.erase(0);
								if(grid.get_item_at(row, i) && !grid.get_item_at(row, i).attr.autoplay_exclude.value() && grid.get_item_at(row, i).attr.trigger_mode.value() == 0)
									trigger = grid.get_item_at(row, i).attr.trigger_btn.callback();
									trigger(true);
									break;
					}
				}
				
				transition_value = ctrls.transition.value();
				
				if(this.active_cells[row])
					custom_transition = this.active_cells[row].attr.transition.value();
					if(custom_transition >= 0.0)
						transition_value = custom_transition;
				
				if(ctrls.transit_b)
					custom_transition = ctrls.transit_b.attr.transition.value();
					if(custom_transition >= 0.0)
						transition_value = custom_transition;
				
				if(ctrls.transition_time <= 0.0) {
					
					if(transit_a) {
						try {
							other = ctrls.transit_b ?? None;
							transit_a.attr.item.dispatch("transition", [
								value = 1.0,
								other = other,
								is_transit_a = true,
								is_transit_b = false,
							]);
						}
						catch(e) {
							//Reset states ?
							ctrls.stop_btn.value(1);
							ctrls.stop_btn.value(0);
							return;
						}
					}
					
					if(ctrls.transit_b) {
						try {
							other = transit_a ?? None;
							ctrls.transit_b.attr.item.dispatch("transition", [
								value = 0.0,
								other = other,
								is_transit_a = false,
								is_transit_b = true,
							]);
						}
						catch(e) {
							ctrls.stop_btn.value(1);
							ctrls.stop_btn.value(0);
							return;
						}

						old_active = this.active_cells[row];
						this.active_cells[row] = ctrls.transit_b;
						ctrls.transit_b = None;
						if(old_active)	
							old_active.attr.set_active(false);
						
						ctrls.layer_item.dispatch("set_input", [
								name = "iChannel2",
								value = None,
								index = 0,
							]);
						
						this.active_cells[row].attr.set_active(true);			
					}
					
					ctrls.layer_item.dispatch("set_uniform", [
							name = "TRANSITION",
							value = 0.0,
							index = 0,
						]);
					
					if(ctrls.transit_c) {
						tmp = ctrls.transit_c;
						ctrls.transit_c = None;
						ctrls.start_transition(tmp, tmp.attr.item);
					}
					
					return;
				}
				
				perc = 1.0 - math.clamp(ctrls.transition_time / transition_value, 0, 1);
		
				ctrls.layer_item.dispatch("set_uniform", [
					name = "TRANSITION",
					value = perc,
					index = 0,
				]);
				
				real_fps = nanogui.current_context().real_fps();
			
				ctrls.transition_time = ctrls.transition_time - (1.0/real_fps);		
			
				if(transit_a)
				{
					try {
						other = ctrls.transit_b ? ctrls.transit_b.attr.item : None;
						transit_a.attr.item.dispatch("transition", [
							value = 1.0 - perc,
							other = other,
							is_transit_a = true,
							is_transit_b = false,
						]);
					}
					catch(e) {
						//Reset states ?
						ctrls.stop_btn.value(1);
						ctrls.stop_btn.value(0);
						return;
					}
				}
				if(ctrls.transit_b) {
					try {
						other = transit_a ?? None;
						ctrls.transit_b.attr.item.dispatch("transition", [
							value = perc,
							other = other,
							is_transit_a = false,
							is_transit_b = true,
						]);
					}
					catch(e) {
						//Reset states ?
						ctrls.stop_btn.value(1);
						ctrls.stop_btn.value(0);
						return;
					}
				}
			}
			catch(e) {
				if(this.active_cells) {
					this.active_cells[row] = None;
					this.layer_controls[row].transit_b = None;
					this.layer_controls[row].transit_c = None;
				}
			}
		};
		
		layer.dispatch("get_item", 0).dispatch("set_render_callback", ctrls.render_callback);
	}
	
	add_composition_shader() {
		if(composition_shader)
			return;
		
		composition_shader = generator(preview_area, "engine/assets/composition.glsl", vec2f(0,0), "composition_shader", [no_header=true]);
		composition_shader.window.anchor(0);
		item_guid = composition_shader.guid;
		items[item_guid] = composition_shader;
		composition_shader.dispatch("get_default_input").visible(false);
		
		composition_shader.dispatch("set_render_callback", [this](){
			if(this.reset_active_state)
				this.reset_active_state--;
				//Every clip, as save_state() goes over them: also one that shares its cell with another clip, which
				//grid.get_item_at() does not return (which of the two it returns depends on the order of the load
				//threads, so the other one kept the state it was saved with, #202 round trip of ledmap)
				try {
					for(i = 0; i < this.items.size(); i++) {
						if(this.items.key(i) == "composition_shader")
							continue;
						cell = this.items[i].extra_widgets.cell;
						if(cell && cell.row() >= 0)
							cell.attr.set_active(false);
					}
				}
				catch(e) {}		
				
				if(this.active_preview)
					this.active_preview.attr.preview_btn.pushed(false);
					cb = this.active_preview.attr.preview_btn.on_change();
					cb(false);
		});
		
		out_ctrl.value(composition_shader.dispatch("get_default_output").value());
		out_ctrl.callback([this, out_ctrl](v){
			out_ctrl.value(this.composition_shader.dispatch("get_default_output").value());
		});
	}

	//from_state: the clip comes from a saved state, whose load_state fills its stack right after; the clip stays even
	//when its own asset no longer exists, so its saved entries are not lost (#202)
	add_generator(path, row, col, guid = "", auto_select_preview = true, from_state = false) {
		if(row >= 0 && col >= 0) {
			new_rows = grid.rows();
			new_cols = grid.cols();
			
			if(row >= new_rows-1)
				new_rows = row+2;
			if(col >= new_cols-1)
				new_cols = col+2;
			
			set_size(new_rows, new_cols);
		}
		
		layer_area.content().children_visible(false);
		
		cell = None;
		shader_view = None;
		name_view = None;
		
		if(col >= 0)
			cell = grid.add_item(row, col);
			shader_view = cell.shader_view().anchor(2).anchor_bottom(20);
			name_view = cell.label("").anchor(2).anchor_bottom(20).visible(false);
		else
			cell = grid.add_header_left_item(row);
			shader_view = cell.shader_view().anchor(0).anchor_bottom(25).anchor_right(0.5,"percent");
			name_view = cell.label("").anchor(2).anchor_bottom(25).visible(false);
			
		name_view.alignment("center");
		
		cell.attr.shader_view = shader_view;
		
		//A clip without a picture (a Phaser) draws its cell itself (#677): the entry of its stack that has a cell preview
		//(get_cell_preview), asked to draw every frame
		cell_draw = None;
		if(col >= 0) {
			cell_draw = cell.widget().anchor(2).anchor_bottom(20).visible(false);
			cell.attr.cell_preview = None;
			cell_draw.on_draw([cell, cell_draw]() {
				entry = cell.attr.cell_preview;
				if(!entry)
					return;
				size = cell_draw.size();
				nanogui.nvgSave();
				nanogui.nvgIntersectScissor(vec2f(0, 0), vec2f(size.x, size.y));
				entry.dispatch("draw_cell", size);
				nanogui.nvgRestore();
			});
		}
		
		//Dont forget to save hash / name of this controlbutton too for reconstruction !!!
		
		item = generator(layer_area, "engine/assets/shaderstack.asset", vec2f(0,0), guid, [no_header=true, custom_path=path]);
		
		if(!item) {
			std.free(item);
			std.free(cell);
			return None;
		}
		
		item.window.anchor(0);
		item.extra_widgets = [cell=cell];
		item_guid = item.guid;
		
		trigger_btn = col >= 0 ? cell.controlbutton("TRIGGER_"+item_guid).hold(true).anchor(0).anchor_bottom(20).transparent(1) : None;
		//The selected clip (shown in the preview) is a selection, not "on": accent, not green
		preview_btn = cell.pushbutton(fileio.pure_name(path)).anchor_left(2).anchor_right(2).anchor_bottom(2).fixed_height(20).latched_style("selection").pushed(auto_select_preview);
		hidden_label = cell.label(fileio.pure_name(path)).anchor_left(2).anchor_right(2).anchor_bottom(2).fixed_height(20).alignment("center").visible(false);
		
		cell.attr.item = item;
		cell.attr.preview_btn = preview_btn;

		//What the user does to the stack of this clip (an entry added or removed) is a step of the undo history (#350).
		//Not for a layer: its stack is made by the Clipview
		if(col >= 0) {
			item.dispatch("on_user_step", [this, cell](name, action){
				this.clip_step(name, [[view = this, row = cell.row(), col = cell.col()]], action);
			});
		}
		cell.attr.trigger_btn = trigger_btn;
		cell.attr.hidden_label = hidden_label;
		
		item.dispatch("on_items_changed", [this, shader_view, name_view, cell, cell_draw, item](stackview) {
			
			//The clip goes with its last entry, but not while it still has entries whose asset is missing (#202)
			if(stackview.items.size() == 0 && stackview.missing.size() == 0)
				item.on_close();
				this.link_shaders_lazy = true;
				return;
			try {
				has_output = item.dispatch("get_default_output") ? true : false;
				if(has_output)
					shader_view.shader(item.dispatch("get_default_output").value());
					name_view.visible(false);
				else
					name_view.visible(true);
				//no picture: what the clip draws itself, if it does (#677)
				if(cell_draw) {
					cell.attr.cell_preview = has_output ? None : item.dispatch("get_cell_preview");
					cell_draw.visible(cell.attr.cell_preview ? true : false);
					shader_view.visible(!cell.attr.cell_preview);
				}
				this.link_shaders_lazy = true;
			}
			catch(e) {}
		});
		
		//#330: clips of a project being loaded start inactive (load_state below turns this off again)
		if(from_state && row >= 0 && col >= 0)
			item.dispatch("start_inactive", true);
		
		try {
			if(!item.dispatch("add_generator", path) && !from_state)
				std.free(item);
				std.free(cell);
				return None;
		}
		catch(e) {
			if(!from_state) {
				std.free(item);
				std.free(cell);
				return None;
			}
		}
		
		this.items[item_guid] = item;
		
		item.on_close = [this, item_guid, cell, row, col]() {
			
			if(this.on_change_callback) {
				this.on_change_callback(None, row, col);
			}
			
			//A clip that goes has to leave the references of its row while its widgets are alive. A
			//[[layer]] keeps the [[link]] to the output of the clip it last showed; when that clip is
			//freed the input is dead and the layer renders black (#574). set_active(false) does not
			//help here: its guard returns right away for the active cell, the one that is closing.
			linked = false;
			if(row >= 0 && row < this.active_cells.size() && this.active_cells[row] == cell) {
				this.active_cells[row] = None;
				linked = true;
			}
			if(row >= 0 && row < this.layer_controls.size()) {
				row_ctrls = this.layer_controls[row];
				if(row_ctrls.transit_b == cell) {
					row_ctrls.transit_b = None;
					//The clip the transition fades in is gone: the transition ends now (the next frame puts the
					//layer back on the running clip and starts a queued one). Running on, it faded the layer to an
					//empty input and showed black until its time was up (#574)
					row_ctrls.transition_time = 0.0;
					linked = true;
				}
				if(row_ctrls.transit_c == cell) {
					row_ctrls.transit_c = None;
					linked = true;
				}
			}
			if(linked)
				this.link_shaders(); //the rows take the pictures that are still there (#574)
			
			if(this.items.has(item_guid)) {
				item = this.items[item_guid];
				std.free(item);
				std.free(cell);
				this.items.erase(item_guid);
			}
		};
		
		//Fix trigger and preview "active" dispatch mess!!! add helper functions to get current row cell, aswell as item from cell etc...
		if(trigger_btn) {
			
			timeline = std.global("timeline");
			//Call with value 2 to indicate that the callback was NOT called from the UI (mouse interaction)
			trigger_btn.callback([this, cell, item, trigger_btn, timeline](v){			
				row = cell.row();			
				t = timeline.cursor_pos.value();
				layer_ctrls = this.layer_controls[row];
				layer_ctrls.last_autoplay_time = t;
				
				if(!v) {
					if(cell.attr.trigger_mode.value() == 1 && layer_ctrls.last_active_cell) {
						layer_ctrls.start_transition(layer_ctrls.last_active_cell, layer_ctrls.last_active_cell.attr.item);						
					}						
					
					return;
				}	
				
				layer_ctrls.start_transition(cell, item);		
			});
		}
		
		//Selects (or deselects) this clip as the preview. The script calls this too (new clip, drop onto a clip): there is
		//no mouse gesture then, so no dragdrop starts here
		cell.attr.select_preview = [this, cell, item, preview_btn](v){
			if(v) {
				if(this.active_preview) {
					this.active_preview.attr.preview_btn.pushed(false);
					cb = this.active_preview.attr.preview_btn.on_change();
					cb(false);				
				}
				
				this.layer_area.content().children_visible(false);
				item.window.visible(true);	
				cell.attr.set_active(true);			
				this.active_preview = cell;
			}
			else {
				item.window.visible(false);
				cell.attr.set_active(false);
				//Only when this clip IS the preview: a layer head made for a new row deselects itself (select_preview(false))
				//and used to clear the preview of another clip, whose name tag then stayed pushed - two tags lit, and the
				//next press on it deselected instead of selecting (#574)
				if(this.active_preview == cell)
					this.active_preview = None;
			}
			
			item.dispatch("clip_preview", preview_btn.pushed());
		};

		//Delete on the name tag that has the focus (#374): see the grid's on_keyboard
		preview_btn.on_keyboard([this, preview_btn](key, scancode, action, mods){
			if(this.delete_key(key, action, mods))
				return true;
			return preview_btn.keyboard_default(key, scancode, action, mods);
		});

		preview_btn.on_change([cell, item, col](v){
			cell.attr.select_preview(v);

			//A layer (column -1, the head of a row) stays where it is: it is not a clip that moves to a cell (#428)
			if(col < 0)
				return;

			//The press on the name tag also starts the move of the clip. Last statement: when the mouse was already
			//released, the screen drops right here, and that drop closes this clip
			cell.begin_dragdrop([cell=cell,item=item]);
		});
		
		//Helper function
		cell.attr.set_active = [this, cell, item, preview_btn](v) {
			row = cell.row();
			if(v || row < 0) {
				cell.outline(false);
				item.dispatch("active", true);
				this.link_shaders();
				if(row >= 0) {
					if(this.active_cells[row] && this.active_cells[row] == cell)
						cell.state("live"); //running: live ring and Live badge
					else if(this.layer_controls[row].transit_b && this.layer_controls[row].transit_b == cell)
						cell.state("fading"); //the clip a transition fades in: dashed live ring
				}
			}
			else {
				if(row >= 0) {
					if(
						(this.active_cells[row] && this.active_cells[row] == cell) || 
						(this.layer_controls[row].transit_b && this.layer_controls[row].transit_b == cell)
					) 
					{
						return; //still running (or fading in): it keeps its Live / fading ring (#574)
					}
				}

				//A clip that is not running loses its ring; the clip queued after a transition keeps its Next ring.
				//Before, the ring went first, also for the running clip that returns above: deselecting it as the
				//preview made a clip that still played look stopped (#574)
				queued = row >= 0 && this.layer_controls[row].transit_c && this.layer_controls[row].transit_c == cell;
				if(!queued)
					cell.outline(false);
				item.dispatch("active", preview_btn.pushed());
			}
		};
		
		cell.attr.select_preview(auto_select_preview);
		
		default_in = item.dispatch("get_default_input");
		if(default_in)
			default_in.visible(false);
		
		if(row >= 0 && col >= 0) {
			settings_area = item.dispatch("get_settings_area", "Clip Settings").content().layout(nanogui.layout_vertical());
			layer_name = settings_area.controltext("layer_name").caption("Name");
			cell.attr.layer_name = layer_name;
		
			//Saved and compared as an index (0 normal, 1 hold), so the item texts can change
			trigger_mode = settings_area.controlcombo("trigger_mode").tooltip("Normal: a click starts the [[clip]]. Hold: it plays while you hold its picture.\n[[wiki:Clipview#clip-settings]]").caption("Trigger").items(["Normal", "Hold"]).segmented(true);
			cell.attr.trigger_mode = trigger_mode;
			
			inputs_vec = settings_area.controlvector("Inputs", "input_settings").content().layout(nanogui.layout_vertical());
			
			//The number means something different in each mode, so both rules are spelled out (#374)
			inputs_vec.label("Relative: −1 layer above · 0 off · +1 layer below").fixed_height(14).font_size(13);
			inputs_vec.label("Absolute: 1 = Layer 1 · 0 off").fixed_height(14).font_size(13);
			
			try {
				item_inputs = item.dispatch("get_inputs");
				
				cell.attr.has_default_input = false;
				
				if(!item_inputs) {
					item_inputs = [input=item.dispatch("get_default_input")];
					if(item_inputs.input)
						cell.attr.has_default_input = true;
					else
						item_inputs = None;
				}
				
				cell.attr.inputs = [];
				
				for(i = 0; i < item_inputs.size(); i++) {
					in_name = item_inputs.key(i);
					
					splitter = inputs_vec.widget().anchor_left(0).anchor_right(0).fixed_height(30);
					
					in_ctrl = splitter.controlint(in_name, "shader_input").anchor(0).anchor_right(164).tooltip("Which [[layer]] feeds this input.\nRelative: the rows away from this layer (-1 = the layer above, +1 = the layer below).\nAbsolute: the number of the layer (1 = Layer 1).\n0 is off in both modes.\n[[wiki:Clipview#inputs-relative--absolute]]");
					//Saved as an index (0 relative, 1 absolute)
					in_type = splitter.controlcombo(in_name+"_type", "shader_input").anchor_top(0).anchor_bottom(0).anchor_right(0).fixed_width(160).items(["Relative","Absolute"]).segmented(true, false).hide_config_menu().tooltip("How the number of this input picks the [[layer]]: Relative counts from the layer of this clip, Absolute names one layer (1 = Layer 1, 0 = off).");
					if(in_name == "input" || in_name == "iChannel0")
						in_ctrl.value(1);
					else
						in_ctrl.value(0);
						cell.attr.item.dispatch("set_input", [name=in_name, value=None]);
						
					cell.attr.inputs.push_back([name=in_name, ctrl=in_ctrl, type=in_type]);
					
					in_ctrl.callback([this](v){
						link_shaders_lazy = true;
					});
					
					in_type.callback([this](v){
						link_shaders_lazy = true;
					});
				}
			}
			catch(e) {}
			
			autoplay_vec = settings_area.controlvector("Autoplay", "autoplay_settings").content().layout(nanogui.layout_vertical());
			
			cell.attr.autoplay_exclude = autoplay_vec.controlbutton("Exclude", "autoplay_exclude").tooltip("[[autoplay|Autoplay]], Previous and Next skip this [[clip]]").push(1);
			//A negative value uses the layer's setting. The transition fades over seconds (1 / fps per frame), the duration counts beats
			cell.attr.duration = autoplay_vec.controlfloat("DurationBeats", "autoplay_duration").tooltip("How long this [[clip]] plays during [[autoplay]], in [[beat|beats]]. Layer: as long as its [[layer]] says.").caption("Duration").unit("beats").value_word(-1, "Layer").value(-1);
			cell.attr.transition = autoplay_vec.controlfloat("Transition", "transition_time").tooltip("The fade time of this [[clip]]. Layer: the [[transition]] of its [[layer]].").unit("s").value_word(-1, "Layer").value(-1);
			
			macro_vec = settings_area.controlvector("Macros", "macros").content().layout(nanogui.layout_vertical());	
			cell.attr.macros = [];
			for(i = 0; i < 8; i++) {
				cell.attr.macros.push_back(macro_vec.controlslider("MACRO " + (i+1)).caption("Macro " + (i+1)));
			}
			
			layer_name.callback([this, cell, item, row, col, name_view](v){
				cell.attr.preview_btn.caption(v);
				cell.attr.hidden_label.caption(v);
				
				name_view.caption(v);
				
				if(this.on_change_callback) {
					this.on_change_callback(item, row, col);
				}
			});
				
			//This causes on_change_callback to be called...
			layer_name.value(cell.attr.preview_btn.caption());
		}
		else(on_change_callback) {
			on_change_callback(item, row, col);
		}
		
		return item;
	}

	//A drag of a clip from a cell of a Clipview (its name tag): [cell=, item=]
	is_clip_payload(payload) {
		return std.is_json(payload) && payload.has("cell") && payload.has("item") ? true : false;
	}

	//What a cell takes (#346): a clip, or an asset (a payload with a path, from the asset browser)
	takes_drop(payload) {
		if(!std.is_json(payload))
			return false;
		if(is_clip_payload(payload))
			return true;
		return payload.has("path") && std.is_string(payload.path) && payload.path != "" ? true : false;
	}

	//A clip dropped on the cell row, col: moved there (copy: copied), or added to the clip in it
	drop_clip(payload, row, col, copy) {
		cell = grid.get_item_at(row, col);
		state = payload.item.save_state();
		node_state = payload.item.node.serialize_json(false);
		path = payload.item.path;
	
		//Onto another clip: every entry of its stack goes onto the stack of that clip, in its order, each with its
		//settings (#374). Taken before a move closes the dragged clip. The clip settings (name, trigger, inputs,
		//autoplay, macros) are those of the clip it lands on
		entries = [];
		if(cell) {
			stack_items = payload.item.dispatch("get_items");
			entry_states = state.data ?? [];
			for(i = 0; i < entry_states.size(); i++) {
				s = entry_states[i];
				clip_entry = [state = s, node = None, button_node = None];
				if(stack_items && s.guid && stack_items.has(s.guid)) {
					clip_entry.node = stack_items[s.guid].node.serialize_json(false);
					clip_entry.button_node = stack_items[s.guid].button_panel.serialize_json();
				}
				entries.push_back(clip_entry);
			}
		}
	
		if(!copy)
			payload.item.on_close();
	
		if(cell) {
			for(i = 0; i < entries.size(); i++)
				cell.attr.item.dispatch("add_entry", entries[i]);
			cell.attr.select_preview(true);
			return;
		}
		item = this.add_generator(path, row, col);
		if(!item)
			return;
		item.load_state(state);
		item.node.deserialize_json(node_state, true);
	}

	//An asset dropped on the cell row, col: a new clip, or one more entry of the clip in it
	drop_asset(path, row, col) {
		cell = grid.get_item_at(row, col);
		if(cell) {
			cell.attr.item.dispatch("add_generator", path);
			cell.attr.select_preview(true);
		}
		else
			this.add_generator(path, row, col);
		this.link_shaders();
	}

	//Delete or Backspace (the delete key of a Mac): the selected clip goes (#374). Not while the grid is locked for
	//playing (Live). True when the key was used
	delete_key(key, action, mods) {
		if(action != 1 || mods != 0 || (key != CLIP_KEY_DELETE && key != CLIP_KEY_BACKSPACE) || livemode.pushed())
			return false;
		cell = active_preview;
		if(!cell || cell.col() < 0)
			return false;
		return delete_clip(cell.row(), cell.col());
	}

	//Deletes the clip in the cell row, col with its whole stack, as one step of the undo history (#374)
	delete_clip(row, col) {
		cell = grid.get_item_at(row, col);
		if(!cell || !cell.attr.item)
			return false;
		this.clip_step("Delete clip", [[view = this, row = row, col = col]], [this, row, col](){
			cell = this.grid.get_item_at(row, col);
			if(cell && cell.attr.item)
				cell.attr.item.on_close();
			this.link_shaders_lazy = true;
		});
		return true;
	}

	//The column of the next clip of the row from col in the direction dir (-1: to the left, 1: to the right), empty
	//cells skipped; -1 when there is none
	next_clip_col(row, col, dir) {
		for(c = col + dir; c >= 0 && c < grid.cols(); c += dir) {
			cell = grid.get_item_at(row, c);
			if(cell && cell.attr.item)
				return c;
		}
		return -1;
	}

	//Swaps the clips of the cells row, col_a and row, col_b, as one step of the undo history named name (the CueList
	//moves a cue up or down this way, #374): each clip is made again in the other cell with its guid, its stack, its
	//settings and its links; the running one keeps running, the selected one stays selected. Not while the grid is
	//locked for playing (Live). True when it swapped
	swap_clips(row, col_a, col_b, name = "Move clip") {
		if(livemode.pushed() || col_a == col_b || col_a < 0 || col_b < 0)
			return false;
		a = grid.get_item_at(row, col_a);
		b = grid.get_item_at(row, col_b);
		if(!a || !a.attr.item || !b || !b.attr.item)
			return false;
		this.clip_step(name, [[view = this, row = row, col = col_a], [view = this, row = row, col = col_b]], [this, row, col_a, col_b](){
			this.swap_cells(row, col_a, col_b);
		});
		return true;
	}

	swap_cells(row, col_a, col_b) {
		clip_a = clip_snapshot(row, col_a);
		clip_b = clip_snapshot(row, col_b);
		if(std.is_none(clip_a) || std.is_none(clip_b))
			return;
		selected = active_preview ? active_preview.attr.item.guid : "";
		//Both go first: each clip is made again with its own guid, which must not be alive any more then
		close_cell(row, col_a);
		close_cell(row, col_b);
		wait_freed();
		make_clip(row, col_a, clip_b);
		make_clip(row, col_b, clip_a);
		cols = [col_a, col_b];
		for(col : cols) {
			cell = grid.get_item_at(row, col);
			if(selected && cell && cell.attr.item && cell.attr.item.guid == selected) {
				cell.attr.preview_btn.pushed(true);
				cell.attr.select_preview(true);
			}
		}
		link_shaders();
	}

	// =========================================================================
	// Undo / redo of clips (#350)
	// =========================================================================
	//A user action on clips is one step: the cells it touches are kept as they were before and as they are after it
	//(clip_snapshot), the history puts them back (generators.shio, apply_clips -> set_cell). A clip is made again with
	//its guid, its stack, its settings and its links.

	//Undo finds this view again by its uid (generators.shio): the Clipviews that are alive
	enlist() {
		if(listed)
			return;
		eng = std.global("engine");
		if(!eng || !eng.env)
			return;
		if(!eng.env.clip_views)
			eng.env.clip_views = [];
		eng.env.clip_views.push_back(this);
		listed = true;
	}

	delist() {
		eng = std.global("engine");
		if(!listed || !eng || !eng.env || !eng.env.clip_views)
			return;
		views = eng.env.clip_views;
		for(i = 0; i < views.size(); i++) {
			if(views[i].uid == uid) {
				views.erase(i);
				break;
			}
		}
		listed = false;
	}

	__deinit__() {
		delist();
	}

	//The Clipview that holds the clip item, None if none does
	clip_view_of(item) {
		views = std.global("engine").env.clip_views;
		if(!views || !item)
			return None;
		for(i = 0; i < views.size(); i++) {
			if(views[i].items.has(item.guid))
				return views[i];
		}
		return None;
	}

	//The clip in a cell as data, None for an empty cell. key: the clip and its entries, to see whether it changed
	clip_snapshot(row, col) {
		cell = grid.get_item_at(row, col);
		if(!cell || !cell.attr.item)
			return None;
		item = cell.attr.item;
		key = item.guid;
		entries = item.dispatch("get_items");
		if(entries) {
			for(i = 0; i < entries.size(); i++)
				key += ":" + std.string(entries.key(i));
		}
		//live: it is the running clip of its row, a clip made again from this runs again (a cue moved while it plays)
		live = row < active_cells.size() && active_cells[row] == cell;
		return [path = item.path, guid = item.guid, state = item.save_state(), node = item.node.serialize_json(true), key = key, live = live];
	}

	clip_key(snapshot) {
		return std.is_none(snapshot) ? "" : snapshot["key"]; //snapshot.key is the method key() of a json
	}

	//Runs a user action on clips as one step of the history. cells: [view, row, col] it may change
	clip_step(name, cells, action) {
		env = std.global("engine").env;
		if(clip_recording || !std.is_function(env.clip_step)) {
			action();
			return;
		}
		before = [];
		for(i = 0; i < cells.size(); i++)
			before.push_back([clip = cells[i].view.clip_snapshot(cells[i].row, cells[i].col)]);
		clip_recording = true;
		try {
			action();
		}
		catch(e) {}
		clip_recording = false;

		changes = [];
		for(i = 0; i < cells.size(); i++) {
			c = cells[i];
			after = c.view.clip_snapshot(c.row, c.col);
			if(clip_key(before[i].clip) != clip_key(after))
				changes.push_back([view = c.view.uid, row = c.row, col = c.col, before = before[i].clip, after = after]);
		}
		if(changes.size() > 0)
			env.clip_step(name, changes);
	}

	//The cell row, col as the data says: the clip in it goes, the one of the data (None: none) is made again
	set_cell(row, col, clip) {
		close_cell(row, col);
		//The clip of the data may still be alive in another cell of this view: a swap of two clips (a cue moved, #374)
		//is put back one cell after the other. It goes too; the change of its cell in the same step makes it again
		if(!std.is_none(clip) && items.has(clip.guid)) {
			other = items[clip.guid];
			if(other.extra_widgets && other.extra_widgets.cell && other.extra_widgets.cell.col() >= 0)
				other.on_close();
		}
		wait_freed();
		make_clip(row, col, clip);
		link_shaders();
	}

	//The clip of the cell row, col goes (nothing when the cell is empty)
	close_cell(row, col) {
		cell = grid.get_item_at(row, col);
		if(cell && cell.attr.item)
			cell.attr.item.on_close();
	}

	//Freed clips go with the next frame: before a clip is made again with the same guid, the old one has to be gone
	wait_freed() {
		for(!grid.screen().garbage_cleared()) {
			std.sleep(0);
		}
	}

	//Makes the clip of the data (clip_snapshot) in the empty cell row, col, with its guid. A clip that was running
	//runs again when nothing else runs in its row
	make_clip(row, col, clip) {
		if(std.is_none(clip))
			return;
		item = add_generator(clip.path, row, col, clip.guid, false);
		if(!item) {
			std.warn("Undo / redo: the clip " + clip.path + " cannot be made again, it is skipped");
			return;
		}
		try {
			item.load_state(clip.state);
			item.node.deserialize_json(clip.node, true);
		}
		catch(e) {}
		cell = grid.get_item_at(row, col);
		if((clip.live ?? false) && cell && row < active_cells.size() && !active_cells[row]) {
			active_cells[row] = cell;
			cell.attr.set_active(true);
		}
	}

	insert_generator(path, row, col) {
		cell = grid.get_item_at(row, col);
		item = None;
		if(cell)
			item = cell.attr.item.dispatch("add_generator", path);
			cell.attr.select_preview(true);
			if(on_change_callback)
				on_change_callback(item, row, col);
		else
			item = this.add_generator(path, row, col);
		
		return item;
	}

	save_state() {
		states = [grid_states=[], rows=grid.rows(), cols=grid.cols(), livemode=livemode.pushed()];
			
		states.cell_size_x = this.grid.cell_size().x;
		states.cell_size_y = this.grid.cell_size().y;
		grid_spacing = this.grid.spacing();
		states.spacing = [x=grid_spacing.x, y=grid_spacing.y];
		
		for(i = 0; i < this.items.size(); i++) {
			item = this.items[i];
			try {
				if(this.items.key(i) == "composition_shader")
					states.grid_states.push_back([row=-1, col=-1, data=item.save_state()]);
				else if(item.extra_widgets.cell.row() < 0)
					states.grid_states.push_back([row=item.extra_widgets.cell.attr.row, col=-1, data=item.save_state()]);
				else
					states.grid_states.push_back([row=item.extra_widgets.cell.row(), col=item.extra_widgets.cell.col(), data=item.save_state()]);
			}
			catch(e) {}
		}
		
		return states;
	}

	//Before this view goes (on_free of the Clipview and the CueList, #361): its generators first. Their shaders call
	//back into the view while they render, so they must be gone before the view is ("class not valid" otherwise)
	free_items() {
		load_in_progress = true; //the render callbacks of the layers do nothing from here on
		delist();

		for(i = 0; i < this.items.size(); i++) {
			try {
				if(this.items[i])
					std.free(this.items[i]);
			}
			catch(e) {}
		}

		this.items.clear();

		//Freed widgets and their shaders only go with the next frame. Not through grid: the widgets of this view
		//can be gone already when its window went first
		screen = std.global("engine").screen;
		for(!screen.garbage_cleared()) {
			std.sleep(0);
		}
	}

	load_state(states) {
		
		load_in_progress = true;
		
		for(i = 0; i < this.items.size(); i++) {
			try {
				if(this.items[i])
					std.free(this.items[i]);
			}
			catch(e) {}
		}
		
		this.items.clear();
		
		// Very special function, this avoids reloading same project GUID's while the current objects may not be destroyed yet
		for(!grid.screen().garbage_cleared()) {
			std.sleep(0);
		}
		
		set_size(0,0);
		
		layer_controls.clear();
		active_cells.clear();
		
		// Very special function, this avoids reloading same project GUID's while the current objects may not be destroyed yet
		for(!grid.screen().garbage_cleared()) {
			std.sleep(0);
		}
		
		add_composition_shader();
		
		set_size(states.rows, states.cols);
		
		managed load_threads = [];
		
		for(i = 0; i < states.grid_states.size(); i++) {
			state = states.grid_states[i];
			thread = std.thread([this, state](){
				try {
					item = None;
					if(state.row == -1 && state.col == -1) //composition shader
						item = composition_shader;
						item.load_state(state.data);
					else if(state.col < 0) //layers
						item = grid.get_header_left_item(state.row).attr.item;
						item.load_state(state.data);
					else
						item = add_generator(asset_resolve(state.data.path, state.data.asset_id ?? ""), state.row, state.col, state.data.guid, false, true); //where the asset is now (#202)
						item.dispatch("no_delete", true);
						item.load_state(state.data);
						item.dispatch("no_delete", false);
					
					if(state.row >= 0 && state.col >= 0)
						item.dispatch("set_active", false);
						item.dispatch("start_inactive", false); //entries added later follow the clip again
				}
				catch(e) {}
			});
			
			load_threads.push_back(thread);
			thread.run();
		}
		
		for(i = 0; i < load_threads.size(); i++) {
			load_threads[i].join();
		}
		
		this.grid.cell_size(vec2f(states.cell_size_x, states.cell_size_y));
		
		if(states.spacing ?? false)
			this.grid.spacing(vec2f(states.spacing.x, states.spacing.y));
		
		reset_active_state = 2; //Reset for 10 frames, hacky but might work
		
		if(states.livemode) {
			livemode.pushed(true);
			cb = livemode.on_change();
			cb(states.livemode);
		}
		
		//Call this again because the render_callback in the stackviews will be overwritten by load_state
		set_size(states.rows, states.cols);
		
		load_in_progress = false;
		link_shaders_lazy = true;
	}

	on_change(cb) {
		on_change_callback = cb;
	}

	load_in_progress = false;
	set_size_in_progress = false;
}