//The links of copied generators among themselves (#348): Alt + drag with Ctrl at the drop and Ctrl+C / Ctrl+V
//(generatorview.shio, singleview.shio). A link from one copied generator to another one copied with it goes from copy
//to copy, with its type and its bend; links to generators that are not copied are not copied. Without a class, so
//_testing/nanogui/copy_links.shio checks it with plain nodes

//The links of a node that go out to or come in from controls of other nodes: "global" of node.serialize_json(true),
//[ctrl1, ctrl2, type, bend], the side in this node relative to it, the other side by its full path. [] without any
//(serialize_json writes None then)
node_links_outside(node) {
	all = node.serialize_json(true);
	global = all["links"]["global"];
	return std.is_json(global) ? global : [];
}

//The full path of a control of an original as the path of that control in its copy; "" when it is in none of them
copied_path(snaps, made, path) {
	if(!std.is_string(path))
		return "";
	for(i = 0; i < snaps.size(); i++) {
		prefix = snaps[i].node_path + "/";
		if(made[i] && made[i].node && path.starts(prefix))
			return made[i].node.get_full_path() + "/" + path.substr(prefix.length());
	}
	return "";
}

//snaps[i]: an original as data, with node_path (its node.get_full_path()) and links (node_links_outside of its node);
//made[i]: its copy, something with a node (a generator), or None when it was not made. Each link is taken once, from
//the side it goes out of
link_copies(snaps, made) {
	for(i = 0; i < snaps.size(); i++) {
		if(!made[i] || !made[i].node)
			continue;
		links = snaps[i].links;
		global = [];
		for(k = 0; k < links.size(); k++) {
			entry = links[k];
			target = copied_path(snaps, made, entry["ctrl2"]);
			if(target == "")
				continue; //into this generator, or to one that is not copied
			link = entry.copy();
			link["ctrl2"] = target;
			global.push_back(link);
		}
		if(global.size() == 0)
			continue;
		state = std.json();
		state["links"] = std.json();
		state["links"]["global"] = global;
		try {
			made[i].node.deserialize_json(state, true);
		}
		catch(e) {}
	}
}
