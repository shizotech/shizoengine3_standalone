//Generators that leave a Patchview for a clip (#348): a cell of a Clipview or a CueList, the entries of a clip (its
//stack), a clip of the timeline or of a loop. They move alive, so their controls, links and MIDI mappings stay. With
//Ctrl at the drop the clips get copies, with the links the copied generators have among themselves (copy_links.shio).
//Without a class: the Clipview (clipview.shio) and the timeline (timeline_clips.shio) use them

#include "copy_links"

//The window keys of a saved generator: an entry of a stack fills its clip, it has no place of its own
GENERATOR_WINDOW_KEYS = ["guid", "x", "y", "w", "h", "fw", "fh", "is_big", "window_state", "collapse_state", "is_collapsed",
	"is_active_internal"];

//The Patchview with the uid (generatorview.uid), None when it is gone. Undo finds a view by it (engine.env.patch_views)
patch_view_by_uid(uid) {
	views = std.global("engine").env.patch_views;
	if(!views)
		return None;
	for(i = 0; i < views.size(); i++) {
		if(views[i].uid == uid)
			return views[i];
	}
	return None;
}

//The Clipview with the uid (clipview.uid), None when it is gone (engine.env.clip_views)
clip_view_by_uid(uid) {
	views = std.global("engine").env.clip_views;
	if(!views)
		return None;
	for(i = 0; i < views.size(); i++) {
		if(views[i].uid == uid)
			return views[i];
	}
	return None;
}

//What a drag out of a Patchview brings (generatorview.start_drag): [view, gens], the generators that are still in that
//view, in the order they were selected. None when there is nothing to drop, and in show mode. The drag is used up
take_dragged_generators() {
	env = std.global("engine").env;
	drag = env.dragged_generators;
	env.dragged_generators = None;
	if(!drag || !drag.view || nanogui.show_mode())
		return None;
	gens = [];
	for(i = 0; i < drag.guids.size(); i++) {
		if(drag.view.items.has(drag.guids[i]))
			gens.push_back(drag.view.items[drag.guids[i]]);
	}
	if(gens.size() == 0)
		return None;
	return [view = drag.view, gens = gens];
}

//A generator of a Patchview before it moves: its guid, the uid of its view and where it was there, so an undo puts it
//back as the window it was (generatorview.take_back)
generator_home(view, gen) {
	w = gen.window;
	return [guid = gen.guid, view = view.uid,
		home = [x = w.x(), y = w.y(), w = w.fixed_width(), h = w.fixed_height(), margin = w.margin()]];
}

//A generator as an entry of a stack (clipstackview.add_entry): its asset, its settings and its controls, without its
//window and its guid. The entry made of it is a copy with a guid of its own
generator_entry(gen) {
	state = gen.save_state();
	for(k : GENERATOR_WINDOW_KEYS)
		state.erase(k);
	return [state = state, node = gen.node.serialize_json(false), button_node = gen.button_panel.serialize_json()];
}

//The last entry of the stack of a clip, None without one
last_entry(clip) {
	entries = clip.dispatch("get_items");
	if(!entries || entries.size() == 0)
		return None;
	return entries[entries.size() - 1];
}

//The generator m (generator_home) leaves its Patchview for the clip: the last entry of its stack. False when it or
//its view is gone
adopt_moved(clip, m) {
	view = patch_view_by_uid(m.view);
	if(!view || !view.items.has(m.guid))
		return false;
	gen = view.forget(m.guid);
	return clip.dispatch("adopt_generator", gen) ? true : false;
}

//The undo of adopt_moved: the entry m.guid leaves the clip for its Patchview, where it was. The caller lets the stack
//link its entries again afterwards (or closes the clip when it has none left). False when it or its view is gone
return_moved(clip, m) {
	view = patch_view_by_uid(m.view);
	if(!view) {
		std.warn("Undo: the Patchview of a moved generator no longer exists, it stays in the clip");
		return false;
	}
	gen = clip.dispatch("release_entry", m.guid);
	if(!gen) {
		std.warn("Undo: a moved generator is no longer in its clip, it is skipped");
		return false;
	}
	view.take_back(gen, m.home);
	gen.set_active(true); //in the clip it ran only while the clip did
	return true;
}
