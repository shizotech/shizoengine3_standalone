
#include "engine/interfaces/aiinterface"

import nanogui;

using eigen;

class generator {
	
	//Store a ptr to the global engine class
	engine = None;
	
	managed window = None;
	managed node = None;
	managed button_panel = None;
	managed module = None; //Is set in the specific loader
	managed extra_widgets = []; //External widgets around the generator that need clearance
	managed ai_interface = None;
	
	path = "";
	guid = "";
	
	//These are two individual states, is_active is enforced by the engine
	is_active_internal = true; 
	active_btn = None;
	
	//Important to set these callbacks when using this class
	on_close = None;
	
	//Extra fields
	big_view_btn = None;
	
	dispatcher = None;
	
	__init__(parent, path, pos, init_guid = "", options_kw=[]) {
		//Check file extension, then use engine/loaders/ext.shio to load the file / folder ?
		//Do normal generators + omnigenerator directly omingen imbennenen in "Patch" "Save patch" und input/output generators
		path = path.replace("\\", "/");
		
		preset = None;
		
		if(fileio.file_ext(path).lowercase() == "preset") {
			preset = fileio.read_json(path);
			
			preset.state.erase("x");
			preset.state.erase("y");
			preset.state.erase("w");
			preset.state.erase("h");
			preset.state.erase("fw");
			preset.state.erase("fh");
			
			//Naive search for parent asset
			start_pos = path.rfind(".") - 1;
			
			end_pos = path.rfind(".", start_pos);
			
			final_pos = path.find("/", end_pos);
			
			path = path.substr(0, final_pos);
			//std.print("PRESET: " + path);
		}
		
		this.path = path;
		
		engine = std.global("engine");
				
		file_ext = fileio.file_ext(path).lowercase();
		
		if(!file_ext) {
			if(fileio.exists(path + "/src/__init__.shio"))
				file_ext = "asset";
			else if(fileio.exists(path + "/src/__init__.glsl"))
				file_ext = "glsl";
			else
				std.error("Asset has no valid extension.");
				return None;
		}
		
		// Every video container shares one loader (engine/generators/extensions/video).
		if([mp4=1, mov=1, m4v=1, mkv=1, webm=1, avi=1, mxf=1, mpg=1, mpeg=1, ts=1, wmv=1].has(file_ext))
			file_ext = "video";
		
		if(!file_ext || !fileio.exists("engine/generators/extensions/" + file_ext)) {
			std.print("No loader for extension: " + file_ext);
			return None;
		}
		
		window = parent.window(" ")
			.position(pos)
			.fixed_size(vec2f(400,300))
			.movable(true)
			.resizable(true);
			
		window.on_keyboard([window](key,scancode,action,mods){
			if(key == 69 && action == 1) //'E' key
			{
				window.header_enabled(!window.header_enabled());
				return true;
			}
			window.keyboard_default(key,scancode,action,mods);
			return false;
		});
			
		if(options_kw.no_header ?? false)
			window.header_enabled(false);
		
		//When initialized with an empty name, the GUID becomes the name of this node (works nicely for dynamic nodes)
		node = window.matrixnode("", init_guid)
			.anchor(0).layout(nanogui.layout_vertical());
		
		node.attr.generator = this;
		
		guid = node.guid();
		
		button_panel = window.button_panel().matrixnode("", guid + "_buttonpanel").anchor(0);
		
		left_top_panel = button_panel.widget().anchor_left(0).anchor_top(0).anchor_bottom(0).layout(nanogui.layout_horizontal());
		
		//TODO: put ACT somewhere else so it is inside the main matrixnode and doesnt need an extra one...
		
		active_btn = left_top_panel.controlbutton("ACT").push(true).anchor_top(0).anchor_bottom(0);
		active_btn.value(true);
		active_btn.no_load_callbacks(true);
		//Power (Shizo UI window header): an icon that turns green while the generator runs, the button itself stays grey.
		//It keeps its link handle (MIDI-mappable) and its ID "ACT", so mappings and projects keep working
		active_btn.get_button().caption("").icon(nanogui.icon("power_off")).latched_style("icon").tooltip("Generator active");
		active_btn.fixed_width(40);
		
		btn_margin = 30;
		
		//Rarely used actions go into the more menu, with plain names
		more_btn = button_panel.button_popup("").icon(nanogui.icon("ellipsis_h")).side("bottom")
			.anchor_top(0)
			.anchor_bottom(0)
			.anchor_right(btn_margin * 3 + 6)
			.fixed_width(25)
			.tooltip("More");
		more_menu = more_btn.popup().content().layout(nanogui.layout_vertical());
		more_menu.fixed_width(200);
		
		copy_preset_btn = more_menu.button("Copy settings").icon(nanogui.icon("copy")).anchor_left(0).anchor_right(0).fixed_height(28);
		copy_preset_btn.on_click([this,engine,more_btn](){
			more_btn.close();
			preset_json = [
				state = this.save_state(false),
				node = this.node.serialize_json(),
				button_node = this.button_panel.serialize_json(),
				path = this.path,
			];
			
			std.global("copy_paste").preset = preset_json;
		});
		
		paste_preset_btn = more_menu.button("Paste settings").icon(nanogui.icon("paste")).anchor_left(0).anchor_right(0).fixed_height(28);
		paste_preset_btn.on_click([this,engine,more_btn](){
			more_btn.close();
			preset_json = std.global("copy_paste").preset;
			if(!preset_json)
				return;
			
			if(preset_json.path != this.path)
				return;
			
			this.load_state(preset_json.state);
			this.node.deserialize_json(preset_json.node);
			this.button_panel.deserialize_json(preset_json.button_node);
		});
		
		//Always draw the links of this generator's controls (and its subnodes), independent of the global link overview.
		//Also for the button panel node, which holds ACT. The flag is saved with each node, the button follows the main node.
		links_btn = button_panel.pushbutton("").icon(nanogui.icon("link"))
			.anchor_top(0)
			.anchor_bottom(0)
			.anchor_right(btn_margin * 4 + 6)
			.fixed_width(25)
			.tooltip("Always draw links");
		links_btn.pushed(node.always_draw_links_own());
		links_btn.on_change([this](pushed){
			this.node.always_draw_links(pushed);
			this.button_panel.always_draw_links(pushed);
		});
		node.on_always_draw_links([links_btn](enabled){
			links_btn.pushed(enabled);
		});
		
		save_preset_btn = more_menu.button("Save preset…").icon(nanogui.icon("save")).anchor_left(0).anchor_right(0).fixed_height(28);
		save_preset_btn.on_click([this, engine, more_btn](){
			more_btn.close();
			form = [
				[id="name",  	label="Preset Name",  	type="text",   	placeholder = "New Preset"],
			];
			
			res = engine.screen.modal_form(form, "Choose preset name", "save", "cancel");		
			if(res.choice != "submit")
				return;
			
			preset_json = [
				state = this.save_state(false),
				node = this.node.serialize_json(),
				button_node = this.button_panel.serialize_json(),
			];
			
			fileio.write_string(this.path + "/presets/" + res.values.name + ".preset", preset_json.compact_string());
		});
			
		reload_btn = more_menu.button("Reload module").icon(nanogui.icon("sync")).anchor_left(0).anchor_right(0).fixed_height(28);
		
		//Same as the E key
		hide_header_btn = more_menu.button("Hide header (E)").icon(nanogui.icon("eye_slash")).anchor_left(0).anchor_right(0).fixed_height(28);
		hide_header_btn.on_click([window, more_btn](){
			more_btn.close();
			window.header_enabled(false);
		});
			
		/*edit_btn = left_top_panel.button("E")
			.anchor_top(0)
			.anchor_bottom(0)
			.fixed_width(25);
		*/
		
		name_lbl = left_top_panel.label(" " + fileio.pure_name(path));
		name_lbl.font_size(16); //title style (design/tokens.json font.title)
		
		big_view_btn = button_panel.pushbutton("").icon(nanogui.icon("window_maximize"))
			.anchor_top(0)
			.anchor_bottom(0)
			.anchor_right(btn_margin * 2)
			.fixed_width(25);
				
		smaller_btn = button_panel.pushbutton("").icon(nanogui.icon("window_minimize"))
			.anchor_top(0)
			.anchor_bottom(0)
			.anchor_right(btn_margin)
			.fixed_width(25);
		smaller_btn.on_change([this, window](pushed){
			
			if(pushed) {
				this._collapse_state = [
					size = window.size(),
					fsize = window.fixed_size(),
				];
				
				old_size = window.size();
				window.size([old_size.x, window.header_height()]);
				window.fixed_size([old_size.x, window.header_height()]);
			}
			else {
				window.size(this._collapse_state.size);
				window.fixed_size(this._collapse_state.fsize);
				window.refresh_size();
				window.refresh_layout();
			}
		});
		
		
		close_btn = button_panel.button("").icon(nanogui.icon("times")).anchor_top(0).anchor_bottom(0).anchor_right(0).fixed_width(25);
		close_btn.on_click([this](){
			release();
		});
		
		big_view_btn.on_change([this, window, parent, smaller_btn, close_btn, big_view_btn, btn_margin](pushed){
			
			if(pushed)
				window.parent().children_visible(false);
				window.visible(true);
			else
				window.parent().children_visible(true);
			
			scroll_area_parent = window.parent().parent();
			
			smaller_btn.visible(pushed == 0);
			close_btn.visible(pushed == 0);
			
			if(pushed)
				big_view_btn.anchor_right(0);
			else
				big_view_btn.anchor_right(btn_margin * 2);
			
			if(pushed) {
				
				this._window_state = [
					scale = scroll_area_parent.scale(),
					pan = [x=scroll_area_parent.pan().x, y=scroll_area_parent.pan().y],
					pos = [x=window.position().x, y=window.position().y],
					wsize = [x=window.size().x, y=window.size().y],
					fsize = [x=window.fixed_size().x, y=window.fixed_size().y],
				];
				
				scroll_area_parent.scale(1.0);
				scroll_area_parent.pan([0,0]);
				scroll_area_parent.lock_controls(true);
				
				window.position([0,0]);
				window.fixed_size(scroll_area_parent.size());
				window.size(scroll_area_parent.size());
				window.movable(false);
				window.resizable(false);
				
				window.on_draw([window, scroll_area_parent]() {
					window.fixed_size(scroll_area_parent.size());
					window.size(scroll_area_parent.size());
				});
				
			}
			else {
				scroll_area_parent.lock_controls(false);
				scroll_area_parent.scale(this._window_state.scale);
				scroll_area_parent.pan(vec2f(this._window_state.pan.x,this._window_state.pan.y));
				
				window.position(vec2f(this._window_state.pos.x,this._window_state.pos.y));
				window.size(vec2f(this._window_state.wsize.x,this._window_state.wsize.y));
				window.fixed_size(vec2f(this._window_state.fsize.x,this._window_state.fsize.y));
				window.movable(true);
				window.resizable(true);
				
				window.on_draw(None);
				window.refresh_layout();
			}
		});
		
		loader = [this, file_ext]() {	

			_was_loaded = false;

			//Reset AI queries...
			ai_interface.clear_queries();

			old_state = None;
			old_node_state = None;
		
			if(this.module) {
				screen = this.node.screen();
				old_state = this.save_state();
				old_node_state = this.node.serialize_json(true); //Serialize all links (even global ones)
				std.free(this.module);
				this.node.clear_children();
				
				// Very special function, this avoids reloading same project GUID's while the current objects may not be destroyed yet
				for(!screen.garbage_cleared()) {
					std.sleep(0);
				}
			}
			
			managed loader_module = std.module();
			loader_module.load_file("engine/generators/extensions/"+file_ext+"/__init__.shio");
			
			if(!loader_module.has("load_extension"))
				std.error("Extension loader has no entry point.");
				return false;		
			try {
				loader_module.call("load_extension", this);
			}
			catch(e) { return false; }
			
			if(loader_module.call_error() || !this.module || !is_loaded())
				return false;
			
			if(this.module.has("dispatcher")) {
				this.dispatcher = this.module.get("dispatcher");
			}
			
			this.active_btn.callback([this](v){
				this.dispatch("active", v);
			});
			
			try {
				if(old_state)
					this.load_state(old_state);
				if(old_node_state)
					this.node.deserialize_json(old_node_state, true);
			}
			catch(e) {}
			
			//For reloads
			if(this.dispatcher)
				this.dispatcher(this, "active", this.active_btn.value());
			//else
			//	std.verbose("Module has no dispatcher.");
			
			ai_interface.register("get_local_controls", [], [this](args){
				control_paths = this.node.get_control_paths(false);
				ctrls = [];
				for(i = 0; i < control_paths.size(); i++) {
					if(control_paths[i].contains("#"))
						continue;
					local_ctrl = this.node.get_control_by_path(control_paths[i]);
					ctrls.push_back([
						path = control_paths[i],
						value = local_ctrl.value(),
						type = std.string(local_ctrl),
						outgoing_links = local_ctrl.link_count(),
						incoming_links = local_ctrl.link_count_incoming(),
					]);
					if(std.string(local_ctrl) == "nanogui.midicontrolcombo")
						ctrls[-1].items = local_ctrl.items();
				}
				
				return ctrls;
			}, "Returns all available controls present in the generator.");
			
			ai_interface.register("get_local_control_attributes", [path="&string(): The path to the control element."], [this](args){
				control_paths = this.node.get_control_paths(false);
				local_ctrl = this.node.get_control_by_path(args.path);
				if(!local_ctrl) {
					return [
						ok = 0,
						error = "Control was not found. Make sure to pass the args correctly.",
					];
				}
				
				ctrls = [];
				for(i = 0; i < control_paths.size(); i++) {
					if(!control_paths[i].starts(args.path) || !control_paths[i].contains("#"))
						continue;
					local_ctrl = this.node.get_control_by_path(control_paths[i]);
					ctrls.push_back([
						path = control_paths[i],
						value = local_ctrl.value(),
						type = std.string(local_ctrl),
					]);
				}		
				return ctrls;			
			}, "Returns the local paths of the attribute controls for a given parent control.");
			
			ai_interface.register("get_local_control", [path="&string(): The path to the control element."], [this](args){
				local_ctrl = this.node.get_control_by_path(args.path);
				if(!local_ctrl) {
					return [
						ok = 0,
						error = "Control was not found. Make sure to pass the args correctly.",
					];
				}
				
				links = local_ctrl.links();
				links_items = [];
				
				in_links = local_ctrl.incoming_links();
				in_links_items = [];
				
				for(i = 0; i < links.size(); i++) {
					links_items.push_back(links[i].path());
				}
				
				for(i = 0; i < in_links.size(); i++) {
					in_links_items.push_back(in_links[i].path());
				}
				
				state = [
					ok=1,
					value = local_ctrl.value(),
					type = std.string(local_ctrl),
					out_links = links_items,
					in_links = in_links_items,
					full_path = local_ctrl.path(),
				];
				
				if(std.string(local_ctrl) == "nanogui.midicontrolcombo")
					state.items = local_ctrl.items();
				
				return state;			
			}, "Returns value, type, links and the full path (for linking) of one control.");
			
			ai_interface.register("set_local_control", [path="&string(): The path to the control element.", value="&any(): Value for this control."], [this](args){
				local_ctrl = this.node.get_control_by_path(args.path);
				if(!local_ctrl) {
					return [
						ok = 0,
						error = "Control was not found. Make sure to pass the args correctly.",
					];
				}
				local_ctrl.value(args.value);
				return [
					ok = 1,
					new_value = local_ctrl.value(),
				];
			}, "Sets the value of one control.");
			
			return true;
		};
		
		//Reload button, same logic...
		reload_btn.on_click([loader, more_btn](){
			more_btn.close();
			loader();
		});
		
		//Before loading but after everything else initalized, register AI interactions...
		ai_interface = AIInterface(this, window, get_relative_path());
		ai_interface.on_get_status([this](){
			status = [
				active=active_btn.value(),
			];
			if(_on_get_status)
				status.module_status = _on_get_status();
			return status;
		});
		
		try {
			if(!loader()) {
				std.free(window);
				return None;
			}
		}
		catch(e) {
			std.free(window);
			return None;
		}
		
		//std.print("---GENERATOR INIT---");
		
		//Dont need to load the state for the preset when loading a project
		if(preset && !engine.load_in_progress) {
			try {
				if(preset.state)
					load_state(preset.state);
				if(preset.node)
					node.deserialize_json(preset.node);
				if(preset.button_node)
					button_panel.deserialize_json(preset.button_node);
			}
			catch(e) {}
		}
		
		//Kind of a hack / ugly code but meh, used in the clipview only (and maybe other generators which use wrapper generators)
		if(options_kw.custom_path ?? false)
			this.path = options_kw.custom_path;
			ai_interface.source_file = get_relative_path();
	}
	
	__deinit__() {
		//std.print("---GENERATOR DEINIT---");
		//std.error(path);
	}
	
	release() {
		if(std.is_function(this.on_close))
			this.on_close();
		else
			std.free(this);
	}
	
	get_live_path() {
		return node.get_full_path();
	}
	
	get_relative_path() {
		return fileio.relative_path_cwd(path);
	}
	
	dispatch(cmd, value = None) {
		if(cmd == "active") {
			is_active_internal = value;
			//Reset update callbacks on state change
			if(is_active()) {
				if(!_pre_callback && _pre_callback_disabled)
					pre_callback(_pre_callback_disabled);
					_pre_callback_disabled = None;
				if(!_post_callback && _post_callback_disabled)
					post_callback(_post_callback_disabled);
					_post_callback_disabled = None;
			}
			else {
				if(_pre_callback)
					_pre_callback_disabled = _pre_callback;
					_pre_callback = None;
				if(_post_callback)
					_post_callback_disabled = _post_callback;
					_post_callback = None;
			}
		}
		if(!dispatcher)
			return None;
		return dispatcher(this, cmd, value);
	}
	
	is_loaded() {
		return _was_loaded;
	}
	
	is_active() {
		return is_active_internal && active_btn.value();
	}
	
	set_active(v) {
		dispatch("active", v);
	}
	
	//cb(generator)
	pre_callback(cb) {
		_pre_callback = cb;
		//Todo: add check if already exists
		engine.generators_pre_callbacks.push_back(this);
	}
	
	post_callback(cb) {
		_post_callback = cb;
		engine.generators_post_callbacks.push_back(this);
	}
	
	save_state(save_window_state=true) {
		state = [];
		
		if(save_window_state) {
			state = [
				path = path,
				guid = guid,
				x = window.x(),
				y = window.y(),
				w = window.width(),
				h = window.height(),
				fw = window.fixed_width(),
				fh = window.fixed_height(),
				is_big = big_view_btn.pushed(),
				is_active = active_btn.value(),
				is_active_internal = is_active_internal,
			];
			
			if(state.is_big) {
				state.window_state = _window_state;
				state.collapse_state = _collapse_state;
			}
		}
		
		try {
			if(module.has("save_state"))
				state.data = module.call("save_state");
		}
		catch(e) {
			
		}
		
		return state;
	}
	
	load_state(state) {
		if(state.has("x"))
			window.position(vec2f(state.x, state.y));
		if(state.has("w"))
			window.size(vec2f(state.w, state.h));
		if(state.has("fw"))
			window.fixed_size(vec2f(state.fw, state.fh));
		
		try {
			if(module.has("load_state"))
				module.call("load_state", state.data);
		}
		catch(e) {}
		
		if(state.is_big) {
			big_view_btn.pushed(true);
			cb = big_view_btn.on_change();
			_window_state = state.window_state;
			_collapse_state = state.collapse_state;
			cb(true);
			_window_state = state.window_state;
			_collapse_state = state.collapse_state;
		}
		
		if(state.has("is_active") && !state.is_active)
			active_btn.value(false); //Only call this when the control is actually not active, this is to avoid reactivating "disabled" generators because active true is the default anyways.
		
		if(state.has("is_active_internal"))
			dispatch("active", state.is_active_internal);
	}
	
	
	//AI Agent specific helper query functions
	//args: typed specs, see engine/interfaces/aiinterface.shio. access: "read" / "write" / None (from the name)
	register(name, args, callback, description = "", access = None) {
		ai_interface.register(name, args, callback, description, access);
	}
	on_get_status(callback) {
		_on_get_status = callback;
	}
	
	//Set by the extension loader to check if it was successfull...
	_was_loaded = false;
	
	_window_state = [];
	_collapse_state = [];
	_pre_callback = None;
	_pre_callback_disabled = None;
	_post_callback = None;
	_post_callback_disabled = None;

	_on_get_status = None;
	
}
