//FFGL plugin as a generator (#428). The generator of a GLSL shader (shader_loader.shio) with a passthrough shader whose
//input is the plugin: the plugin renders in a nanogui ffgl host (shzmodule_nanogui/ffgl_host.cpp). Its parameters become
//controls in the Control tab (section FFGL), its video inputs IN ports there; the first one is the default input, so the
//plugin works in the stack of a clip or the effects of a MapLab output like a shader.

#include "engine/generators/extensions/glsl/shader_loader"

managed ffgl = None;
ffgl_inputs = [];   //the IN controls of the plugin's inputs
ffgl_controls = []; //[index=, ctrl=, kind=]
ffgl_start = 0;

//The control of one parameter, by its type. Its name is the name of the parameter: saved projects and links find it again
ffgl_control(parent, p, used_names) {
	name = p.name;
	if(!name)
		name = "Parameter " + (p.index + 1);
	if(used_names.has(name))
		name = name + " " + (p.index + 1);
	used_names[name] = 1;

	kind = p.type;
	ctrl = None;
	if(kind == "bool") {
		ctrl = parent.controlbutton(name, "ffgl").push(1);
		ctrl.value(p.default >= 0.5 ? 1 : 0);
	}
	else if(kind == "event") {
		ctrl = parent.controlbutton(name, "ffgl").hold(true);
	}
	else if(kind == "option") {
		ctrl = parent.controlcombo(name, "ffgl").items(p.elements);
		for(i = 0; i < p.element_values.size(); i++) {
			if(math.abs(p.element_values[i] - p.default) < 0.0001)
				ctrl.value(i);
		}
	}
	else if(kind == "text" || kind == "file") {
		ctrl = parent.controltext(name, "ffgl").value(p.default_text);
	}
	else if(kind == "buffer") {
		return None; //FFT buffers are not fed yet
	}
	else {
		ctrl = parent.controlslider(name, "ffgl").min(p.min).max(p.max).value(p.default);
		if(kind == "int")
			ctrl.decimals(0);
	}

	if(p.display_name && p.display_name != name)
		ctrl.display_name(p.display_name);

	index = p.index;
	values = p.element_values;
	ctrl.callback([index, kind, values](v){
		if(!ffgl)
			return;
		if(kind == "option") {
			if(v >= 0 && v < values.size())
				ffgl.parameter(index, values[v]);
		}
		else if(kind == "text" || kind == "file")
			ffgl.parameter(index, std.string(v));
		else if(kind == "int")
			ffgl.parameter(index, math.round(v));
		else
			ffgl.parameter(index, v ? std.float(v) : 0.0);
	});
	return ctrl;
}

ffgl_entry(generator, area, plugin_path, passthrough_path) {
	//The input of the passthrough shader is the plugin, it gets no IN control of its own
	hidden_inputs = [ffgl_out = 1];
	entry(generator, area, passthrough_path);

	ffgl = area.ffgl(plugin_path).visible(false);
	ffgl_start = std.millis();

	section = control_area.controlvector("FFGL", "ffgl").expanded(true);
	info = ffgl.info();

	if(ffgl.error()) {
		section.label(ffgl.error()).text_color(vec4f(0.937, 0.416, 0.353, 1.0));
		std.error("FFGL " + plugin_path + ": " + ffgl.error());
		return;
	}

	section.label(info.name + " (" + info.type + ", FFGL " + info.api + ")").tooltip(info.description + (info.about ? "\n" + info.about : ""));

	//Video inputs: an effect has one, a mixer two (or what the plugin says)
	for(i = 0; i < info.max_inputs; i++) {
		in_ctrl = section.control("Input " + (i + 1), "ffgl_inputs").caption("In " + (i + 1));
		index = i;
		in_ctrl.callback([index](v){
			if(ffgl)
				ffgl.input(index, v);
		});
		in_ctrl.on_unlink([in_ctrl, index](ctrl1, ctrl2){
			if(ctrl2 == in_ctrl && ffgl)
				ffgl.input(index, None);
		});
		ffgl_inputs.push_back(in_ctrl);
	}
	if(ffgl_inputs.size() > 0)
		default_input = ffgl_inputs[0];

	params = ffgl.parameters();
	used_names = [];
	groups = [];
	for(i = 0; i < params.size(); i++) {
		p = params[i];
		parent = section;
		if(p.group) {
			if(!groups.has(p.group))
				groups[p.group] = section.controlvector(p.group, "ffgl_groups").content().layout(nanogui.layout_vertical());
			parent = groups[p.group];
		}
		ctrl = ffgl_control(parent, p, used_names);
		if(ctrl)
			ffgl_controls.push_back([index = p.index, ctrl = ctrl, kind = p.type]);
	}

	shaders[0].shader.input("ffgl_out", ffgl);
	ffgl.render_size(shaders[0].shader.render_size());
}

//Every frame: the size of the generator, the time and the beat of the timeline
update(generator, tl_pos, pos_delta) {
	if(!ffgl)
		return;
	size = shaders[0].shader.render_size();
	now = ffgl.render_size();
	if(size.x != now.x || size.y != now.y)
		ffgl.render_size(size);
	ffgl.time((std.millis() - ffgl_start) / 1000.0);
	timeline = std.global("timeline");
	if(timeline)
		ffgl.beat(timeline.bpm_ctrl.value(), math.mod(tl_pos / 4.0, 1.0));
}
