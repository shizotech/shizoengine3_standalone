// Loader for FFGL plugins (#428): .dll (Windows), .bundle (macOS), .so (Linux). generatoritem.shio maps these
// extensions to this loader. The plugin runs in a nanogui ffgl host; the generator around it is the one of a GLSL shader
// (preview, OUT, render size, Spout, NDI, display, video router), see ffgl_loader.shio
load_extension(generator) {
	generator.module = std.module();
	generator.module.load_file(__DIR__ + "/ffgl_loader.shio");

	if(generator.module.has("ffgl_entry"))
		generator.module.call("ffgl_entry", generator, generator.node, generator.path, __DIR__ + "/passthrough.glsl");

	if(generator.module.has("update")) {
		update_fn = generator.module.get("update");
		generator.pre_callback([update_fn](generator, tl_pos, pos_delta){
			update_fn(generator, tl_pos, pos_delta);
		});
	}

	generator._was_loaded = true;
}
