// Loader for native assets (#201): a folder Name.asset with src/__init__.native, whose C ABI plugin declares controls,
// value outputs and a picture (core/shizoscript3_core_cabi/include/shz_abi.h, reg->add_asset). generatoritem.shio
// maps such a folder to this loader. The generator around it is the one of a GLSL shader (preview, OUT, render size,
// Spout, NDI, display, video router), see native_loader.shio
load_extension(generator) {
	generator.module = std.module();
	generator.module.load_file(__DIR__ + "/native_loader.shio");

	generator.module.call("native_entry", generator, generator.node, generator.path, __DIR__ + "/passthrough.glsl");
	if(generator.module.call_error())
		return false;

	if(generator.module.has("update")) {
		update_fn = generator.module.get("update");
		generator.pre_callback([update_fn](generator, tl_pos, pos_delta){
			update_fn(generator, tl_pos, pos_delta);
		});
	}

	generator._was_loaded = true;
	return true;
}
