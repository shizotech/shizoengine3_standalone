//The controls of the //@ annotations of GLSL shaders (shader_loader.shio) and the #@ annotations of Python assets (#853,
//engine/generators/extensions/py): one grammar, one implementation. "//@<type> key=value ..." above a uniform, "#@<type>
//key=value ..." above a module level assignment of a .py script. The types: assets/Shaders/SHADER_GUIDE.MD, 3.2

//The visible name of a shader control, made from its uniform name (#436): "bg_colour" -> "Background colour",
//"timeMultiplier" -> "Time multiplier", "stage5_offset" -> "Stage 5 offset", "BAND_WIDTH" -> "Band width". Only the
//caption: the uniform name stays the ID of the control (links, MIDI mappings and saved projects find it by that), and
//a displayname= of the annotation or a name the user gives the control still wins
SHADER_CAPTION_WORDS = [bg="background", fg="foreground", rot="rotation", freq="frequency", amp="amplitude",
	pos="position", src="source", tgt="target", num="number", anim="animation", dir="direction", mult="multiplier",
	lum="luminance", func="function", hi="high", rgb="RGB", rgba="RGBA", hsv="HSV", uv="UV", vhs="VHS", fft="FFT",
	bpm="BPM", sdf="SDF", led="LED", x="X", y="Y", z="Z", w="W", fps="FPS", interp="interpolation",
	kaleido="kaleidoscope", cols="columns", dist="distance", fov="FOV", aa="anti-aliasing"];
SHADER_CAPTION_WORDS["3d"] = "3D";
SHADER_CAPTION_WORDS["2d"] = "2D";

//The value= of a button / pushbutton annotation as 0 or 1: a number (0 is off, #586) or a word true / false. A Python
//asset writes #@button value=True: std.float("True") is 0, so the word is read first (2026-11-01).
annotation_button_value(text) {
	var t = std.string(text).lowercase();
	if(t == "true" || t == "yes" || t == "on")
		return 1;
	if(t == "false" || t == "no" || t == "off")
		return 0;
	return std.float(t) != 0.0 ? 1 : 0;
}

shader_uniform_caption(name) {
	s = name;
	if(s.starts("u_"))
		s = s.substr(2);
	words = [];
	word = "";
	prev = "";
	for(c : s) {
		is_digit = "0123456789".contains(c);
		is_upper = !is_digit && c != c.lowercase();
		prev_digit = prev != "" && "0123456789".contains(prev);
		prev_lower = prev != "" && !prev_digit && prev != "_" && prev == prev.lowercase();
		if(c == "_" || c == " " || c == "-") {
			if(word != "")
				words.push_back(word);
			word = "";
		}
		else {
			if(word != "" && ((is_upper && (prev_lower || prev_digit)) || (is_digit && !prev_digit)))
				words.push_back(word);
				word = "";
			word += c;
		}
		prev = c;
	}
	if(word != "")
		words.push_back(word);
	if(words.size() == 0)
		return name;
	//Shadertoy style: iMouse -> Mouse
	if(words.size() > 1 && words[0] == "i")
		words.erase(0);
	//A name in capitals only (BAND_WIDTH_FAR) is read as plain words
	shouting = s == s.uppercase();
	out = "";
	for(i, w : words) {
		l = w.lowercase();
		if(SHADER_CAPTION_WORDS.has(l))
			l = SHADER_CAPTION_WORDS[l];
		else if(!shouting && w.size() > 1 && w == w.uppercase() && w != l)
			l = w; //an abbreviation written in capitals stays (RGB, UV)
		else if(i > 0 && l.size() == 1)
			l = l.uppercase(); //colorB -> Color B
		if(i == 0 && l.size() > 0)
			l = l.substr(0, 1).uppercase() + l.substr(1);
		out += (i > 0 ? " " : "") + l;
	}
	return out;
}

//The control of an annotation type in parent, in the group of its controls (the shaders: "uniforms"). Returns
//[ctrl, vec_ctrls, color_selector]: vec_ctrls are the components of a vector or a colour (None for one value), ctrl is
//None for a type this does not make (text, settings: the loaders handle them)
annotation_control(parent, type, name, group) {
	ctrl = None;
	vec_ctrls = None;
	color_selector = None;
	
	if(type == "slider") {
		ctrl = parent.controlslider(name, group);
	}
	else if(type == "int") {
		ctrl = parent.controlint(name, group);
	}
	else if(type == "float") {
		ctrl = parent.controlfloat(name, group);
	}
	else if(type == "button") {
		//A toggle, as SHADER_GUIDE.MD says: without push(1) it was a button that only reports the press, a //@button
		//(Flip Y of DateTime, ...) could be switched on and never off again (#436)
		ctrl = parent.controlbutton(name, group).push(1);
	}
	else if(type == "pushbutton") {
		ctrl = parent.controlbutton(name, group).push(1);
	}
	else if(type == "vec2") {
		ctrl = parent.controlvector(name, group);
		vec_ctrls.push_back(ctrl.controlfloat("X", group));
		vec_ctrls.push_back(ctrl.controlfloat("Y", group));
	}
	else if(type == "vec3") {
		ctrl = parent.controlvector(name, group);
		vec_ctrls.push_back(ctrl.controlfloat("X", group));
		vec_ctrls.push_back(ctrl.controlfloat("Y", group));
		vec_ctrls.push_back(ctrl.controlfloat("Z", group));
	}
	else if(type == "vec4") {
		ctrl = parent.controlvector(name, group);
		vec_ctrls.push_back(ctrl.controlfloat("X", group));
		vec_ctrls.push_back(ctrl.controlfloat("Y", group));
		vec_ctrls.push_back(ctrl.controlfloat("Z", group));
		vec_ctrls.push_back(ctrl.controlfloat("W", group));
	}
	else if(type == "ivec2") {
		ctrl = parent.controlvector(name, group);
		vec_ctrls.push_back(ctrl.controlint("X", group));
		vec_ctrls.push_back(ctrl.controlint("Y", group));
	}
	else if(type == "ivec3") {
		ctrl = parent.controlvector(name, group);
		vec_ctrls.push_back(ctrl.controlint("X", group));
		vec_ctrls.push_back(ctrl.controlint("Y", group));
		vec_ctrls.push_back(ctrl.controlint("Z", group));
	}
	else if(type == "ivec4") {
		ctrl = parent.controlvector(name, group);
		vec_ctrls.push_back(ctrl.controlint("X", group));
		vec_ctrls.push_back(ctrl.controlint("Y", group));
		vec_ctrls.push_back(ctrl.controlint("Z", group));
		vec_ctrls.push_back(ctrl.controlint("W", group));
	}
	else if(type == "slidervec2") {
		ctrl = parent.controlvector(name, group);
		vec_ctrls.push_back(ctrl.controlslider("X", group));
		vec_ctrls.push_back(ctrl.controlslider("Y", group));
	}
	else if(type == "slidervec3") {
		ctrl = parent.controlvector(name, group);
		vec_ctrls.push_back(ctrl.controlslider("X", group));
		vec_ctrls.push_back(ctrl.controlslider("Y", group));
		vec_ctrls.push_back(ctrl.controlslider("Z", group));
	}
	else if(type == "slidervec4") {
		ctrl = parent.controlvector(name, group);
		vec_ctrls.push_back(ctrl.controlslider("X", group));
		vec_ctrls.push_back(ctrl.controlslider("Y", group));
		vec_ctrls.push_back(ctrl.controlslider("Z", group));
		vec_ctrls.push_back(ctrl.controlslider("W", group));
	}
	else if(type == "rgb") {
		ctrl = parent.controlvector(name, group);
		rgb_vec = ctrl.controlvector("RGB");
		color_selector = ctrl.color_selector();
		
		vec_ctrls.push_back(rgb_vec.controlslider("R", group));
		vec_ctrls.push_back(rgb_vec.controlslider("G", group));
		vec_ctrls.push_back(rgb_vec.controlslider("B", group));
		
		r_comp = vec_ctrls[-3];
		g_comp = vec_ctrls[-2];
		b_comp = vec_ctrls[-1];
		
		color_selector.on_color_change([r_comp,g_comp,b_comp](col) {
			r_comp.value(col.x);
			g_comp.value(col.y);
			b_comp.value(col.z);
		});
	}
	else if(type == "rgba") {
		ctrl = parent.controlvector(name, group);
		rgb_vec = ctrl.controlvector("RGBA");
		color_selector = ctrl.color_selector();
		
		vec_ctrls.push_back(rgb_vec.controlslider("R", group));
		vec_ctrls.push_back(rgb_vec.controlslider("G", group));
		vec_ctrls.push_back(rgb_vec.controlslider("B", group));
		vec_ctrls.push_back(rgb_vec.controlslider("A", group));
		
		r_comp = vec_ctrls[-4];
		g_comp = vec_ctrls[-3];
		b_comp = vec_ctrls[-2];
		a_comp = vec_ctrls[-1];
		
		color_selector.on_color_change([r_comp,g_comp,b_comp,a_comp](col) {
			r_comp.value(col.x);
			g_comp.value(col.y);
			b_comp.value(col.z);
			a_comp.value(col.w);
		});
	}
	else if(type == "enum") {
		ctrl = parent.controlcombo(name, group);
	}
	return [ctrl = ctrl, vec_ctrls = vec_ctrls, color_selector = color_selector];
}

//The key=value words of an annotation, from index first on, as [[key, value], ...] (a word without "=" is left out)
annotation_attr_pairs(words, first = 0) {
	pairs = [];
	for(i = first; i < words.size(); i++) {
		word = words[i];
		if(word.find("=") < 0)
			continue;
		key_value = word.smart_split("=");
		pairs.push_back([key_value[0], key_value.size() > 1 ? key_value[1] : ""]);
	}
	return pairs;
}

//A value in quotes without them ("Speed" -> Speed); anything else as it is
annotation_unquote(text) {
	t = std.string(text);
	if(t.size() >= 2 && (t.starts("\"") || t.starts("'")) && t.ends(t.substr(0, 1)))
		return t.substr(1, t.size() - 2);
	return t;
}

//Applies the attributes [[key, value], ...] of an annotation to its control, in their order: options=(a, b) the items
//of an enum, displayname="..." its name, value=2 of an enum the index, (x, y, ...) of a vector one value per
//component, any other key the method of that name with the value (min, max, value, decimals, unit, tooltip, ...)
annotation_apply_attrs(ctrl, type, attrs, vec_ctrls) {
	for(key_value : attrs) {
		try {
			if(key_value[0] == "options") {
				ctrl.items(key_value[1].extract("(",")").smart_split(",", -1, true));
			}
			else if(key_value[0] == "displayname") {
				ctrl.display_name(key_value[1].extract("\"","\""));
			}
			else if(key_value[0] == "value" && type == "enum" && "0123456789".contains(key_value[1].substr(0, 1))) {
				//value=2 is the index of the option: a string would be looked up as the text of an option (#436)
				ctrl.value(std.int(key_value[1]));
			}
			else if(key_value[0] == "value" && (type == "button" || type == "pushbutton")) {
				//value=0 is off: the text "0" set as it is switched the button on (#586)
				ctrl.value(annotation_button_value(key_value[1]));
			}
			else if(vec_ctrls) {
				vec_values = key_value[1].extract("(",")").split(",", -1, true);
				for(j = 0; j < math.min(vec_values.size(), vec_ctrls.size()); j++) {
					c = vec_ctrls[j];
					c[key_value[0]](vec_values[j]);
				}
			}
			else {
				ctrl[key_value[0]](annotation_unquote(key_value[1]));
			}
		}
		catch(e) {}
	}
}
