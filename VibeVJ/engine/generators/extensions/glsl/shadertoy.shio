//What a Shadertoy shader (one with mainImage) gets around its source: the uniforms of Shadertoy and a main() that calls
//mainImage. Used by shader_loader.shio and by the preview of the Assets tab (src/menu/assetbrowser/shader_preview.shio)

shadertoy_header = R"(
/*---INJECTED HEADER CODE---*/
precision highp float; uniform vec3 iResolution;  uniform float iTime;  uniform float iTimeDelta;  uniform int iFrame; 
//@slidervec4
uniform vec4 iMouse;
uniform vec4 iDate; uniform float iSampleRate; uniform sampler2D iChannel0; uniform sampler2D iChannel1; uniform sampler2D iChannel2; uniform sampler2D iChannel3; uniform int RenderMaskActive; uniform sampler2D RenderMaskInput;
/*---*/
)";

shadertoy_main = "/*---INJECTED MAIN FUNCTION---*/\nvoid main(){ vec4 new_color = vec4(0,0,0,0); vec2 n_coord = v_uv*iResolution.xy; if(RenderMaskActive == 1) { vec4 mask_color = texture(RenderMaskInput, v_uv); if(mask_color.rgb == vec3(0.0)) { fragColor = new_color; return; }} mainImage( new_color, n_coord ); fragColor = new_color;}\n/*---*/\n";

//#586: a point pass (//@settings draw=points or draw=quads, SHADER_GUIDE.MD *Point passes*). The loader compiles the
//pass twice: as the vertex shader of a point draw (nanogui.shader points(n)), which calls
//mainPoint(id, position, size, color, data) once a point, and as the fragment shader that colours the point:
//pointPixel(color, data, coord) when the pass has one, else a round soft dot. The Shadertoy header is in both, so
//uniforms, controls and inputs work in both. size is in pixels; a GL point smaller than a pixel is drawn one pixel big
//and fainter; a point with the colour 0 is not drawn. draw=quads (SHZ_QUADS) draws each point as two triangles
//(nanogui.shader point_quads): 6 vertices a point, no size limit, the corners placed here.
points_vertex_header = "#define SHZ_VERTEX 1\nout vec4 v_point_color;\nout vec4 v_point_data;\nout vec2 v_point_coord;\n";
points_vertex_main = R"(
/*---INJECTED POINT MAIN---*/
void main() {
#ifdef SHZ_QUADS
	int shz_id = gl_VertexID / 6;
	int shz_corner = gl_VertexID - shz_id * 6;
#else
	int shz_id = gl_VertexID;
#endif
	vec4 shz_position = vec4(2.0, 2.0, 2.0, 1.0);
	float shz_size = 1.0;
	vec4 shz_color = vec4(1.0);
	vec4 shz_data = vec4(0.0);
	mainPoint(shz_id, shz_position, shz_size, shz_color, shz_data);
#ifdef SHZ_QUADS
	vec2 shz_c = vec2(shz_corner == 1 || shz_corner == 4 || shz_corner == 5 ? 1.0 : 0.0, shz_corner == 2 || shz_corner == 3 || shz_corner == 5 ? 1.0 : 0.0);
	if (shz_size <= 0.0 || shz_color == vec4(0.0)) shz_position = vec4(2.0, 2.0, 2.0, 1.0);
	else shz_position.xy += (shz_c * 2.0 - 1.0) * (0.5 * shz_size) / iResolution.xy * 2.0 * shz_position.w;
	v_point_coord = vec2(shz_c.x, 1.0 - shz_c.y);
#else
	if (shz_size < 1.0) { shz_color *= max(shz_size, 0.0); shz_size = 1.0; }
	if (shz_color == vec4(0.0)) shz_position = vec4(2.0, 2.0, 2.0, 1.0);
	gl_PointSize = shz_size;
	v_point_coord = vec2(0.5);
#endif
	gl_Position = shz_position;
	v_point_color = shz_color;
	v_point_data = shz_data;
	v_uv = shz_position.xy / max(abs(shz_position.w), 1e-6) * 0.5 + 0.5;
}
/*---*/
)";
points_fragment_header = "#define SHZ_FRAGMENT 1\nin vec4 v_point_color;\nin vec4 v_point_data;\nin vec2 v_point_coord;\n";
points_fragment_main = R"(
/*---INJECTED POINT MAIN---*/
void main() {
#ifdef SHZ_QUADS
	vec2 shz_d = v_point_coord * 2.0 - 1.0;
#else
	vec2 shz_d = gl_PointCoord * 2.0 - 1.0;
#endif
	fragColor = v_point_color * (1.0 - smoothstep(0.5, 1.0, dot(shz_d, shz_d)));
}
/*---*/
)";
points_fragment_main_custom = R"(
/*---INJECTED POINT MAIN---*/
void main() {
#ifdef SHZ_QUADS
	fragColor = pointPixel(v_point_color, v_point_data, v_point_coord);
#else
	fragColor = pointPixel(v_point_color, v_point_data, gl_PointCoord);
#endif
}
/*---*/
)";
