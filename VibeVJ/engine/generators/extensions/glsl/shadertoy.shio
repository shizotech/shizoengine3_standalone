//What a Shadertoy shader (one with mainImage) gets around its source: the uniforms of Shadertoy and a main() that calls
//mainImage. Used by shader_loader.shio and by the preview of the Assets tab (src/menu/assetbrowser/shader_preview.shio)

shadertoy_header = R"(
/*---INJECTED HEADER CODE---*/
precision highp float; uniform vec3 iResolution;  uniform float iTime;  uniform float iTimeDelta;  uniform int iFrame; 
//@slidervec4
uniform vec4 iMouse;
uniform vec4 iDate; uniform float iSampleRate; uniform sampler2D iChannel0; uniform sampler2D iChannel1; uniform sampler2D iChannel2; uniform sampler2D iChannel3; uniform int RenderMaskActive; uniform sampler2D RenderMaskInput;
/*---*/
)";

shadertoy_main = "/*---INJECTED MAIN FUNCTION---*/\nvoid main(){ vec4 new_color = vec4(0,0,0,0); vec2 n_coord = v_uv*iResolution.xy; if(RenderMaskActive == 1) { vec4 mask_color = texture(RenderMaskInput, v_uv); if(mask_color.rgb == vec3(0.0)) { fragColor = new_color; return; }} mainImage( new_color, n_coord ); fragColor = new_color;}\n/*---*/\n";
