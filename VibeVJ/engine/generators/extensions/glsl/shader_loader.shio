
#include "engine/interfaces/videorouter"

import nanogui;
import subprocess;

using eigen;

managed shaders = []; //fmt: [{shader=shader, has_fixed_size=bool, has_fixed_comp_fmt=bool, has_fixed_pixel_fmt=bool}]
managed monitor_screen = None;
managed video_router = None;

uniforms = [];
inputs = [];
is_shadertoy = false;

size_x = None;
size_y = None;

default_input = None;
default_output = None;

render_callback = None;

shadertoy_header = R"(
/*---AUTOMATICALLY INJECTED HEADER CODE (NOT DIRECTLY PART OF THE SHADER ITSELF)---*/
precision highp float; uniform vec3 iResolution;  uniform float iTime;  uniform float iTimeDelta;  uniform int iFrame; 
//@slidervec4
uniform vec4 iMouse;
uniform vec4 iDate; uniform float iSampleRate; uniform sampler2D iChannel0; uniform sampler2D iChannel1; uniform sampler2D iChannel2; uniform sampler2D iChannel3; uniform int RenderMaskActive; uniform sampler2D RenderMaskInput;
/*---*/
)";

shadertoy_main = "/*AUTOMATICALLY INJECTED MAIN FUNCTION (NOT DIRECTLY PART OF THE SHADER ITSELF)*/ void main(){ vec4 new_color = vec4(0,0,0,0); vec2 n_coord = v_uv*iResolution.xy; if(RenderMaskActive == 1) { vec4 mask_color = texture(RenderMaskInput, v_uv); if(mask_color.rgb == vec3(0.0)) { fragColor = new_color; return; }} mainImage( new_color, n_coord ); fragColor = new_color;} /*---*/";

find_shader(name) {
	for(i = 0; i < shaders.size(); i++) {
		if(shaders[i].name == name)
			return shaders[i].shader;
	}
	return None;
}

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return None;
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.rendering_enabled(value);
		}
	}
	
	if(cmd == "get_inputs")
		return inputs;
	
	if(cmd == "get_default_input")
		return default_input;
	
	if(cmd == "get_default_output")
		return default_output;
	
	if(cmd == "set_render_callback")
		render_callback = value;
	
	if(cmd == "set_uniform") {
		if(!uniforms.has(value.name)) {
			for(i = 0; i < shaders.size(); i++) {
				if(!shaders[i].shader.has_uniform(value.name))
					continue;
				shaders[i].shader.uniform(value.name, value.value);
			}
			
			return true;
		}
		
		uni = uniforms[value.name];
		for(i = 0; i < uni.size(); i++)
			uni[i].uniform(value.name, value.value);
			
		return true;
	}
	
	if(cmd == "set_input") {
		if(!inputs.has(value.name))
			return false;
		ins = inputs[value.name];
		for(i = 0; i < ins.size(); i++)
			ins[i].input(value.name, value.value);
		return true;
	}
	
	return None;
}

entry(generator, area, shader_dir) {
	
	shader_paths = [];
	
	if(fileio.is_directory(shader_dir)) {
		files = fileio.files(shader_dir, false).filter_value(".glsl");
		
		//First, try to find entry point
		for(i = 0; i < files.size(); i++) {
			if(files[i] == "__init__.glsl")
				shader_paths = [shader_dir + "/" + files[i]];
				files.erase(i);
				break;
		}
		
		if(!shader_paths)
			std.error("No __init__.glsl entry point found!");
			return;

		//init glsl always has to be the FIRST shader, now we can add the rest...
		for(i = 0; i < files.size(); i++) {
			shader_paths.push_back(shader_dir + "/" + files[i]);
		}
	}
	else
		shader_paths = [shader_dir]; //Only a single glsl file...
	
	area.layout(None);
	
	control_tabs = area.tabwidget().anchor_left(0).anchor_top(0).anchor_bottom(25).fixed_width(250);
	
	ctrls_tab = control_tabs.add_tab("Control").anchor(0).vscroll().anchor(0).content().layout(nanogui.layout_vertical());
	settings_tab = control_tabs.add_tab("Settings").anchor(0).vscroll().anchor(0).content().layout(nanogui.layout_vertical());
	transform_tab = control_tabs.add_tab("Transform").anchor(0).vscroll().anchor(0).content().layout(nanogui.layout_vertical());
	
	io_panel = area.widget().anchor_bottom(0).anchor_left(0).anchor_right(0).fixed_height(25);
	in_panel = io_panel.widget().anchor(0).anchor_right(70);
	
	shader_widget = None;
	shader_tabs = [];
	
	if(shader_paths.size() > 1) {
		shader_widget = area.tabwidget();
		shader_widget.anchor_left(250).anchor_top(0).anchor_bottom(25).anchor_right(0);
		for(i = 0; i < shader_paths.size(); i++) {
			name = fileio.pure_name(shader_paths[i]);
			if(name == "__init__")
				name = "MAIN";
			shader_tabs.push_back(shader_widget.add_tab(name));
		}
	}
	else {
		shader_widget = area.widget();
		shader_widget.anchor_left(250).anchor_top(0).anchor_bottom(25).anchor_right(0);
	}
	
	//Time controls
	time_vec = ctrls_tab.controlvector("Time", "ctrls").expanded(false);
	time_type_ctrl = time_vec.controlcombo("Sync", "timectrls").items(["Freetime", "Manual", "Sync"]);
	time_ctrl = time_vec.controlfloat("Time", "timectrls");
	time_offs_ctrl = time_vec.controlfloat("Offset", "timectrls");
	time_mult_ctrl = time_vec.controlslider("Multiplier", "timectrls").min(-2).max(2).value(1);
	
	//Uniforms
	uniform_vec = ctrls_tab.controlvector("Controls", "uniforms").expanded(false);
	
	//Input controls
	input_vec = ctrls_tab.controlvector("Inputs", "ctrls").expanded(false);	
	
	//Output controls
	output_vec = ctrls_tab.controlvector("Outputs", "ctrls").expanded(false);	
	
	monitor_vec = output_vec.controlvector("Monitor", "output_ctrls_monitor").expanded(false);
	monitor_type = monitor_vec.controlcombo("monitor_type", "output_ctrls_monitor").items(["FULLSCREEN", "WINDOWED"]);
	monitor_select = monitor_vec.controlcombo("monitor_select", "output_ctrls_monitor");
	monitor_select.on_open([monitor_select](){
		ctx = nanogui.current_context();
		items = ["No Monitor"];
		for(i = 0; i < ctx.monitor_count(); i++) {
			items.push_back("Monitor " + (i+1));
		}
		monitor_select.items(items);
	});
	
	mon_cb = monitor_select.on_open();
	mon_cb();
	
	videorouter_vec = output_vec.controlvector("VideoRouter", "output_ctrls_router").expanded(false);
	videorouter_enable = videorouter_vec.controlbutton("Enable Router", "router").push(1);
	videorouter_name = videorouter_vec.controltext("VideoRouterName", "router").hide_config_menu();
	
	videorouter_enable.callback([videorouter_name](v){
		if(v)
			video_router = VideoRouter(videorouter_name.value(), default_output);
		else
			video_router = None;
	});
	
	videorouter_name.callback([videorouter_name](v){
		if(video_router)
			video_router.name = v;
	});
	
	spout_vec = output_vec.controlvector("SPOUT", "output_ctrls_spout").expanded(false);
	spout_enable = spout_vec.controlbutton("Enable SPOUT", "spout").push(1);
	spout_name = spout_vec.controltext("SpoutName", "spout").hide_config_menu();
	
	monitor_select.callback([spout_enable, monitor_type](index) {
		
		if(monitor_screen)
			std.free(monitor_screen);
		
		//None
		if(index == 0) 
			return;
		
		index = index-1; //To get monitor id
		
		ctx = nanogui.current_context();
		mon_info = ctx.monitor_info(index);
		
		if(mon_info)
			size_x.value(mon_info.width);
			size_y.value(mon_info.height);
	
		monitor_screen = ctx.fullscreen(index, "shizoengine_output", !monitor_type.value());
		monitor_screen.decorated(0);

		shadertoy_header_screen = "uniform sampler2D in_texture;";
		shadertoy_main_screen = "void main(){ fragColor = texture(in_texture, v_uv); }";
		shader = monitor_screen.shader();
		shader.anchor(0);
		shader.render_size(eigen.vec2i(monitor_screen.width(), monitor_screen.height()));
		shader.fragment_source(shadertoy_header_screen + shadertoy_main_screen);
		shader.input("in_texture", shaders[0].shader);
		
	});
	
	spout_enable.callback([spout_name, monitor_select](v){
		shaders[0].shader.spout_sender_name(spout_name.value());
		shaders[0].shader.spout_enabled(v);
	});
	
	spout_name.callback([monitor_select](v) {
		if(monitor_select.value() == 0)
			shaders[0].shader.spout_sender_name(v);
	});
	
	//Settings
	size_vec = settings_tab.controlvector("Render", "settings");
	render_size_linked = size_vec.controlbutton("Linked to parent").push(1).value(1);
	render_downscale = size_vec.controlfloat("Renderscale").value(1);
	size_vec = settings_tab.controlvector("Size", "settings");
	//Instead of this, just change the size automatically if the generator has the same dims as the project had before
	//size_mode = size_vec.controlcombo("sizemode", "settings").items(["Use project size", "Use custom size"]);
	size_x = size_vec.controlint("Width", "settings").value(generator.engine.project_width.value());
	size_y = size_vec.controlint("Height", "settings").value(generator.engine.project_height.value());
	
	size_cb = [size_x, size_y, render_downscale](v) {
		for(i = 0; i < shaders.size(); i++) {
			if(!shaders[i].has_fixed_size)
				shaders[i].shader.render_size(vec2i(size_x.value() * render_downscale.value(), size_y.value() * render_downscale.value()));
		}
	};
	
	size_x.callback(size_cb);
	size_y.callback(size_cb);
	
	fmt_vec = settings_tab.controlvector("Format", "settings").expanded(false);;
	
	comp_types = ["uint8", "int8", "uint16", "int16", "uint32", "int32", "uint64", "int64", "float16", "float32", "float64"];
	pixel_types = ["r", "ra", "rgb", "rgba", "bgr", "bgra", "depth", "depthstencil"];
	
	comp_fmt = fmt_vec.controlcombo("Component Fmt", "settings").items(
		comp_types
	).value(0);
	
	pixel_fmt = fmt_vec.controlcombo("Pixel Fmt", "settings").items(
		pixel_types
	).value(3);
	
	comp_fmt.callback([comp_types](v){
		for(i = 0; i < shaders.size(); i++) {
			if(!shaders[i].has_fixed_comp_fmt)
				shaders[i].shader.output_component_format(comp_types[v]);
		}
	});
	
	pixel_fmt.callback([pixel_types](v){
		for(i = 0; i < shaders.size(); i++) {
			if(!shaders[i].has_fixed_pixel_fmt)
				shaders[i].shader.output_pixel_format(pixel_types[v]);
		}
	});
	
	mask_vec = settings_tab.controlvector("Mask", "settings").expanded(false);
	rendermask_active = mask_vec.controlbutton("Rendermask", "settings").push(true);
	
	rendermask_active.callback([](v) {
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.uniform("RenderMaskActive", v);
		}
	});
	
	//Transform controls
	
	transform_vec = transform_tab.controlvector("Transform").expanded(true);
	clip_uv = transform_vec.controlbutton("Clip UV").push(1);
	translate_x = transform_vec.controlfloat("X");
	translate_y = transform_vec.controlfloat("Y");
	rotate = transform_vec.controlslider("Rotate").min(0).max(360);
	zoom = transform_vec.controlslider("Zoom").value(1.0);
	flip_x = transform_vec.controlbutton("Flip X").push(1).fixed_height(25);
	flip_y = transform_vec.controlbutton("Flip Y").push(1).fixed_height(25);
	

	translate_x.callback([translate_x, translate_y](v) {
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.translate(vec2f(translate_x.value(), translate_y.value()));
		}
	});
	
	translate_y.callback(translate_x.callback());
	
	rotate.callback([rotate](v) {
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.rotation(v);
		}
	});
	
	zoom.callback([zoom](v) {
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.zoom(v);
		}
	});
	
	clip_uv.callback([](v){
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.clip_uv(v);
		}
	});
	
	flip_x.callback([](v){
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.flip_uv_x(v);
		}
	});
	
	flip_y.callback([](v){
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.flip_uv_y(v);
		}
	});
	
	projection_vec = transform_tab.controlvector("Projection Mapping").content().layout(nanogui.layout_vertical());
	
	projection_btn = projection_vec.pushbutton("Edit Grid");
	projection_subdivide = projection_vec.button("Subdivide");
	
	projection_grid_vec = projection_vec.controlvector("Grid", "mapping").expanded(false);	
	projection_grid_x = projection_grid_vec.controlint("X", "mapping").value(1);
	projection_grid_y = projection_grid_vec.controlint("Y", "mapping").value(1);
	
	projection_grid_fine_vec = projection_vec.controlvector("Fine", "mapping").expanded(false);	
	projection_grid_fine_x = projection_grid_fine_vec.controlint("X", "mapping").value(4);
	projection_grid_fine_y = projection_grid_fine_vec.controlint("Y", "mapping").value(4);
	
	projection_reset = projection_vec.button("Reset");
	
	set_projection_grid_cb = [projection_btn](v) {
		if(!projection_btn.pushed()) //Only set when its actually activated once, "lazy" set
			return;
		
		for(i = 0; i < shaders.size(); i++)
			shaders[i].need_projection_update = true;
	};
	
	projection_btn.on_change([set_projection_grid_cb](v) {
		for(i = 0; i < shaders.size(); i++)
			shaders[i].shader.projection_enabled(v);
		
		if(v)
			set_projection_grid_cb(0); //Only set these if projection mapping is actually needed...
	});
	
	projection_subdivide.on_click([projection_btn, projection_grid_x, projection_grid_y]() {
		
		if(!projection_btn.pushed()) //Only set when its actually activated once, "lazy" set
			return;
		
		for(i = 0; i < shaders.size(); i++)
			shaders[i].shader.projection_subdivide();
		projection_grid_x.value(projection_grid_x.value() * 2, false, false);
		projection_grid_y.value(projection_grid_y.value() * 2, false, false);
	});
	
	projection_reset.on_click([projection_grid_x, projection_grid_y]() {
		for(i = 0; i < shaders.size(); i++)
			shaders[i].shader.projection_reset();
	});
	
	projection_grid_x.callback(set_projection_grid_cb);
	projection_grid_y.callback(set_projection_grid_cb);
	projection_grid_fine_x.callback(set_projection_grid_cb);
	projection_grid_fine_y.callback(set_projection_grid_cb);
	
	//Scan uniform definitions in src..
	parse_uniform = [ctrls_tab, uniform_vec](shader_index, name, str) {

		shader = shaders[shader_index].shader;

		if(!shader.has_uniform(name))
			std.warn("Uniform doesnt exist in shader: ", name);
			return;
		
		if(uniforms.has(name)) {
			uniforms[name].push_back(shader);
			return;
		}
		
		ctrl = None;
		
		attributes = str.smart_split(" ");
		
		vec_ctrls = None;
		color_selector = None;
		
		if(attributes[0] == "slider") {
			ctrl = uniform_vec.controlslider(name, "uniforms");
		}
		else if(attributes[0] == "int") {
			ctrl = uniform_vec.controlint(name, "uniforms");
		}
		else if(attributes[0] == "float") {
			ctrl = uniform_vec.controlfloat(name, "uniforms");
		}
		else if(attributes[0] == "button") {
			ctrl = uniform_vec.controlbutton(name, "uniforms");
		}
		else if(attributes[0] == "pushbutton") {
			ctrl = uniform_vec.controlbutton(name, "uniforms").push(1);
		}
		else if(attributes[0] == "vec2") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlfloat("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlfloat("Y", "uniforms"));
		}
		else if(attributes[0] == "vec3") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlfloat("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlfloat("Y", "uniforms"));
			vec_ctrls.push_back(ctrl.controlfloat("Z", "uniforms"));
		}
		else if(attributes[0] == "vec4") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlfloat("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlfloat("Y", "uniforms"));
			vec_ctrls.push_back(ctrl.controlfloat("Z", "uniforms"));
			vec_ctrls.push_back(ctrl.controlfloat("W", "uniforms"));
		}
		else if(attributes[0] == "ivec2") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlint("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlint("Y", "uniforms"));
		}
		else if(attributes[0] == "ivec3") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlint("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlint("Y", "uniforms"));
			vec_ctrls.push_back(ctrl.controlint("Z", "uniforms"));
		}
		else if(attributes[0] == "ivec4") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlint("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlint("Y", "uniforms"));
			vec_ctrls.push_back(ctrl.controlint("Z", "uniforms"));
			vec_ctrls.push_back(ctrl.controlint("W", "uniforms"));
		}
		else if(attributes[0] == "slidervec2") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlslider("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlslider("Y", "uniforms"));
		}
		else if(attributes[0] == "slidervec3") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlslider("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlslider("Y", "uniforms"));
			vec_ctrls.push_back(ctrl.controlslider("Z", "uniforms"));
		}
		else if(attributes[0] == "slidervec4") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlslider("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlslider("Y", "uniforms"));
			vec_ctrls.push_back(ctrl.controlslider("Z", "uniforms"));
			vec_ctrls.push_back(ctrl.controlslider("W", "uniforms"));
		}
		else if(attributes[0] == "rgb") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			rgb_vec = ctrl.controlvector("RGB");
			color_selector = ctrl.color_selector();
			
			vec_ctrls.push_back(rgb_vec.controlslider("R", "uniforms"));
			vec_ctrls.push_back(rgb_vec.controlslider("G", "uniforms"));
			vec_ctrls.push_back(rgb_vec.controlslider("B", "uniforms"));
			
			r_comp = vec_ctrls[-3];
			g_comp = vec_ctrls[-2];
			b_comp = vec_ctrls[-1];
			
			color_selector.on_color_change([r_comp,g_comp,b_comp](col) {
				r_comp.value(col.x);
				g_comp.value(col.y);
				b_comp.value(col.z);
			});
		}
		else if(attributes[0] == "rgba") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			rgb_vec = ctrl.controlvector("RGBA");
			color_selector = ctrl.color_selector();
			
			vec_ctrls.push_back(rgb_vec.controlslider("R", "uniforms"));
			vec_ctrls.push_back(rgb_vec.controlslider("G", "uniforms"));
			vec_ctrls.push_back(rgb_vec.controlslider("B", "uniforms"));
			vec_ctrls.push_back(rgb_vec.controlslider("A", "uniforms"));
			
			r_comp = vec_ctrls[-4];
			g_comp = vec_ctrls[-3];
			b_comp = vec_ctrls[-2];
			a_comp = vec_ctrls[-1];
			
			color_selector.on_color_change([r_comp,g_comp,b_comp,a_comp](col) {
				r_comp.value(col.x);
				g_comp.value(col.y);
				b_comp.value(col.z);
				a_comp.value(col.w);
			});
		}
		else if(attributes[0] == "enum") {
			ctrl = uniform_vec.controlcombo(name, "uniforms");
		}
		
		if(ctrl) {
			for(i = 1; i < attributes.size(); i++) {
				attr = &attributes[i];
				if(attr.find("=") >= 0) {
					key_value = attr.smart_split("=");
					try {
						if(key_value[0] == "options") {
							ctrl.items(key_value[1].extract("(",")").smart_split(","));
						}
						else if(key_value[0] == "displayname") {
							ctrl.display_name(key_value[1].extract("\"","\""));
						}
						else if(vec_ctrls) {
							vec_values = key_value[1].extract("(",")").split(",", -1, true);
							for(j = 0; j < math.min(vec_values.size(), vec_values.size()); j++) {
								c = vec_ctrls[j];
								c[key_value[0]](vec_values[j]);
							}
						}
						else {
							ctrl[key_value[0]](key_value[1]);
						}
					}
					catch(e) {}
				}
			}
			
			//This is extremely inefficient, somehow update the uniforms differently.
			//Currently this callback is called EVERY time one of the components changes...		
			//TODO: set the uniforms in before_render callback instead, so it can be set multiple times in one frame but still only updates once!
			
			uniforms[name] = [shader];
			uniform_entry = &uniforms[name];
			
			if(vec_ctrls) {
				if(vec_ctrls.size() == 2)
					shader.uniform(name, vec2f(vec_ctrls[0].value(), vec_ctrls[1].value()));
					vec_ctrls[0].callback([name, uniform_entry, vec_ctrls](v) {
						for(j = 0; j < uniform_entry.size(); j++)
							uniform_entry[j].uniform(name, vec2f(vec_ctrls[0].value(), vec_ctrls[1].value()));
					});
					vec_ctrls[1].callback(vec_ctrls[0].callback());
				if(vec_ctrls.size() == 3)
					shader.uniform(name, vec3f(vec_ctrls[0].value(), vec_ctrls[1].value(), vec_ctrls[2].value()));
					if(color_selector)
						vec_ctrls[0].callback([name, uniform_entry, vec_ctrls, color_selector](v) {
							vec = vec3f(vec_ctrls[0].value(), vec_ctrls[1].value(), vec_ctrls[2].value());
							for(j = 0; j < uniform_entry.size(); j++)
								uniform_entry[j].uniform(name, vec);
							color_selector.rgb(vec);
						});
					else
						vec_ctrls[0].callback([name, uniform_entry, vec_ctrls](v) {
							vec = vec3f(vec_ctrls[0].value(), vec_ctrls[1].value(), vec_ctrls[2].value());
							for(j = 0; j < uniform_entry.size(); j++)
								uniform_entry[j].uniform(name, vec);
						});
					vec_ctrls[1].callback(vec_ctrls[0].callback());
					vec_ctrls[2].callback(vec_ctrls[0].callback());
				if(vec_ctrls.size() == 4)
					shader.uniform(name, vec4f(vec_ctrls[0].value(), vec_ctrls[1].value(), vec_ctrls[2].value(), vec_ctrls[3].value()));
					if(color_selector)
						vec_ctrls[0].callback([name, uniform_entry, vec_ctrls, color_selector](v) {
							vec = vec4f(vec_ctrls[0].value(), vec_ctrls[1].value(), vec_ctrls[2].value(), vec_ctrls[3].value());
							for(j = 0; j < uniform_entry.size(); j++)
								uniform_entry[j].uniform(name, vec);
							color_selector.rgba(vec);
						});
					else
						vec_ctrls[0].callback([name, uniform_entry, vec_ctrls](v) {
							for(j = 0; j < uniform_entry.size(); j++)
								uniform_entry[j].uniform(name, vec4f(vec_ctrls[0].value(), vec_ctrls[1].value(), vec_ctrls[2].value(), vec_ctrls[3].value()));
						});
					vec_ctrls[1].callback(vec_ctrls[0].callback());
					vec_ctrls[2].callback(vec_ctrls[0].callback());
					vec_ctrls[3].callback(vec_ctrls[0].callback());
			}
			else {
				shader.uniform(name, ctrl.value());		
				ctrl.callback([name, uniform_entry](v) {
					for(j = 0; j < uniform_entry.size(); j++)
						uniform_entry[j].uniform(name, v);
				});
			}
		}
	};
	
	parse_settings = [comp_fmt, pixel_fmt, shader_paths](shader_index, str) {
		
		attributes = str.smart_split(" ");
		
		is_single_shader = shader_paths.size() == 1;
		
		set_comp_fmt = [shader_index, comp_fmt, is_single_shader](value) {
			if(is_single_shader) {
				comp_fmt.value(value);
				return;
			}

			shaders[shader_index].shader.output_component_format(value);
			shaders[shader_index].has_fixed_comp_fmt = true;
		};
		
		set_pixel_fmt = [shader_index, pixel_fmt, is_single_shader](value) {
			if(is_single_shader) {
				pixel_fmt.value(value);
				return;
			}
			
			shaders[shader_index].shader.output_pixel_format(value);
			shaders[shader_index].has_fixed_pixel_fmt = true;
		};
		
		for(i = 0; i < attributes.size(); i++) {
			attr = &attributes[i];
			if(attr.find("=") >= 0) {
				key_value = attr.smart_split("=");
				if(key_value[0] == "dtype" || key_value[0] == "type")
					set_comp_fmt(key_value[1]);
				else if(key_value[0] == "format")
					set_pixel_fmt(key_value[1]);
				else if(key_value[0] == "rendersize") {
					vec_values = key_value[1].extract("(",")").split(",", -1, true);
					try {
						shaders[shader_index].shader.render_size(vec2i(vec_values[0], vec_values[1]));
						shaders[shader_index].has_fixed_size = true;
					}
					catch(e) {}
				}
			}
		}
	};
	
	total_inputs = 0;
	parse_inputs = [in_panel, &total_inputs, mask_vec, input_vec](shader_index) {
		shader = shaders[shader_index].shader;
		shader_inputs = shader.inputs();
		
		for(i = 0; i < shader_inputs.size(); i++) {
			input_name = shader_inputs[i].name;
			
			//Some special cases, feedback from __init__ pass...
			if(input_name == "main_image")
				shader.input(input_name, shaders[0].shader);
				continue;
			
			//Feedback
			if(input_name == "feedback")
				shader.input(input_name, shader); //set ourselves
				continue;
			
			//Input from another buffer within this node
			other = find_shader(input_name);
			if(other)
				shader.input(input_name, other);
				continue;
				
			if(inputs.has(input_name))
				inputs[input_name].push_back(shader);
				continue;
			
			inputs[input_name] = [shader];
			input_entry = inputs[input_name];
			
			in_ctrl = None;
			
			if(input_name == "RenderMaskInput") {
				in_ctrl = mask_vec.control(input_name, "input_ctrls");
			}
			else {
				in_ctrl = in_panel.control(input_name, "input_ctrls");
				in_ctrl.anchor_left((*total_inputs) * 100).anchor_top(0).anchor_bottom(0).fixed_width(100);
				*total_inputs++;
			}
			
			in_ctrl.on_unlink([in_ctrl, input_name, input_entry](ctrl1,ctrl2){
				if(ctrl2 == in_ctrl) {
					for(sid = 0; sid < input_entry.size(); sid++)
						input_entry[sid].input(input_name, None);
					
				}
			});
			in_ctrl.callback([input_name, input_entry](v) {
				for(sid = 0; sid < input_entry.size(); sid++)
					input_entry[sid].input(input_name, v);
			});
			
			lc = input_name.lowercase();
			
			if(!default_input && (lc == "input" || lc == "ichannel0"))
				default_input = in_ctrl;
			
			input_collapsable = input_vec.collapsable(input_name).anchor_left(0).anchor_right(0);
			select_video_router = input_collapsable.combobox().items(["Select Input"]).anchor_left(0).anchor_right(0);
			
			select_video_router.on_open([select_video_router](){
				routers = get_video_routers();
				items = ["Select Input"];
				for(i = 0; i < routers.size(); i++) {
					items.push_back(routers[i].name);
				}
				select_video_router.items(items);
			});
			
			select_video_router.on_change([select_video_router, in_ctrl](index, text){
				routers = get_video_routers();
				index--;
				if(index < 0 || index >= routers.size())
					in_ctrl.clear_incoming_links();
					in_ctrl.value(None);
				else 
					routers[index].output_ctrl.link_to(in_ctrl);
					in_ctrl.value(routers[index].output_ctrl.value());
					
			});
		}
	};
	
	resolve_includes = [&resolve_includes](wd, path) {
		shader_src = fileio.read_string(wd + "/" + path);
		shader_lines = shader_src.split("\n");
		shader_src = "";
		for(i = 0; i < shader_lines.size(); i++) {
			if(shader_lines[i].starts("#include"))
				include_file = shader_lines[i].removeprefix("#include").strip().extract_quotes();
				include_file = wd + "/" + include_file;
				if(fileio.exists(include_file))
					shader_src += resolve_includes(fileio.file_dir(include_file), fileio.file_name(include_file)).strip();
				else
					std.error("Cannot read include file: " + include_file);
				continue;
			shader_src += shader_lines[i] + "\n";
		}
		return shader_src;
	};
	
	has_time_controls = false;
	
	for(sid = 0; sid < shader_paths.size(); sid++) {
		shader_src_file = fileio.read_string(shader_paths[sid]);
		shader_src = shader_src_file;	
		
		if(shader_src.find("#include") >= 0) {
			include_file = shader_paths[sid];
			shader_src = resolve_includes(fileio.file_dir(include_file), fileio.file_name(include_file)).strip();
		}
		
		if(shader_src.regex_search(R"(void\s+mainImage\s*\()") >= 0) {
			is_shadertoy = true;
			shader_src = shadertoy_header + "\n" + shader_src + "\n" + shadertoy_main;
		}	
		
		shader = None;
		if(shader_tabs)
			shader = shader_tabs[sid].shader();
		else
			shader = shader_widget.shader();
		
		shader.anchor(0);
		shader.fragment_source(shader_src);	
		shaders.push_back([shader=shader, name=fileio.pure_name(shader_paths[sid])]);

		if(shader.has_uniform("iTime"))
			has_time_controls = true;

		shader_lines = shader_src.split("\n");
		current_def = "";
		
		for(i = 0; i < shader_lines.size(); i++) {
			line = shader_lines[i].strip().compress_whitespace();
			if(line.empty()) continue;
			if(line.starts("//")) {
				if(line.starts("//@settings"))
					current_def = "";
					parse_settings(sid, line.removeprefix("//@settings").strip());
					continue;
				if(line.starts("//@"))
					current_def = line.substr(3);
				else if(line.starts("//") && !current_def.empty())
					current_def += " " + line;
				else
					current_def = "";
			}
			else if(!current_def.empty() && line.starts("uniform")) {			
				try {
					def = current_def;
					current_def = "";
					uniform_str = line.split(" ");
					parse_uniform(sid, uniform_str[2].removesuffix(";"), def);
				}
				catch(e) {}
			}
		}
	}
	
	//Hide time controls when iTime is not used...
	if(!has_time_controls)
		time_vec.visible(false);
	
	//Do shader inputs etc in another pass so all shaders are ready
	timeline = std.global("timeline");
	
	for(sid = 0; sid < shader_paths.size(); sid++) {
		
		parse_inputs(sid);
	
		shader_entry = &shaders[sid];
		has_iresolution = shader_entry.shader.has_uniform("iResolution");
		has_itime = shader_entry.shader.has_uniform("iTime");
		has_iframe = shader_entry.shader.has_uniform("iFrame");
		
		if(has_iframe)
			shader_entry.frame = 0;
		
		shader_entry.shader.before_render([shader_entry, time_ctrl, time_offs_ctrl, time_mult_ctrl, time_type_ctrl, timeline,
			has_iresolution, has_itime, has_iframe, projection_grid_x, projection_grid_y, projection_grid_fine_x, projection_grid_fine_y](){

			if(!shader_entry || !shader_entry.shader)
				return;

			if(shader_entry.need_projection_update) {
				shader_entry.need_projection_update = false;
				shader_entry.shader.projection_grid(vec2i(projection_grid_x.value(), projection_grid_y.value()));
				shader_entry.shader.projection_fine(vec2i(projection_grid_fine_x.value(), projection_grid_fine_y.value()));
			}
			
			real_fps = nanogui.current_context().real_fps();
			current_time = time_ctrl.value();
			time_type = time_type_ctrl.value();
			
			//Iwie eher last time und dann immer wenn quantized time beat > 1/fps dann 1/fps adden damit auch bei low fps constant bleibt?
			
			if(time_type == 0) {
				current_time += 1/real_fps * time_mult_ctrl.value();
				time_ctrl.value(current_time);
				//std.print(current_time);
			}
			else if(time_type == 1) {
				current_time *= time_mult_ctrl.value();
			}
			else if(time_type == 2) {
				current_time = timeline.cursor_pos.value() * time_mult_ctrl.value();
				time_ctrl.value(current_time);
			}
			
			current_time = math.mod(current_time + time_offs_ctrl.value(), 4096.0);
			shader_entry.shader.uniform("u_time", current_time);
		
			if(is_shadertoy) {
				if(has_iresolution)
					render_size = shader_entry.shader.render_size();
					shader_entry.shader.uniform("iResolution", vec3f(render_size.x, render_size.y, render_size.x / render_size.y));
				if(has_itime)
					shader_entry.shader.uniform("iTime", current_time);
				if(has_iframe)
					shader_entry.shader.uniform("iFrame", shader_entry.frame);
					shader_entry.frame++;
			}	
			
			if(std.is_function(render_callback))
				render_callback();
		});
	}
	
	out = io_panel.control("OUT", "output_ctrls");
	out.anchor_right(0).anchor_top(0).anchor_bottom(0).fixed_width(70);
	out.value(shaders[0].shader);
	out.callback([out](v){
		//Reset value back to shader...
		out.value(shaders[0].shader);
	});
	
	default_output = out;
	
	if(!uniforms)
		std.free(uniform_vec); //Remove collapsable when no uniforms are present...
	
	rnd_name = fileio.pure_name(generator.path) + "_" + std.random_hash(6);
	spout_name.value(rnd_name);
	videorouter_name.value(rnd_name);
	
	size_cb(0);
	//std.print(shaders);
	//std.print(uniforms);
}

save_state() {
	result = [proj=[], enabled=shaders[0].shader.rendering_enabled()];
	//TODO, rather than saving by index, save the shader name too so changes dont break things...
	for(i = 0; i < shaders.size(); i++)
		result.proj.push_back(shaders[i].shader.projection_save());
	
	return result;
}

load_state(state) {
	if(state.proj.size()) {
		for(i = 0; i < math.min(state.proj.size(), shaders.size()); i++) {
			shaders[i].shader.projection_load(state.proj[i]);
			shaders[i].need_projection_update = false;
		}
		if(state.has("enabled"))
			for(i = 0; i < shaders.size(); i++) {
				shaders[i].shader.rendering_enabled(state.enabled);
			}
	}
	
	default_output.value(shaders[0].shader);
}