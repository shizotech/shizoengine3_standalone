
#include "engine/interfaces/videorouter"
#include "engine/interfaces/display_output"

import nanogui;
import subprocess;

using eigen;

managed shaders = []; //fmt: [{shader=shader, has_fixed_size=bool, has_fixed_comp_fmt=bool, has_fixed_pixel_fmt=bool}]
managed monitor_screen = None;
managed video_router = None;

last_monitor_index = -1;
monitor_out = None; //the shader of the display output that copies the picture (picture_fit: stretch, fit, fill)

//How the picture fills a display, the copy shader and the Display lists: engine/interfaces/display_output.shio (#601)
last_frame_index = -1;

uniforms = [];
inputs = [];
text_uniform_ctrls = []; //name -> the text field of a //@text annotation
is_shadertoy = false;

size_x = None;
size_y = None;
size_mode = None; //Settings > Render > Size: 0 Custom, 1 Project

default_input = None;
default_output = None;

//For loaders that build on this one (the FFGL loader, #428): inputs that get no control (set by the loader itself),
//and the Control tab, where they add their own controls
hidden_inputs = [];
control_area = None;

render_callback = None;

#include "engine/generators/extensions/glsl/shadertoy"

//The visible name of a shader control, made from its uniform name (#436): "bg_colour" -> "Background colour",
//"timeMultiplier" -> "Time multiplier", "stage5_offset" -> "Stage 5 offset", "BAND_WIDTH" -> "Band width". Only the
//caption: the uniform name stays the ID of the control (links, MIDI mappings and saved projects find it by that), and
//a displayname= of the annotation or a name the user gives the control still wins
SHADER_CAPTION_WORDS = [bg="background", fg="foreground", rot="rotation", freq="frequency", amp="amplitude",
	pos="position", src="source", tgt="target", num="number", anim="animation", dir="direction", mult="multiplier",
	lum="luminance", func="function", hi="high", rgb="RGB", rgba="RGBA", hsv="HSV", uv="UV", vhs="VHS", fft="FFT",
	bpm="BPM", sdf="SDF", led="LED", x="X", y="Y", z="Z", w="W", fps="FPS", interp="interpolation",
	kaleido="kaleidoscope", cols="columns", dist="distance", fov="FOV", aa="anti-aliasing"];
SHADER_CAPTION_WORDS["3d"] = "3D";
SHADER_CAPTION_WORDS["2d"] = "2D";

shader_uniform_caption(name) {
	s = name;
	if(s.starts("u_"))
		s = s.substr(2);
	words = [];
	word = "";
	prev = "";
	for(c : s) {
		is_digit = "0123456789".contains(c);
		is_upper = !is_digit && c != c.lowercase();
		prev_digit = prev != "" && "0123456789".contains(prev);
		prev_lower = prev != "" && !prev_digit && prev != "_" && prev == prev.lowercase();
		if(c == "_" || c == " " || c == "-") {
			if(word != "")
				words.push_back(word);
			word = "";
		}
		else {
			if(word != "" && ((is_upper && (prev_lower || prev_digit)) || (is_digit && !prev_digit)))
				words.push_back(word);
				word = "";
			word += c;
		}
		prev = c;
	}
	if(word != "")
		words.push_back(word);
	if(words.size() == 0)
		return name;
	//Shadertoy style: iMouse -> Mouse
	if(words.size() > 1 && words[0] == "i")
		words.erase(0);
	//A name in capitals only (BAND_WIDTH_FAR) is read as plain words
	shouting = s == s.uppercase();
	out = "";
	for(i, w : words) {
		l = w.lowercase();
		if(SHADER_CAPTION_WORDS.has(l))
			l = SHADER_CAPTION_WORDS[l];
		else if(!shouting && w.size() > 1 && w == w.uppercase() && w != l)
			l = w; //an abbreviation written in capitals stays (RGB, UV)
		else if(i > 0 && l.size() == 1)
			l = l.uppercase(); //colorB -> Color B
		if(i == 0 && l.size() > 0)
			l = l.substr(0, 1).uppercase() + l.substr(1);
		out += (i > 0 ? " " : "") + l;
	}
	return out;
}

//iDate of Shadertoy: year, month - 1, day, seconds since midnight (local time, with milliseconds). Declared for every
//Shadertoy shader, it was never set and stayed 0 (#436: the clock of DateTime showed 00:00)
shadertoy_idate() {
	d = std.date("%Y %m %d %z").split(" ");
	z = d[3]; //UTC offset, "+0200"
	tz = (std.int(z.substr(1, 2)) * 60 + std.int(z.substr(3, 2))) * 60;
	if(z.starts("-"))
		tz = -tz;
	secs = math.mod(std.millis() / 1000.0 + tz, 86400.0);
	return vec4f(std.int(d[0]), std.int(d[1]) - 1, std.int(d[2]), secs);
}

//The characters a //@text annotation can send, from code 32 (space) on
SHADER_TEXT_CHARS = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";

//Sends a text into the int uniforms of a //@text annotation: <prefix>1 .. <prefix><slots> get the character codes (a
//character outside of ASCII becomes a space), <count> the number of characters
shader_send_text(shader, text, opts) {
	t = std.string(text ?? "");
	i = 0;
	for(c : t) {
		if(i >= opts.slots)
			break;
		code = SHADER_TEXT_CHARS.find(c);
		shader.uniform(opts.prefix + (i + 1), code < 0 ? 32 : code + 32);
		i++;
	}
	n = i;
	for(j = n; j < opts.slots; j++)
		shader.uniform(opts.prefix + (j + 1), 32);
	if(opts.count != "")
		shader.uniform(opts.count, n);
}

//The caption of an input port (#436), like the In / Out of the other generators: "input" -> "In", "input2" -> "In 2",
//"iChannel0" -> "Channel 0", any other sampler by its name ("AUDIO" -> "Audio"). Only the caption, the port's ID stays
shader_input_caption(name) {
	if(name == "input")
		return "In";
	if(name.starts("input") && "0123456789".contains(name.substr(5, 1)))
		return "In " + name.substr(5);
	return shader_uniform_caption(name);
}

find_shader(name) {
	for(i = 0; i < shaders.size(); i++) {
		if(shaders[i].name == name)
			return shaders[i].shader;
	}
	return None;
}

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return None;
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.rendering_enabled(value);
		}
	}
	
	if(cmd == "get_inputs")
		return inputs;
	
	if(cmd == "get_default_input")
		return default_input;
	
	if(cmd == "get_default_output")
		return default_output;
	
	if(cmd == "set_render_callback")
		render_callback = value;
	
	if(cmd == "set_uniform") {
		if(!uniforms.has(value.name)) {
			for(i = 0; i < shaders.size(); i++) {
				if(!shaders[i].shader.has_uniform(value.name))
					continue;
				shaders[i].shader.uniform(value.name, value.value);
			}
			
			return true;
		}
		
		uni = uniforms[value.name];
		for(i = 0; i < uni.size(); i++)
			uni[i].uniform(value.name, value.value);
			
		return true;
	}
	
	if(cmd == "set_input") {
		if(!inputs.has(value.name))
			return false;
		ins = inputs[value.name];
		for(i = 0; i < ins.size(); i++)
			ins[i].input(value.name, value.value);
		return true;
	}
	
	return None;
}

entry(generator, area, shader_dir) {
	
	shader_paths = [];
	
	if(fileio.is_directory(shader_dir)) {
		files = fileio.files(shader_dir, false).filter_value(".glsl");
		
		//First, try to find entry point
		for(i = 0; i < files.size(); i++) {
			if(files[i] == "__init__.glsl")
				shader_paths = [shader_dir + "/" + files[i]];
				files.erase(i);
				break;
		}
		
		if(!shader_paths)
			std.error("No __init__.glsl entry point found!");
			return;

		//Files that another shader file #includes are helpers, not render passes of their own
		//(compiled alone they have no main and fail, e.g. FlyingForms/helper.glsl)
		included = [];
		all_files = files.copy();
		all_files.push_back("__init__.glsl");
		for(i = 0; i < all_files.size(); i++) {
			lines = fileio.read_string(shader_dir + "/" + all_files[i]).split("\n");
			for(j = 0; j < lines.size(); j++) {
				line = lines[j].strip();
				if(line.starts("#include")) {
					included[fileio.file_name(line.removeprefix("#include").strip().extract_quotes())] = true;
				}
			}
		}

		//init glsl always has to be the FIRST shader, now we can add the rest...
		for(i = 0; i < files.size(); i++) {
			if(included.has(files[i]))
				continue;
			shader_paths.push_back(shader_dir + "/" + files[i]);
		}
	}
	else
		shader_paths = [shader_dir]; //Only a single glsl file...
	
	area.layout(None);
	
	control_tabs = area.tabwidget().anchor_left(0).anchor_top(0).anchor_bottom(25).fixed_width(250);
	
	ctrls_tab = control_tabs.add_tab("Control").anchor(0).vscroll().anchor(0).content().layout(nanogui.layout_vertical());
	control_area = ctrls_tab;
	settings_tab = control_tabs.add_tab("Settings").anchor(0).vscroll().anchor(0).content().layout(nanogui.layout_vertical());
	transform_tab = control_tabs.add_tab("Transform").anchor(0).vscroll().anchor(0).content().layout(nanogui.layout_vertical());
	//Tooltips (#379): one sentence each, the last line leads into the wiki (F1)
	control_tabs.tab_tooltip(0, "The time, the controls of the [[shader]], its inputs and where its picture goes\n[[wiki:Output-and-Devices#the-tabs-of-a-shader]]");
	control_tabs.tab_tooltip(1, "Size, format and mask of the picture the [[shader]] renders\n[[wiki:Output-and-Devices#render-settings-tab-settings]]");
	control_tabs.tab_tooltip(2, "Move, turn, zoom and mirror the picture, and fit it onto a surface (projection mapping)\n[[wiki:Output-and-Devices#transform-and-projection-mapping-tab-transform]]");
	
	io_panel = area.widget().anchor_bottom(0).anchor_left(0).anchor_right(0).fixed_height(25);
	in_panel = io_panel.widget().anchor(0).anchor_right(70);
	
	shader_widget = None;
	shader_tabs = [];
	
	if(shader_paths.size() > 1) {
		shader_widget = area.tabwidget();
		shader_widget.anchor_left(250).anchor_top(0).anchor_bottom(25).anchor_right(0);
		for(i = 0; i < shader_paths.size(); i++) {
			name = fileio.pure_name(shader_paths[i]);
			if(name == "__init__")
				name = "MAIN";
			shader_tabs.push_back(shader_widget.add_tab(name));
		}
	}
	else {
		shader_widget = area.widget();
		shader_widget.anchor_left(250).anchor_top(0).anchor_bottom(25).anchor_right(0);
	}
	
	//Time controls
	time_vec = ctrls_tab.controlvector("Time", "ctrls").expanded(false);
	time_vec.tooltip("How the time of the [[shader]] runs\n[[wiki:Settings#default-sync]]");
	time_type_ctrl = time_vec.controlcombo("Sync", "timectrls").items(["Free", "Manual", "Sync"]).segmented(true); //index-based
	time_type_ctrl.value(generator.engine.env.default_sync_mode.value());
	time_type_ctrl.tooltip("Free: runs on its own, in seconds. Manual: stands still, set Time yourself or [[link]] it. Sync: follows the [[timeline]], in [[beat|beats]]\n[[wiki:Settings#default-sync]]");
	time_ctrl = time_vec.controlfloat("Time", "timectrls");
	time_offs_ctrl = time_vec.controlfloat("Offset", "timectrls");
	time_mult_ctrl = time_vec.controlslider("Multiplier", "timectrls").min(-2).max(2).value(1);
	
	//Uniforms
	uniform_vec = ctrls_tab.controlvector("Controls", "uniforms").expanded(false);
	uniform_vec.tooltip("The controls the [[shader]] itself has");
	
	//Input controls
	input_vec = ctrls_tab.controlvector("Inputs", "ctrls").expanded(false);	
	input_vec.tooltip("The pictures the [[shader]] takes in: from a [[video router]] name, or No Input");
	
	//Output controls
	output_vec = ctrls_tab.controlvector("Outputs", "ctrls").expanded(false);	
	output_vec.tooltip("Where the picture goes: a display, the [[video router]], Spout / Syphon or NDI\n[[wiki:Output-and-Devices#outputs-tab-control]]");
	
	monitor_vec = output_vec.controlvector("Monitor", "output_ctrls_monitor").expanded(false);
	monitor_vec.tooltip("Show the picture on a display or projector\n[[wiki:Output-and-Devices#show-the-picture-on-a-display-or-projector]]");
	monitor_type = monitor_vec.controlcombo("monitor_type", "output_ctrls_monitor").caption("Display mode").items(["Fullscreen", "Window"]).segmented(true); //index-based
	//The name of the display that was chosen, kept with the project: at another venue the order of the displays
	//differs, the output goes to the display with that name or stays off (no fallback onto the screen of the program)
	monitor_name = monitor_vec.controltext("monitor_name", "output_ctrls_monitor").caption("Display name").hide_config_menu();
	//Empty: a text control of an older nanogui starts with its own name as text, and a new shader looked for a display
	//called "monitor_name" and left every output off (#593, #600)
	monitor_name.value("");
	monitor_name.visible(false);
	monitor_select = monitor_vec.controlcombo("monitor_select", "output_ctrls_monitor").caption("Display");
	monitor_fit = monitor_vec.controlcombo("monitor_fit", "output_ctrls_monitor").caption("Picture").items(DISPLAY_FIT_ITEMS).segmented(true); //index-based
	monitor_fit.tooltip(DISPLAY_FIT_TOOLTIP + "\n[[wiki:Output-and-Devices#show-the-picture-on-a-display-or-projector]]");
	monitor_type.tooltip("Fullscreen covers the display; Window opens a window you can move");
	monitor_select.tooltip("The display that shows the picture; Off closes it\n[[wiki:Output-and-Devices#show-the-picture-on-a-display-or-projector]]");
	//Each display with its name, the resolution the picture is made in for it and its role (Settings > Display, #593)
	monitor_select.on_open([monitor_select](){
		monitor_select.items(display_output_items());
	});
	
	mon_cb = monitor_select.on_open();
	mon_cb();
	
	videorouter_vec = output_vec.controlvector("VideoRouter", "video_router").caption("Video router").expanded(false);
	videorouter_enable = videorouter_vec.controlbutton("Enable Router").caption("Enable router").push(1);
	videorouter_name = videorouter_vec.controltext("VideoRouterName").caption("Video router name").hide_config_menu();
	videorouter_vec.tooltip("Offer the picture to other shaders by name: they pick it under Inputs\n[[wiki:Output-and-Devices#outputs-tab-control]]");
	videorouter_enable.tooltip("Offer the picture in the [[video router]]");
	videorouter_name.tooltip("The name other shaders pick it by");
	
	videorouter_enable.callback([videorouter_name](v){
		if(v)
			if(!video_router)
				video_router = VideoRouter(videorouter_name.value(), default_output);
		else
			video_router = None;
	});
	
	videorouter_name.callback([videorouter_name](v){
		if(video_router)
			video_router.name = v;
	});
	
	// Spout on Windows, Syphon on macOS (#264): the same controls and IDs, only the captions differ
	share = std.os_platform().lowercase().starts("mac") ? "Syphon" : "Spout";
	spout_vec = output_vec.controlvector("SPOUT", "output_ctrls_spout").caption(share).expanded(false);
	spout_enable = spout_vec.controlbutton("Enable SPOUT", "spout").caption("Enable " + share).push(1);
	spout_name = spout_vec.controltext("SpoutName", "spout").caption(share + " name").hide_config_menu();
	spout_vec.tooltip("Send the picture to other programs on this computer (Spout on Windows, Syphon on macOS)\n[[wiki:Output-and-Devices#outputs-tab-control]]");
	spout_name.tooltip("The name the other program finds the picture by");
	
	spout_enable.callback([spout_name, monitor_select](v){
		shaders[0].shader.spout_sender_name(spout_name.value());
		shaders[0].shader.spout_enabled(v);
	});
	
	//A new name applies at once, also while a display shows the output (#319)
	spout_name.callback([](v) {
		shaders[0].shader.spout_sender_name(v);
	});
	
	ndi_vec = output_vec.controlvector("NDI Stream", "output_ctrls_ndi").caption("NDI stream").expanded(false);
	ndi_enable = ndi_vec.controlbutton("Enable NDI", "ndi").push(1);
	ndi_name = ndi_vec.controltext("NDI Name", "ndi").caption("NDI name").hide_config_menu();
	ndi_vec.tooltip("Send the picture over the network as NDI\n[[wiki:Output-and-Devices#outputs-tab-control]]");
	ndi_name.tooltip("The name receivers on the network find the stream by");
	
	ndi_enable.callback([ndi_name, monitor_select](v){
		shaders[0].shader.ndi_source_name(ndi_name.value());
		shaders[0].shader.ndi_enabled(v);
	});
	
	ndi_name.callback([monitor_select](v) {
		shaders[0].shader.ndi_source_name(v);
	});
	
	monitor_select.callback([monitor_select, spout_enable, monitor_type, monitor_name, monitor_fit](index) {
		
		if(index == last_monitor_index)
			return;
		
		ctx = nanogui.current_context();
		//A display by its name: the one the project was made with, wherever it is in the list now. A saved display
		//that is not connected leaves the output off; it does not land on the screen of the program
		if(index > 0) {
			found = display_output_pick(index, monitor_name.value());
			if(found == 0) {
				last_monitor_index = 0;
				monitor_select.value(0, false); //no second round through this callback
				if(monitor_screen) {
					std.free(monitor_screen);
					monitor_screen = None;
				}
				monitor_out = None;
				return;
			}
			if(found != index) {
				monitor_select.value(found, false);
				index = found;
			}
		}

		last_monitor_index = index;
		
		if(monitor_screen)
			std.free(monitor_screen);
			monitor_screen = None;
		monitor_out = None;
		
		//None
		if(index == 0) 
			return;
		
		index = index-1; //To get monitor id
		
		mon_info = ctx.monitor_info(index);
		if(mon_info && mon_info.name)
			monitor_name.value(mon_info.name);
		
		//A shader with its own size (Custom) renders in the resolution of the display (Settings > Display: Auto is the
		//size in pixels; macOS gives a Retina display's size in points, the shader rendered at half its resolution,
		//#260). With the size of the project it keeps that: the project size follows the output displays, and setting
		//Width / Height here while they are linked to the project made the size depend on what changed last (#593)
		if(mon_info && size_mode && size_mode.value() == 0) {
			displays = std.global("engine").displays;
			res = displays ? displays.resolution(index) : [mon_info.pixel_width, mon_info.pixel_height];
			size_x.value(res[0]);
			size_y.value(res[1]);
		}
	
		monitor_screen = ctx.fullscreen(index, "shizoengine_output", !monitor_type.value());
		monitor_screen.decorated(0);
		monitor_screen.shadow(0); //no grey edge around the output on macOS

		monitor_screen.should_close([monitor_select](){
			monitor_select.value(0);
		});

		//The copy at the size of the display, also after its window changes (Window mode, another resolution)
		monitor_out = display_output_copy(monitor_screen, shaders[0].shader, monitor_fit.value());
		
	});

	monitor_fit.callback([](v) {
		if(monitor_out)
			monitor_out.uniform("shz_fit", std.int(v));
	});

	//Display mode applies at once: the output that shows is made again in the new mode. Before, the mode was only
	//read when a display was chosen (#319)
	monitor_type.callback([monitor_select](v) {
		index = monitor_select.value();
		if(index == 0)
			return;
		last_monitor_index = -1;
		cb = monitor_select.callback();
		cb(index);
	});
	
	//Settings
	size_vec = settings_tab.controlvector("Render", "settings");
	size_mode = size_vec.controlcombo("resize_mode", "settings").caption("Size").items(["Custom", "Project"]).segmented(true); //index-based
	render_downscale = size_vec.controlfloat("Renderscale").caption("Render scale").value(1);
	size_mode.tooltip("Project: the size of the [[project]] (Settings, Project). Custom: Width and Height below\n[[wiki:Output-and-Devices#render-settings-tab-settings]]");
	render_downscale.tooltip("Multiplies the size: 0.5 renders at half size (faster), 1 at full size");
	size_vec = settings_tab.controlvector("Size", "settings");
	//Instead of this, just change the size automatically if the generator has the same dims as the project had before
	size_x = size_vec.controlint("Width", "settings").value(generator.engine.project_width.value());
	size_y = size_vec.controlint("Height", "settings").value(generator.engine.project_height.value());
	
	size_mode.callback([size_x, size_y](v){
		engine = std.global("engine");
		if(v == 1) {
			engine.project_width.link_to(size_x);
			engine.project_height.link_to(size_y);
		}
		else {
			engine.project_width.unlink_from(size_x);
			engine.project_height.unlink_from(size_y);
		}
		
	});
	
	size_cb = [size_x, size_y, render_downscale](v) {
		for(i = 0; i < shaders.size(); i++) {
			if(!shaders[i].has_fixed_size)
				shaders[i].shader.render_size(vec2i(size_x.value() * render_downscale.value(), size_y.value() * render_downscale.value()));
		}
	};
	
	size_x.callback(size_cb);
	size_y.callback(size_cb);
	
	size_mode.value(1);
	
	fmt_vec = settings_tab.controlvector("Format", "settings").expanded(false);;
	
	comp_types = ["uint8", "int8", "uint16", "int16", "uint32", "int32", "uint64", "int64", "float16", "float32", "float64"];
	pixel_types = ["r", "ra", "rgb", "rgba", "bgr", "bgra", "depth", "depthstencil"];
	
	comp_fmt = fmt_vec.controlcombo("Component Fmt", "settings").caption("Component format").items(
		comp_types
	).value(0);
	
	pixel_fmt = fmt_vec.controlcombo("Pixel Fmt", "settings").caption("Pixel format").items(
		pixel_types
	).value(3);
	
	comp_fmt.callback([comp_types](v){
		for(i = 0; i < shaders.size(); i++) {
			if(!shaders[i].has_fixed_comp_fmt)
				shaders[i].shader.output_component_format(comp_types[v]);
		}
	});
	
	pixel_fmt.callback([pixel_types](v){
		for(i = 0; i < shaders.size(); i++) {
			if(!shaders[i].has_fixed_pixel_fmt)
				shaders[i].shader.output_pixel_format(pixel_types[v]);
		}
	});
	
	mask_vec = settings_tab.controlvector("Mask", "settings").expanded(false);
	rendermask_active = mask_vec.controlbutton("Rendermask", "settings").caption("Render mask").push(true);
	fmt_vec.tooltip("The format of the picture. NDI always sends 8-bit RGBA\n[[wiki:Output-and-Devices#render-settings-tab-settings]]");
	rendermask_active.tooltip("Turns the mask input on or off");
	
	rendermask_active.callback([](v) {
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.uniform("RenderMaskActive", v);
		}
	});
	
	//Transform controls
	
	transform_vec = transform_tab.controlvector("Transform").expanded(true);
	clip_uv = transform_vec.controlbutton("Clip UV").push(1);
	translate_x = transform_vec.controlfloat("X");
	translate_y = transform_vec.controlfloat("Y");
	rotate = transform_vec.controlslider("Rotate").min(0).max(360);
	zoom = transform_vec.controlslider("Zoom").value(1.0);
	flip_x = transform_vec.controlbutton("Flip X").push(1).fixed_height(25);
	flip_y = transform_vec.controlbutton("Flip Y").push(1).fixed_height(25);
	clip_uv.tooltip("Cut the picture off where a move, a turn or the zoom pushes it out of its frame\n[[wiki:Output-and-Devices#transform-and-projection-mapping-tab-transform]]");
	flip_x.tooltip("Mirror the picture left to right");
	flip_y.tooltip("Mirror the picture top to bottom");
	

	translate_x.callback([translate_x, translate_y](v) {
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.translate(vec2f(translate_x.value(), translate_y.value()));
		}
	});
	
	translate_y.callback(translate_x.callback());
	
	rotate.callback([rotate](v) {
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.rotation(v);
		}
	});
	
	zoom.callback([zoom](v) {
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.zoom(v);
		}
	});
	
	clip_uv.callback([](v){
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.clip_uv(v);
		}
	});
	
	flip_x.callback([](v){
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.flip_uv_x(v);
		}
	});
	
	flip_y.callback([](v){
		for(i = 0; i < shaders.size(); i++) {
			shaders[i].shader.flip_uv_y(v);
		}
	});
	
	projection_vec = transform_tab.controlvector("Projection Mapping").caption("Projection mapping").content().layout(nanogui.layout_vertical());
	
	projection_btn = projection_vec.pushbutton("Edit Grid");
	projection_subdivide = projection_vec.button("Subdivide");
	
	projection_grid_vec = projection_vec.controlvector("Grid", "mapping").expanded(false);	
	projection_grid_x = projection_grid_vec.controlint("X", "mapping").value(1);
	projection_grid_y = projection_grid_vec.controlint("Y", "mapping").value(1);
	
	projection_grid_fine_vec = projection_vec.controlvector("Fine", "mapping").expanded(false);	
	projection_grid_fine_x = projection_grid_fine_vec.controlint("X", "mapping").value(4);
	projection_grid_fine_y = projection_grid_fine_vec.controlint("Y", "mapping").value(4);
	
	projection_reset = projection_vec.button("Reset");
	projection_btn.tooltip("Show a grid over the picture: drag its points to fit the picture onto a surface\n[[wiki:Output-and-Devices#transform-and-projection-mapping-tab-transform]]");
	projection_subdivide.tooltip("A finer grid");
	projection_reset.tooltip("Back to the plain grid");
	projection_grid_vec.tooltip("How many fields the grid has across and down");
	projection_grid_fine_vec.tooltip("How finely each field is divided");
	
	set_projection_grid_cb = [projection_btn](v) {
		if(!projection_btn.pushed()) //Only set when its actually activated once, "lazy" set
			return;
		
		for(i = 0; i < shaders.size(); i++)
			shaders[i].need_projection_update = true;
	};
	
	projection_btn.on_change([set_projection_grid_cb](v) {
		for(i = 0; i < shaders.size(); i++)
			shaders[i].shader.projection_enabled(v);
		
		if(v)
			set_projection_grid_cb(0); //Only set these if projection mapping is actually needed...
	});
	
	projection_subdivide.on_click([projection_btn, projection_grid_x, projection_grid_y]() {
		
		if(!projection_btn.pushed()) //Only set when its actually activated once, "lazy" set
			return;
		
		for(i = 0; i < shaders.size(); i++)
			shaders[i].shader.projection_subdivide();
		projection_grid_x.value(projection_grid_x.value() * 2, false, false);
		projection_grid_y.value(projection_grid_y.value() * 2, false, false);
	});
	
	projection_reset.on_click([projection_grid_x, projection_grid_y]() {
		for(i = 0; i < shaders.size(); i++)
			shaders[i].shader.projection_reset();
	});
	
	projection_grid_x.callback(set_projection_grid_cb);
	projection_grid_y.callback(set_projection_grid_cb);
	projection_grid_fine_x.callback(set_projection_grid_cb);
	projection_grid_fine_y.callback(set_projection_grid_cb);
	
	//Scan uniform definitions in src..
	parse_uniform = [ctrls_tab, uniform_vec](shader_index, name, str) {

		shader = shaders[shader_index].shader;

		//@text prefix=char slots=16 count=char_count value="HTTP": a text field whose characters go into the int
		//uniforms char1 .. char16 and their number into char_count (#436). The uniform below the annotation only
		//names the field, the shader does not need to use it
		if(str.starts("text")) {
			opts = [prefix = name, slots = 16, count = "", value = ""];
			attributes = str.smart_split(" ");
			for(i = 1; i < attributes.size(); i++) {
				kv = attributes[i].smart_split("=");
				if(kv.size() < 2)
					continue;
				if(kv[0] == "prefix")
					opts.prefix = kv[1];
				else if(kv[0] == "slots")
					opts.slots = math.max(std.int(kv[1]), 0);
				else if(kv[0] == "count")
					opts.count = kv[1];
				else if(kv[0] == "value")
					opts.value = kv[1].extract("\"", "\"");
			}
			if(text_uniform_ctrls.has(name)) {
				uniforms[name].push_back(shader);
				shader_send_text(shader, text_uniform_ctrls[name].value(), opts);
				return;
			}
			ctrl = uniform_vec.controltext(name, "uniforms").caption(shader_uniform_caption(name)).value(opts.value);
			ctrl.tooltip("The text the shader shows, up to " + std.int(opts.slots) + " characters");
			text_uniform_ctrls[name] = ctrl;
			uniforms[name] = [shader];
			uniform_entry = &uniforms[name];
			shader_send_text(shader, ctrl.value(), opts);
			ctrl.callback([uniform_entry, opts](v) {
				for(j = 0; j < uniform_entry.size(); j++)
					shader_send_text(uniform_entry[j], v, opts);
			});
			return;
		}

		if(!shader.has_uniform(name))
			//std.warn("Uniform doesnt exist in shader: ", name);
			return;
		
		if(uniforms.has(name)) {
			uniforms[name].push_back(shader);
			return;
		}
		
		ctrl = None;
		
		attributes = str.smart_split(" ");
		
		vec_ctrls = None;
		color_selector = None;
		
		if(attributes[0] == "slider") {
			ctrl = uniform_vec.controlslider(name, "uniforms");
		}
		else if(attributes[0] == "int") {
			ctrl = uniform_vec.controlint(name, "uniforms");
		}
		else if(attributes[0] == "float") {
			ctrl = uniform_vec.controlfloat(name, "uniforms");
		}
		else if(attributes[0] == "button") {
			//A toggle, as SHADER_GUIDE.MD says: without push(1) it was a button that only reports the press, a //@button
			//(Flip Y of DateTime, ...) could be switched on and never off again (#436)
			ctrl = uniform_vec.controlbutton(name, "uniforms").push(1);
		}
		else if(attributes[0] == "pushbutton") {
			ctrl = uniform_vec.controlbutton(name, "uniforms").push(1);
		}
		else if(attributes[0] == "vec2") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlfloat("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlfloat("Y", "uniforms"));
		}
		else if(attributes[0] == "vec3") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlfloat("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlfloat("Y", "uniforms"));
			vec_ctrls.push_back(ctrl.controlfloat("Z", "uniforms"));
		}
		else if(attributes[0] == "vec4") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlfloat("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlfloat("Y", "uniforms"));
			vec_ctrls.push_back(ctrl.controlfloat("Z", "uniforms"));
			vec_ctrls.push_back(ctrl.controlfloat("W", "uniforms"));
		}
		else if(attributes[0] == "ivec2") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlint("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlint("Y", "uniforms"));
		}
		else if(attributes[0] == "ivec3") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlint("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlint("Y", "uniforms"));
			vec_ctrls.push_back(ctrl.controlint("Z", "uniforms"));
		}
		else if(attributes[0] == "ivec4") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlint("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlint("Y", "uniforms"));
			vec_ctrls.push_back(ctrl.controlint("Z", "uniforms"));
			vec_ctrls.push_back(ctrl.controlint("W", "uniforms"));
		}
		else if(attributes[0] == "slidervec2") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlslider("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlslider("Y", "uniforms"));
		}
		else if(attributes[0] == "slidervec3") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlslider("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlslider("Y", "uniforms"));
			vec_ctrls.push_back(ctrl.controlslider("Z", "uniforms"));
		}
		else if(attributes[0] == "slidervec4") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			vec_ctrls.push_back(ctrl.controlslider("X", "uniforms"));
			vec_ctrls.push_back(ctrl.controlslider("Y", "uniforms"));
			vec_ctrls.push_back(ctrl.controlslider("Z", "uniforms"));
			vec_ctrls.push_back(ctrl.controlslider("W", "uniforms"));
		}
		else if(attributes[0] == "rgb") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			rgb_vec = ctrl.controlvector("RGB");
			color_selector = ctrl.color_selector();
			
			vec_ctrls.push_back(rgb_vec.controlslider("R", "uniforms"));
			vec_ctrls.push_back(rgb_vec.controlslider("G", "uniforms"));
			vec_ctrls.push_back(rgb_vec.controlslider("B", "uniforms"));
			
			r_comp = vec_ctrls[-3];
			g_comp = vec_ctrls[-2];
			b_comp = vec_ctrls[-1];
			
			color_selector.on_color_change([r_comp,g_comp,b_comp](col) {
				r_comp.value(col.x);
				g_comp.value(col.y);
				b_comp.value(col.z);
			});
		}
		else if(attributes[0] == "rgba") {
			ctrl = uniform_vec.controlvector(name, "uniforms");
			rgb_vec = ctrl.controlvector("RGBA");
			color_selector = ctrl.color_selector();
			
			vec_ctrls.push_back(rgb_vec.controlslider("R", "uniforms"));
			vec_ctrls.push_back(rgb_vec.controlslider("G", "uniforms"));
			vec_ctrls.push_back(rgb_vec.controlslider("B", "uniforms"));
			vec_ctrls.push_back(rgb_vec.controlslider("A", "uniforms"));
			
			r_comp = vec_ctrls[-4];
			g_comp = vec_ctrls[-3];
			b_comp = vec_ctrls[-2];
			a_comp = vec_ctrls[-1];
			
			color_selector.on_color_change([r_comp,g_comp,b_comp,a_comp](col) {
				r_comp.value(col.x);
				g_comp.value(col.y);
				b_comp.value(col.z);
				a_comp.value(col.w);
			});
		}
		else if(attributes[0] == "enum") {
			ctrl = uniform_vec.controlcombo(name, "uniforms");
		}
		
		if(ctrl) {
			ctrl.caption(shader_uniform_caption(name));
			for(i = 1; i < attributes.size(); i++) {
				attr = &attributes[i];
				if(attr.find("=") >= 0) {
					key_value = attr.smart_split("=");
					try {
						if(key_value[0] == "options") {
							ctrl.items(key_value[1].extract("(",")").smart_split(","));
						}
						else if(key_value[0] == "displayname") {
							ctrl.display_name(key_value[1].extract("\"","\""));
						}
						else if(key_value[0] == "value" && attributes[0] == "enum" && "0123456789".contains(key_value[1].substr(0, 1))) {
							//value=2 is the index of the option: a string would be looked up as the text of an option (#436)
							ctrl.value(std.int(key_value[1]));
						}
						else if(vec_ctrls) {
							vec_values = key_value[1].extract("(",")").split(",", -1, true);
							for(j = 0; j < math.min(vec_values.size(), vec_values.size()); j++) {
								c = vec_ctrls[j];
								c[key_value[0]](vec_values[j]);
							}
						}
						else {
							ctrl[key_value[0]](key_value[1]);
						}
					}
					catch(e) {}
				}
			}
			
			//This is extremely inefficient, somehow update the uniforms differently.
			//Currently this callback is called EVERY time one of the components changes...		
			//TODO: set the uniforms in before_render callback instead, so it can be set multiple times in one frame but still only updates once!
			
			uniforms[name] = [shader];
			uniform_entry = &uniforms[name];
			
			if(vec_ctrls) {
				if(vec_ctrls.size() == 2)
					shader.uniform(name, vec2f(vec_ctrls[0].value(), vec_ctrls[1].value()));
					vec_ctrls[0].callback([name, uniform_entry, vec_ctrls](v) {
						for(j = 0; j < uniform_entry.size(); j++)
							uniform_entry[j].uniform(name, vec2f(vec_ctrls[0].value(), vec_ctrls[1].value()));
					});
					vec_ctrls[1].callback(vec_ctrls[0].callback());
				if(vec_ctrls.size() == 3)
					shader.uniform(name, vec3f(vec_ctrls[0].value(), vec_ctrls[1].value(), vec_ctrls[2].value()));
					if(color_selector)
						vec_ctrls[0].callback([name, uniform_entry, vec_ctrls, color_selector](v) {
							vec = vec3f(vec_ctrls[0].value(), vec_ctrls[1].value(), vec_ctrls[2].value());
							for(j = 0; j < uniform_entry.size(); j++)
								uniform_entry[j].uniform(name, vec);
							color_selector.rgb(vec);
						});
					else
						vec_ctrls[0].callback([name, uniform_entry, vec_ctrls](v) {
							vec = vec3f(vec_ctrls[0].value(), vec_ctrls[1].value(), vec_ctrls[2].value());
							for(j = 0; j < uniform_entry.size(); j++)
								uniform_entry[j].uniform(name, vec);
						});
					vec_ctrls[1].callback(vec_ctrls[0].callback());
					vec_ctrls[2].callback(vec_ctrls[0].callback());
				if(vec_ctrls.size() == 4)
					shader.uniform(name, vec4f(vec_ctrls[0].value(), vec_ctrls[1].value(), vec_ctrls[2].value(), vec_ctrls[3].value()));
					if(color_selector)
						vec_ctrls[0].callback([name, uniform_entry, vec_ctrls, color_selector](v) {
							vec = vec4f(vec_ctrls[0].value(), vec_ctrls[1].value(), vec_ctrls[2].value(), vec_ctrls[3].value());
							for(j = 0; j < uniform_entry.size(); j++)
								uniform_entry[j].uniform(name, vec);
							color_selector.rgba(vec);
						});
					else
						vec_ctrls[0].callback([name, uniform_entry, vec_ctrls](v) {
							for(j = 0; j < uniform_entry.size(); j++)
								uniform_entry[j].uniform(name, vec4f(vec_ctrls[0].value(), vec_ctrls[1].value(), vec_ctrls[2].value(), vec_ctrls[3].value()));
						});
					vec_ctrls[1].callback(vec_ctrls[0].callback());
					vec_ctrls[2].callback(vec_ctrls[0].callback());
					vec_ctrls[3].callback(vec_ctrls[0].callback());
			}
			else {
				shader.uniform(name, ctrl.value());		
				ctrl.callback([name, uniform_entry](v) {
					for(j = 0; j < uniform_entry.size(); j++)
						uniform_entry[j].uniform(name, v);
				});
			}
		}
	};
	
	parse_settings = [comp_fmt, pixel_fmt, shader_paths](shader_index, str) {
		
		attributes = str.smart_split(" ");
		
		is_single_shader = shader_paths.size() == 1;
		
		set_comp_fmt = [shader_index, comp_fmt, is_single_shader](value) {
			if(is_single_shader) {
				comp_fmt.value(value);
				return;
			}

			shaders[shader_index].shader.output_component_format(value);
			shaders[shader_index].has_fixed_comp_fmt = true;
		};
		
		set_pixel_fmt = [shader_index, pixel_fmt, is_single_shader](value) {
			if(is_single_shader) {
				pixel_fmt.value(value);
				return;
			}
			
			shaders[shader_index].shader.output_pixel_format(value);
			shaders[shader_index].has_fixed_pixel_fmt = true;
		};
		
		for(i = 0; i < attributes.size(); i++) {
			attr = &attributes[i];
			if(attr.find("=") >= 0) {
				key_value = attr.smart_split("=");
				if(key_value[0] == "dtype" || key_value[0] == "type")
					set_comp_fmt(key_value[1]);
				else if(key_value[0] == "format")
					set_pixel_fmt(key_value[1]);
				else if(key_value[0] == "rendersize") {
					vec_values = key_value[1].extract("(",")").split(",", -1, true);
					try {
						shaders[shader_index].shader.render_size(vec2i(vec_values[0], vec_values[1]));
						shaders[shader_index].has_fixed_size = true;
					}
					catch(e) {}
				}
			}
		}
	};
	
	total_inputs = 0;
	parse_inputs = [in_panel, &total_inputs, mask_vec, input_vec](shader_index) {
		shader = shaders[shader_index].shader;
		shader_inputs = shader.inputs();
		
		for(i = 0; i < shader_inputs.size(); i++) {
			input_name = shader_inputs[i].name;
			
			//Some special cases, feedback from __init__ pass...
			if(input_name == "main_image")
				shader.input(input_name, shaders[0].shader);
				continue;
			
			//Feedback
			if(input_name == "feedback")
				shader.input(input_name, shader); //set ourselves
				continue;
			
			//Input from another buffer within this node
			other = find_shader(input_name);
			if(other)
				shader.input(input_name, other);
				continue;
				
			if(inputs.has(input_name))
				inputs[input_name].push_back(shader);
				continue;
			
			inputs[input_name] = [shader];
			input_entry = inputs[input_name];

			if(hidden_inputs.has(input_name))
				continue;
			
			in_ctrl = None;
			
			if(input_name == "RenderMaskInput") {
				in_ctrl = mask_vec.control(input_name, "input_ctrls").caption("Render mask input");
			}
			else {
				in_ctrl = in_panel.control(input_name, "input_ctrls").caption(shader_input_caption(input_name));
				in_ctrl.anchor_left((*total_inputs) * 100).anchor_top(0).anchor_bottom(0).fixed_width(100);
				*total_inputs++;
			}
			
			in_ctrl.tooltip("An input of the shader: [[link]] a picture into it\n[[wiki:Output-and-Devices#the-tabs-of-a-shader]]");
			in_ctrl.on_unlink([in_ctrl, input_name, input_entry](ctrl1,ctrl2){
				if(ctrl2 == in_ctrl) {
					for(sid = 0; sid < input_entry.size(); sid++)
						input_entry[sid].input(input_name, None);
					
				}
			});
			in_ctrl.callback([input_name, input_entry](v) {
				for(sid = 0; sid < input_entry.size(); sid++)
					input_entry[sid].input(input_name, v);
			});
			
			lc = input_name.lowercase();
			
			if(!default_input && (lc == "input" || lc == "ichannel0"))
				default_input = in_ctrl;
			
			input_collapsable = input_vec.collapsable(input_name == "RenderMaskInput" ? "Render mask input" : shader_input_caption(input_name)); //the vertical layout gives it the full width inside the padding
			select_video_router = input_collapsable.combobox().items(["Select Input"]).anchor_left(0).anchor_right(0);
			
			select_video_router.on_open([select_video_router](){
				routers = get_video_routers();
				items = ["Select Input", "No Input"];
				for(i = 0; i < routers.size(); i++) {
					items.push_back(routers[i].name);
				}
				select_video_router.items(items);
			});
			
			select_video_router.on_change([select_video_router, in_ctrl](index, text){
				routers = get_video_routers();
				index-=2;
				if(index < 0 || index >= routers.size())
					if(index == -1)
						in_ctrl.clear_incoming_links();
						in_ctrl.value(None);
				else 
					routers[index].output_ctrl.link_to(in_ctrl);
					in_ctrl.value(routers[index].output_ctrl.value());
					
			});
		}
	};
	
	resolve_includes = [&resolve_includes](wd, path) {
		shader_src = fileio.read_string(wd + "/" + path);
		shader_lines = shader_src.split("\n");
		shader_src = "";
		for(i = 0; i < shader_lines.size(); i++) {
			if(shader_lines[i].starts("#include"))
				include_file = shader_lines[i].removeprefix("#include").strip().extract_quotes();
				include_file = wd + "/" + include_file;
				if(fileio.exists(include_file))
					shader_src += resolve_includes(fileio.file_dir(include_file), fileio.file_name(include_file)).strip();
				else
					std.error("Cannot read include file: " + include_file);
				continue;
			shader_src += shader_lines[i] + "\n";
		}
		return shader_src;
	};
	
	has_time_controls = false;

	//A Shadertoy shader declares mainImage(). Looked for line by line: regex_search refuses a text of more than
	//16384 characters (#102), and a pass of Audio/noise is longer (#552)
	declares_main_image = [](src) {
		if(src.find("mainImage") < 0)
			return false;
		src_lines = src.split("\n");
		for(i = 0; i < src_lines.size(); i++) {
			if(src_lines[i].find("mainImage") >= 0 && src_lines[i].regex_search(R"(void\s+mainImage\s*\()") >= 0)
				return true;
		}
		return false;
	};
	
	for(sid = 0; sid < shader_paths.size(); sid++) {
		shader_src_file = fileio.read_string(shader_paths[sid]);
		shader_src = shader_src_file;	
		
		if(shader_src.find("#include") >= 0) {
			include_file = shader_paths[sid];
			shader_src = resolve_includes(fileio.file_dir(include_file), fileio.file_name(include_file)).strip();
		}
		
		if(declares_main_image(shader_src)) {
			is_shadertoy = true;
			//#line: compile errors then count lines from the start of the shader file, not of the injected header
			shader_src = shadertoy_header + "\n#line 1\n" + shader_src + "\n" + shadertoy_main;
		}	
		
		shader = None;
		if(shader_tabs)
			shader = shader_tabs[sid].shader();
		else
			shader = shader_widget.shader();
		
		shader.anchor(0);
		shader.fragment_source(shader_src);	
		shaders.push_back([shader=shader, name=fileio.pure_name(shader_paths[sid])]);

		if(shader.has_uniform("iTime"))
			has_time_controls = true;

		shader_lines = shader_src.split("\n");
		current_def = "";
		
		for(i = 0; i < shader_lines.size(); i++) {
			line = shader_lines[i].strip().compress_whitespace();
			if(line.empty()) continue;
			if(line.starts("//")) {
				if(line.starts("//@settings"))
					current_def = "";
					parse_settings(sid, line.removeprefix("//@settings").strip());
					continue;
				if(line.starts("//@"))
					current_def = line.substr(3);
				else if(line.starts("//") && !current_def.empty())
					current_def += " " + line;
				else
					current_def = "";
			}
			else if(!current_def.empty() && line.starts("uniform")) {			
				try {
					def = current_def;
					current_def = "";
					uniform_str = line.split(" ");
					parse_uniform(sid, uniform_str[2].removesuffix(";"), def);
				}
				catch(e) {}
			}
		}
	}
	
	//Hide time controls when iTime is not used...
	if(!has_time_controls)
		time_vec.visible(false);
	
	//Do shader inputs etc in another pass so all shaders are ready
	timeline = std.global("timeline");
	
	for(sid = 0; sid < shader_paths.size(); sid++) {
		
		parse_inputs(sid);
	
		shader_entry = &shaders[sid];
		has_iresolution = shader_entry.shader.has_uniform("iResolution");
		has_itime = shader_entry.shader.has_uniform("iTime");
		has_itimedelta = shader_entry.shader.has_uniform("iTimeDelta");
		has_iframe = shader_entry.shader.has_uniform("iFrame");
		has_idate = shader_entry.shader.has_uniform("iDate");
		
		is_first = (sid == 0);
		
		if(has_iframe)
			shader_entry.frame = 0;
		
		shader_entry.shader.before_render([shader_entry, is_first, time_ctrl, time_offs_ctrl, time_mult_ctrl, time_type_ctrl, timeline,
			has_iresolution, has_itime, has_itimedelta, has_iframe, has_idate, projection_grid_x, projection_grid_y, projection_grid_fine_x, projection_grid_fine_y](){

			if(!shader_entry || !shader_entry.shader)
				return;

			if(shader_entry.need_projection_update) {
				shader_entry.need_projection_update = false;
				shader_entry.shader.projection_grid(vec2i(projection_grid_x.value(), projection_grid_y.value()));
				shader_entry.shader.projection_fine(vec2i(projection_grid_fine_x.value(), projection_grid_fine_y.value()));
			}

			real_fps = math.max(nanogui.current_context().real_fps(), 1);
			current_time = time_ctrl.value();

			if(shader_entry.shader.global_frame_index() != last_frame_index) {
			
				last_frame_index = shader_entry.shader.global_frame_index();
			
				if(std.is_function(render_callback))
					render_callback();
			
				time_type = time_type_ctrl.value();
			
				//Iwie eher last time und dann immer wenn quantized time beat > 1/fps dann 1/fps adden damit auch bei low fps constant bleibt?
				
				if(time_type == 0) {
					current_time += 1/real_fps * time_mult_ctrl.value();
					time_ctrl.value(current_time);
					//std.print(current_time);
				}
				else if(time_type == 1) {
					current_time *= time_mult_ctrl.value();
				}
				else if(time_type == 2) {
					current_time = timeline.cursor_pos.value() * time_mult_ctrl.value();
					time_ctrl.value(current_time);
				}
				
				current_time = math.mod(current_time + time_offs_ctrl.value(), 4096.0);
			}
			
			shader_entry.shader.uniform("u_time", current_time);
		
			if(is_shadertoy) {
				if(has_iresolution)
					render_size = shader_entry.shader.render_size();
					shader_entry.shader.uniform("iResolution", vec3f(render_size.x, render_size.y, render_size.x / render_size.y));
				if(has_itime)
					shader_entry.shader.uniform("iTime", current_time);
				if(has_itimedelta)
					shader_entry.shader.uniform("iTimeDelta", 1/real_fps * time_mult_ctrl.value());
				if(has_iframe)
					shader_entry.shader.uniform("iFrame", shader_entry.frame);
					shader_entry.frame++;
				if(has_idate)
					shader_entry.shader.uniform("iDate", shadertoy_idate());
			}	
		
		});
	}
	
	out = io_panel.control("OUT", "output_ctrls").caption("Out").as_output(true);
	out.tooltip("The picture of the shader: [[link]] it into an input, MapLab or a display\n[[wiki:Output-and-Devices#the-tabs-of-a-shader]]");
	out.anchor_right(0).anchor_top(0).anchor_bottom(0).fixed_width(70);
	out.value(shaders[0].shader);
	out.callback([out](v){
		//Reset value back to shader...
		out.value(shaders[0].shader);
	});
	
	default_output = out;
	
	if(!uniforms)
		std.free(uniform_vec); //Remove collapsable when no uniforms are present...
	
	rnd_name = fileio.pure_name(generator.path) + "_" + std.random_hash(6);
	spout_name.value(rnd_name);
	ndi_name.value(rnd_name);
	videorouter_name.value(rnd_name);
	
	size_cb(0);
	//std.print(shaders);
	//std.print(uniforms);
}

save_state() {
	result = [proj=[], enabled=shaders[0].shader.rendering_enabled()];
	//TODO, rather than saving by index, save the shader name too so changes dont break things...
	for(i = 0; i < shaders.size(); i++)
		result.proj.push_back(shaders[i].shader.projection_save());
	
	return result;
}

load_state(state) {
	if(state.proj.size()) {
		for(i = 0; i < math.min(state.proj.size(), shaders.size()); i++) {
			shaders[i].shader.projection_load(state.proj[i]);
			shaders[i].need_projection_update = false;
		}
		if(state.has("enabled"))
			for(i = 0; i < shaders.size(); i++) {
				shaders[i].shader.rendering_enabled(state.enabled);
			}
	}
	
	default_output.value(shaders[0].shader);
}