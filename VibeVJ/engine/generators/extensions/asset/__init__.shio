
load_extension(generator) {
	
	load_path = generator.path;
	
	if(fileio.is_directory(load_path)) {
		if(fileio.exists(load_path + "/src/__init__.shio"))
			load_path += "/src/__init__.shio"
		else if(fileio.exists(load_path + "/__init__.shio"))
			load_path += "/__init__.shio";
		else
			std.error("Not a valid asset (no __init__.shio found)");
			return;
	}
	
	generator.module = std.module();
	generator.module.load_file(load_path);
	
	//A class asset (#202, engine/contracts): create() gives the object behind the contract GeneratorModule. The
	//generator checks it, builds it and runs its hooks (generatoritem.shio, attach_module)
	if(generator.module.has("create")) {
		generator.impl = generator.module.call("create", generator, generator.node);
		if(generator.module.call_error() || !generator.impl)
			return false;
		generator._was_loaded = true;
		return true;
	}
	
	if(generator.module.has("entry")) {
		generator.module.call("entry", generator, generator.node);
		if(generator.module.call_error())
			return false;
	}
	
	//pre_callback() has one slot: an asset with update_pre() and update() gets both from one callback, update_pre()
	//first (as attach_module() does for a class asset). Two calls of pre_callback() left only the second one
	update_pre_fn = generator.module.has("update_pre") ? generator.module.get("update_pre") : None;
	update_fn = generator.module.has("update") ? generator.module.get("update") : None;
	if(update_pre_fn && update_fn) {
		generator.pre_callback([update_pre_fn, update_fn](generator, tl_pos, pos_delta){
			update_pre_fn(generator, tl_pos, pos_delta);
			update_fn(generator, tl_pos, pos_delta);
		});
	}
	else if(update_pre_fn || update_fn) {
		one_fn = update_pre_fn ? update_pre_fn : update_fn;
		generator.pre_callback([one_fn](generator, tl_pos, pos_delta){
			one_fn(generator, tl_pos, pos_delta);
		});
	}
	
	if(generator.module.has("update_post")) {
		update_fn = generator.module.get("update_post");
		generator.post_callback([update_fn](generator){
			update_fn(generator);
		});
	}
	
	generator._was_loaded = true;
}