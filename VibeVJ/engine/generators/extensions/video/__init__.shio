
// Loader for video files (.mp4, .mov, .mkv, ...). generatoritem.shio maps every
// video file extension to this loader.
load_extension(generator) {
	
	load_path = __DIR__+"/video_module.shio";
	
	generator.module = std.module();
	generator.module.load_file(load_path);
	
	if(generator.module.has("entry"))
		generator.module.call("entry", generator, generator.node);
	
	if(generator.module.has("update")) {
		update_fn = generator.module.get("update");
		generator.pre_callback([update_fn](generator, tl_pos, pos_delta){
			update_fn(generator, tl_pos, pos_delta);
		});
	}
		
	generator._was_loaded = true;
}
