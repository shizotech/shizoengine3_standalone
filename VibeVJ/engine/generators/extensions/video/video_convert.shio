// Formats and sizes of "Convert" (nanogui.video_convert, #278 / #460), shared by the Assets list
// (src/menu/assetbrowser/assetbrowser.shio) and the video generator (video_module.shio).
//
// A copy lands next to its file as <name>_<suffix>[_<size>p].mov: the first format with the
// original size is <name>_hap.mov, as before #460.

VIDEO_CONVERT_FORMATS = [
	[id = "hap", name = "HAP", short = "HAP", suffix = "hap",
		matches = ["hap", "hap_alpha"], tip = "HAP: the graphics card unpacks it, the cheapest to play (HAP Alpha when the file has alpha)"],
	[id = "hap_alpha", name = "HAP Alpha", short = "Alpha", suffix = "hapalpha",
		matches = ["hap_alpha"], tip = "HAP Alpha: HAP with a transparency channel"],
	[id = "hap_q", name = "HAP Q", short = "HAP Q", suffix = "hapq",
		matches = ["hap_q", "hap_q_alpha"], tip = "HAP Q: better colours than HAP, files twice as big"],
	[id = "prores", name = "ProRes", short = "ProRes", suffix = "prores",
		matches = ["prores"], tip = "ProRes 422 HQ (4444 with alpha): for editing, the processor decodes it"],
	[id = "dnxhr", name = "DNxHR", short = "DNxHR", suffix = "dnxhr",
		matches = ["dnxhr", "dnxhd"], tip = "DNxHR HQ: for editing, the processor decodes it; at least 256x120"],
];

// The most pixels of the shorter side (0 = the size of the file); never enlarged
VIDEO_CONVERT_SIZES = [0, 2160, 1080, 720, 480];

video_convert_size_name(size_index) {
	size = VIDEO_CONVERT_SIZES[size_index];
	return size ? std.string(size) + "p" : "Original";
}

video_convert_format_names(short) {
	names = [];
	for(f : VIDEO_CONVERT_FORMATS)
		names.push_back(short ? f.short : f.name);
	return names;
}

video_convert_size_names() {
	names = [];
	for(i = 0; i < VIDEO_CONVERT_SIZES.size(); i++)
		names.push_back(video_convert_size_name(i));
	return names;
}

// "HAP", "ProRes 720p"
video_convert_label(format_index, size_index) {
	label = VIDEO_CONVERT_FORMATS[format_index].name;
	if(VIDEO_CONVERT_SIZES[size_index])
		label = label + " " + video_convert_size_name(size_index);
	return label;
}

video_convert_format_index(id) {
	for(i, f : VIDEO_CONVERT_FORMATS) {
		if(f.id == id)
			return i;
	}
	return 0;
}

video_convert_size_index(size) {
	for(i = 0; i < VIDEO_CONVERT_SIZES.size(); i++) {
		if(VIDEO_CONVERT_SIZES[i] == size)
			return i;
	}
	return 0;
}

// The copy a conversion writes: <dir>/<name>_<suffix>[_<size>p].mov
video_convert_target(path, format_index, size_index) {
	name = fileio.pure_name(path) + "_" + VIDEO_CONVERT_FORMATS[format_index].suffix;
	if(VIDEO_CONVERT_SIZES[size_index])
		name = name + "_" + video_convert_size_name(size_index);
	return fileio.file_dir(path) + "/" + name + ".mov";
}

// The files VibeVJ plays as videos (mapped to this loader in generatoritem.shio)
VIDEO_FILE_EXTENSIONS = [mp4 = 1, mov = 1, m4v = 1, mkv = 1, webm = 1, avi = 1, mxf = 1, mpg = 1, mpeg = 1, ts = 1, wmv = 1];

video_convert_is_video(path) {
	return VIDEO_FILE_EXTENSIONS.has(fileio.file_ext(path).lowercase());
}

// The name (without extension) of the file a copy was made of: "clip" for clip_hap.mov or clip_prores_720p.mov,
// "" for a name that is no copy name
video_convert_copy_of(path) {
	if(fileio.file_ext(path).lowercase() != "mov")
		return "";
	name = fileio.pure_name(path);
	// drop a size part "_720p"
	cut = name.rfind("_");
	if(cut > 0 && name.ends("p")) {
		digits = name.substr(cut + 1, name.size() - cut - 2);
		only_digits = digits.size() > 0;
		numerals = "0123456789";
		for(c : digits) {
			if(!numerals.contains(c))
				only_digits = false;
		}
		if(only_digits)
			name = name.substr(0, cut);
	}
	for(f : VIDEO_CONVERT_FORMATS) {
		suffix = "_" + f.suffix;
		if(name.size() > suffix.size() && name.ends(suffix))
			return name.substr(0, name.size() - suffix.size());
	}
	return "";
}

// The videos directly in a folder (not in its subfolders) that a folder conversion goes through: without the copies
// Convert made there (clip_hap.mov next to clip.mp4; a clip_hap.mov without its clip.* is a video of its own)
video_convert_folder_videos(dir) {
	videos = [];
	names = std.json();
	files = fileio.files(dir, false);
	for(name : files) {
		if(video_convert_is_video(name))
			names[fileio.pure_name(name)] = 1;
	}
	for(name : files) {
		if(!video_convert_is_video(name))
			continue;
		original = video_convert_copy_of(name);
		if(original && names.has(original))
			continue;
		videos.push_back(dir + "/" + name);
	}
	videos.sort();
	return videos;
}

// Why the file needs no conversion to this format and size, or "" when it does (#460). The file is
// read (nanogui.video_probe) when no copy exists; a file that cannot be read is left to the converter,
// which says what is wrong with it.
video_convert_skip_reason(path, format_index, size_index) {
	target = video_convert_target(path, format_index, size_index);
	if(fileio.exists(target))
		return "copy exists: " + fileio.file_name(target);
	info = nanogui.video_probe(path);
	if(!info.ok)
		return "";
	format = VIDEO_CONVERT_FORMATS[format_index];
	size = VIDEO_CONVERT_SIZES[size_index];
	if(size && math.min(info.width, info.height) > size)
		return "";
	for(m : format.matches) {
		if(m == info.format)
			return "the file is " + format.name + " already";
	}
	return "";
}
