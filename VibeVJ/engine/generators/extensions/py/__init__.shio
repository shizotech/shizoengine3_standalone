//Loader for Python assets (#853 step 2): a .py file, or a folder Name.py/ with src/__init__.py (and asset.json). The
//script runs in a Python server process of its own; py_generator.shio makes its controls from the #@ annotations
load_extension(generator) {

	load_path = generator.path;

	if(fileio.is_directory(load_path)) {
		if(fileio.exists(load_path + "/src/__init__.py"))
			load_path += "/src/__init__.py";
		else if(fileio.exists(load_path + "/__init__.py"))
			load_path += "/__init__.py";
		else {
			std.error("Not a valid Python asset (no src/__init__.py found): " + load_path);
			return false;
		}
	}

	generator.module = std.module();
	generator.module.load_file(__DIR__ + "/py_generator.shio");

	if(generator.module.has("entry")) {
		generator.module.call("entry", generator, generator.node, load_path);
		if(generator.module.call_error())
			return false;
	}

	if(generator.module.has("update")) {
		update_fn = generator.module.get("update");
		generator.pre_callback([update_fn](generator, tl_pos, pos_delta){
			update_fn(generator, tl_pos, pos_delta);
		});
	}

	generator._was_loaded = true;
	return true;
}
