
#include "engine/interfaces/videorouter"

managed video_router = None;

output = None;

dispatcher(generator, cmd, value) {
	if(cmd == "get_default_output")
		return output;
}

entry(generator, area) {
	area.layout(None);
	
	control_tabs = area.vscroll().anchor_left(0).anchor_top(0).anchor_bottom(25).fixed_width(250)
		.content().layout(nanogui.layout_vertical());
	
	image = area.image(generator.path);
	
	image.anchor_left(250).anchor_top(0).anchor_bottom(25).anchor_right(0);
	
	output = control_tabs.control("OUT").as_output(true);
	
	size_vec = control_tabs.controlvector("Size");
	width = size_vec.controlint("Width").value(image.width());
	height = size_vec.controlint("Height").value(image.height());
	
	flip_ctrl = control_tabs.controlbutton("Flip Y").push(1);
	flip_ctrl.callback([image](v){
		image.flip_y(v);
	});
	
	videorouter_vec = control_tabs.controlvector("VideoRouter", "video_router").expanded(false);
	videorouter_enable = videorouter_vec.controlbutton("Enable Router").push(1);
	videorouter_name = videorouter_vec.controltext("VideoRouterName").hide_config_menu();
	
	videorouter_enable.callback([videorouter_name, output](v){
		if(v)
			if(!video_router)
				video_router = VideoRouter(videorouter_name.value(), output);
		else
			video_router = None;
	});
	
	videorouter_name.callback([videorouter_name](v){
		if(video_router)
			video_router.name = v;
	});
	
	videorouter_name.value(fileio.pure_name(generator.path));
	
	output.value(image);
	output.callback([output, image](v){
		output.value(image);
	});
}