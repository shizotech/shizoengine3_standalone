
#include "generatoritem"

//TODO: this can be dragged into the clipview to stack effects onto sources, should include the sidebar (like in v2)

class stackview
{
	managed area = None;
	managed ctrl_area = None;
	managed item_area = None;
	managed settings_area = None;
	managed items = [];
	
	on_items_changed = None;
	
	no_delete_first_item = false;
	
	__init__(parent)
	{		
		area = parent.widget().anchor(0);
		
		ctrl_area = area.widget().anchor_left(0).anchor_top(0).anchor_bottom(0).fixed_width(200).vscroll().anchor(0).content().layout(nanogui.layout_vertical());
		item_area = area.widget().anchor_left(200).anchor_top(0).anchor_bottom(0).anchor_right(0);
		
		ctrl_area.content().on_dragdrop_hover([this](payload, pos) {
			return true;
		});
		
		ctrl_area.content().on_dragdrop([this, area](payload, pos) {
			std.print(payload);
			std.print(pos);
			path = fileio.relative_path_cwd(payload.path);	
			
			this.add_generator(path);
			//Handle payload.paths for multi-file later...
			
			return true;
		});
		
		//Used internally in the clipview for example, to add extra controls
		settings_area = ctrl_area.collapsable("Settings");
		settings_area.visible(false);
	}

	dispatch(cmd, value) {		
	
		if(cmd == "add_generator")
			return add_generator(value);
	
		if(cmd == "on_items_changed")
			on_items_changed = value;
			return None;
		
		if(!items)
			return None;
		
		if(cmd == "no_delete")
			items[0].extra_widgets.entry_delete.visible(false);
			items[0].extra_widgets.entry_btn.anchor_right(0);
			items[0].extra_widgets.entry_btn.caption("LAYER");
			no_delete_first_item = true;
			return None;
	
		if(cmd == "get_item")
			return items[value];
	
		if(cmd == "get_default_input")
			return items[0].dispatch(cmd, value);
	
		if(cmd == "get_default_output")
			return items[-1].dispatch(cmd, value);
		
		if(cmd == "get_settings_area")
			settings_area.visible(true);
			if(value)
				settings_area.title(value);
			return settings_area;
	
		if(std.is_json(value) && value.has("index"))
			return items[value.index].dispatch(cmd, value);
		
		for(i = 0; i < items.size(); i++) {
			items[i].dispatch(cmd, value);
		}
		return None;
	}

	add_generator(path, guid = "", do_init = true) {
		item = generator(item_area, path, vec2f(0,0), guid, [no_header=true]);
		item.window.anchor(0).visible(false);
		item.window.movable(false);
		item.window.resizable(false);
		item_guid = item.guid;
		
		if(!item_guid) {
			std.free(item);
			return None;
		}
		
		entry_cnt = ctrl_area.widget().fixed_height(30).anchor_left(0).anchor_right(0);
		
		entry_btn = entry_cnt.pushbutton(fileio.pure_name(path)).anchor(0).anchor_right(25);
		entry_btn.on_change([this, item, entry_btn](v){
			if(v) {
				for(i = 0; i < items.size(); i++) {
					if(!items[i])
						items.erase(i);
						i--;
					items[i].extra_widgets.entry_btn.pushed(false);
					cb = items[i].extra_widgets.entry_btn.on_change();
					cb(false);
				}
				
				item.window.visible(true);
				entry_btn.pushed(true);
			}
			else
				item.window.visible(false);
		});
		
		entry_delete = entry_cnt.button("X").anchor_right(0).fixed_width(25).anchor_top(0).anchor_bottom(0);
		entry_delete.on_click([this, item](){
			item.on_close();
		});
		
		item.extra_widgets = [entry_cnt=entry_cnt, entry_btn=entry_btn, entry_delete=entry_delete];
		
		this.items[item_guid] = item;
		
		item.on_close = [this, item_guid]() {
			if(this.items.has(item_guid)) {
				item = this.items[item_guid];
				this.items.erase(item_guid);
				std.free(item);
			}
			
			this.link_items();
		};
		
		if(do_init) {
			cb = entry_btn.on_change();
			cb(true);
			link_items();
		}
		
		default_in = item.dispatch("get_default_input");
		if(default_in)
			default_in.visible(false);
		
		return item;
	}

	link_items() {
		if(items.size()) {
			last_out = items[0].dispatch("get_default_output");
		
			for(i = 1; i < items.size(); i++) {
				in = items[i].dispatch("get_default_input");
				
				if(last_out && in) {
					//Hook into this ctrl to prevent it from resetting...
					old_cb = in.callback();
					in.callback([last_out, old_cb, in](v){
						if(!v)
							in.value(last_out);
						else
							old_cb(v);
					});
				
					in.value(last_out.value());
				}
				if(items[i].dispatch("get_default_output"))
					last_out = items[i].dispatch("get_default_output");
			}
		}
		
		if(on_items_changed)
			on_items_changed(this);
	}

	save_state() {
		states = [];
			
		for(i = 0; i < this.items.size(); i++) {
			item = this.items[i];
			states.push_back(item.save_state());
		}
		
		return states;
	}

	load_state(states) {
		//Skip first item
		for(i = no_delete_first_item; i < this.items.size(); i++) {
			try {
				if(this.items[i])
					std.free(this.items[i]);
			}
			catch(e) {}
		}
		
		if(no_delete_first_item)
			tmp = items[0];
			items.clear();
			items.push_back(tmp);
		else
			items.clear();
		
		// Very special function, this avoids reloading same project GUID's while the current objects may not be destroyed yet
		for(!area.screen().garbage_cleared()) {
			std.sleep(0);
		}
		
		managed load_threads = [];
		
		for(i = 0; i < states.size(); i++) {
			state = states[i];
			is_first_state = i == 0;
			is_last_state = i == states.size()-1;
			thread = std.thread([this, state, is_first_state, is_last_state](){
				try {
					if(is_first_state && no_delete_first_item)
						items[0].load_state(state);
					else
						item = add_generator(state.path, state.guid, is_last_state);
						item.load_state(state);
				}
				catch(e) {}
			});
			thread.run();
			load_threads.push_back(thread);
		}
		
		for(i = 0; i < load_threads.size(); i++) {
			load_threads[i].join();
		}
	}
}