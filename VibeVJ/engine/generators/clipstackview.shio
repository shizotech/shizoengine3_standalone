
#include "generatoritem"

//The stack of a clip (a cell of the Clipview, a clip of the timeline): its entries run one after the other, the output
//of one into the default input of the next. Assets and generators dragged out of a Patchview (#348) are dropped on
//the list of its entries

class stackview
{
	managed area = None;
	managed ctrl_area = None;
	managed item_area = None;
	managed settings_area = None;
	managed items = [];
	//Entries whose asset did not load (removed, renamed), with their place in the stack: saved again as they were and
	//where they were, so the clip does not lose them (#202). [index = <place in the saved list>, state = <state>]
	missing = [];
	
	on_items_changed = None;
	//callback(name, action): runs a user action on the entries as one step of the undo history (the Clipview, #350)
	on_user_step = None;
	//callback(stack): generators dragged out of a Patchview are dropped on the entries (#348). The owner of the clip
	//(Clipview, timeline) takes them, as one step of its history. None: the stack does not take them
	on_generators_drop = None;
	
	no_delete_first_item = false;
	
	//While a project loads its clips (#330): new entries start inactive. A new generator renders from the start,
	//and the Clipview made its clips inactive only after each one had loaded, so every clip of the project rendered
	//(and held its textures) during the load. The Clipview sets the live ones active again afterwards.
	start_inactive = false;
	
	__init__(parent)
	{		
		area = parent.widget().anchor(0);
		
		ctrl_area = area.widget().anchor_left(0).anchor_top(0).anchor_bottom(0).fixed_width(250).vscroll().anchor(0).content().layout(nanogui.layout_vertical());
		item_area = area.widget().anchor_left(250).anchor_top(0).anchor_bottom(0).anchor_right(0);
		
		//Assets (a payload with a path, #346) and generators of a Patchview (#348): anything else gets the red outline
		//of the screen and is not dropped
		ctrl_area.content().on_dragdrop_hover([this](payload, pos) {
			return this.takes_drop(payload);
		});
		
		ctrl_area.content().on_dragdrop([this, area](payload, pos) {
			if(!this.takes_drop(payload))
				return false;
			if(payload.has("generators") && payload.generators) {
				this.on_generators_drop(this);
				return true;
			}
			path = fileio.relative_path_cwd(payload.path);	
			
			this.user_step("Add to clip", [this, path](){
				this.add_generator(path);
			});
			//Handle payload.paths for multi-file later...
			
			return true;
		});
		
		//Used internally in the clipview for example, to add extra controls
		settings_area = ctrl_area.collapsable("Settings");
		settings_area.visible(false);
	}

	//An asset dragged from the asset browser (a payload with a path), generators of a Patchview when the owner of the
	//clip takes them
	takes_drop(payload) {
		if(!std.is_json(payload))
			return false;
		if(payload.has("generators") && payload.generators)
			return std.is_function(on_generators_drop) && !nanogui.show_mode() ? true : false;
		return payload.has("path") && std.is_string(payload.path) && payload.path != "" ? true : false;
	}

	dispatch(cmd, value) {		
	
		if(cmd == "add_generator")
			return add_generator(value);
	
		if(cmd == "add_entry")
			return add_entry(value);
	
		if(cmd == "on_items_changed")
			on_items_changed = value;
			return None;

		if(cmd == "on_user_step") {
			on_user_step = value;
			return None;
		}

		if(cmd == "on_generators_drop") {
			on_generators_drop = value;
			return None;
		}

		//A generator that lives in another view becomes the last entry (#348)
		if(cmd == "adopt_generator")
			return adopt_generator(value);

		//An entry leaves the stack alive (value: its guid), the undo of adopt_generator
		if(cmd == "release_entry")
			return release_entry(value);

		if(cmd == "link_items") {
			link_items();
			return None;
		}

		//No entries left, also none whose asset is missing: the clip would go with the next link_items
		if(cmd == "is_empty")
			return items.size() == 0 && missing.size() == 0 ? true : false;
		
		if(cmd == "start_inactive") {
			start_inactive = value;
			if(value) {
				for(i = 0; i < items.size(); i++)
					items[i].set_active(false);
			}
			return None;
		}
		
		//The settings area belongs to the stack, not to its entries: there also while it has none, e.g. when the
		//asset of its only entry is missing (#202)
		if(cmd == "get_settings_area")
			settings_area.visible(true);
			if(value)
				settings_area.title(value);
			return settings_area;
		
		if(!items)
			return None;
		
		if(cmd == "no_delete")
			items[0].extra_widgets.entry_delete.visible(!value);
			items[0].extra_widgets.entry_btn.anchor_right(value ? 0 : 25);
			no_delete_first_item = value;
			return None;
		
		if(cmd == "set_first_name")
			items[0].extra_widgets.entry_btn.caption(value);
		
		if(cmd == "get_items") {
			return items;
		}
	
		if(cmd == "get_item")
			return items[value];
	
		if(cmd == "get_default_input" || cmd == "get_inputs")
			return items[0].dispatch(cmd, value);
	
		if(cmd == "get_default_output")
			return items[-1].dispatch(cmd, value);

		//The first entry that draws the cell of the clip (#677): the clip view calls its draw_cell
		if(cmd == "get_cell_preview") {
			for(i = 0; i < items.size(); i++) {
				if(items[i].dispatch("has_cell_preview", None) == true)
					return items[i];
			}
			return None;
		}
		
		if(std.is_json(value) && value.has("index"))
			return items[value.index].dispatch(cmd, value);
		
		for(i = 0; i < items.size(); i++) {
			items[i].dispatch(cmd, value);
		}
		return None;
	}

	add_generator(path, guid = "", do_init = true) {
		item = generator(item_area, path, vec2f(0,0), guid, [no_header=true]);
		
		//A generator whose asset did not load still exists (its constructor only returns early): it has no window (#202)
		if(!item || !item.is_loaded()) {
			if(item)
				std.free(item);
			return None;
		}
		
		if(start_inactive)
			item.set_active(false);
		
		return take_item(item, do_init);
	}

	//A generator dragged out of a Patchview (#348) becomes the last entry alive: its controls, links and MIDI mappings
	//stay. It runs when the clip runs, as the other entries. Returns it
	adopt_generator(gen) {
		if(!gen || !gen.window)
			return None;
		gen.set_collapsed(false);
		window = gen.window;
		window.move_to(item_area);
		window.clear_anchors();
		window.position(vec2f(0, 0));
		window.header_enabled(false);
		window.snap_grid(0);
		//The handlers of the Patchview (select, Alt + drag) belong to the view it left
		window.on_mouse_button(None);
		window.on_grab(None);
		gen.on_user_close = None;
		return take_item(gen, true);
	}

	//The entry guid leaves the stack alive (the undo of a move into the clip, #348): its row in the list goes, the
	//generator does not. Its window is still in the stack: the caller moves it out, then dispatches "link_items" (a
	//stack without entries closes its clip then, with what is still in it). Returns the generator, None when the
	//stack has no such entry
	release_entry(guid) {
		if(!items.has(guid))
			return None;
		gen = items[guid];
		items.erase(guid);
		//The link the stack made from the entry before into its default input
		default_in = gen.dispatch("get_default_input");
		if(default_in) {
			default_in.remove_all_links();
			default_in.visible(true);
		}
		if(gen.extra_widgets && gen.extra_widgets.entry_cnt)
			std.free(gen.extra_widgets.entry_cnt);
		gen.extra_widgets = [];
		gen.on_close = None;
		gen.window.visible(true);
		return gen;
	}

	//An entry made here or taken from another view: its row in the list of entries, its window in the stack
	take_item(item, do_init) {
		path = item.path;
		item.window.anchor(0).visible(false);
		item.window.movable(false);
		item.window.resizable(false);
		item_guid = item.guid;
		
		entry_cnt = ctrl_area.widget().fixed_height(30).anchor_left(0).anchor_right(0);
		
		entry_btn = entry_cnt.pushbutton(fileio.pure_name(path)).anchor(0).anchor_right(25);
		entry_btn.on_change([this, item, entry_btn](v){
			if(v) {
				for(i = 0; i < items.size(); i++) {
					if(!items[i]) {
						items.erase(i);
						i--;
						continue;
					}
					items[i].extra_widgets.entry_btn.pushed(false);
					cb = items[i].extra_widgets.entry_btn.on_change();
					cb(false);
				}
				
				item.window.visible(true);
				entry_btn.pushed(true);
			}
			else
				item.window.visible(false);
		});
		
		entry_delete = entry_cnt.button("").icon(nanogui.icon("times")).tooltip("Remove this entry from the [[stack]]. The [[clip]] goes with its last entry.").danger("hover").anchor_right(0).fixed_width(25).anchor_top(0).anchor_bottom(0);
		entry_delete.on_click([this, item](){
			this.user_step("Remove from clip", [item](){
				item.on_close();
			});
		});
		
		item.extra_widgets = [entry_cnt=entry_cnt, entry_btn=entry_btn, entry_delete=entry_delete];
		
		this.items[item_guid] = item;
		
		item.on_close = [this, item_guid]() {
			if(this.items.has(item_guid)) {
				item = this.items[item_guid];
				this.items.erase(item_guid);
				std.free(item);
			}
			
			this.link_items();
		};
		
		if(do_init) {
			cb = entry_btn.on_change();
			cb(true);
			link_items();
		}
		
		default_in = item.dispatch("get_default_input");
		if(default_in)
			default_in.visible(false);
		
		return item;
	}

	//An entry of another stack, at the end of this one, with its settings (a clip dropped onto a clip, #374).
	//clip_entry: [state = <save_state()>, node = <node.serialize_json()>, button_node = <button_panel.serialize_json()>],
	//node / button_node None for an entry whose asset is missing. It gets a guid of its own: a copy of the clip keeps
	//the guids of its entries, and two nodes with one name cannot be in the same clip
	add_entry(clip_entry) {
		state = clip_entry.state;
		item = None;
		try {
			item = add_generator(asset_resolve(state.path, state.asset_id ?? ""));
		}
		catch(e) {}
		if(!item) {
			//Kept as it was, after the last entry, like an entry of a project whose asset is missing (#202)
			if(state.path) {
				missing.push_back([index = items.size() + missing.size(), state = state]);
				std.warn("Asset not found, kept in the clip: " + state.path);
			}
			return None;
		}
		try {
			item.load_state(state);
			if(!std.is_none(clip_entry.node))
				item.node.deserialize_json(clip_entry.node, true);
			if(!std.is_none(clip_entry.button_node))
				item.button_panel.deserialize_json(clip_entry.button_node);
		}
		catch(e) {}
		link_items();
		return item;
	}

	user_step(name, action) {
		if(std.is_function(on_user_step))
			on_user_step(name, action);
		else
			action();
	}

	link_items() {
		try {
			if(items.size()) {
				last_out = items[0].dispatch("get_default_output");
			
				for(i = 1; i < items.size(); i++) {
					in = items[i].dispatch("get_default_input");
					
					if(last_out && in) {
						//Hook into this ctrl to prevent it from resetting...
						old_cb = in.callback();
						in.callback([last_out, old_cb, in](v){
							if(!v)
								in.value(last_out);
							else
								old_cb(v);
						});
					
						//in.value(last_out.value());
						in.remove_all_links();
						last_out.link_to(in);
					}
					
					if(items[i].dispatch("get_default_output"))
						last_out = items[i].dispatch("get_default_output");
					else
						last_out = None;
				}
			}
		}
		catch(e) {
			
		}

		if(on_items_changed)
			on_items_changed(this);
	}

	save_state() {
		states = [];
		
		for(i = 0; i < this.items.size(); i++) {
			try {
				item = this.items[i];
				states.push_back(item.save_state());
			}
			catch(e) {
				
			}
		}
		
		//The entries that did not load, back at their place (missing is in the order of their index)
		for(i = 0; i < missing.size(); i++) {
			at = missing[i].index;
			if(at > states.size())
				at = states.size();
			states.insert(at, missing[i].state);
		}
		
		return states;
	}

	load_state(states) {
		//Skip first item
		
		for(i = 0; i < this.items.size(); i++) {
			try {
				std.free(items[i]);
			}
			catch(e) {
				
			}
		}
		
		items.clear();
		missing = [];
		
		// Very special function, this avoids reloading same project GUID's while the current objects may not be destroyed yet
		for(!area.screen().garbage_cleared()) {
			std.sleep(0);
		}
		
		managed load_threads = [];
		
		for(i = 0; i < states.size(); i++) {
			state = states[i];
			is_first_state = i == 0;
			is_last_state = i == states.size()-1;
			
			item = None;
			try {
				//Where the asset is now, when its folder was moved (#202)
				item = add_generator(asset_resolve(state.path, state.asset_id ?? ""), state.guid, is_last_state);
			}
			catch(e) {}
			if(!item) {
				if(state.path) {
					missing.push_back([index = i, state = state]);
					std.warn("Asset not found, kept in the project: " + state.path);
				}
				continue;
			}
			
			thread = std.thread([this, state, item](){
				try {
					item.load_state(state);
					if(this.start_inactive)
						item.set_active(false); //its saved state may have switched it on again
				}
				catch(e) {}
			});
			
			thread.run();
			load_threads.push_back(thread);
		}
		
		for(i = 0; i < load_threads.size(); i++) {
			load_threads[i].join();
		}
		
		link_items();
	}
}