//The picture of a generator on a display or projector: what the display output of a shader (shader_loader.shio) and
//the outputs of MapLab share, so they work the same (#601).

//How the picture fills a display whose shape differs: 0 Stretch (as before), 1 Fit (bars, nothing cut off), 2 Fill
//(nothing empty, the edges cut off). The copy shader of the output does it, with the sizes of both
DISPLAY_COPY_SHADER = "uniform sampler2D in_texture; uniform vec2 shz_out_size; uniform int shz_fit;\n" +
	"void main(){\n" +
	"  vec2 uv = v_uv;\n" +
	"  vec2 src = vec2(textureSize(in_texture, 0));\n" +
	"  if(shz_fit != 0 && src.x > 0.0 && src.y > 0.0 && shz_out_size.x > 0.0 && shz_out_size.y > 0.0) {\n" +
	"    float a = (src.x / src.y) / (shz_out_size.x / shz_out_size.y);\n" +
	"    vec2 k = a > 1.0 ? vec2(1.0, a) : vec2(1.0 / a, 1.0);\n" +
	"    if(shz_fit == 2) k = a > 1.0 ? vec2(1.0 / a, 1.0) : vec2(1.0, a);\n" +
	"    uv = (v_uv - 0.5) * k + 0.5;\n" +
	"    if(uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) { fragColor = vec4(0.0, 0.0, 0.0, 1.0); return; }\n" +
	"  }\n" +
	"  fragColor = texture(in_texture, uv);\n" +
	"}";

DISPLAY_FIT_ITEMS = ["Stretch", "Fit", "Fill"];
DISPLAY_FIT_TOOLTIP = "When the picture and the display have another shape: Stretch fills the display and distorts it, Fit shows all of it with black bars, Fill fills the display and cuts the edges off";

//The entries of a Display list: Off, then each display with its name, resolution and role (Settings > Display, #593)
display_output_items() {
	ctx = nanogui.current_context();
	displays = std.global("engine").displays;
	items = ["Off"];
	for(i = 0; i < ctx.monitor_count(); i++) {
		if(displays) {
			items.push_back(displays.label(i));
			continue;
		}
		info = ctx.monitor_info(i);
		items.push_back("Display " + (i + 1) + (info && info.name ? " · " + info.name : ""));
	}
	return items;
}

//The display for a choice of a Display list (index: 1 the first display, 0 Off) and the name of the display that was
//chosen, kept with the project. At another venue the order of the displays differs: the output goes to the display
//with that name wherever it is now (with two of the same name, the chosen place decides), or stays off when it is not
//connected - it never lands on another display, also not on the screen of the program. Without a name, the place.
//Returns the index to use (0: off, a warning is in the Log)
display_output_pick(index, wanted) {
	if(index <= 0)
		return 0;
	//Saved before #593 / #600: a text control started with its own name, no name was chosen
	if(wanted == "monitor_name")
		wanted = "";
	ctx = nanogui.current_context();
	count = ctx.monitor_count();
	if(!wanted) {
		if(index > count) {
			std.warn("Display output: \"Display " + index + "\" is not connected, the output stays off");
			return 0;
		}
		return index;
	}
	found = -1;
	for(i = 0; i < count; i++) {
		info = ctx.monitor_info(i);
		if(info && info.name == wanted && found < 0)
			found = i + 1;
	}
	if(index <= count) {
		here = ctx.monitor_info(index - 1);
		if(here && here.name == wanted)
			found = index;
	}
	if(found < 0) {
		std.warn("Display output: \"" + wanted + "\" is not connected, the output stays off");
		return 0;
	}
	return found;
}

//The copy of the picture on the screen of a display output: renders at the size of that screen, with the Picture mode
//fit (0 Stretch, 1 Fit, 2 Fill), and again at the new size when the window changes (Window mode, a display that changes
//its resolution). Returns the shader; picture: the shader whose picture goes out
display_output_copy(screen, picture, fit) {
	shader = screen.shader();
	shader.anchor(0);
	//In pixels: width() / height() are points on a Retina display of macOS
	fb = screen.framebuffer_size();
	shader.render_size(eigen.vec2i(fb[0], fb[1]));
	shader.fragment_source(DISPLAY_COPY_SHADER);
	shader.input("in_texture", picture);
	shader.uniform("shz_out_size", eigen.vec2f(fb[0], fb[1]));
	shader.uniform("shz_fit", std.int(fit));
	screen.on_window_resize([screen, shader](new_size, old_size){
		if(!screen || !shader)
			return;
		fb = screen.framebuffer_size();
		shader.render_size(eigen.vec2i(fb[0], fb[1]));
		shader.uniform("shz_out_size", eigen.vec2f(fb[0], fb[1]));
	});
	return shader;
}
