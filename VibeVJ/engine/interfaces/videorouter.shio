
class VideoRouter {

	name = "";
	output_ctrl = None;

	__init__(_name = "source", ctrl = None) {
		output_ctrl = ctrl;
		name = _name;
		router = std.global("videorouter");
		if(!router.instances)
			router.instances = [];
		
		//First check for stale entries... this can happen when __deinit__ is not called during module deinit (fix shizoscript internals)
		for(i = 0; i < router.instances.size(); i++) {
			if(!router.instances[i])
				router.instances.erase(i);
				i--;
		}
		
		router.instances.push_back(this);
	}
	
	__deinit__() {
		router = std.global("videorouter");
		for(i = 0; i < router.instances.size(); i++) {
			if(router.instances[i] == this) {
				router.instances.erase(i);
			}
		}
	}
}

get_video_routers() {
	router = std.global("videorouter");
	
	//First check for stale entries... this can happen when __deinit__ is not called during module deinit (fix shizoscript internals)
	for(i = 0; i < router.instances.size(); i++) {
		if(!router.instances[i])
			router.instances.erase(i);
			i--;
	}
	
	return router.instances;
}