
class AIInterface {
	
	target = None;
	queries = [];
	source_file = "";
	
	__init__(parent, parent_widget, src_file = "", get_status = None) {
		target = parent;
		source_file = src_file;
		if(parent_widget) {
			parent_widget.on_focus([this](v){
				if(v)
					focus();
			});
		}
		
		if(source_file) {
			register("get_source_file", None, [this](value) {
				return source_file;
			});
		}
		
		if(get_status) {
			on_get_status(get_status);
		}
	}
	
	focus() {
		std.global("engine").ai_last_interface = this;
	}
	
	on_get_status(callback) {
		register("get_target_status", None, [callback](v){
			callback();
		});
	}
	
	register(name, args, callback, description = "") {
		queries[name] = [args=args, callback=callback, description=description];	
	}
	
	query(name, args) {
		try {
			if(queries.has(name))
				cb = queries[name].callback;
				if(std.is_string(args))
					args = std.json(args);
				return cb(args);
		}
		catch(e) {
			return [
				ok=false,
				error="An error occured while executing this action.",
			];
		}
		return None;
	}
	
	clear_queries() {
		tmp_status_query = queries["get_target_status"];
		queries = [get_target_status=tmp_status_query];
	}
}