//The fixture editor: opened by the "Fixture editor" button in the tab Devices (#575).
//It was a menu file in assets/Fixtures before, where it was in the way of the assets.

#include "engine/menus/fixtures/editor"

managed menu = None;

menu_name() {
	return "Fixture Editor";
}

entry(parent) {
	menu = fixture_editor(parent);
}
