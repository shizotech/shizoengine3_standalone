//The fixture editor: opened by the Tools button at the right of the top bar and by "Fixture editor" in the tab Devices
//(#575, #975). It was a menu file in assets/Fixtures before, where it was in the way of the assets.
//Kept (#975, menu_keep): closing its tab hides it, the next open shows the fixture that was open.

#include "engine/menus/fixtures/editor"

managed menu = None;

menu_name() {
	return "Fixture Editor";
}

menu_keep() {
	return true;
}

entry(parent) {
	menu = fixture_editor(parent);
}

menu_shown() {
	if(menu)
		menu.shown();
}
