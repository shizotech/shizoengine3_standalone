
class fixture_instance {
	
	managed window = None;
	
	__init__(_window) {
		window = _window;
		
		draw_widget = window.pushbutton(" ").anchor(10);
		
		draw_widget.on_draw([draw_widget](){
				ctx = nanogui.current_context();
				ctx.nvgBeginPath();
				ctx.nvgRect(vec2f(5,5), vec2f(draw_widget.width()-10,draw_widget.height()-10));
				ctx.nvgFillColor(vec4f(1,0,0,1));
				ctx.nvgFill();
				
		});
	}
}
