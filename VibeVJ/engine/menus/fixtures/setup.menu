//The fixture setup: opened by the Tools button at the right of the top bar and by "Fixture setup" in the tab Devices
//(#575, #975). It was a menu file in assets/Fixtures before, where it was in the way of the assets.
//Kept (#975, menu_keep): closing its tab hides it, the next open shows the same menu again (the selection, the view, the
//programmer and its controls stay), instead of building it anew.

#include "engine/menus/fixtures/setup"

managed menu = None;

menu_name() {
	return "Fixture Setup";
}

menu_keep() {
	return true;
}

entry(parent) {
	menu = fixture_arranger(parent);
}

menu_shown() {
	if(menu)
		menu.shown();
}

menu_hidden() {
	if(menu)
		menu.hidden();
}
