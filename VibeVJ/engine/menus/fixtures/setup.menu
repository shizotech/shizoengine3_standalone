//The fixture setup: opened by the "Fixture setup" button in the tab Devices (#575).
//It was a menu file in assets/Fixtures before, where it was in the way of the assets.

#include "engine/menus/fixtures/setup"

managed menu = None;

menu_name() {
	return "Fixture Setup";
}

entry(parent) {
	menu = fixture_arranger(parent);
}
