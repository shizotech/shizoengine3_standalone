
import nanogui;

using eigen;

class fixture_item {
	path = "";
	managed area = None;
	managed scroll_area = None;
	managed channels = [];
	
	managed total_byte_count = None;
	
	__init__(editor, parent, _path) {
	
		path = _path;
	
		fixture_config = fileio.read_json(path);
		
		if(fixture_config.type != "fixture")
			std.error("json file is not a fixture!");
			return None;
	
		area = parent.widget().anchor(0);

		fixture_name = area.textbox(fileio.pure_name(path)).anchor_left(0).anchor_right(0).anchor_top(0).fixed_height(30);
		
		add_channel = area.button("Add Channel").anchor_left(0).anchor_right(0).anchor_top(30).fixed_height(30);
	
		splitter = area.widget().anchor_left(0).anchor_right(0).anchor_top(60).fixed_height(30);
		splitter.label("Total count:").anchor_left(0).fixed_width(100);
		total_byte_count = splitter.intbox().anchor(0).anchor_left(100);

		scroll_area = area.vscroll().anchor_left(0).anchor_right(0).anchor_top(90).anchor_bottom(0).content().layout(nanogui.layout_vertical());
	
		fixture_name.on_change([this, fixture_name, editor](txt) {
			//Construct path on the fly based on name
			old_path = this.path;
			this.path = fileio.file_dir(old_path) + "/" + txt + ".json";
			fileio.rename(old_path, this.path);
			editor.filebrowser.refresh();
			std.global("engine").filebrowser.refresh();
		});
		
		add_channel.on_click([this](){
			create_channel();
		});
		
		if(fixture_config.channels) {
			for(i = 0; i < fixture_config.channels.size(); i++) {
				chan_config = fixture_config.channels[i];
				chan = create_channel(chan_config.name);
				chan.type_select.selected(chan_config.type_id);
				chan.channel_count.value(chan_config.batch_count);
			}
		}
	}
	
	create_channel(name = "") {
		if(!name)
			name = "New channel";
		
		cnt = scroll_area.widget().layout(nanogui.layout_horizontal()).fixed_height(35);
			
		type_select = cnt.combobox().fixed_width(100);
		type_select.items(["8-bit","16-bit","RGB","RGBW"]);
		type_select.on_change([this](index,txt){
			this.save();
		});
		
		channel_count = cnt.intbox().anchor_left(100).fixed_width(50).min_value(1).max_value(999999).value(1);
		channel_count.value_callback([this](v){
			this.save();
		});
		
		channel_name = cnt.textbox(name).anchor_left(150).anchor_right(25);
		channel_name.on_change([this](txt){
			this.save();
		});
		
		channel_delete = cnt.button("X").anchor_right(0).fixed_width(25);
		
		channel_delete.on_click([this, cnt](){
			for(i = 0; i < channels.size(); i++) {
				if(channels[i].cnt == cnt)
					channels.erase(i);
					break;
			}
			
			std.free(cnt);
			
			this.save();
		});
		
		channels.push_back([
			cnt = cnt,
			type_select = type_select,
			channel_name = channel_name,
			channel_count = channel_count,
		]);
		
		this.save();
		
		return channels[-1];
	}
	
	save() {
		
		managed _grd = std.critical_section();
		
		channel_json = [];
		
		for(i = 0; i < channels.size(); i++) {
			type_text = channels[i].type_select.selected_text();
			type_size = 1;
			if(type_text == "16-bit")
				type_size = 2;
			else if(type_text == "RGB")
				type_size = 3;
			else if(type_text == "RGBW")
				type_size = 4;
			
			channel_json.push_back([
				name=channels[i].channel_name.value(),
				type=type_text,
				type_id = channels[i].type_select.selected(),
				batch_count = channels[i].channel_count.value(),
				byte_count = type_size,
			]);
		}
		
		fileio.write_json(path, [
			type = "fixture",
			channels = channel_json,
		]);
		
		calculate_total_size();
	}
	
	calculate_total_size() {
		total_bytes = 0;
		for(i = 0; i < channels.size(); i++) {
			type_text = channels[i].type_select.selected_text();
			type_size = 1;
			if(type_text == "16-bit")
				type_size = 2;
			else if(type_text == "RGB")
				type_size = 3;
			else if(type_text == "RGBW")
				type_size = 4;
			total_bytes += type_size * channels[i].channel_count.value();
		}
		total_byte_count.value(total_bytes);
		return total_bytes;
	}
}

class fixture_editor {
	managed filebrowser = None;
	managed opened_fixture = None;
	managed fixture_area = None;
	
	__init__(_parent) {
		engine = std.global("engine");
		parent = _parent;
		
		new_fixture = parent.button("Create new fixture").fixed_width(250).anchor_top(0).anchor_left(0);
		
		filebrowser = parent.filebrowser("assets/fixtures");
		filebrowser.anchor(0).anchor_top(30).clear_anchor_right().fixed_width(250);
		filebrowser.extensions([".json"]);
		
		fixture_area = parent.widget().anchor(0).anchor_left(250);
	
		new_fixture.on_click([this, engine]() {
			dirs = filebrowser.selected_paths();
			
			dir = dirs ? dirs[0] : "assets/fixtures";
			
			if(fileio.is_file(dir))
				dir = fileio.file_dir(dir);

			fixture_path = "";
			
			if(fileio.exists(dir + "/new_fixture.json")) {
				for(i = 2; i < 9999; i++) {
					if(!fileio.exists(dir + "/new_fixture (" + i + ").json"))
						fixture_path = dir + "/new_fixture (" + i + ").json";
						break;
				}
			}
			else
				fixture_path = dir + "/new_fixture.json";
			
			fileio.write_json(fixture_path, [type="fixture"]);
			this.filebrowser.refresh();
			engine.filebrowser.refresh();
		});
		
		filebrowser.on_double_click([this, engine](path){
			form = [
				[id="name",  	label="New Name",  	type="text",   	placeholder = fileio.pure_name(path)],
			];
			
			res = engine.screen.modal_form(form, "Choose fixture name", "save", "cancel");		
			if(res.choice != "submit")
				return;
			
			fileio.rename(path, fileio.file_dir(path) + "/" + fileio.pure_name(res.values.name) + ".json");
			
			filebrowser.refresh();
			engine.filebrowser.refresh();
		});
		
		filebrowser.on_click([this, engine](path){		
			open_fixture(path);
		});
	}
	
	open_fixture(path) {
		if(opened_fixture)
			opened_fixture = None;
		opened_fixture = fixture_item(this, fixture_area, path);
	}
}
