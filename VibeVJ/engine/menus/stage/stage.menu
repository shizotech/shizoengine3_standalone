//The Stage menu (#980): the room, the set and the decoration in 3D. Opened by the Tools button at the right of the
//top bar. Kept (#975, menu_keep): closing its tab hides it, the next open shows it as it was.

#include "engine/menus/stage/stage_editor"

managed menu = None;

menu_name() {
	return "Stage";
}

menu_keep() {
	return true;
}

entry(parent) {
	menu = stage_editor(parent);
}

menu_shown() {
	if(menu)
		menu.shown();
}
