//A QR code encoder in plain script (#359): the web remote shows its address as a QR code, so a phone opens it with the
//camera. Byte mode (UTF-8), versions 1 to 10 (up to 213 bytes at level L, 151 at M), no external library.
//The steps follow the QR Code generator library of Project Nayuki (MIT licence): data bits, Reed-Solomon error
//correction per block, interleaving, function patterns, zig-zag placement, mask, format and version bits.
//
//  qr = qr_encode("http://192.168.1.20:13350/#pin=123456");   //level M
//  qr.width;                     //21, 25, ... modules per side (without the quiet zone of 4 modules)
//  qr.modules[y * qr.width + x]; //1 dark, 0 light (not "size": a json key of that name is hidden by .size())
//  qr = qr_encode(text, "L");    //L, M, Q or H; None when the text is too long
//  qr = qr_encode(text, "M", 3); //mask 3 instead of the one with the lowest penalty (tests)
//
//Shifts (<<, >>) do not exist in ShizoScript: * 2, / 2 (ints divide as ints) and & instead.

QR_MAX_VERSION = 10;
QR_ECL_NAMES = ["L", "M", "Q", "H"];
QR_ECL_FORMAT = [1, 0, 3, 2]; //the two bits of the level in the format information
//Error correction codewords per block and the number of blocks, by level (L, M, Q, H) and version (index 0 unused)
QR_ECC_PER_BLOCK = [
	[-1, 7, 10, 15, 20, 26, 18, 20, 24, 30, 18],
	[-1, 10, 16, 26, 18, 24, 16, 18, 22, 22, 26],
	[-1, 13, 22, 18, 26, 18, 24, 18, 22, 20, 24],
	[-1, 17, 28, 22, 16, 22, 28, 26, 26, 24, 28]];
QR_BLOCKS = [
	[-1, 1, 1, 1, 1, 1, 2, 2, 2, 2, 4],
	[-1, 1, 1, 1, 2, 2, 4, 4, 4, 5, 5],
	[-1, 1, 1, 2, 2, 4, 4, 6, 6, 8, 8],
	[-1, 1, 1, 2, 4, 4, 4, 5, 6, 8, 8]];

//2^i for the bits (no shifts)
QR_POW2 = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072, 262144];

qr_bit(value, i) {
	return (value / QR_POW2[i]) & 1;
}

//GF(256) with the polynomial 0x11D: exp and log tables
qr_gf_tables() {
	exp = [];
	log = [];
	for(i = 0; i < 512; i++)
		exp.push_back(0);
	for(i = 0; i < 256; i++)
		log.push_back(0);
	x = 1;
	for(i = 0; i < 255; i++) {
		exp[i] = x;
		log[x] = i;
		x = x * 2;
		if(x >= 256)
			x = x ^ 0x11D;
	}
	for(i = 255; i < 512; i++)
		exp[i] = exp[i - 255];
	log[0] = 0;
	return [exp = exp, log = log];
}

QR_GF = qr_gf_tables();

qr_gf_mul(a, b) {
	if(a == 0 || b == 0)
		return 0;
	return QR_GF.exp[QR_GF.log[a] + QR_GF.log[b]];
}

//The generator polynomial of the given degree (coefficients from the highest power, the leading 1 left out)
qr_rs_divisor(degree) {
	result = [];
	for(i = 0; i < degree; i++)
		result.push_back(0);
	result[degree - 1] = 1;
	root = 1;
	for(i = 0; i < degree; i++) {
		for(j = 0; j < degree; j++) {
			result[j] = qr_gf_mul(result[j], root);
			if(j + 1 < degree)
				result[j] = result[j] ^ result[j + 1];
		}
		root = qr_gf_mul(root, 2);
	}
	return result;
}

qr_rs_remainder(data, divisor) {
	n = divisor.size();
	result = [];
	for(i = 0; i < n; i++)
		result.push_back(0);
	for(b : data) {
		factor = b ^ result[0];
		result.erase(0);
		result.push_back(0);
		for(i = 0; i < n; i++)
			result[i] = result[i] ^ qr_gf_mul(divisor[i], factor);
	}
	return result;
}

//Modules of a version that hold data and error correction (all but the function patterns)
qr_raw_modules(ver) {
	result = (16 * ver + 128) * ver + 64;
	if(ver >= 2) {
		num_align = ver / 7 + 2;
		result -= (25 * num_align - 10) * num_align - 55;
		if(ver >= 7)
			result -= 36;
	}
	return result;
}

qr_data_codewords(ver, ecl) {
	return qr_raw_modules(ver) / 8 - QR_ECC_PER_BLOCK[ecl][ver] * QR_BLOCKS[ecl][ver];
}

qr_align_positions(ver, size) {
	if(ver == 1)
		return [];
	num_align = ver / 7 + 2;
	step = (ver * 8 + num_align * 3 + 5) / (num_align * 4 - 4) * 2;
	result = [6];
	pos = size - 7;
	for(result.size() < num_align) {
		result.insert(1, pos);
		pos -= step;
	}
	return result;
}

class qr_matrix {
	size = 0;
	modules = [];
	function_mask = [];

	__init__(size) {
		this.size = size;
		modules = [];
		function_mask = [];
		for(i = 0; i < size * size; i++) {
			modules.push_back(0);
			function_mask.push_back(0);
		}
	}

	set_function(x, y, dark) {
		modules[y * size + x] = dark ? 1 : 0;
		function_mask[y * size + x] = 1;
	}

	finder(cx, cy) {
		for(dy = -4; dy <= 4; dy++) {
			for(dx = -4; dx <= 4; dx++) {
				dist = math.max(math.abs(dx), math.abs(dy));
				x = cx + dx;
				y = cy + dy;
				if(x >= 0 && x < size && y >= 0 && y < size)
					set_function(x, y, dist != 2 && dist != 4);
			}
		}
	}

	alignment(cx, cy) {
		for(dy = -2; dy <= 2; dy++)
			for(dx = -2; dx <= 2; dx++)
				set_function(cx + dx, cy + dy, math.max(math.abs(dx), math.abs(dy)) != 1);
	}

	format_bits(ecl, mask) {
		data = QR_ECL_FORMAT[ecl] * 8 + mask;
		rem = data;
		for(i = 0; i < 10; i++)
			rem = (rem * 2) ^ (((rem / 512) & 1) * 0x537);
		bits = ((data * 1024) | (rem & 1023)) ^ 0x5412;
		//first copy, around the finder at the top left
		for(i = 0; i < 6; i++)
			set_function(8, i, qr_bit(bits, i));
		set_function(8, 7, qr_bit(bits, 6));
		set_function(8, 8, qr_bit(bits, 7));
		set_function(7, 8, qr_bit(bits, 8));
		for(i = 9; i < 15; i++)
			set_function(14 - i, 8, qr_bit(bits, i));
		//second copy, split between the other two finders
		for(i = 0; i < 8; i++)
			set_function(size - 1 - i, 8, qr_bit(bits, i));
		for(i = 8; i < 15; i++)
			set_function(8, size - 15 + i, qr_bit(bits, i));
		set_function(8, size - 8, true); //the dark module
	}

	version_bits(ver) {
		if(ver < 7)
			return;
		rem = ver;
		for(i = 0; i < 12; i++)
			rem = (rem * 2) ^ (((rem / 2048) & 1) * 0x1F25);
		bits = ver * 4096 + (rem & 4095);
		for(i = 0; i < 18; i++) {
			bit = qr_bit(bits, i);
			a = size - 11 + i % 3;
			b = i / 3;
			set_function(a, b, bit);
			set_function(b, a, bit);
		}
	}

	function_patterns(ver, ecl) {
		for(i = 0; i < size; i++) {
			set_function(6, i, i % 2 == 0);
			set_function(i, 6, i % 2 == 0);
		}
		finder(3, 3);
		finder(size - 4, 3);
		finder(3, size - 4);
		pos = qr_align_positions(ver, size);
		n = pos.size();
		for(i = 0; i < n; i++) {
			for(j = 0; j < n; j++) {
				if((i == 0 && j == 0) || (i == 0 && j == n - 1) || (i == n - 1 && j == 0))
					continue;
				alignment(pos[i], pos[j]);
			}
		}
		format_bits(ecl, 0); //placeholder, drawn again with the mask
		version_bits(ver);
	}

	//The codewords in the zig-zag of two columns, from the bottom right
	codewords(data) {
		total = data.size() * 8;
		i = 0;
		for(right = size - 1; right >= 1; right -= 2) {
			if(right == 6)
				right = 5;
			upward = ((right + 1) & 2) == 0;
			for(vert = 0; vert < size; vert++) {
				for(j = 0; j < 2; j++) {
					x = right - j;
					y = upward ? size - 1 - vert : vert;
					if(function_mask[y * size + x] || i >= total)
						continue;
					modules[y * size + x] = qr_bit(data[i / 8], 7 - (i & 7));
					i++;
				}
			}
		}
	}

	//XOR of the mask pattern over the data modules (twice gives the modules back)
	apply_mask(mask) {
		for(y = 0; y < size; y++) {
			for(x = 0; x < size; x++) {
				k = y * size + x;
				if(function_mask[k])
					continue;
				invert = false;
				if(mask == 0)
					invert = (x + y) % 2 == 0;
				else if(mask == 1)
					invert = y % 2 == 0;
				else if(mask == 2)
					invert = x % 3 == 0;
				else if(mask == 3)
					invert = (x + y) % 3 == 0;
				else if(mask == 4)
					invert = (x / 3 + y / 2) % 2 == 0;
				else if(mask == 5)
					invert = (x * y) % 2 + (x * y) % 3 == 0;
				else if(mask == 6)
					invert = ((x * y) % 2 + (x * y) % 3) % 2 == 0;
				else
					invert = ((x + y) % 2 + (x * y) % 3) % 2 == 0;
				if(invert)
					modules[k] = 1 - modules[k];
			}
		}
	}

	//Penalty of the rules 1 (runs of 5 and more), 2 (2 x 2 blocks) and 4 (dark / light balance). Rule 3 (patterns that
	//look like a finder) is left out: every mask gives a valid code, the penalty only picks one that reads well
	penalty() {
		result = 0;
		for(pass = 0; pass < 2; pass++) {
			for(a = 0; a < size; a++) {
				run = 0;
				last = -1;
				for(b = 0; b < size; b++) {
					v = pass == 0 ? modules[a * size + b] : modules[b * size + a];
					if(v == last) {
						run++;
						if(run == 5)
							result += 3;
						else if(run > 5)
							result += 1;
					}
					else {
						last = v;
						run = 1;
					}
				}
			}
		}
		for(y = 0; y + 1 < size; y++) {
			for(x = 0; x + 1 < size; x++) {
				v = modules[y * size + x];
				if(v == modules[y * size + x + 1] && v == modules[(y + 1) * size + x] && v == modules[(y + 1) * size + x + 1])
					result += 3;
			}
		}
		dark = 0;
		for(v : modules)
			dark += v;
		total = size * size;
		k = (math.abs(dark * 20 - total * 10) + total - 1) / total - 1;
		if(k > 0)
			result += k * 10;
		return result;
	}
}

//Data codewords plus error correction, split into blocks and interleaved
qr_add_ecc(data, ver, ecl) {
	num_blocks = QR_BLOCKS[ecl][ver];
	ecc_len = QR_ECC_PER_BLOCK[ecl][ver];
	raw = qr_raw_modules(ver) / 8;
	num_short = num_blocks - raw % num_blocks;
	short_len = raw / num_blocks;
	divisor = qr_rs_divisor(ecc_len);
	blocks = [];
	k = 0;
	for(i = 0; i < num_blocks; i++) {
		n = short_len - ecc_len + (i < num_short ? 0 : 1);
		dat = [];
		for(j = 0; j < n; j++)
			dat.push_back(data[k + j]);
		k += n;
		ecc = qr_rs_remainder(dat, divisor);
		if(i < num_short)
			dat.push_back(0);
		for(e : ecc)
			dat.push_back(e);
		blocks.push_back(dat);
	}
	result = [];
	block_len = blocks[0].size();
	for(i = 0; i < block_len; i++) {
		for(j = 0; j < num_blocks; j++) {
			if(i != short_len - ecc_len || j >= num_short)
				result.push_back(blocks[j][i]);
		}
	}
	return result;
}

//The QR code of text (UTF-8 bytes): [width =, version =, level =, mask =, modules = [1 dark / 0 light, row by row]], or
//None when it does not fit into version 10. level: "L", "M" (default), "Q" or "H"
qr_encode(text, level = "M", force_mask = -1) {
	ecl = 1;
	for(i, name : QR_ECL_NAMES)
		if(name == std.string(level).uppercase())
			ecl = i;
	bytes = std.buffer();
	bytes.append(std.string(text));
	n = bytes.size();

	ver = 0;
	for(v = 1; v <= QR_MAX_VERSION; v++) {
		count_bits = v <= 9 ? 8 : 16;
		if(4 + count_bits + n * 8 <= qr_data_codewords(v, ecl) * 8) {
			ver = v;
			break;
		}
	}
	if(ver == 0)
		return None;

	//the bits: mode byte (0100), the count, the bytes, terminator, padding
	bits = [];
	push_bits = [&bits](value, count) {
		for(i = count - 1; i >= 0; i--)
			bits.push_back(qr_bit(value, i));
	};
	push_bits(4, 4);
	push_bits(n, ver <= 9 ? 8 : 16);
	for(b : bytes)
		push_bits(b, 8);
	capacity = qr_data_codewords(ver, ecl) * 8;
	for(i = 0; i < 4 && bits.size() < capacity; i++)
		bits.push_back(0);
	for(bits.size() % 8 != 0)
		bits.push_back(0);
	data = [];
	for(i = 0; i < bits.size(); i += 8) {
		v = 0;
		for(j = 0; j < 8; j++)
			v = v * 2 + bits[i + j];
		data.push_back(v);
	}
	pad = 0xEC;
	for(data.size() < capacity / 8) {
		data.push_back(pad);
		pad = pad == 0xEC ? 0x11 : 0xEC;
	}

	size = ver * 4 + 17;
	m = qr_matrix(size);
	m.function_patterns(ver, ecl);
	m.codewords(qr_add_ecc(data, ver, ecl));

	best = 0;
	best_penalty = -1;
	for(mask = 0; mask < 8; mask++) {
		m.apply_mask(mask);
		m.format_bits(ecl, mask);
		p = m.penalty();
		if(best_penalty < 0 || p < best_penalty) {
			best = mask;
			best_penalty = p;
		}
		m.apply_mask(mask);
	}
	if(force_mask >= 0 && force_mask < 8)
		best = force_mask;
	m.apply_mask(best);
	m.format_bits(ecl, best);
	return [width = size, version = ver, level = QR_ECL_NAMES[ecl], mask = best, modules = m.modules];
}
