
import simpleaudio;
import ipc;

managed audio = simpleaudio.audio();
managed analyzer = audio.analyzer();
managed fft = audio.fft();

managed ipc_handle = ipc.ipc();
managed ipc_handle_in = ipc.ipc();

ipc_check_timeout = 0;

ipc_handle.connect(std.argv(1), false);
ipc_handle_in.connect(std.argv(1) + "_in", true);

ipc_handle_in.on_message([](msg) {
	
	analyzer.set_tempo(msg.fix_bpm);
	analyzer.break_treshold(msg.break_treshold);
	analyzer.drop_treshold(msg.drop_treshold);
	
	fft.band_smoothing(msg.band_smoothing);
	fft.attack(msg.attack);
	fft.decay(msg.decay);
	fft.release(msg.release);
	fft.noise_floor(msg.noise_floor);
	
	fft.low_cutoff(msg.low_cutoff);
	fft.high_cutoff(msg.high_cutoff);
	
	ipc_check_timeout = std.millis();
});
	

analyzer.on_beat([](){
	ipc_handle.send([
		type="beat",
	]);
});

audio.start(None, [](input_buffer){
	if(!ipc_handle.send([
		type="info",
		bpm=analyzer.bpm(),
		phase=analyzer.phase(),
		cum_score=analyzer.cum_score(),
		break_detected = analyzer.break_detected(),
		normalized_bands = fft.normalized_bands(),
		band_ema = fft.band_ema(),
		waveform = input_buffer.as_mono_list(),
		energy = [fft.low_energy(), fft.mid_energy(), fft.high_energy()],
	])) {
		std.print("IPC timeout.");
		std.exitprocess(0);
	}
},
[
	periodSize=512,
]);

for(1) {
	if(ipc_check_timeout && (std.millis() - ipc_check_timeout > 1000 * 3))
		std.print("Parent timeout.");
		std.exitprocess(0);
	
	std.sleep(1000);
}
