
import simpleaudio;
import ipc;

managed audio = simpleaudio.audio();
managed analyzer = audio.analyzer();
managed fft = audio.fft();

managed ipc_handle = ipc.ipc();
managed ipc_handle_in = ipc.ipc();

// The parent sends settings 4 times a second; 3 s without one and it is gone (crashed or killed). The clock runs
// from the start, with 10 s for the first message: a parent that dies before it (a crash while a project loads)
// left this process running forever on macOS, which has no PR_SET_PDEATHSIG (#555). A parent that stalls longer
// starts a new one from its render loop.
ipc_check_timeout = std.millis() + 7000;

// argv(2) == "external": no sound card, the parent sends the samples ("pcm" messages), e.g. the
// microphone or line-in of DJ Watch, the ESP32 formerly called prolink-bridge (USB or ShizoNet)
external = false;
if(std.argc() > 2)
	external = std.argv(2) == "external";
external_rate = 0;
WAVEFORM_SIZE = 512; // the parent's texture is 512 wide

// Both channels belong to the parent: it keeps them across restarts of this process (on Linux a channel
// created here would be replaced by every restart, and the parent would keep writing into the old one)
ipc_handle.connect(std.argv(1), false);
ipc_handle_in.connect(std.argv(1) + "_in", false);

send_info = [](input_buffer){
	waveform = input_buffer.as_mono_list();
	if(waveform.size() < WAVEFORM_SIZE && waveform.size() > 0) {
		// Shorter periods (external audio at 16/24 kHz): stretch to the texture width
		stretched = [];
		for(i = 0; i < WAVEFORM_SIZE; i++)
			stretched.push_back(waveform[std.int(i * waveform.size() / WAVEFORM_SIZE)]);
		waveform = stretched;
	}
	if(!ipc_handle.send([
		type="info",
		bpm=analyzer.bpm(),
		phase=analyzer.phase(),
		cum_score=analyzer.cum_score(),
		break_detected = analyzer.break_detected(),
		normalized_bands = fft.normalized_bands(),
		band_ema = fft.band_ema(),
		waveform = waveform,
		energy = [fft.low_energy(), fft.mid_energy(), fft.high_energy()],
	])) {
		std.print("IPC timeout.");
		std.exitprocess(0);
	}
};

ipc_handle_in.on_message([](msg) {
	
	if(msg.type == "pcm") {
		if(!external)
			return;
		// Same time resolution as a sound card at 48 kHz with 512 frames
		if(msg.rate != external_rate) {
			external_rate = msg.rate;
			period = 512;
			if(msg.rate < 44100)
				period = 256;
			audio.start_external(send_info, [sampleRate=msg.rate, periodSize=period]);
		}
		audio.feed(msg.data); // binary int16 little-endian mono
		return;
	}
	
	ipc_check_timeout = std.millis();
	
	// External audio: the analyzer only exists after the first samples (they bring the sample rate)
	if(external && !external_rate)
		return;
	
	analyzer.set_tempo(msg.fix_bpm);
	analyzer.break_treshold(msg.break_treshold);
	analyzer.drop_treshold(msg.drop_treshold);
	
	fft.band_smoothing(msg.band_smoothing);
	fft.attack(msg.attack);
	fft.decay(msg.decay);
	fft.release(msg.release);
	fft.noise_floor(msg.noise_floor);
	
	fft.low_cutoff(msg.low_cutoff);
	fft.high_cutoff(msg.high_cutoff);
});
	

analyzer.on_beat([](){
	ipc_handle.send([
		type="beat",
	]);
});

if(!external)
	audio.start(None, send_info, [
		periodSize=512,
	]);

for(1) {
	if(ipc_check_timeout && (std.millis() - ipc_check_timeout > 1000 * 3))
		std.print("Parent timeout.");
		std.exitprocess(0);
	
	std.sleep(1000);
}
