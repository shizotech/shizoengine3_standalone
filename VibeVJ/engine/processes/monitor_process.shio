
import nanogui;

monitor_id = std.int(std.argv(1));
is_fullscreen = std.int(std.argv(2));
spout_id = std.argv(3);

std.print("Monitor: " + spout_id);

ctx = nanogui.context();

screen = ctx.fullscreen(monitor_id, "shizoengine_output", is_fullscreen);

screen.decorated(0);

screen.should_close([](){
	std.exitprocess(0);
});

image = screen.spout_receiver(spout_id);
image.invert(true);
image.handshake(1);

//Kind of uneccessary really, but the scaling for the spout widget is somewhat completely off and I dont know why
//TODO: maybe atleast add some useful uniforms or something idk it feels so wrong
image.visible(false);
shadertoy_header = "uniform sampler2D in_texture;";
shadertoy_main = "void main(){ fragColor = texture(in_texture, v_uv); }";
shader = screen.shader();
shader.anchor(0);
shader.render_size(eigen.vec2i(screen.width(), screen.height()));
shader.fragment_source(shadertoy_header + shadertoy_main);
shader.input("in_texture", image);

std.sleep(-1);