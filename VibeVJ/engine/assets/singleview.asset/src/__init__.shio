
#include "engine/generators/singleview"

managed view = None;

ai_docs = R"(
This is a simple single view capable of holding one generator or sub-view.
)";

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return;
	}
	
	view.dispatch(cmd, value);

	return None;
}

entry(generator, parent) {
	view = singleview(parent);
	
	//Register as last focused for the AI agent, since clipview is usually instanced in a window, use the parent for parent_widget (so the headerbar can be clicked too)
	generator.on_get_status([this](){
		
		current_item = "No active item.";
		try {
			if(view.item) {
				current_item = [asset=view.item.get_relative_path(), live_path=view.item.node.get_full_path()];
			}
		}
		catch(e) {
		
		}
		
		return [
			current_item = current_item,
			explanation = ai_docs,
		];
	});
	
	generator.register("set_item", [path="Path to the asset or view"], [this](args){
		
		if(!args.has("path"))
			return [ok=false, error="Needs 'path' args."];
		
		new_item = view.add_generator(view.area, args.path);
		
		if(new_item) {		
			return [
				ok = true,
				status = "New generator was set.",
			];
		}
		
		return [
			ok = false,
			error = "Could not set generator.",
		];
		
	}, "DANGEROUS: Set the generators, clears anything that is currently on it.");
}

save_state() {
	return [
		view = view.save_state(),
	];
}

load_state(state) {
	view.load_state(state.view);
}