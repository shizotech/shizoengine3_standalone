// The build process of a Python environment (#853 step 3): VibeVJ starts it with shz (pyenv_for_script() in
// py_env.shio), so uv runs outside the render thread and a hang or a crash of it ends only this process.
//
//   shz py_env_build.shio <request.json>        the request: [root, python, dependencies, opts]
//   shz py_env_build.shio --uv-hashes [version]  prints PYENV_UV_BUILDS for that uv version (to update it)
//
// It writes lines for VibeVJ to stdout: "@status <what it does>", "@progress <the last line of uv>" and at the end
// "@result <json>" (pyenv_build()). Exit code 0 when the environment is ready.

#include "py_env"

if(std.argc() > 1 && std.argv(1) == "--uv-hashes") {
	version = std.argc() > 2 ? std.argv(2) : PYENV_UV_VERSION;
	failed = 0;
	std.print("PYENV_UV_VERSION = \"" + version + "\";");
	std.print("PYENV_UV_BUILDS = [");
	n = 0;
	for(target, build : PYENV_UV_BUILDS) {
		url = PYENV_UV_URL + version + "/" + build["archive"] + ".sha256";
		r = pyenv_run(["curl", "-L", "--fail", "--silent", "--show-error", url], None, "", None, 60000);
		h = std.string(std.string(r.out).strip().split(" ")[0]).lowercase();
		if(r.code !== 0 || h.length() != 64) {
			std.print("ERROR " + url + ": " + std.string(r.err).strip());
			failed++;
			continue;
		}
		n++;
		std.print("\t\"" + target + "\" = [\"archive\" = \"" + build["archive"] + "\", \"sha256\" = \"" + h + "\"]" +
			(n < PYENV_UV_BUILDS.size() ? "," : ""));
	}
	std.print("];");
	std.exitprocess(failed == 0 ? 0 : 1);
}

if(std.argc() < 2) {
	std.print("usage: shz py_env_build.shio <request.json> | --uv-hashes [version]");
	std.exitprocess(2);
}

req = fileio.read_json(std.argv(1));
res = pyenv_build(req["root"], req["python"], req["dependencies"] ?? [], req["opts"] ?? std.json(), [](kind, text) {
	std.print("@" + kind + " " + std.string(text).replace("\n", " "));
});
std.print("@result " + res.compact_string());
std.exitprocess(res.ok ? 0 : 1);
