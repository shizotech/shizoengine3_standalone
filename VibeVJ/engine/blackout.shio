//Blackout (#538): one switch that takes everything that leaves VibeVJ to black, and fades it back.
//- Video: nanogui.output_master() darkens the output screens (the Display output of a shader or of MapLab), the NDI of
//  every screen and shader and the Spout of every shader. The views in the program stay as they are, so you still see
//  what will come back.
//- Light: the fixtures (Devices > Fixtures) scale their brightness and colour channels by engine.env.output_master,
//  pan, tilt and the other channels stay where they are (moving heads do not swing). The LEDMappers scale their pixels.
//  ArtnetSender sends what it is given.
//- On: black at once. Off: back over fade_back seconds (Settings > Output > Blackout, kept in the style file).
//- Switched by the Blackout button of the timeline (MIDI-mappable, ID BLACKOUT), Ctrl+B, and works in show mode.

BLACKOUT_FADES = [0.0, 0.5, 1.0, 2.0, 4.0]; //the choices for fading back, in seconds
BLACKOUT_FADE_NAMES = ["At once", "0.5 s", "1 s", "2 s", "4 s"];

class blackout_switch
{
	engine = None;
	on = false;
	level = 1.0;       //what goes out now: 1 as it is, 0 black
	fade_back = 1.0;   //seconds from black back to full
	last_tick = 0;
	on_change = None;  //callback(on): the button follows a change by the key or by MIDI
	loading = false;   //a project loads: its saved Blackout button does not switch the outputs (load_project)

	__init__(engine) {
		this.engine = engine;
		engine.env.output_master = 1.0;
		style = engine.style;
		if(style.has("blackout_fade"))
			fade_back = std.float(style.blackout_fade);
		last_tick = std.millis();
	}

	toggle() {
		set(!on);
	}

	//After a project load: the button shows the state again, which the load did not change
	sync() {
		if(std.is_function(on_change))
			on_change(on);
	}

	set(value) {
		value = value ? true : false;
		if(value == on || loading)
			return;
		on = value;
		if(on)
			apply(0.0); //at once: a blackout is for when something goes wrong
		else if(fade_back <= 0.0)
			apply(1.0);
		if(std.is_function(on_change))
			on_change(on);
	}

	//Every frame (__init__.shio, pre render): the fade back
	tick() {
		now = std.millis();
		dt = (now - last_tick) / 1000.0;
		last_tick = now;
		target = on ? 0.0 : 1.0;
		if(level == target)
			return;
		step = fade_back > 0.0 ? dt / fade_back : 1.0;
		next = level < target ? math.min(target, level + step) : math.max(target, level - step);
		apply(next);
	}

	apply(value) {
		level = value;
		engine.env.output_master = value;
		nanogui.output_master(value); //needs the nanogui of #538 (a namespace function: checked when VibeVJ compiles)
		//The fixtures write on change only: every lamp once more with the new master
		if(engine.fixture_menu)
			engine.fixture_menu.refresh_all();
	}
}
