#strict
//A generator module with the old entry points, behind the contract of GeneratorModule (#202, PR 1.2 of
//_shizoengine3/REWRITE_PLAN.md). The old way stays for every asset that is not a class yet, built in or from the
//community: functions in the std.module of the asset (or of an extension, e.g. shader_loader.shio), each one optional:
//
//	save_state() / load_state(state)       the module's own data (state.data of the generator)
//	save_view() / load_view(view)          view only data (state.view)
//	dispatcher(generator, cmd, value)      generator.dispatch()
//	on_free()                              before the module goes
//
//This is the one place where the engine asks a module which functions it has; the rest of the engine calls the methods
//of GeneratorModule. entry() and update / update_pre / update_post are still run by the extension loaders.
#include "generator_module"

class LegacyModule : GeneratorModule
{
	module = None; //the std.module with the functions

	//Which functions the module has, looked up once (std.module has() is a lookup by name each time)
	has_save_state = false;
	has_load_state = false;
	has_save_view = false;
	has_load_view = false;
	has_dispatcher = false;
	has_on_free = false;

	__init__(any module, any generator) {
		this.module = module;
		this.generator = generator;
		this.node = generator ? generator.node : None;
		if(!module)
			return;
		has_save_state = module.has("save_state");
		has_load_state = module.has("load_state");
		has_save_view = module.has("save_view");
		has_load_view = module.has("load_view");
		has_dispatcher = module.has("dispatcher");
		has_on_free = module.has("on_free");
	}

	//The old modules build their controls in entry(), which their extension loader runs
	build(any generator, any node) {}

	any save_state() {
		if(!has_save_state)
			return None;
		return module.call("save_state");
	}

	load_state(any state) {
		if(has_load_state)
			module.call("load_state", state);
	}

	any save_view() {
		if(!has_save_view)
			return None;
		return module.call("save_view");
	}

	load_view(any view) {
		if(has_load_view)
			module.call("load_view", view);
	}

	on_free() {
		if(has_on_free)
			module.call("on_free");
	}

	//The old dispatcher gets every command, "active" too, and decides itself
	any dispatch(any cmd, any value) {
		if(!has_dispatcher)
			return None;
		return module.call("dispatcher", generator, cmd, value);
	}
}
