#strict
//The contract of a generator module (#202, _shizoengine3/REWRITE_PLAN.md §2, engine/contracts/README.md).
//
//An asset writes its generator as a class derived from GeneratorModule and exports create(generator, node), which
//returns an instance. The engine builds it with build(generator, node) and calls the other methods; the defaults below
//make every hook but build() optional, so nothing is "called if it exists" any more.
//
//	#include "engine/contracts/generator_module"
//	class Sine : GeneratorModule {
//		build(generator, node) { ... }
//		hooks() { return ["update"]; }
//		update(tl_pos, delta) { ... }
//	}
//	create(generator, node) { return Sine(); }
//
//An asset with the old entry points (entry, save_state, load_state, dispatcher, update, ...) keeps working: the
//engine wraps it in a LegacyModule (engine/contracts/legacy_module.shio).
//
//Mixins add the commands of other parts of the engine as methods: class Fx : GeneratorModule, VideoIO { ... }.

//The methods the engine calls on every generator module
GENERATOR_MODULE_METHODS = ["build", "save_state", "load_state", "save_view", "load_view", "dispatch", "on_free",
	"hooks", "update", "update_pre", "update_post"];

//The commands the engine still sends as strings through generator.dispatch(cmd, value), and whether the method of the
//same name takes the value (1) or nothing (0). GeneratorModule.dispatch() runs that method when the module has it.
GENERATOR_COMMANDS = [
	get_default_input = 0, get_default_output = 0, get_inputs = 0,
	set_input = 1, set_uniform = 1, set_render_callback = 1,
	transition = 1, clip_preview = 1, has_cell_preview = 0, draw_cell = 1,
	get_items = 0, get_item = 1, add_item = 1, on_items_changed = 1,
];

class GeneratorModule
{
	//The generator (engine/generators/generatoritem.shio) this module belongs to and its matrixnode, set by the engine
	//before build()
	generator = None;
	node = None;

	//Required: builds the controls of the module into node (widget.control* controls of a unique name + group)
	abstract build(generator, node) {}

	//Optional, the defaults do nothing
	any save_state() { return None; }   //the module's own data, saved as state.data of the generator
	load_state(any state) {}
	any save_view() { return None; }    //view only data (zoom, pan), saved as state.view
	load_view(any view) {}
	active(any on) {}                   //the power button of the generator (ACT)
	on_free() {}                        //before the module goes: free what it made outside its node

	//Which of update / update_pre / update_post the engine calls every frame; none by default, so a module without
	//them costs nothing per frame
	list<string> hooks() { return []; }
	update(any tl_pos, any delta) {}
	update_pre(any tl_pos, any delta) {}
	update_post() {}

	//generator.dispatch(cmd, value). "active" goes to active() (only while the power button is on, as the old
	//dispatchers did); a command of GENERATOR_COMMANDS to the method of the same name, when the module has one
	any dispatch(any cmd, any value) {
		if(cmd == "active") {
			if(value && generator && !generator.active_btn.value())
				return None;
			active(value);
			return None;
		}
		if(!GENERATOR_COMMANDS.has(cmd))
			return None;
		f = None;
		try {
			f = this[cmd];
		}
		catch(e) {
			return None;
		}
		if(GENERATOR_COMMANDS[cmd])
			return f(value);
		return f();
	}
}

//A module with a video input and output (shaders, video, images, the stack of a clip)
class VideoIO
{
	any get_default_input() { return None; }
	any get_default_output() { return None; }
	any get_inputs() { return None; }
	set_input(any value) {}
	set_uniform(any value) {}
	set_render_callback(any value) {}
}

//A module a clip can blend with: transitions between clips, the preview of a clip
class Transitionable
{
	transition(any value) {}
	clip_preview(any value) {}
	//The cell of a clip without a picture (no video output, #677): true when the module draws it, then draw_cell(size)
	//draws it with nvg every frame (0, 0 is the top left of the cell)
	any has_cell_preview() { return false; }
	draw_cell(any size) {}
}

//A module that holds other generators in an order (the stack of a clip)
class ItemStack
{
	any get_items() { return None; }
	any get_item(any index) { return None; }
	any add_item(any path) { return None; }
	on_items_changed(any callback) {}
}
