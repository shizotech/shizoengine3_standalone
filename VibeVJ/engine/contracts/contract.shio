#strict
//Checks an object against a contract by the names of its methods (#202, _shizoengine3/REWRITE_PLAN.md §2).
//
//An asset is its own std.module() program: when it #includes a contract class, it gets its own copy of that class.
//std.instanceof(obj, Class) with the class object of the engine is false for it, by name it is true. So the engine
//checks what it calls: that the methods are there, once, when the asset is loaded, instead of finding out in a frame.

//The names in `names` that are not a method of obj
list<string> contract_missing(any obj, list<string> names) {
	list<string> missing = [];
	for(i = 0; i < names.size(); i++) {
		ok = false;
		try {
			ok = std.is_function(obj[names[i]]);
		}
		catch(e) {}
		if(!ok)
			missing.push_back(names[i]);
	}
	return missing;
}

//"" when obj has every method of the contract, else the message for the log: what is missing, for whom
string contract_error(any obj, string contract, list<string> names, string who) {
	if(!obj)
		return who + ": no object for the contract " + contract;
	missing = contract_missing(obj, names);
	if(missing.size() == 0)
		return "";
	text = who + " does not fulfil the contract " + contract + ", missing:";
	for(i = 0; i < missing.size(); i++)
		text += " " + missing[i] + "()";
	return text;
}
