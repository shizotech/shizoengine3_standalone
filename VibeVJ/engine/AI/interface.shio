
class AIInterface {
	
	target = None;
	queries = [];
	source_file = "";
	
	__init__(parent, parent_widget, src_file = "") {
		target = parent;
		source_file = src_file;
		if(parent_widget) {
			parent_widget.on_focus([this](v){
				if(v)
					focus();
			});
		}
		
		if(source_file) {
			register("get_source_file", None, [this](value) {
				return source_file;
			});
		}
	}
	
	focus() {
		std.print(this);
		std.print(target);
		std.global("engine").ai_last_item = this;
	}
	
	on_get_status(callback) {
		register("get_target_status", None, [callback](v){
			callback();
		});
	}
	
	register(name, args, callback) {
		queries[name] = [args=args, callback=callback];	
	}
	
	query(name, args) {
		try {
			if(queries.has(name))
				cb = queries[name].callback;
				if(std.is_string(args))
					args = std.json(args);
				return cb(args);
		}
		catch(e) {
			return [
				ok=false,
				error="An error occured while executing this action.",
			];
		}
		return None;
	}
}