//The patch of a project (#439): which lamps there are, where they hang and how they are addressed.
//
//Pure data and logic, no UI: the fixture setup (Setup.menu), Devices > Fixtures, the Phaser and the LEDMapper all read
//and change the same JSON (engine.patch), saved as projects/<name>/fixture_setup.json.
//
//  patch = [
//    fixtures = [[id, name, type, node, universe, address, x, y, z, rotation, mount, (legacy_index)], ...],
//    groups   = [[id, name, fixtures = [id, ...]], ...],
//    nodes    = [[mac, ip, name], ...],
//  ]
//
//- type: path of the fixture file (assets/Fixtures/...json), always with "/".
//- node: MAC of the Art-Net node ("" = not sent anywhere yet). universe: Art-Net port-address 0-32767. address: DMX start
//  address 1-512, as on the lamp. No internal universes or patch layers: a lamp is "node > universe > address" and that
//  is what is shown everywhere.
//- x, y: where the lamp hangs on the stage plan, in metres from the middle (x to the right, y towards the audience).
//  z: height above the floor in metres (#655, the 3D view; 0 in projects before it). rotation in degrees (around the
//  vertical). mount: "floor" (standing, the beam goes up at tilt 0.5) or "hanging" (upside down on a truss).
//  lean (#669): degrees the lamp leans its beam towards its front (a bar on the floor angled at the audience, a head on a
//  side truss); 0 in projects before it.
//- groups are ordered lists of lamps: the order is the order of a phaser.
//- nodes: nodes added by hand (by IP), so a node that does not answer ArtPoll, or is not on the network yet, can be
//  patched. Nodes that answer ArtPoll are found by themselves and need no entry.
//- legacy_index: lamps of a project before #439 keep the IDs of their controls (MIDI mappings, links).

PATCH_UNIVERSE_SIZE = 512;
PATCH_ROOT = ""; //folder the paths of fixture types are relative to (the app runs in _shizoengine3; a test sets it)
PATCH_MAX_UNIVERSE = 32767;

//A list sorted by a key of its entries, stable (json.sort_by() sorts the keys of an object, not a list)
patch_sort_by(list, key) {
	out = [];
	for(i = 0; i < list.size(); i++) {
		e = list[i];
		j = out.size();
		for(j > 0 && out[j - 1][key] > e[key])
			j--;
		out.insert(j, e);
	}
	return out;
}

//Position of a value in a list, -1 if it is not in it
patch_index_of(list, value) {
	for(i = 0; i < list.size(); i++) {
		if(list[i] == value)
			return i;
	}
	return -1;
}

//Path with "/" (projects saved on Windows have "\")
patch_norm_path(path) {
	if(!path)
		return "";
	return std.string(path).replace("\\", "/");
}

patch_new() {
	return [fixtures = [], groups = [], nodes = []];
}

PATCH_MOUNTS = ["floor", "hanging"];

//What a lamp is, for how the plan and the 3D view draw it (#669): a moving head (pan / tilt), a bar (two or more colour
//pixels), a par (one colour) or a dimmer (only intensity). The fixture file can say it ("kind"), else it is guessed from
//the channels (patch_guess_kind).
PATCH_KINDS = ["head", "bar", "par", "dimmer"];
PATCH_KIND_LABELS = ["Moving head", "Bar", "Par", "Dimmer"];

//Keys a lamp of an older patch does not have yet (#655: height and mount for the 3D view)
patch_fixture_defaults(f) {
	if(!f.has("z") || std.is_none(f.z))
		f.z = 0.0;
	if(!f.has("rotation") || std.is_none(f.rotation))
		f.rotation = 0;
	if(!f.has("mount") || !PATCH_MOUNTS.has_value(f.mount))
		f.mount = "floor";
	if(!f.has("lean") || std.is_none(f.lean))
		f.lean = 0.0;
	return f;
}

//Missing lists of an empty or hand-written patch
patch_normalize(p) {
	if(!p.has("fixtures") || std.type(p.fixtures) != "json")
		p.fixtures = [];
	if(!p.has("groups") || std.type(p.groups) != "json")
		p.groups = [];
	if(!p.has("nodes") || std.type(p.nodes) != "json")
		p.nodes = [];
	for(i = 0; i < p.fixtures.size(); i++)
		patch_fixture_defaults(p.fixtures[i]);
	return p;
}

// =========================================================================
// Fixture types (the files in assets/Fixtures)
// =========================================================================

//Bytes of one entry of a channel by its type
patch_kind_bytes(kind) {
	if(kind == "16-bit")
		return 2;
	if(kind == "RGB")
		return 3;
	if(kind == "RGBW")
		return 4;
	return 1;
}

//What a channel does (#655), as the families of a lighting desk: the Phaser offers effects that fit (a circle for pan
//and tilt, a fade or a rainbow for a colour), the 3D view of the fixture setup turns the beams by pan and tilt.
//A channel of a fixture file can name it ("function"); without one it is guessed from its name and type.
PATCH_FUNCTIONS = ["dimmer", "pan", "tilt", "color", "colorwheel", "strobe", "gobo", "beam", "speed", "control", "other"];
PATCH_FUNCTION_LABELS = ["Dimmer", "Pan", "Tilt", "Colour mix", "Colour wheel", "Strobe / shutter", "Gobo / prism",
	"Beam (focus, zoom, frost)", "Speed", "Control (reset, mode)", "Other"];

//The function of a channel by its name ("PT Speed" is a speed, "ColorFrost" a beam channel, "COLOR" a colour wheel)
patch_guess_function(name, kind = "8-bit") {
	if(kind == "RGB" || kind == "RGBW")
		return "color";
	n = std.string(name).lowercase();
	if(n.contains("speed"))
		return "speed";
	if(n.contains("pan"))
		return "pan";
	if(n.contains("tilt"))
		return "tilt";
	if(n.contains("dim") || n.contains("intens") || n.contains("master") || n.contains("bright"))
		return "dimmer";
	if(n.contains("strobe") || n.contains("shutter"))
		return "strobe";
	if(n.contains("gobo") || n.contains("prism"))
		return "gobo";
	if(n.contains("frost") || n.contains("focus") || n.contains("zoom") || n.contains("iris"))
		return "beam";
	if(n.contains("color") || n.contains("colour") || n.contains("wheel"))
		return "colorwheel";
	if(n.contains("red") || n.contains("green") || n.contains("blue") || n.contains("white") || n.contains("amber") ||
		n.contains("lime") || n.contains("cyan") || n.contains("magenta") || n.contains("yellow") || n == "uv" ||
		n.starts("uv ") || n.ends(" uv"))
		return "color";
	if(n.contains("reset") || n.contains("mode") || n.contains("macro") || n.contains("control") || n.contains("function"))
		return "control";
	return "other";
}

//The function of a channel of a fixture file: its own, else the guess
patch_channel_function(chan) {
	kind = chan.has("type") ? chan.type : "8-bit";
	if(chan.has("function") && PATCH_FUNCTIONS.has_value(chan.function))
		return chan.function;
	return patch_guess_function(chan.name ?? "", kind);
}

//The value a control of a channel has when nothing else sets it (#669, "default" of the channel: 0..1, a list for the
//colours of RGB / RGBW), 0 when the file does not say
patch_channel_default(chan, comp) {
	if(!chan.has("default"))
		return 0.0;
	d = chan.default;
	if(std.is_list(d))
		return comp < d.size() ? math.clamp(std.float(d[comp]), 0.0, 1.0) : 0.0;
	return math.clamp(std.float(d), 0.0, 1.0);
}

//The 3D models of GDTF imports (#669, engine/patch/gdtf_mesh.shio), by path: read with the types, never while drawing
patch_mesh_store() {
	g = std.global("patch_mesh_cache");
	cache = g.get();
	if(std.is_none(cache)) {
		g.set(std.json());
		cache = g.get();
	}
	return cache;
}

//The largest side (metres) of the box around a model at rest (no pan, no tilt): how big it is drawn, with its yoke and
//head (the length of the type is its base only)
patch_mesh_extent(mesh) {
	world = [];
	lo = [0.0, 0.0, 0.0];
	hi = [0.0, 0.0, 0.0];
	first = true;
	for(i = 0; i < mesh.parts.size(); i++) {
		part = mesh.parts[i];
		a = part.m;
		if(part.parent >= 0 && part.parent < world.size()) {
			b = world[part.parent];
			c = [];
			for(r = 0; r < 3; r++) {
				for(k = 0; k < 4; k++) {
					v = b[r * 4] * a[k] + b[r * 4 + 1] * a[4 + k] + b[r * 4 + 2] * a[8 + k];
					if(k == 3)
						v += b[r * 4 + 3];
					c.push_back(v);
				}
			}
			a = c;
		}
		world.push_back(a);
		v = part.v;
		if(std.type(v) != "json")
			continue;
		for(j = 0; j + 2 < v.size(); j += 3) {
			for(r = 0; r < 3; r++) {
				w = a[r * 4] * v[j] + a[r * 4 + 1] * v[j + 1] + a[r * 4 + 2] * v[j + 2] + a[r * 4 + 3];
				if(first || w < lo[r])
					lo[r] = w;
				if(first || w > hi[r])
					hi[r] = w;
			}
			first = false;
		}
	}
	return math.max(hi[0] - lo[0], math.max(hi[1] - lo[1], hi[2] - lo[2]));
}

//A file next to a fixture file of a GDTF import: its model (.mesh, has "parts") or its wheels (.wheels, has "wheels");
//None without one. fresh: read it again (patch_reload_types)
patch_mesh(path, fresh = false, needs = "parts") {
	cache = patch_mesh_store();
	if(!fresh && cache.has(path))
		return cache[path];
	data = None;
	if(fileio.exists(PATCH_ROOT + path)) {
		try {
			data = fileio.read_json(PATCH_ROOT + path);
		}
		catch(e) {
			data = None;
		}
	}
	if(data && (std.type(data) != "json" || !data.has(needs) || !data[needs].size()))
		data = None;
	if(data && needs == "parts")
		data.extent = patch_mesh_extent(data); //(not "size": a method of JSON)
	cache[path] = data;
	return cache[path];
}

//The slot of its wheel a slot of a fixture type shows at value (0..1, as sent): [name, color [r, g, b], gobo (a mask,
//engine/patch/gdtf_zip.shio, "" for none)]; None when it has no wheel or is between slots (spinning, open)
patch_wheel_slot(t, slot_index, value) {
	if(!t.wheels || slot_index < 0 || slot_index >= t.slots.size())
		return None;
	w = t.slots[slot_index].wheel;
	if(!w)
		return None;
	wheel = None;
	for(candidate : t.wheels.wheels) {
		if(candidate.name == w.name)
			wheel = candidate;
	}
	if(!wheel)
		return None;
	n = 0;
	for(r : w.ranges) {
		if(r[0] > value + 0.000001)
			break;
		n = r[1];
	}
	if(n < 1 || n > wheel.slots.size())
		return None;
	return wheel.slots[n - 1];
}

//The cache of the parsed fixture types, shared by every module that includes this file (the engine, the fixture setup,
//the Phaser, the LEDMapper): std.global, not a global of the file
patch_type_store() {
	g = std.global("patch_type_cache");
	cache = g.get();
	if(std.is_none(cache)) {
		g.set([loads = 0, types = []]);
		cache = g.get();
	}
	return cache;
}

def patch_type_read(path);

//Reads the fixture files of the cached types again (after the fixture editor saved one or a GDTF import wrote some, when
//the setup opens), here and now: the cache is never empty in between. An empty cache made the next draw of the setup
//read the files, and a file read suspends the draw (fileio runs it on a thread): it went on after its frame, every
//nvg* call an error (#669).
patch_reload_types() {
	cache = patch_type_store();
	fresh = std.json();
	for(i = 0; i < cache.types.size(); i++) {
		path = cache.types.key(i);
		fresh[path] = patch_type_read(path);
	}
	cache.types = fresh;
}

//What a type of lamp is when its file does not say it (#669): pan or tilt make a moving head, two or more colour
//pixels a bar, one (or colour channels of one byte each, R G B in another order) a par, else a dimmer
patch_guess_kind(t) {
	if(t.moving)
		return "head";
	if(t.pixels >= 2)
		return "bar";
	if(t.pixels == 1)
		return "par";
	for(i = 0; i < t.slots.size(); i++) {
		if(t.slots[i].function == "color")
			return "par";
	}
	return "dimmer";
}

//The fixture file parsed and expanded:
//  [path, name, valid, footprint, channels, time (a new number each time the file is read), signature (of the
//   channels), has_color, moving (has pan or tilt), pan_range / tilt_range (degrees the head turns over 0..1),
//   beam_angle (degrees, for the 3D view), pixels (colour channels), kind (head, bar, par, dimmer: PATCH_KINDS, from
//   "kind" of the file or patch_guess_kind), length (metres: along a bar, else across the lamp), width (metres: across
//   a bar; "length" and "width" of the file when it has them, as a GDTF import writes them),
//   slots    = one per channel entry ([name, channel, sub, kind, offset, bytes, function, wheel (the slots of its
//              wheel by its value, "wheel" of the channel, or None)]); a channel with a count of 3 has 3,
//   controls = one per value ([label, slot, comp, offset, kind, function, default (0..1, the value it starts at)]): a
//              colour has one per component (R, G, B, W),
//   mesh (the 3D model of a GDTF import, None without one), pan_part / tilt_part (its parts pan and tilt turn, -1),
//   wheels (its colour and gobo wheels, patch_wheel_slot)]
//The order of `controls` is the order of the controls of a lamp in Devices > Fixtures and of the attributes of the Phaser.
//Read once and cached: no file access when it is cached, so it can be called while drawing.
patch_type(path) {
	path = patch_norm_path(path);
	cache = patch_type_store();
	if(cache.types.has(path))
		return cache.types[path];
	cache.types[path] = patch_type_read(path);
	return cache.types[path];
}

//The fixture file read and parsed (patch_type without the cache)
patch_type_read(path) {
	path = patch_norm_path(path);
	cache = patch_type_store();
	cache.loads++;
	t = [path = path, name = fileio.pure_name(path), valid = false, footprint = 0, channels = [], slots = [], controls = [],
		time = cache.loads, has_color = false, moving = false, pan_range = 540.0, tilt_range = 270.0, beam_angle = 0.0,
		virtual = false];
	file = PATCH_ROOT + path;
	conf = None;
	if(path && fileio.exists(file)) {
		try {
			conf = fileio.read_json(file);
		}
		catch(e) {
			conf = None;
		}
	}
	if(conf && std.type(conf) == "json" && conf.has("channels") && std.type(conf.channels) == "json") {
		t.valid = true;
		t.channels = conf.channels;
	}
	else if(conf && std.type(conf) == "json" && conf.has("type") && conf.type == "fixture")
		t.valid = true; //a fixture without channels yet (new in the editor)

	offset = 0;
	for(k = 0; k < t.channels.size(); k++) {
		chan = t.channels[k];
		kind = chan.has("type") ? chan.type : "8-bit";
		bytes = patch_kind_bytes(kind);
		count = chan.has("batch_count") ? math.max(1, std.int(chan.batch_count)) : 1;
		func = patch_channel_function(chan);
		if(func == "pan" || func == "tilt")
			t.moving = true;
		for(h = 0; h < count; h++) {
			slot_name = chan.name;
			if(h > 0)
				slot_name += " (" + (h + 1) + ")";
			slot_index = t.slots.size();
			t.slots.push_back([name = slot_name, channel = k, sub = h, kind = kind, offset = offset, bytes = bytes, function = func,
				wheel = chan.has("wheel") && std.type(chan.wheel) == "json" && chan.wheel.has("ranges") ? chan.wheel : None]);
			//Labels as the Phaser always named them ("RGB - R", "RGB - R (2)")
			suffix = count > 1 ? " (" + (h + 1) + ")" : "";
			if(kind == "RGB" || kind == "RGBW") {
				t.has_color = true;
				comps = kind == "RGB" ? ["R", "G", "B"] : ["R", "G", "B", "W"];
				for(c = 0; c < comps.size(); c++)
					t.controls.push_back([label = chan.name + " - " + comps[c] + suffix, slot = slot_index, comp = c, offset = offset + c,
						kind = kind, function = func, default = patch_channel_default(chan, c)]);
			}
			else
				t.controls.push_back([label = chan.name + suffix, slot = slot_index, comp = 0, offset = offset, kind = kind, function = func,
					default = patch_channel_default(chan, 0)]);
			offset += bytes;
		}
	}
	t.footprint = offset;
	//How the lamp moves and how wide its beam is (#655): the fixture file can tell, else what most moving heads do
	if(conf && std.type(conf) == "json") {
		if(conf.has("pan_range") && std.float(conf.pan_range) > 0.0)
			t.pan_range = std.float(conf.pan_range);
		if(conf.has("tilt_range") && std.float(conf.tilt_range) > 0.0)
			t.tilt_range = std.float(conf.tilt_range);
		if(conf.has("beam_angle") && std.float(conf.beam_angle) > 0.0)
			t.beam_angle = std.float(conf.beam_angle);
		//A virtual lamp (a zone of a projection, a MapLab slice): it needs no node, the Phaser and the fixture controls
		//move it like a real lamp and MapLab or FixtureState show what it does
		if(conf.has("virtual") && conf.virtual)
			t.virtual = true;
	}
	//Pan and tilt of a virtual lamp move a slice of MapLab, not a beam (#719): the 3D view and FixtureState treat it as
	//a lamp that does not move. The Phaser still offers Position for it (fx_attributes looks at the functions)
	if(t.virtual)
		t.moving = false;
	if(t.beam_angle <= 0.0)
		t.beam_angle = t.moving ? 15.0 : 30.0;
	//What it is and how big (#669)
	t.pixels = 0;
	for(i = 0; i < t.slots.size(); i++) {
		if(t.slots[i].kind == "RGB" || t.slots[i].kind == "RGBW")
			t.pixels++;
	}
	t.kind = patch_guess_kind(t);
	if(conf && std.type(conf) == "json" && conf.has("kind") && PATCH_KINDS.has_value(conf.kind))
		t.kind = conf.kind;
	t.length = t.kind == "bar" ? math.max(0.6, t.pixels * 0.12) : 0.5; //metres
	t.width = t.kind == "bar" ? 0.22 : t.length;
	//the size the file gives (a GDTF import: the model of the lamp)
	if(conf && std.type(conf) == "json") {
		if(conf.has("length") && std.float(conf.length) > 0.0)
			t.length = math.clamp(std.float(conf.length), 0.05, 20.0);
		if(conf.has("width") && std.float(conf.width) > 0.0)
			t.width = math.clamp(std.float(conf.width), 0.02, 20.0);
		else if(t.kind != "bar")
			t.width = t.length;
	}
	//The 3D model of a GDTF import (#669): the parts pan and tilt turn
	t.mesh = None;
	t.wheels = None;
	t.pan_part = -1;
	t.tilt_part = -1;
	if(conf && std.type(conf) == "json" && conf.has("gdtf") && std.type(conf.gdtf) == "json" && conf.gdtf.has("mesh") && conf.gdtf.mesh) {
		dir = fileio.file_dir(path);
		t.mesh = patch_mesh((dir ? dir + "/" : "") + conf.gdtf.mesh, true);
	}
	if(conf && std.type(conf) == "json" && conf.has("gdtf") && std.type(conf.gdtf) == "json" && conf.gdtf.has("wheels") &&
		conf.gdtf.wheels) {
		dir = fileio.file_dir(path);
		t.wheels = patch_mesh((dir ? dir + "/" : "") + conf.gdtf.wheels, true, "wheels");
	}
	if(t.mesh) {
		if(conf.gdtf.has("pan_part") && std.type(conf.gdtf.pan_part) != "string")
			t.pan_part = std.int(conf.gdtf.pan_part);
		if(conf.gdtf.has("tilt_part") && std.type(conf.gdtf.tilt_part) != "string")
			t.tilt_part = std.int(conf.gdtf.tilt_part);
	}
	//Changes only when the channels change: what the controls of a lamp are built from. Not the start values ("default"):
	//a changed signature builds the lamps again, and a lamp that is there keeps its values when only a start value changes
	sig = t.valid ? "v" : "x";
	for(i = 0; i < t.controls.size(); i++)
		sig += "|" + t.controls[i].label + ":" + t.controls[i].kind;
	t.signature = sig;
	return t;
}

//The size of a lamp on the stage in metres (#669): [kind, bar (drawn long), length (along its rotation), width]
patch_lamp_size(f) {
	t = patch_type(f.type);
	if(t.kind == "bar")
		return [kind = t.kind, bar = true, length = t.length, width = t.width];
	return [kind = t.kind, bar = false, length = t.length, width = t.width];
}

//A lamp of a virtual type (a projection zone): it needs no node
patch_is_virtual(f) {
	return f && patch_type(f.type).virtual;
}

//The fixture type of the virtual lamps MapLab makes for its slices
PATCH_VIRTUAL_TYPE = "assets/Fixtures/Virtual/ProjectionZone.json";

//Channels a lamp of this type takes (at least 1, so a lamp of a missing type still has an address)
patch_footprint(path) {
	return math.max(1, patch_type(path).footprint);
}

//The first slot of a colour (RGB / RGBW), or None: what the LEDMapper writes pixels into
patch_pixel_slots(path) {
	t = patch_type(path);
	list = [];
	for(i = 0; i < t.slots.size(); i++) {
		if(t.slots[i].kind == "RGB" || t.slots[i].kind == "RGBW")
			list.push_back(t.slots[i]);
	}
	return list;
}

// =========================================================================
// Lamps
// =========================================================================

patch_find(p, id) {
	for(i = 0; i < p.fixtures.size(); i++) {
		if(p.fixtures[i].id == id)
			return p.fixtures[i];
	}
	return None;
}

patch_index(p, id) {
	for(i = 0; i < p.fixtures.size(); i++) {
		if(p.fixtures[i].id == id)
			return i;
	}
	return -1;
}

//Last channel of a lamp (its address range is address .. patch_end(f))
patch_end(f) {
	return f.address + patch_footprint(f.type) - 1;
}

//Two lamps that send to the same channels
patch_overlaps(a, b) {
	if(a.id == b.id || !a.node || a.node != b.node || a.universe != b.universe)
		return false;
	return a.address <= patch_end(b) && b.address <= patch_end(a);
}

//Problems of the patch as [id = [text, ...]]: lamps on the same channels, lamps past channel 512, lamps without a node
patch_problems(p) {
	problems = [];
	for(i = 0; i < p.fixtures.size(); i++) {
		f = p.fixtures[i];
		list = [];
		if(!f.node && !patch_is_virtual(f))
			list.push_back("No node");
		if(f.address < 1 || patch_end(f) > PATCH_UNIVERSE_SIZE)
			list.push_back("Past channel 512");
		for(j = 0; j < p.fixtures.size(); j++) {
			if(i != j && patch_overlaps(f, p.fixtures[j]))
				list.push_back("Same channels as " + p.fixtures[j].name);
		}
		if(list.size())
			problems[f.id] = list;
	}
	return problems;
}

//Two lamps on the same channels (the problem that matters most: the No-node and range problems are visible in the list)
patch_conflicts(p) {
	ids = [];
	for(i = 0; i < p.fixtures.size(); i++) {
		for(j = i + 1; j < p.fixtures.size(); j++) {
			if(patch_overlaps(p.fixtures[i], p.fixtures[j])) {
				ids[p.fixtures[i].id] = true;
				ids[p.fixtures[j].id] = true;
			}
		}
	}
	return ids;
}

//The 512 channels of a universe of a node: "" free, the id of the lamp, or "!" where two lamps meet
patch_universe_map(p, node, universe) {
	map = [];
	map.resize(PATCH_UNIVERSE_SIZE);
	for(c = 0; c < PATCH_UNIVERSE_SIZE; c++)
		map[c] = "";
	for(i = 0; i < p.fixtures.size(); i++) {
		f = p.fixtures[i];
		if(f.node != node || f.universe != universe)
			continue;
		last = math.min(patch_end(f), PATCH_UNIVERSE_SIZE);
		for(c = math.max(1, f.address); c <= last; c++) {
			map[c - 1] = map[c - 1] ? "!" : f.id;
		}
	}
	return map;
}

//First address from `from` on where `footprint` channels are free (ignoring the lamps in `skip`), going on into the next
//universes. Returns [universe, address]. A lamp never spans two universes.
patch_next_free(p, node, universe, footprint, from = 1, skip = []) {
	footprint = math.max(1, footprint);
	for(u = universe; u <= PATCH_MAX_UNIVERSE; u++) {
		used = [];
		used.resize(PATCH_UNIVERSE_SIZE + 1);
		for(i = 0; i < p.fixtures.size(); i++) {
			f = p.fixtures[i];
			if(f.node != node || f.universe != u || skip.has_value(f.id))
				continue;
			last = math.min(patch_end(f), PATCH_UNIVERSE_SIZE);
			for(c = math.max(1, f.address); c <= last; c++)
				used[c] = 1;
		}
		start = u == universe ? math.max(1, from) : 1;
		run = 0;
		for(c = start; c <= PATCH_UNIVERSE_SIZE; c++) {
			if(used[c]) {
				run = 0;
				continue;
			}
			run++;
			if(run == footprint)
				return [universe = u, address = c - footprint + 1];
		}
	}
	return [universe = universe, address = 1];
}

//Name for the next lamp of a type: "Hexapad 3" (the number after the highest one in use)
patch_next_name(p, type_name) {
	highest = 0;
	for(i = 0; i < p.fixtures.size(); i++) {
		n = std.string(p.fixtures[i].name);
		if(n.starts(type_name + " ")) {
			rest = n.substr(type_name.length() + 1);
			num = 0;
			try {
				num = std.int(rest);
			}
			catch(e) {
				num = 0;
			}
			if(num > highest)
				highest = num;
		}
	}
	return type_name + " " + (highest + 1);
}

//Adds `count` lamps of a type. address 0: the next free addresses from universe on (each lamp after the one before).
//They are put in a row from (x, y) on, one metre apart. Returns the new lamps.
patch_add(p, type, count = 1, node = "", universe = 0, address = 0, x = 0.0, y = 0.0) {
	type = patch_norm_path(type);
	t = patch_type(type);
	footprint = patch_footprint(type);
	added = [];
	next = [universe = universe, address = address > 0 ? address : 1];
	for(n = 0; n < count; n++) {
		if(address <= 0 || n > 0 || !node)
			next = patch_next_free(p, node, next.universe, footprint, next.address);
		f = [
			id = std.random_hash(),
			name = patch_next_name(p, t.name),
			type = type,
			node = node,
			universe = next.universe,
			address = next.address,
			x = x + n,
			y = y,
			z = 0.0,
			rotation = 0,
			mount = "floor",
			lean = 0.0,
		];
		p.fixtures.push_back(f);
		added.push_back(p.fixtures[-1]);
		next = [universe = f.universe, address = f.address + footprint];
	}
	return added;
}

//Gives the lamps (ids, in this order) one address after the other from (node, universe, address) on, the first free ones
//where address is 0. Lamps that are not in the list keep their addresses.
patch_readdress(p, ids, node, universe, address = 0) {
	next = [universe = universe, address = math.max(1, address)];
	for(i = 0; i < ids.size(); i++) {
		f = patch_find(p, ids[i]);
		if(!f)
			continue;
		footprint = patch_footprint(f.type);
		if(address <= 0 || next.address + footprint - 1 > PATCH_UNIVERSE_SIZE)
			next = patch_next_free(p, node, next.universe, footprint, next.address, ids);
		f.node = node;
		f.universe = next.universe;
		f.address = next.address;
		next = [universe = f.universe, address = f.address + footprint];
	}
}

//Removes lamps (and takes them out of the groups)
patch_remove(p, ids) {
	for(i = p.fixtures.size() - 1; i >= 0; i--) {
		if(ids.has_value(p.fixtures[i].id))
			p.fixtures.erase(i);
	}
	for(g = 0; g < p.groups.size(); g++) {
		list = p.groups[g].fixtures;
		for(i = list.size() - 1; i >= 0; i--) {
			if(ids.has_value(list[i]))
				list.erase(i);
		}
	}
}

//New lamps with the same type, node and settings, the next free addresses and one metre lower on the plan
patch_duplicate(p, ids) {
	added = [];
	for(i = 0; i < ids.size(); i++) {
		f = patch_find(p, ids[i]);
		if(!f)
			continue;
		copy = f.copy();
		copy.id = std.random_hash();
		copy.name = patch_next_name(p, patch_type(f.type).name);
		if(copy.has("legacy_index"))
			copy.erase("legacy_index");
		copy.y = f.y + 1;
		next = patch_next_free(p, f.node, f.universe, patch_footprint(f.type), f.address);
		copy.universe = next.universe;
		copy.address = next.address;
		p.fixtures.push_back(copy);
		added.push_back(p.fixtures[-1]);
	}
	return added;
}

patch_fixtures_of_type(p, type) {
	type = patch_norm_path(type);
	list = [];
	for(i = 0; i < p.fixtures.size(); i++) {
		if(p.fixtures[i].type == type)
			list.push_back(p.fixtures[i]);
	}
	return list;
}

//The fixture types in use, in the order they first appear
patch_types(p) {
	list = [];
	for(i = 0; i < p.fixtures.size(); i++) {
		if(!list.has_value(p.fixtures[i].type))
			list.push_back(p.fixtures[i].type);
	}
	return list;
}

//"U0 · 1-12" (or "No node")
patch_address_text(f) {
	text = "U" + f.universe + " · " + f.address;
	end = patch_end(f);
	if(end != f.address)
		text += "–" + end;
	return text;
}

// =========================================================================
// Groups
// =========================================================================

patch_group(p, id) {
	for(i = 0; i < p.groups.size(); i++) {
		if(p.groups[i].id == id)
			return p.groups[i];
	}
	return None;
}

patch_group_add(p, name, ids = []) {
	g = [id = std.random_hash(), name = name, fixtures = ids.copy()];
	p.groups.push_back(g);
	return p.groups[-1];
}

patch_group_remove(p, id) {
	for(i = 0; i < p.groups.size(); i++) {
		if(p.groups[i].id == id) {
			p.groups.erase(i);
			return true;
		}
	}
	return false;
}

//The lamps a target of a phaser or LEDMapper names, in their order:
//  "group:<id>"  the lamps of a group
//  "type:<path>" every lamp of a fixture type (in the order of the patch)
//  "fixture:<id>" one lamp
patch_target_fixtures(p, target) {
	list = [];
	if(!target)
		return list;
	target = std.string(target);
	if(target.starts("group:")) {
		g = patch_group(p, target.substr(6));
		if(!g)
			return list;
		for(i = 0; i < g.fixtures.size(); i++) {
			f = patch_find(p, g.fixtures[i]);
			if(f)
				list.push_back(f);
		}
	}
	else if(target.starts("type:"))
		list = patch_fixtures_of_type(p, target.substr(5));
	else if(target.starts("fixture:")) {
		f = patch_find(p, target.substr(8));
		if(f)
			list.push_back(f);
	}
	return list;
}

//What a target is called in a list
patch_target_name(p, target) {
	if(!target)
		return "";
	target = std.string(target);
	if(target.starts("group:")) {
		g = patch_group(p, target.substr(6));
		return g ? g.name : "(deleted group)";
	}
	if(target.starts("type:"))
		return "All " + fileio.pure_name(target.substr(5));
	if(target.starts("fixture:")) {
		f = patch_find(p, target.substr(8));
		return f ? f.name : "(deleted lamp)";
	}
	return target;
}

//Every target there is: the groups, then one entry per fixture type in use
patch_targets(p) {
	list = [];
	for(i = 0; i < p.groups.size(); i++)
		list.push_back([id = "group:" + p.groups[i].id, name = p.groups[i].name]);
	types = patch_types(p);
	for(i = 0; i < types.size(); i++)
		list.push_back([id = "type:" + types[i], name = "All " + fileio.pure_name(types[i])]);
	return list;
}

//Index of a control of a type by its label, -1 if the type has none of that name
patch_control_index(type, label) {
	t = patch_type(type);
	for(i = 0; i < t.controls.size(); i++) {
		if(t.controls[i].label == label)
			return i;
	}
	return -1;
}

//The attributes the lamps of a target have in common, by label (the `controls` of their types), in the order of the first
//lamp: [[label, kind, function], ...]
patch_target_attributes(p, target) {
	lamps = patch_target_fixtures(p, target);
	list = [];
	if(!lamps.size())
		return list;
	first = patch_type(lamps[0].type);
	for(i = 0; i < first.controls.size(); i++) {
		label = first.controls[i].label;
		everywhere = true;
		for(j = 1; j < lamps.size(); j++) {
			if(patch_control_index(lamps[j].type, label) < 0) {
				everywhere = false;
				break;
			}
		}
		if(everywhere)
			list.push_back([label = label, kind = first.controls[i].kind, function = first.controls[i].function]);
	}
	return list;
}

// =========================================================================
// Nodes added by hand
// =========================================================================

patch_node_add(p, ip, name = "", mac = "") {
	for(i = 0; i < p.nodes.size(); i++) {
		if(p.nodes[i].ip == ip) {
			if(name)
				p.nodes[i].name = name;
			if(mac)
				p.nodes[i].mac = mac;
			return p.nodes[i];
		}
	}
	p.nodes.push_back([ip = ip, name = name, mac = mac]);
	return p.nodes[-1];
}

//Art-Net nodes that answered (net: engine.net), then the ones added by hand that did not: [[mac, name, ip, online]]
patch_known_nodes(net, p) {
	list = [];
	seen = [];
	devs = net ? net.artnet_devices() : [];
	for(i = 0; i < devs.size(); i++) {
		dev = devs[i];
		mac = dev.mac();
		if(!mac || seen.has(mac))
			continue;
		seen[mac] = true;
		list.push_back([mac = mac, name = dev.name() ?? mac, ip = dev.ip() ?? "", online = dev.online()]);
	}
	for(i = 0; i < p.nodes.size(); i++) {
		n = p.nodes[i];
		if(!n.mac || seen.has(n.mac))
			continue;
		seen[n.mac] = true;
		list.push_back([mac = n.mac, name = n.name ? n.name : n.ip, ip = n.ip, online = false]);
	}
	return list;
}

//Name of a node: given by hand, else what the node calls itself, else its MAC
patch_node_name(net, p, mac) {
	if(!mac)
		return "No node";
	for(i = 0; i < p.nodes.size(); i++) {
		if(p.nodes[i].mac == mac && p.nodes[i].name)
			return p.nodes[i].name;
	}
	dev = net ? net.find_artnet_device(mac) : None;
	if(dev && dev.name())
		return dev.name();
	return mac;
}

// =========================================================================
// The stage plan
// =========================================================================

//Bounds of lamps on the plan [min_x, min_y, max_x, max_y] (None without lamps)
patch_bounds(lamps) {
	if(!lamps.size())
		return None;
	b = [min_x = lamps[0].x, min_y = lamps[0].y, max_x = lamps[0].x, max_y = lamps[0].y];
	for(i = 1; i < lamps.size(); i++) {
		b.min_x = math.min(b.min_x, lamps[i].x);
		b.min_y = math.min(b.min_y, lamps[i].y);
		b.max_x = math.max(b.max_x, lamps[i].x);
		b.max_y = math.max(b.max_y, lamps[i].y);
	}
	return b;
}

//Arranges lamps (in this order) around their middle: "row" (a line, `spacing` apart), "grid" (rows of `columns`) or "circle"
patch_arrange(lamps, shape, spacing = 1.0, columns = 4) {
	n = lamps.size();
	if(n == 0)
		return;
	b = patch_bounds(lamps);
	cx = (b.min_x + b.max_x) / 2.0;
	cy = (b.min_y + b.max_y) / 2.0;
	columns = math.max(1, columns);
	for(i = 0; i < n; i++) {
		f = lamps[i];
		if(shape == "grid") {
			rows = std.int((n + columns - 1) / columns);
			col = i % columns;
			row = std.int(i / columns);
			f.x = cx + (col - (math.min(n, columns) - 1) / 2.0) * spacing;
			f.y = cy + (row - (rows - 1) / 2.0) * spacing;
		}
		else if(shape == "circle") {
			radius = math.max(spacing, spacing * n / (2.0 * math.PI));
			a = 2.0 * math.PI * i / n - math.PI / 2.0;
			f.x = cx + math.cos(a) * radius;
			f.y = cy + math.sin(a) * radius;
			f.rotation = std.int(a * 180.0 / math.PI + 90.0);
		}
		else {
			f.x = cx + (i - (n - 1) / 2.0) * spacing;
			f.y = cy;
		}
	}
}

//Where a lamp lies for a phaser, 0..1 over the lamps of a target:
//  "index" (their order), "left" (left to right), "right", "center" (from the middle out), "outside" (from the outside in),
//  "front" (front to back), "back"
patch_spread(lamps, mode) {
	n = lamps.size();
	shares = [];
	shares.resize(n);
	if(n <= 1) {
		for(i = 0; i < n; i++)
			shares[i] = 0.0;
		return shares;
	}
	b = patch_bounds(lamps);
	cx = (b.min_x + b.max_x) / 2.0;
	cy = (b.min_y + b.max_y) / 2.0;
	span_x = b.max_x - b.min_x;
	span_y = b.max_y - b.min_y;
	max_dist = 0.0;
	for(i = 0; i < n; i++) {
		dx = lamps[i].x - cx;
		dy = lamps[i].y - cy;
		max_dist = math.max(max_dist, math.sqrt(dx * dx + dy * dy));
	}
	for(i = 0; i < n; i++) {
		f = lamps[i];
		s = i / std.float(n - 1);
		if(mode == "left")
			s = span_x > 0.0 ? (f.x - b.min_x) / span_x : s;
		else if(mode == "right")
			s = span_x > 0.0 ? 1.0 - (f.x - b.min_x) / span_x : 1.0 - s;
		else if(mode == "back")
			s = span_y > 0.0 ? (f.y - b.min_y) / span_y : s;
		else if(mode == "front")
			s = span_y > 0.0 ? 1.0 - (f.y - b.min_y) / span_y : 1.0 - s;
		else if(mode == "center" || mode == "outside") {
			dx = f.x - cx;
			dy = f.y - cy;
			d = max_dist > 0.0 ? math.sqrt(dx * dx + dy * dy) / max_dist : 0.0;
			s = mode == "center" ? d : 1.0 - d;
		}
		shares[i] = s;
	}
	return shares;
}

// =========================================================================
// The format before #439 (fixture_setup.json of project format 2 and older)
// =========================================================================

//Old: [<fixture path> = [path, instances = [[name, device_mac, device_ip, universe, start_channel, batch_count,
//uv_pos = [x, y] (-1..1 on the grid), uv_size]]]]. An instance with a count of n were n lamps one after the other.
//Each lamp keeps its old position in the list of its type (legacy_index): the IDs of its controls stay the same.
patch_from_legacy(old) {
	p = patch_new();
	if(!old || std.type(old) != "json")
		return p;
	if(old.has("fixtures") && old.has("groups"))
		return patch_normalize(old); //already the new format

	stage_half = 11.0; //the old grid was 22 cells of 100 px; one cell is one metre now
	for(i = 0; i < old.size(); i++) {
		entry = old[i];
		if(std.type(entry) != "json")
			continue;
		type = patch_norm_path(entry.has("path") ? entry.path : old.key(i));
		footprint = patch_footprint(type);
		type_name = fileio.pure_name(type);
		instances = entry.has("instances") ? entry.instances : [];
		index = 0;
		for(j = 0; j < instances.size(); j++) {
			inst = instances[j];
			count = inst.has("batch_count") ? math.max(1, std.int(inst.batch_count)) : 1;
			x = 0.0;
			y = 0.0;
			if(inst.has("uv_pos") && std.type(inst.uv_pos) == "json") {
				x = inst.uv_pos.x * stage_half;
				y = inst.uv_pos.y * stage_half;
			}
			else {
				x = index;
				y = p.fixtures.size() ? 2.0 * i : 0.0;
			}
			mac = inst.has("device_mac") ? std.string(inst.device_mac) : "";
			if(mac == "<none>")
				mac = "";
			if(mac && inst.has("device_ip") && inst.device_ip && inst.device_ip != "<none>")
				patch_node_add(p, inst.device_ip, "", mac);
			base = inst.has("name") && inst.name ? std.string(inst.name) : type_name + " " + (j + 1);
			for(k = 0; k < count; k++) {
				name = base;
				if(count > 1)
					name += " (" + (k + 1) + ")";
				p.fixtures.push_back([
					id = std.random_hash(),
					name = name,
					type = type,
					node = mac,
					universe = inst.has("universe") ? std.int(inst.universe) : 0,
					address = (inst.has("start_channel") ? std.int(inst.start_channel) : 0) + 1 + footprint * k,
					x = x + k,
					y = y,
					rotation = 0,
					legacy_index = index,
				]);
				index++;
			}
		}
	}
	return p;
}

//Group of a control of a lamp in Devices > Fixtures: a lamp from before #439 keeps its old one (the position of the lamp in
//the list of its type), so MIDI mappings and links of old projects still find their control
patch_control_group(f, channel_name, channel_index) {
	if(f.has("legacy_index"))
		return channel_name + "_" + channel_index + "_" + f.legacy_index;
	return channel_name + "_" + channel_index + "_" + f.id;
}
