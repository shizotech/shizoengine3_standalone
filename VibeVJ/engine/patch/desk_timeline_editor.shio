//The effect timeline of a cue in the Programmer (#755, the logic in engine/patch/desk.shio): keyframes and waveforms
//per lamps x attribute, played while the stack plays the cue.
//
//  +----------------------------------------------------------------------------------------------------+
//  | Cue [1 · Intro v]  Beats [8]  [Loop]  Attribute [Dimmer v]  [+ Add lane]                       |
//  +-----------------------------+----------------------------------------------------------------------+
//  | Front pars · Dimmer      x  |  |    o--------o          |           o                |              |
//  | [Keys v] Beats 4            |  |   /          \         |          /                 |  (playhead)  |
//  | Depth 0.5 Mid 0.5 Spread 0  |  o-/            o--------o---------/                  |              |
//  +-----------------------------+----------------------------------------------------------------------+
//
//- A click on the empty part of a lane sets a key there (the beat snaps to a quarter, Shift: free; the height is the
//  value; a colour lane takes the colour the programmer has for its first lamp, else white). Drag a key to move it,
//  right click it to change its curve to the next key (step, linear, smooth), Ctrl+click it to delete it.
//- A lane with a waveform (Keys -> Sine, Saw, ...) draws the wave instead of its keys.
//- The playhead shows where the cue plays now when its stack plays it.
//- Every change is a step of the undo history (a drag: one step when the mouse is let go).
//Needs engine/patch/desk.shio and engine/patch/palette.shio included before it.

DTE_ROW = 28;
DTE_GAP = 4;
DTE_LANE_H = 92;
DTE_CTRL_W = 300;
DTE_PAD = 8;          //space left and right of the beats in a lane
DTE_HIT = 8;          //pixels a click may be away from a key
DTE_ATTRS = ["dimmer", "color", "pan", "tilt", "strobe", "zoom"];
DTE_ATTR_LABELS = ["Dimmer", "Colour", "Pan", "Tilt", "Strobe", "Zoom"];
DTE_WAVE_LABELS = ["Keys", "Sine", "Saw", "Square", "Triangle", "Random"];
DTE_MOD_SHIFT = 1;
DTE_MOD_CTRL = 2;

//Where v is in list, -1 for nowhere
dte_index(list, v) {
	for(i = 0; i < list.size(); i++) {
		if(list[i] == v)
			return i;
	}
	return -1;
}

//What a lane moves, for its title: the group or lamp by name, All lamps, or "3 lamps"
dte_target_name(p, target) {
	t = std.string(target);
	if(t == "all")
		return "All lamps";
	if(t.starts("group:")) {
		for(i = 0; i < p.groups.size(); i++) {
			if(p.groups[i].id == t.substr(6))
				return p.groups[i].name;
		}
	}
	if(t.starts("lamp:")) {
		f = patch_find(p, t.substr(5));
		if(f)
			return f.name;
	}
	n = desk_target_ids(p, t).size();
	return n + (n == 1 ? " lamp" : " lamps");
}

//"Dimmer" for "dimmer", the label of a channel for "label:<label>"
dte_attr_label(attr) {
	a = std.string(attr);
	if(a.starts("label:"))
		return a.substr(6);
	for(i = 0; i < DTE_ATTRS.size(); i++) {
		if(DTE_ATTRS[i] == a)
			return DTE_ATTR_LABELS[i];
	}
	return a;
}

class desk_timeline_editor
{
	desk = None;
	engine = None;
	managed root = None;
	managed cue_combo = None;
	managed length_box = None;
	managed loop_btn = None;
	managed attr_combo = None;
	managed add_btn = None;
	managed lanes_content = None;
	managed hint = None;
	stack_id = "";
	number = 0.0;          //the cue the editor shows
	cue_numbers = [];      //the numbers of the items of cue_combo
	rows = [];             //[[lane = id, canvas, shape, period, amp, center, spread], ...]
	seen = "";             //what the rows were built for
	seen_revision = -1;
	drag = None;           //[lane = id, index, undo_from, canvas]
	setting = false;       //while the controls are set from the data: their callbacks do not write back

	__init__(parent, desk_runtime, eng) {
		desk = desk_runtime;
		engine = eng;
		root = parent.widget().anchor(0);
		head = root.widget().anchor_left(0).anchor_right(0).anchor_top(0).fixed_height(DTE_ROW);
		cue_combo = head.combobox().anchor_left(0).fixed_width(170).fixed_height(DTE_ROW);
		cue_combo.tooltip("The cue of the stack whose timeline this is. A new cue gets its number when its first lane is added");
		cue_combo.on_change([this](index, text) {
			if(index >= 0 && index < this.cue_numbers.size()) {
				this.number = this.cue_numbers[index];
				this.seen = "";
			}
		});
		length_box = head.floatbox().value(8.0).caption("Beats").alignment("right").anchor_left(174).fixed_width(100).fixed_height(DTE_ROW);
		length_box.min_value(0.25).max_value(1024.0);
		length_box.tooltip("How long the timeline is, in beats of the BPM (4 beats: a bar)");
		length_box.value_callback([this](v) {
			if(this.setting)
				return;
			this.edit("Timeline length", [v](tl) { tl.length = math.max(0.25, std.float(v)); });
		});
		loop_btn = head.pushbutton("Loop").anchor_left(278).fixed_width(60).fixed_height(DTE_ROW).pushed(true);
		loop_btn.tooltip("On: the timeline starts again at its end while the cue plays. Off: it stops on its last values");
		loop_btn.on_change([this](v) {
			if(this.setting)
				return;
			this.edit("Timeline loop", [v](tl) { tl.loop = v ? true : false; });
		});
		attr_combo = head.combobox().items(DTE_ATTR_LABELS).selected(0).anchor_left(342).fixed_width(100).fixed_height(DTE_ROW);
		attr_combo.tooltip("What the next lane moves");
		add_btn = head.button("Add lane").icon(nanogui.icon("plus")).anchor_left(446).fixed_width(140).fixed_height(DTE_ROW);
		add_btn.tooltip("A lane for the selected lamps (a group when the selection is one, all lamps when none is selected) and the attribute on the left\n[[wiki:Lighting-Desk#effect-timelines]]");
		add_btn.on_click([this]() { this.add_lane(); });
		hint = root.label("Pick a cue stack below, select lamps and add a lane: then click into it to set keys.").anchor_left(0).anchor_right(0)
			.anchor_top(DTE_ROW + DTE_GAP + 8).fixed_height(20).text_color(PAL_TEXT_3);
		lanes_content = root.vscroll().anchor_left(0).anchor_right(0).anchor_top(DTE_ROW + DTE_GAP).anchor_bottom(0).content()
			.layout(nanogui.layout_vertical());
	}

	//The lanes draw with this editor: a frame after it went (a project loads, the Programmer is freed) they would call
	//into it ("class not valid")
	__deinit__() {
		unhook();
	}

	unhook() {
		for(i = 0; i < rows.size(); i++) {
			c = rows[i].canvas;
			if(c) {
				c.on_draw(None);
				c.on_mouse_button(None);
				c.on_mouse_drag(None);
			}
		}
	}

	//The stack of the Programmer's list ("" for New stack)
	set_stack(id) {
		if(id == stack_id)
			return;
		stack_id = id;
		number = 0.0;
		seen = "";
	}

	timeline() {
		return stack_id && number > 0.0 ? desk.timeline_of(stack_id, number, false) : None;
	}

	//A change as one undo step
	edit(name, action) {
		if(!stack_id || number <= 0.0)
			return None;
		return desk.edit_timeline(stack_id, number, action, name);
	}

	find_lane(id) {
		tl = timeline();
		if(!tl)
			return None;
		for(i = 0; i < tl.lanes.size(); i++) {
			if(tl.lanes[i].id == id)
				return tl.lanes[i];
		}
		return None;
	}

	//The target and name of a lane for the selection: the group it is, the lamps in their order, or all
	selection_target() {
		p = engine.patch;
		sel = desk.prog.selection;
		if(!sel.size())
			return [target = "all", name = "All lamps"];
		for(i = 0; i < p.groups.size(); i++) {
			g = p.groups[i];
			if(g.fixtures.size() != sel.size())
				continue;
			same = true;
			for(k = 0; k < sel.size() && same; k++)
				same = g.fixtures.has_value(sel[k]);
			if(same)
				return [target = "group:" + g.id, name = g.name];
		}
		if(sel.size() == 1) {
			f = patch_find(p, sel[0]);
			return [target = "lamp:" + sel[0], name = f ? f.name : "1 lamp"];
		}
		return [target = "lamps:" + desk_join(sel, ","), name = sel.size() + " lamps"];
	}

	add_lane() {
		if(!stack_id) {
			desk.message = "Pick a cue stack below first";
			desk.changed();
			return;
		}
		if(number <= 0.0) {
			s = desk_stack(desk.data, stack_id);
			number = s ? desk_next_cue_number(s) : 1.0;
		}
		t = selection_target();
		attr = DTE_ATTRS[math.clamp(attr_combo.selected(), 0, DTE_ATTRS.size() - 1)];
		edit("Add timeline lane", [t, attr](tl) {
			tl.lanes.push_back(desk_lane_new(t.target, attr, t.name));
		});
		seen = "";
	}

	remove_lane(id) {
		edit("Remove timeline lane", [id](tl) {
			for(i = 0; i < tl.lanes.size(); i++) {
				if(tl.lanes[i].id == id) {
					tl.lanes.erase(i);
					return;
				}
			}
		});
		seen = "";
	}

	//Called every frame by the Programmer: the cue list, the rows when the lanes changed, the controls
	update() {
		if(!root)
			return;
		s = stack_id ? desk_stack(desk.data, stack_id) : None;
		if(desk.revision != seen_revision) {
			seen_revision = desk.revision;
			fill_cues(s);
		}
		tl = timeline();
		key = stack_id + "|" + number;
		if(tl) {
			for(i = 0; i < tl.lanes.size(); i++)
				key += "|" + tl.lanes[i].id;
		}
		if(key != seen) {
			seen = key;
			build(tl);
		}
		hint.visible(!tl || !tl.lanes.size());
		setting = true;
		if(tl) {
			if(math.abs(length_box.value() - std.float(tl.length)) > 0.0001)
				length_box.value(std.float(tl.length));
			loop = tl.has("loop") ? (tl.loop ? true : false) : true;
			if(loop_btn.pushed() != loop)
				loop_btn.pushed(loop);
		}
		setting = false;
	}

	//The cues of the stack in the list, then a new one
	fill_cues(s) {
		items = [];
		cue_numbers = [];
		sel = -1;
		if(s) {
			for(i = 0; i < s.cues.size(); i++) {
				c = s.cues[i];
				lanes = c.has("timeline") && c.timeline ? c.timeline.lanes.size() : 0;
				title = "Cue " + desk_num_text(c.number);
				items.push_back(title + (c.name && c.name != title ? " · " + c.name : "") + (lanes ? " · " + lanes + (lanes == 1 ? " lane" : " lanes") : ""));
				cue_numbers.push_back(c.number);
				if(math.abs(c.number - number) < 0.0001)
					sel = i;
			}
			next = desk_next_cue_number(s);
			items.push_back("New cue " + desk_num_text(next));
			cue_numbers.push_back(next);
			if(sel < 0) {
				//the first cue with a timeline, else the new one
				for(i = 0; i < s.cues.size() && sel < 0; i++) {
					if(s.cues[i].has("timeline") && s.cues[i].timeline)
						sel = i;
				}
				if(sel < 0)
					sel = items.size() - 1;
				number = cue_numbers[sel];
			}
		}
		else
			items.push_back("Pick a cue stack below");
		cue_combo.items(items).selected(math.max(0, sel));
	}

	build(tl) {
		unhook();
		lanes_content.clear_children();
		rows = [];
		if(!tl)
			return;
		for(i = 0; i < tl.lanes.size(); i++)
			build_lane(tl.lanes[i]);
		lanes_content.parent().refresh_layout();
	}

	build_lane(lane) {
		id = lane.id;
		row = lanes_content.widget().fixed_height(DTE_LANE_H).anchor_left(0).anchor_right(0);
		ctrl = row.widget().anchor_left(0).anchor_top(0).anchor_bottom(DTE_GAP).fixed_width(DTE_CTRL_W);
		name = (lane.name ? lane.name : dte_target_name(engine.patch, lane.target)) + " · " + dte_attr_label(lane.attr);
		ctrl.label(name).anchor_left(4).anchor_right(30).anchor_top(2).fixed_height(22).tooltip(name);
		del = ctrl.button("").icon(nanogui.icon("times")).danger("hover").anchor_right(0).anchor_top(0).fixed_width(26).fixed_height(24);
		del.tooltip("Removes this lane");
		del.on_click([this, id]() { this.remove_lane(id); });
		is_color = lane.attr == "color";
		shape = None;
		period = None;
		amp = None;
		center = None;
		if(!is_color) {
			shape = ctrl.combobox().items(DTE_WAVE_LABELS).anchor_left(0).anchor_top(28).fixed_width(110).fixed_height(26);
			shape.tooltip("Keys: the keys you set. A waveform instead: it goes up and down by itself (Beats: how long one round takes)");
			shape.on_change([this, id](index, text) {
				if(this.setting)
					return;
				this.edit("Timeline wave", [id, index](tl) {
					for(i = 0; i < tl.lanes.size(); i++) {
						if(tl.lanes[i].id == id)
							tl.lanes[i].wave.shape = DESK_WAVES[math.clamp(index, 0, DESK_WAVES.size() - 1)];
					}
				});
			});
			period = ctrl.floatbox().value(4.0).caption("Beats").alignment("right").anchor_left(114).anchor_top(28).fixed_width(100).fixed_height(26);
			period.min_value(0.0625).max_value(256.0);
			period.tooltip("How many beats one round of the wave takes");
			amp = ctrl.floatbox().value(0.5).caption("Depth").alignment("right").anchor_left(0).anchor_top(58).fixed_width(96).fixed_height(26);
			amp.min_value(0.0).max_value(1.0);
			amp.tooltip("How far the wave goes up and down from its middle (0.5: from 0 to 1 around 0.5)");
			center = ctrl.floatbox().value(0.5).caption("Mid").alignment("right").anchor_left(100).anchor_top(58).fixed_width(90).fixed_height(26);
			center.min_value(0.0).max_value(1.0);
			center.tooltip("The middle of the wave");
			period.value_callback([this, id](v) { this.set_wave(id, "period", v); });
			amp.value_callback([this, id](v) { this.set_wave(id, "amp", v); });
			center.value_callback([this, id](v) { this.set_wave(id, "center", v); });
		}
		spread = ctrl.floatbox().value(0.0).caption("Spread").alignment("right").anchor_left(is_color ? 0 : 194).anchor_top(is_color ? 28 : 58)
			.fixed_width(106).fixed_height(26);
		spread.min_value(0.0).max_value(1.0);
		spread.tooltip("The lamps one after the other: each this part of the timeline (of a wave: of its round) later than the one before. 1: a chase over all of it");
		spread.value_callback([this, id](v) {
			if(this.setting)
				return;
			this.edit("Timeline spread", [id, v](tl) {
				for(i = 0; i < tl.lanes.size(); i++) {
					if(tl.lanes[i].id == id)
						tl.lanes[i].spread = math.clamp(std.float(v), 0.0, 1.0);
				}
			});
		});
		canvas = row.widget().anchor_left(DTE_CTRL_W + DTE_GAP).anchor_right(0).anchor_top(0).anchor_bottom(DTE_GAP);
		canvas.tooltip("Click: a key (Shift: off the quarter beats). Drag a key to move it, right click: its curve to the next key (step, linear, smooth), Ctrl+click: delete it\n[[wiki:Lighting-Desk#effect-timelines]]");
		canvas.on_draw([this, id, canvas]() { this.draw_lane(id, canvas); });
		canvas.on_mouse_button([this, id, canvas](pos, button, down, mods) { return this.lane_button(id, canvas, pos, button, down, mods); });
		canvas.on_mouse_drag([this, id, canvas](pos, rel, button, mods) { return this.lane_drag(id, canvas, pos, mods); });
		rows.push_back([lane = id, canvas = canvas, shape = shape, period = period, amp = amp, center = center, spread = spread]);
		set_controls(rows[-1], lane);
	}

	set_controls(row, lane) {
		setting = true;
		if(row.shape) {
			at = 0;
			for(i = 0; i < DESK_WAVES.size(); i++) {
				if(DESK_WAVES[i] == lane.wave.shape)
					at = i;
			}
			row.shape.selected(at);
			row.period.value(std.float(lane.wave.period));
			row.amp.value(std.float(lane.wave.amp));
			row.center.value(std.float(lane.wave.center));
		}
		row.spread.value(std.float(lane.spread ?? 0.0));
		setting = false;
	}

	set_wave(id, field, v) {
		if(setting)
			return;
		edit("Timeline wave", [id, field, v](tl) {
			for(i = 0; i < tl.lanes.size(); i++) {
				if(tl.lanes[i].id == id)
					tl.lanes[i].wave[field] = std.float(v);
			}
		});
	}

	// ---- the keys of a lane ----

	beat_x(t, length, w) {
		return DTE_PAD + t / length * (w - 2.0 * DTE_PAD);
	}

	x_beat(x, length, w) {
		return math.clamp((x - DTE_PAD) / math.max(1.0, w - 2.0 * DTE_PAD) * length, 0.0, length);
	}

	value_y(v, h) {
		return 4.0 + (1.0 - v) * (h - 8.0);
	}

	y_value(y, h) {
		return math.clamp(1.0 - (y - 4.0) / math.max(1.0, h - 8.0), 0.0, 1.0);
	}

	//The value a key shows as its height: a colour by its brightest channel
	key_level(v) {
		if(std.type(v) == "json")
			return math.max(v[0], math.max(v[1], v[2]));
		return std.float(v);
	}

	draw_lane(id, canvas) {
		if(!root || !desk)
			return;
		lane = find_lane(id);
		tl = timeline();
		if(!lane || !tl)
			return;
		s = canvas.size();
		w = s.x;
		h = s.y;
		length = math.max(0.25, std.float(tl.length));
		loop = tl.has("loop") ? (tl.loop ? true : false) : true;
		nvgBeginPath();
		nvgRect(vec2f(0, 0), vec2f(w, h));
		nvgFillColor(PAL_CANVAS);
		nvgFill();
		//beats, bars stronger
		for(b = 0; b <= length + 0.001; b += 1.0) {
			x = beat_x(b, length, w);
			nvgBeginPath();
			nvgMoveTo(vec2f(x, 0));
			nvgLineTo(vec2f(x, h));
			nvgStrokeColor(std.int(b) % 4 == 0 ? PAL_LINE_STRONG : pal_alpha(PAL_LINE_STRONG, 0.35));
			nvgStrokeWidth(1.0);
			nvgStroke();
		}
		is_color = lane.attr == "color";
		steps = 96;
		if(is_color) {
			//the colour along the beats
			for(i = 0; i < steps; i++) {
				t = length * (i + 0.5) / steps;
				v = desk_lane_value(lane, t, length, loop);
				if(std.is_none(v))
					continue;
				x0 = beat_x(length * i / steps, length, w);
				x1 = beat_x(length * (i + 1) / steps, length, w);
				nvgBeginPath();
				nvgRect(vec2f(x0, h * 0.25), vec2f(x1 - x0 + 0.5, h * 0.5));
				nvgFillColor(vec4f(v[0], v[1], v[2], 1.0));
				nvgFill();
			}
		}
		else {
			nvgBeginPath();
			drawn = 0;
			for(i = 0; i <= steps; i++) {
				t = length * i / steps;
				v = desk_lane_value(lane, t, length, loop);
				if(std.is_none(v))
					continue;
				pt = vec2f(beat_x(t, length, w), value_y(v, h));
				if(drawn == 0)
					nvgMoveTo(pt);
				else
					nvgLineTo(pt);
				drawn++;
			}
			nvgStrokeColor(PAL_ACCENT);
			nvgStrokeWidth(2.0);
			nvgStroke();
		}
		//the keys (not for a waveform: it does not use them)
		waved = !is_color && (lane.wave.shape ?? "none") != "none";
		for(i = 0; i < lane.keys.size() && !waved; i++) {
			k = lane.keys[i];
			x = beat_x(k.t, length, w);
			y = is_color ? h * 0.5 : value_y(key_level(k.v), h);
			nvgBeginPath();
			if(k.curve == "step")
				nvgRect(vec2f(x - 5, y - 5), vec2f(10, 10));
			else
				nvgCircle(vec2f(x, y), k.curve == "smooth" ? 6.0 : 5.0);
			c = is_color ? vec4f(k.v[0], k.v[1], k.v[2], 1.0) : PAL_CANVAS;
			nvgFillColor(c);
			nvgFill();
			nvgStrokeColor(drag && drag.lane == id && drag.index == i ? PAL_CUE : PAL_TEXT);
			nvgStrokeWidth(2.0);
			nvgStroke();
		}
		if(waved)
			pal_text(vec2f(w - 8, 10), DTE_WAVE_LABELS[math.max(0, dte_index(DESK_WAVES, lane.wave.shape))], 11, PAL_TEXT_3, PAL_ALIGN_RIGHT_MIDDLE);
		else if(!lane.keys.size())
			pal_text(vec2f(w / 2.0, h / 2.0), "Click to set a key", 12, PAL_TEXT_3, PAL_ALIGN_CENTER_MIDDLE);
		//where it plays
		beat = desk.timeline_beat(stack_id);
		s_cur = stack_id ? desk_stack(desk.data, stack_id) : None;
		pb_ok = beat >= 0.0 && desk.playbacks.has(stack_id) && s_cur && desk.playbacks[stack_id].index >= 0
			&& desk.playbacks[stack_id].index < s_cur.cues.size()
			&& math.abs(s_cur.cues[desk.playbacks[stack_id].index].number - number) < 0.0001;
		if(pb_ok) {
			x = beat_x(beat, length, w);
			nvgBeginPath();
			nvgMoveTo(vec2f(x, 0));
			nvgLineTo(vec2f(x, h));
			nvgStrokeColor(PAL_CUE);
			nvgStrokeWidth(2.0);
			nvgStroke();
		}
	}

	//The key near pos (widget pixels), -1 for none
	key_at(lane, length, w, h, pos) {
		is_color = lane.attr == "color";
		best = -1;
		best_d = DTE_HIT;
		for(i = 0; i < lane.keys.size(); i++) {
			k = lane.keys[i];
			x = beat_x(k.t, length, w);
			y = is_color ? h * 0.5 : value_y(key_level(k.v), h);
			d = math.sqrt((x - pos.x) * (x - pos.x) + (y - pos.y) * (y - pos.y));
			if(is_color)
				d = math.abs(x - pos.x);
			if(d < best_d) {
				best_d = d;
				best = i;
			}
		}
		return best;
	}

	//The value of a new key: the height, or for a colour the colour the programmer has for the first lamp of the lane
	new_value(lane, h, y) {
		if(lane.attr != "color")
			return y_value(y, h);
		ids = desk_target_ids(engine.patch, lane.target);
		if(ids.size() && desk.prog.values.has(ids[0])) {
			f = patch_find(engine.patch, ids[0]);
			labels = f ? desk_labels_of_function(f.type, "color") : [];
			vals = desk.prog.values[ids[0]];
			if(labels.size() >= 3 && vals.has(labels[0]) && vals.has(labels[1]) && vals.has(labels[2]))
				return [vals[labels[0]], vals[labels[1]], vals[labels[2]]];
		}
		return [1.0, 1.0, 1.0];
	}

	snap(t, mods) {
		return (mods & DTE_MOD_SHIFT) ? t : math.round(t * 4.0) / 4.0;
	}

	lane_button(id, canvas, pos, button, down, mods) {
		lane = find_lane(id);
		tl = timeline();
		if(!lane || !tl)
			return false;
		s = canvas.size();
		length = math.max(0.25, std.float(tl.length));
		if(!down) {
			if(drag) {
				desk.record_step("Timeline key", drag.undo_from);
				drag = None;
				desk.changed();
			}
			return true;
		}
		at = key_at(lane, length, s.x, s.y, pos);
		if(button == 1) {
			if(at < 0)
				return true;
			edit("Timeline curve", [id, at](tl) {
				for(i = 0; i < tl.lanes.size(); i++) {
					if(tl.lanes[i].id != id || at >= tl.lanes[i].keys.size())
						continue;
					k = tl.lanes[i].keys[at];
					k.curve = DESK_CURVES[(math.max(0, dte_index(DESK_CURVES, k.curve)) + 1) % DESK_CURVES.size()];
				}
			});
			return true;
		}
		if(button != 0)
			return false;
		if(at >= 0 && (mods & DTE_MOD_CTRL)) {
			edit("Delete timeline key", [id, at](tl) {
				for(i = 0; i < tl.lanes.size(); i++) {
					if(tl.lanes[i].id == id)
						desk_lane_remove_key(tl.lanes[i], at);
				}
			});
			return true;
		}
		undo_from = desk.snapshot();
		if(at < 0) {
			managed _grd = std.critical_section("desk");
			at = desk_lane_set_key(lane, snap(x_beat(pos.x, length, s.x), mods), new_value(lane, s.y, pos.y), "linear");
			desk.changed();
		}
		drag = [lane = id, index = at, undo_from = undo_from];
		return true;
	}

	lane_drag(id, canvas, pos, mods) {
		if(!drag || drag.lane != id)
			return false;
		lane = find_lane(id);
		tl = timeline();
		if(!lane || !tl || drag.index >= lane.keys.size())
			return false;
		o = canvas.position();
		local = vec2f(pos.x - o.x, pos.y - o.y);
		s = canvas.size();
		length = math.max(0.25, std.float(tl.length));
		managed _grd = std.critical_section("desk");
		k = lane.keys[drag.index];
		v = lane.attr == "color" ? k.v : y_value(local.y, s.y);
		lane.keys.erase(drag.index);
		drag.index = desk_lane_set_key(lane, snap(x_beat(local.x, length, s.x), mods), v, k.curve);
		desk.changed();
		return true;
	}
}
