//Colours and text helpers for the plans drawn with nvg (fixture setup, LEDMapper, Phaser), from design/tokens.json.
//Colour is information (design/README.md): accent = selected, danger = a problem, on = active, cue = learning/testing.

import nanogui;

using eigen;

PAL_CANVAS = vec4f(11 / 255.0, 11 / 255.0, 12 / 255.0, 1.0);
PAL_FIELD = vec4f(14 / 255.0, 14 / 255.0, 15 / 255.0, 1.0);
PAL_RAISED = vec4f(33 / 255.0, 33 / 255.0, 36 / 255.0, 1.0);
PAL_CONTROL = vec4f(37 / 255.0, 37 / 255.0, 40 / 255.0, 1.0);
PAL_LINE = vec4f(1.0, 1.0, 1.0, 0.07);
PAL_LINE_STRONG = vec4f(1.0, 1.0, 1.0, 0.16);
PAL_TEXT = vec4f(237 / 255.0, 237 / 255.0, 237 / 255.0, 1.0);
PAL_TEXT_2 = vec4f(155 / 255.0, 155 / 255.0, 160 / 255.0, 1.0);
PAL_TEXT_3 = vec4f(94 / 255.0, 94 / 255.0, 99 / 255.0, 1.0);
PAL_ON = vec4f(63 / 255.0, 207 / 255.0, 142 / 255.0, 1.0);
PAL_ACCENT = vec4f(157 / 255.0, 133 / 255.0, 255 / 255.0, 1.0);
PAL_CUE = vec4f(240 / 255.0, 180 / 255.0, 76 / 255.0, 1.0);
PAL_DANGER = vec4f(239 / 255.0, 106 / 255.0, 90 / 255.0, 1.0);

//nvgTextAlign flags
PAL_ALIGN_LEFT_MIDDLE = 17;
PAL_ALIGN_CENTER_MIDDLE = 18;
PAL_ALIGN_RIGHT_MIDDLE = 20;
PAL_ALIGN_CENTER_TOP = 10;
PAL_ALIGN_LEFT_TOP = 9;

pal_alpha(c, a) {
	return vec4f(c.x, c.y, c.z, a);
}

//A calm colour of its own for each of many things (lamps in the universe map, groups of the LEDMapper)
//(no reds: red means a problem)
pal_hue(index, alpha = 1.0) {
	h = 0.12 + math.mod(index * 0.61803398875, 1.0) * 0.72;
	r = math.clamp(math.abs(h * 6.0 - 3.0) - 1.0, 0.0, 1.0);
	g = math.clamp(2.0 - math.abs(h * 6.0 - 2.0), 0.0, 1.0);
	b = math.clamp(2.0 - math.abs(h * 6.0 - 4.0), 0.0, 1.0);
	return vec4f(0.35 + r * 0.4, 0.35 + g * 0.4, 0.35 + b * 0.4, alpha);
}

pal_text(pos, text, size = 13, color = PAL_TEXT_2, align = 17, face = "sans") {
	nvgFontSize(size);
	nvgFontFace(face);
	nvgFillColor(color);
	nvgTextAlign(align);
	nvgText(pos, text);
}

//Rounded box with a caption, for labels on a plan
pal_badge(pos, text, color, ink = PAL_CANVAS, size = 11) {
	nvgFontSize(size);
	nvgFontFace("sans-bold");
	w = nvgTextBounds(vec2f(0, 0), text)[0] + size * 0.8;
	h = size + 5.0;
	nvgBeginPath();
	nvgRoundedRect(vec2f(pos.x - w / 2.0, pos.y - h / 2.0), vec2f(w, h), size * 0.25);
	nvgFillColor(color);
	nvgFill();
	nvgFillColor(ink);
	nvgTextAlign(PAL_ALIGN_CENTER_MIDDLE);
	nvgText(pos, text);
}
