//A channel map (#655): the 512 channels of one universe of a node as a grid, with what sends there as blocks that can be
//dragged to other channels. The universe map of the fixture setup and the Channels of the LEDMapper are one each.
//
//Needs engine/patch/patch.shio, dmx.shio and palette.shio included before it.
//
//The owner gives a provider: a lambda that returns what to show now
//  [node, universe, title, empty (text when there is nothing to show), blocks, cells]
//  blocks = [[ref, first, last (1-based channels of this universe), label, color (vec4f), movable, selected, problem,
//             tip (why it cannot move)], ...]
//  cells  = dmx_universe_cells() of the other senders (grey, red when two meet), or None
//and callbacks:
//  on_pick(block, mods)    a block was pressed (before a drag)
//  on_move(block, delta)   a block was dragged delta channels (on release)
//  on_universe(step)       the arrows: -1 / +1 universe

CHMAP_COLS = 64;
CHMAP_ROWS = 8;
CHMAP_LEFT = 34; //room for the channel numbers
CHMAP_TOP = 30; //room for the title
CHMAP_ARROW = 24;
CHMAP_MOD_SHIFT = 1;

class channel_map {

	managed area = None;
	managed prev_btn = None;
	managed next_btn = None;
	provider = None;
	on_pick = None;
	on_move = None;
	on_universe = None;

	data = None; //what the provider gave for this frame
	hover = "";
	drag = None; //[ref, grab (cell - first of the block), first, last, target (the first channel where it would go), moved]

	__init__(parent) {
		area = parent;
		area.on_draw([this]() { this.draw(); });
		area.on_mouse_button([this](pos, button, down, mods) { return this.mouse_button(pos, button, down, mods); });
		//(a drag reports its position as the parent sees the widget: its own position added, a press does not)
		area.on_mouse_drag([this](pos, rel, button, mods) { return this.mouse_drag(vec2f(pos.x, pos.y) - this.area.position()); });
		area.on_mouse_motion([this](pos, rel, button, mods) {
			this.motion(pos);
			return false;
		});
		next_btn = area.button("").icon(nanogui.icon("chevron_right")).anchor_right(4).anchor_top(3).fixed_width(CHMAP_ARROW).fixed_height(CHMAP_ARROW);
		next_btn.tooltip("The next universe of this node");
		next_btn.on_click([this]() { this.step(1); });
		prev_btn = area.button("").icon(nanogui.icon("chevron_left")).anchor_right(CHMAP_ARROW + 6).anchor_top(3).fixed_width(CHMAP_ARROW).fixed_height(CHMAP_ARROW);
		prev_btn.tooltip("The universe before");
		prev_btn.on_click([this]() { this.step(-1); });
	}

	step(d) {
		f = on_universe;
		if(f)
			f(d);
	}

	refresh() {
		f = provider;
		data = f ? f() : None;
		return data;
	}

	// =========================================================================
	// Grid
	// =========================================================================

	cell_size() {
		s = area.size();
		return vec2f((s.x - CHMAP_LEFT - 8) / CHMAP_COLS, (s.y - CHMAP_TOP - 8) / CHMAP_ROWS);
	}

	//Rectangle of channel c (0-based)
	cell_rect(c) {
		cs = cell_size();
		return [x = CHMAP_LEFT + (c % CHMAP_COLS) * cs.x, y = CHMAP_TOP + std.int(c / CHMAP_COLS) * cs.y, w = cs.x, h = cs.y];
	}

	//0-based channel under pos, -1 outside; clamp: the nearest one
	cell_at(pos, clamp = false) {
		cs = cell_size();
		col = std.int(math.floor((pos.x - CHMAP_LEFT) / cs.x));
		row = std.int(math.floor((pos.y - CHMAP_TOP) / cs.y));
		if(clamp) {
			col = math.clamp(col, 0, CHMAP_COLS - 1);
			row = math.clamp(row, 0, CHMAP_ROWS - 1);
		}
		else if(col < 0 || col >= CHMAP_COLS || row < 0 || row >= CHMAP_ROWS)
			return -1;
		return row * CHMAP_COLS + col;
	}

	//The block on channel c (1-based): a selected one first
	block_at(c) {
		if(!data)
			return None;
		found = None;
		for(i = 0; i < data.blocks.size(); i++) {
			b = data.blocks[i];
			if(c >= b.first && c <= b.last && (!found || b.selected))
				found = b;
		}
		return found;
	}

	// =========================================================================
	// Drawing
	// =========================================================================

	//Channels first..last (1-based): a rectangle per row, not a fill per channel (#682: 512 fills and more each frame made
	//the fixture setup slow). The lines between the cells are drawn over it (grid_lines). A fill each: a path of several
	//rectangles is filled through the stencil buffer, which the widget may not have (it fills the box around them all).
	fill_cells(first, last, color) {
		c = math.max(1, first) - 1;
		last = math.min(DMX_UNIVERSE_SIZE, last) - 1;
		cs = cell_size();
		for(c <= last) {
			row = std.int(c / CHMAP_COLS);
			end = math.min(last, row * CHMAP_COLS + CHMAP_COLS - 1);
			nvgBeginPath();
			nvgRect(vec2f(CHMAP_LEFT + (c % CHMAP_COLS) * cs.x, CHMAP_TOP + row * cs.y), vec2f((end - c + 1) * cs.x, cs.y));
			nvgFillColor(color);
			nvgFill();
			c = end + 1;
		}
	}

	//The gaps between the cells, in the colour of the background
	grid_lines() {
		cs = cell_size();
		bottom = CHMAP_TOP + CHMAP_ROWS * cs.y;
		right = CHMAP_LEFT + CHMAP_COLS * cs.x;
		nvgBeginPath();
		for(col = 0; col <= CHMAP_COLS; col++) {
			x = CHMAP_LEFT + col * cs.x;
			nvgMoveTo(vec2f(x, CHMAP_TOP));
			nvgLineTo(vec2f(x, bottom));
		}
		for(row = 0; row <= CHMAP_ROWS; row++) {
			y = CHMAP_TOP + row * cs.y;
			nvgMoveTo(vec2f(CHMAP_LEFT, y));
			nvgLineTo(vec2f(right, y));
		}
		nvgStrokeColor(PAL_FIELD);
		nvgStrokeWidth(1.0);
		nvgStroke();
	}

	draw() {
		s = area.size();
		nvgBeginPath();
		nvgRect(vec2f(0, 0), vec2f(s.x, s.y));
		nvgFillColor(PAL_FIELD);
		nvgFill();
		refresh();
		show = data && data.node;
		prev_btn.visible(show ? true : false);
		next_btn.visible(show ? true : false);
		if(!show) {
			pal_text(vec2f(8, 15), data ? data.empty : "", 12, PAL_TEXT_3, PAL_ALIGN_LEFT_MIDDLE);
			return;
		}
		title = data.title;
		if(drag && drag.moved)
			title += "   —   to " + std.string(drag.target) + (drag.target + drag.last - drag.first != drag.target ? "–" + std.string(drag.target + drag.last - drag.first) : "");
		else if(hover)
			title += "   —   " + hover;
		pal_text(vec2f(8, 15), title, 12, PAL_TEXT_2, PAL_ALIGN_LEFT_MIDDLE);

		//free channels and the other senders: a fill for each run of channels in the same state
		cells = data.cells;
		c = 0;
		for(c < DMX_UNIVERSE_SIZE) {
			state = cells ? cells[c].state : "";
			end = c;
			for(end + 1 < DMX_UNIVERSE_SIZE && (cells ? cells[end + 1].state : "") == state)
				end++;
			fill_cells(c + 1, end + 1, state == "!" ? PAL_DANGER : (state ? PAL_TEXT_3 : PAL_CONTROL));
			c = end + 1;
		}
		//the blocks: selected ones on top
		for(pass = 0; pass < 2; pass++) {
			for(i = 0; i < data.blocks.size(); i++) {
				b = data.blocks[i];
				if((pass == 1) != (b.selected ? true : false))
					continue;
				color = b.problem ? PAL_DANGER : (b.selected ? PAL_ACCENT : b.color);
				if(drag && drag.moved && b.ref == drag.ref)
					color = pal_alpha(color, 0.35);
				fill_cells(b.first, b.last, color);
			}
		}
		//where a dragged block would go
		if(drag && drag.moved) {
			last = drag.target + drag.last - drag.first;
			fits = dmx_range_free(data.blocks, cells, drag.ref, drag.target, last);
			fill_cells(drag.target, last, fits ? pal_alpha(PAL_ON, 0.8) : pal_alpha(PAL_DANGER, 0.8));
		}
		grid_lines();
		for(row = 0; row < CHMAP_ROWS; row++) {
			r = cell_rect(row * CHMAP_COLS);
			pal_text(vec2f(r.x - 4, r.y + r.h / 2.0), std.string(row * CHMAP_COLS + 1), 10, PAL_TEXT_3, PAL_ALIGN_RIGHT_MIDDLE);
		}
	}

	// =========================================================================
	// Mouse
	// =========================================================================

	motion(pos) {
		hover = "";
		c = cell_at(pos);
		if(c < 0 || !data || !data.node)
			return;
		names = [];
		for(i = 0; i < data.blocks.size(); i++) {
			b = data.blocks[i];
			if(c + 1 >= b.first && c + 1 <= b.last)
				names.push_back(b.label + (b.first < c + 1 ? " (+" + std.string(c + 1 - b.first) + ")" : ""));
		}
		if(data.cells) {
			list = data.cells[c].names;
			for(i = 0; i < list.size(); i++)
				names.push_back(list[i]);
		}
		//(not combine_string(): it puts the separator after the last one too)
		text = "";
		for(i = 0; i < names.size(); i++)
			text += (i ? ", " : "") + names[i];
		hover = "Channel " + std.string(c + 1) + ": " + (names.size() ? text : "free");
		b = block_at(c + 1);
		if(b && !b.movable && b.tip)
			hover += " · " + b.tip;
		else if(b)
			hover += " · drag to move it";
	}

	mouse_button(pos, button, down, mods) {
		if(button != 0)
			return true;
		if(down) {
			drag = None;
			c = cell_at(pos);
			if(c < 0 || !data || !data.node)
				return true;
			b = block_at(c + 1);
			if(!b)
				return true;
			pick = on_pick;
			if(pick)
				pick(b, mods);
			if(b.movable)
				drag = [ref = b.ref, grab = c + 1 - b.first, first = b.first, last = b.last, target = b.first, moved = false, block = b];
			return true;
		}
		move = on_move;
		if(drag && drag.moved && drag.target != drag.first && move)
			move(drag.block, drag.target - drag.first);
		drag = None;
		hover = ""; //what was under the mouse moved
		return true;
	}

	mouse_drag(pos) {
		if(!drag)
			return false;
		c = cell_at(pos, true);
		length = drag.last - drag.first;
		target = math.clamp(c + 1 - drag.grab, 1, DMX_UNIVERSE_SIZE - length);
		if(target != drag.first)
			drag.moved = true;
		drag.target = target;
		return true;
	}
}
