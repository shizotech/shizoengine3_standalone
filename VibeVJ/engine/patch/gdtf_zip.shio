//Reads a .gdtf archive for engine/patch/gdtf.shio (#669), loaded there in a module of its own: the import zip of this
//file is the only one of the fixture setup, so the setup still loads without the zip package.
import zip;

GDTF_GOBO_SIZE = 24; //cells of a gobo mask (each side)

//A gobo image (white: light) as a mask: GDTF_GOBO_SIZE x GDTF_GOBO_SIZE characters "0" / "1", row after row; "" when
//it cannot be read
gdtf_gobo_mask(file) {
	try {
		img = bitmap.load(file);
		if(!img || img.width() < 1 || img.height() < 1)
			return "";
		img.resize_lanczos(GDTF_GOBO_SIZE, GDTF_GOBO_SIZE);
		mask = "";
		half = GDTF_GOBO_SIZE / 2.0;
		for(y = 0; y < GDTF_GOBO_SIZE; y++) {
			for(x = 0; x < GDTF_GOBO_SIZE; x++) {
				//a gobo is round: outside the circle no light (the corners of an image are often transparent white)
				dx = x + 0.5 - half;
				dy = y + 0.5 - half;
				if(dx * dx + dy * dy > half * half) {
					mask += "0";
					continue;
				}
				p = img.get_pixel(x, y);
				lum = (std.int(p / 65536) % 256) * 0.3 + (std.int(p / 256) % 256) * 0.59 + (p % 256) * 0.11;
				mask += lum > 100 ? "1" : "0";
			}
		}
		return mask;
	}
	catch(e) {
		return "";
	}
}

//[names (the entries of the archive), xml (description.xml), files (the 3D models: path in the archive -> std.buffer),
// gobos (the wheel images: path in the archive -> gdtf_gobo_mask), error ("" when it could be read)]. tmp: a file
//name the images are written to for bitmap.load (removed again)
gdtf_zip_read(path, tmp = "") {
	res = [names = [], xml = "", files = std.json(), gobos = std.json(), error = ""];
	try {
		z = zip.file(path);
		res.names = z.names();
		if(!z.has("description.xml")) {
			res.error = fileio.file_name(path) + " has no description.xml: not a GDTF file.";
			return res;
		}
		res.xml = z.read("description.xml");
		for(n : res.names) {
			low = std.string(n).lowercase();
			if(low.starts("models/") && (low.ends(".glb") || low.ends(".3ds")))
				res.files[n] = z.read_binary(n);
			else if(tmp && low.starts("wheels/") && (low.ends(".png") || low.ends(".jpg") || low.ends(".bmp"))) {
				try {
					z.extract(n, tmp);
					res.gobos[n] = gdtf_gobo_mask(tmp);
				}
				catch(e) {
					res.gobos[n] = "";
				}
			}
		}
		if(tmp && fileio.exists(tmp))
			fileio.remove(tmp);
	}
	catch(e) {
		res.error = "Cannot read " + fileio.file_name(path) + ": not a zip archive (a .gdtf file is one).";
	}
	return res;
}
