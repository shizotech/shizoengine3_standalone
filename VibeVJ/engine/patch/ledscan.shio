//Camera scan of LED positions (#980): a strip laid by hand on real decoration gets the places its LEDs really have. One
//LED at a time is lit (all others dark), a camera looks at it, and its spot in the picture is its place. The LEDMapper
//asset runs it (Camera scan, queries scan_leds / get_scan_status / stop_scan) and writes the places into its segments
//(shape "points", engine/patch/ledmap.shio). No UI; tested in _testing/ledscan.shio.
//
//The spot is found on the GPU: the measure shader (LEDSCAN_MEASURE_SRC) compares the camera picture with a dark
//reference taken with all LEDs off (LEDSCAN_REF_SRC holds it) and writes per cell of a LEDSCAN_GRID x LEDSCAN_GRID
//grid the sums of the brighter light: weight, weight * x, weight * y and its peak. Only those few floats are read back;
//ledscan_spot() takes the brightest cell and the cells around it (a reflection elsewhere does not pull the spot away).
//
//Coordinates: 0..1 of the camera picture as it is shown, x to the right, y down (as the LEDMapper's picture).

using eigen;

LEDSCAN_GRID = 32;            //cells of the measure shader per side (its render size)
LEDSCAN_SAMPLES = 16;         //samples of the camera per cell and side: 512 x 512 in all
LEDSCAN_WAIT_MS = 300;        //from a LED switched on to the camera picture (Art-Net, the camera, its buffer)
LEDSCAN_MIN_PEAK = 0.06;      //brighter than the reference by at least this (0..1): else the LED was not seen
LEDSCAN_REF_EVERY = 64;       //a new dark reference after so many LEDs (the light in the room changes)
LEDSCAN_BLOB_MIN_PEAK = 0.025; //a spot through a material is faint: brighter than the dark picture by this much
LEDSCAN_BLOB_NOISE = 0.01;     //and the light under this much is not counted (the noise of a camera)
LEDSCAN_NEAR_CELLS = 2;       //cells around the brightest one that count for the spot
LEDSCAN_LEVEL = 180;          //how bright the lit LED is (0..255 on each channel): bright, but not blinding the camera

//The reference: the camera picture while capture is 1, then held (its own last picture, feedback)
LEDSCAN_REF_SRC = R"(
#version 330 core
uniform sampler2D camera;
uniform sampler2D feedback;
uniform int capture;
void main()
{
    fragColor = capture != 0 ? texture(camera, v_uv) : texture(feedback, v_uv);
}
)";

//Per cell: r = sum of weights, g = sum weight * x, b = sum weight * y (x, y 0..1 of the picture as shown, y down; the
//texture is in GL orientation, its row 0 the bottom of the picture: y = 1 - v, as the LEDMapper's LED shader does), a = peak.
//The weight is how much brighter than the reference, above a little noise, squared (the core of the spot counts most)
LEDSCAN_MEASURE_SRC = R"(
#version 330 core
uniform sampler2D camera;
uniform sampler2D reference;
uniform int grid;
uniform int samples;
uniform float noise;
void main()
{
    ivec2 cell = ivec2(gl_FragCoord.xy);
    float n = float(grid * samples);
    vec4 acc = vec4(0.0);
    for(int j = 0; j < samples; j++) {
        for(int i = 0; i < samples; i++) {
            vec2 uv = (vec2(cell * samples + ivec2(i, j)) + 0.5) / n;
            vec3 c = texture(camera, uv).rgb;
            vec3 r = texture(reference, uv).rgb;
            float d = max(max(c.r - r.r, c.g - r.g), c.b - r.b);
            float w = max(d - noise, 0.0);
            w *= w;
            acc.r += w;
            acc.g += w * uv.x;
            acc.b += w * (1.0 - uv.y);
            acc.a = max(acc.a, d);
        }
    }
    fragColor = acc;
}
)";

//The spot in the sums of the measure shader (vals: r, g, b, a per cell, row by row, cells per side): [found, x, y, peak]
ledscan_spot(vals, cells = LEDSCAN_GRID, min_peak = LEDSCAN_MIN_PEAK) {
	n = cells * cells;
	if(vals.size() < n * 4)
		return [found = false, x = 0.0, y = 0.0, peak = 0.0];
	best = -1;
	peak = 0.0;
	for(i = 0; i < n; i++) {
		if(vals[i * 4 + 3] > peak) {
			peak = vals[i * 4 + 3];
			best = i;
		}
	}
	if(best < 0 || peak < min_peak)
		return [found = false, x = 0.0, y = 0.0, peak = peak];
	bx = best % cells;
	by = std.int(best / cells);
	w = 0.0;
	sx = 0.0;
	sy = 0.0;
	for(y = math.max(0, by - LEDSCAN_NEAR_CELLS); y <= math.min(cells - 1, by + LEDSCAN_NEAR_CELLS); y++) {
		for(x = math.max(0, bx - LEDSCAN_NEAR_CELLS); x <= math.min(cells - 1, bx + LEDSCAN_NEAR_CELLS); x++) {
			k = (y * cells + x) * 4;
			w += vals[k];
			sx += vals[k + 1];
			sy += vals[k + 2];
		}
	}
	if(w <= 0.0)
		return [found = false, x = 0.0, y = 0.0, peak = peak];
	return [found = true, x = sx / w, y = sy / w, peak = peak];
}

//The floats of the read-back buffer of the measure shader (RGBA float32: 16 bytes per cell)
ledscan_values(buffer, cells = LEDSCAN_GRID) {
	vals = [];
	n = cells * cells * 4;
	if(!buffer || buffer.size() < n * 4)
		return vals;
	for(i = 0; i < n; i++)
		vals.push_back(buffer.read("f32", i));
	return vals;
}

//The places of a run of LEDs (one segment) from what the scan found: [[found, x, y], ...] in the order of the LEDs.
//A LED that was not seen (hidden, too dim) gets a place between its neighbours that were, along the strip; at the ends
//it continues the step of the last two seen. Returns [points = [[x, y], ...], missing] or None when fewer than 2 were seen
ledscan_points(found) {
	seen = [];
	for(i = 0; i < found.size(); i++) {
		if(found[i].found)
			seen.push_back(i);
	}
	if(seen.size() < 2)
		return None;
	pts = [];
	k = 0; //seen[k] <= i < seen[k + 1]
	for(i = 0; i < found.size(); i++) {
		if(found[i].found) {
			pts.push_back([x = found[i].x, y = found[i].y]);
			continue;
		}
		for(k + 1 < seen.size() && seen[k + 1] < i)
			k++;
		a = seen[k];
		b = seen[math.min(k + 1, seen.size() - 1)];
		if(i < seen[0]) {
			a = seen[0];
			b = seen[1];
		}
		else if(i > seen[-1]) {
			a = seen[-2];
			b = seen[-1];
		}
		t = (i - a) / std.float(b - a);
		pts.push_back([x = found[a].x + (found[b].x - found[a].x) * t, y = found[a].y + (found[b].y - found[a].y) * t]);
	}
	return [points = pts, missing = found.size() - seen.size()];
}

//Fits places of the camera picture into the LEDMapper's picture: the box around all of them fills it (less a margin),
//keeping their proportions (cam_aspect, pic_aspect: width / height of the camera and of the picture). lists: several
//lists of [x, y], changed in place (all of one scan, so the segments stay where they are to each other)
ledscan_fit(lists, cam_aspect, pic_aspect, margin = 0.05) {
	lo_x = 1e9;
	lo_y = 1e9;
	hi_x = -1e9;
	hi_y = -1e9;
	for(l : lists) {
		for(p : l) {
			lo_x = math.min(lo_x, p.x);
			hi_x = math.max(hi_x, p.x);
			lo_y = math.min(lo_y, p.y);
			hi_y = math.max(hi_y, p.y);
		}
	}
	if(lo_x > hi_x)
		return lists;
	//in units of the camera's height: x * cam_aspect, y
	w = math.max(1e-6, (hi_x - lo_x) * cam_aspect);
	h = math.max(1e-6, hi_y - lo_y);
	room_w = pic_aspect * (1.0 - 2.0 * margin);
	room_h = 1.0 - 2.0 * margin;
	s = math.min(room_w / w, room_h / h);
	cx = (lo_x + hi_x) / 2.0;
	cy = (lo_y + hi_y) / 2.0;
	for(li = 0; li < lists.size(); li++) {
		for(i = 0; i < lists[li].size(); i++) {
			q = lists[li][i];
			px = (q.x - cx) * cam_aspect * s;
			py = (q.y - cy) * s;
			lists[li][i] = [x = 0.5 + px / pic_aspect, y = 0.5 + py];
		}
	}
	return lists;
}

//The scan itself, frame by frame: tick() says which LED to light (-1: all dark) and whether the reference is taken,
//and takes the spot measured. leds: the indices of the LEDs to scan (in the order sent, as the LEDMapper's buffer)
class LedScan {
	leds = [];
	wait_ms = LEDSCAN_WAIT_MS;
	state = "idle";       //idle, dark (taking the reference), led (one lit, waiting for the camera), done, stopped
	index = 0;            //of leds
	since = 0;            //when the state or the LED changed (ms)
	found = [];           //per LED of leds: [found, x, y, peak]
	since_ref = 0;        //LEDs since the last reference

	start(list, now, wait = LEDSCAN_WAIT_MS) {
		leds = list;
		wait_ms = math.max(30, wait);
		found = [];
		index = 0;
		since_ref = 0;
		state = leds.size() ? "dark" : "done";
		since = now;
	}

	stop() {
		if(state == "dark" || state == "led")
			state = "stopped";
	}

	running() {
		return state == "dark" || state == "led";
	}

	//0..1
	progress() {
		return leds.size() ? found.size() / std.float(leds.size()) : 1.0;
	}

	seen() {
		n = 0;
		for(f : found) {
			if(f.found)
				n++;
		}
		return n;
	}

	//One frame: spot = ledscan_spot() of the latest picture (None before the first). Returns [lit = index of the LED to
	//light or -1, capture = 1 while the reference follows the camera]
	tick(now, spot) {
		if(state == "dark") {
			if(now - since >= wait_ms) {
				state = "led";
				since = now;
				since_ref = 0;
				return [lit = leds[index], capture = 0];
			}
			return [lit = -1, capture = 1];
		}
		if(state != "led")
			return [lit = -1, capture = 0];
		if(now - since < wait_ms)
			return [lit = leds[index], capture = 0];
		found.push_back(spot ? [found = spot.found, x = spot.x, y = spot.y, peak = spot.peak] : [found = false, x = 0.0, y = 0.0, peak = 0.0]);
		index++;
		since_ref++;
		since = now;
		if(index >= leds.size()) {
			state = "done";
			return [lit = -1, capture = 0];
		}
		if(since_ref >= LEDSCAN_REF_EVERY) {
			state = "dark";
			return [lit = -1, capture = 1];
		}
		return [lit = leds[index], capture = 0];
	}
}

//The two shaders of the scan on the GPU, in a hidden widget of parent: the reference and the measure. They render every
//frame (a hidden shader does), so make one only for a scan and free it after. source() is the camera's picture (a
//nanogui.video, or any shader)
class LedScanGpu {
	managed host = None;
	managed ref = None;
	managed measure = None;

	__init__(parent) {
		host = parent.widget().visible(false).fixed_size(vec2f(8, 8));
		//(each widget as big as its picture: a shader maps its picture into the rectangle of its widget)
		ref = host.shader();
		ref.fixed_size(vec2f(640, 360));
		ref.size(vec2f(640, 360));
		ref.fragment_source(LEDSCAN_REF_SRC);
		ref.render_size(vec2i(640, 360));
		ref.keep_aspect_ratio(false);
		ref.output_component_format("uint8");
		ref.output_pixel_format("rgba");
		ref.input("feedback", ref);
		ref.uniform("capture", 1);
		measure = host.shader();
		measure.fixed_size(vec2f(LEDSCAN_GRID, LEDSCAN_GRID));
		measure.size(vec2f(LEDSCAN_GRID, LEDSCAN_GRID));
		measure.fragment_source(LEDSCAN_MEASURE_SRC);
		measure.render_size(vec2i(LEDSCAN_GRID, LEDSCAN_GRID));
		measure.keep_aspect_ratio(false);
		measure.output_component_format("float32");
		measure.output_pixel_format("rgba");
		measure.pixel_readback(true);
		measure.input("reference", ref);
		measure.uniform("grid", LEDSCAN_GRID);
		measure.uniform("samples", LEDSCAN_SAMPLES);
		measure.uniform("noise", 0.02);
	}

	source(picture) {
		ref.input("camera", picture);
		measure.input("camera", picture);
	}

	//The reference follows the camera while capture is 1, else it holds its picture
	frame(capture) {
		ref.uniform("capture", capture ? 1 : 0);
	}

	//The spot of the latest measure read back (None before the first)
	spot() {
		vals = ledscan_values(measure.pixel_buffer());
		return vals.size() ? ledscan_spot(vals) : None;
	}
}

// =========================================================================
// The spot of one LED through a material (#980: Stage › Materials › Measure with a camera)
// =========================================================================

//How wide and how bright the light is that comes through: the light brighter than the dark reference, weighted as it
//is (not squared: its second moment is the spread). Render size 2 * grid x grid: the left half per cell r = sum of
//weights, g = sum weight * x, b = sum weight * y, a = peak; the right half r = sum weight * x², g = sum weight * y²
//(x, y 0..1 of the picture as shown, y down)
LEDSCAN_BLOB_SRC = R"(
#version 330 core
uniform sampler2D camera;
uniform sampler2D reference;
uniform int grid;
uniform int samples;
uniform float noise;
void main()
{
    ivec2 fc = ivec2(gl_FragCoord.xy);
    int second = fc.x / grid;
    ivec2 cell = ivec2(fc.x % grid, fc.y);
    float n = float(grid * samples);
    vec4 acc = vec4(0.0);
    for(int j = 0; j < samples; j++) {
        for(int i = 0; i < samples; i++) {
            vec2 uv = (vec2(cell * samples + ivec2(i, j)) + 0.5) / n;
            vec3 c = texture(camera, uv).rgb;
            vec3 r = texture(reference, uv).rgb;
            float d = max(max(c.r - r.r, c.g - r.g), c.b - r.b);
            float w = max(d - noise, 0.0);
            float x = uv.x;
            float y = 1.0 - uv.y;
            if(second == 0) {
                acc.rgb += vec3(w, w * x, w * y);
                acc.a = max(acc.a, d);
            }
            else
                acc.rg += vec2(w * x * x, w * y * y);
        }
    }
    fragColor = acc;
}
)";

//The spot from the read-back sums of the blob shader (vals: 2 * cells x cells cells, 4 floats each, row by row):
//[found, x, y (its middle, 0..1 of the picture, y down), sx, sy (its sigma along x and y, in widths and heights of the
//picture), flux (the light above the dark per sample: the same picture, the same camera, comparable), peak]
ledscan_blob(vals, cells = LEDSCAN_GRID, min_peak = LEDSCAN_BLOB_MIN_PEAK, noise = LEDSCAN_BLOB_NOISE) {
	none = [found = false, x = 0.0, y = 0.0, sx = 0.0, sy = 0.0, flux = 0.0, peak = 0.0];
	if(vals.size() < cells * cells * 8)
		return none;
	w = 0.0;
	sx = 0.0;
	sy = 0.0;
	sxx = 0.0;
	syy = 0.0;
	peak = 0.0;
	row = cells * 2;
	for(y = 0; y < cells; y++) {
		for(x = 0; x < cells; x++) {
			a = (y * row + x) * 4;
			b = (y * row + cells + x) * 4;
			w += vals[a];
			sx += vals[a + 1];
			sy += vals[a + 2];
			peak = math.max(peak, vals[a + 3]);
			sxx += vals[b];
			syy += vals[b + 1];
		}
	}
	none.peak = peak;
	if(w <= 0.0 || peak < min_peak)
		return none;
	mx = sx / w;
	my = sy / w;
	n = std.float(cells * LEDSCAN_SAMPLES);
	vx = math.max(0.0, sxx / w - mx * mx);
	vy = math.max(0.0, syy / w - my * my);
	//The light under the noise threshold t is not counted: of a gaussian spot of peak A the rim is cut where it is t
	//(L = ln(A / t)). Counted then: 2 pi s^2 (A - t - t L) of 2 pi s^2 A; its second moment s^2 (A - t (1 + L) - t L^2 / 2)
	/// (A - t - t L) of s^2. A faint, wide spot loses more than a bright one: both put back
	k_var = 1.0;
	k_flux = 1.0;
	t = noise;
	if(t > 0.0 && peak > t * 1.01) {
		L = math.log(peak / t);
		den = peak - t - t * L;
		fx = peak - t * (1.0 + L) - t * L * L / 2.0;
		if(den > 1e-9 && fx > 1e-9) {
			k_var = den / fx;
			k_flux = peak / den;
		}
	}
	return [found = true, x = mx, y = my, sx = math.sqrt(vx * k_var), sy = math.sqrt(vy * k_var), flux = w / (n * n) * k_flux, peak = peak];
}

//The spot in metres on the surface: the camera sees width metres across (at the surface), aspect = its width / height.
//sigma: the mean of both axes
ledscan_blob_metres(b, width, aspect) {
	sx = b.sx * width;
	sy = b.sy * width / math.max(0.01, aspect);
	return math.sqrt((sx * sx + sy * sy) / 2.0);
}

//The floats of the blob shader's read-back (2 * grid x grid RGBA float32)
ledscan_blob_buffer(buffer, cells = LEDSCAN_GRID) {
	n = cells * cells * 8;
	if(!buffer || buffer.size() < n * 4)
		return None;
	vals = [];
	for(i = 0; i < n; i++)
		vals.push_back(buffer.read("f32", i));
	return ledscan_blob(vals, cells);
}

//The reference and the blob shader in a hidden widget of parent (as LedScanGpu); frames() of the camera are averaged
//by the caller: blob() after each frame
class LedBlobGpu {
	managed host = None;
	managed ref = None;
	managed blob_shader = None;

	__init__(parent) {
		host = parent.widget().visible(false).fixed_size(vec2f(8, 8));
		ref = host.shader();
		ref.fixed_size(vec2f(640, 360));
		ref.size(vec2f(640, 360));
		ref.fragment_source(LEDSCAN_REF_SRC);
		ref.render_size(vec2i(640, 360));
		ref.keep_aspect_ratio(false);
		ref.output_component_format("uint8");
		ref.output_pixel_format("rgba");
		ref.input("feedback", ref);
		ref.uniform("capture", 1);
		blob_shader = host.shader();
		blob_shader.fixed_size(vec2f(LEDSCAN_GRID * 2, LEDSCAN_GRID));
		blob_shader.size(vec2f(LEDSCAN_GRID * 2, LEDSCAN_GRID));
		blob_shader.fragment_source(LEDSCAN_BLOB_SRC);
		blob_shader.render_size(vec2i(LEDSCAN_GRID * 2, LEDSCAN_GRID));
		blob_shader.keep_aspect_ratio(false);
		blob_shader.output_component_format("float32");
		blob_shader.output_pixel_format("rgba");
		blob_shader.pixel_readback(true);
		blob_shader.input("reference", ref);
		blob_shader.uniform("grid", LEDSCAN_GRID);
		blob_shader.uniform("samples", LEDSCAN_SAMPLES);
		blob_shader.uniform("noise", LEDSCAN_BLOB_NOISE);
	}

	source(picture) {
		ref.input("camera", picture);
		blob_shader.input("camera", picture);
	}

	//capture 1: the reference follows the camera (the dark picture), 0: held
	dark(capture) {
		ref.uniform("capture", capture ? 1 : 0);
	}

	//The spot of the latest frame read back (None before the first)
	blob() {
		return ledscan_blob_buffer(blob_shader.pixel_buffer());
	}

	free() noexcept {
		try {
			std.free(host);
		}
		catch(e) {}
	}
}

//The picture of a camera (#980): of the generator live_path (a Camera: its video; any other, an NDI receiver, a capture
//card: the picture of its default output), else of the only Camera generator. engine: has ai_capture
ledscan_picture(engine, live_path) {
	g = live_path ? engine.ai_capture.generator(live_path) : engine.ai_capture.camera(None);
	if(!g)
		std.runtime_error("The generator " + live_path + " is gone");
	pic = None;
	try {
		pic = g.dispatch("get_capture_widget");
		if(!pic) {
			out = g.dispatch("get_default_output");
			pic = out ? out.value() : None;
		}
	}
	catch(e) {}
	if(!pic)
		std.runtime_error("The generator " + g.get_live_path() + " shows no picture");
	return pic;
}

//Width / height of a picture: a shader by its render size (its width() is the widget's), a video by its frames
ledscan_picture_aspect(pic) {
	try {
		rs = pic.render_size();
		if(rs && rs.x > 0 && rs.y > 0)
			return rs.x / std.float(rs.y);
	}
	catch(e) {}
	try {
		if(pic.width() > 0 && pic.height() > 0)
			return pic.width() / std.float(pic.height());
	}
	catch(e) {}
	return 16.0 / 9.0;
}

//The generators a picture can come from: the Camera generators, [[live_path, name], ...]
ledscan_cameras(engine) {
	out = [];
	try {
		for(c : engine.ai_capture.cameras()) {
			name = std.is_json(c.status) && c.status.has("camera") && c.status.camera ? c.status.camera : "";
			out.push_back([live_path = c.live_path, name = name ? name + " (" + c.live_path + ")" : c.live_path]);
		}
	}
	catch(e) {}
	return out;
}
