//Reads a 3MF archive for engine/stage/stage_models.shio (#980), loaded there in a module of its own: the import zip of
//this file is the only one of the stage, so the stage still loads without the zip package.
import zip;

//[start (the path of the root model part), files (path -> XML text of every .model part), error ("" when it could be
//read)]
stage_zip_3mf(path) {
	res = [start = "", files = std.json(), error = ""];
	try {
		z = zip.file(path);
		names = z.names();
		//the root part: the relationship of type .../3dmodel in _rels/.rels, else 3D/3dmodel.model
		if(z.has("_rels/.rels")) {
			rels = z.read("_rels/.rels");
			at = rels.find("3dmodel\"");
			if(at < 0)
				at = rels.find("3dmodel'");
			if(at >= 0) {
				s = rels.rfind("<Relationship", at);
				e = rels.find(">", at);
				if(s >= 0 && e > s) {
					tag = rels.substr(s, e - s);
					t = tag.find("Target=\"");
					if(t >= 0) {
						t += 8;
						res.start = tag.substr(t, tag.find("\"", t) - t);
					}
				}
			}
		}
		if(!res.start)
			res.start = "3D/3dmodel.model";
		if(res.start.starts("/"))
			res.start = res.start.substr(1);
		for(n : names) {
			if(std.string(n).lowercase().ends(".model"))
				res.files[n] = z.read(n);
		}
		if(!res.files.size())
			res.error = fileio.file_name(path) + " has no 3D model part: not a 3MF file.";
	}
	catch(e) {
		res.error = "Cannot read " + fileio.file_name(path) + ": not a zip archive (a .3mf file is one).";
	}
	return res;
}
