		[k = "height", label = "Height m", kind = "float", def = 0.6, min = 0.05, max = 3.0, step = 0.2, tip = "Top of the decks above the floor (legs of 20 to 100 cm are common)"],
		[k = "surface", label = "Surface", kind = "choice", def = "black", values = ["black", "grey", "wood"]],
		[k = "skirt", label = "Skirt", kind = "choice", def = "front", values = ["none", "front", "around"], labels = ["None", "Front", "All around"],
			tip = "Black cloth (molton) from the edge of the decks to the floor"]],
	stairs = [
		[k = "width", label = "Width m", kind = "float", def = 1.0, min = 0.3, max = 6.0, step = 0.25],
