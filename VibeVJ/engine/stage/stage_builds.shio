//What stands at every show, made from its measures (#980): trusses, stage decks, stairs, ground support towers, crank
//stands, speakers, front barriers, curtains, a DJ booth. No model file: an object of kind "build" whose model is made
//here (like the screens), each type with its measures (STAGE_BUILD_PARAMS: the defaults, the limits and the rows of the
//Stage menu's inspector) and presets in the sizes of the common rental systems (STAGE_BUILD_LIBRARY: the Build button).
//
//  o.build = [type ("truss", "deck", "stairs", "tower", "stand", "speaker", "barrier", "curtain", "booth"), the
//             measures of that type (STAGE_BUILD_PARAMS)]
//
//- Its place (x, y, z) is the middle of its bottom, its front towards the audience (+y), metres. A straight truss lies
//  along x; an arc lies flat around its place, its middle at +y; stairs go up from the audience towards -y, their top
//  step's back edge at y 0 (put that edge at the front of a deck).
//- stage_build_nodes: where another piece can be joined (the ends of a truss, the top of a tower): the point and the
//  direction out of it, in the object's own frame.

def stage_build_param(type, k);
def stage_build_m(v);
def stage_build_index(l, v);
def stage_build_color(name);
def stage_build_box(p, x0, y0, z0, x1, y1, z1);
def stage_truss_profile(c);
def stage_truss_path(c);
def stage_truss_at(s, ch);
def stage_truss_parts(c, p);

STAGE_BUILD_TYPES = ["truss", "deck", "stairs", "tower", "stand", "speaker", "barrier", "curtain", "booth"];
STAGE_BUILD_NAMES = ["Truss", "Stage", "Stairs", "Tower", "Stand", "Speaker", "Barrier", "Curtain", "DJ booth"];
STAGE_BUILD_COLORS = [silver = [0.78, 0.79, 0.82], black = [0.07, 0.07, 0.08], grey = [0.35, 0.35, 0.37], wood = [0.55, 0.40, 0.25],
	red = [0.45, 0.05, 0.06], white = [0.88, 0.88, 0.88], dark = [0.16, 0.16, 0.17]];
STAGE_BUILD_COLOR_LABELS = [silver = "Aluminium", black = "Black", grey = "Grey", wood = "Wood", red = "Red", white = "White", dark = "Dark grey"];

