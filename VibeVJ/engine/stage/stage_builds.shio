			tip = "From the middle of the circle to the middle of the truss"],
		[k = "angle", label = "Angle °", kind = "float", def = 360.0, min = 5.0, max = 360.0, step = 15.0, when = ["path", "arc"],
			tip = "How much of the circle (360: closed, 90: a quarter)"],
		[k = "width", label = "Width m", kind = "float", def = 0.29, min = 0.05, max = 3.0, step = 0.01, tip = "Outside of the chords (290 mm: the common rental truss)"],
		[k = "chord", label = "Chord Ø m", kind = "float", def = 0.048, min = 0.005, max = 0.5, step = 0.002, tip = "Diameter of the tubes along it"],
		[k = "brace", label = "Brace Ø m", kind = "float", def = 0.016, min = 0.002, max = 0.3, step = 0.002, tip = "Diameter of the diagonal tubes"],
		[k = "spacing", label = "Brace step m", kind = "float", def = 0.0, min = 0.0, max = 10.0, step = 0.05, tip = "Metres between two braces along it; 0: as wide as the truss"],
