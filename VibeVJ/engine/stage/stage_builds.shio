		[k = "folds", label = "Folds", kind = "int", def = 24, min = 0, max = 400, step = 1, tip = "How many folds across (0: flat)"],
		[k = "color", label = "Colour", kind = "choice", def = "black", values = ["black", "red", "white", "grey"]],
		[k = "pipe", label = "Pipe", kind = "choice", def = "yes", values = ["yes", "no"], labels = ["On a pipe", "None"]]],
	booth = [
		[k = "width", label = "Width m", kind = "float", def = 2.0, min = 0.5, max = 6.0, step = 0.1],
		[k = "depth", label = "Depth m", kind = "float", def = 0.8, min = 0.3, max = 2.0, step = 0.1],
		[k = "height", label = "Height m", kind = "float", def = 1.0, min = 0.5, max = 1.5, step = 0.05, tip = "Top of the table (about 1 m to play standing)"],
		[k = "finish", label = "Finish", kind = "choice", def = "black", values = ["black", "white", "wood"]]]];

