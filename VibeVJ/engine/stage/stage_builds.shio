		[k = "width", label = "Truss m", kind = "float", def = 0.29, min = 0.15, max = 1.0, step = 0.01, tip = "The square truss of the tower"],
		[k = "base", label = "Base plate m", kind = "float", def = 0.8, min = 0.3, max = 3.0, step = 0.1],
		[k = "finish", label = "Finish", kind = "choice", def = "silver", values = ["silver", "black"]]],
	stand = [
		[k = "height", label = "Height m", kind = "float", def = 3.5, min = 1.0, max = 8.0, step = 0.25, tip = "Cranked up to"],
		[k = "bar", label = "T-bar m", kind = "float", def = 1.2, min = 0.0, max = 4.0, step = 0.1, tip = "Width of the bar on top for the lamps (0: none)"],
		[k = "finish", label = "Finish", kind = "choice", def = "black", values = ["black", "silver"]]],
	speaker = [
		[k = "width", label = "Width m", kind = "float", def = 0.4, min = 0.05, max = 3.0, step = 0.05],
		[k = "depth", label = "Depth m", kind = "float", def = 0.4, min = 0.05, max = 3.0, step = 0.05],
		[k = "height", label = "Height m", kind = "float", def = 0.65, min = 0.05, max = 4.0, step = 0.05],
		[k = "pole", label = "On a stand m", kind = "float", def = 1.6, min = 0.0, max = 4.0, step = 0.1, tip = "The bottom of the box on a stand this high (0: on the floor)"],
		[k = "finish", label = "Finish", kind = "choice", def = "black", values = ["black", "white"]]],
	barrier = [
		[k = "count", label = "Elements", kind = "int", def = 6, min = 1, max = 100, step = 1],
		[k = "element", label = "Element m", kind = "float", def = 1.0, min = 0.3, max = 3.0, step = 0.1],
