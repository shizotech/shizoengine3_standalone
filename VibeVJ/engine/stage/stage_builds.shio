		[k = "plate", label = "Step plate m", kind = "float", def = 0.9, min = 0.0, max = 2.0, step = 0.1, tip = "The plate the crowd stands on, in front (0: a light barrier without)"],
		[k = "finish", label = "Finish", kind = "choice", def = "silver", values = ["silver", "black"]]],
	curtain = [
		[k = "width", label = "Width m", kind = "float", def = 6.0, min = 0.5, max = 50.0, step = 0.5],
