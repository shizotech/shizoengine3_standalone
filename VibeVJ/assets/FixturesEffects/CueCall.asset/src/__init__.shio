//Cue call (#719): what comes next on the master deck, per crew (Lighting, Video, SFX, Laser: the crews of the desk's
//shows per track), counted down in bars.beats with standby / 3 / 2 / 1 / GO on the beat. Items: the cues of the track's
//show, rekordbox cues whose name a rule waits for, look-ahead actions, phrases a phrase trigger fits; the last row is
//the next phrase. engine.desk.shows.cue_call() (engine/patch/desk_show_runtime.shio); phones see the same on the page
//cuecall of the web remote. No sound: VibeVJ has no speech output.

import nanogui;

using eigen;
using nanogui;

#include "engine/patch/patch"
#include "engine/patch/fx"
#include "engine/patch/desk"
#include "engine/patch/palette"

def draw_call();

engine = None;
desk = None;
managed view = None;
call = None;

//The colour of a state: GO green, 3 / 2 / 1 the cue colour, standby a dim cue colour
state_color(state) {
	if(state == "go")
		return PAL_ON;
	if(state == "1" || state == "2" || state == "3")
		return PAL_CUE;
	if(state == "standby")
		return pal_alpha(PAL_CUE, 0.45);
	return PAL_LINE_STRONG;
}

draw_tile(x, y, w, h, row) {
	state = std.string(row.state ?? "");
	nvgBeginPath();
	nvgRoundedRect(vec2f(x, y), vec2f(w, h), 8.0);
	nvgFillColor(state == "go" ? pal_alpha(PAL_ON, 0.85) : PAL_RAISED);
	nvgFill();
	nvgStrokeColor(state_color(state));
	nvgStrokeWidth(state == "" ? 1.0 : 3.0);
	nvgStroke();
	ink = state == "go" ? PAL_CANVAS : PAL_TEXT;
	pal_text(vec2f(x + 14, y + 20), std.string(row.crew ?? ""), 15, state == "go" ? PAL_CANVAS : PAL_TEXT_2, PAL_ALIGN_LEFT_MIDDLE, "sans-bold");
	what = std.string(row.what ?? "");
	pal_text(vec2f(x + 14, y + 44), what ? what : "nothing ahead", 17, what ? ink : PAL_TEXT_3, PAL_ALIGN_LEFT_MIDDLE);
	if(row.has("at") && row.at)
		pal_text(vec2f(x + 14, y + h - 16), std.string(row.at), 12, state == "go" ? PAL_CANVAS : PAL_TEXT_3, PAL_ALIGN_LEFT_MIDDLE);
	big = "";
	if(state == "go")
		big = "GO";
	else if(state == "1" || state == "2" || state == "3")
		big = state;
	else if(what)
		big = std.string(row.text ?? "-");
	size = big == "GO" || big.length() == 1 ? h * 0.62 : h * 0.42;
	pal_text(vec2f(x + w - 16, y + h * 0.55), big, size, state == "go" ? PAL_CANVAS : (state ? PAL_CUE : PAL_TEXT), PAL_ALIGN_RIGHT_MIDDLE, "sans-bold");
	if(state == "standby")
		pal_text(vec2f(x + w - 16, y + 16), "STANDBY", 12, PAL_CUE, PAL_ALIGN_RIGHT_MIDDLE, "sans-bold");
}

draw_call() {
	if(!view || !desk)
		return;
	sz = view.size();
	nvgBeginPath();
	nvgRect(vec2f(0, 0), sz);
	nvgFillColor(PAL_CANVAS);
	nvgFill();
	c = call;
	if(!c || !(c.deck ?? 0)) {
		pal_text(vec2f(sz.x / 2, sz.y / 2), c && c.has("waiting") ? std.string(c.waiting) : "No master deck", 16, PAL_TEXT_3, PAL_ALIGN_CENTER_MIDDLE);
		return;
	}
	head = "Deck " + std.string(c.deck) + " · " + std.string(c.title ?? "") + "   " + std.string(c.bar ?? "") + (c.playing ? "" : " (paused)");
	pal_text(vec2f(12, 18), head, 15, PAL_TEXT, PAL_ALIGN_LEFT_MIDDLE, "sans-bold");
	if(c.phrase)
		pal_text(vec2f(sz.x - 12, 18), "Phrase: " + std.string(c.phrase), 14, PAL_TEXT_2, PAL_ALIGN_RIGHT_MIDDLE);
	rows = [];
	for(r : c.rows)
		rows.push_back(r);
	if(c.next_phrase)
		rows.push_back(c.next_phrase);
	if(!rows.size())
		return;
	cols = sz.x >= 760 ? 2 : 1;
	gap = 10.0;
	lines = math.ceil(rows.size() / std.float(cols));
	tile_w = (sz.x - gap * (cols + 1)) / cols;
	tile_h = math.clamp((sz.y - 40 - gap * (lines + 1)) / lines, 60.0, 180.0);
	for(i, r : rows) {
		cx = i % cols;
		cy = std.int(math.floor(i / std.float(cols)));
		draw_tile(gap + cx * (tile_w + gap), 36 + gap + cy * (tile_h + gap), tile_w, tile_h, r);
	}
}

update(generator, tl_pos, pos_delta) {
	if(!desk)
		return;
	call = desk.shows.cue_call();
}

dispatcher(generator, cmd, value) {
	return None;
}

entry(generator, area) {
	engine = generator.engine;
	desk = engine.desk;
	generator.window.fixed_size(vec2f(820, 520));
	area.layout(None);
	view = area.widget().anchor_left(0).anchor_right(0).anchor_top(0).anchor_bottom(0);
	view.tooltip("The cue call of the master deck: per crew the next cue, named cue, look-ahead or phrase trigger in bars.beats, standby / 3 / 2 / 1 / GO on the beat. Phones: /cuecall of the web remote\n[[wiki:Lighting-Desk#cue-call]]");
	view.on_draw([]() { draw_call(); });
}
