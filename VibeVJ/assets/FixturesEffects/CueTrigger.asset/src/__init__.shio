//CueTrigger (#719): starts a cue of a cue stack of the desk when it is switched on. Put it into a clip of a Clipview
//or a CueList: the clip that starts the video starts the light with it, one show for picture and light. Or press
//Trigger (map it, or link a beat or a button into it).
//
//- Stack, What (Go: the next cue, Go to cue, Back, Off) and the Cue number for Go to.
//- When a clip with it starts (its generators are switched on), and on Trigger. Not when a project loads.

import nanogui;

using eigen;
using nanogui;

#include "engine/patch/patch"
#include "engine/patch/fx"
#include "engine/patch/desk"
#include "engine/patch/palette"

CT_ROW = 28;
CT_ACTIONS = ["Go", "Go to cue", "Back", "Off"];
CT_ACTION_IDS = ["go", "goto", "back", "off"];

engine = None;
desk = None;
managed stack_combo = None;
managed action_combo = None;
managed cue_box = None;
managed trigger_btn = None;
managed info = None;

stack_id = "";
stack_ids = [];
action = 0;
cue_number = 1.0;
was_active = false;
ready_ms = 0;      //switched on before this (the generator was just made or loaded): no trigger
seen_revision = -1;

//Runs the action on the stack
fire() {
	if(!desk || !stack_id)
		return;
	cue = desk.go(stack_id, CT_ACTION_IDS[math.clamp(action, 0, CT_ACTIONS.size() - 1)], cue_number);
	s = desk_stack(desk.data, stack_id);
	if(info && s)
		info.caption(CT_ACTIONS[action] + " on " + s.name + (cue ? ": cue " + desk_num_text(cue.number) + " " + cue.name : ""));
}

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		on = value && generator.active_btn.value();
		if(on && !was_active && engine && !engine.load_in_progress && std.millis() >= ready_ms)
			fire();
		was_active = on ? true : false;
	}
	return None;
}

fill_stacks() {
	seen_revision = desk.revision;
	items = ["Pick a stack…"];
	stack_ids = [""];
	sel = 0;
	for(i = 0; i < desk.data.stacks.size(); i++) {
		s = desk.data.stacks[i];
		items.push_back(s.name);
		stack_ids.push_back(s.id);
		if(s.id == stack_id)
			sel = i + 1;
	}
	if(stack_id && sel == 0) {
		items.push_back("(deleted stack)");
		stack_ids.push_back(stack_id);
		sel = items.size() - 1;
	}
	stack_combo.items(items).selected(sel);
}

update(generator, tl_pos, pos_delta) {
	if(desk && stack_combo && desk.revision != seen_revision)
		fill_stacks();
}

entry(generator, area) {
	engine = generator.engine;
	desk = engine.desk;
	ready_ms = std.millis() + 1000;
	generator.window.fixed_size(vec2f(320, 200));
	area.layout(nanogui.layout_vertical());
	stack_combo = area.combobox().fixed_height(CT_ROW);
	stack_combo.tooltip("The cue stack of the desk (made in the Programmer)\n[[wiki:Lighting-Desk#light-cues-in-clips]]");
	stack_combo.on_open([]() { fill_stacks(); });
	stack_combo.on_change([](index, text) {
		if(index >= 0 && index < stack_ids.size())
			stack_id = stack_ids[index];
	});
	action_combo = area.combobox().items(CT_ACTIONS).fixed_height(CT_ROW);
	action_combo.tooltip("Go: the next cue. Go to cue: the cue with the number below. Back: the cue before. Off: the stack lets go");
	action_combo.on_change([](index, text) {
		action = index;
	});
	row = area.widget().fixed_height(CT_ROW);
	row.label("Cue").anchor_left(0).fixed_width(60).fixed_height(CT_ROW).text_color(PAL_TEXT_2);
	cue_box = row.floatbox().value(cue_number).alignment("right").anchor_left(60).anchor_right(0).fixed_height(CT_ROW);
	cue_box.min_value(0.0).max_value(9999.0).tooltip("The cue number for Go to cue");
	cue_box.value_callback([](v) {
		cue_number = v;
	});
	trigger_btn = area.controlbutton("Trigger").caption("Trigger").fixed_height(CT_ROW);
	trigger_btn.tooltip("Runs it now. Link a beat or a button into it, or map it to MIDI");
	trigger_btn.undoable(false);
	trigger_btn.callback([](v) {
		if(v)
			fire();
	});
	info = area.label("When a clip with this starts, or on Trigger").fixed_height(20).text_color(PAL_TEXT_3);
	fill_stacks();
}

save_state() {
	return [stack = stack_id, action = action, cue = cue_number];
}

load_state(state) {
	stack_id = std.string(state.stack ?? "");
	action = math.clamp(std.int(state.action ?? 0), 0, CT_ACTIONS.size() - 1);
	cue_number = std.float(state.cue ?? 1.0);
	if(action_combo)
		action_combo.selected(action);
	if(cue_box)
		cue_box.value(cue_number);
	if(stack_combo)
		fill_stacks();
	ready_ms = std.millis() + 1000;
}
