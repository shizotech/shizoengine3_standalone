//LampValues (#719): the channels of one lamp of the fixture setup as pure outputs, to link into anything: the
//parameters of a shader follow a lamp as a moving head follows the desk. With a Look (a virtual lamp of the type
//Fixtures > Virtual > Look: Dimmer, Colour, Speed, Size, FX 1 to 4) a shader is a lamp of the desk: palettes, cues, the
//Phaser and the executors move it, and a console moves it over its Art-Net mapping.
//
//- Lamp: any lamp (a real one too: a shader that follows the colour of a par). New look makes a virtual Look lamp.
//- One row per channel, 0 to 1, as Devices > Fixtures sends it (the Group masters and the blackout included).

import nanogui;

using eigen;
using nanogui;

#include "engine/patch/patch"
#include "engine/patch/palette"

LV_ROW = 28;
LV_LOOK_TYPE = "assets/Fixtures/Virtual/Look.json";

engine = None;
managed lamp_combo = None;
managed rows_content = None;
managed info = None;

lamp_id = "";
lamp_ids = [];
outputs = [];        //[[ctrl, index], ...] one per control of the type of the lamp
built_for = "x";     //lamp id and type signature the rows were built for
combo_revision = -1;
active = true;

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return;
		active = value;
	}
}

fill_combo() {
	combo_revision = engine.patch_revision;
	items = ["Pick a lamp…"];
	lamp_ids = [""];
	sel = 0;
	p = engine.patch;
	for(i = 0; i < p.fixtures.size(); i++) {
		f = p.fixtures[i];
		items.push_back(f.name + " (" + patch_type(f.type).name + ")");
		lamp_ids.push_back(f.id);
		if(f.id == lamp_id)
			sel = i + 1;
	}
	if(lamp_id && sel == 0) {
		items.push_back("(deleted lamp)");
		lamp_ids.push_back(lamp_id);
		sel = items.size() - 1;
	}
	lamp_combo.items(items).selected(sel);
}

//The rows of the lamp: the names are the labels of its channels, so links stay while the lamp has them
build_rows() {
	rows_content.clear_children();
	outputs = [];
	f = lamp_id ? patch_find(engine.patch, lamp_id) : None;
	if(!f) {
		info.caption(lamp_id ? "The lamp is gone" : "Pick a lamp, or make a Look with New look");
		rows_content.parent().refresh_layout();
		return;
	}
	t = patch_type(f.type);
	info.caption(t.controls.size() + " channels of " + f.name + ": link them into a shader");
	for(i = 0; i < t.controls.size(); i++) {
		c = t.controls[i];
		ctrl = rows_content.controlslider(c.label, "lamp_values").as_output(true).fixed_height(LV_ROW);
		ctrl.tooltip(c.label + " of " + f.name + ", 0 to 1, as it is sent. A [[pure output]]: [[link]] it into a parameter of a shader\n[[wiki:Lighting-Desk#shaders-as-lamps]]");
		outputs.push_back([ctrl = ctrl, index = i]);
	}
	rows_content.parent().refresh_layout();
}

//A new virtual Look lamp, upstage, and this generator follows it
new_look() {
	p = engine.patch;
	added = patch_add(p, LV_LOOK_TYPE, 1, "", 0, 0, 0.0, -5.0);
	if(!added.size())
		return;
	added[0].z = 3.0;
	lamp_id = added[0].id;
	engine.patch_changed();
}

update(generator, tl_pos, pos_delta) {
	if(!engine || !rows_content)
		return;
	if(engine.patch_revision != combo_revision)
		fill_combo();
	f = lamp_id ? patch_find(engine.patch, lamp_id) : None;
	key = f ? f.id + ":" + patch_type(f.type).signature : lamp_id;
	if(key != built_for) {
		built_for = key;
		build_rows();
	}
	if(!f || !active || !engine.fixture_menu)
		return;
	menu = engine.fixture_menu;
	ctrls = menu.lamp_controls(f.id);
	type_entry = menu.types[f.type] ?? None;
	if(!type_entry)
		return;
	t = patch_type(f.type);
	for(i = 0; i < outputs.size(); i++) {
		k = outputs[i].index;
		if(k >= ctrls.size() || k >= t.controls.size())
			continue;
		v = menu.out_value(f, type_entry, t.controls[k].slot, ctrls[k].value(), 1.0);
		if(math.abs(outputs[i].ctrl.value() - v) > 0.00001)
			outputs[i].ctrl.value(v);
	}
}

entry(generator, area) {
	engine = generator.engine;
	generator.window.fixed_size(vec2f(380, 400));
	area.layout(None);
	top = area.widget().anchor_left(0).anchor_right(0).anchor_top(0).fixed_height(LV_ROW);
	lamp_combo = top.combobox().anchor_left(0).anchor_right(112).fixed_height(LV_ROW);
	lamp_combo.tooltip("The lamp of the [[fixture setup]] whose channels this sends");
	lamp_combo.on_change([](index, text) {
		if(index >= 0 && index < lamp_ids.size())
			lamp_id = lamp_ids[index];
	});
	look_btn = top.button("New look").icon(nanogui.icon("plus")).anchor_right(0).fixed_width(108).fixed_height(LV_ROW);
	look_btn.tooltip("A virtual lamp Look (Dimmer, Colour, Speed, Size, FX 1 to 4) for a shader: palettes, cues and the Phaser move it, then its channels come out here\n[[wiki:Lighting-Desk#shaders-as-lamps]]");
	look_btn.on_click([]() { new_look(); });
	info = area.label("").anchor_left(0).anchor_right(0).anchor_top(LV_ROW + 4).fixed_height(20).text_color(PAL_TEXT_3);
	rows_content = area.vscroll().anchor_left(0).anchor_right(0).anchor_top(LV_ROW + 28).anchor_bottom(0).content().layout(nanogui.layout_vertical());
	fill_combo();
}

save_state() {
	return [lamp = lamp_id];
}

//The rows first (same names as saved), then the controls get their links
load_state(state) {
	lamp_id = std.string(state.lamp ?? "");
	if(rows_content && engine) {
		fill_combo();
		f = lamp_id ? patch_find(engine.patch, lamp_id) : None;
		built_for = f ? f.id + ":" + patch_type(f.type).signature : lamp_id;
		build_rows();
	}
}
