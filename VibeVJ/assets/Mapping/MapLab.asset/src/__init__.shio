//SHADER SRC
shader_src = R"(
#version 330 core

uniform sampler2D u_input;

void main()
{
    fragColor = texture(u_input, v_uv);
}
)";

out_shader_src = R"(
#version 330 core

// Minimum alpha value that counts as a "solid" pixel.
// Used to detect solid<->transparent transitions for edge-local feathering.
#define EDGE_ALPHA_SOLID 0.1

uniform sampler2D in1;
uniform sampler2D in2;
uniform sampler2D in3;
uniform sampler2D in4;
uniform sampler2D in5;
uniform sampler2D in6;
uniform sampler2D in7;
uniform sampler2D in8;
uniform sampler2D in9;
uniform sampler2D in10;
uniform sampler2D in11;
uniform sampler2D in12;
uniform sampler2D in13;
uniform sampler2D in14;
uniform sampler2D in15;
uniform sampler2D in16;


uniform vec4 in1_rect;
uniform vec4 in2_rect;
uniform vec4 in3_rect;
uniform vec4 in4_rect;
uniform vec4 in5_rect;
uniform vec4 in6_rect;
uniform vec4 in7_rect;
uniform vec4 in8_rect;
uniform vec4 in9_rect;
uniform vec4 in10_rect;
uniform vec4 in11_rect;
uniform vec4 in12_rect;
uniform vec4 in13_rect;
uniform vec4 in14_rect;
uniform vec4 in15_rect;
uniform vec4 in16_rect;


// Per-input brightness

uniform float in1_brightness;
uniform float in2_brightness;
uniform float in3_brightness;
uniform float in4_brightness;
uniform float in5_brightness;
uniform float in6_brightness;
uniform float in7_brightness;
uniform float in8_brightness;
uniform float in9_brightness;
uniform float in10_brightness;
uniform float in11_brightness;
uniform float in12_brightness;
uniform float in13_brightness;
uniform float in14_brightness;
uniform float in15_brightness;
uniform float in16_brightness;


// Per-input lamp: 1 - (colour x dimmer) of the lamp of the slice (virtual fixtures). 0 = unchanged, so a slot
// that is never set leaves its slice as it is

uniform vec3 in1_lamp_dim;
uniform vec3 in2_lamp_dim;
uniform vec3 in3_lamp_dim;
uniform vec3 in4_lamp_dim;
uniform vec3 in5_lamp_dim;
uniform vec3 in6_lamp_dim;
uniform vec3 in7_lamp_dim;
uniform vec3 in8_lamp_dim;
uniform vec3 in9_lamp_dim;
uniform vec3 in10_lamp_dim;
uniform vec3 in11_lamp_dim;
uniform vec3 in12_lamp_dim;
uniform vec3 in13_lamp_dim;
uniform vec3 in14_lamp_dim;
uniform vec3 in15_lamp_dim;
uniform vec3 in16_lamp_dim;


// Per-input opacity

uniform float in1_opacity;
uniform float in2_opacity;
uniform float in3_opacity;
uniform float in4_opacity;
uniform float in5_opacity;
uniform float in6_opacity;
uniform float in7_opacity;
uniform float in8_opacity;
uniform float in9_opacity;
uniform float in10_opacity;
uniform float in11_opacity;
uniform float in12_opacity;
uniform float in13_opacity;
uniform float in14_opacity;
uniform float in15_opacity;
uniform float in16_opacity;


// Per-input blend mode
//
// 0 = Add
// 1 = Multiply
// 2 = Normal
// 3 = Screen
// 4 = Lighten
// 5 = Darken
// 6 = Overlay
// 7 = Difference
// 8 = Subtract

uniform int in1_blend_mode;
uniform int in2_blend_mode;
uniform int in3_blend_mode;
uniform int in4_blend_mode;
uniform int in5_blend_mode;
uniform int in6_blend_mode;
uniform int in7_blend_mode;
uniform int in8_blend_mode;
uniform int in9_blend_mode;
uniform int in10_blend_mode;
uniform int in11_blend_mode;
uniform int in12_blend_mode;
uniform int in13_blend_mode;
uniform int in14_blend_mode;
uniform int in15_blend_mode;
uniform int in16_blend_mode;


// x, y, width, height of THIS output

uniform vec4 current_rect;


// Edge feather width in projection-space pixels
// (0 = hard edges, old behavior)

uniform float edge_feather;


// Blend two colors.
vec4 blend_colors(
    vec4 base,
    vec4 layer,
    float opacity,
    int mode
)
{
    float alpha = clamp(opacity, 0.0, 1.0);

    // The layer's alpha determines whether the blend operation
    // actually affects the underlying image.
    float blend_alpha = alpha * clamp(layer.a, 0.0, 1.0);

    vec3 result;


    // 0 = Add
    if(mode == 0)
    {
        base.rgb += layer.rgb * blend_alpha;

        base.a = max(base.a, layer.a * alpha);

        return base;
    }


    // 1 = Multiply
    if(mode == 1)
    {
        result = base.rgb * layer.rgb;

        base.rgb = mix(
            base.rgb,
            result,
            blend_alpha
        );

        base.a = max(base.a, layer.a * alpha);

        return base;
    }


    // 2 = Normal
    if(mode == 2)
    {
        base.rgb = mix(
            base.rgb,
            layer.rgb,
            blend_alpha
        );

        base.a = max(base.a, layer.a * alpha);

        return base;
    }


    // 3 = Screen
    if(mode == 3)
    {
        result = 1.0 -
            (1.0 - base.rgb) *
            (1.0 - layer.rgb);

        base.rgb = mix(
            base.rgb,
            result,
            blend_alpha
        );

        base.a = max(base.a, layer.a * alpha);

        return base;
    }


    // 4 = Lighten
    if(mode == 4)
    {
        result = max(
            base.rgb,
            layer.rgb
        );

        base.rgb = mix(
            base.rgb,
            result,
            blend_alpha
        );

        base.a = max(base.a, layer.a * alpha);

        return base;
    }


    // 5 = Darken
    if(mode == 5)
    {
        result = min(
            base.rgb,
            layer.rgb
        );

        base.rgb = mix(
            base.rgb,
            result,
            blend_alpha
        );

        base.a = max(base.a, layer.a * alpha);

        return base;
    }


    // 6 = Overlay
    if(mode == 6)
    {
        result = mix(
            2.0 * base.rgb * layer.rgb,
            1.0 -
                2.0 *
                (1.0 - base.rgb) *
                (1.0 - layer.rgb),
            step(
                vec3(0.5),
                base.rgb
            )
        );

        base.rgb = mix(
            base.rgb,
            result,
            blend_alpha
        );

        base.a = max(base.a, layer.a * alpha);

        return base;
    }


    // 7 = Difference
    if(mode == 7)
    {
        result = abs(
            base.rgb -
            layer.rgb
        );

        base.rgb = mix(
            base.rgb,
            result,
            blend_alpha
        );

        base.a = max(base.a, layer.a * alpha);

        return base;
    }


    // 8 = Subtract
    if(mode == 8)
    {
        result = max(
            base.rgb - layer.rgb,
            0.0
        );

        base.rgb = mix(
            base.rgb,
            result,
            blend_alpha
        );

        base.a = max(base.a, layer.a * alpha);

        return base;
    }


    return base;
}


// Edge-local multi-tap feathering of the input content's own alpha edges
// (transitions between solid and fully transparent pixels).
// Solid interiors keep the untouched center tap (fully sharp, no detail loss);
// only pixels whose 3x3 kernel straddles a solid<->transparent transition get
// blurred, feathering both inward and outward over +/- radius.
// Averaging is done in premultiplied space to avoid dark fringing.

vec4 sample_input_smooth(
	sampler2D input_texture,
	vec2 uv,
	vec2 radius
)
{
	if(radius.x <= 0.0 && radius.y <= 0.0)
		return texture(
			input_texture,
			clamp(uv, vec2(0.0), vec2(1.0))
		);

	// Center tap is preserved as the sharp fallback for solid interiors.
	vec4 center = texture(
		input_texture,
		clamp(uv, vec2(0.0), vec2(1.0))
	);

	vec3 rgb_sum = vec3(0.0);
	float a_sum = 0.0;
	float w_sum = 0.0;

	// Track the alpha extent of the kernel neighborhood to derive an edge metric.
	float a_min = 1.0;
	float a_max = 0.0;

	for(int ty = -1; ty <= 1; ty++)
	{
		for(int tx = -1; tx <= 1; tx++)
		{
			float wx = 1.0;
			float wy = 1.0;

			if(tx == 0) wx = 2.0;
			if(ty == 0) wy = 2.0;

			float wt = wx * wy;

			vec2 tap_uv = clamp(
				uv + vec2(
					float(tx) * radius.x,
					float(ty) * radius.y
				),
				vec2(0.0),
				vec2(1.0)
			);

			vec4 s = texture(input_texture, tap_uv);

			rgb_sum += s.rgb * s.a * wt;
			a_sum   += s.a * wt;
			w_sum   += wt;

			a_min = min(a_min, s.a);
			a_max = max(a_max, s.a);
		}
	}

	float blurred_a = a_sum / w_sum;

	vec3 blurred_rgb = vec3(0.0);

	if(a_sum > 0.00001)
		blurred_rgb = rgb_sum / a_sum;

	vec4 blurred = vec4(blurred_rgb, blurred_a);

	// Fully solid interiors and fully transparent regions have a small alpha
	// span (edge = 0) and stay untouched; only the transition band is blurred.
	float span = a_max - a_min;
	float edge = smoothstep(EDGE_ALPHA_SOLID, 1.0, span);

	return mix(center, blurred, edge);
}


// Process one projection mapping input.

vec4 apply_input(
	vec4 base,
	sampler2D input_texture,
	vec4 input_rect,
	float brightness,
	vec3 lamp_dim,
	float opacity,
	int blend_mode,
	vec2 world_pos,
	float feather
)
{
	// Ignore inactive / degenerate input rects.

	if(input_rect.z <= 0.0 || input_rect.w <= 0.0)
		return base;

	float f = max(feather, 0.0);

	// Extended bounds so feathered edge pixels are still processed.

	if(
		world_pos.x >= input_rect.x - f &&
		world_pos.x <= input_rect.x + input_rect.z + f &&
		world_pos.y >= input_rect.y - f &&
		world_pos.y <= input_rect.y + input_rect.w + f
	)
	{
		// Convert world position into texture UV.

		vec2 uv =
			(world_pos - input_rect.xy) /
			input_rect.zw;

		// Keep the original Y orientation.

		uv.y = 1.0 - uv.y;

		// Soft coverage mask for the projection rectangle border.

		float rect_cov = 1.0;

		if(f > 0.0)
		{
			rect_cov =
				smoothstep(-f, 0.0, world_pos.x - input_rect.x) *
				smoothstep(-f, 0.0, (input_rect.x + input_rect.z) - world_pos.x) *
				smoothstep(-f, 0.0, world_pos.y - input_rect.y) *
				smoothstep(-f, 0.0, (input_rect.y + input_rect.w) - world_pos.y);
		}

		if(rect_cov > 0.0)
		{
			// Feather radius converted from projection pixels into UV units.

			vec2 radius = vec2(0.0);

			if(f > 0.0)
				radius = f / input_rect.zw;

			// Sample texture (multi-tap to soften internal content edges).

			vec4 color =
				sample_input_smooth(
					input_texture,
					uv,
					radius
				);

			// Apply brightness only to RGB.

			color.rgb *= brightness * (vec3(1.0) - lamp_dim);

			// Blend with the accumulated output,
			// opacity modulated by the rect feather coverage.

			base = blend_colors(
				base,
				color,
				opacity * rect_cov,
				blend_mode
			);
		}
	}

	return base;
}


void main()
{
	// Calculate the world position
	// represented by this output pixel.

	vec2 world_pos =
		current_rect.xy +
		vec2(
			v_uv.x * current_rect.z,
			(1.0 - v_uv.y) * current_rect.w
		);


	vec4 final_color =
		vec4(0.0);


	// Input 1

	final_color = apply_input(
		final_color,
		in1,
		in1_rect,
		in1_brightness,
		in1_lamp_dim,
		in1_opacity,
		in1_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 2

	final_color = apply_input(
		final_color,
		in2,
		in2_rect,
		in2_brightness,
		in2_lamp_dim,
		in2_opacity,
		in2_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 3

	final_color = apply_input(
		final_color,
		in3,
		in3_rect,
		in3_brightness,
		in3_lamp_dim,
		in3_opacity,
		in3_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 4

	final_color = apply_input(
		final_color,
		in4,
		in4_rect,
		in4_brightness,
		in4_lamp_dim,
		in4_opacity,
		in4_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 5

	final_color = apply_input(
		final_color,
		in5,
		in5_rect,
		in5_brightness,
		in5_lamp_dim,
		in5_opacity,
		in5_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 6

	final_color = apply_input(
		final_color,
		in6,
		in6_rect,
		in6_brightness,
		in6_lamp_dim,
		in6_opacity,
		in6_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 7

	final_color = apply_input(
		final_color,
		in7,
		in7_rect,
		in7_brightness,
		in7_lamp_dim,
		in7_opacity,
		in7_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 8

	final_color = apply_input(
		final_color,
		in8,
		in8_rect,
		in8_brightness,
		in8_lamp_dim,
		in8_opacity,
		in8_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 9

	final_color = apply_input(
		final_color,
		in9,
		in9_rect,
		in9_brightness,
		in9_lamp_dim,
		in9_opacity,
		in9_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 10

	final_color = apply_input(
		final_color,
		in10,
		in10_rect,
		in10_brightness,
		in10_lamp_dim,
		in10_opacity,
		in10_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 11

	final_color = apply_input(
		final_color,
		in11,
		in11_rect,
		in11_brightness,
		in11_lamp_dim,
		in11_opacity,
		in11_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 12

	final_color = apply_input(
		final_color,
		in12,
		in12_rect,
		in12_brightness,
		in12_lamp_dim,
		in12_opacity,
		in12_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 13

	final_color = apply_input(
		final_color,
		in13,
		in13_rect,
		in13_brightness,
		in13_lamp_dim,
		in13_opacity,
		in13_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 14

	final_color = apply_input(
		final_color,
		in14,
		in14_rect,
		in14_brightness,
		in14_lamp_dim,
		in14_opacity,
		in14_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 15

	final_color = apply_input(
		final_color,
		in15,
		in15_rect,
		in15_brightness,
		in15_lamp_dim,
		in15_opacity,
		in15_blend_mode,
		world_pos,
		edge_feather
	);


	// Input 16

	final_color = apply_input(
		final_color,
		in16,
		in16_rect,
		in16_brightness,
		in16_lamp_dim,
		in16_opacity,
		in16_blend_mode,
		world_pos,
		edge_feather
	);


	fragColor = final_color;
}
)";

// =========================================================================
// Virtual fixtures: a slice follows a lamp of the fixture setup
// =========================================================================
//
//The Lamp of a slice (its settings) is a lamp of the fixture setup: usually a virtual one (assets/Fixtures/Virtual,
//no node, made by "Lamps for slices"), but any lamp works. Its colour times its dimmer, as Devices > Fixtures sends it
//(the Phaser, links, MIDI and the blackout move it), tints the slice in every output: white at full leaves the
//slice as it is, black hides it.

//1 - (colour x dimmer) of the lamp of a slice: the lamp_dim of the output shader. 0, 0, 0 (unchanged) without a lamp,
//for a lamp that is gone and while the fixture menu is not there
slice_lamp_dim(slice) {
	if(!slice || !slice.lamp || !maplab_engine || !maplab_engine.fixture_menu)
		return vec3f(0, 0, 0);
	f = patch_find(maplab_engine.patch, slice.lamp);
	if(!f)
		return vec3f(0, 0, 0);
	light = maplab_engine.fixture_menu.lamp_light(f);
	if(!light)
		return vec3f(0, 0, 0);
	//Strobe (#719, a projection zone): the slice flashes, 1 to 20 times a second
	k = light.dimmer;
	strobe = slice_lamp_value(f, "Strobe");
	if(!std.is_none(strobe) && strobe > 0.004) {
		rate = 1.0 + strobe * 19.0;
		phase = std.millis() * rate / 1000.0;
		if(phase - math.floor(phase) >= 0.5)
			k = 0.0;
	}
	return vec3f(1.0 - light.r * k, 1.0 - light.g * k, 1.0 - light.b * k);
}

//The value (0..1, as sent) of a control of a lamp by its label, None when its type has none
slice_lamp_value(f, label) {
	t = patch_type(f.type);
	i = patch_control_index(f.type, label);
	if(i < 0)
		return None;
	ctrls = maplab_engine.fixture_menu.lamp_controls(f.id);
	if(i >= ctrls.size())
		return None;
	return ctrls[i].value();
}

//Pan, Tilt, Zoom and Rotate of the lamp of a slice (#719, a projection zone) move the picture in the slice, on top of
//its own Transform: Pan (to the right) and Tilt (up) by up to a slice width / height either way (0.5 = where Transform
//puts it), Zoom from
//half to twice the size, Rotate half a turn either way. A slice whose lamp has none of them keeps its Transform
slice_lamp_motion(slice) {
	if(!slice || slice.is_eco || !slice.translate_x || !maplab_engine || !maplab_engine.fixture_menu)
		return;
	f = slice.lamp ? patch_find(maplab_engine.patch, slice.lamp) : None;
	pan = f ? slice_lamp_value(f, "Pan") : None;
	tilt = f ? slice_lamp_value(f, "Tilt") : None;
	zoom = f ? slice_lamp_value(f, "Zoom") : None;
	rot = f ? slice_lamp_value(f, "Rotate") : None;
	if(std.is_none(pan) && std.is_none(tilt) && std.is_none(zoom) && std.is_none(rot)) {
		if(slice.lamp_moved) {
			//the lamp is gone or has no motion: back to the Transform of the slice
			slice.lamp_moved = false;
			slice.shader.translate(vec2f(slice.translate_x.value(), slice.translate_y.value()));
			slice.shader.rotation(slice.rotate_ctrl.value());
			slice.shader.zoom(slice.zoom_ctrl.value());
		}
		return;
	}
	slice.lamp_moved = true;
	size = slice.shader.render_size();
	//(the translate of the shader moves where the picture is read from: the picture goes the other way. Pan up: to the
	//right, Tilt up: up)
	dx = std.is_none(pan) ? 0.0 : -(pan - 0.5) * 2.0 * size.x;
	dy = std.is_none(tilt) ? 0.0 : -(tilt - 0.5) * 2.0 * size.y;
	slice.shader.translate(vec2f(slice.translate_x.value() + dx, slice.translate_y.value() + dy));
	slice.shader.rotation(slice.rotate_ctrl.value() + (std.is_none(rot) ? 0.0 : (rot - 0.5) * 360.0));
	slice.shader.zoom(math.max(0.01, slice.zoom_ctrl.value()) * (std.is_none(zoom) ? 1.0 : math.pow(2.0, (zoom - 0.5) * 2.0)));
}

//Every slice of every input, in their order
all_slices() {
	list = [];
	for(i = 0; i < inputs.size(); i++) {
		for(j = 0; j < inputs[i].slices.size(); j++)
			list.push_back(inputs[i].slices[j]);
	}
	return list;
}

//The Lamp list of a slice: "No lamp", then "Lamp: <name>" for the lamps of the fixture setup (others than virtual ones
//with their type)
fill_lamp_combo(slice) {
	if(!slice.lamp_combo)
		return;
	items = ["No lamp"];
	ids = [""];
	sel = 0;
	if(maplab_engine) {
		p = maplab_engine.patch;
		for(i = 0; i < p.fixtures.size(); i++) {
			f = p.fixtures[i];
			items.push_back("Lamp: " + (patch_is_virtual(f) ? f.name : f.name + " (" + patch_type(f.type).name + ")"));
			ids.push_back(f.id);
			if(f.id == slice.lamp)
				sel = ids.size() - 1;
		}
	}
	if(slice.lamp && sel == 0) {
		items.push_back("Lamp: (deleted)");
		ids.push_back(slice.lamp);
		sel = ids.size() - 1;
	}
	slice.lamp_ids = ids;
	slice.lamp_combo.items(items).selected(sel);
}

//The Lamp lists follow the fixture setup (lamps added, renamed, removed)
refresh_lamp_combos() {
	if(!maplab_engine)
		return;
	lamp_combo_revision = maplab_engine.patch_revision;
	slices = all_slices();
	for(i = 0; i < slices.size(); i++)
		fill_lamp_combo(slices[i]);
}

//Where the slices hang on the stage plan (#719): the projection is a screen upstage (y -4 m, 3 m high) as wide as the
//lamps of the fixture setup (at least 1 m per slice), and each virtual lamp of a slice stands where the middle of the
//slice is across the outputs (left edge of the outputs: left end of the screen). So "Left to right" of a Phaser runs through lamps and slices together. order: [[index, x], ...] by x
place_slice_lamps(p, slices, order) {
	real = [];
	for(i = 0; i < p.fixtures.size(); i++) {
		if(!patch_is_virtual(p.fixtures[i]))
			real.push_back(p.fixtures[i]);
	}
	b = patch_bounds(real);
	n = order.size();
	width = math.max(n * 1.0, b ? b.max_x - b.min_x : 0.0);
	middle = b ? (b.min_x + b.max_x) / 2.0 : 0.0;
	//The width the slices are placed in: the outputs (where they are seen), else the slices themselves
	min_x = 0.0;
	max_x = 0.0;
	for(k = 0; k < outputs.size(); k++) {
		ox = outputs[k].shader.x();
		ow = outputs[k].shader.width();
		if(k == 0 || ox < min_x)
			min_x = ox;
		if(k == 0 || ox + ow > max_x)
			max_x = ox + ow;
	}
	if(!outputs.size()) {
		for(k = 0; k < n; k++) {
			cx = order[k].x;
			if(k == 0 || cx < min_x)
				min_x = cx;
			if(k == 0 || cx > max_x)
				max_x = cx;
		}
	}
	span = max_x - min_x;
	for(k = 0; k < n; k++) {
		slice = slices[order[k].index];
		f = slice.lamp ? patch_find(p, slice.lamp) : None;
		if(!f || !patch_is_virtual(f))
			continue;
		share = span > 0.0 ? math.clamp((order[k].x - min_x) / span, 0.0, 1.0) : (n > 1 ? k / (n - 1.0) : 0.5);
		f.x = math.round((middle + (share - 0.5) * width) * 100.0) / 100.0;
		f.y = -4.0;
		f.z = 3.0;
	}
}

//A virtual lamp (PATCH_VIRTUAL_TYPE) for every slice without a lamp, named after the slice, at full and white, and a
//group of all lamps of the slices in the order of the slices from left to right: a Phaser runs over it at once. On the
//stage plan the lamps stand upstage where the slices are (place_slice_lamps), again with every click. Returns how many
//lamps were made
make_slice_lamps() {
	if(!maplab_engine)
		return 0;
	p = maplab_engine.patch;
	slices = all_slices();
	//Left to right by where the slices are in the outputs
	order = [];
	for(i = 0; i < slices.size(); i++)
		order.push_back([index = i, x = slices[i].shader.x() + slices[i].shader.width() / 2.0]);
	order = patch_sort_by(order, "x");
	made = [];
	ids = [];
	n = order.size();
	for(k = 0; k < n; k++) {
		slice = slices[order[k].index];
		f = slice.lamp ? patch_find(p, slice.lamp) : None;
		if(!f) {
			added = patch_add(p, PATCH_VIRTUAL_TYPE, 1, "", 0, 0, k - (n - 1) / 2.0, -4.0);
			f = added[0];
			if(slice.slice_name)
				f.name = slice.slice_name;
			slice.lamp = f.id;
			made.push_back(f.id);
		}
		ids.push_back(f.id);
	}
	if(ids.size() == 0)
		return 0;
	place_slice_lamps(p, slices, order);
	//One group per MapLab (saved with it), the same one again when the button is clicked again
	g = slice_group ? patch_group(p, slice_group) : None;
	if(g)
		g.fixtures = ids;
	else
		slice_group = patch_group_add(p, "MapLab slices", ids).id;
	//The new lamps start at full and white (fixture_menu.build_lamp): the slices look as before until an effect moves them
	maplab_engine.patch_changed();
	refresh_lamp_combos();
	return made.size();
}

rect_overlap(pos1, size1, pos2, size2) {
    return pos1.x < pos2.x + size2.x &&
           pos1.x + size1.x > pos2.x &&
           pos1.y < pos2.y + size2.y &&
           pos1.y + size1.y > pos2.y;
}

link_shaders() {
	// ------------------------------------------------------------
	// First pass:
	// Reset the required render size for every slice.
	//
	// This is the resolution the slice actually needs to render at
	// based on the outputs it is currently visible on.
	// ------------------------------------------------------------
	for(i = 0; i < inputs.size(); i++) {
		//The size of the input mask these render sizes are made for: update_post links again when it changes
		mask_size = inputs[i].input_mask.output_size();
		inputs[i].linked_mask_size = [x = mask_size.x, y = mask_size.y];

		for(j = 0; j < inputs[i].slices.size(); j++) {
			slice = inputs[i].slices[j];

			if(!slice.is_eco)
				slice.required_render_size = vec2i(1, 1);
		}
	}


	// ------------------------------------------------------------
	// Second pass:
	// Link all slices to their overlapping outputs and determine
	// the maximum render resolution required for every slice.
	// ------------------------------------------------------------
	for(i = 0; i < outputs.size(); i++) {
		out = outputs[i];

		// Reset all inputs first
		for(j = 1; j <= max_num_inputs; j++) {
			out.shader.input("in" + j, None);
			out.shader.uniform(
				"in" + j + "_rect",
				vec4f(0, 0, 0, 0)
			);
			out.shader.uniform(
				"in" + j + "_brightness",
				1.0
			);
			out.shader.uniform(
				"in" + j + "_lamp_dim",
				vec3f(0, 0, 0)
			);
			out.shader.uniform(
				"in" + j + "_opacity",
				1.0
			);
			out.shader.uniform(
				"in" + j + "_blend_mode",
				0
			);
		}

		out.inputs = [];

		for(j = 0; j < inputs.size(); j++) {
			in = inputs[j];

			for(k = 0; k < in.slices.size(); k++) {
				slice = in.slices[k];

				if(rect_overlap(
					slice.shader.position(),
					slice.shader.fixed_size(),
					out.shader.position(),
					out.shader.fixed_size()
				)) {

					// ------------------------------------------------
					// Calculate how many physical output pixels the
					// slice occupies.
					//
					// The slice coordinates are in project/output
					// space, while the output shader may render at a
					// different physical resolution.
					//
					// Example:
					//   output fixed size = 1920x1080
					//   output render size = 3840x2160
					//
					// A 960x540 slice therefore needs 1920x1080
					// pixels when rendered for this output.
					// ------------------------------------------------
					if(!slice.is_eco) {
						output_fixed_size = out.shader.fixed_size();
						output_render_size = out.shader.render_size();

						scale_x = output_render_size.x / output_fixed_size.x;
						scale_y = output_render_size.y / output_fixed_size.y;

						slice_size = slice.shader.fixed_size();

						required_width = math.ceil(
							slice_size.x * scale_x
						);

						required_height = math.ceil(
							slice_size.y * scale_y
						);

						// ------------------------------------------------
						// Never request more pixels than the slice's
						// original/native render resolution.
						//
						// This is particularly important when an output
						// is rendered at a higher resolution than the
						// source input.
						// ------------------------------------------------
						current_render_size = in.input_mask.output_size();

						required_width = math.min(
							required_width,
							current_render_size.x
						);

						required_height = math.min(
							required_height,
							current_render_size.y
						);

						// ------------------------------------------------
						// Keep the maximum requirement across all outputs
						// this slice overlaps.
						// ------------------------------------------------
						slice.required_render_size = vec2i(
							math.max(
								slice.required_render_size.x,
								required_width
							),
							math.max(
								slice.required_render_size.y,
								required_height
							)
						);
					}


					shader_slice = slice.shader;

					out.inputs.push_back([
						shader = shader_slice,
						rect = vec4f(
							slice.shader.x(),
							slice.shader.y(),
							slice.shader.width(),
							slice.shader.height()
						),
						is_eco = slice.is_eco,
						opacity_ctrl = slice.opacity_ctrl,
						bright_ctrl = slice.bright_ctrl,
						blendmode_ctrl = slice.blendmode_ctrl,
						slice = slice,
					]);
				}
			}
		}

		out.shader.uniform(
			"current_rect",
			vec4f(
				out.shader.x(),
				out.shader.y(),
				out.shader.width(),
				out.shader.height()
			)
		);
	}


	// ------------------------------------------------------------
	// Third pass:
	// Apply the calculated render resolutions.
	//
	// Doing this after processing ALL outputs is important because
	// the same slice can be used by multiple outputs.
	// ------------------------------------------------------------
	for(i = 0; i < inputs.size(); i++) {
		for(j = 0; j < inputs[i].slices.size(); j++) {
			slice = inputs[i].slices[j];
			if(!slice.is_eco) {
				//std.print("Set Rendersize: ", slice.required_render_size);
				//Technically, we could also set the input_mask (if available)
				//To that resolution since its kinda useless to render at full input
				//resolution ?
				//But in input mask we have to keep aspect ratio from the input which makes this more
				//complicated
				slice.shader.render_size(
					slice.required_render_size
				);
			}
		}
	}
}

//The effects of an output (#428): the mapped picture goes into the first one, the last one is what goes out (OUT, the
//display, Spout and NDI). Without effects that is the output shader itself
route_output(out) {
	final = out.shader;
	items = out.fx_stack.items;
	if(items.size() > 0) {
		//A shader in a stack renders once it is active (in the Clipview its cell does that). It loads after it was
		//added: made active once it has loaded
		for(i = 0; i < items.size(); i++) {
			if(!out.fx_live.has(items[i].guid) && items[i].is_loaded()) {
				items[i].dispatch("active", true);
				out.fx_live[items[i].guid] = 1;
			}
		}

		first_in = items[0].dispatch("get_default_input");
		if(first_in && first_in.value() != out.shader)
			first_in.value(out.shader);
		//The last effect with a picture: one without an output is left out, it does not end the chain
		for(i = items.size() - 1; i >= 0; i--) {
			last_out = items[i].dispatch("get_default_output");
			if(last_out && last_out.value()) {
				final = last_out.value();
				break;
			}
		}
	}
	else if(final == out.final_shader)
		return; //no effects, nothing changed

	if(final != out.final_shader) {
		old = out.final_shader;
		old.spout_enabled(false);
		old.ndi_enabled(false);
		out.final_shader = final;
		if(out.spout_enable.value()) {
			final.spout_sender_name(out.spout_name.value());
			final.spout_enabled(true);
		}
		if(out.ndi_enable.value()) {
			final.ndi_source_name(out.ndi_name.value());
			final.ndi_enabled(true);
		}
	}

	if(out.output_ctrl.value() != final)
		out.output_ctrl.value(final);
	if(out.monitor_shader && out.monitor_input != final) {
		out.monitor_shader.input("in_texture", final);
		out.monitor_input = final;
	}
	if(out.preview && out.preview_input != final) {
		out.preview.shader(final);
		out.preview_input = final;
	}
}

//The preview of an output (#272) is as wide as the output column and has the aspect of the output, within limits
output_preview_resize(out) {
	if(!out.preview)
		return;
	w = math.max(1, out.width_ctrl.value());
	h = math.max(1, out.height_ctrl.value());
	out.preview.fixed_height(math.clamp((side_width - 8) * h / w, 40, 160));
	output_area.refresh_layout();
}

//The effects of one output in the upper half of MapLab, as an input mask shows there (only one of them at a time)
show_effects(out, v) {
	if(v) {
		if(active_input_mask_btn) {
			cb = active_input_mask_btn.on_change();
			cb(false);
		}
		for(i = 0; i < outputs.size(); i++) {
			if(outputs[i].fx_btn != out.fx_btn && outputs[i].fx_btn.pushed()) {
				outputs[i].fx_btn.pushed(false);
				outputs[i].fx_panel.visible(false);
			}
		}
		active_fx_btn = out.fx_btn;
		active_fx_panel = out.fx_panel;
		out.fx_panel.visible(true);
		projection_window.anchor_top(0.5, "percent");
		out.fx_panel.anchor_bottom(0.5, "percent");
	}
	else {
		out.fx_panel.visible(false);
		if(active_fx_btn == out.fx_btn) {
			active_fx_btn = None;
			active_fx_panel = None;
			projection_window.anchor_top(0);
		}
	}
	out.fx_btn.pushed(v);
	projection_window.refresh_layout();
}

//Closes the effects that show, before an input mask takes the upper half
hide_effects() {
	for(i = 0; i < outputs.size(); i++) {
		if(outputs[i].fx_btn == active_fx_btn) {
			show_effects(outputs[i], false);
			return;
		}
	}
}

free_effects(out) {
	items = out.fx_stack.items;
	for(i = 0; i < items.size(); i++) {
		try {
			std.free(items[i]);
		}
		catch(e) {}
	}
	items.clear();
}

add_slice(current_input, slice_name = "", slice_guid = "", is_eco = false) {
	
	if(!slice_guid)
		slice_guid = std.random_hash(8);
	
	slice_area = current_input.slice_area.widget().layout(nanogui.layout_vertical());
	
	splitter = slice_area.widget().layout(nanogui.layout_horizontal()).fixed_height(35);
	select_slice_btn = splitter.pushbutton("").expander(true).tooltip("Open or close the settings of this slice").anchor_left(0).fixed_width(25).transparent(true);
	name = splitter.textbox(slice_name ? slice_name : ("Slice #" + (current_input.slices.size()+1))).anchor(0).anchor_right(25).anchor_left(25);
	delete_btn = splitter.button("").icon(nanogui.icon("times")).tooltip("Remove this slice").anchor_right(0).fixed_width(25).transparent(true);
	
	shader_slice = None;
	projection_enable_btn = None;
	set_projection_grid_cb = None;
	translate_x = None;
	translate_y = None;
	rotate = None;
	zoom = None;
	
	ctrl_area = slice_area.widget().layout(nanogui.layout_vertical()).section_guide(true).visible(false);
	
	opacity_ctrl = ctrl_area.controlslider("Opacity", slice_guid).tooltip("How much of the slice shows, 0 to 1").value(1.0).fixed_height(25);
	bright_ctrl = ctrl_area.controlslider("Brightness", slice_guid).tooltip("Makes the slice darker or brighter").value(1.0).fixed_height(25);
	blendmode_ctrl = ctrl_area.controlcombo("Blendmode", slice_guid).tooltip("How the slice mixes with what is below it in the output").items(["Add", "Multiply", "Normal", "Screen", "Lighten", "Darken", "Overlay", "Difference", "Subtract"]).fixed_height(25);
	lamp_combo = ctrl_area.combobox().fixed_height(25)
		.tooltip("A lamp of the [[fixture setup]] that tints this slice: its colour times its dimmer, as Devices > Fixtures sends it (the Phaser, links, MIDI). Usually a virtual lamp (Lamps for slices), any lamp works\n[[wiki:Output-and-Devices#virtual-fixtures]]");
	
	input_mask_btn = ctrl_area.pushbutton("Slice Input Mask").tooltip("Shows the mask of this slice in the upper half: the part of the input it cuts out\n[[wiki:Output-and-Devices#mapping]]").fixed_height(25);
	
	if(!is_eco) {
		shader_slice = projection_area.shader().fixed_size(vec2f(current_input.width_ctrl.value(),current_input.height_ctrl.value())).render_size(vec2i(current_input.width_ctrl.value(),current_input.height_ctrl.value()));
		shader_slice.fragment_source(shader_src);
		shader_slice.input("u_input", current_input.input_mask);
		shader_slice.drawing_enabled(false);
		
		projection_enable_btn = ctrl_area.pushbutton("Edit Grid").tooltip("Shows a grid over the slice: drag its points to fit it onto a surface\n[[wiki:Output-and-Devices#mapping]]").fixed_height(25);
		projection_subdivide = ctrl_area.button("Subdivide").tooltip("A finer grid").fixed_height(25);
		
		transform_vec = ctrl_area.controlvector("Transform", slice_guid).tooltip("Moves, turns, zooms and mirrors the slice").transparent(true).content().layout(nanogui.layout_vertical());
		
		translate_x = transform_vec.controlfloat("X", slice_guid).fixed_height(25);
		translate_y = transform_vec.controlfloat("Y", slice_guid).fixed_height(25);
		rotate = transform_vec.controlslider("Rotate", slice_guid).min(0).max(360).fixed_height(25);
		zoom = transform_vec.controlslider("Zoom", slice_guid).value(1.0).fixed_height(25);
		clip_uv = transform_vec.controlbutton("Clip UV", slice_guid).tooltip("Cuts the slice off where a move, a turn or the zoom pushes it out of its frame").push(1).fixed_height(25);
		flip_x = transform_vec.controlbutton("Flip X", slice_guid).push(1).fixed_height(25);
		flip_y = transform_vec.controlbutton("Flip Y", slice_guid).push(1).fixed_height(25);

		translate_x.callback([translate_x, translate_y, shader_slice](v) {
			shader_slice.translate(vec2f(translate_x.value(), translate_y.value()));
		});
		
		translate_y.callback(translate_x.callback());
		
		rotate.callback([rotate, shader_slice](v) {
			shader_slice.rotation(v);
		});
		
		zoom.callback([zoom, shader_slice](v) {
			shader_slice.zoom(v);
		});
		
		clip_uv.callback([shader_slice](v){
			shader_slice.clip_uv(v);	
		});
		
		flip_x.callback([shader_slice](v){
			shader_slice.flip_uv_x(v);	
		});
		
		flip_y.callback([shader_slice](v){
			shader_slice.flip_uv_y(v);	
		});
		
		projection_grid_vec = ctrl_area.controlvector("Grid", slice_guid).tooltip("How many fields the grid has across and down").expanded(false).transparent(true);	
		projection_grid_x = projection_grid_vec.controlint("X", slice_guid).value(1).fixed_height(25);
		projection_grid_y = projection_grid_vec.controlint("Y", slice_guid).value(1).fixed_height(25);
		
		projection_grid_fine_vec = ctrl_area.controlvector("Fine", slice_guid).tooltip("How finely each field is divided").expanded(false).transparent(true);	
		projection_grid_fine_x = projection_grid_fine_vec.controlint("X", slice_guid).value(8).fixed_height(25);
		projection_grid_fine_y = projection_grid_fine_vec.controlint("Y", slice_guid).value(8).fixed_height(25);
		
		projection_reset = ctrl_area.button("Reset").tooltip("Back to the plain grid").fixed_height(25);
		
		projection_subdivide.on_click([projection_grid_x, projection_grid_y, shader_slice]() {
			if(!shader_slice.projection_enabled()) //Only set when its actually activated once, "lazy" set
				return;
			
			shader_slice.projection_subdivide();
			projection_grid_x.value(projection_grid_x.value() * 2, false, false);
			projection_grid_y.value(projection_grid_y.value() * 2, false, false);
		});
		
		projection_reset.on_click([projection_grid_x, projection_grid_y, shader_slice]() {
			shader_slice.projection_reset();
		});
		
		set_projection_grid_cb = [projection_grid_x, projection_grid_y, projection_grid_fine_x, projection_grid_fine_y, shader_slice](v) {
			if(!shader_slice.projection_enabled()) //Only set when its actually activated once, "lazy" set
				return;
			
			shader_slice.projection_grid(vec2i(projection_grid_x.value(), projection_grid_y.value()));
			shader_slice.projection_fine(vec2i(projection_grid_fine_x.value(), projection_grid_fine_y.value()));
		};
		
		projection_grid_x.callback(set_projection_grid_cb);
		projection_grid_y.callback(set_projection_grid_cb);
		projection_grid_fine_x.callback(set_projection_grid_cb);
		projection_grid_fine_y.callback(set_projection_grid_cb);
		
		shader_slice.projection_enabled(false);
	}
	else {
		shader_slice = projection_area.shader_view().fixed_size(vec2f(current_input.width_ctrl.value(),current_input.height_ctrl.value()));
		shader_slice.shader(current_input.input_mask);
		shader_slice.drawing_enabled(false);
		
		input_mask_btn.visible(false); //Idk why this doesnt work, debug later there is something wrong with how shaderview is handled ?
	}
	
	shader_slice.keep_aspect_ratio(false);
	
	//A new slice starts a little below and right of the previous one, not exactly on top of it
	//(a loaded project restores the saved positions afterwards)
	shader_slice.position(vec2f(24, 24) * (current_input.slices.size() % 10));

	current_input.slices.push_back([
		area = slice_area,
		ctrl_area = ctrl_area,
		btn = select_slice_btn,
		input_mask_btn = input_mask_btn,
		delete_btn = delete_btn,
		shader = shader_slice,
		slice_name = name.value(),
		slice_guid = slice_guid,
		is_eco = is_eco,
		projection_enable_btn=projection_enable_btn,
		opacity_ctrl = opacity_ctrl,
		bright_ctrl = bright_ctrl,
		blendmode_ctrl = blendmode_ctrl,
		input_mask = None,
		input = current_input,   //the input this slice belongs to (#573)
		lamp = "",               //id of the lamp of the fixture setup that tints it, "" for none
		translate_x = translate_x, //its Transform (None for an eco slice): the lamp moves the picture on top of it (#719)
		translate_y = translate_y,
		rotate_ctrl = rotate,
		zoom_ctrl = zoom,
		lamp_moved = false,
		lamp_combo = lamp_combo,
		lamp_ids = [],           //the lamp ids of the items of lamp_combo
	]);
	
	current_slice = current_input.slices[-1];
	fill_lamp_combo(current_slice);
	lamp_combo.on_change([current_slice](index, text) {
		current_slice.lamp = current_slice.lamp_ids[index] ?? "";
	});
	
	name.on_change([current_slice](v){
		current_slice.slice_name = v;
	});
	
	delete_btn.on_click([current_input, current_slice](){
		std.free(current_slice.area);
		std.free(current_slice.shader);
		std.free(current_slice.input_mask);
		current_input.slices.erase(current_slice);
		link_shaders();
	});
	
	input_mask_btn.on_change([input_mask_btn, current_slice, current_input, shader_slice](v){
		if(v)
			if(active_input_mask_btn)
				old_cb = active_input_mask_btn.on_change();
				old_cb(false);
			hide_effects(); //the upper half shows one thing at a time
			active_input_mask = current_slice.input_mask;
			active_input_mask_btn = input_mask_btn;
			if(!current_slice.input_mask)
				current_slice.input_mask = main_area.warp_mapper().anchor_top(0).anchor_bottom(0.5,"percent").anchor_left(side_width).anchor_right(side_width);
				current_slice.input_mask.rendering_enabled(true);
			current_slice.input_mask.input(current_input.input_mask);
			if(current_slice.is_eco)
				shader_slice.shader(current_slice.input_mask);
			else
				shader_slice.input("u_input", current_slice.input_mask);
			current_slice.input_mask.visible(true);
			projection_window.anchor_top(0.5, "percent");
			current_slice.input_mask.anchor_top(0).anchor_bottom(0.5,"percent");
		else
			if(current_slice.input_mask)
				current_slice.input_mask.visible(false);
			projection_window.anchor_top(0);
			active_input_mask = None;
			active_input_mask_btn = None;
		input_mask_btn.pushed(v);
		projection_window.refresh_layout();
	});
	
	shader_slice.on_mouse_button([shader_slice, current_input, current_slice, projection_enable_btn](pos, btn, down, mod) {

		if(btn != 0)
			return false;
		
		if(!down && !shader_slice.focused())
			return false;
		
		if(down && mod == 2) {
			add_slice(current_input, "", "", current_slice.is_eco);
			
			new_slice = current_input.slices[-1];
			
			new_slice.shader.x(shader_slice.x());
			new_slice.shader.y(shader_slice.y());
			new_slice.shader.fixed_width(shader_slice.fixed_width());
			new_slice.shader.fixed_height(shader_slice.fixed_height());
			new_slice.shader.size(new_slice.shader.fixed_size());
			
			if(!current_slice.is_eco)
				new_slice.shader.projection_load(shader_slice.projection_save());
			
			if(current_slice.input_mask)
				cb = new_slice.input_mask_btn.on_change(); //Causes input mask to be allocated...
				cb(true);
				cb(false);
				new_slice.input_mask.deserialize(current_slice.input_mask.serialize());
			
			cb = new_slice.shader.on_mouse_button();
			return cb(pos, btn, down, 0);
		}
		
		current_input.drag_corner = 0;

		//Disabled when working on an output
		if(selected_output.btn || btn != 0)
			return shader_slice.parent().parent().mouse_button_default(pos, btn, down, mod); //scrollarea content widget -> scrollarea
			
		if(selected_slice.btn && selected_slice.shader == shader_slice && projection_enable_btn && projection_enable_btn.pushed()) {	
			shader_slice.mouse_button_default(pos, btn, down, mod);
			return true;
		}

		current_input.btn.pushed(true);
		select_cb = current_input.btn.on_change();
		select_cb(true);
		current_slice.btn.pushed(true);
		select_cb = current_slice.btn.on_change();
		select_cb(true);
			
		if(down) {
		
			position = shader_slice.position();
			size = shader_slice.fixed_size();

			local_pos = pos;

			border = 35;

			left   = local_pos.x < border;
			right  = local_pos.x > size.x - border;
			top    = local_pos.y < border;
			bottom = local_pos.y > size.y - border;

			// Current aspect ratio
			aspect = size.x / size.y;

			// Store the aspect ratio for the resize operation
			current_input.drag_aspect = aspect;

			if(left && top) {
				// Top-left: bottom-right remains fixed
				current_input.drag_corner = 1;
			}
			else if(right && top) {
				// Top-right: bottom-left remains fixed
				current_input.drag_corner = 2;
			}
			else if(left && bottom) {
				// Bottom-left: top-right remains fixed
				current_input.drag_corner = 3;
			}
			else if(right && bottom) {
				// Bottom-right: top-left remains fixed
				current_input.drag_corner = 4;
			}
		}
		else {
			gs = grid_size_ctrl.value();
			
			if(gs > 0.0 && enable_grid_btn.value())
			{	
				pos = shader_slice.position();
				pos.x = math.round(pos.x / gs);
				pos.y = math.round(pos.y / gs);
				shader_slice.position(pos * gs);
				
				size = shader_slice.size();
				size.x = math.round(size.x / gs);
				size.y = math.round(size.y / gs);
				shader_slice.size(size * gs);
				
				size = shader_slice.fixed_size();
				size.x = math.round(size.x / gs);
				size.y = math.round(size.y / gs);
				shader_slice.fixed_size(size * gs);
				link_shaders();
			}
		}

		return selected_slice.btn && selected_slice.shader == shader_slice;
	});
	
	shader_slice.on_mouse_drag([shader_slice, current_input, current_slice](pos, rel, btn, mod) {
		
		//Disabled when working on an output
		if(selected_output.btn || btn != 1) //Confusing, mouse_button is the button index (0 for LMB), drag works with "mousestate" flag (1 for LMB in this case)
			return shader_slice.parent().parent().mouse_drag_default(pos, rel, btn, mod); //scrollarea content widget -> scrollarea
	
		if(!current_slice.is_eco && shader_slice.projection_enabled())
			shader_slice.mouse_drag_default(pos, rel, btn, mod);
			return true;
		
		position = shader_slice.position();
		fixed_size = shader_slice.fixed_size();

		// Mouse position relative to the slice
		local_pos = pos - position;

		if(current_input.drag_corner == 1) {
			if(mod == 1) {
				// Shift: preserve aspect ratio
				new_height = fixed_size.y - rel.y;
				new_width = new_height * current_input.drag_aspect;

				shader_slice.position(
					position + vec2f(
						fixed_size.x - new_width,
						rel.y
					)
				);

				shader_slice.fixed_size(
					vec2f(new_width, new_height)
				);
			}
			else {
				shader_slice.position(shader_slice.position() + rel); 
				shader_slice.fixed_size(shader_slice.fixed_size() - rel);
			}
		}
		else if(current_input.drag_corner == 2) {
			if(mod == 1) {
				// Shift: preserve aspect ratio
				new_height = fixed_size.y - rel.y;
				new_width = new_height * current_input.drag_aspect;

				shader_slice.position(
					position + vec2f(
						0,
						rel.y
					)
				);

				shader_slice.fixed_size(
					vec2f(new_width, new_height)
				);
			}
			else {
				rel_y = vec2f(0, rel.y);
				rel_x = vec2f(rel.x, -rel.y);
				shader_slice.position(shader_slice.position() + rel_y); 
				shader_slice.fixed_size(shader_slice.fixed_size() + rel_x);
			}
		}
		else if(current_input.drag_corner == 3) {
			if(mod == 1) {
				// Shift: preserve aspect ratio
				new_width = fixed_size.x + rel.x;
				new_height = new_width / current_input.drag_aspect;

				shader_slice.position(
					position + vec2f(
						rel.x,
						0
					)
				);

				shader_slice.fixed_size(
					vec2f(new_width, new_height)
				);
			}
			else {
				rel_y = vec2f(rel.x, 0);
				rel_x = vec2f(-rel.x, rel.y);
				shader_slice.position(shader_slice.position() + rel_y); 
				shader_slice.fixed_size(shader_slice.fixed_size() + rel_x); 
			}
		}
		else if(current_input.drag_corner == 4) {
			if(mod == 1) {
				// Shift: preserve aspect ratio
				new_width = fixed_size.x + rel.x;
				new_height = new_width / current_input.drag_aspect;

				shader_slice.fixed_size(
					vec2f(new_width, new_height)
				);
			}
			else {
				shader_slice.fixed_size(shader_slice.fixed_size() + rel);
			}
		}
		else {
			shader_slice.position(shader_slice.position() + rel); 
		}
	
		shader_slice.size(shader_slice.fixed_size());
	
		link_shaders();
	
		return current_input.drag_corner != 0;
	});
	
	shader_slice.on_draw([current_slice, shader_slice](){
			
		size = shader_slice.size();
		header_height = 28;
		radius = 5;

		selected = selected_slice.btn && selected_slice.shader == shader_slice;

		// Full slice border
		nvgBeginPath();
		nvgRect(
			vec2f(1, 1),
			vec2f(size.x - 2, size.y - 2)
		);

		nvgStrokeColor(
			selected
				? vec4f(0.15, 0.85, 1.0, 1.0)
				: vec4f(0.10, 0.45, 0.65, 0.9)
		);

		nvgStrokeWidth(selected ? 3 : 2);
		nvgStroke();

		// Name
		nvgFontSize(14);
		nvgFillColor(vec4f(1, 1, 1, 1));
		nvgTextAlign(1 | 16);

		//Name on a dark chip, so names of slices lying on top of each other stay readable
		name_w = nvgTextBounds(vec2f(0, 0), current_slice.slice_name)[0];
		nvgBeginPath();
		nvgRoundedRect(vec2f(5, header_height * 0.5 - 10), vec2f(name_w + 10, 20), 4);
		nvgFillColor(vec4f(0.06, 0.07, 0.08, 1));
		nvgFill();
		nvgFillColor(vec4f(1, 1, 1, 1));

		nvgText(
			vec2f(10, header_height * 0.5),
			current_slice.slice_name
		);

		// Resize handles
		if(!selected) {
			handle = 7;

			nvgFillColor(vec4f(0.35, 0.85, 1.0, 1.0));

			nvgBeginPath();
			nvgRect(vec2f(0, 0), vec2f(handle, handle));
			nvgFill();

			nvgBeginPath();
			nvgRect(
				vec2f(size.x - handle, 0),
				vec2f(handle, handle)
			);
			nvgFill();

			nvgBeginPath();
			nvgRect(
				vec2f(0, size.y - handle),
				vec2f(handle, handle)
			);
			nvgFill();

			nvgBeginPath();
			nvgRect(
				vec2f(size.x - handle, size.y - handle),
				vec2f(handle, handle)
			);
			nvgFill();
		}
	});
	
	select_slice_btn.on_change([select_slice_btn, current_slice](v){
		
		if(selected_output.btn && v)
			selected_output.btn.pushed(false);
			selected_output.slice_area.visible(false);
			selected_output = None;
		
		if(selected_slice.btn && (selected_slice.btn == current_slice.btn || v))
			selected_slice.btn.pushed(false);
			selected_slice.ctrl_area.visible(false);
			selected_slice = None;
		
		if(v)
			selected_slice = current_slice;
			selected_slice.btn.pushed(true);
			selected_slice.ctrl_area.visible(true);
			selected_slice.shader.focus(false);
			selected_slice.shader.focus(true);
			
		input_area.refresh_layout();
	});
	
	if(projection_enable_btn) {
		projection_enable_btn.on_change([current_slice, set_projection_grid_cb](v){
			selected_slice.shader.projection_enabled(v);
			selected_slice.shader.focus(false);
			if(v && set_projection_grid_cb)
				set_projection_grid_cb(0); //Only set these if projection mapping is actually needed...
			if(v)
				selected_slice.shader.focus(true);
		});
	}
	
	input_area.refresh_layout();
	
	//Do both because this is kinda buggy
	if(!is_eco) //Find out why eco slices are blackscreen on first add..
		link_shaders_lazy = true;
	link_shaders();
	
	return current_input.slices[-1];
}

add_input(input_name = "", input_guid = "") {
	
	if(!input_guid)
		input_guid = std.random_hash(8);
	
	new_area = input_area.widget().layout(nanogui.layout_vertical());
	
	splitter = new_area.widget().layout(nanogui.layout_horizontal()).fixed_height(35);
	btn = splitter.pushbutton("").expander(true).tooltip("Open or close the settings of this input").anchor_left(0).fixed_width(25).transparent(true);
	name = splitter.textbox(input_name ? input_name : ("Input #" + (inputs.size()+1))).anchor(0).anchor_right(25).anchor_left(25);
	delete_btn = splitter.button("").icon(nanogui.icon("times")).tooltip("Remove this input and its slices").anchor_right(0).fixed_width(25).transparent(true);
	
	slice_area = new_area.widget().layout(nanogui.layout_vertical()).section_guide(true).visible(false);

	engine = std.global("engine");

	input_width = slice_area.controlint("Width", input_guid).tooltip("The width the input is used in, in pixels").value(engine.project_width.value()).fixed_height(25);
	input_height = slice_area.controlint("Height", input_guid).tooltip("The height the input is used in, in pixels").value(engine.project_height.value()).fixed_height(25);

	select_video_router = slice_area.combobox().items(["Select Input"]).tooltip("The picture of this input: everything a [[video router]] offers (shaders, videos, receivers)\n[[wiki:Output-and-Devices#mapping]]").fixed_height(25);

	input_mask_btn = slice_area.pushbutton("Input Mask").tooltip("Shows the mask of the whole input in the upper half\n[[wiki:Output-and-Devices#mapping]]").fixed_height(25);
	

	input_ctrl = control_inputs_area.control("IN", input_guid).tooltip("The port of this input: [[link]] a picture into it\n[[wiki:Output-and-Devices#mapping]]").caption("In").fixed_width(52);

	input_mask = main_area.warp_mapper().anchor_top(0).anchor_bottom(0.5,"percent").anchor_left(side_width).anchor_right(side_width);
	input_mask.rendering_enabled(true).visible(false);

	select_video_router.on_open([select_video_router](){
		routers = get_video_routers();
		items = ["Select Input"];
		for(i = 0; i < routers.size(); i++) {
			items.push_back(routers[i].name);
		}
		select_video_router.items(items);
	});
	
	select_video_router.on_change([select_video_router, input_ctrl](index, text){
		routers = get_video_routers();
		index--;
		if(index < 0 || index >= routers.size())
			input_ctrl.clear_incoming_links();
			input_ctrl.value(None);
		else 
			routers[index].output_ctrl.link_to(input_ctrl);
			input_ctrl.value(routers[index].output_ctrl.value());
			
	});

	inputs.push_back([
		area = new_area,
		btn = btn,
		slice_area = slice_area,
		slices = [],
		input_ctrl = input_ctrl,
		input_guid = input_guid,
		input_name = input_name,
		
		width_ctrl = input_width,
		height_ctrl = input_height,
		
		select_video_router = select_video_router,
		
		input_mask = input_mask,
		linked_mask_size = None,
	]);
	
	current_input = inputs[-1];
	
	name.on_change([current_input](v){
		current_input.input_name = v;
	});
	
	delete_btn.on_click([current_input](){
		
		for(current_input.slices.size()) {
			cb = current_input.slices[0].delete_btn.on_click();
			cb();
		}
		
		std.free(current_input.area);
		std.free(current_input.input_ctrl);
		std.free(current_input.input_mask);
		
		inputs.erase(current_input);
		
		link_shaders();
	});
	
	input_mask_btn.on_change([input_mask_btn, input_mask](v){
		if(v)
			if(active_input_mask_btn)
				old_cb = active_input_mask_btn.on_change();
				old_cb(false);
			hide_effects(); //the upper half shows one thing at a time
			active_input_mask = input_mask;
			active_input_mask_btn = input_mask_btn;
			input_mask.visible(true);
			projection_window.anchor_top(0.5, "percent");
			input_mask.anchor_bottom(0.5, "percent");
		else
			input_mask.visible(false);
			projection_window.anchor_top(0);
			active_input_mask = None;
			active_input_mask_btn = None;
		input_mask_btn.pushed(v);
		projection_window.refresh_layout();
	});
	
	input_ctrl.callback([input_mask](v){
		input_mask.input(v);
	});
	
	input_width.callback([current_input](v){
		for(i = 0; i < current_input.slices.size(); i++) {
			if(!current_input.slices[i].is_eco)
				current_input.slices[i].shader.render_size(vec2i(current_input.width_ctrl.value(), current_input.height_ctrl.value()));
		}
	});
	input_height.callback([current_input](v){
		for(i = 0; i < current_input.slices.size(); i++) {
			if(!current_input.slices[i].is_eco)
				current_input.slices[i].shader.render_size(vec2i(current_input.width_ctrl.value(), current_input.height_ctrl.value()));
		}
	});
	
	
	
	btn.on_change([btn, slice_area, current_input](v){
		slice_area.visible(v);
		input_area.refresh_layout();
	});
	
	input_area.refresh_layout();
	
	link_shaders();
}

add_output(output_name, output_guid = "") {
	
	if(!output_guid)
		output_guid = std.random_hash(8);
	
	new_area = output_area.widget().layout(nanogui.layout_vertical());
	
	splitter = new_area.widget().layout(nanogui.layout_horizontal()).fixed_height(30);
	btn = splitter.pushbutton("").expander(true).tooltip("Open or close the settings of this output").anchor_left(0).fixed_width(25).transparent(true);
	name = splitter.textbox(output_name ? output_name : ("Output #" + (outputs.size()+1))).anchor(0).anchor_right(25).anchor_left(25);	
	delete_btn = splitter.button("").icon(nanogui.icon("times")).tooltip("Remove this output").anchor_right(0).fixed_width(25).transparent(true);

	//What goes out of this output (#272): shows the picture the output renders anyway (the end of its effects),
	//it renders nothing of its own. Display only, it is not routed anywhere and not saved
	preview = new_area.shader_view().fixed_height(110)
		.tooltip("What goes out of this output. Click to select the output.");
	
	engine = std.global("engine");
	
	slice_area = new_area.widget().layout(nanogui.layout_vertical()).section_guide(true).visible(false);
	output_width = slice_area.controlint("Width", output_guid).tooltip("The width of the output, in pixels\n[[wiki:Output-and-Devices#the-outputs-of-maplab]]").value(engine.project_width.value());
	output_height = slice_area.controlint("Height", output_guid).tooltip("The height of the output, in pixels\n[[wiki:Output-and-Devices#the-outputs-of-maplab]]").value(engine.project_height.value());
	//The resolution of the display this output is shown on, or of the first output display (Settings > Display, #601)
	display_size_btn = slice_area.button("Size of the display").fixed_height(25)
		.tooltip("Sets Width and Height to the resolution of the display this output is shown on, or of the first output display (Settings > Display).\n[[wiki:Output-and-Devices#the-outputs-of-maplab]]");
	
	edge_smooth = slice_area.controlslider("Edge Smooth", output_guid).tooltip("Softens the edges of the slices in this output, 0 to 4\n[[wiki:Output-and-Devices#the-outputs-of-maplab]]").max(4);

	videorouter_vec = slice_area.controlvector("VideoRouter", output_guid).tooltip("Offers the output by name in every input list: shaders, LEDMapper, MapLab ([[video router]])\n[[wiki:Output-and-Devices#the-outputs-of-maplab]]").expanded(false).transparent(true);
	videorouter_enable = videorouter_vec.controlbutton("Enable Router").push(1);	

	//The output straight to a display, as Spout or as NDI (#428), as a shader generator has it in its Outputs
	monitor_vec = slice_area.controlvector("Monitor", output_guid).caption("Display").expanded(false).transparent(true);
	monitor_type = monitor_vec.controlcombo("monitor_type", output_guid).caption("Display mode").items(["Fullscreen", "Window"]).segmented(true)
		.tooltip("Fullscreen: the display shows only this output. Window: a window of its own on that display.");
	//The name of the chosen display, kept with the project: at another venue the output goes to the display with that
	//name or stays off, never onto another display (#601, display_output_pick)
	monitor_name = monitor_vec.controltext("monitor_name", output_guid).caption("Display name").hide_config_menu();
	monitor_name.value("");
	monitor_name.visible(false);
	monitor_select = monitor_vec.controlcombo("monitor_select", output_guid).caption("Display")
		.tooltip("The display this output is shown on. Off: none.\n[[wiki:Output-and-Devices#the-outputs-of-maplab]]");
	monitor_fit = monitor_vec.controlcombo("monitor_fit", output_guid).caption("Picture").items(DISPLAY_FIT_ITEMS).segmented(true)
		.tooltip(DISPLAY_FIT_TOOLTIP + "\n[[wiki:Output-and-Devices#the-outputs-of-maplab]]");
	//Each display with its name, resolution and role (Settings > Display, #593)
	monitor_select.on_open([monitor_select](){
		monitor_select.items(display_output_items());
	});
	mon_cb = monitor_select.on_open();
	mon_cb();

	// Spout on Windows, Syphon on macOS (#264): the same controls and IDs, only the captions differ
	share = std.os_platform().lowercase().starts("mac") ? "Syphon" : "Spout";
	spout_vec = slice_area.controlvector("SPOUT", output_guid).caption(share).expanded(false).transparent(true);
	spout_enable = spout_vec.controlbutton("Enable SPOUT", output_guid).caption("Enable " + share).push(1).tooltip("Sends this output to other programs on this computer (Spout on Windows, Syphon on macOS)");
	spout_name = spout_vec.controltext("SpoutName", output_guid).caption(share + " name").hide_config_menu();

	ndi_vec = slice_area.controlvector("NDI Stream", output_guid).caption("NDI stream").expanded(false).transparent(true);
	ndi_enable = ndi_vec.controlbutton("Enable NDI", output_guid).caption("Enable NDI").push(1).tooltip("Sends this output as an NDI source");
	ndi_name = ndi_vec.controltext("NDI Name", output_guid).caption("NDI name").hide_config_menu();

	//Effects of the output (#428): a stack of shaders after the mapping, as in a clip of the Clipview. They show in the
	//upper half of MapLab, like an input mask; drop shaders from the Assets tab onto their list
	fx_btn = slice_area.pushbutton("Effects").fixed_height(25)
		.tooltip("Shaders that work on the whole output, after the mapping. Drop shaders from the Assets tab onto the list that opens.");
	fx_panel = main_area.widget().anchor_top(0).anchor_bottom(0.5, "percent").anchor_left(side_width).anchor_right(side_width).visible(false);
	//LED mapping of the output (#428): a LEDMapper in its effects gets this output as its picture and passes it on
	led_btn = slice_area.button("LED mapping").fixed_height(25)
		.tooltip("Adds a LEDMapper to the effects of this output: it maps the LEDs from this output and passes the picture on.");
	fx_hint = fx_panel.label("Drop shaders from the Assets tab onto the list on the left. The first one gets the mapped output, the last one is what goes out.")
		.anchor_left(260).anchor_right(10).anchor_top(10).fixed_height(40).text_color(vec4f(0.608, 0.608, 0.627, 1.0));
	fx_stack = stackview(fx_panel);

	engine = std.global("engine");
	
	shader_slice = projection_area.shader()
		.fixed_size(vec2f(engine.project_width.value(),engine.project_height.value()))
		.render_size(vec2i(engine.project_width.value(),engine.project_height.value()));
	shader_slice.fragment_source(out_shader_src);
	
	edge_smooth.callback([shader_slice](v){
		shader_slice.uniform("edge_feather", v);
	});
	
	output_ctrl = control_outputs_area.control("OUT", output_guid).tooltip("The picture of this output: [[link]] it onward\n[[wiki:Output-and-Devices#the-outputs-of-maplab]]").caption("Out").fixed_width(52).as_output(true);
	
	outputs.push_back([
		area = new_area,
		slice_area = slice_area,
		btn = btn,
		delete_btn = delete_btn,
		shader = shader_slice,
		output_ctrl = output_ctrl,
		output_guid = output_guid,
		output_name = name.value(),
		
		width_ctrl = output_width,
		height_ctrl = output_height,

		fx_btn = fx_btn,
		fx_panel = fx_panel,
		fx_stack = fx_stack,
		final_shader = shader_slice, //the shader at the end of the effects: what goes out
		spout_enable = spout_enable,
		spout_name = spout_name,
		ndi_enable = ndi_enable,
		ndi_name = ndi_name,
		monitor_shader = None,
		monitor_input = None,
		preview = preview,
		preview_input = shader_slice,
		fx_live = [], //guids of the effects that were made active
	]);
	
	current_output = outputs[-1];

	preview.shader(shader_slice);
	output_preview_resize(current_output);
	//A click on the preview selects the output, like the arrow button of its name row
	preview.on_mouse_button([current_output](pos, btn, down, mod) {
		if(!down || btn != 0)
			return false;
		v = !current_output.btn.pushed();
		current_output.btn.pushed(v);
		cb = current_output.btn.on_change();
		cb(v);
		return true;
	});

	fx_stack.on_items_changed = [current_output, fx_hint](stack){
		fx_hint.visible(stack.items.size() == 0);
		route_output(current_output);
	};

	fx_btn.on_change([current_output](v){
		show_effects(current_output, v);
	});

	led_btn.on_click([current_output](){
		current_output.fx_stack.add_generator("assets/Mapping/LEDMapper.asset");
		show_effects(current_output, true);
	});
	
	name.on_change([current_output](v){
		current_output.output_name = v;
		if(current_output.video_router)
			current_output.video_router.name = v;
	});
	
	spout_name.value(current_output.output_name);
	ndi_name.value(current_output.output_name);

	//Spout and NDI send the end of the effects (route_output moves them when the effects change)
	spout_enable.callback([current_output, spout_name](v){
		current_output.final_shader.spout_sender_name(spout_name.value());
		current_output.final_shader.spout_enabled(v);
	});
	spout_name.callback([current_output](v){
		current_output.final_shader.spout_sender_name(v);
	});
	ndi_enable.callback([current_output, ndi_name](v){
		current_output.final_shader.ndi_source_name(ndi_name.value());
		current_output.final_shader.ndi_enabled(v);
	});
	ndi_name.callback([current_output](v){
		current_output.final_shader.ndi_source_name(v);
	});

	current_output.monitor_index = 0;
	monitor_select.callback([current_output, shader_slice, monitor_type, monitor_select, monitor_name, monitor_fit](index){
		if(index == current_output.monitor_index)
			return;

		//The display by its name (display_output_pick): it may be at another place now, or not connected
		if(index > 0) {
			found = display_output_pick(index, monitor_name.value());
			if(found != index) {
				monitor_select.value(found, false); //no second round through this callback
				index = found;
			}
		}
		current_output.monitor_index = index;

		if(current_output.monitor_screen) {
			std.free(current_output.monitor_screen);
			current_output.monitor_screen = None;
			current_output.monitor_shader = None;
		}
		if(index <= 0)
			return;

		ctx = nanogui.current_context();
		info = ctx.monitor_info(index - 1);
		if(info && info.name)
			monitor_name.value(info.name);
		screen = ctx.fullscreen(index - 1, "maplab_output", !monitor_type.value());
		screen.decorated(0);
		screen.shadow(0); //no grey edge around the output on macOS
		screen.should_close([current_output, monitor_select](){
			monitor_select.value(0);
		});

		//The output as it is rendered, on the display as Picture says (Stretch, Fit, Fill)
		current_output.monitor_shader = display_output_copy(screen, current_output.final_shader, monitor_fit.value());
		current_output.monitor_input = current_output.final_shader;
		current_output.monitor_screen = screen;
	});
	monitor_fit.callback([current_output](v){
		if(current_output.monitor_shader)
			current_output.monitor_shader.uniform("shz_fit", std.int(v));
	});
	display_size_btn.on_click([current_output, output_width, output_height](){
		displays = std.global("engine").displays;
		if(!displays)
			return;
		size = current_output.monitor_index > 0 ? displays.resolution(current_output.monitor_index - 1) : displays.output_size();
		if(!size) {
			std.warn("MapLab: no output display (Settings > Display), the size stays");
			return;
		}
		output_width.value(size[0]);
		output_height.value(size[1]);
	});
	//The display mode applies at once: the display is opened again in the new mode
	monitor_type.callback([current_output, monitor_select](v){
		index = current_output.monitor_index;
		if(index <= 0)
			return;
		current_output.monitor_index = -1;
		cb = monitor_select.callback();
		cb(index);
	});

	videorouter_enable.callback([current_output](v){
		if(v)
			if(!current_output.video_router)
				current_output.video_router = VideoRouter(current_output.output_name, current_output.output_ctrl);
		else
			std.free(current_output.video_router);
			current_output.video_router = None;
	});
	
	delete_btn.on_click([current_output](){
		if(current_output.monitor_screen) {
			std.free(current_output.monitor_screen);
			current_output.monitor_screen = None;
		}
		if(active_fx_btn == current_output.fx_btn)
			show_effects(current_output, false);
		free_effects(current_output);
		std.free(current_output.fx_panel);
		std.free(current_output.area);
		std.free(current_output.shader);
		std.free(current_output.output_ctrl);
		outputs.erase(current_output);		
		link_shaders();
	});
	
	output_width.callback([current_output, shader_slice](v){
		shader_slice.render_size(vec2i(current_output.width_ctrl.value(), current_output.height_ctrl.value()));
		shader_slice.fixed_size(vec2f(current_output.width_ctrl.value(), current_output.height_ctrl.value()));
		shader_slice.size(vec2f(current_output.width_ctrl.value(), current_output.height_ctrl.value()));
		output_preview_resize(current_output);
	});
	output_height.callback([current_output, shader_slice](v){
		shader_slice.render_size(vec2i(current_output.width_ctrl.value(), current_output.height_ctrl.value()));
		shader_slice.fixed_size(vec2f(current_output.width_ctrl.value(), current_output.height_ctrl.value()));
		shader_slice.size(vec2f(current_output.width_ctrl.value(), current_output.height_ctrl.value()));
		output_preview_resize(current_output);
	});
	
	shader_slice.on_mouse_button([shader_slice, current_output](pos, btn, down, mod) {
			
		if(!current_output.btn.pushed() || btn == 1)
			if(btn == 1)
				return shader_slice.parent().parent().mouse_button_default(pos, btn, down, mod); //scrollarea content widget -> scrollarea
			else
				return false;
			
		if(down) {
			
			current_output.dragging = true;
			current_output.drag_corner = -1;
			
			position = shader_slice.position();
			size = shader_slice.size();

			local_pos = pos;

			border = 25;

			left   = local_pos.x < border;
			right  = local_pos.x > size.x - border;
			top    = local_pos.y < border;
			bottom = local_pos.y > size.y - border;

			// Current aspect ratio
			aspect = size.x / size.y;

			if(left && top) {
				// Top-left: bottom-right remains fixed
				current_output.drag_corner = 1;
			}
			else if(right && top) {
				// Top-right: bottom-left remains fixed
				current_output.drag_corner = 2;
			}
			else if(left && bottom) {
				// Bottom-left: top-right remains fixed
				current_output.drag_corner = 3;
			}
			else if(right && bottom) {
				// Bottom-right: top-left remains fixed
				current_output.drag_corner = 4;
			}
			
			return true;
		}
		else {
			current_output.dragging = false;
			
			gs = grid_size_ctrl.value();
			
			if(gs > 0.0 && enable_grid_btn.value())
			{	
				pos = shader_slice.position();
				pos.x = math.round(pos.x / gs);
				pos.y = math.round(pos.y / gs);
				shader_slice.position(pos * gs);
				
				//Align to grid but keep aspect (based on width)
				size = shader_slice.size();
				aspect = size.y / math.max(1,size.x);
				size.x = math.round(size.x / gs);
				size.y = size.x * aspect;
				shader_slice.size(size * gs);
				
				size = shader_slice.fixed_size();
				aspect = size.y / math.max(1,size.x);
				size.x = math.round(size.x / gs);
				size.y = size.x * aspect;
				shader_slice.fixed_size(size * gs);
				link_shaders();
			}
		
		}
		
		return current_output.btn.pushed();
	});
	shader_slice.on_mouse_drag([shader_slice, current_output](pos, rel, btn, mod) {		
		
		if(!current_output.btn.pushed() || btn == 2)
			if(btn == 2)
				return shader_slice.parent().parent().mouse_drag_default(pos, rel, btn, mod); //scrollarea content widget -> scrollarea
			else
				return false;
		
		if(!current_output.dragging)
			return false;

		position = shader_slice.position();
		size = shader_slice.fixed_size();

		// Mouse position relative to the slice
		local_pos = pos - position;

		border = 25;

		left   = local_pos.x < border;
		right  = local_pos.x > size.x - border;
		top    = local_pos.y < border;
		bottom = local_pos.y > size.y - border;

		// Current aspect ratio
		aspect = size.x / size.y;

		if(current_output.drag_corner == 1) {
			// Top-left: bottom-right remains fixed
			anchor = position + size;

			new_width = size.x - rel.x;
			new_height = new_width / aspect;

			new_size = vec2f(new_width, new_height);

			shader_slice.fixed_size(new_size);
			shader_slice.position(anchor - new_size);
		}
		else if(current_output.drag_corner == 2) {
			// Top-right: bottom-left remains fixed
			anchor = vec2f(
				position.x,
				position.y + size.y
			);

			new_width = size.x + rel.x;
			new_height = new_width / aspect;

			new_size = vec2f(new_width, new_height);

			shader_slice.fixed_size(new_size);
			shader_slice.position(
				vec2f(
					anchor.x,
					anchor.y - new_size.y
				)
			);
		}
		else if(current_output.drag_corner == 3) {
			// Bottom-left: top-right remains fixed
			anchor = vec2f(
				position.x + size.x,
				position.y
			);

			new_width = size.x - rel.x;
			new_height = new_width / aspect;

			new_size = vec2f(new_width, new_height);

			shader_slice.fixed_size(new_size);
			shader_slice.position(
				vec2f(
					anchor.x - new_size.x,
					anchor.y
				)
			);
		}
		else if(current_output.drag_corner == 4) {
			// Bottom-right: top-left remains fixed
			new_width = size.x + rel.x;
			new_height = new_width / aspect;

			shader_slice.fixed_size(
				vec2f(new_width, new_height)
			);
		}
		else {
			// Move
			shader_slice.position(position + rel);
		}
		
		shader_slice.size(shader_slice.fixed_size());
		
		if(shader_slice.x() < 0)
			shader_slice.x(0);
		if(shader_slice.y() < 0)
			shader_slice.y(0);
		
		link_shaders();
		
		return true;
	});
	
	shader_slice.on_draw([current_output, shader_slice](){
	
		size = shader_slice.size();
		header_height = 28;
		radius = 5;

		selected = selected_output.shader == shader_slice;

		// ------------------------------------------------------------
		// Output grid
		// ------------------------------------------------------------

		grid_size = grid_size_ctrl.value();

		nvgStrokeWidth(1);
		nvgStrokeColor(vec4f(1.0, 1.0, 1.0, 0.08));

		for(x = grid_size; x < size.x; x += grid_size) {
			nvgBeginPath();
			nvgMoveTo(vec2f(x, 0));
			nvgLineTo(vec2f(x, size.y));
			nvgStroke();
		}

		for(y = grid_size; y < size.y; y += grid_size) {
			nvgBeginPath();
			nvgMoveTo(vec2f(0, y));
			nvgLineTo(vec2f(size.x, y));
			nvgStroke();
		}

		// ------------------------------------------------------------
		// Full output border
		// ------------------------------------------------------------

		nvgBeginPath();
		nvgRect(
			vec2f(1, 1),
			vec2f(size.x - 2, size.y - 2)
		);

		nvgStrokeColor(
			selected
				? vec4f(0.80, 0.35, 1.0, 1.0)
				: vec4f(0.45, 0.18, 0.65, 0.9)
		);

		nvgStrokeWidth(selected ? 3 : 2);
		nvgStroke();

		// ------------------------------------------------------------
		// Name
		// ------------------------------------------------------------

		nvgFontSize(14);
		nvgFillColor(vec4f(1, 1, 1, 1));
		nvgTextAlign(1 | 16);

		//Name on a dark chip, so names of slices lying on top of each other stay readable
		name_w = nvgTextBounds(vec2f(0, 0), current_output.output_name)[0];
		nvgBeginPath();
		nvgRoundedRect(vec2f(5, header_height * 0.5 - 10), vec2f(name_w + 10, 20), 4);
		nvgFillColor(vec4f(0.06, 0.07, 0.08, 1));
		nvgFill();
		nvgFillColor(vec4f(1, 1, 1, 1));

		nvgText(
			vec2f(10, header_height * 0.5),
			current_output.output_name
		);

		// ------------------------------------------------------------
		// Resize handles
		// ------------------------------------------------------------

		if(selected) {
			handle = 7;

			nvgFillColor(vec4f(0.90, 0.60, 1.0, 1.0));

			nvgBeginPath();
			nvgRect(vec2f(0, 0), vec2f(handle, handle));
			nvgFill();

			nvgBeginPath();
			nvgRect(
				vec2f(size.x - handle, 0),
				vec2f(handle, handle)
			);
			nvgFill();

			nvgBeginPath();
			nvgRect(
				vec2f(0, size.y - handle),
				vec2f(handle, handle)
			);
			nvgFill();

			nvgBeginPath();
			nvgRect(
				vec2f(size.x - handle, size.y - handle),
				vec2f(handle, handle)
			);
			nvgFill();
		}
	});

	//Render first max_num_inputs inputs directly
	shader_slice.before_render([current_output, shader_slice](){
		for(i = 0; i < math.min(max_num_inputs, current_output.inputs.size()); i++) {
			cin = current_output.inputs[i];
			slice_shader = cin.shader;
			if(cin.is_eco) //Shaderview instead of shader
				slice_shader = slice_shader.shader();
			shader_slice.input(
				"in" + (i+1),
				slice_shader
			);
			shader_slice.uniform(
				"in" + (i+1) + "_rect",
				cin.rect
			);
			shader_slice.uniform(
				"in" + (i+1) + "_brightness",
				cin.bright_ctrl.value()
			);
			shader_slice.uniform(
				"in" + (i+1) + "_lamp_dim",
				slice_lamp_dim(cin.slice)
			);
			shader_slice.uniform(
				"in" + (i+1) + "_opacity",
				cin.opacity_ctrl.value()
			);
			shader_slice.uniform(
				"in" + (i+1) + "_blend_mode",
				cin.blendmode_ctrl.value()
			);
		}
	});
	
	//If more than max_num_inputs inputs, draw the rest by rendering chunks of max_num_inputs again
	shader_slice.after_render([current_output, shader_slice]() {
		
		if(current_output.inputs.size() <= max_num_inputs)
			return;
		
		remaining_passes = ((current_output.inputs.size()-max_num_inputs) / max_num_inputs) + 1;
		
		for(pass = 0; pass < remaining_passes; pass++) {
			for(i = 0; i < max_num_inputs; i++) {
				current_index = max_num_inputs + pass * max_num_inputs + i;
				
				if(current_index >= current_output.inputs.size()) {
					shader_slice.uniform("in" + (i+1) + "_rect", vec4f(0, 0, 0, 0));
					continue;
				}
				
				cin = current_output.inputs[current_index];
				slice_shader = cin.shader;
				if(cin.is_eco) //Shaderview instead of shader
					slice_shader = slice_shader.shader();
				
				shader_slice.input(
					"in" + (i+1),
					slice_shader
				);
				shader_slice.uniform(
					"in" + (i+1) + "_rect",
					cin.rect
				);
				shader_slice.uniform(
					"in" + (i+1) + "_brightness",
					cin.bright_ctrl.value()
				);
				shader_slice.uniform(
					"in" + (i+1) + "_lamp_dim",
					slice_lamp_dim(cin.slice)
				);
				shader_slice.uniform(
					"in" + (i+1) + "_opacity",
					cin.opacity_ctrl.value()
				);
				shader_slice.uniform(
					"in" + (i+1) + "_blend_mode",
					cin.blendmode_ctrl.value()
				);
			}
			
			shader_slice.render(false);
		}
		
	});

	btn.on_change([current_output, shader_slice](v){		
		if(selected_slice.btn && v)
			selected_slice.btn.pushed(false);
			selected_slice.shader.projection_enabled(false);
			selected_slice.ctrl_area.visible(false);
			selected_slice = None;
		
		if(selected_output.btn)
			selected_output.btn.pushed(false);
			selected_output.slice_area.visible(false);
			selected_output = None;
		
		if(v) {
			selected_output = current_output;
			selected_output.btn.pushed(true);
			selected_output.slice_area.visible(true);
			shader_slice.focus(false);
			shader_slice.focus(true);
		}
	});
	
	output_ctrl.value(shader_slice);
	output_ctrl.callback([output_ctrl, current_output](v){
		output_ctrl.value(current_output.final_shader);
	});
	
	output_area.refresh_layout();
	
	link_shaders();
	
	return current_output;
}

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return None;
		for(i = 0; i < outputs.size(); i++) {
			outputs[i].shader.rendering_enabled(value);
			outputs[i].fx_stack.dispatch("active", value);
		}
		for(i = 0; i < inputs.size(); i++) {
			inputs[i].input_mask.rendering_enabled(value);
			for(j = 0; j < inputs[i].slices.size(); j++) {
				if(!inputs[i].slices[j].is_eco)
					inputs[i].slices[j].shader.rendering_enabled(value);
				if(inputs[i].slices[j].input_mask)
					inputs[i].slices[j].input_mask.rendering_enabled(value);
			}
		}
	}
	
	if(cmd == "get_default_input" && inputs)
		return inputs[0].input_ctrl;
	
	if(cmd == "get_default_output" && outputs)
		return outputs[0].output_ctrl;
	
	return None;
}

//The input the top Slice buttons use (#573): the selected one, the one of the selected slice, the one an
//output works on; with a single input that one; with none of these: None (the caller makes an input first)
selected_input() {
	if(selected_slice && selected_slice.btn && selected_slice.input)
		return selected_slice.input;
	if(selected_output && selected_output.btn)
		return None; //an output is open: a slice of an input would be a guess
	for(i = 0; i < inputs.size(); i++) {
		if(inputs[i].btn.pushed())
			return inputs[i];
	}
	if(inputs.size() == 1)
		return inputs[0];
	return None;
}

//"Add Slice" / "Add Eco Slice" of the top row (#573)
add_slice_to_current(is_eco) {
	input = selected_input();
	if(!input) {
		if(inputs.size() > 0)
			std.warn("MapLab: open an input (its arrow button) to say which one the slice goes into, the slice went into the last input.");
		add_input();
		input = inputs[-1];
	}
	add_slice(input, "", "", is_eco);
}

entry(generator, area) {
	
	maplab_engine = generator.engine;
	generator.window.fixed_size(vec2f(1200,800));
	
	area.layout(None);
	
	main_area = area;

	projection_window = area.window(" ").movable(false).movable_y(true).clamp_move(false).anchor_left(side_width).anchor_right(side_width).anchor_top(0).anchor_bottom(30);
	projection_area = projection_window.scrollarea().anchor(0).content().fixed_size(vec2f(10000,10000));
	
	//Dragging the projection window up or down resizes what shows in the upper half: an input mask or the effects of
	//an output (#520)
	projection_window.on_move([projection_window](pos, old_pos) {
		
		upper = active_input_mask ? active_input_mask : active_fx_panel;
		if(!upper)
			projection_window.anchor_top(0);
			projection_window.y(0);
			return;
		
		delta_y = math.max(60, pos.y);
		delta_y = math.min(delta_y, projection_window.parent().height() - 64);
		projection_window.anchor_top(delta_y);
		
		upper.anchor_bottom(projection_window.parent().height() - delta_y);
		
		projection_window.parent().refresh_layout();
	});

	top_menu = projection_window.button_panel().layout(nanogui.layout_horizontal());

	enable_grid_btn = top_menu.controlbutton("ENABLE GRID", "area_settings").tooltip("Slices snap to the grid when they are moved or resized").caption("Enable grid").push(1).value(1);
	grid_size_ctrl = top_menu.controlint("Grid Size", "area_settings").tooltip("The size of the snap grid, in pixels").value(64);
	lamps_btn = top_menu.button("Lamps for slices")
		.tooltip("A [[virtual fixture|virtual lamp]] in the [[fixture setup]] for every slice without a lamp, and a group of them from left to right, placed on the stage where the slices are: effects for lamps (the Phaser, palettes, cues) then play on the slices, and Pan, Tilt, Zoom, Rotate and Strobe of the lamps move them\n[[wiki:Output-and-Devices#virtual-fixtures]]");
	lamps_btn.on_click([]() {
		made = make_slice_lamps();
		std.print("MapLab: " + made + " virtual lamps made");
	});
	
	//The buttons that add things, together at the top of the input side (#573), not inside every input.
	//"Add Slice" and "Add Eco Slice" take the selected input: the open one, the one of the selected
	//slice, the one an output works on; with a single input that one; with none, Add Input makes one
	//The widths follow the captions, a size smaller than the theme: all three fit in side_width ("Add Eco Slice" was cut off)
	add_slice_row = area.widget().anchor_top(0).anchor_left(0).fixed_width(side_width).fixed_height(30).layout(nanogui.layout_horizontal());
	add_input_btn = add_slice_row.button("Add Input").tooltip("A new input: a picture to cut slices from\n[[wiki:Output-and-Devices#mapping]]").anchor_left(0).fixed_width(64).fixed_height(30).font_size(14);
	add_slice_btn = add_slice_row.button("Add Slice").tooltip("A new slice of the selected input: a part of it, placed and warped on its own\n[[wiki:Output-and-Devices#mapping]]").anchor_left(64).fixed_width(56).fixed_height(30).font_size(14);
	add_eco_slice_btn = add_slice_row.button("Add Eco Slice").tooltip("A slice without a shader of its own: cheaper, but without the grid and the transform\n[[wiki:Output-and-Devices#mapping]]").anchor_left(120).fixed_width(80).fixed_height(30).font_size(14);
		
	add_output_btn = area.button("Add Output").tooltip("A new output: a picture made of the slices, sent to a display, Spout, NDI or a video router\n[[wiki:Output-and-Devices#the-outputs-of-maplab]]").anchor_top(0).anchor_right(0).fixed_width(side_width).fixed_height(30);
	
	input_area = area.vscroll().anchor_left(0).anchor_top(32).anchor_bottom(30).fixed_width(side_width).content().layout(nanogui.layout_vertical());
	output_area = area.vscroll().anchor_right(0).anchor_top(32).anchor_bottom(30).fixed_width(side_width).content().layout(nanogui.layout_vertical());
	
	control_inputs_area = area.widget().anchor_left(0).anchor_bottom(0).fixed_height(30).anchor_right(0.5, "percent").layout(nanogui.layout_horizontal());
	control_outputs_area = area.widget().anchor_right(0).anchor_bottom(0).fixed_height(30).anchor_left(0.5, "percent").layout(nanogui.layout_horizontal());
	
	add_input_btn.on_click([input_area](){
		add_input();
	});
	add_slice_btn.on_click([this](){
		add_slice_to_current(false);
	});
	add_eco_slice_btn.on_click([this](){
		add_slice_to_current(true);
	});
	
	add_output_btn.on_click([input_area](){
		add_output();
	});
}

update_post(generator) {
	//The Lamp lists of the slices follow the fixture setup
	if(maplab_engine && maplab_engine.patch_revision != lamp_combo_revision)
		refresh_lamp_combos();

	//Pan, Tilt, Zoom and Rotate of the lamps of the slices
	for(i = 0; i < inputs.size(); i++) {
		for(j = 0; j < inputs[i].slices.size(); j++)
			slice_lamp_motion(inputs[i].slices[j]);
	}

	//An input mask takes its size from its input when it renders, a frame after the input was set: the slices were
	//still limited to the size before (blurry until a slice was moved, #428). Link again once the size changed
	if(!link_shaders_lazy) {
		for(i = 0; i < inputs.size(); i++) {
			linked = inputs[i].linked_mask_size;
			size = inputs[i].input_mask.output_size();
			if(!linked || linked.x != size.x || linked.y != size.y) {
				link_shaders_lazy = true;
				break;
			}
		}
	}

	//A shader added to the effects of an output gets its input and output when it has loaded: route again until it has
	for(i = 0; i < outputs.size(); i++) {
		if(outputs[i].fx_stack.items.size() > 0)
			route_output(outputs[i]);
	}

	if(link_shaders_lazy) {
		try {
			link_shaders();
		}
		catch(e) {}
		link_shaders_lazy = false;
	}
}

save_state() {
	saved_inputs = [];
	saved_outputs = [];
	
	for(i = 0; i < inputs.size(); i++) {
		
		slices = [];
		
		for(j = 0; j < inputs[i].slices.size(); j++) {
			slice = inputs[i].slices[j].shader;
			
			slices.push_back([
				x = slice.x(),
				y = slice.y(),
				w = slice.fixed_width(),
				h = slice.fixed_height(),
				slice_name = inputs[i].slices[j].slice_name,
				slice_guid = inputs[i].slices[j].slice_guid,
				is_eco = inputs[i].slices[j].is_eco,
			]);
			if(inputs[i].slices[j].lamp)
				slices[-1].lamp = inputs[i].slices[j].lamp;
			
			if(!inputs[i].slices[j].is_eco)
				slices[-1].shader_state = slice.projection_save();
			
			if(inputs[i].slices[j].input_mask)
				slices[-1].input_mask_state = inputs[i].slices[j].input_mask.serialize();
		}
		
		saved_inputs.push_back([
			input_name = inputs[i].input_name,
			input_guid = inputs[i].input_guid,
			selected_router = inputs[i].select_video_router.selected_text(),
			slices = slices,
			input_mask_state = inputs[i].input_mask.serialize(),
		]);
	}
	
	for(i = 0; i < outputs.size(); i++) {
		output = outputs[i];
		shader = output.shader;
		
		saved_outputs.push_back([
			output_name = output.output_name,
			output_guid = output.output_guid,
			x = shader.x(),
			y = shader.y(),
			w = shader.fixed_width(),
			h = shader.fixed_height(),
			shader_state = shader.projection_save(),
			effects = output.fx_stack.save_state(),
		]);
	}
	
	return [
		inputs = saved_inputs,
		outputs = saved_outputs,
		slice_group = slice_group,
	];
}

load_state(state) {
	
	slice_group = state.slice_group ?? "";
	inputs = [];
	outputs = [];
	
	for(i = 0; i < state.inputs.size(); i++) {
		
		add_input(state.inputs[i].input_name, state.inputs[i].input_guid);
		
		inputs[-1].select_video_router.items([state.inputs[i].selected_router]);
		
		if(state.inputs[i].input_mask_state ?? false) {
			inputs[-1].input_mask.deserialize(state.inputs[i].input_mask_state);
		}
		
		for(j = 0; j < state.inputs[i].slices.size(); j++) {
			state_slice = state.inputs[i].slices[j];
			
			slice_meta = add_slice(inputs[-1], state_slice.slice_name, state_slice.slice_guid, state_slice.is_eco);
			slice_meta.lamp = state_slice.lamp ?? "";
			fill_lamp_combo(slice_meta);
			slice = slice_meta.shader;
			
			slice.x(state_slice.x);
			slice.y(state_slice.y);
			slice.fixed_width(state_slice.w);
			slice.fixed_height(state_slice.h);
			slice.size(slice.fixed_size());
			
			if(!state_slice.is_eco)
				slice.projection_load(state_slice.shader_state);
			
			if(state_slice.input_mask_state ?? false)
				cb = slice_meta.input_mask_btn.on_change(); //Causes input mask to be allocated...
				cb(true);
				cb(false);
				slice_meta.input_mask.deserialize(state_slice.input_mask_state);
		}
	}
	
	if(state.outputs) {
		for(i = 0; i < state.outputs.size(); i++) {
			
			state_output = state.outputs[i];
			output = add_output(state_output.output_name, state_output.output_guid);
			shader = output.shader;
			
			shader.x(state_output.x);
			shader.y(state_output.y);
			shader.fixed_width(state_output.w);
			shader.fixed_height(state_output.h);
			shader.size(shader.fixed_size());
			
			shader.projection_load(state_output.shader_state);

			if(state_output.effects ?? false) {
				if(state_output.effects.size() > 0)
					output.fx_stack.load_state(state_output.effects);
			}
		}
	}
	
	link_shaders();
}