//LEDMapper (#439): LED strips, bars and matrices drawn over a picture; their colours go to Art-Net nodes or to lamps of the
//fixture setup.
//
//  +--------------------+----------------------------------------------------+----------------------+
//  | Input, size, LEDs  | toolbar: Select Line Curve Transform | Snap Grid | | Scene / group /      |
//  | Layout (outliner): |          Test Addresses Channels                   | segment settings     |
//  |  scene             | LED strip (what is sent)                           | (inspector)          |
//  |   group            | canvas: the picture with the segments              |                      |
//  |    segment         | channels: the universe of the selection (drag)     |                      |
//  | Library (presets)  | masters of the scenes                    status    |                      |
//  +--------------------+----------------------------------------------------+----------------------+
//
//- A segment is one strip with its own number of LEDs (no fixture per strip as in other software): a line or a curve,
//  with rows for a matrix. A group is what one node gets (or a lamp of the fixture setup), its segments one after the
//  other. A scene is a set of groups with a master.
//- Positions, addresses and what is sent are worked out in engine/patch/ledmap.shio (tested in _testing/ledmap.shio).
//- Presets of scenes, groups and segments are in the Library on the left (and can still be dragged in from the Assets
//  tab): click one to insert it where the selection is. A preset is a scene, group or segment by its "type", else by
//  the folder it is in (scenes, groups, segments; ledmap_preset_kind).
//- Channels (#655): the 512 channels of the universe of the selection (engine/patch/channelmap.shio). Drag a segment
//  to other channels: the first segment of a group moves the group, another one gets its own address. Lamps of the
//  fixture setup on that universe are there too and can be moved the same way (their address in the patch).
//- Test lights the selected segment, group or scene white and everything else black: to find a strip in the rig.
//- What it sends goes into the DMX registry of the engine (engine/patch/dmx.shio): segments that write the channels of a
//  lamp of the fixture setup (one they are not meant for) or of another LEDMapper are red, like overlapping segments here.

import nanogui;

using eigen;
using nanogui;

#include "engine/interfaces/videorouter"
#include "engine/patch/patch"
#include "engine/patch/ledmap"
#include "engine/patch/dmx"
#include "engine/patch/palette"
#include "engine/patch/channelmap"
#include "engine/stage/stage"
#include "engine/stage/stage_leds"
#include "engine/patch/ledscan"

LM_ROW = 26;
LM_LEFT_W = 250;
LM_RIGHT_W = 270;
LM_TOOLBAR_H = 32;
LM_STRIP_H = 14;
LM_MASTERS_H = 34;
LM_CHANNELS_H = 170;
LM_HANDLE = 7;
LM_HIT = 9; //pixels a click may be away from a segment
LM_PRESET_DIR = __DIR__ + "/../";
LM_PRESET_KINDS = [["scenes", "scene", "Scene"], ["groups", "group", "Group"], ["segments", "segment", "Segment"]];
LM_TOOLS = [
	["select", "Select", "crosshairs", "Pick a segment, drag it, its ends or the handle of a curve (V)"],
	["line", "Line", "minus", "Drag to draw a straight segment into the selected group (L)"],
	["curve", "Curve", "sync", "Drag to draw a curved segment, then drag its handle (C)"],
	["transform", "Transform", "expand_arrows_alt", "Move, scale and turn the whole selected group (T)"],
];
LM_SHAPES = ["Line", "Curve"];

//GLFW
LM_KEY_DELETE = 261;
LM_KEY_BACKSPACE = 259;
LM_KEY_ESCAPE = 256;
LM_KEY_C = 67;
LM_KEY_D = 68;
LM_KEY_L = 76;
LM_KEY_R = 82;
LM_KEY_T = 84;
LM_KEY_V = 86;
LM_KEY_RIGHT = 262;
LM_KEY_LEFT = 263;
LM_KEY_DOWN = 264;
LM_KEY_UP = 265;
LM_MOD_SHIFT = 1;
LM_MOD_CTRL = 2;

//The picture as it comes in
LM_SHADER_SRC = R"(
#version 330 core

uniform sampler2D input;

void main()
{
    fragColor = texture(input, v_uv);
}
)";

//One pixel per LED: the colour under the LED (averaged over led_radius), smoothed, scaled by the gain of its segment
//(scene master x group brightness), then in the colour order of the LED. gains: per segment r = gain, g = test value,
//b = 1 while testing (the test value replaces the colour)
LM_LED_SHADER_SRC = R"(
#version 330 core

uniform sampler2D input;
uniform sampler2D led_coords;
uniform sampler2D gains;
uniform sampler2D feedback;
uniform sampler2D led_pos; // #980: x, y, z on the stage (metres), w 1: the 3D effect colours this LED

// The 3D effect (#980): over the box of its LEDs (fx_lo .. fx_hi), fx_time in cycles (speed applied)
uniform int fx_type;      // 0 plane sweep, 1 sphere pulse, 2 noise, 3 rainbow
uniform int fx_axis;      // 0 x, 1 y, 2 z
uniform float fx_time;
uniform float fx_size;    // 0..1 of the box
uniform float fx_hue_a;
uniform float fx_hue_b;
uniform vec3 fx_lo;
uniform vec3 fx_hi;

vec3 hue_rgb(float h)
{
    vec3 k = clamp(abs(fract(h + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
    return k;
}

float fx_hash(vec3 p)
{
    p = fract(p * 0.3183099 + 0.1);
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float fx_noise(vec3 x)
{
    vec3 i = floor(x);
    vec3 f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(mix(fx_hash(i), fx_hash(i + vec3(1, 0, 0)), f.x), mix(fx_hash(i + vec3(0, 1, 0)), fx_hash(i + vec3(1, 1, 0)), f.x), f.y),
               mix(mix(fx_hash(i + vec3(0, 0, 1)), fx_hash(i + vec3(1, 0, 1)), f.x), mix(fx_hash(i + vec3(0, 1, 1)), fx_hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

vec3 effect3d(vec3 p)
{
    vec3 span = max(fx_hi - fx_lo, vec3(0.001));
    vec3 q = (p - fx_lo) / span;                       // 0..1 in the box
    float along = fx_axis == 0 ? q.x : (fx_axis == 1 ? q.y : 1.0 - q.z);
    float size = max(fx_size, 0.01);
    vec3 a = hue_rgb(fx_hue_a);
    vec3 b = hue_rgb(fx_hue_b);
    if (fx_type == 0)
    {
        // a plane of colour a sweeping through, b elsewhere
        float d = abs(fract(along - fx_time + 0.5) - 0.5);
        return mix(b, a, 1.0 - smoothstep(size * 0.5, size * 0.5 + 0.05, d));
    }
    if (fx_type == 1)
    {
        // rings from the middle of the box outwards
        float r = length((p - (fx_lo + fx_hi) * 0.5) / max(max(span.x, span.y), span.z));
        float w = fract(r / size - fx_time);
        return mix(b, a, smoothstep(0.0, 0.15, w) * (1.0 - smoothstep(0.35, 0.6, w)));
    }
    if (fx_type == 2)
    {
        // 3D noise drifting through
        float n = fx_noise(q / size * 2.0 + vec3(0.0, 0.0, fx_time * 2.0));
        return mix(b, a, smoothstep(0.35, 0.65, n));
    }
    // a rainbow along the axis
    return hue_rgb(fx_hue_a + along / size - fx_time);
}

uniform int analog_mode;
uniform int led_radius;
uniform float feedback_value; // 0.0 = none, 1.0 = full ghosting

void main()
{
    // x, y, rgb_type, segment slot
    vec4 coords = texelFetch(led_coords, ivec2(int(gl_FragCoord.x), 0), 0);
    int rgb_type = int(coords.z);
    vec4 gain = texelFetch(gains, ivec2(int(coords.w + 0.5), 0), 0);

    coords.y = 1.0 - coords.y;

    vec4 current_color;
    if (led_radius <= 0)
    {
        current_color = texture(input, coords.xy);
    }
    else
    {
        ivec2 input_size = textureSize(input, 0);
        vec2 pixel_size = 1.0 / vec2(input_size);
        vec4 color_sum = vec4(0.0);
        int sample_count = 0;
        for (int y = -led_radius; y <= led_radius; y++)
        {
            for (int x = -led_radius; x <= led_radius; x++)
            {
                if (x * x + y * y <= led_radius * led_radius)
                {
                    color_sum += texture(input, coords.xy + vec2(float(x), float(y)) * pixel_size);
                    sample_count++;
                }
            }
        }
        current_color = color_sum / float(sample_count);
    }
    // #980: an LED of the 3D effect takes the effect's colour at its place on the stage
    vec4 lpos = texelFetch(led_pos, ivec2(int(gl_FragCoord.x), 0), 0);
    if (lpos.w > 0.5)
        current_color = vec4(effect3d(lpos.xyz), 1.0);
    current_color *= gain.r;

    vec4 feedbackColor = max(texture(feedback, v_uv) - 0.0025, 0.0);
    float attack;
    float release;
    if (analog_mode == 0)
    {
        float feedback_amount = 1.0 - clamp(feedback_value, 0.0, 1.0);
        float decay = feedback_amount * feedback_amount;
        attack = 0.85;
        release = 0.15 + decay * 0.80;
    }
    else
    {
        // Simulates the thermal inertia of a lamp: up quickly, down slowly
        float inertia = clamp(feedback_value, 0.0, 1.0);
        inertia *= inertia;
        attack = mix(0.95, 0.25, inertia);
        release = mix(0.15, 0.02, inertia);
    }
    vec4 target = current_color;
    vec4 response;
    response.r = target.r > feedbackColor.r ? mix(feedbackColor.r, target.r, attack) : mix(feedbackColor.r, target.r, release);
    response.g = target.g > feedbackColor.g ? mix(feedbackColor.g, target.g, attack) : mix(feedbackColor.g, target.g, release);
    response.b = target.b > feedbackColor.b ? mix(feedbackColor.b, target.b, attack) : mix(feedbackColor.b, target.b, release);
    response.a = target.a > feedbackColor.a ? mix(feedbackColor.a, target.a, attack) : mix(feedbackColor.a, target.a, release);
    fragColor = response;

    if (gain.b > 0.5)
        fragColor = vec4(gain.g, gain.g, gain.g, 1.0);

    if (rgb_type == 0)
    {
        float max_value = max(fragColor.r, max(fragColor.g, fragColor.b));
        fragColor = vec4(max_value, max_value, max_value, 0.0);
    }
    else if (rgb_type == 2)
        fragColor = vec4(fragColor.r, fragColor.b, fragColor.g, fragColor.a);
    else if (rgb_type == 3)
        fragColor = vec4(fragColor.g, fragColor.r, fragColor.b, fragColor.a);
    else if (rgb_type == 4)
        fragColor = vec4(fragColor.g, fragColor.b, fragColor.r, fragColor.a);
    else if (rgb_type == 5)
        fragColor = vec4(fragColor.b, fragColor.r, fragColor.g, fragColor.a);
    else if (rgb_type == 6)
        fragColor = vec4(fragColor.b, fragColor.g, fragColor.r, fragColor.a);
}
)";

class led_mapper {

	engine = None;
	gen = None;

	scenes = []; //the layout, saved as fixture_scenes
	sel_scene = -1;
	sel_group = -1;
	sel_segment = -1;
	tool_name = "select";
	snap_on = true;
	grid_div = 12;
	test_on = false;
	labels_on = true;
	channels_on = true; //the channel map under the picture
	map_shift = 0; //universes its arrows stepped from the selection
	map_cells = None; //dmx_universe_cells() of the universe in the map, cached
	map_cells_key = "";

	build_data = None;
	build_dirty = true;
	gains_dirty = true;
	uploaded_master = 1.0; //the blackout master the gains were uploaded with (upload_gains)
	seen_patch_rev = -1;
	devices_cache = [];
	overlap_slots = []; //slots that write channels something else writes too (here or elsewhere)
	own_overlaps = []; //[[a, b], ...] slots of this LEDMapper on the same channels (ledmap_overlaps)
	ext_problems = []; //slot (as string) -> ["Same channels as ...", ...]: lamps of the setup, other LEDMappers
	seen_dmx_state = "";
	drag = None;

	managed canvas = None;
	managed canvas_view = None;
	managed canvas_scroll = None;
	ui = 1.0; //canvas pixels per screen pixel: the canvas is shown zoomed, lines and labels keep their size on screen
	managed led_shader = None;
	managed coords_image = None;
	managed gains_image = None;
	coords_tex = None;
	managed pos_image = None; //#980: the place of each LED on the stage, for the 3D effect
	pos_tex = None;
	seen_stage_rev = -1;      //the stage it placed the LEDs by (an object they hang on moves: again)
	fx_clock = 0.0;           //cycles of the 3D effect so far
	fx_last = 0;              //std.millis() of the last frame
	managed fx_type = None;   //the controls of the 3D effect
	managed fx_speed = None;
	managed fx_size = None;
	managed fx_axis = None;
	managed fx_hue_a = None;
	managed fx_hue_b = None;
	gains_tex = None;

	//#980: the camera scan of the LEDs' places (engine/patch/ledscan.shio)
	scan = None;              //LedScan of the last scan (running or done)
	scan_gpu = None;          //LedScanGpu while one runs
	scan_slots = [];          //the segments scanned: [id, offset, count] (offset into scan.leds)
	scan_buffer = None;       //what is sent while scanning: the one LED lit
	scan_lit = -1;            //the LED lit in scan_buffer
	scan_camera = "";         //live_path of the Camera generator
	scan_cam_paths = [];      //of the camera list
	scan_fit = true;          //the places fitted into the picture
	scan_result = "";         //what the last scan found
	scan_shown = "";          //the status text shown
	managed scan_btn = None;
	managed scan_info = None;
	managed scan_wait_box = None;
	managed scan_cam_combo = None;

	managed in_ctrl = None;
	managed out_ctrl = None;
	managed size_x = None;
	managed size_y = None;

	managed outliner_holder = None;
	managed inspector_holder = None;
	managed library_holder = None;
	managed masters_holder = None;
	outliner_box = None; //rebuilt with fresh_box
	inspector_box = None;
	library_box = None;
	masters = []; //scene id -> control "Master"

	tool_buttons = [];
	managed test_btn = None;
	managed labels_btn = None;
	managed snap_btn = None;
	managed channels_btn = None;
	managed channels_area = None;
	managed center_holder = None;
	managed chmap = None;
	managed status_label = None;
	info_label = None; //addresses of the selection in the inspector

	__init__(generator, area) {
		gen = generator;
		engine = generator.engine;
		build_ui(area);
	}

	// =========================================================================
	// Selection
	// =========================================================================

	cur_scene() {
		return sel_scene >= 0 && sel_scene < scenes.size() ? scenes[sel_scene] : None;
	}

	cur_group() {
		sc = cur_scene();
		return sc && sel_group >= 0 && sel_group < sc.groups.size() ? sc.groups[sel_group] : None;
	}

	cur_segment() {
		g = cur_group();
		return g && sel_segment >= 0 && sel_segment < g.segments.size() ? g.segments[sel_segment] : None;
	}

	select(si, gi = -1, k = -1) {
		if(si != sel_scene || gi != sel_group || k != sel_segment)
			map_shift = 0; //the channel map goes back to the universe of the selection
		sel_scene = si;
		sel_group = gi;
		sel_segment = k;
		gains_dirty = true;
		build_outliner();
		build_inspector();
	}

	//After a change of the layout. structure: the outliner (names, items) changed too
	changed(structure = false, inspector = false) {
		build_dirty = true;
		if(structure) {
			build_outliner();
			build_masters();
		}
		if(inspector)
			build_inspector();
	}

	fresh_box(holder, old) {
		if(old)
			std.free(old);
		return holder.widget().layout(nanogui.layout_vertical());
	}

	// =========================================================================
	// Making things
	// =========================================================================

	add_scene(name = "") {
		sc = ledmap_normalize_scene([name = name ? name : "Scene " + (scenes.size() + 1), groups = []]);
		scenes.push_back(sc);
		select(scenes.size() - 1, -1, -1);
		changed(true);
		return scenes[-1];
	}

	add_group(name = "") {
		if(!cur_scene())
			add_scene();
		sc = cur_scene();
		nodes = patch_known_nodes(engine.net, engine.patch);
		g = ledmap_normalize_group([name = name ? name : "Group " + (sc.groups.size() + 1), segments = [],
			device_mac = nodes.size() ? nodes[0].mac : ""]);
		sc.groups.push_back(g);
		select(sel_scene, sc.groups.size() - 1, -1);
		changed(true);
		return sc.groups[-1];
	}

	//A new segment from a to b (0..1 of the picture, before the transform of the group) into the selected group
	add_segment(a, b, shape = "line") {
		if(!cur_group())
			add_group();
		g = cur_group();
		last = g.segments.size() ? g.segments[-1] : None;
		seg = ledmap_normalize_segment([
			name = "Segment " + (g.segments.size() + 1),
			start_pos = [x = a.x, y = a.y],
			end_pos = [x = b.x, y = b.y],
			shape = shape,
			width = last ? last.width : 60,
			height = last ? last.height : 1,
			rgb_type = last ? last.rgb_type : 1,
			is_rgbw = last ? last.is_rgbw : 0,
		]);
		if(shape == "curve") {
			//The handle beside the middle: the curve shows that it is one
			d = b - a;
			seg.control = [x = (a.x + b.x) / 2.0 + d.y * 0.25, y = (a.y + b.y) / 2.0 - d.x * 0.25];
		}
		g.segments.push_back(seg);
		select(sel_scene, sel_group, g.segments.size() - 1);
		changed(true);
		return g.segments[-1];
	}

	remove_selected() {
		sc = cur_scene();
		g = cur_group();
		if(cur_segment()) {
			g.segments.erase(sel_segment);
			select(sel_scene, sel_group, -1);
		}
		else if(g) {
			sc.groups.erase(sel_group);
			select(sel_scene, -1, -1);
		}
		else if(sc) {
			if(sc.groups.size() && !engine.screen.modal_yes_no("Remove the scene " + sc.name + " with its " + sc.groups.size() + " groups?", "Remove scene"))
				return;
			scenes.erase(sel_scene);
			select(-1, -1, -1);
		}
		changed(true);
	}

	duplicate_selected() {
		seg = cur_segment();
		g = cur_group();
		if(seg) {
			copy = ledmap_new_ids(seg.copy());
			copy.name = seg.name + " copy";
			//a little lower, so it is seen
			moved = ledmap_segment_movable(copy);
			for(i = 0; i < moved.size(); i++)
				moved[i].y = math.min(1.0, moved[i].y + 0.05);
			g.segments.insert(sel_segment + 1, copy);
			select(sel_scene, sel_group, sel_segment + 1);
		}
		else if(g) {
			copy = ledmap_new_ids(g.copy());
			copy.name = g.name + " copy";
			cur_scene().groups.insert(sel_group + 1, copy);
			select(sel_scene, sel_group + 1, -1);
		}
		changed(true);
	}

	//The lamps of a target of the fixture setup (group or type) as a new group: one segment per lamp with pixels, placed
	//as they hang on the stage plan, each on the address of its lamp
	add_lamps(target) {
		lamps = patch_target_fixtures(engine.patch, target);
		pixel_lamps = [];
		for(i = 0; i < lamps.size(); i++) {
			if(patch_pixel_slots(lamps[i].type).size())
				pixel_lamps.push_back(lamps[i]);
		}
		if(!pixel_lamps.size())
			return None;
		b = patch_bounds(pixel_lamps);
		w = math.max(1.0, b.max_x - b.min_x + 1.0);
		h = math.max(1.0, b.max_y - b.min_y + 1.0);
		scale = 0.8 / math.max(w, h);
		cx = (b.min_x + b.max_x) / 2.0;
		cy = (b.min_y + b.max_y) / 2.0;
		g = add_group(patch_target_name(engine.patch, target));
		g.device_mac = pixel_lamps[0].node;
		for(i = 0; i < pixel_lamps.size(); i++) {
			f = pixel_lamps[i];
			slots = patch_pixel_slots(f.type);
			length = math.max(0.3, slots.size() * 0.12) * scale;
			a = (f.rotation ?? 0) * math.PI / 180.0;
			mx = 0.5 + (f.x - cx) * scale;
			my = 0.5 + (f.y - cy) * scale;
			dx = math.cos(a) * length / 2.0;
			dy = math.sin(a) * length / 2.0;
			g.segments.push_back(ledmap_normalize_segment([
				name = f.name,
				start_pos = [x = math.clamp(mx - dx, 0.0, 1.0), y = math.clamp(my - dy, 0.0, 1.0)],
				end_pos = [x = math.clamp(mx + dx, 0.0, 1.0), y = math.clamp(my + dy, 0.0, 1.0)],
				width = slots.size(),
				rgb_type = 1,
				is_rgbw = slots[0].kind == "RGBW" ? 1 : 0,
				target = "fixture:" + f.id,
			]));
		}
		select(sel_scene, sel_group, -1);
		changed(true, true);
		return g;
	}

	// =========================================================================
	// Presets (the Library)
	// =========================================================================

	//The preset files: [path (from the app folder), kind, label]. (fileio.files() names them relative to their folder.)
	preset_files() {
		list = [];
		for(i = 0; i < LM_PRESET_KINDS.size(); i++) {
			dir = LM_PRESET_DIR + LM_PRESET_KINDS[i][0];
			if(!fileio.exists(dir))
				continue;
			files = fileio.files(dir, false);
			for(j = 0; j < files.size(); j++) {
				if(std.string(files[j]).ends(".json"))
					list.push_back([path = dir + "/" + fileio.file_name(files[j]), kind = LM_PRESET_KINDS[i][1], label = LM_PRESET_KINDS[i][2]]);
			}
		}
		return list;
	}

	//A preset (or a dropped file) into the layout where the selection is. kind: what the file is when it does not say
	//(its folder); presets saved before #655 have no "type"
	insert_preset(config, kind = "") {
		if(!config || std.type(config) != "json")
			return false;
		kind = ledmap_preset_kind(config, kind);
		data = ledmap_new_ids(config.copy());
		if(data.has("type"))
			data.erase("type");
		if(kind == "scene") {
			scenes.push_back(ledmap_normalize_scene(data));
			select(scenes.size() - 1, -1, -1);
		}
		else if(kind == "group") {
			if(!cur_scene())
				add_scene();
			cur_scene().groups.push_back(ledmap_normalize_group(data));
			select(sel_scene, cur_scene().groups.size() - 1, -1);
		}
		else if(kind == "segment") {
			if(!cur_group())
				add_group();
			cur_group().segments.push_back(ledmap_normalize_segment(data));
			select(sel_scene, sel_group, cur_group().segments.size() - 1);
		}
		else
			return false;
		set_tool("select"); //what was inserted can be moved and picked right away
		changed(true);
		return true;
	}

	save_preset(kind, item) {
		form = [[id = "name", label = "Preset name", type = "text", placeholder = item.name]];
		res = engine.screen.modal_form(form, "Save " + kind + " as a preset", "Save", "Cancel");
		if(res.choice != "submit")
			return;
		name = res.values.name ? std.string(res.values.name) : std.string(item.name);
		if(!name)
			return;
		data = item.copy();
		data.type = kind;
		fileio.write_json(LM_PRESET_DIR + kind + "s/" + name + ".json", data, true);
		build_library();
	}

	//The presets by kind: click to insert, × to delete
	build_library() {
		library_box = fresh_box(library_holder, library_box);
		files = preset_files();
		if(!files.size())
			library_box.label("No presets yet: Preset in the settings of a scene, group or segment saves one.").wrap(true)
				.fixed_width(LM_LEFT_W - 16).text_color(PAL_TEXT_3);
		last_kind = "";
		for(i = 0; i < files.size(); i++) {
			entry = files[i];
			path = entry.path;
			kind = entry.kind;
			if(kind != last_kind) {
				last_kind = kind;
				library_box.label(entry.label + "s").fixed_height(LM_ROW - 6).text_color(PAL_TEXT_3);
			}
			row = library_box.widget().fixed_height(LM_ROW);
			b = row.button(fileio.pure_name(path)).icon(nanogui.icon("plus")).alignment("left").anchor_left(0).anchor_right(LM_ROW + 2).fixed_height(LM_ROW);
			where = kind == "scene" ? "as a new scene" : (kind == "group" ? "into the selected scene" : "into the selected group");
			b.tooltip("Click: insert this " + kind + " " + where + " (one is made when there is none). Or drag it from the Assets tab (Mapping > LEDMapper) onto the picture");
			b.on_click([this, path, kind]() {
				if(!this.insert_preset(fileio.read_json(path), kind))
					this.engine.screen.modal_yes_no("This preset could not be read: " + path, "Preset");
			});
			del = row.button("").icon(nanogui.icon("times")).anchor_right(0).fixed_width(LM_ROW).fixed_height(LM_ROW).transparent(true);
			del.tooltip("Delete this preset");
			del.on_click([this, path]() {
				if(this.engine.screen.modal_yes_no("Delete the preset " + fileio.pure_name(path) + "?", "Delete preset")) {
					fileio.remove(path);
					this.build_library();
				}
			});
		}
		library_holder.refresh_layout();
	}

	// =========================================================================
	// Outliner (left) and the masters of the scenes (under the canvas)
	// =========================================================================

	outliner_row(box, indent, caption, is_selected, enabled_item, on_pick, tooltip) {
		row = box.widget().fixed_height(LM_ROW);
		x = indent;
		if(enabled_item) {
			eye = row.button("").icon(nanogui.icon(enabled_item.enabled ? "eye" : "eye_slash")).anchor_left(x).fixed_width(LM_ROW).fixed_height(LM_ROW).transparent(true);
			eye.tooltip(enabled_item.enabled ? "On: sent. Click to switch it off (not sent at all)" : "Off: not sent. Click to switch it on");
			eye.on_click([this, enabled_item]() {
				enabled_item.enabled = enabled_item.enabled ? 0 : 1;
				this.changed(true);
			});
			x += LM_ROW;
		}
		else
			x += 6;
		btn = row.pushbutton(caption).alignment("left").latched_style("selection").anchor_left(x).anchor_right(0).fixed_height(LM_ROW);
		btn.pushed(is_selected);
		if(enabled_item && !enabled_item.enabled)
			btn.text_color(PAL_TEXT_3);
		btn.tooltip(tooltip);
		btn.on_change([on_pick](v) {
			on_pick();
		});
		return btn;
	}

	build_outliner() {
		box = fresh_box(outliner_holder, outliner_box);
		outliner_box = box;
		if(!scenes.size())
			box.label("Draw a segment on the picture (Line or Curve), or add a scene.").wrap(true).fixed_width(LM_LEFT_W - 16).text_color(PAL_TEXT_3);
		for(si = 0; si < scenes.size(); si++) {
			sc = scenes[si];
			s_index = si;
			outliner_row(box, 0, sc.name, si == sel_scene && sel_group < 0, sc, [this, s_index]() { this.select(s_index, -1, -1); },
				"Scene: a set of groups with a master");
			for(gi = 0; gi < sc.groups.size(); gi++) {
				g = sc.groups[gi];
				g_index = gi;
				caption = g.name + (g.target ? "  (lamp)" : "");
				outliner_row(box, 14, caption, si == sel_scene && gi == sel_group && sel_segment < 0, g,
					[this, s_index, g_index]() { this.select(s_index, g_index, -1); }, "Group: what one node gets, its segments one after the other");
				for(k = 0; k < g.segments.size(); k++) {
					seg = g.segments[k];
					k_index = k;
					leds = seg.width * seg.height;
					outliner_row(box, 40, seg.name + "  · " + leds, si == sel_scene && gi == sel_group && k == sel_segment, None,
						[this, s_index, g_index, k_index]() { this.select(s_index, g_index, k_index); }, "Segment: " + leds + " LEDs");
				}
			}
		}
		row = box.widget().fixed_height(LM_ROW + 6);
		add_s = row.button("Scene").icon(nanogui.icon("plus")).anchor_left(0).fixed_width(80).anchor_top(4).fixed_height(LM_ROW);
		add_s.tooltip("Add a scene");
		add_s.on_click([this]() { this.add_scene(); });
		add_g = row.button("Group").icon(nanogui.icon("plus")).anchor_left(84).fixed_width(80).anchor_top(4).fixed_height(LM_ROW);
		add_g.tooltip("Add a group to the selected scene");
		add_g.on_click([this]() { this.add_group(); });
		outliner_holder.refresh_layout();
	}

	build_masters() {
		//Scenes that are gone
		for(i = masters.size() - 1; i >= 0; i--) {
			id = masters.key(i);
			found = false;
			for(j = 0; j < scenes.size(); j++) {
				if(scenes[j].id == id)
					found = true;
			}
			if(!found) {
				std.free(masters[i]);
				masters.erase(id);
			}
		}
		for(j = 0; j < scenes.size(); j++) {
			sc = scenes[j];
			ctrl = masters[sc.id] ?? None;
			if(!ctrl) {
				ctrl = masters_holder.controlslider("Master", sc.id).fixed_height(LM_ROW).fixed_width(200);
				ctrl.value(sc.master);
				id = sc.id;
				ctrl.callback([this, id](v) {
					for(n = 0; n < this.scenes.size(); n++) {
						if(this.scenes[n].id == id)
							this.scenes[n].master = v;
					}
					this.build_dirty = true;
				});
				masters[sc.id] = ctrl;
			}
			ctrl.display_name(sc.name);
			ctrl.tooltip("Master of the scene " + sc.name + ": scales all its LEDs");
			ctrl.anchor_left(4 + j * 204).anchor_top(4);
		}
	}

	// =========================================================================
	// Inspector (right)
	// =========================================================================

	field(parent, caption) {
		row = parent.widget().fixed_height(LM_ROW + 2);
		row.label(caption).anchor_left(0).fixed_width(100).fixed_height(LM_ROW).text_color(PAL_TEXT_2);
		return row.widget().anchor_left(100).anchor_right(0).fixed_height(LM_ROW);
	}

	title(parent, text) {
		return parent.label(text).fixed_height(LM_ROW + 4).bold(true);
	}

	hint(parent, text) {
		return parent.label(text).wrap(true).fixed_width(LM_RIGHT_W - 16).text_color(PAL_TEXT_3);
	}

	//The nodes in a combobox, on_pick(mac)
	node_combo(parent, current, on_pick) {
		nodes = patch_known_nodes(engine.net, engine.patch);
		items = ["No node"];
		macs = [""];
		sel = 0;
		for(i = 0; i < nodes.size(); i++) {
			items.push_back(nodes[i].name + (nodes[i].online ? "" : " (offline)"));
			macs.push_back(nodes[i].mac);
			if(nodes[i].mac == current)
				sel = i + 1;
		}
		if(current && sel == 0) {
			items.push_back(current + " (not found)");
			macs.push_back(current);
			sel = items.size() - 1;
		}
		combo = parent.combobox().items(items).selected(sel).anchor(0);
		combo.on_change([macs, on_pick](index, text) {
			if(index >= 0 && index < macs.size())
				on_pick(macs[index]);
		});
		return combo;
	}

	//Lamps of the fixture setup that have pixels (a colour channel), on_pick("fixture:<id>" or "")
	lamp_combo(parent, current, on_pick) {
		items = ["None"];
		ids = [""];
		sel = 0;
		p = engine.patch;
		for(i = 0; i < p.fixtures.size(); i++) {
			f = p.fixtures[i];
			slots = patch_pixel_slots(f.type);
			if(!slots.size())
				continue;
			items.push_back(f.name + " · " + slots.size() + " px · " + patch_address_text(f));
			ids.push_back("fixture:" + f.id);
			if("fixture:" + f.id == current)
				sel = ids.size() - 1;
		}
		if(current && sel == 0) {
			items.push_back("(lamp gone)");
			ids.push_back(current);
			sel = items.size() - 1;
		}
		combo = parent.combobox().items(items).selected(sel).anchor(0);
		combo.tooltip("A lamp of the fixture setup (Fixtures > Setup): the address comes from the lamp and follows it");
		combo.on_change([ids, on_pick](index, text) {
			if(index >= 0 && index < ids.size())
				on_pick(ids[index]);
		});
		return combo;
	}

	//"U0 · 1 – U1 · 30" of the selection (from the last build)
	selection_info() {
		if(!build_data)
			return "";
		first = None;
		last = None;
		leds = 0;
		for(i = 0; i < build_data.slots.size(); i++) {
			s = build_data.slots[i];
			if(s.scene != sel_scene || (sel_group >= 0 && s.group != sel_group) || (sel_segment >= 0 && s.segment != sel_segment))
				continue;
			if(!first)
				first = s;
			last = s;
			leds += s.count;
		}
		if(!first)
			return "Not sent (switched off)";
		text = leds + " LEDs · " + ledmap_address_text(first.start) + " – " + ledmap_address_text(last.last);
		if(first.node)
			text += "\n" + patch_node_name(engine.net, engine.patch, first.node);
		else
			text += "\nNo node: not sent";
		own = false;
		others = [];
		for(i = 0; i < overlap_slots.size(); i++) {
			s = build_data.slots[overlap_slots[i]];
			if(s.scene != sel_scene || (sel_group >= 0 && s.group != sel_group) || (sel_segment >= 0 && s.segment != sel_segment))
				continue;
			for(k = 0; k < own_overlaps.size(); k++) {
				if(own_overlaps[k].a == overlap_slots[i] || own_overlaps[k].b == overlap_slots[i])
					own = true;
			}
			list = ext_problems[std.string(overlap_slots[i])] ?? [];
			for(k = 0; k < list.size(); k++) {
				if(!others.has_value(list[k]))
					others.push_back(list[k]);
			}
		}
		if(own)
			text += "\nSends to the same channels as another segment";
		for(i = 0; i < others.size() && i < 3; i++)
			text += "\n" + others[i];
		if(others.size() > 3)
			text += "\n… and " + std.string(others.size() - 3) + " more";
		return text;
	}

	build_inspector() {
		box = fresh_box(inspector_holder, inspector_box);
		inspector_box = box;
		info_label = None;
		seg = cur_segment();
		g = cur_group();
		sc = cur_scene();
		if(seg)
			build_segment_inspector(box, seg, g);
		else if(g)
			build_group_inspector(box, g);
		else if(sc)
			build_scene_inspector(box, sc);
		else {
			title(box, "LEDMapper");
			hint(box, "1. Pick the picture in Input (left).");
			hint(box, "2. Choose Line or Curve and drag on the picture: each segment is one strip with its own number of LEDs.");
			hint(box, "3. Click a segment to set LEDs, colour order and address; click its group for the node.");
			hint(box, "4. Test lights the selection white on the real LEDs.");
			hint(box, "Lamps of the fixture setup with pixels can be added from the settings of a scene.");
		}
		if(sc || g || seg) {
			info_label = box.label(selection_info()).wrap(true).fixed_width(LM_RIGHT_W - 16);
			info_label.text_color(PAL_TEXT_2);
		}
		inspector_holder.refresh_layout();
	}

	update_info() {
		if(info_label)
			info_label.caption(selection_info());
	}

	name_field(box, item) {
		name = field(box, "Name").textbox(item.name).anchor(0);
		name.on_change([this, item](text) {
			if(text) {
				item.name = text;
				this.build_dirty = true; //the name is in what the fixture setup shows for its channels
				this.build_outliner();
				this.build_masters();
			}
		});
	}

	build_scene_inspector(box, sc) {
		title(box, "Scene");
		name_field(box, sc);
		hint(box, "The master of the scene is under the picture: link it or map it to MIDI like any slider.");
		add = box.button("Add group").icon(nanogui.icon("plus")).fixed_height(LM_ROW);
		add.on_click([this]() { this.add_group(); });

		targets = patch_targets(engine.patch);
		if(targets.size()) {
			title(box, "Lamps of the fixture setup");
			hint(box, "Adds a group with one segment per lamp that has pixels, placed as on the stage plan, each on the address of its lamp.");
			items = [];
			for(i = 0; i < targets.size(); i++)
				items.push_back(targets[i].name);
			pick = box.combobox().items(items).fixed_height(LM_ROW);
			lamps_btn = box.button("Add these lamps").icon(nanogui.icon("plus")).fixed_height(LM_ROW);
			lamps_btn.on_click([this, pick, targets]() {
				i = pick.selected();
				if(i >= 0 && i < targets.size() && !this.add_lamps(targets[i].id))
					this.engine.screen.modal_yes_no("These lamps have no colour channels (RGB or RGBW).", "Add lamps");
			});
		}

		save_btn = box.button("Save as preset").icon(nanogui.icon("save")).fixed_height(LM_ROW);
		save_btn.on_click([this, sc]() { this.save_preset("scene", sc); });
		rem = box.button("Remove scene").icon(nanogui.icon("trash")).fixed_height(LM_ROW).danger(true);
		rem.on_click([this]() { this.remove_selected(); });
	}

	build_group_inspector(box, g) {
		title(box, "Group");
		name_field(box, g);

		uses_lamp = g.target ? 1 : 0;
		out = field(box, "Output").combobox().items(["Art-Net node", "Lamp of the setup"]).selected(uses_lamp).anchor(0);
		out.tooltip("Where the LEDs of this group go: a node (universe and address set here) or a lamp of the fixture setup");
		out.on_change([this, g](index, text) {
			if(index == 0)
				g.target = "";
			else if(!g.target)
				g.target = "fixture:";
			this.changed(true, true);
		});

		if(uses_lamp) {
			lamp_combo(field(box, "Lamp"), g.target, [this, g](id) {
				g.target = id ? id : "fixture:";
				//its pixels: the LEDs of a single segment
				lamp = ledmap_fixture_address(this.engine.patch, g.target);
				if(lamp && g.segments.size() == 1) {
					g.segments[0].width = lamp.pixels;
					g.segments[0].height = 1;
					g.segments[0].is_rgbw = lamp.rgbw ? 1 : 0;
				}
				this.changed(true, true);
			});
		}
		else {
			node_combo(field(box, "Node"), g.device_mac, [this, g](mac) {
				g.device_mac = mac;
				this.changed(false);
				this.update_info();
			});
			uni = field(box, "Universe").intbox().anchor(0).min_value(0).max_value(32767).value(g.start_universe);
			uni.tooltip("Art-Net universe of the first LED");
			uni.value_callback([this, g](v) {
				g.start_universe = v;
				this.changed(false);
			});
			adr = field(box, "Address").intbox().anchor(0).min_value(1).max_value(512).value(g.start_channel + 1);
			adr.tooltip("DMX address of the first LED (1–512)");
			adr.value_callback([this, g](v) {
				g.start_channel = v - 1;
				this.changed(false);
			});
		}
		wrap = box.pushbutton("Whole pixels per universe").fixed_height(LM_ROW).pushed(g.wrap_leds ? true : false);
		wrap.tooltip("On: a universe holds whole LEDs only (170 RGB, 128 RGBW); the next LED starts the next universe. Off: an LED can be split over two universes. As your node expects it.");
		wrap.on_change([this, g](v) {
			g.wrap_leds = v ? 1 : 0;
			this.changed(false);
		});
		gap = field(box, "Spacing").intbox().anchor(0).min_value(0).max_value(65536).value(g.channel_gap);
		gap.tooltip("0: each segment starts right after the one before. Otherwise: channels from the start of a segment to the start of the next (512: each segment in a universe of its own).");
		gap.value_callback([this, g](v) {
			g.channel_gap = v;
			this.changed(false);
		});
		bright = box.slider("Brightness").fixed_height(LM_ROW).value(g.max_brightness);
		bright.tooltip("Scales all LEDs of this group");
		bright.value_callback([this, g](v) {
			g.max_brightness = v;
			this.changed(false);
		});

		title(box, "Transform");
		hint(box, "Transform (T): drag the corners or the middle on the picture.");
		ang = field(box, "Angle").intbox().anchor(0).min_value(-180).max_value(180).value(g.transform_angle);
		ang.value_callback([this, g](v) {
			g.transform_angle = v;
			this.changed(false);
		});
		row = box.widget().fixed_height(LM_ROW + 2);
		mx = row.button("Mirror X").anchor_left(0).fixed_width(84).fixed_height(LM_ROW);
		mx.tooltip("Flips the segments left to right (their data direction stays)");
		mx.on_click([this, g]() { this.mirror(g, true); });
		my = row.button("Mirror Y").anchor_left(88).fixed_width(84).fixed_height(LM_ROW);
		my.on_click([this, g]() { this.mirror(g, false); });
		reset = row.button("Reset").anchor_left(176).anchor_right(0).fixed_height(LM_ROW);
		reset.tooltip("Back to the whole picture, no angle");
		reset.on_click([this, g]() {
			g.transform_uv = ledmap_default_transform();
			g.transform_angle = 0;
			this.changed(false, true);
		});

		build_stage_place(box, g);

		row = box.widget().fixed_height(LM_ROW + 2);
		dup = row.button("Duplicate").icon(nanogui.icon("copy")).anchor_left(0).fixed_width(126).fixed_height(LM_ROW);
		dup.on_click([this]() { this.duplicate_selected(); });
		save_btn = row.button("Preset").icon(nanogui.icon("save")).anchor_left(130).anchor_right(0).fixed_height(LM_ROW);
		save_btn.tooltip("Save this group as a preset (Library on the left)");
		save_btn.on_click([this, g]() { this.save_preset("group", g); });
		rem = box.button("Remove group").icon(nanogui.icon("trash")).fixed_height(LM_ROW).danger(true);
		rem.on_click([this]() { this.remove_selected(); });
	}

	//Where the group is on the stage (#980, place3d): its LEDs in the 3D views of the Stage menu and the fixture setup
	build_stage_place(box, g) {
		title(box, "On the stage");
		pl = g.place3d;
		on = box.pushbutton(pl.on ? "Shown on the stage" : "Not on the stage").icon(nanogui.icon(pl.on ? "eye" : "eye_slash"))
			.fixed_height(LM_ROW).pushed(pl.on ? true : false);
		on.tooltip("Places the LEDs of this group in 3D: the Stage menu (Tools) and the 3D view of the fixture setup show them in the colours they are sent\n[[wiki:Stage#leds-on-the-stage]]");
		on.on_change([this, g](v) {
			g.place3d.on = v ? 1 : 0;
			this.changed(false, true);
		});
		if(!pl.on)
			return;
		hint(box, "The middle of the group's LEDs stands at Position, the picture upright facing the audience (its x to the right, its top up) unless turned. Width: how wide the whole picture is on the stage.");
		src_index = LEDMAP_COLOR_SOURCES.has_value(g.color_source) ? patch_index_of(LEDMAP_COLOR_SOURCES, g.color_source) : 0;
		cs = field(box, "Colours").combobox().items(LEDMAP_COLOR_SOURCE_LABELS).selected(src_index).anchor(0);
		cs.tooltip("Picture: where the LEDs are drawn. Projected: the picture laid over every group projected the same way, by where its LEDs stand on the stage (a video shines through the whole arrangement). 3D effect: the effect on the left (3D effect)\n[[wiki:Stage#colours-of-the-leds-on-the-stage]]");
		cs.on_change([this, g](i, text) {
			if(i >= 0 && i < LEDMAP_COLOR_SOURCES.size()) {
				g.color_source = LEDMAP_COLOR_SOURCES[i];
				this.changed(false);
			}
		});
		w3 = (LM_RIGHT_W - 12 - 100) / 3.0;
		rows = [["Position m", ["x", "y", "z"], 0.05], ["Turn °", ["rx", "ry", "rz"], 5.0]];
		for(r : rows) {
			row = box.widget().fixed_height(LM_ROW + 2);
			row.label(r[0]).anchor_left(0).fixed_width(100).fixed_height(LM_ROW).text_color(PAL_TEXT_2);
			for(i = 0; i < 3; i++) {
				k = r[1][i];
				fb = row.floatbox().anchor_left(100 + i * w3).fixed_width(w3 - 4).fixed_height(LM_ROW).value(pl[k]);
				fb.step(r[2]);
				fb.value_callback([this, g, k](v) {
					g.place3d[k] = v;
					this.changed(false);
				});
			}
		}
		wb = field(box, "Width m").floatbox().anchor(0).min_value(0.01).max_value(1000.0).value(pl.width);
		wb.step(0.1);
		wb.tooltip("How wide the whole picture of this LEDMapper is on the stage (metres); the height follows its aspect. The group's own size is below");
		wb.value_callback([this, g](v) {
			if(v > 0.0) {
				g.place3d.width = v;
				this.changed(false);
				this.update_info();
			}
		});
		//an object of the stage it hangs on: it moves with it
		names = ["The stage"];
		ids = [""];
		at = 0;
		st = engine.stage;
		if(st) {
			for(o : st.objects) {
				if(o.id == pl.hangs_on)
					at = ids.size();
				names.push_back(o.name);
				ids.push_back(o.id);
			}
		}
		hc = field(box, "Hangs on").combobox().items(names).selected(at).anchor(0);
		hc.tooltip("An object of the stage (a panel, a truss) the LEDs move with: Position and Turn are then from that object");
		hc.on_change([this, g, ids](i, text) {
			if(i >= 0 && i < ids.size()) {
				g.place3d.hangs_on = ids[i];
				this.changed(false);
			}
		});
		//its size on the stage, from the LEDs as they are now
		leds = [];
		if(build_data) {
			for(sg : ledmap_stage_groups(scenes, build_data)) {
				if(sg.id == g.id)
					leds = sg.leds;
			}
		}
		if(leds.size()) {
			aspect = size_x.value() / math.max(1.0, std.float(size_y.value()));
			ext = stage_leds_extent([leds = leds, place = pl], aspect);
			hint(box, "On the stage: " + (math.round(ext.width * 100.0) / 100.0) + " × " + (math.round(ext.height * 100.0) / 100.0) + " m");
		}
	}

	build_segment_inspector(box, seg, g) {
		title(box, "Segment");
		name_field(box, seg);

		leds = field(box, "LEDs").intbox().anchor(0).min_value(1).max_value(8192).value(seg.width);
		leds.tooltip("LEDs along the segment (of one row)");
		leds.value_callback([this, seg](v) {
			seg.width = v;
			this.changed(true);
		});
		rows = field(box, "Rows").intbox().anchor(0).min_value(1).max_value(1024).value(seg.height);
		rows.tooltip("More than 1: a matrix, the rows side by side across the segment");
		rows.value_callback([this, seg](v) {
			seg.height = v;
			this.changed(true);
		});
		//#980: a scanned segment (shape "points") has as many LEDs as the camera found places, one row; Line or Curve
		//makes it a straight strip again (its points are gone)
		scanned = seg.shape == "points";
		if(scanned) {
			leds.enabled(false);
			rows.enabled(false);
			leds.tooltip("Scanned: one LED per place the camera scan found (Camera scan on the left)");
		}
		shape = field(box, "Shape").combobox().items(scanned ? [LM_SHAPES[0], LM_SHAPES[1], "Scanned"] : LM_SHAPES).selected(scanned ? 2 : (seg.shape == "curve" ? 1 : 0)).anchor(0);
		shape.on_change([this, seg](index, text) {
			if(index == 2)
				return;
			was_scanned = seg.shape == "points";
			if(index == 1 && seg.shape != "curve") {
				d = ledmap_vec(seg.end_pos) - ledmap_vec(seg.start_pos);
				seg.control = [x = (seg.start_pos.x + seg.end_pos.x) / 2.0 + d.y * 0.25, y = (seg.start_pos.y + seg.end_pos.y) / 2.0 - d.x * 0.25];
			}
			seg.shape = index == 1 ? "curve" : "line";
			seg.points = [];
			this.changed(false, was_scanned);
		});

		row = box.widget().fixed_height(LM_ROW + 2);
		rev = row.pushbutton("Reverse").anchor_left(0).fixed_width(126).fixed_height(LM_ROW).pushed(seg.reversed ? true : false);
		rev.tooltip("The data starts at the other end (R)");
		rev.on_change([this, seg](v) {
			seg.reversed = v ? 1 : 0;
			this.changed(false);
		});
		serp = row.pushbutton("Zigzag rows").anchor_left(130).anchor_right(0).fixed_height(LM_ROW).pushed(seg.serpentine ? true : false);
		serp.tooltip("Matrix: every second row runs back (serpentine), as most LED panels are wired");
		serp.enabled(seg.height > 1);
		serp.on_change([this, seg](v) {
			seg.serpentine = v ? 1 : 0;
			this.changed(false);
		});

		order = field(box, "Colours").combobox().items(LEDMAP_RGB_TYPES).selected(seg.rgb_type).anchor(0);
		order.tooltip("The order of the colour channels of the LEDs (WS2812 strips are often GRB). Single channel: one dimmer channel per LED.");
		order.on_change([this, seg](index, text) {
			seg.rgb_type = index;
			this.changed(false);
		});
		white = box.pushbutton("White channel (RGBW)").fixed_height(LM_ROW).pushed(seg.is_rgbw ? true : false);
		white.tooltip("The LEDs have a fourth channel for white: 4 channels per LED");
		white.on_change([this, seg](v) {
			seg.is_rgbw = v ? 1 : 0;
			this.changed(false);
		});

		title(box, "Address");
		own = seg.universe >= 0 || seg.channel >= 0;
		lamp_combo(field(box, "Lamp"), seg.target, [this, seg](id) {
			seg.target = id;
			lamp = ledmap_fixture_address(this.engine.patch, id);
			if(lamp) {
				seg.width = lamp.pixels;
				seg.height = 1;
				seg.is_rgbw = lamp.rgbw ? 1 : 0;
			}
			this.changed(true, true);
		});
		if(!seg.target) {
			own_btn = box.pushbutton("Own address").fixed_height(LM_ROW).pushed(own);
			own_btn.tooltip("Off: this segment starts after the one before in its group. On: at the universe and address below; the next ones follow it.");
			own_btn.on_change([this, seg](v) {
				if(v) {
					sl = this.slot_of(this.sel_scene, this.sel_group, this.sel_segment);
					seg.universe = sl ? sl.start.universe : 0;
					seg.channel = sl ? sl.start.channel : 0;
				}
				else {
					seg.universe = -1;
					seg.channel = -1;
				}
				this.changed(false, true);
			});
			if(own) {
				uni = field(box, "Universe").intbox().anchor(0).min_value(0).max_value(32767).value(math.max(0, seg.universe));
				uni.value_callback([this, seg](v) {
					seg.universe = v;
					this.changed(false);
				});
				adr = field(box, "Address").intbox().anchor(0).min_value(1).max_value(512).value(math.max(0, seg.channel) + 1);
				adr.value_callback([this, seg](v) {
					seg.channel = v - 1;
					this.changed(false);
				});
			}
		}

		row = box.widget().fixed_height(LM_ROW + 2);
		dup = row.button("Duplicate").icon(nanogui.icon("copy")).anchor_left(0).fixed_width(126).fixed_height(LM_ROW);
		dup.tooltip("Ctrl+D");
		dup.on_click([this]() { this.duplicate_selected(); });
		save_btn = row.button("Preset").icon(nanogui.icon("save")).anchor_left(130).anchor_right(0).fixed_height(LM_ROW);
		save_btn.tooltip("Save this segment as a preset (Library on the left)");
		save_btn.on_click([this, seg]() { this.save_preset("segment", seg); });
		rem = box.button("Remove segment").icon(nanogui.icon("trash")).fixed_height(LM_ROW).danger(true);
		rem.tooltip("Delete");
		rem.on_click([this]() { this.remove_selected(); });
	}

	mirror(g, along_x) {
		for(i = 0; i < g.segments.size(); i++) {
			seg = g.segments[i];
			pts = ledmap_segment_movable(seg);
			for(j = 0; j < pts.size(); j++) {
				if(along_x)
					pts[j].x = 1.0 - pts[j].x;
				else
					pts[j].y = 1.0 - pts[j].y;
			}
		}
		changed(false);
	}

	slot_of(si, gi, k) {
		if(!build_data)
			return None;
		for(i = 0; i < build_data.slots.size(); i++) {
			s = build_data.slots[i];
			if(s.scene == si && s.group == gi && s.segment == k)
				return s;
		}
		return None;
	}

	// =========================================================================
	// Building and sending
	// =========================================================================

	rebuild() {
		ledmap_normalize(scenes);
		build_data = ledmap_build(scenes, engine.patch);
		build_dirty = false;
		gains_dirty = true;
		devices_cache = [];

		own_overlaps = ledmap_overlaps(build_data);
		//what is sent now, for the fixture setup and the other LEDMappers
		dmx_publish(engine, gen.ai_interface.registry_id, "LEDMapper", ledmap_dmx_ranges(scenes, build_data),
			gen.ai_interface.registry_id, gen);
		//the groups with a place on the stage (#980): the 3D views draw their LEDs in the colours sent
		publish_stage();
		check_conflicts(false);

		total = math.max(1, build_data.total);
		apply_stage_colors();
		coords = build_data.coords;
		if(!build_data.total)
			coords = [0.0, 0.0, 1.0, 0.0];
		coords_tex.size(vec2i(total, 1));
		coords_tex.upload_data(coords);
		led_shader.render_size(vec2i(total, 1));
		update_status();
		update_info();
	}

	//Segments on the same channels: of this LEDMapper (own_overlaps) and with the lamps of the fixture setup or other
	//LEDMappers (the DMX registry). refresh: the status and the inspector follow
	check_conflicts(refresh = true) {
		seen_dmx_state = dmx_state(engine);
		overlap_slots = [];
		for(i = 0; i < own_overlaps.size(); i++) {
			if(!overlap_slots.has_value(own_overlaps[i].a))
				overlap_slots.push_back(own_overlaps[i].a);
			if(!overlap_slots.has_value(own_overlaps[i].b))
				overlap_slots.push_back(own_overlaps[i].b);
		}
		ext_problems = dmx_problems_of(engine, engine.patch, gen.ai_interface.registry_id);
		for(i = 0; i < ext_problems.size(); i++) {
			slot = std.int(ext_problems.key(i));
			if(!overlap_slots.has_value(slot))
				overlap_slots.push_back(slot);
		}
		if(refresh) {
			update_status();
			update_info();
		}
	}

	upload_gains() {
		gains_dirty = false;
		//The blackout (engine/blackout.shio) scales every pixel, the test light too
		//Not `?? 1.0`: ?? goes by truth, so a full blackout (the master 0.0, #670) reads as missing, and
		//has() alone hands back a None value: both guards, the key present and not None (#570, #670)
		master = engine.env.has("output_master") && !std.is_none(engine.env.output_master) ? engine.env.output_master : 1.0;
		uploaded_master = master;
		list = [];
		slots = build_data ? build_data.slots : [];
		for(i = 0; i < slots.size(); i++) {
			s = slots[i];
			if(test_on) {
				lit = sel_scene < 0 || (s.scene == sel_scene && (sel_group < 0 || s.group == sel_group) && (sel_segment < 0 || s.segment == sel_segment));
				list.push_back(0.0);
				list.push_back(lit ? master : 0.0);
				list.push_back(1.0);
				list.push_back(0.0);
			}
			else {
				list.push_back(s.gain * master);
				list.push_back(0.0);
				list.push_back(0.0);
				list.push_back(0.0);
			}
		}
		if(!list.size())
			list = [0.0, 0.0, 0.0, 0.0];
		gains_tex.size(vec2i(math.max(1, slots.size()), 1));
		gains_tex.upload_data(list);
	}

	device(node) {
		if(!node)
			return None;
		dev = devices_cache[node] ?? None;
		if(!dev) {
			dev = engine.net.find_artnet_device(node);
			if(dev)
				devices_cache[node] = dev;
		}
		return dev;
	}

	update() {
		//A lamp of the setup moved to another address: follow it
		if(engine.patch_revision != seen_patch_rev) {
			seen_patch_rev = engine.patch_revision;
			build_dirty = true;
		}
		//#980: an object of the stage that LEDs hang on moved: their places, the projections, the 3D effect again
		if(engine.stage_revision != seen_stage_rev) {
			seen_stage_rev = engine.stage_revision;
			if(engine.stage_leds.has(gen.ai_interface.registry_id))
				build_dirty = true;
		}
		tick_effect();
		if(build_dirty) {
			rebuild();
			return;
		}
		//a lamp of the setup or another LEDMapper changed, or one was switched on or off
		if(dmx_state(engine) != seen_dmx_state)
			check_conflicts();
		//the gains follow the masters each frame (cheap): they are linked and move all the time
		if(gains_dirty || !test_on || (engine.env.has("output_master") && !std.is_none(engine.env.output_master) ? engine.env.output_master : 1.0) != uploaded_master)
			upload_gains();

		buffer = led_shader.pixel_buffer();
		//#980: while a camera scan runs only the LED it lights
		if(scan && scan.running())
			buffer = scan_frame();
		if(!buffer || !build_data)
			return;
		for(i = 0; i < build_data.runs.size(); i++) {
			r = build_data.runs[i];
			dev = device(r.node);
			if(!dev)
				continue;
			dev.set_artnet_buffer(r.universe, r.channel, buffer, r.offset * 3, r.count * 3, r.wrap ? true : false, 3, r.out);
		}
	}

	update_status() {
		if(!build_data || !status_label)
			return;
		nodes = [];
		for(i = 0; i < build_data.slots.size(); i++) {
			s = build_data.slots[i];
			if(s.node && !nodes.has(s.node))
				nodes[s.node] = true;
		}
		text = build_data.total + " LEDs · " + build_data.slots.size() + (build_data.slots.size() == 1 ? " segment · " : " segments · ") + nodes.size() + (nodes.size() == 1 ? " node" : " nodes");
		if(overlap_slots.size()) {
			text += " · " + overlap_slots.size() + (overlap_slots.size() == 1 ? " segment" : " segments") + " on the same channels";
			status_label.text_color(PAL_DANGER);
		}
		else
			status_label.text_color(PAL_TEXT_2);
		status_label.caption(text);
	}

	// =========================================================================
	// Canvas: coordinates
	// =========================================================================

	canvas_size() {
		s = canvas.size();
		return vec2f(math.max(1, s.x), math.max(1, s.y));
	}

	to_px(uv) {
		s = canvas_size();
		return vec2f(uv.x * s.x, uv.y * s.y);
	}

	to_uv(pos) {
		s = canvas_size();
		return vec2f(pos.x / s.x, pos.y / s.y);
	}

	snap_uv(uv) {
		if(!snap_on)
			return uv;
		n = math.max(1, grid_div);
		return vec2f(math.round(uv.x * n) / n, math.round(uv.y * n) / n);
	}

	//From the picture into the coordinates of the segments of a group (the inverse of its transform)
	untransform(g, uv) {
		u_min = g.transform_uv[0].x;
		v_min = g.transform_uv[0].y;
		u_max = g.transform_uv[2].x;
		v_max = g.transform_uv[2].y;
		a = -g.transform_angle * math.PI / 180.0;
		cx = (u_min + u_max) * 0.5;
		cy = (v_min + v_max) * 0.5;
		dx = uv.x - cx;
		dy = uv.y - cy;
		u = cx + dx * math.cos(a) - dy * math.sin(a);
		v = cy + dx * math.sin(a) + dy * math.cos(a);
		w = u_max - u_min;
		h = v_max - v_min;
		return vec2f(w != 0.0 ? (u - u_min) / w : 0.0, h != 0.0 ? (v - v_min) / h : 0.0);
	}

	//Pixel position of a point of a segment of group g
	seg_px(g, p) {
		return to_px(ledmap_transform(g, vec2f(p.x, p.y)));
	}

	//Distance in pixels from pos to the path of a segment
	seg_distance(g, seg, pos) {
		steps = ledmap_path_steps(seg);
		best = 1000000.0;
		prev = to_px(ledmap_transform(g, ledmap_path_point(seg, 0.0)));
		for(i = 1; i <= steps; i++) {
			cur = to_px(ledmap_transform(g, ledmap_path_point(seg, i / std.float(steps))));
			best = math.min(best, ledmap_point_line_distance(prev, cur, pos));
			prev = cur;
		}
		//a matrix is as wide as it is long
		if(seg.height > 1) {
			half = (seg_px(g, seg.end_pos) - seg_px(g, seg.start_pos)).length() / 2.0;
			best = math.max(0.0, best - half);
		}
		return best;
	}

	//[scene, group, segment] under pos: the selected group first, then the selected scene, then all
	hit_segment(pos) {
		best = None;
		best_d = LM_HIT * ui;
		for(si = 0; si < scenes.size(); si++) {
			sc = scenes[si];
			for(gi = 0; gi < sc.groups.size(); gi++) {
				g = sc.groups[gi];
				for(k = 0; k < g.segments.size(); k++) {
					d = seg_distance(g, g.segments[k], pos);
					//the selection wins when it is as close
					if(si == sel_scene && gi == sel_group)
						d -= 2.0 * ui;
					if(d < best_d) {
						best_d = d;
						best = [scene = si, group = gi, segment = k];
					}
				}
			}
		}
		return best;
	}

	// =========================================================================
	// Canvas: mouse and keys
	// =========================================================================

	set_tool(name) {
		tool_name = name;
		for(i = 0; i < tool_buttons.size(); i++)
			tool_buttons[i].pushed(tool_buttons.key(i) == name);
	}

	mouse_button(pos, button, down, mods) {
		//the right mouse button ends drawing: back to Select
		if(button == 1 && down && tool_name != "select") {
			set_tool("select");
			drag = None;
			return true;
		}
		if(button != 0)
			return false;
		p = vec2f(pos.x, pos.y);
		if(down) {
			drag = [mode = "", start = p, last = p, moved = false];
			if(tool_name == "line" || tool_name == "curve") {
				drag.mode = "draw";
				drag.a = snap_uv(to_uv(p));
				drag.b = drag.a;
				return true;
			}
			g = cur_group();
			if(tool_name == "transform") {
				if(!g)
					return true;
				drag.mode = "transform";
				drag.corner = -1;
				for(i = 0; i < 4; i++) {
					c = to_px(vec2f(g.transform_uv[i].x, g.transform_uv[i].y));
					if((c - p).length() < 12.0 * ui)
						drag.corner = i;
				}
				drag.uv = g.transform_uv.copy();
				return true;
			}
			//Select: handles of the selected segment first
			seg = cur_segment();
			if(seg) {
				//(a scanned segment, shape "points": its points come from the camera, it is only moved as a whole)
				handles = seg.shape == "points" ? [] : [["start", seg.start_pos], ["end", seg.end_pos]];
				if(seg.shape == "curve")
					handles.push_back(["control", seg.control]);
				for(i = 0; i < handles.size(); i++) {
					if((seg_px(g, handles[i][1]) - p).length() <= (LM_HANDLE + 4) * ui) {
						drag.mode = "handle";
						drag.handle = handles[i][0];
						return true;
					}
				}
			}
			hit = hit_segment(p);
			if(hit) {
				if(hit.scene != sel_scene || hit.group != sel_group || hit.segment != sel_segment)
					select(hit.scene, hit.group, hit.segment);
				drag.mode = "move";
			}
			else if(sel_segment >= 0)
				select(sel_scene, sel_group, -1);
			return true;
		}

		//up
		if(drag && drag.mode == "draw" && drag.moved) {
			g = cur_group();
			a = drag.a;
			b = drag.b;
			if(!g) {
				add_group();
				g = cur_group();
			}
			add_segment(untransform(g, a), untransform(g, b), tool_name == "curve" ? "curve" : "line");
			//after a curve: drag its handle
			if(tool_name == "curve")
				set_tool("select");
		}
		else if(drag && drag.moved && drag.mode != "")
			changed(false, false);
		drag = None;
		return true;
	}

	mouse_drag(pos, rel, button, mods) {
		if(!drag)
			return false;
		p = vec2f(pos.x, pos.y);
		if((p - drag.start).length() > 3.0 * ui)
			drag.moved = true;
		if(drag.mode == "draw") {
			drag.b = snap_uv(to_uv(p));
			return true;
		}
		g = cur_group();
		if(!g)
			return true;
		if(drag.mode == "transform") {
			d = to_uv(p) - to_uv(drag.start);
			uv = drag.uv.copy();
			c = drag.corner;
			if(c < 0) {
				for(i = 0; i < 4; i++) {
					uv[i].x += d.x;
					uv[i].y += d.y;
				}
			}
			else {
				//the corner and the sides it touches; the opposite corner stays
				uv[c].x += d.x;
				uv[c].y += d.y;
				xs = c == 0 || c == 3 ? [0, 3] : [1, 2];
				ys = c == 0 || c == 1 ? [0, 1] : [2, 3];
				for(i = 0; i < 2; i++) {
					uv[xs[i]].x = uv[c].x;
					uv[ys[i]].y = uv[c].y;
				}
			}
			for(i = 0; i < 4; i++) {
				q = snap_uv(vec2f(uv[i].x, uv[i].y));
				uv[i].x = q.x;
				uv[i].y = q.y;
			}
			g.transform_uv = uv;
			build_dirty = true;
			return true;
		}
		seg = cur_segment();
		if(!seg)
			return true;
		now = untransform(g, snap_uv(to_uv(p)));
		if(drag.mode == "handle") {
			target = drag.handle == "start" ? seg.start_pos : (drag.handle == "end" ? seg.end_pos : seg.control);
			target.x = math.clamp(now.x, 0.0, 1.0);
			target.y = math.clamp(now.y, 0.0, 1.0);
			build_dirty = true;
		}
		else if(drag.mode == "move") {
			before = untransform(g, snap_uv(to_uv(drag.last)));
			d = now - before;
			if(d.x != 0.0 || d.y != 0.0) {
				pts = ledmap_segment_movable(seg);
				for(i = 0; i < pts.size(); i++) {
					pts[i].x = pts[i].x + d.x;
					pts[i].y = pts[i].y + d.y;
				}
				drag.last = p;
				build_dirty = true;
			}
		}
		return true;
	}

	key(key, action, mods) {
		if(action != 1)
			return false;
		if(key == LM_KEY_DELETE || key == LM_KEY_BACKSPACE) {
			remove_selected();
			return true;
		}
		if(key == LM_KEY_ESCAPE) {
			//a drawing tool goes back to Select first
			if(tool_name != "select")
				set_tool("select");
			else
				select(-1, -1, -1);
			return true;
		}
		if(key == LM_KEY_LEFT || key == LM_KEY_RIGHT || key == LM_KEY_UP || key == LM_KEY_DOWN) {
			dx = key == LM_KEY_LEFT ? -1 : (key == LM_KEY_RIGHT ? 1 : 0);
			dy = key == LM_KEY_UP ? -1 : (key == LM_KEY_DOWN ? 1 : 0);
			return nudge(dx, dy, (mods & LM_MOD_SHIFT) ? true : false);
		}
		if((mods & LM_MOD_CTRL) && key == LM_KEY_D) {
			duplicate_selected();
			return true;
		}
		if(mods & LM_MOD_CTRL)
			return false;
		if(key == LM_KEY_V)
			set_tool("select");
		else if(key == LM_KEY_L)
			set_tool("line");
		else if(key == LM_KEY_C)
			set_tool("curve");
		else if(key == LM_KEY_T)
			set_tool("transform");
		else if(key == LM_KEY_R && cur_segment()) {
			seg = cur_segment();
			seg.reversed = seg.reversed ? 0 : 1;
			changed(false, true);
		}
		else
			return false;
		return true;
	}

	//The selected segment (or group) a step to the side (arrow keys): a cell of the grid with Snap, else a pixel (Shift:
	//ten pixels)
	nudge(dx, dy, big) {
		g = cur_group();
		if(!g)
			return false;
		s = canvas_size();
		step = snap_on ? vec2f(1.0 / math.max(1, grid_div), 1.0 / math.max(1, grid_div)) : vec2f(1.0 / s.x, 1.0 / s.y);
		if(big && !snap_on)
			step = step * 10.0;
		d = vec2f(dx * step.x, dy * step.y);
		seg = cur_segment();
		if(seg) {
			//in the coordinates of the segment (before the transform of its group)
			o = untransform(g, vec2f(0.5, 0.5));
			m = untransform(g, vec2f(0.5 + d.x, 0.5 + d.y)) - o;
			pts = ledmap_segment_movable(seg);
			for(i = 0; i < pts.size(); i++) {
				pts[i].x = pts[i].x + m.x;
				pts[i].y = pts[i].y + m.y;
			}
		}
		else {
			for(i = 0; i < 4; i++) {
				g.transform_uv[i].x = g.transform_uv[i].x + d.x;
				g.transform_uv[i].y = g.transform_uv[i].y + d.y;
			}
		}
		build_dirty = true;
		return true;
	}

	// =========================================================================
	// Canvas: drawing
	// =========================================================================

	draw_grid() {
		s = canvas_size();
		n = math.max(1, grid_div);
		nvgBeginPath();
		for(i = 0; i <= n; i++) {
			x = s.x * i / n;
			y = s.y * i / n;
			nvgMoveTo(vec2f(x, 0));
			nvgLineTo(vec2f(x, s.y));
			nvgMoveTo(vec2f(0, y));
			nvgLineTo(vec2f(s.x, y));
		}
		nvgStrokeColor(snap_on ? PAL_LINE_STRONG : PAL_LINE);
		nvgStrokeWidth(ui);
		nvgStroke();
	}

	//One segment from the last build: its rows as lines, LEDs as dots when there is room, the first LED and the direction
	draw_slot(slot, color, width, is_selected, g, seg) {
		n = slot.count;
		if(!n)
			return;
		leds = slot.leds;
		rows = math.max(1, seg.height);
		per_row = math.max(1, seg.width);
		//a matrix: the rows thinner than the space between them
		limit = 1000000.0;
		if(rows > 1 && n >= 2 * per_row) {
			//the LED of the second row next to the first LED (rows stay blocks of per_row, also reversed)
			neighbour = seg.serpentine ? 2 * per_row - 1 : per_row;
			limit = (to_px(leds[neighbour]) - to_px(leds[0])).length() * 0.45;
		}
		width = math.min(width * ui, limit) / ui;
		//all rows in one path: one draw call (#690). They do not overlap (limit), so an alpha colour stays even
		s = canvas_size();
		nvgBeginPath();
		for(r = 0; r < rows; r++) {
			first = r * per_row;
			last = math.min(n, first + per_row) - 1;
			if(first > last)
				continue;
			step = math.max(1, std.int(per_row / 48));
			nvgMoveTo(vec2f(leds[first].x * s.x, leds[first].y * s.y));
			for(i = first + step; i < last; i += step)
				nvgLineTo(vec2f(leds[i].x * s.x, leds[i].y * s.y));
			nvgLineTo(vec2f(leds[last].x * s.x, leds[last].y * s.y));
		}
		nvgStrokeColor(color);
		nvgStrokeWidth(width * ui);
		nvgLineCap(1);
		nvgStroke();
		//dots when they are at least 5 px apart, all of a slot in one stroke (#690: a fill per dot was a draw call each,
		//6000 LEDs took 166 ms a frame instead of 67 under software GL; one fill of many circles needs a stencil, which
		//the framebuffer of the shader has not)
		if(n > 1 && n <= 600) {
			gap = (to_px(leds[1]) - to_px(leds[0])).length();
			if(gap >= 5.0 * ui) {
				dot = math.min(math.min(3.0 * ui, gap / 3.0), limit * 0.6);
				nvgStrokeColor(is_selected ? PAL_TEXT : vec4f(0.0, 0.0, 0.0, 0.5));
				nvgStrokeDots(leds, dot, s);
			}
		}
		//the first LED (where the data comes in) and the direction
		p0 = to_px(leds[0]);
		nvgBeginPath();
		nvgCircle(p0, (width * 0.5 + 3.0) * ui);
		nvgFillColor(color);
		nvgFill();
		nvgStrokeColor(PAL_CANVAS);
		nvgStrokeWidth(1.5 * ui);
		nvgStroke();
		if(n >= 2) {
			mid = std.int(math.min(n, per_row) / 2);
			a = to_px(leds[math.max(0, mid - 1)]);
			b = to_px(leds[math.min(n - 1, mid + 1)]);
			d = b - a;
			if(d.length() > 0.5) {
				d.normalize();
				m = (a + b) / 2.0;
				side = vec2f(d.y, 0.0 - d.x);
				nvgBeginPath();
				nvgMoveTo(m + d * (7.0 * ui));
				nvgLineTo(m - d * (5.0 * ui) + side * (6.0 * ui));
				nvgLineTo(m - d * (5.0 * ui) - side * (6.0 * ui));
				nvgClosePath();
				nvgFillColor(is_selected ? PAL_CANVAS : PAL_TEXT);
				nvgFill();
			}
		}
	}

	draw_handles(g, seg) {
		ps = seg_px(g, seg.start_pos);
		pe = seg_px(g, seg.end_pos);
		if(seg.shape == "curve") {
			pc = seg_px(g, seg.control);
			nvgBeginPath();
			nvgMoveTo(ps);
			nvgLineTo(pc);
			nvgLineTo(pe);
			nvgStrokeColor(pal_alpha(PAL_ACCENT, 0.6));
			nvgStrokeWidth(ui);
			nvgStroke();
			hs = LM_HANDLE * ui;
			nvgBeginPath();
			nvgRect(vec2f(pc.x - hs, pc.y - hs), vec2f(hs * 2, hs * 2));
			nvgFillColor(PAL_CANVAS);
			nvgFill();
			nvgStrokeColor(PAL_ACCENT);
			nvgStrokeWidth(2.0 * ui);
			nvgStroke();
		}
		pts = [ps, pe];
		for(i = 0; i < 2; i++) {
			nvgBeginPath();
			nvgCircle(pts[i], LM_HANDLE * ui);
			nvgFillColor(i == 0 ? PAL_ACCENT : PAL_CANVAS);
			nvgFill();
			nvgStrokeColor(PAL_ACCENT);
			nvgStrokeWidth(2.0 * ui);
			nvgStroke();
		}
	}

	draw_transform(g) {
		nvgBeginPath();
		c0 = to_px(vec2f(g.transform_uv[0].x, g.transform_uv[0].y));
		nvgMoveTo(c0);
		for(i = 1; i < 4; i++)
			nvgLineTo(to_px(vec2f(g.transform_uv[i].x, g.transform_uv[i].y)));
		nvgClosePath();
		nvgStrokeColor(PAL_CUE);
		nvgStrokeWidth(2.0 * ui);
		nvgStroke();
		for(i = 0; i < 4; i++) {
			nvgBeginPath();
			nvgCircle(to_px(vec2f(g.transform_uv[i].x, g.transform_uv[i].y)), 6.0 * ui);
			nvgFillColor(PAL_CUE);
			nvgFill();
		}
	}

	draw() {
		ui = 1.0 / math.max(0.05, canvas_scroll.scale());
		draw_grid();
		//An empty layout: what to do (#655)
		if(!scenes.size() && !(drag && drag.mode == "draw")) {
			s = canvas_size();
			text = tool_name == "line" || tool_name == "curve" ? "Drag on the picture to draw a strip of LEDs" : "Choose Line (L) or Curve (C), then drag on the picture";
			pal_badge(vec2f(s.x / 2.0, s.y / 2.0), text, pal_alpha(PAL_RAISED, 0.92), PAL_TEXT, 14 * ui);
			pal_badge(vec2f(s.x / 2.0, s.y / 2.0 + 26 * ui), "or click a preset in the Library on the left", pal_alpha(PAL_RAISED, 0.92), PAL_TEXT_2, 12 * ui);
		}
		if(!build_data)
			return;
		//sent segments, from the last build
		for(i = 0; i < build_data.slots.size(); i++) {
			slot = build_data.slots[i];
			//the build can be a frame older than the layout (a segment was just removed)
			if(slot.scene >= scenes.size() || slot.group >= scenes[slot.scene].groups.size() ||
				slot.segment >= scenes[slot.scene].groups[slot.group].segments.size())
				continue;
			g = scenes[slot.scene].groups[slot.group];
			seg = g.segments[slot.segment];
			is_selected = slot.scene == sel_scene && slot.group == sel_group && slot.segment == sel_segment;
			in_group = slot.scene == sel_scene && slot.group == sel_group;
			color = pal_hue(slot.scene * 7 + slot.group, slot.scene == sel_scene || sel_scene < 0 ? 0.9 : 0.35);
			if(overlap_slots.has_value(i))
				color = PAL_DANGER;
			if(in_group && !is_selected)
				color = pal_alpha(PAL_TEXT, 0.85);
			if(is_selected)
				color = PAL_ACCENT;
			draw_slot(slot, color, is_selected ? 6.0 : 4.0, is_selected, g, seg);
			if(labels_on && (in_group || sel_group < 0)) {
				m = to_px(slot.leds[std.int(slot.count / 2)]);
				pal_badge(vec2f(m.x, m.y - 16 * ui), ledmap_address_text(slot.start) + " – " + ledmap_address_text(slot.last),
					is_selected ? PAL_ACCENT : pal_alpha(PAL_RAISED, 0.9), is_selected ? PAL_CANVAS : PAL_TEXT_2, 11 * ui);
			}
		}
		//switched off: only their path, faint
		for(si = 0; si < scenes.size(); si++) {
			sc = scenes[si];
			for(gi = 0; gi < sc.groups.size(); gi++) {
				g = sc.groups[gi];
				if(sc.enabled && g.enabled)
					continue;
				for(k = 0; k < g.segments.size(); k++) {
					seg = g.segments[k];
					nvgBeginPath();
					nvgMoveTo(seg_px(g, ledmap_path_point(seg, 0.0)));
					steps = ledmap_path_steps(seg);
					for(t = 1; t <= steps; t++)
						nvgLineTo(seg_px(g, ledmap_path_point(seg, t / std.float(steps))));
					nvgStrokeColor(PAL_LINE_STRONG);
					nvgStrokeWidth(3.0 * ui);
					nvgStroke();
				}
			}
		}
		g = cur_group();
		seg = cur_segment();
		if(seg && tool_name != "transform")
			draw_handles(g, seg);
		if(g && tool_name == "transform")
			draw_transform(g);
		if(drag && drag.mode == "draw" && drag.moved) {
			a = to_px(drag.a);
			b = to_px(drag.b);
			nvgBeginPath();
			nvgMoveTo(a);
			if(tool_name == "curve") {
				d = drag.b - drag.a;
				c = to_px(vec2f((drag.a.x + drag.b.x) / 2.0 + d.y * 0.25, (drag.a.y + drag.b.y) / 2.0 - d.x * 0.25));
				nvgQuadTo(c, b);
			}
			else
				nvgLineTo(b);
			nvgStrokeColor(PAL_ON);
			nvgStrokeWidth(4.0 * ui);
			nvgStroke();
		}
		if(test_on) {
			s = canvas_size();
			pal_badge(vec2f(80 * ui, 16 * ui), "TEST: selection white", PAL_CUE, PAL_CANVAS, 12 * ui);
		}
	}

	// =========================================================================
	// UI
	// =========================================================================

	build_ui(area) {
		gen.window.fixed_size(vec2f(1400, 880));
		area.layout(None);

		left = area.widget().anchor_left(0).anchor_top(0).anchor_bottom(30).fixed_width(LM_LEFT_W);
		right = area.widget().anchor_right(0).anchor_top(0).anchor_bottom(30).fixed_width(LM_RIGHT_W);
		center = area.widget().anchor_left(LM_LEFT_W + 4).anchor_right(LM_RIGHT_W + 4).anchor_top(0).anchor_bottom(30);
		center_holder = center;

		in_ctrl = area.control("IN").caption("In").anchor_left(0).anchor_bottom(0).fixed_height(30).fixed_width(LM_LEFT_W);
		out_ctrl = area.control("OUT").caption("Out").anchor_right(0).anchor_bottom(0).fixed_height(30).fixed_width(LM_RIGHT_W).as_output(true);

		//Left: settings, outliner, library
		left_content = left.vscroll().anchor(0).content().layout(nanogui.layout_vertical()).fixed_width(LM_LEFT_W - 12);
		title(left_content, "Input");
		select_video_router = left_content.combobox().items(["Select input"]).fixed_height(LM_ROW);
		select_video_router.tooltip("The picture the LEDs take their colours from: every shader, video or receiver with its Video router on");
		select_video_router.on_open([select_video_router]() {
			routers = get_video_routers();
			items = ["Select input"];
			for(i = 0; i < routers.size(); i++)
				items.push_back(routers[i].name);
			select_video_router.items(items);
		});
		select_video_router.on_change([this](index, text) {
			routers = get_video_routers();
			index--;
			if(index < 0 || index >= routers.size()) {
				this.in_ctrl.clear_incoming_links();
				this.in_ctrl.value(None);
			}
			else {
				routers[index].output_ctrl.link_to(this.in_ctrl);
				this.in_ctrl.value(routers[index].output_ctrl.value());
			}
		});
		size_x = left_content.controlint("Width", "settings").value(engine.project_width.value()).fixed_height(LM_ROW);
		size_x.tooltip("Width of the picture the LEDs are drawn on, in pixels");
		size_y = left_content.controlint("Height", "settings").value(engine.project_height.value()).fixed_height(LM_ROW);
		radius = left_content.controlint("LED Radius").min(0).max(100).fixed_height(LM_ROW);
		radius.tooltip("0: each LED takes the pixel under it. More: the average of a circle of this many pixels (softer)");
		radius.callback([this](v) { this.led_shader.uniform("led_radius", v); });
		smoothing = left_content.controlslider("LED Smoothing").fixed_height(LM_ROW);
		smoothing.tooltip("Changes fade over a few frames");
		smoothing.callback([this](v) { this.led_shader.uniform("feedback_value", v); });
		analog = left_content.controlbutton("Analog Mode").push(true).fixed_height(LM_ROW);
		analog.tooltip("Smoothing like a light bulb: up quickly, down slowly");
		analog.callback([this](v) { this.led_shader.uniform("analog_mode", v); });

		//#980: the 3D effect of the groups on the stage whose Colours are "3D effect" (the box of their LEDs)
		title(left_content, "3D effect");
		fx_type = left_content.controlcombo("Effect", "effect3d").caption("Effect").items(["Plane sweep", "Sphere pulse", "Noise", "Rainbow"]).fixed_height(LM_ROW);
		fx_type.tooltip("For the groups on the stage whose Colours are 3D effect: a plane sweeping through them, rings from their middle, 3D noise, a rainbow along an axis\n[[wiki:Stage#colours-of-the-leds-on-the-stage]]");
		fx_type.callback([this](v) { this.led_shader.uniform("fx_type", std.int(v)); });
		fx_axis = left_content.controlcombo("Direction", "effect3d").caption("Direction").items(["Left to right", "Back to front", "Top to bottom"]).fixed_height(LM_ROW);
		fx_axis.callback([this](v) { this.led_shader.uniform("fx_axis", std.int(v)); });
		fx_speed = left_content.controlslider("Speed", "effect3d").fixed_height(LM_ROW).value(0.25);
		fx_speed.tooltip("How fast it moves: 0 stands still, 1 two passes a second");
		fx_size = left_content.controlslider("Size", "effect3d").fixed_height(LM_ROW).value(0.3);
		fx_size.tooltip("How wide the plane, the rings, the noise or the rainbow are, from a thin line to the whole arrangement");
		fx_size.callback([this](v) { this.led_shader.uniform("fx_size", v); });
		fx_hue_a = left_content.controlslider("Colour A", "effect3d").fixed_height(LM_ROW).value(0.6);
		fx_hue_a.tooltip("The colour of the plane, the rings, the bright noise (a hue: 0 red, 0.33 green, 0.66 blue)");
		fx_hue_a.callback([this](v) { this.led_shader.uniform("fx_hue_a", v); });
		fx_hue_b = left_content.controlslider("Colour B", "effect3d").fixed_height(LM_ROW).value(0.0);
		fx_hue_b.tooltip("The colour around them");
		fx_hue_b.callback([this](v) { this.led_shader.uniform("fx_hue_b", v); });

		//#980: the camera scan: one LED after the other lit, its place where a camera sees it
		title(left_content, "Camera scan");
		scan_cam_combo = left_content.combobox().items(["Pick a camera…"]).fixed_height(LM_ROW);
		scan_cam_combo.tooltip("A Camera generator (Generators › Input › Camera) that sees the LEDs from where the audience looks at them\n[[wiki:Output-and-Devices#camera-scan]]");
		scan_cam_combo.on_open([this]() { this.fill_scan_cameras(); });
		scan_cam_combo.on_change([this](index, text) {
			this.scan_camera = index > 0 && index - 1 < this.scan_cam_paths.size() ? this.scan_cam_paths[index - 1] : "";
		});
		scan_wait_box = field(left_content, "Wait (ms)").intbox().anchor(0).min_value(30).max_value(5000).value(LEDSCAN_WAIT_MS);
		scan_wait_box.tooltip("How long each LED is lit before the camera's picture counts: Art-Net, the camera and its buffer. More when LEDs are found in the wrong place (the one before)");
		fit_btn = left_content.pushbutton("Fit into the picture").fixed_height(LM_ROW).pushed(true);
		fit_btn.tooltip("On: the places found fill the picture (their proportions kept). Off: where they are in the camera's picture");
		fit_btn.on_change([this](v) { this.scan_fit = v ? true : false; });
		scan_btn = left_content.button("Scan the selection").fixed_height(LM_ROW);
		scan_btn.tooltip("Lights the LEDs of the selected segment (or of all segments of the selected group) one after the other and puts each where the camera sees it. Darken the room first");
		scan_btn.on_click([this]() {
			if(this.scan && this.scan.running())
				this.stop_scan();
			else {
				r = this.start_scan();
				if(!r.ok)
					this.show_scan_info(r.error);
			}
		});
		scan_info = left_content.label("").wrap(true).fixed_width(LM_LEFT_W - 16).text_color(PAL_TEXT_2);

		title(left_content, "Layout");
		outliner_holder = left_content.widget().layout(nanogui.layout_vertical());
		title(left_content, "Library");
		library_holder = left_content.widget().layout(nanogui.layout_vertical());

		//Right: inspector
		right_content = right.vscroll().anchor(0).content().layout(nanogui.layout_vertical()).fixed_width(LM_RIGHT_W - 12);
		inspector_holder = right_content.widget().layout(nanogui.layout_vertical());

		//Center: toolbar, LED strip, canvas, masters
		toolbar = center.widget().anchor_left(0).anchor_right(0).anchor_top(0).fixed_height(LM_TOOLBAR_H);
		x = 0;
		for(i = 0; i < LM_TOOLS.size(); i++) {
			t = LM_TOOLS[i];
			name = t[0];
			b = toolbar.pushbutton(t[1]).icon(nanogui.icon(t[2])).anchor_left(x).anchor_top(2).fixed_width(90).fixed_height(LM_ROW).latched_style("selection");
			b.tooltip(t[3]);
			b.pushed(name == tool_name);
			b.on_change([this, name](v) { this.set_tool(name); });
			tool_buttons[name] = b;
			x += 92;
		}
		x += 8;
		snap_btn = toolbar.pushbutton("Snap").icon(nanogui.icon("th")).anchor_left(x).anchor_top(2).fixed_width(74).fixed_height(LM_ROW).pushed(snap_on);
		snap_btn.tooltip("Ends snap to the grid");
		snap_btn.on_change([this](v) { this.snap_on = v; });
		x += 76;
		grid_box = toolbar.intbox().anchor_left(x).anchor_top(2).fixed_width(54).fixed_height(LM_ROW).min_value(1).max_value(128).value(grid_div);
		grid_box.tooltip("Grid: cells across the picture");
		grid_box.value_callback([this](v) { this.grid_div = v; });
		x += 62;
		test_btn = toolbar.pushbutton("Test").icon(nanogui.icon("crosshairs")).latched_style("cue").anchor_left(x).anchor_top(2).fixed_width(74).fixed_height(LM_ROW);
		test_btn.tooltip("Lights the selected [[led segment|segment]], group or scene white on the LEDs and everything else black, to find it in the rig\n[[wiki:Output-and-Devices#ledmapper]]");
		test_btn.on_change([this](v) {
			this.test_on = v;
			this.gains_dirty = true;
		});
		x += 76;
		labels_btn = toolbar.pushbutton("Addresses").icon(nanogui.icon("list_ol")).anchor_left(x).anchor_top(2).fixed_width(110).fixed_height(LM_ROW).pushed(labels_on);
		labels_btn.tooltip("Show the first and last DMX address of each segment");
		labels_btn.on_change([this](v) { this.labels_on = v; });
		x += 112;
		channels_btn = toolbar.pushbutton("Channels").icon(nanogui.icon("table")).anchor_left(x).anchor_top(2).fixed_width(110).fixed_height(LM_ROW).pushed(channels_on);
		channels_btn.tooltip("The 512 channels of the universe of the selection under the picture. Drag a segment there to other channels (the first segment of a group moves the group), or a lamp of the fixture setup");
		channels_btn.on_change([this](v) { this.show_channels(v); });


		coords_image = area.image().visible(false);
		coords_tex = coords_image.texture();
		coords_tex.pixel_format("rgba").component_format("float32").size(vec2i(1, 1));
		gains_image = area.image().visible(false);
		gains_tex = gains_image.texture();
		gains_tex.pixel_format("rgba").component_format("float32").size(vec2i(1, 1));
		gains_tex.upload_data([1.0, 0.0, 0.0, 0.0]);
		pos_image = area.image().visible(false);
		pos_tex = pos_image.texture();
		pos_tex.pixel_format("rgba").component_format("float32").size(vec2i(1, 1));
		pos_tex.upload_data([0.0, 0.0, 0.0, 0.0]);

		led_shader = center.shader().anchor_left(0).anchor_right(0).anchor_top(LM_TOOLBAR_H).fixed_height(LM_STRIP_H);
		led_shader.tooltip("What is sent: one pixel per LED, in the order of the data");
		led_shader.fragment_source(LM_LED_SHADER_SRC);
		led_shader.render_size(vec2i(1, 1));
		led_shader.keep_aspect_ratio(false);
		led_shader.pixel_readback(true);
		led_shader.output_component_format("uint8");
		led_shader.output_pixel_format("rgb");
		led_shader.input("feedback", led_shader);
		led_shader.input("led_coords", coords_image);
		led_shader.input("gains", gains_image);
		led_shader.input("led_pos", pos_image);
		//the 3D effect (#980) as its controls start (they set it again when they change or a project loads them)
		led_shader.uniform("fx_type", std.int(fx_type.value()));
		led_shader.uniform("fx_axis", std.int(fx_axis.value()));
		led_shader.uniform("fx_size", fx_size.value());
		led_shader.uniform("fx_hue_a", fx_hue_a.value());
		led_shader.uniform("fx_hue_b", fx_hue_b.value());
		led_shader.uniform("fx_time", 0.0);
		led_shader.uniform("fx_lo", vec3f(0.0, 0.0, 0.0));
		led_shader.uniform("fx_hi", vec3f(1.0, 1.0, 1.0));

		canvas_scroll = center.scrollarea().anchor_left(0).anchor_right(0).anchor_top(LM_TOOLBAR_H + LM_STRIP_H + 2).anchor_bottom(LM_MASTERS_H).fit_content();
		canvas_view = canvas_scroll.content();
		canvas = canvas_view.shader();
		canvas.fragment_source(LM_SHADER_SRC);
		led_shader.input("input", canvas);

		channels_area = center.widget().anchor_left(0).anchor_right(0).anchor_bottom(LM_MASTERS_H).fixed_height(LM_CHANNELS_H);
		chmap = channel_map(channels_area);
		chmap.provider = [this]() { return this.map_data(); };
		chmap.on_pick = [this](b, mods) { this.map_pick(b); };
		chmap.on_move = [this](b, delta) { this.map_move(b, delta); };
		chmap.on_universe = [this](d) {
			data = this.chmap.data;
			if(data && data.universe + d >= 0)
				this.map_shift = this.map_shift + d;
		};

		masters_holder = center.widget().anchor_left(0).anchor_right(0).anchor_bottom(0).fixed_height(LM_MASTERS_H);
		status_label = masters_holder.label("").anchor_right(4).anchor_top(0).fixed_height(LM_MASTERS_H).fixed_width(360).alignment("right");

		size_cb = [this](v) {
			this.canvas.render_size(vec2i(this.size_x.value(), this.size_y.value()));
			this.canvas_view.fixed_size(vec2i(this.size_x.value(), this.size_y.value()));
			this.canvas_view.size(this.canvas_view.fixed_size());
			this.canvas_view.refresh_layout();
			this.build_dirty = true;
		};
		size_x.callback(size_cb);
		size_y.callback(size_cb);
		size_cb(0);
		radius.value(0);
		smoothing.value(0.0);
		analog.value(0);

		canvas.on_mouse_button([this](pos, button, down, mods) { return this.mouse_button(pos, button, down, mods); });
		canvas.on_mouse_drag([this](pos, rel, button, mods) { return this.mouse_drag(pos, rel, button, mods); });
		canvas.on_keyboard([this](key, scancode, action, mods) { return this.key(key, action, mods); });
		canvas.on_draw([this]() { this.draw(); });

		in_ctrl.callback([this](v) { this.canvas.input("input", v); });
		out_ctrl.value(canvas);
		out_ctrl.callback([this](v) { this.out_ctrl.value(this.canvas); });

		//Presets dropped from the Assets tab: [config, kind] (kind by "type", the folder or the content)
		accepts = [](payload) {
			if(!payload.has("path"))
				return None;
			path = fileio.relative_path_cwd(payload.path);
			if(!std.string(path).ends(".json"))
				return None;
			config = fileio.read_json(path);
			kind = ledmap_preset_kind(config, ledmap_preset_kind_of_path(path));
			if(!kind)
				return None;
			return [config = config, kind = kind];
		};
		drop_targets = [left, right, canvas];
		for(i = 0; i < drop_targets.size(); i++) {
			drop_targets[i].on_dragdrop_hover([accepts](payload, pos) {
				return accepts(payload) ? true : false;
			});
			drop_targets[i].on_dragdrop([this, accepts](payload, pos) {
				found = accepts(payload);
				return found ? this.insert_preset(found.config, found.kind) : false;
			});
		}

		build_outliner();
		build_inspector();
		build_library();
		build_masters();
		show_channels(channels_on);
		set_tool("line"); //an empty layout: draw right away
	}

	// =========================================================================
	// Going away (#666)
	// =========================================================================

	//The widgets of the generator's window outlive this instance by at least one frame when the LEDMapper goes
	//away: closed with its x, a project loaded while it is open, the module reloaded. The picture and the
	//Channels map kept their draw callbacks, so every frame after it ran the draw of a freed instance and
	//logged "class not valid." twice (__init__.shio:1918 and channelmap.shio:39). Everything registered on
	//widgets this instance does not own goes off with it.
	__deinit__() noexcept {
		detach();
	}

	//#980: the colours of the groups on the stage: a projected LED samples the picture where the projection puts it
	//(build_data.coords), an LED of the 3D effect gets its place in led_pos (engine/stage/stage_leds.shio)
	apply_stage_colors() {
		total = math.max(1, build_data.total);
		groups = ledmap_stage_groups(scenes, build_data);
		aspect = size_x.value() / math.max(1.0, std.float(size_y.value()));
		c = stage_leds_colors(engine.stage, groups, aspect, total);
		for(i = 0; i < c.coords.size(); i++) {
			k = std.int(c.coords.key(i));
			if(k * 4 + 1 < build_data.coords.size()) {
				build_data.coords[k * 4] = c.coords[i].u;
				build_data.coords[k * 4 + 1] = c.coords[i].v;
			}
		}
		pos_tex.size(vec2i(total, 1));
		pos_tex.upload_data(c.pos);
		led_shader.uniform("fx_lo", vec3f(c.fx_lo.x, c.fx_lo.y, c.fx_lo.z));
		led_shader.uniform("fx_hi", vec3f(c.fx_hi.x, c.fx_hi.y, c.fx_hi.z));
	}

	//The 3D effect moves on by its speed (cycles a second) each frame
	tick_effect() {
		now = std.millis();
		dt = fx_last ? math.min(0.25, (now - fx_last) / 1000.0) : 0.0;
		fx_last = now;
		if(!fx_speed)
			return;
		fx_clock += dt * fx_speed.value() * 2.0;
		if(fx_clock > 10000.0)
			fx_clock -= 10000.0;
		led_shader.uniform("fx_time", fx_clock);
	}

	//The groups that are on the stage, for the 3D views (engine/stage/stage_leds.shio): their LEDs and this shader, whose
	//read-back has their colours
	publish_stage() {
		if(!build_data || !gen || !gen.ai_interface)
			return;
		aspect = size_x && size_y ? size_x.value() / math.max(1.0, std.float(size_y.value())) : 16.0 / 9.0;
		try {
			stage_leds_publish(engine, gen.ai_interface.registry_id, "LEDMapper", aspect, led_shader, ledmap_stage_groups(scenes, build_data));
		}
		catch(e) {}
	}

	detach() noexcept {
		try {
			if(gen && gen.ai_interface)
				stage_leds_remove(engine, gen.ai_interface.registry_id);
		}
		catch(e) {}
		if(chmap)
			chmap.detach();
		free_scan_gpu();
		if(canvas) {
			canvas.on_draw(None);
			canvas.on_mouse_button(None);
			canvas.on_mouse_drag(None);
			canvas.on_keyboard(None);
			canvas.on_dragdrop(None);
			canvas.on_dragdrop_hover(None);
		}
		//the controls of this UI: nanogui.serialize_controls()/.deserialize_controls() reach a control's
		//callback by name, and the toolbar buttons of a window that is closing can still be written to
		if(size_x)
			size_x.callback(None);
		if(size_y)
			size_y.callback(None);
		if(in_ctrl)
			in_ctrl.callback(None);
		if(out_ctrl)
			out_ctrl.callback(None);
		if(test_btn)
			test_btn.on_change(None);
		if(labels_btn)
			labels_btn.on_change(None);
		if(snap_btn)
			snap_btn.on_change(None);
		if(channels_btn)
			channels_btn.on_change(None);
		for(i = 0; i < tool_buttons.size(); i++)
			tool_buttons[i].on_change(None);
		for(k, v : masters)
			v.callback(None);
	}

	// =========================================================================
	// Channels: the universe of the selection, segments and lamps dragged to other channels (#655)
	// =========================================================================

	show_channels(v) {
		channels_on = v ? true : false;
		channels_btn.pushed(channels_on);
		channels_area.visible(channels_on);
		canvas_scroll.anchor_bottom(LM_MASTERS_H + (channels_on ? LM_CHANNELS_H + 2 : 0));
		center_holder.refresh_layout();
	}

	in_selection(s) {
		return s.scene == sel_scene && (sel_group < 0 || s.group == sel_group) && (sel_segment < 0 || s.segment == sel_segment);
	}

	//The segment and group of a slot of the last build, None when the layout changed since
	slot_items(s) {
		if(s.scene >= scenes.size() || s.group >= scenes[s.scene].groups.size() || s.segment >= scenes[s.scene].groups[s.group].segments.size())
			return None;
		g = scenes[s.scene].groups[s.group];
		return [scene = scenes[s.scene], group = g, segment = g.segments[s.segment]];
	}

	//What the channel map shows (channelmap.shio): the universe of the selection, its segments and the lamps on it
	map_data() {
		data = [node = "", universe = 0, title = "", blocks = [], cells = None,
			empty = "Channels: draw a segment, then give its group a node (or a lamp of the fixture setup)"];
		if(!build_data || !build_data.slots.size())
			return data;
		slots = build_data.slots;
		base = None;
		for(i = 0; i < slots.size() && !base; i++) {
			if(sel_scene >= 0 && in_selection(slots[i]))
				base = slots[i];
		}
		if(!base)
			base = slots[0];
		if(!base.node) {
			data.empty = "Channels: this group has no node yet (Node in the settings of the group)";
			return data;
		}
		node = base.node;
		universe = math.max(0, base.start.universe + map_shift);
		data.node = node;
		data.universe = universe;
		used = 0;
		for(i = 0; i < slots.size(); i++) {
			s = slots[i];
			items = slot_items(s);
			if(s.node != node || !items)
				continue;
			parts = ledmap_slot_ranges(s);
			for(k = 0; k < parts.size(); k++) {
				part = parts[k];
				if(part.universe != universe)
					continue;
				used += part.last - part.first + 1;
				on_lamp = items.segment.target || items.group.target;
				data.blocks.push_back([ref = i, first = part.first, last = part.last,
					label = items.scene.name + " › " + items.group.name + " › " + items.segment.name,
					color = pal_hue(s.scene * 7 + s.group, 0.9), movable = on_lamp ? false : true, selected = in_selection(s),
					problem = overlap_slots.has_value(i), tip = on_lamp ? "its address comes from its lamp: drag the lamp" : ""]);
			}
		}
		//the lamps of the fixture setup on this universe
		p = engine.patch;
		for(i = 0; i < p.fixtures.size(); i++) {
			f = p.fixtures[i];
			if(f.node != node || f.universe != universe)
				continue;
			used += math.min(patch_end(f), DMX_UNIVERSE_SIZE) - math.max(1, f.address) + 1;
			data.blocks.push_back([ref = "lamp:" + f.id, first = math.max(1, f.address), last = math.min(patch_end(f), DMX_UNIVERSE_SIZE),
				label = f.name + " (fixture setup)", color = pal_alpha(PAL_TEXT_2, 0.55), movable = true, selected = false,
				problem = false, tip = ""]);
		}
		//other LEDMappers (this one draws its own segments)
		//Not a local called `key`: that is the method key() of this class and stays it (the cells were computed once
		//and never again: another universe, node or patch change kept the cells of the first one)
		cells_key = node + "|" + std.string(universe) + "|" + std.string(engine.patch_revision) + "|" + seen_dmx_state;
		if(!map_cells || cells_key != map_cells_key) {
			map_cells = dmx_universe_cells(engine, p, node, universe, gen.ai_interface.registry_id);
			map_cells_key = cells_key;
		}
		data.cells = map_cells;
		data.title = patch_node_name(engine.net, p, node) + " · Universe " + std.string(universe) + " · " + std.string(used) +
			" channels used · lamps of the fixture setup grey";
		return data;
	}

	map_pick(b) {
		if(std.type(b.ref) == "string")
			return;
		s = build_data.slots[b.ref];
		if(s.scene != sel_scene || s.group != sel_group || s.segment != sel_segment) {
			select(s.scene, s.group, s.segment);
			map_shift = 0;
		}
	}

	//A segment or lamp dragged delta channels in the channel map
	map_move(b, delta) {
		if(std.type(b.ref) == "string") {
			f = patch_find(engine.patch, std.string(b.ref).substr(5));
			if(f) {
				f.address = dmx_lamp_moved(f, delta);
				engine.patch_changed();
			}
			return;
		}
		if(!build_data || b.ref >= build_data.slots.size())
			return;
		s = build_data.slots[b.ref];
		items = slot_items(s);
		if(!items)
			return;
		to = dmx_shift_address(s.start.universe, s.start.channel, delta);
		seg = items.segment;
		g = items.group;
		if(seg.universe < 0 && seg.channel < 0 && s.segment == 0) {
			//the first segment starts the group: the group moves
			g.start_universe = to.universe;
			g.start_channel = to.channel;
		}
		else {
			//its own address (the ones after it follow it)
			seg.universe = to.universe;
			seg.channel = to.channel;
		}
		changed(false, true);
	}

	// =========================================================================
	// AI queries (also what the tests use)
	// =========================================================================

	describe() {
		list = [];
		for(si = 0; si < scenes.size(); si++) {
			sc = scenes[si];
			groups = [];
			for(gi = 0; gi < sc.groups.size(); gi++) {
				g = sc.groups[gi];
				segs = [];
				for(k = 0; k < g.segments.size(); k++) {
					seg = g.segments[k];
					sl = slot_of(si, gi, k);
					segs.push_back([name = seg.name, shape = seg.shape, leds = seg.width, rows = seg.height, reversed = seg.reversed,
						rgb_type = LEDMAP_RGB_TYPES[seg.rgb_type], rgbw = seg.is_rgbw, target = seg.target,
						first = sl ? ledmap_address_text(sl.start) : "", last = sl ? ledmap_address_text(sl.last) : "",
						node = sl ? sl.node : ""]);
				}
				groups.push_back([name = g.name, enabled = g.enabled, node = g.device_mac, target = g.target,
					universe = g.start_universe, address = g.start_channel + 1, wrap = g.wrap_leds, segments = segs]);
			}
			list.push_back([name = sc.name, enabled = sc.enabled, master = sc.master, groups = groups]);
		}
		conflicts = [];
		for(i = 0; i < ext_problems.size() && build_data; i++) {
			slot_index = std.int(ext_problems.key(i));
			if(slot_index >= build_data.slots.size())
				continue;
			sl = build_data.slots[slot_index];
			if(sl.scene >= scenes.size() || sl.group >= scenes[sl.scene].groups.size() || sl.segment >= scenes[sl.scene].groups[sl.group].segments.size())
				continue;
			g = scenes[sl.scene].groups[sl.group];
			conflicts.push_back([scene = sl.scene, group = sl.group, segment = sl.segment,
				name = scenes[sl.scene].name + " › " + g.name + " › " + g.segments[sl.segment].name, problems = ext_problems[i]]);
		}
		return [scenes = list, leds = build_data ? build_data.total : 0, overlaps = overlap_slots.size(), conflicts = conflicts,
			selection = [scene = sel_scene, group = sel_group, segment = sel_segment], test = test_on];
	}

	// =========================================================================
	// Camera scan (#980, engine/patch/ledscan.shio)
	// =========================================================================

	//The Camera generators: their live_paths in the combobox
	fill_scan_cameras() {
		scan_cam_paths = [];
		items = ["Pick a camera…"];
		sel = 0;
		for(c : ledscan_cameras(engine)) {
			scan_cam_paths.push_back(c.live_path);
			items.push_back(c.name);
			if(c.live_path == scan_camera)
				sel = items.size() - 1;
		}
		scan_cam_combo.items(items);
		scan_cam_combo.selected(sel);
	}

	//The camera's picture: of the generator picked (a Camera: its video; any other, an NDI receiver of a phone's camera, a
	//capture card: the picture of its default output), else of the only Camera generator
	scan_picture() {
		return ledscan_picture(engine, scan_camera);
	}

	//The slots to scan: the selected segment, else every segment of the selected group
	scan_targets() {
		list = [];
		if(!build_data)
			return list;
		for(slot : build_data.slots) {
			if(slot.scene != sel_scene || slot.group != sel_group)
				continue;
			if(sel_segment >= 0 && slot.segment != sel_segment)
				continue;
			list.push_back(slot);
		}
		return list;
	}

	show_scan_info(text) {
		if(text != scan_shown && scan_info) {
			scan_shown = text;
			scan_info.caption(text);
		}
	}

	free_scan_gpu() noexcept {
		if(scan_gpu) {
			try {
				std.free(scan_gpu.host);
			}
			catch(e) {}
		}
		scan_gpu = None;
	}

	//Starts a scan of the selection: [ok] or [ok = false, error]
	start_scan(camera = None, wait = None, fit = None) {
		if(scan && scan.running())
			return [ok = false, error = "A scan is running"];
		if(camera)
			scan_camera = camera;
		if(!std.is_none(fit))
			scan_fit = fit ? true : false;
		if(!std.is_none(wait))
			scan_wait_box.value(math.clamp(std.int(wait), 30, 5000));
		if(build_dirty)
			rebuild();
		slots = scan_targets();
		if(!slots.size())
			return [ok = false, error = "Select a segment or a group with segments first"];
		pic = None;
		try {
			pic = scan_picture();
		}
		catch(e) {
			return [ok = false, error = std.string(e)];
		}
		leds = [];
		scan_slots = [];
		for(slot : slots) {
			scan_slots.push_back([id = slot.id, offset = leds.size(), count = slot.count]);
			for(i = 0; i < slot.count; i++)
				leds.push_back(slot.offset + i);
		}
		free_scan_gpu();
		scan_gpu = LedScanGpu(center_holder);
		scan_gpu.source(pic);
		scan_buffer = std.buffer();
		scan_buffer.resize(math.max(1, build_data.total) * 3, 0);
		scan_lit = -1;
		scan = LedScan();
		scan.start(leds, std.millis(), scan_wait_box.value());
		scan_result = "";
		scan_btn.caption("Stop the scan");
		show_scan_info("Taking the dark picture…");
		return [ok = true, leds = leds.size(), seconds = math.round(leds.size() * scan.wait_ms / 100.0) / 10.0];
	}

	stop_scan() {
		if(scan && scan.running()) {
			scan.stop();
			end_scan("Stopped: nothing changed");
		}
	}

	//One frame of the scan (render thread, from update()): the measure, the next step, the buffer that is sent
	scan_frame() {
		a = scan.tick(std.millis(), scan_gpu ? scan_gpu.spot() : None);
		if(a.lit != scan_lit) {
			if(scan_lit >= 0 && scan_lit * 3 + 2 < scan_buffer.size()) {
				for(c = 0; c < 3; c++)
					scan_buffer[scan_lit * 3 + c] = 0;
			}
			if(a.lit >= 0 && a.lit * 3 + 2 < scan_buffer.size()) {
				for(c = 0; c < 3; c++)
					scan_buffer[a.lit * 3 + c] = LEDSCAN_LEVEL;
			}
			scan_lit = a.lit;
		}
		if(scan_gpu)
			scan_gpu.frame(a.capture);
		if(scan.state == "done")
			finish_scan();
		else if(scan.running())
			show_scan_info(scan.state == "dark" ? "Taking the dark picture…" : "LED " + (scan.index + 1) + " of " + scan.leds.size() + " · " + scan.seen() + " seen");
		return scan_buffer;
	}

	end_scan(text) {
		free_scan_gpu();
		scan_lit = -1;
		scan_result = text;
		scan_btn.caption("Scan the selection");
		show_scan_info(text);
	}

	//The places found into the segments scanned (shape "points"), in the coordinates of their groups
	finish_scan() {
		pic = None;
		cam_aspect = 16.0 / 9.0;
		try {
			pic = scan_picture();
			cam_aspect = ledscan_picture_aspect(pic);
		}
		catch(e) {}
		results = [];
		lists = [];
		missing = 0;
		failed = [];
		for(e : scan_slots) {
			found = [];
			for(i = 0; i < e.count; i++)
				found.push_back(scan.found[e.offset + i]);
			r = ledscan_points(found);
			if(!r) {
				failed.push_back(e.id);
				continue;
			}
			missing += r.missing;
			results.push_back([id = e.id, points = r.points]);
			lists.push_back(r.points);
		}
		if(scan_fit && lists.size())
			ledscan_fit(lists, cam_aspect, size_x.value() / math.max(1.0, std.float(size_y.value())));
		placed = 0;
		for(k = 0; k < results.size(); k++) {
			hit = find_segment(results[k].id);
			if(!hit)
				continue;
			pts = [];
			for(p : lists[k])
				pts.push_back(untransform(hit.group, vec2f(p.x, p.y)));
			//in the order the LEDs are sent: a reversed segment keeps its points the other way round
			if(hit.segment.reversed) {
				back = [];
				for(i = pts.size() - 1; i >= 0; i--)
					back.push_back(pts[i]);
				pts = back;
			}
			ledmap_set_points(hit.segment, pts);
			placed += pts.size();
		}
		text = scan.leds.size() + " LEDs: " + scan.seen() + " seen";
		if(missing)
			text += ", " + missing + " placed between the ones beside them";
		if(failed.size())
			text += ", " + failed.size() + (failed.size() == 1 ? " segment" : " segments") + " not seen (fewer than 2 LEDs): left as they were";
		if(!placed)
			text = "No LED was seen: is the camera looking at them, the room dark, Art-Net reaching the LEDs?";
		end_scan(text);
		if(placed)
			changed(true, true);
	}

	//[scene, group, segment] of a segment id (the layout can change during a scan)
	find_segment(id) {
		for(sc : scenes) {
			for(g : sc.groups) {
				for(seg : g.segments) {
					if(seg.id == id)
						return [group = g, segment = seg];
				}
			}
		}
		return None;
	}

	register_queries() {
		gen.register("get_layout", [], [this](args) {
			if(this.build_dirty)
				this.rebuild();
			return [ok = true, value = this.describe()];
		}, "Scenes, groups and segments of the LEDMapper with the first and last DMX address of each segment");

		gen.register("add_segment", [
			x1 = "&float(): Start x 0..1 of the picture", y1 = "&float(): Start y 0..1",
			x2 = "&float(): End x 0..1", y2 = "&float(): End y 0..1",
			leds = "int(): LEDs (default: as the segment before)", rows = "int(): Rows (default 1)",
			shape = "string(): line or curve", scene = "int(): Scene index (default: selected)", group = "int(): Group index (default: selected)",
		], [this](args) {
			if(args.has("scene") && args.scene >= 0 && args.scene < this.scenes.size())
				this.select(args.scene, args.has("group") ? args.group : -1, -1);
			seg = this.add_segment(vec2f(args.x1, args.y1), vec2f(args.x2, args.y2), (args.shape ?? "line") == "curve" ? "curve" : "line");
			if(args.has("leds"))
				seg.width = math.max(1, std.int(args.leds));
			if(args.has("rows"))
				seg.height = math.max(1, std.int(args.rows));
			this.changed(true, true);
			return [ok = true, value = this.describe().selection];
		}, "Adds a segment into the selected group (a group and scene are made when there is none)");

		gen.register("set_group", [
			node = "string(): MAC of the Art-Net node", universe = "int(): Universe of the first LED", address = "int(): Address 1-512",
			wrap = "int(): 1: whole pixels per universe", target = "string(): fixture:<id> of a lamp of the fixture setup, or empty",
		], [this](args) {
			g = this.cur_group();
			if(!g)
				return [ok = false, error = "No group selected"];
			if(args.has("node"))
				g.device_mac = args.node;
			if(args.has("universe"))
				g.start_universe = std.int(args.universe);
			if(args.has("address"))
				g.start_channel = std.int(args.address) - 1;
			if(args.has("wrap"))
				g.wrap_leds = std.int(args.wrap);
			if(args.has("target"))
				g.target = args.target;
			this.changed(true, true);
			return [ok = true];
		}, "Changes the selected group");

		//#980: where the selected group is on the stage (engine/stage/stage_leds.shio)
		gen.register("set_stage_place", [
			on = "int(): 1: its LEDs on the stage (the Stage menu, the 3D view of the fixture setup), 0: not",
			x = "float(): Where the middle of its LEDs is, metres (x to the right, y towards the audience, z up)",
			y = "float(): metres", z = "float(): metres (height)",
			rx = "float(): Turn around x in degrees", ry = "float(): Turn around y in degrees",
			rz = "float(): Turn around the vertical in degrees (0: the picture faces the audience)",
			width = "float(): How wide the whole picture is on the stage, metres (the height follows its aspect)",
			hangs_on = "string(): An object of the stage (id or name, list_stage) its LEDs move with; empty: none",
			color_source = "string(): Where its colours come from: picture (as drawn), front, top, side (the picture projected by where the LEDs stand), effect (the 3D effect, set_effect3d)",
		], [this](args) {
			g = this.cur_group();
			if(!g)
				return [ok = false, error = "No group selected (select)"];
			pl = g.place3d;
			pl.on = args.has("on") ? (std.int(args.on) ? 1 : 0) : 1;
			for(k : ["x", "y", "z", "rx", "ry", "rz"]) {
				if(args.has(k))
					pl[k] = std.float(args[k]);
			}
			if(args.has("width") && std.float(args.width) > 0.0)
				pl.width = std.float(args.width);
			if(args.has("hangs_on")) {
				pl.hangs_on = "";
				want = std.string(args.hangs_on);
				st = this.engine.stage;
				for(o : st ? st.objects : []) {
					if(o.id == want || std.string(o.name).lowercase() == want.lowercase())
						pl.hangs_on = o.id;
				}
				if(want && !pl.hangs_on)
					return [ok = false, error = "No object '" + want + "' on the stage (list_stage of the live_path stage)"];
			}
			if(args.has("color_source")) {
				if(!LEDMAP_COLOR_SOURCES.has_value(args.color_source))
					return [ok = false, error = "color_source is one of " + LEDMAP_COLOR_SOURCES.combine_string(", ")];
				g.color_source = args.color_source;
			}
			this.changed(false, true);
			return [ok = true, value = [place = pl, color_source = g.color_source]];
		}, "Places the selected group on the stage (#980): its LEDs in 3D in the colours they are sent; the default is on");

		gen.register("add_group", [name = "string(): Name (default: Group n)"], [this](args) {
			g = this.add_group(args.has("name") ? std.string(args.name) : "");
			this.build_inspector();
			return [ok = true, value = this.describe().selection];
		}, "Adds a group to the selected scene (a scene is made when there is none) and selects it: add_segment draws into it");

		//#980: a strip along an edge of a model of the stage (the Stage menu, an agent): a segment whose LEDs follow a
		//3D path, in a group that hangs on that object
		gen.register("add_path_segment", [
			points = "&array(float): The path: x, y, z, ... in metres, in the frame of the object (as stage_model_edges gives them)",
			hangs_on = "string(): The object of the stage (id) the path belongs to; empty: the points are in the world",
			leds = "int(): How many LEDs (default: leds_per_m times its length)",
			leds_per_m = "float(): LEDs a metre (default 60)",
			group_name = "string(): The group it goes into (made when there is none of that name; default: Edges)",
		], [this](args) {
			pts = [];
			for(v : args.points)
				pts.push_back(std.float(v));
			if(pts.size() < 6 || pts.size() % 3 != 0)
				return [ok = false, error = "points: at least two points, x, y, z each"];
			n = args.has("leds") && args.leds ? std.int(args.leds) : 0;
			if(n <= 0)
				n = math.max(1, std.int(math.round(stage_path_length(pts) * (args.has("leds_per_m") && args.leds_per_m ? std.float(args.leds_per_m) : 60.0))));
			gname = args.has("group_name") && args.group_name ? std.string(args.group_name) : "Edges";
			//the group of that name in the selected scene, else a new one
			found = -1;
			sc = this.cur_scene();
			if(sc) {
				for(i = 0; i < sc.groups.size(); i++) {
					if(sc.groups[i].name == gname)
						found = i;
				}
			}
			if(found >= 0)
				this.select(this.sel_scene, found, -1);
			else
				this.add_group(gname);
			g = this.cur_group();
			g.place3d.on = 1;
			g.place3d.hangs_on = args.has("hangs_on") ? std.string(args.hangs_on) : "";
			//on the picture: a line of its own under the ones before (where it samples the picture)
			row = g.segments.size();
			yy = 0.06 + (row % 16) * 0.055;
			seg = this.add_segment(vec2f(0.08, yy), vec2f(0.92, yy), "line");
			seg.width = n;
			seg.height = 1;
			seg.path3d = pts;
			seg.name = "Edge " + (row + 1);
			this.changed(true, true);
			return [ok = true, value = [group = g.name, segment = seg.name, leds = n, length = stage_path_length(pts)]];
		}, "Adds a strip of LEDs along a 3D path (an edge of a model of the stage) into a group that hangs on that object; on the picture it is a line of its own");

		gen.register("set_effect3d", [
			effect = "string(): plane, sphere, noise or rainbow",
			direction = "string(): x (left to right), y (back to front) or z (top to bottom)",
			speed = "float(): 0..1 (1: two passes a second)", size = "float(): 0..1 of the arrangement",
			hue_a = "float(): Colour A as a hue 0..1 (0 red, 0.33 green, 0.66 blue)", hue_b = "float(): Colour B, the same",
		], [this](args) {
			names = ["plane", "sphere", "noise", "rainbow"];
			axes = ["x", "y", "z"];
			if(args.has("effect")) {
				if(!names.has_value(args.effect))
					return [ok = false, error = "effect is plane, sphere, noise or rainbow"];
				this.fx_type.value(patch_index_of(names, args.effect));
				this.led_shader.uniform("fx_type", patch_index_of(names, args.effect));
			}
			if(args.has("direction")) {
				if(!axes.has_value(args.direction))
					return [ok = false, error = "direction is x, y or z"];
				this.fx_axis.value(patch_index_of(axes, args.direction));
				this.led_shader.uniform("fx_axis", patch_index_of(axes, args.direction));
			}
			if(args.has("speed"))
				this.fx_speed.value(math.clamp(std.float(args.speed), 0.0, 1.0));
			if(args.has("size")) {
				this.fx_size.value(math.clamp(std.float(args.size), 0.0, 1.0));
				this.led_shader.uniform("fx_size", this.fx_size.value());
			}
			if(args.has("hue_a")) {
				this.fx_hue_a.value(math.clamp(std.float(args.hue_a), 0.0, 1.0));
				this.led_shader.uniform("fx_hue_a", this.fx_hue_a.value());
			}
			if(args.has("hue_b")) {
				this.fx_hue_b.value(math.clamp(std.float(args.hue_b), 0.0, 1.0));
				this.led_shader.uniform("fx_hue_b", this.fx_hue_b.value());
			}
			return [ok = true];
		}, "The 3D effect of this LEDMapper (#980) for its groups on the stage whose colour_source is effect");

		gen.register("select", [scene = "&int(): Scene index", group = "int(): Group index (-1: the scene)", segment = "int(): Segment index (-1: the group)"], [this](args) {
			//(not ??: it takes 0 as missing)
			this.select(std.int(args.scene), args.has("group") ? std.int(args.group) : -1, args.has("segment") ? std.int(args.segment) : -1);
			return [ok = true];
		}, "Selects a scene, group or segment");

		gen.register("set_test", [on = "&int(): 1 lights the selection white, 0 back to the picture"], [this](args) {
			this.test_btn.pushed(args.on ? true : false);
			this.test_on = args.on ? true : false;
			this.gains_dirty = true;
			return [ok = true];
		}, "Test mode: the selection white on the LEDs, everything else black");

		//#980: the camera scan
		gen.register("scan_leds", [
			camera = "string(): live_path of a Camera generator, or of another one whose picture is a camera (an NDI receiver) (default: the one picked, else the only Camera)",
			wait_ms = "int(): ms each LED is lit before the camera counts (default 300)",
			fit = "any(): true (default): the places found fill the picture; false: where they are in the camera's picture",
		], [this](args) {
			r = this.start_scan(args.camera ?? None, args.wait_ms ?? None, args.has("fit") ? args.fit : None);
			return r.ok ? [ok = true, value = r] : r;
		}, "Camera scan of the selected segment (or every segment of the selected group): one LED after the other lit, each put where the camera sees it (shape points). Runs over frames: get_scan_status");

		gen.register("get_scan_status", [], [this](args) {
			s = this.scan;
			if(!s)
				return [ok = true, value = [state = "idle"]];
			return [ok = true, value = [state = s.state, leds = s.leds.size(), done = s.found.size(), seen = s.seen(), result = this.scan_result]];
		}, "The camera scan: state (dark, led, done, stopped), LEDs, done, seen, and what it found");

		gen.register("stop_scan", [], [this](args) {
			this.stop_scan();
			return [ok = true];
		}, "Stops a camera scan: the segments stay as they were");

		gen.register("add_lamps", [target = "&string(): group:<id> or type:<path> of the fixture setup"], [this](args) {
			g = this.add_lamps(args.target);
			return g ? [ok = true, value = g.name] : [ok = false, error = "No lamps with colour channels"];
		}, "Adds the lamps of a target of the fixture setup as a group, one segment per lamp");

		gen.register("list_presets", [], [this](args) {
			list = [];
			files = this.preset_files();
			for(i = 0; i < files.size(); i++)
				list.push_back([name = fileio.pure_name(files[i].path), kind = files[i].kind, path = files[i].path]);
			return [ok = true, value = list];
		}, "The presets of the Library: scenes, groups and segments");

		gen.register("insert_preset", [name = "&string(): Name of the preset (list_presets)", kind = "string(): scene, group or segment (when two have the name)"], [this](args) {
			files = this.preset_files();
			for(i = 0; i < files.size(); i++) {
				if(fileio.pure_name(files[i].path) == args.name && (!args.has("kind") || args.kind == files[i].kind)) {
					if(!this.insert_preset(fileio.read_json(files[i].path), files[i].kind))
						return [ok = false, error = "The preset could not be read"];
					return [ok = true, value = this.describe().selection];
				}
			}
			return [ok = false, error = "No preset " + args.name];
		}, "Inserts a preset like a click in the Library: a scene as a new scene, a group into the selected scene, a segment into the selected group");

		gen.register("remove_selected", [], [this](args) {
			this.remove_selected();
			return [ok = true];
		}, "Removes the selected segment, group or scene");
	}

	save() {
		return [fixture_scenes = scenes, grid = grid_div, snap = snap_on, labels = labels_on, channels = channels_on];
	}

	load(state) {
		scenes = ledmap_normalize(state.fixture_scenes ?? []);
		grid_div = state.grid ?? grid_div;
		snap_on = state.has("snap") ? state.snap : snap_on;
		labels_on = state.has("labels") ? state.labels : labels_on;
		sel_scene = scenes.size() ? 0 : -1;
		sel_group = -1;
		sel_segment = -1;
		snap_btn.pushed(snap_on ? true : false);
		labels_btn.pushed(labels_on ? true : false);
		show_channels(state.has("channels") ? state.channels : true);
		set_tool(scenes.size() ? "select" : "line");
		build_dirty = true;
		build_outliner();
		build_inspector();
		build_masters();
	}
}

managed mapper = None;

dispatcher(generator, cmd, value) {
	if(!mapper)
		return None;
	if(cmd == "get_default_input")
		return mapper.in_ctrl;
	if(cmd == "get_default_output")
		return mapper.out_ctrl;
}

entry(generator, area) {
	mapper = led_mapper(generator, area);
	mapper.register_queries();
}

//Called by the generator before this module goes (generator.free_module_content, #361): the managed globals of a
//module whose load_state() ran are not released with it. The mapper registers draw callbacks on the widgets of
//the generator's window, and those widgets live on for a frame after the module is gone: released here, their
//callbacks go with it, kept alive there they draw on a freed instance (#666). The same on_free() every other
//module with managed views in its globals has (Patchview, Clipview, Links, ...)
on_free() {
	if(mapper)
		mapper.detach();
	mapper = None;
}

update_pre(generator, tl_pos, delta) {
	if(mapper)
		mapper.update();
}

save_state() {
	return mapper ? mapper.save() : [];
}

load_state(state) {
	if(mapper && state)
		mapper.load(state);
}
