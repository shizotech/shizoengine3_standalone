//SHADER SRC
shader_src = R"(
#version 330 core

uniform sampler2D input;

void main()
{
    fragColor = texture(input, v_uv);
}
)";

//LED SHADER SRC
led_shader_src = R"(
#version 330 core

uniform sampler2D input;
uniform sampler2D led_coords;
uniform sampler2D feedback;

uniform int analog_mode;
uniform int led_radius;
uniform float feedback_value; // 0.0 = none, 1.0 = full ghosting

void main()
{
    // x, y, rgb_type, is_rgbw
    vec4 coords = texelFetch(
        led_coords,
        ivec2(int(gl_FragCoord.x), 0),
        0
    );

    int rgb_type = int(coords.z);
    int is_rgbw = int(coords.w);

    coords.y = 1.0 - coords.y;


    // ============================================================
    // LED RADIUS
    // Average a circular area around the LED coordinate
    // ============================================================

    vec4 current_color;

    if (led_radius <= 0)
    {
        current_color = texture(input, coords.xy);
    }
    else
    {
        ivec2 input_size = textureSize(input, 0);

        vec2 pixel_size = 1.0 / vec2(input_size);

        vec4 color_sum = vec4(0.0);
        int sample_count = 0;

        for (int y = -led_radius; y <= led_radius; y++)
        {
            for (int x = -led_radius; x <= led_radius; x++)
            {
                // Circular radius
                if (x * x + y * y <= led_radius * led_radius)
                {
                    vec2 offset =
                        vec2(float(x), float(y)) * pixel_size;

                    color_sum += texture(
                        input,
                        coords.xy + offset
                    );

                    sample_count++;
                }
            }
        }

        current_color =
            color_sum / float(sample_count);
    }


	// ============================================================
	// FEEDBACK / LIGHT RESPONSE
	// ============================================================

	vec4 feedbackColor = texture(feedback, v_uv);

	feedbackColor = max(feedbackColor - 0.0025, 0.0);

	float feedback_amount = 1.0 - clamp(feedback_value, 0.0, 1.0);

	// ============================================================
	// NORMAL MODE
	// Keep the existing behavior exactly
	// ============================================================

	if (analog_mode == 0)
	{
		float decay = feedback_amount * feedback_amount;

		float attack = 0.85;
		float release = 0.15 + decay * 0.80;

		vec4 target = current_color;

		vec4 response;

		response.r = target.r > feedbackColor.r
			? mix(feedbackColor.r, target.r, attack)
			: mix(feedbackColor.r, target.r, release);

		response.g = target.g > feedbackColor.g
			? mix(feedbackColor.g, target.g, attack)
			: mix(feedbackColor.g, target.g, release);

		response.b = target.b > feedbackColor.b
			? mix(feedbackColor.b, target.b, attack)
			: mix(feedbackColor.b, target.b, release);

		response.a = target.a > feedbackColor.a
			? mix(feedbackColor.a, target.a, attack)
			: mix(feedbackColor.a, target.a, release);

		fragColor = response;
	}

	// ============================================================
	// ANALOG MODE
	// Simulate physical light response
	// ============================================================

	else
	{
		float analog = clamp(feedback_value, 0.0, 1.0);

		// More analog = more thermal inertia.
		float inertia = analog * analog;

		// Brightening is relatively quick, cooling is slower.
		float attack = mix(0.95, 0.25, inertia);
		float release = mix(0.15, 0.02, inertia);

		vec4 target = current_color;

		vec4 response;

		response.r = target.r > feedbackColor.r
			? mix(feedbackColor.r, target.r, attack)
			: mix(feedbackColor.r, target.r, release);

		response.g = target.g > feedbackColor.g
			? mix(feedbackColor.g, target.g, attack)
			: mix(feedbackColor.g, target.g, release);

		response.b = target.b > feedbackColor.b
			? mix(feedbackColor.b, target.b, attack)
			: mix(feedbackColor.b, target.b, release);

		response.a = target.a > feedbackColor.a
			? mix(feedbackColor.a, target.a, attack)
			: mix(feedbackColor.a, target.a, release);

		fragColor = response;
	}


    // ============================================================
    // RGB ORDER
    // ============================================================

    if (rgb_type == 0)
    {
        // Simple dimmer
        float max_value = max(
            fragColor.r,
            max(fragColor.g, fragColor.b)
        );

        fragColor = vec4(
            max_value,
            max_value,
            max_value,
            0.0
        );
    }
    else if (rgb_type == 2) // RBG
    {
        fragColor = vec4(
            fragColor.r,
            fragColor.b,
            fragColor.g,
            fragColor.a
        );
    }
    else if (rgb_type == 3) // GRB
    {
        fragColor = vec4(
            fragColor.g,
            fragColor.r,
            fragColor.b,
            fragColor.a
        );
    }
    else if (rgb_type == 4) // GBR
    {
        fragColor = vec4(
            fragColor.g,
            fragColor.b,
            fragColor.r,
            fragColor.a
        );
    }
    else if (rgb_type == 5) // BRG
    {
        fragColor = vec4(
            fragColor.b,
            fragColor.r,
            fragColor.g,
            fragColor.a
        );
    }
    else if (rgb_type == 6) // BGR
    {
        fragColor = vec4(
            fragColor.b,
            fragColor.g,
            fragColor.r,
            fragColor.a
        );
    }
}
)";

dispatcher(generator, cmd, value) {
	if(cmd == "get_default_input")
		return in_ctrl;
	
	if(cmd == "get_default_output")
		return out_ctrl;
}

entry(generator, area) {	
	
	generator.window.fixed_size(vec2f(1200,800));
	
	net = generator.engine.net;
	
	area.layout(None);
	
	left_ctrls = area.widget().anchor_left(0).anchor_top(0).anchor_bottom(30).fixed_width(200).layout(nanogui.layout_vertical());
	right_ctrls = area.widget().anchor_right(0).anchor_top(0).anchor_bottom(30).fixed_width(200).layout(nanogui.layout_vertical());
	
	in_ctrl = area.control("IN").anchor_left(0).anchor_bottom(0).fixed_height(30).fixed_width(200);
	out_ctrl = area.control("OUT").anchor_right(0).anchor_bottom(0).fixed_height(30).fixed_width(200);
	
	led_coords_image = area.image().visible(false);
	led_coords_buffer = led_coords_image.texture();
	led_coords_buffer.pixel_format("rgba").component_format("float32").size(vec2i(1,1));
	
	led_shader = area.shader().anchor_left(200).anchor_right(200).anchor_top(0).fixed_height(20);
	led_shader.fragment_source(led_shader_src);
	led_shader.render_size(vec2i(1, 1));
	led_shader.pixel_readback(true);
	led_shader.input("feedback", led_shader);
	
	
	shader_view = area.scrollarea().anchor_left(200).anchor_right(200).anchor_top(20).anchor_bottom(0).fit_content().content();
	
	shader = shader_view.shader();
	shader.fragment_source(shader_src);
	
	size_x = left_ctrls.controlint("Width", "settings").value(generator.engine.project_width.value());
	size_y = left_ctrls.controlint("Height", "settings").value(generator.engine.project_height.value());
	
	led_radius_ctrl = left_ctrls.controlint("LED Radius").min(1).max(100).callback([this](v){
		led_shader.uniform("led_radius", v);
	});
	led_radius_ctrl.value(1);
	
	led_smoothing_ctrl = left_ctrls.controlslider("LED Smoothing").callback([this](v){
		led_shader.uniform("feedback_value", v);
	});
	led_smoothing_ctrl.value(0.0);
	
	led_analog_ctrl = left_ctrls.controlbutton("Analog Mode").push(true).callback([this](v){
		led_shader.uniform("analog_mode", v);
	});
	led_analog_ctrl.value(0);
	
	size_cb = [size_x, size_y, shader_view](v) {
		shader.render_size(vec2i(size_x.value(), size_y.value()));
		shader_view.fixed_size(vec2i(size_x.value(), size_y.value()));
		shader_view.size(shader_view.fixed_size());
		shader_view.refresh_layout();
	};
	
	size_x.callback(size_cb);
	size_y.callback(size_cb);
	
	size_cb();

	select_video_router = left_ctrls.combobox().items(["Select Input"]);
	select_video_router.on_open([select_video_router](){
		routers = get_video_routers();
		items = ["Select Input"];
		for(i = 0; i < routers.size(); i++) {
			items.push_back(routers[i].name);
		}
		select_video_router.items(items);
	});
	
	select_video_router.on_change([select_video_router, in_ctrl](index, text){
		routers = get_video_routers();
		index--;
		if(index < 0 || index >= routers.size())
			in_ctrl.clear_incoming_links();
			in_ctrl.value(None);
		else 
			routers[index].output_ctrl.link_to(in_ctrl);
			in_ctrl.value(routers[index].output_ctrl.value());
			
	});

	add_scene = left_ctrls.button("Add Scene").fixed_height(30);
	
	scene_area = left_ctrls.vscroll().anchor(0).anchor_top(230).content().layout(nanogui.layout_vertical()).fixed_width(200);
	
	scene_control_area = right_ctrls;
	
	add_scene.on_click([](){
		
		fixture_scenes.push_back([
			name="New Scene",
		]);
		
		build_scenes();
	});
	
	left_ctrls.on_dragdrop_hover([this](payload, pos) {
			path = fileio.relative_path_cwd(payload.path);	
			config = fileio.read_json(path);
			return config.type == "scene";
		});
		
	left_ctrls.on_dragdrop([this, area](payload, pos) {
			path = fileio.relative_path_cwd(payload.path);	
			config = fileio.read_json(path);
			if(config.type == "scene") {
				fixture_scenes.push_back(config);
				build_scenes();
				build_shader_flag = true;
			}
			return true;
		});
	
	scene_control_area.on_dragdrop_hover([this](payload, pos) {
			path = fileio.relative_path_cwd(payload.path);	
			config = fileio.read_json(path);
			return config.type == "group" || config.type == "segment";
		});
		
	scene_control_area.on_dragdrop([this, area](payload, pos) {
			path = fileio.relative_path_cwd(payload.path);	
			config = fileio.read_json(path);
			if(config.type == "group") {
				if(!active_scene)
					std.print("No scene active.");
					return;
				active_scene.scene.groups.push_back(config);
				active_scene.build_groups();
				build_shader_flag = true;
			}
			else if(config.type == "segment") {
				if(!active_group)
					std.print("No group active.");
					return;
				active_group.group.segments.push_back(config);
				active_group.build_segments();
				build_shader_flag = true;
			}
			return true;
		});
	
	shader.on_mouse_button([](pos, button, down, mods) {
		if(button != 0)
			return false;
		std.print(pos);
		if(down)
			active_drag_start = quantize_grid(pos);
			if(active_group) {
				uv = vec2f(active_drag_start.x / std.float(shader.width()), active_drag_start.y / std.float(shader.height()));
				active_group.on_drag_start(uv);
			}
		else
			active_drag_end = quantize_grid(pos);
			
			if(active_drag_start && active_drag_end) {
				if(active_group) {
					uv_start = vec2f(active_drag_start.x / std.float(shader.width()), active_drag_start.y / std.float(shader.height()));
					uv_end = vec2f(active_drag_end.x / std.float(shader.width()), active_drag_end.y / std.float(shader.height()));		
					active_group.on_drag_end(uv_start, uv_end);
				}
			}
			
			active_drag_start = None;
			active_drag_end = None;
		return true;
	});
	
	shader.on_mouse_drag([](pos, rel, button, mods) {
		if(active_drag_start) {
			active_drag_end = quantize_grid(pos);
			if(active_group) {
				uv = vec2f(active_drag_end.x / std.float(shader.width()), active_drag_end.y / std.float(shader.height()));
				uv_rel = vec2f(rel.x / std.float(shader.width()), rel.y / std.float(shader.height()));
				active_group.on_drag(uv, uv_rel);
			}
		}
		return true;
	});

	in_ctrl.callback([](v){
		shader.input("input", v);
	});

	shader.on_draw([](){		
		s = shader.size();

		ctx = nanogui.current_context();
		
		if(active_scene) {
			grid = current_grid;

			grid_step_x = s.x / grid;
			grid_step_y = s.y / grid;

			ctx.nvgBeginPath();

			// Vertical lines
			for(xx = 0; xx <= s.x; xx += grid_step_x) {
				ctx.nvgMoveTo(vec2f(xx, 0));
				ctx.nvgLineTo(vec2f(xx, s.y));
			}

			// Horizontal lines
			for(yy = 0; yy <= s.y; yy += grid_step_y) {
				ctx.nvgMoveTo(vec2f(0, yy));
				ctx.nvgLineTo(vec2f(s.x, yy));
			}

			ctx.nvgStrokeColor(vec4f(1, 1, 1, 0.25));
			ctx.nvgStrokeWidth(1.0);
			ctx.nvgStroke();
			
			active_scene.draw_groups(ctx);
		}
	
		if(active_group) {
			active_group.draw(ctx, true);
		}
	
		if(active_drag_start && active_drag_end) {
			
			ctx.nvgBeginPath();
			
			ctx.nvgMoveTo(vec2f(active_drag_start.x, active_drag_start.y));
			ctx.nvgLineTo(vec2f(active_drag_end.x, active_drag_end.y));
			ctx.nvgStrokeWidth(10.0);
			if(active_group)
				ctx.nvgStrokeColor(vec4f(0.4, 0.8, 0, 0.8));
			else
				ctx.nvgStrokeColor(vec4f(0.8, 0.4, 0, 0.8));
			ctx.nvgStroke();
		}
		
	});
}

save_state() {
	return [
		fixture_scenes=fixture_scenes,
	];
}

load_state(state) {
	fixture_scenes = state.fixture_scenes;
	build_scenes();
	build_shader();
}