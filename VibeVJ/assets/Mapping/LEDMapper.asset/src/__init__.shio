managed shader = None;
managed led_shader = None;
managed led_coords_image = None;
managed led_coords_buffer = None;

managed size_x = None;
managed size_y = None;

managed scene_area = None;
managed scene_control_area = None;

managed scene_instances = [];
active_scene = None; //NOT managed!
active_group = None;
active_segment = None;

//Raw json structure, should not contain objects / classes only raw json setup from which everything is build dynamically.
fixture_scenes = [];
optimized_fixture_scenes = []; //Gets generated when the shader is build

net = None;

in_ctrl = None;
out_ctrl = None;

//Temp
active_drag_start = None;
active_drag_end = None;

current_grid = 3;
snap_to_grid = true;

build_shader_flag = false;

rgb_types = [
	"Single Ch.",
	"RGB",
	"RBG",
	"GRB",
	"GBR",
	"BRG",
	"BGR"
];

preset_save_path = __DIR__ + "/../";

def build_scenes();
def build_shader();

quantize_grid(pos)
{
	if(!snap_to_grid)
		return pos;
	
	size = shader.size();
	grid = current_grid * 4;
	
	grid_step_x = size.x / grid;
	grid_step_y = size.y / grid;

	pos.x = (math.round(pos.x / grid_step_x)) * grid_step_x;
	pos.y = (math.round(pos.y / grid_step_y)) * grid_step_y;

	return pos;
}

vec_to_json(v) {
	return [
		x = v.x,
		y = v.y,
	];
}

json_to_vec(v) {
	return vec2f(v.x, v.y);
}

uv_to_pos(uv) {
	return vec2f(uv.x * shader.width(), uv.y * shader.height());
}

pos_to_uv(pos) {
	return vec2f(pos.x / std.float(shader.width()), pos.y / std.float(shader.height()));
}

distanceFromPointToLine(p1, p2, p3)
{
	x1 = p1[0];
	y1 = p1[1];
	
	x2 = p2[0];
	y2 = p2[1];
	
	x3 = p3[0];
	y3 = p3[1];
	
	// Vector from p1 to p2
	vx = x2 - x1;
	vy = y2 - y1;
	
	// Vector from p1 to p3
	wx = x3 - x1;
	wy = y3 - y1;
	
	// Projection of p3 onto the line p1 -> p2 (dot product)
	t = (wx * vx + wy * vy) / (vx * vx + vy * vy);
	
	// Clamp t to the range [0, 1] to ensure it's within the segment
	t = math.max(0, math.min(1, t));
	
	// Find the closest point on the segment
	closest_x = x1 + t * vx;
	closest_y = y1 + t * vy;
	
	// Calculate the distance from p3 to the closest point on the segment
	dx = x3 - closest_x;
	dy = y3 - closest_y;
	
	// Return the Euclidean distance
	return math.sqrt(dx * dx + dy * dy);
}

quantize_transform(transform) {
	quant_transform = [];
	for(i = 0; i < transform.size(); i++) {
		pos = vec2f(transform[i].x*shader.width(), transform[i].y*shader.height());
		pos = quantize_grid(pos);
		quant_transform.push_back([x=pos.x/shader.width(), y=pos.y/shader.height()]);
	}
	return quant_transform;
}

create_splitter(parent, name, height=30) {
	div = parent.widget().fixed_height(height).anchor_left(0).anchor_right(0);
	label = div.label(name).anchor_left(0).anchor_right(0.5, "percent").fixed_height(height);
	return div.widget().anchor_left(0.5,"percent").anchor_right(0).fixed_height(height);
}

class FixtureSegment {
	
	segment = None;
	segment_index = 0;
	
	managed area = None;
	managed ctrl_area = None;
	managed edit_btn = None;
	
	__init__(parent, group, index) {
		segment_index = index;
		segment = group.segments[segment_index];
		
		area = parent.area.widget().layout(nanogui.layout_vertical());
		
		select_div = area.widget().fixed_height(25).anchor_left(0).anchor_right(0);
		edit_btn = select_div.pushbutton(">").anchor_left(0).fixed_width(25);
		save_btn = select_div.button("S").anchor_left(25).fixed_width(25);
		segment_name = select_div.textbox(segment.name).anchor(0).anchor_left(50).anchor_right(25);
		segment_name.on_change([this](v){
			segment.name = v;
		});
		delete_btn = select_div.button("X").anchor_right(0).fixed_width(25);
		
		//Ctrl area
		ctrl_area = area.widget().layout(nanogui.layout_vertical()).visible(false);

		save_btn.on_click([save_btn, segment](){
			form = [
				[id="name",  	label="Preset Name",  	type="text",   	placeholder = segment.name],
			];
			
			engine = std.global("engine");
			res = engine.screen.modal_form(form, "Save preset", "save", "cancel");		
			if(res.choice != "submit")
				return;
			
			//std.print(res);
			
			if(!res.values.name)
				return;
			
			save_segment = segment.copy();
			save_segment.type = "segment";
			fileio.write_json(preset_save_path + "segments/" + res.values.name + ".json", save_segment);
		});
		
		delete_btn.on_click([parent, index](){
			parent.group.segments.erase(index);
			parent.build_segments();
			build_shader_flag = true;
		});

		edit_btn.on_change([this, edit_btn, ctrl_area](v){
			
			edit_btn.caption(v ? "v" : ">");
			
			ctrl_area.visible(v);
			if(active_segment == this) {
				active_segment = v ? this : None;
			}
			else if(v) {
				if(active_segment)
					active_segment.edit_btn.pushed(false);
					active_segment.ctrl_area.visible(false);
				active_segment = this;
				this.edit_btn.pushed(true);
			}
			
			scene_control_area.refresh_layout();
		});
		
		engine = std.global("engine");
	
		target_fixture = ctrl_area.combobox().fixed_height(20).items(["Select Fixture"]);
		target_fixture.on_open([target_fixture, engine](){
			
			items = ["Select Fixture"];
			
			for(i = 0; i < engine.fixtures.size(); i++) {
				items.push_back(fileio.pure_name(engine.fixtures.key(i)));
			}
			
			target_fixture.items(items);
		});
		
		target_channel = ctrl_area.combobox().fixed_height(20).items(["Select Channel"]);
		target_channel.on_open([target_channel, target_fixture, engine](){
			
			items = ["Select Channel"];
			target_channel.items(items);
			
			id = target_fixture.selected();
			if(id == 0)
				return;
			id--;
			if(id >= engine.fixtures.size())
				return;
			
			fixture_config = fileio.read_json(engine.fixtures.key(id));

			for(i = 0; i < fixture_config.channels.size(); i++) {
				items.push_back(fixture_config.channels[i].name);
			}
			
			target_channel.items(items);
		});
		
		target_device = ctrl_area.combobox().fixed_height(20).items(["Select Device"]);
		target_device.on_open([target_device, target_channel, target_fixture, engine](){
			if(target_fixture.selected() == 0) {
				target_device.items(["Select Device"]);
				return;
			}
			
			fixture = engine.fixtures[target_fixture.selected()-1];
			items = ["Select Device"];
			for(i = 0; i < fixture.instances.size(); i++) {
				items.push_back(fixture.instances[i].name);
			}
			
			target_device.items(items);
		});
		
		
		width_ctrl = create_splitter(ctrl_area, "Width", 20).intbox().value(segment.width).anchor(0).value_callback([this, segment](v) {
			segment.width = v;
			build_shader_flag = true;
		});
		height_ctrl = create_splitter(ctrl_area, "Height", 20).intbox().value(segment.height).anchor(0).value_callback([this, segment](v) {
			segment.height = v;
			build_shader_flag = true;
		});
		uni_ctrl = create_splitter(ctrl_area, "Uni Override", 20).intbox().value(segment.universe).anchor(0).value_callback([this, segment](v) {
			segment.universe = v;
			build_shader_flag = true;
		});
		chan_ctrl = create_splitter(ctrl_area, "Chan Override", 20).intbox().value(segment.channel).anchor(0).value_callback([this, segment](v) {
			segment.channel = v;
			build_shader_flag = true;
		});
		
		rgbtype_ctrl = ctrl_area.combobox().fixed_height(20).items(rgb_types).selected(segment.rgb_type).on_change([segment](v, txt) {
			segment.rgb_type = v;
			build_shader_flag = true;
		});
		white_ctrl = ctrl_area.pushbutton("White Channel").fixed_height(20).pushed(segment.is_rgbw).on_change([segment](v) {
			segment.is_rgbw = v;
			build_shader_flag = true;
		});
		
		target_device.on_change([group, target_device, target_channel, target_fixture, engine, segment, uni_ctrl, chan_ctrl, width_ctrl, height_ctrl, rgbtype_ctrl, white_ctrl](index, txt){
			if(index == 0 || target_channel.selected() == 0 || target_fixture.selected() == 0) {
				return;
			}
			
			index--;
			
			fixture = engine.fixtures[target_fixture.selected()-1];
			selected = fixture.instances[index];

			fixture_config = fileio.read_json(fixture.path);
			
			channel_config = fixture_config.channels[target_channel.selected()-1];
			
			segment.custom_device_mac = selected.device_mac;
			group.device_mac = selected.device_mac;
			
			std.print(channel_config);
			
			if(channel_config.byte_count == 1) {
				rgbtype_ctrl.selected(0);
				segment.rgb_type = 0;
				white_ctrl.pushed(false);
				segment.is_rgbw = false;
			}
			if(channel_config.byte_count == 3) {
				if(rgbtype_ctrl.selected() == 0)
					rgbtype_ctrl.selected(1);
					segment.rgb_type = 1;
				white_ctrl.pushed(false);
				segment.is_rgbw = false;
			}
			if(channel_config.byte_count == 4) {
				if(rgbtype_ctrl.selected() == 0)
					rgbtype_ctrl.selected(1);
					segment.rgb_type = 1;
				white_ctrl.pushed(true);
				segment.is_rgbw = true;
			}
			
			uni_ctrl.value(selected.universe);
			segment.universe = selected.universe;
			chan_ctrl.value(selected.start_channel);
			segment.channel = selected.start_channel;
			
			width_ctrl.value(channel_config.batch_count);
			height_ctrl.value(1);
			
			segment.width = channel_config.batch_count;
			segment.height = 1;
			
			build_shader_flag = true;
		});
	}
}

class FixtureGroup {
	
	group = None; //shared pointer to fixture_scenes[...].groups[index]
	group_index = 0;
	
	managed area = None;
	managed edit_btn = None;
	managed segments_area = None;
	managed segments = [];
	
	device_list = [];
	
	transform_uv_select = -1;
	transform_uv_drag = None;
	
	edit_segments_btn = None;
	transform_btn = None;
	
	__init__(parent, scene, index) {
		group_index = index;
		group = scene.groups[group_index];
		
		select_div = parent.group_area.widget().fixed_height(30).anchor_left(0).anchor_right(0);
		edit_btn = select_div.pushbutton(">").anchor_left(0).fixed_width(25);
		save_btn = select_div.button("S").anchor_left(25).fixed_width(25);
		group_name = select_div.textbox(group.name).anchor(0).anchor_right(25).anchor_left(50);
		group_name.on_change([this](v){
			group.name = v;
		});
		delete_btn = select_div.button("X").anchor_right(0).fixed_width(25);
		
		area = parent.group_area.widget().layout(nanogui.layout_vertical());
		
		save_btn.on_click([save_btn, group](){
			form = [
				[id="name",  	label="Preset Name",  	type="text",   	placeholder = group.name],
			];
			
			engine = std.global("engine");
			res = engine.screen.modal_form(form, "Save preset", "save", "cancel");		
			if(res.choice != "submit")
				return;
			
			//std.print(res);
			
			if(!res.values.name)
				return;
			
			save_group = group.copy();
			save_group.type = "group";
			fileio.write_json(preset_save_path + "groups/" + res.values.name + ".json", save_group);
		});
		
		delete_btn.on_click([parent, index](){
			parent.scene.groups.erase(index);
			parent.build_groups();
			build_shader_flag = true;
		});

		edit_btn.on_change([this, edit_btn, area](v){
			edit_btn.caption(v ? "v" : ">");
		
			area.visible(v);
			if(active_group == this) {
				active_group = v ? this : None;
			}
			else if(v) {
				if(active_group)
					active_group.edit_btn.pushed(false);
					active_group.area.visible(false);
				active_group = this;
				this.edit_btn.pushed(true);
			}
			
			scene_control_area.refresh_layout();
		});
		
		selector = area.combobox().items(["Select"]).fixed_height(20);
		
		selector.on_open([this, net, selector](){
			devs = net.artnet_devices();
			device_list.items = ["Select"];
			device_list.devs = [];
			for(i = 0; i < devs.size(); i++)
				device_list.items.push_back(devs[i].name());
				device_list.devs.push_back(devs[i]);
			selector.items(device_list.items);
		});
		selector.on_change([this](v, text){
			if(v == 0) 
				group.device_mac = "";
				return;
			
			v--;
			
			if(v < 0 || v >= device_list.devs.size())
				return;
			
			dev = device_list.devs[v];
			group.device_mac = dev.mac();
		});
		
		create_splitter(area, "Universe", 20).intbox().min_value(0).max_value(15).anchor(0).value(group.start_universe).value_callback([this,group](v) {
			group.start_universe = v;
			build_shader_flag = true;
		});
		create_splitter(area, "Channel", 20).intbox().min_value(1).max_value(512).anchor(0).value(group.start_channel+1).value_callback([this,group](v) {
			group.start_channel = v-1;
			build_shader_flag = true;
		});
		create_splitter(area, "Channel Gap", 20).intbox().anchor(0).value(group.channel_gap).value_callback([this,group](v) {
			group.channel_gap = v;
			build_shader_flag = true;
		});
		
		create_splitter(area, "Angle", 20).intbox().anchor(0).min_value(-180).max_value(180).value(group.transform_angle).value_callback([this](v) {
			group.transform_angle = v;
			build_shader_flag = true;
		});
		
		area.slider("Max Brightness").fixed_height(20).value(group.max_brightness).value_callback([this](v) {
			group.max_brightness = v;
			build_shader_flag = true;
		});
		
		edit_segments_btn = area.pushbutton("DRAW NEW SEGMENTS").fixed_height(20);
		transform_btn = area.pushbutton("TRANSFORM").fixed_height(20);
		area.button("RESET TRANSFORM").fixed_height(20).on_click([this](){
			group.transform_uv = [[x=0,y=0],[x=1,y=0],[x=1,y=1],[x=0,y=1]];
			group.transform_angle = 0;
			build_shader_flag = true;
		});
		area.button("MIRROR X").fixed_height(20).on_click([group](){
			for(i = 0; i < group.segments.size(); i++) {
				group.segments[i].start_pos.x = group.segments[i].start_pos.x;
				group.segments[i].end_pos.x = 1.0 - group.segments[i].end_pos.x;
				
				//TODO reverse direction for 
				//if(group.segments[i].height > 1)
				//	tmp = group.segments[i].start_pos.copy();
				//	group.segments[i].start_pos = group.segments[i].end_pos.copy();
				//	group.segments[i].end_pos = tmp;
			}
			build_shader_flag = true;
		});
		area.button("MIRROR Y").fixed_height(20).on_click([group](){
			for(i = 0; i < group.segments.size(); i++) {
				group.segments[i].start_pos.y = group.segments[i].start_pos.y;
				group.segments[i].end_pos.y = 1.0 - group.segments[i].end_pos.y;
				
				//TODO reverse direction for 
				//if(group.segments[i].height > 1)
				//	tmp = group.segments[i].start_pos.copy();
				//	group.segments[i].start_pos = group.segments[i].end_pos.copy();
				//	group.segments[i].end_pos = tmp;
			}
			build_shader_flag = true;
		});
		
		area.pushbutton("WRAP UNIVERSES").fixed_height(20).pushed(group.wrap_leds).on_change([this, group](v){
			group.wrap_leds = v;
			build_shader_flag = true;
		});
		
		edit_segments_btn.on_change([transform_btn](v) {
			if(v)
				transform_btn.pushed(false);
		});
		
		transform_btn.on_change([edit_segments_btn](v) {
			if(v)
				edit_segments_btn.pushed(false);
		});
		
		area.visible(false);
		
		build_segments();
	}
	
	build_segments() {
		segments = [];
		
		for(i = 0; i < group.segments.size(); i++) {
			seg = FixtureSegment(this, group, i);
			segments.push_back(seg);
		}
		
		scene_control_area.refresh_layout();
	}
	
	on_drag_start(uv) {
		if(transform_btn.pushed()) {
			transform_uv_select = -1;
	
			for(i = 0; i < group.transform_uv.size(); i++)
			{
				rel_vec = uv - vec2f(group.transform_uv[i][0], group.transform_uv[i][1]);
				if(rel_vec.length() < 0.1)
					transform_uv_select = i;
					break;
			}
			
			transform_uv_drag = group.transform_uv.copy();
			
			return 1;
			
		}
	}
	
	on_drag(uv, rel) {
		if(transform_btn.pushed()) {
	
			if(transform_uv_select == -1)
			{
				for(i = 0; i < group.transform_uv.size(); i++)
				{
					transform_uv_drag[i][0] += rel.x;
					transform_uv_drag[i][1] += rel.y;
				}
			}					
			if(transform_uv_select == 0)
			{
				transform_uv_drag[0][0] += rel.x;
				transform_uv_drag[0][1] += rel.y;
				
				transform_uv_drag[1][1] += rel.y;
				transform_uv_drag[3][0] += rel.x;							
			}
			
			if(transform_uv_select == 1)
			{
				transform_uv_drag[1][0] += rel.x;
				transform_uv_drag[1][1] += rel.y;
				
				transform_uv_drag[0][1] += rel.y;
				transform_uv_drag[2][0] += rel.x;							
			}
			
			if(transform_uv_select == 2)
			{
				transform_uv_drag[2][0] += rel.x;
				transform_uv_drag[2][1] += rel.y;
				
				transform_uv_drag[3][1] += rel.y;
				transform_uv_drag[1][0] += rel.x;							
			}
			
			if(transform_uv_select == 3)
			{
				transform_uv_drag[3][0] += rel.x;
				transform_uv_drag[3][1] += rel.y;
				
				transform_uv_drag[2][1] += rel.y;
				transform_uv_drag[0][0] += rel.x;							
			}
			
			group.transform_uv = quantize_transform(transform_uv_drag);
			
			build_shader_flag = true;
		}
	}
	
	on_drag_end(start_uv, end_uv) {
		if(edit_segments_btn.pushed())
			new_segment(start_uv, end_uv);
	}
	
	
	draw(ctx, is_active) {
		if(group.segments ?? false)
		{
			if(transform_btn.pushed()) {
				
				ctx.nvgBeginPath();
				ctx.nvgStrokeColor(vec4f(1,0,0,0.6));
				ctx.nvgStrokeWidth(3);
				
				rs = shader.render_size();
				psw = rs.x;
				psh = rs.y;
				
				ctx.nvgMoveTo(vec2f(group.transform_uv[0][0]*psw,group.transform_uv[0][1]*psh));
				
				for(i = 0; i < group.transform_uv.size(); i++)
				{	
					ctx.nvgLineTo(vec2f(group.transform_uv[i][0]*psw,group.transform_uv[i][1]*psh));
					
					if(i == transform_uv_select)
					{
						ctx.nvgStroke();
						ctx.nvgBeginPath();
						ctx.nvgStrokeColor(vec4f(1,1,0,0.6));
						ctx.nvgStrokeWidth(5);
					}
					
					ctx.nvgCircle(vec2f(group.transform_uv[i][0]*psw,group.transform_uv[i][1]*psh), 5 * (transform_uv_select + 1));
					
					if(i == transform_uv_select)
					{
						ctx.nvgStroke();
						ctx.nvgBeginPath();
						ctx.nvgStrokeColor(vec4f(1,0,0,0.6));
						ctx.nvgStrokeWidth(3);
					}
					
					ctx.nvgMoveTo(vec2f(group.transform_uv[i][0]*psw,group.transform_uv[i][1]*psh));
				}
				
				ctx.nvgLineTo(vec2f(group.transform_uv[0][0]*psw,group.transform_uv[0][1]*psh));
				ctx.nvgStroke();
			
			
				uv_min = vec2f(group.transform_uv[0][0],group.transform_uv[0][1]) * vec2f(psw, psh);
				uv_max = vec2f(group.transform_uv[2][0],group.transform_uv[2][1]) * vec2f(psw, psh);
				uv_middle = uv_min + (uv_max - uv_min) / 2.0;
				
				ctx.nvgSave();
				
				ctx.nvgTranslate(vec2f(uv_middle[0], uv_middle[1]));
				angle_deg = group.transform_angle;
				ctx.nvgRotate(angle_deg * math.PI / 180.0);
				ctx.nvgTranslate(vec2f(-uv_middle[0], -uv_middle[1]));
				
				ctx.nvgTranslate(vec2f(uv_min[0], uv_min[1]));
				ctx.nvgScale(vec2f(group.transform_uv[2][0] - group.transform_uv[0][0], group.transform_uv[2][1] - group.transform_uv[0][1]));
				
				draw_segments(ctx, is_active);
				
				ctx.nvgTranslate(vec2f(0-uv_min[0], 0-uv_min[1]));
				
				ctx.nvgRestore();
				
			}
			else
				draw_segments(ctx, is_active);
			
		}
	}
	
	draw_segments(ctx, is_active) {
		draw_color = is_active ? vec4f(0.0, 0.4, 0.8, 0.8) : vec4f(0.8, 0.8, 0.8, 0.6);
			
		for(i = 0; i < group.segments.size(); i++) {
			
			seg = group.segments[i];
			
			if(seg.height == 1) {
				start_pos = json_to_vec(seg.start_pos) * shader.size();
				end_pos = json_to_vec(seg.end_pos) * shader.size();

				ctx.nvgBeginPath();
			
				ctx.nvgMoveTo(vec2f(start_pos.x, start_pos.y));
				ctx.nvgLineTo(vec2f(end_pos.x, end_pos.y));
				ctx.nvgStrokeWidth(10.0);
				ctx.nvgStrokeColor(draw_color);
				ctx.nvgStroke();
			}
			else {
				ctx.nvgBeginPath();
				
				led_count = seg.width;
				led_height = seg.height;
				
				start_pos = json_to_vec(seg.start_pos) * shader.size();
				end_pos = json_to_vec(seg.end_pos) * shader.size();
				
				led_diff = end_pos - start_pos;
				perp = vec2f(led_diff.y, 0 - led_diff.x);
				perp.normalize();
				
				//make vector same length as out square formed by the points
				perp *= led_diff.length();
				perp_step = perp / std.float(led_height-1);
				//half perp cuz we go from the middle
				perp /= 2.0;
				
				perp_start = start_pos - perp;
				perp_end = end_pos - perp;
				

				for(j = 0; j < led_height; j++)
				{
					ctx.nvgMoveTo(vec2f(perp_start.x,perp_start.y));
					ctx.nvgLineTo(vec2f(perp_end.x, perp_end.y));
					perp_start += perp_step;
					perp_end += perp_step;
				}
				
				ctx.nvgStrokeWidth(10.0);
				ctx.nvgStrokeColor(draw_color);
				
				ctx.nvgStroke();
			}
		}
	}
	
	//NORMALIZED coords!
	new_segment(start_pos, end_pos) {
		if(!group.segments)
			group.segments = [];
		
		last_seg = group.segments ? group.segments[-1] : None;
		
		last_width = last_seg ? last_seg.width : 1;
		last_height = last_seg ? last_seg.height : 1;
		last_rgb_type = last_seg ? last_seg.rgb_type : 1;
		last_rgbw = last_seg ? last_seg.is_rgbw : 0;
		
		group.segments.push_back([
			name = "Segment " + (group.segments.size()+1),
			start_pos = vec_to_json(start_pos),
			end_pos = vec_to_json(end_pos),
			universe = -1,
			channel = -1,
			width = last_width,
			height = last_height,
			rgb_type = last_rgb_type,
			is_rgbw = last_rgbw,
		]);
		
		build_segments();
		build_shader_flag = true;
	}		
}

class FixtureScene {	
	scene = None; //Direct shared pointer to the corresponding fixture_scenes entry
	scene_index = 0;
	
	managed groups = [];
	
	managed top_group_area = None;
	managed group_area = None;
	managed select_div = None;
	managed select_btn = None;
	
	group_counter = 1;
	
	active_group_btn = None;
	
	__init__(index) {
		scene_index = index;
		scene = fixture_scenes[scene_index];

		select_div = scene_area.widget().fixed_height(25).anchor_left(0).anchor_right(0);
		select_btn = select_div.pushbutton(">").anchor_left(0).fixed_width(25);
		save_btn = select_div.button("S").anchor_left(25).fixed_width(25);
		scene_name = select_div.textbox(scene.name).anchor(0).anchor_right(25).anchor_left(50);
		scene_name.on_change([this, scene](v){
			scene.name = v;
		});
		delete_btn = select_div.button("X").anchor_right(0).fixed_width(25);
		
		select_btn.on_change([this, select_btn](v){
			select_btn.caption(v ? "v" : ">");
		
			select_group(v);
			select_btn.pushed(v);
		});
		
		save_btn.on_click([save_btn, scene](){
			form = [
				[id="name",  	label="Preset Name",  	type="text",   	placeholder = scene.name],
			];
			
			engine = std.global("engine");
			res = engine.screen.modal_form(form, "Save preset", "save", "cancel");		
			if(res.choice != "submit")
				return;
			
			//std.print(res);
			
			if(!res.values.name)
				return;
			
			save_scene = scene.copy();
			save_scene.type = "scene";
			fileio.write_json(preset_save_path + "scenes/" + res.values.name + ".json", save_scene);
		});
		
		delete_btn.on_click([this, index](){
			fixture_scenes.erase(index);
			build_scenes();
			build_shader_flag = true;
		});
	}
	
	select_group(selected = true) {
		
		for(i = 0; i < scene_instances.size(); i++) {
			scene_instances[i].groups = [];
			scene_instances[i].select_btn.pushed(false);
		}
		
		top_group_area = None;
		active_scene = None;
		
		if(!selected)
			return;
		
		active_scene = this;

		top_group_area = scene_control_area.widget().anchor(0).layout(nanogui.layout_vertical());
		
		add_group_btn = top_group_area.button("Add Group");
		add_group_btn.on_click([this, scene](){
			if(!scene.groups)
				scene.groups = [];
			this.group_counter++;
			scene.groups.push_back([
				name="New Group " + this.group_counter,
				start_universe = 0,
				start_channel = 0,
				max_brightness = 1.0,
				wrap_leds = false,
				transform_uv = [[x=0,y=0],[x=1,y=0],[x=1,y=1],[x=0,y=1]],
				transform_angle = 0,
			]);
			
			build_groups();
		});
		
		top_group_area.pushbutton("Snap to Grid").pushed(snap_to_grid).on_change([](v){ snap_to_grid = v; });
		
		grid = create_splitter(top_group_area, "Grid").intbox().anchor(0).value(current_grid);
		grid.value_callback([](v){
			current_grid = v;
		});
		
		build_groups();
	}
	
	build_groups() {
		
		groups = [];
		
		group_area = scene_control_area.vscroll().anchor(0).anchor_top(100);
		group_area.content().layout(nanogui.layout_vertical());
		
		for(i = 0; i < scene.groups.size(); i++) {
			group = FixtureGroup(this, scene, i);
			groups.push_back(group);
		}
		
		group_counter = groups.size();
		
		scene_control_area.refresh_layout();
	}

	draw_groups(ctx) {
		if(!groups)
			return;
		for(i = 0; i < groups.size(); i++) {
			if(groups[i] != active_group)
				groups[i].draw(ctx, false);
		}
	}
}

build_scenes() {
	
	scene_instances = [];
	
	// Very special function, this avoids reloading same project GUID's while the current objects may not be destroyed yet
	for(!scene_area.screen().garbage_cleared()) {
		std.sleep(0);
	}
	
	for(i = 0; i < fixture_scenes.size(); i++) {
		scene = FixtureScene(i);
		scene_instances.push(scene);
	}
}

traverse_segment(led_buffer, group, segment) {
	
	// Remember where this segment starts in the buffer.
	// We need this so the transform below only affects this segment.
	buffer_start = led_buffer.size();
	
	led_width = math.max(1, segment.width);
	led_height = math.max(1, segment.height);
	
	count = led_width * led_height;
	
	led_start = vec2f(segment.start_pos.x, segment.start_pos.y);
	led_end = vec2f(segment.end_pos.x, segment.end_pos.y);
	
	
	// ------------------------------------------------------------
	// Generate LED coordinates
	// ------------------------------------------------------------
	
	if(led_height == 1) {
		
		// Simple 1D segment
		
		for(i = 0; i < led_width; i++) {
			
			t = 0.0;
			if(led_width == 1)
				t = 0.5;
			else
				t = i / std.float(led_width - 1);
			
			perc_inv = 1.0 - t;
			
			vcur = led_start * perc_inv + led_end * t;
			
			led_buffer.push_back(vcur.x);
			led_buffer.push_back(vcur.y);
			led_buffer.push_back(segment.rgb_type);
			led_buffer.push_back(segment.is_rgbw);
		}
	}
	else {
		
		// --------------------------------------------------------
		// 2D LED grid
		// --------------------------------------------------------
		
		// Direction and length of the main segment
		led_diff = led_end - led_start;
		segment_length = led_diff.length();
		
		
		// Create perpendicular vector
		perp = vec2f(led_diff.y, 0 - led_diff.x);
		
		
		// Normalize perpendicular direction
		if(segment_length > 0.0)
			perp.normalize();
		
		
		// Make the perpendicular vector the same length
		// as the main segment.
		//
		// This matches the drawing code:
		//
		// perp.normalize();
		// perp *= led_diff.length();
		//
		perp_full = perp * segment_length;
		
		
		// Center the grid around the original segment.
		// First row starts at -0.5 * perpendicular length.
		perp_start = perp_full * -0.5;
		
		
		// Distance between rows
		row_step = perp_full / std.float(led_height - 1);
		
		
		switch_lines = false;
		
		
		for(j = 0; j < led_height; j++) {
			
			// Offset this row perpendicular to the segment
			row_offset = perp_start + row_step * j;
			
			row_start = led_start + row_offset;
			row_end   = led_end + row_offset;
			
			
			// Serpentine LED ordering:
			//
			// Row 0: ---->
			// Row 1: <----
			// Row 2: ---->
			// Row 3: <----
			
			if(switch_lines) {
				
				for(i = 0; i < led_width; i++) {
					t = 0.0;
					if(led_width == 1)
						t = 0.5;
					else
						t = i / std.float(led_width - 1);
					
					// Reverse interpolation
					vcur = row_end * (1.0 - t) + row_start * t;
					
					led_buffer.push_back(vcur.x);
					led_buffer.push_back(vcur.y);
					led_buffer.push_back(segment.rgb_type);
					led_buffer.push_back(segment.is_rgbw);
				}
			}
			else {
				
				for(i = 0; i < led_width; i++) {
					t = 0.0;
					if(led_width == 1)
						t = 0.5;
					else
						t = i / std.float(led_width - 1);
					
					// Normal interpolation
					vcur = row_start * (1.0 - t) + row_end * t;
					
					led_buffer.push_back(vcur.x);
					led_buffer.push_back(vcur.y);
					led_buffer.push_back(segment.rgb_type);
					led_buffer.push_back(segment.is_rgbw);
				}
			}
			
			
			switch_lines = !switch_lines;
		}
	}
	
	
	// ------------------------------------------------------------
	// Apply group UV transform
	// ------------------------------------------------------------
	
	u_min = group.transform_uv[0][0];
	v_min = group.transform_uv[0][1];
	
	u_max = group.transform_uv[2][0];
	v_max = group.transform_uv[2][1];
	
	
	// Rotation
	angle_deg = group.transform_angle;
	angle_rad = angle_deg * math.PI / 180.0;
	
	cosA = math.cos(angle_rad);
	sinA = math.sin(angle_rad);
	
	
	// Center of the transform area
	cx = (u_min + u_max) * 0.5;
	cy = (v_min + v_max) * 0.5;
	
	
	// IMPORTANT:
	//
	// Only transform LEDs generated by THIS traverse_segment call.
	//
	// Previously:
	//
	// for(i = 0; i < led_buffer.size(); i += 4)
	//
	// caused every previous segment to be transformed again.
	
	for(i = buffer_start; i < led_buffer.size(); i += 4) {
		
		u = led_buffer[i];
		v = led_buffer[i + 1];
		
		
		// Map normalized segment coordinates into
		// the group's transform UV rectangle.
		
		u_mapped = u_min + u * (u_max - u_min);
		v_mapped = v_min + v * (v_max - v_min);
		
		
		// Rotate around the center of transform_uv
		
		dx = u_mapped - cx;
		dy = v_mapped - cy;
		
		
		u_rot = cx + dx * cosA - dy * sinA;
		v_rot = cy + dx * sinA + dy * cosA;
		
		
		led_buffer[i]     = u_rot;
		led_buffer[i + 1] = v_rot;
	}
	
	
	return count;
}

traverse_group(led_buffer, group) {
	
	optimized_fixture_scenes.push_back([segments=[], device_mac=group.device_mac, wrap_leds=group.wrap_leds]);
	
	optimized_group = optimized_fixture_scenes[-1];
	
	last_uni = group.start_universe;
	last_chan = group.start_channel;
	last_rgb_type = -1;
	last_rgbw = -1;
	
	for(i = 0; i < group.segments.size(); i++) {
		seg = group.segments[i];
		led_count = traverse_segment(led_buffer, group, seg);	

		if(group.channel_gap == 0 && seg.universe == -1 && seg.channel == -1 &&
			seg.rgb_type == last_rgb_type && seg.is_rgbw == last_rgbw) {
			//Continous segment, can merge
			optimized_group.segments[-1].count += led_count;
			if(seg.rgb_type == 0)
				last_chan += led_count;
			else(seg.is_rgbw)
				last_chan += led_count * 4;
			else
				last_chan += led_count * 3;
		}
		else {
			
			if(seg.universe != -1)
				last_uni = seg.universe;
			
			if(seg.channel != -1)
				last_chan = seg.channel;
			
			last_rgb_type = seg.rgb_type;
			last_rgbw = seg.is_rgbw;
			
			optimized_group.segments.push_back([
				universe = last_uni,
				channel = last_chan,
				rgb_type = seg.rgb_type,
				is_rgbw = seg.is_rgbw,
				count = led_count,
			]);
			
			if(group.channel_gap)
				last_chan += group.channel_gap;
			else {
				if(seg.rgb_type == 0)
					last_chan += led_count;
				else(seg.is_rgbw)
					last_chan += led_count * 4;
				else
					last_chan += led_count * 3;
			}
		}
	}
}

traverse_scene(led_buffer, scene) {
	for(i = 0; i < scene.groups.size(); i++) {
		traverse_group(led_buffer, scene.groups[i]);
	}
}

build_shader() {
	
	led_buffer = [];
	optimized_fixture_scenes = [];
	
	for(i = 0; i < fixture_scenes.size(); i++) {
		traverse_scene(led_buffer, fixture_scenes[i]);
	}
	
	total_pixel_count = led_buffer.size() / 4; //Because 4 component float texture
	
	led_coords_buffer.size(vec2i(total_pixel_count, 1));
	led_coords_buffer.upload_data(led_buffer);
	
	led_shader.render_size(vec2i(total_pixel_count, 1));
	led_shader.keep_aspect_ratio(false);
	led_shader.input("input", shader);
	led_shader.input("led_coords", led_coords_image);
	led_shader.output_component_format("uint8");
	led_shader.output_pixel_format("rgb");
}

update_pre(generator, tl_pos, delta) {
	//Set artnet buffer here so PhaserGroup always overwrites it?
	if(build_shader_flag) {
		build_shader_flag = false;
		build_shader();
		return;
	}	

	buffer = led_shader.pixel_buffer();
	
	for(i = 0; i < optimized_fixture_scenes.size(); i++) {
		group = optimized_fixture_scenes[i];
		
		if(!group.dev) {
			if(group.device_mac)
				group.dev = net.find_artnet_device(group.device_mac);
			if(!group.dev)
				continue;
		}
		
		led_offset = 0;
		channel_offset = 0;
		for(j = 0; j < group.segments.size(); j++) {
			seg = group.segments[j];
			num_channels = 3;
			if(seg.rgb_type == 0)
				num_channels = 1;
			else if(seg.is_rgbw)
				num_channels = 4;
			
			if(seg.channel >= 0)
				channel_offset = seg.channel;

			if(seg.custom_device_mac) {
				if(!seg.dev)
					seg.dev = net.find_artnet_device(seg.custom_device_mac);
				if(seg.dev)
					seg.dev.set_artnet_buffer(seg.universe, channel_offset, buffer, led_offset*3, seg.count*3, group.wrap_leds, 3, num_channels);
			}
			else if(group.dev)
				group.dev.set_artnet_buffer(seg.universe, channel_offset, buffer, led_offset*3, seg.count*3, group.wrap_leds, 3, num_channels);
			
			led_offset += seg.count;
			channel_offset += led_offset * num_channels;
		}
	}
}

