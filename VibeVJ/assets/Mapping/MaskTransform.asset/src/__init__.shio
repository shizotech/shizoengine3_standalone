
using eigen;

managed map = None;

in_ctrl = None;
out_ctrl = None;

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return None;
		
		map.rendering_enabled(value);
	}
	
	if(cmd == "get_default_input")
		return in_ctrl;
	
	if(cmd == "get_default_output")
		return out_ctrl;
	
	return None;
}

entry(generator, area) {

	//One input source -> stage 1 (input mask) -> transfer -> stage 2 (output mask transform)
	map = area.warp_mapper().anchor(0).anchor_bottom(25);
	
	//The output texture size follows the input source (auto sizing). output_size() sets a fixed
	//size and switches to manual, auto_output_size(1) switches back. Without an input the last
	//requested size (512x512) is used.
	//map.output_size(vec2i(1280, 720)); //If you need to set the resolution manually, else it is derived from the input.
	//map.auto_output_size(1);
	
	map.view("input");

	//Stage 1: the input is drawn as background. Shift+click adds a mask vertex,
	//right click deletes one, a left drag inside the mask moves the whole contour.
	//Use the Hole button (or H) for an inner contour, I to invert keep/erase, A to toggle auto output sizing.
	map.mask_rect(vec2f(0.0, 0.0), vec2f(1.0, 1.0));

	//Transfer freezes the mask and builds the independent output transform.
	//Transferring again after a mask edit only updates the committed mask shape, the output vertices
	//stay exactly where you left them. map.transfer_mask(1) rebuilds them from the current mask.
	//map.transfer_mask();

	//Stage 2: only the destination points move, the mask shape stays fixed.
	//map.view("output");
	//map.show_triangulation(1);
	//map.set_destination(0, vec2f(0.15, 0.05));
	//map.move_destination(vec2f(0.02, 0.00));

	//Output mesh subdivision: the sampling grid is uniform over the input mask and every grid point
	//gets its output position from the control points, so the surface bends between them instead of
	//folding along a straight triangle seam. 0 and 1 render the raw triangles only, 32 is the
	//maximum, and masks with many points are capped automatically. PgUp/PgDn changes it live.
	//map.subdivisions(24);

	//Warp mode decides how the mesh between the control points is sampled. 'affine' renders the raw
	//triangles, 'smooth' blends over the whole contour so the surface bends freely, and 'projective'
	//fits a homography to the control point pairs, which is the exact warp of a flat surface seen
	//from another viewpoint: lines stay straight, so it relies on subdivisions to follow the
	//perspective between the control points. The Warp button and the W key cycle the modes,
	//warp_fit_error() reports how projective the current output actually is.
	//map.warp_mode("projective");

	//The mask border is rasterized into the output texture, so the warp pass renders into a
	//multisampled buffer that is resolved into it. 4 samples is the default, 0 or 1 disables
	//multisampling and 16 is the maximum; used_antialias_samples() reports the active count.
	//map.antialias_samples(8);

	//Convenience: map.reset() puts both stages back to the full rectangle (Reset button / R key).
	//grid(1) shows a snap grid, grid_snap(1) enables snapping and grid_divisions(n) sets the cell
	//count (2..64). The G key toggles display and snapping together, held Ctrl skips snapping while
	//editing, and snap_points() snaps the selected point or the whole stage (S key).
	//map.grid(1);
	//map.grid_divisions(16);

	//Arrow keys nudge the selected point, or the whole stage when nothing is selected, by whole
	//texture pixels of the view being edited: one texel of the input resolution while the mask is
	//open, one texel of the output resolution in the transform. Shift moves ten pixels, Ctrl a tenth
	//of a pixel for sub pixel placement. keyboard_step_pixels(n) scales the step and 0 disables
	//nudging. With grid snapping the arrows move whole cells instead.
	//map.keyboard_step_pixels(1.0);

	//Output stage helpers that only move points: mirror_output(1) flips left/right (0 flips top to
	//bottom), rotate_output(1) turns by 90 degrees, fit_output(min, max) scales the current bounding
	//box into a rectangle, center_output()/center_mask() move a stage onto a target UV.
	//mask_bounds() and output_bounds() return [min, max] vec2 values of each stage.
	//map.fit_output(vec2f(0.1, 0.1), vec2f(0.9, 0.9));

	//Presets: serialize() returns the full widget state as a JSON object and deserialize()
	//loads it back. json.compact_string() turns it into text for fileio, deserialize() also
	//accepts that text directly. Every mask point is a normalized input UV, so switching the
	//input source or loading a preset never resets them. Inputs are not stored in a preset,
	//an already bound input stays bound.
	//preset = map.serialize();
	//fileio.write_text("mapping/warp.json", preset.compact_string());
	//map.deserialize(fileio.read_text("mapping/warp.json"));

	in_ctrl = area.control("IN").anchor_left(0).anchor_right(0.5, "percent").anchor_bottom(0).fixed_height(25);
	in_ctrl.callback([](v){
		map.input(v);
	});
	
	out_ctrl = area.control("OUT").anchor_right(0).anchor_left(0.5, "percent").anchor_bottom(0).fixed_height(25).fixed_width(35);
	out_ctrl.callback([out_ctrl](v){
		out_ctrl.value(map); //Dont allow override...
	});
	out_ctrl.value(map);
}

save_state() {
	return map.serialize();
}

load_state(state) {
	map.deserialize(state);
}