
using eigen;

managed projection_area = None;

managed inputs = [];
managed outputs = [];

add_input_btn = None;

//TODO: wenn ein input hinzugefügt wird für die slices einfach nen viereck anzeigen ud sobald shader gelinked ist dessen rendersize nehmen !
//Einfacher passtrough shader code

entry(generator, area) {
	area.layout(None);

	projection_area = area.scrollarea().anchor_left(150).anchor_right(150).anchor_top(0).anchor_bottom(0).content();
	
	add_input_btn = area.button("Add Input").anchor_top(0).anchor_left(0).fixed_width(150).fixed_height(30);
		
	add_output_btn = area.button("Add Output").anchor_top(0).anchor_right(0).fixed_width(150).fixed_height(30);
	
	input_area = area.vscroll().anchor_left(0).anchor_top(60).fixed_width(150).content().layout(nanogui.layout_vertical());
	
	add_input_btn.on_click([input_area](){
		btn = input_area.pushbutton("Input #" + (inputs.size()+1)).fixed_height(35);
		area = input_area.widget().layout(nanogui.layout_vertical()).visible(false);
	
		add_slice_btn = area.button("Add Slice").fixed_height(30);
	
		inputs.push_back([
			btn = btn,
			slice_btn = add_slice_btn,
			area = area,
			slices = [],
		]);
		
		current_input = inputs[-1];
		
		add_slice_btn.on_click([current_input](){
			
			shader_slice = projection_area.shader().size(vec2f(300,200));
			
			shader_slice.projection_enabled(true);
			
			shader_slice.on_mouse_button([shader_slice, current_input](pos, btn, down, mod) {
				std.print(pos);
				if(btn == 0 && down) {
					
					current_input.dragging = true;
					current_input.drag_corner = -1;
					
					position = shader_slice.position();
					size = shader_slice.size();

					local_pos = pos;

					border = 10;

					left   = local_pos.x < border;
					right  = local_pos.x > size.x - border;
					top    = local_pos.y < border;
					bottom = local_pos.y > size.y - border;

					// Current aspect ratio
					aspect = size.x / size.y;

					if(left && top) {
						// Top-left: bottom-right remains fixed
						current_input.drag_corner = 1;
					}
					else if(right && top) {
						// Top-right: bottom-left remains fixed
						current_input.drag_corner = 2;
					}
					else if(left && bottom) {
						// Bottom-left: top-right remains fixed
						current_input.drag_corner = 3;
					}
					else if(right && bottom) {
						// Bottom-right: top-left remains fixed
						current_input.drag_corner = 4;
					}
				}
				else
					current_input.dragging = false;
				
				if(btn == 0)
					return true;
				return false;
			});
			
			shader_slice.on_mouse_drag([shader_slice, current_input](pos, rel, btn, mod) {
				if(!current_input.dragging)
					return false;

				position = shader_slice.position();
				size = shader_slice.size();

				// Mouse position relative to the slice
				local_pos = pos - position;

				border = 10;

				left   = local_pos.x < border;
				right  = local_pos.x > size.x - border;
				top    = local_pos.y < border;
				bottom = local_pos.y > size.y - border;

				// Current aspect ratio
				aspect = size.x / size.y;

				if(current_input.drag_corner == 1) {
					// Top-left: bottom-right remains fixed
					anchor = position + size;

					new_width = size.x - rel.x;
					new_height = new_width / aspect;

					new_size = vec2f(new_width, new_height);

					shader_slice.size(new_size);
					shader_slice.position(anchor - new_size);
				}
				else if(current_input.drag_corner == 2) {
					// Top-right: bottom-left remains fixed
					anchor = vec2f(
						position.x,
						position.y + size.y
					);

					new_width = size.x + rel.x;
					new_height = new_width / aspect;

					new_size = vec2f(new_width, new_height);

					shader_slice.size(new_size);
					shader_slice.position(
						vec2f(
							anchor.x,
							anchor.y - new_size.y
						)
					);
				}
				else if(current_input.drag_corner == 3) {
					// Bottom-left: top-right remains fixed
					anchor = vec2f(
						position.x + size.x,
						position.y
					);

					new_width = size.x - rel.x;
					new_height = new_width / aspect;

					new_size = vec2f(new_width, new_height);

					shader_slice.size(new_size);
					shader_slice.position(
						vec2f(
							anchor.x - new_size.x,
							anchor.y
						)
					);
				}
				else if(current_input.drag_corner == 4) {
					// Bottom-right: top-left remains fixed
					new_width = size.x + rel.x;
					new_height = new_width / aspect;

					shader_slice.size(
						vec2f(new_width, new_height)
					);
				}
				else {
					// Move
					shader_slice.position(position + rel);
				}
				
				return true;
			});
			
			shader_slice.on_draw([](){
				ctx = nanogui.current_context();
				ctx.nvgBeginPath();
				ctx.nvgMoveTo(vec2f(0,0));
				ctx.nvgLineTo(vec2f(200,200));
				ctx.nvgStrokeColor(vec4f(1,0,0,1));
				ctx.nvgStrokeWidth(3);
				ctx.nvgStroke();
			});

			select_slice_btn = current_input.area.button("Slice #" + (current_input.slices.size()+1));

			current_input.slices.push_back([
				btn = select_slice_btn,
			]);
		});
		
		btn.on_change([btn, area, current_input, add_slice_btn](v){
			area.visible(v);
		});
	});
}

save_state() {
	saved_inputs = [];
	
	for(i = 0; i < inputs.size(); i++) {
		saved_inputs.push_back([
			name="test",
		]);
	}
	
	return [
		inputs=saved_inputs,
	];
}

load_state(state) {
	
	inputs = [];
	outputs = [];
	
	add_input_fn = add_input_btn.on_click();
	
	std.print(state);
	
	for(i = 0; i < state.inputs.size(); i++) {
		add_input_fn();
	}
}