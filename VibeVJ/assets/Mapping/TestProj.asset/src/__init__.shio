
using eigen;

entry(generator, area) {
	area.layout(nanogui.layout_vertical());
	
	//2) the mapper is itself a shader source
	map = area.warp_mapper();
	map.output_size(vec2i(1280, 720));
	map.add_source("pattern");

	//3) surfaces: source rect -> destination rect (all 0..1 normalized)
	a = map.add_surface("panel", 0);
	a.rect(vec2f(0.10, 0.10), vec2f(0.90, 0.90), vec2f(0.15, 0.10), vec2f(0.85, 0.90));
	a.add_vertex(vec2f(0.50, 0.05), vec2f(0.50, 0.02));   //arbitrary polygon

	b = map.add_surface("corner", 0);
	b.rect(vec2f(0.0, 0.0), vec2f(0.30, 0.30), vec2f(0.02, 0.55), vec2f(0.25, 0.95));

	map.edit_mode("destination");
	map.show_triangulation(1);
	
	in_ctrl = area.control("IN").anchor_bottom(0).anchor_left(0).anchor_right(0.5,"percent").fixed_height(25);
	in_ctrl.callback([map](v){
		map.set_source(0, v);
	});
}