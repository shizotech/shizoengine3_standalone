
#include "engine/generators/singleview"

managed tabs = None;

managed all_tabs = [];

ai_docs = R"(
The tab view can hold multiple tabs.
)";

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return None;
	}
	
	for(i = 0; i < all_tabs.size(); i++) {
		all_tabs[i].view.dispatch(cmd, value);
	}
	
	return None;
}

add_new_tab(index = -1, name = None, guid = "") {
	
	new_tab = index >= 0 ? tabs.insert_tab(index, name ?? "New Tab") : tabs.add_tab(name ?? "New Tab");
	new_node = new_tab.matrixnode("", guid).anchor(0);
	new_view = singleview(new_node);
	new_view.area.anchor(0);
	
	all_tabs.push_back([
		tab = new_tab,
		view = new_view,
		node = new_node,
	]);
	
	if(index >= 0)
		tabs.tab(index);
	
	return new_view;
}

entry(generator, parent) {
	
	tabs = parent.tabwidget();
	tabs.movable(false); //Re-edit the code to work with this, have to dynamically resolve the correct tab widget from all_tabs
	tabs.closeable(true);
	
	add_new_tab(-1);
	
	tabs.on_double_click([generator](index) {
		
		if(tabs.tab_name(index) == "+")
			return;
		
		form = [
			[id="name",  	label="Tab Name",  	type="text", placeholder = "New Tab"],
		];
		
		res = generator.engine.screen.modal_form(form, "Choose tab name", "ok", "cancel");		
		if(res.choice != "submit" || res.values.name == "+")
			return;
		
		tabs.tab_name(index, res.values.name);
	});
	
	tabs.on_close([tabs](index){
		
		accept = tabs.screen().modal_yes_no("Are you sure you want to remove this tab?", "Delete tab?");
		if(accept == "yes") {
			tabs.remove_tab(all_tabs[index].tab);
			all_tabs.erase(index);
		}
		/*
		real_index = -1;
		for(i = 0; i < all_tabs.size(); i++) {
			if(all_tabs[i].tab == tabs.tab_at(index))
				real_index = i;
				break;
		}
	
		if(real_index < 0)
			std.error("Cannot remove tab meta!");
			//tabs.remove_tab(index);
			return;
	
		if(all_tabs[real_index].view)
			std.free(all_tabs[real_index].view);
		if(all_tabs[real_index].node)
			std.free(all_tabs[real_index].node);
		all_tabs.erase(real_index);
		
		tabs.remove_tab(index);
		*/
	});

	//Register as last focused for the AI agent, since clipview is usually instanced in a window, use the parent for parent_widget (so the headerbar can be clicked too)
	generator.on_get_status([this](){
		
		current_items = [];
		
		for(i = 0; i < all_tabs.size(); i++) {
			current_items.push_back([
				name = tabs.tab_name(all_tabs[i].tab),
				index = i,
				item = "No item",
			]);
			
			if(all_tabs[i].view.item) {
				current_items[-1].item = [
					asset=all_tabs[i].view.item.get_relative_path(), 
					live_path=all_tabs[i].view.item.node.get_full_path(),
				];
			}
		}
		
		return current_items;
	});

	generator.register("add_tab", [path="Path to the generator asset or shader", tabname="Name of the new tab"], [this](args){
		
		if(!args.has("path") || !args.has("tabname"))
			return [ok=false, error="Needs 'path' and 'tabname' args."];
		
		new_item = add_new_tab(-1, args.tabname);
		
		if(new_item) {		
			new_item.add_generator(new_item.area, args.path);
			if(new_item.item)
				return [
					ok = true,
					status = "New generator was set.",
				];
		}
		
		return [
			ok = false,
			error = "Could not add generator.",
		];
		
	}, "Add a new tab and initialize it with a generator or view.");

	generator.register("remove_tab_at", [index="Index number of the tab"], [this](args){
		
		if(!args.has("index"))
			return [ok=false, error="Needs 'index' arg."];
		
		if(args.index >= 0 && args.index < all_tabs.size())
			tabs.remove_tab(all_tabs[args.index].tab);
			all_tabs.erase(args.index);
			return [ok=true, status="Removed tab."];
			
		return [
			ok = false,
			error = "Could not remove tab.",
		];
		
	}, "Remove a tab by index.");

	tabs.on_dragdrop_hover([](payload, pos) {
		return true;
	});
	
	tabs.on_dragdrop([this, tabs](payload, pos) {
		view = add_new_tab(-1, fileio.pure_name(payload.path));
		path = fileio.relative_path_cwd(payload.path);	
		view.add_generator(view.area, path);
		//Handle payload.paths for multi-file later...
		
		return true;
	});

	//Add one tab...
	//cb = tabs.on_change();
	//cb(0);
}

find_view(tab) {
	for(i = 0; i < all_tabs.size(); i++) {
		if(tabs.tab_at(i) == tab)
			return all_tabs[i];
	}
	
	return None;
}

save_state() {
	state = [tabs=[],selected=tabs.tab()];
	
	for(i = 0; i < all_tabs.size(); i++) {
		try {
			state.tabs.push_back([
				name=tabs.tab_name(all_tabs[i].tab),
				view=all_tabs[i].view.save_state(),
				guid=all_tabs[i].node.guid(),
			]);
		}
		catch(e) {}
	}
	
	return state;
}

load_state(state) {
	
	tabs.remove_all_tabs();
	
	all_tabs = [];
	
	for(!tabs.screen().garbage_cleared()) {
		std.sleep(0);
	}
	
	for(i = 0; i < state.tabs.size(); i++) {
		new_view = add_new_tab(-1, state.tabs[i].name, state.tabs[i].guid);
		try {
			new_view.load_state(state.tabs[i].view);
		}
		catch(e) {}
	}
	
	tabs.tab(state.selected);
}