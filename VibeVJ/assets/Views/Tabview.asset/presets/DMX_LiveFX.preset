                                            "fh": 700,
                                            "fw": 1000,
                                            "guid": "GLmWgYzImIN",
                                            "h": 523,
                                            "is_active": 1,
                                            "is_active_internal": 0,
                                            "is_big": 0,
                                            "path": "assets/Shaders/Sources/Basic/Radial_Line.glsl",
                                            "w": 727,
