                                                        "proj": [
                                                            {
                                                                "fragment_source": "/*---AUTOMATICALLY INJECTED HEADER CODE (NOT DIRECTLY PART OF THE SHADER ITSELF)---*/\nprecision highp float; uniform vec3 iResolution;  uniform float iTime;  uniform float iTimeDelta;  uniform int iFrame; \n//@slidervec4\nuniform vec4 iMouse;\nuniform vec4 iDate; uniform float iSampleRate; uniform sampler2D iChannel0; uniform sampler2D iChannel1; uniform sampler2D iChannel2; uniform sampler2D iChannel3; uniform int RenderMaskActive; uniform sampler2D RenderMaskInput;\n/*---*/\n\n// ==== Custom Uniform Controls ====\n\n//@rgba value=(1,0,0,1)\nuniform vec4 color;\n\n//@slider value=1\nuniform float brightness;\n\n//@slider value=0\nuniform float hue_rotate;\n\n\nvec4 shiftHue(in vec3 col, in float Shift)\n{\n    vec3 P = vec3(0.55735) * dot(vec3(0.55735), col);\n    vec3 U = col - P;\n    vec3 V = cross(vec3(0.55735), U);    \n    col = U * cos(Shift * 6.2832) + V * sin(Shift * 6.2832) + P;\n    return vec4(col, 1.0);\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    fragColor = color * brightness;\n\tfragColor = shiftHue(fragColor.rgb, hue_rotate);\n}\n\n/*AUTOMATICALLY INJECTED MAIN FUNCTION (NOT DIRECTLY PART OF THE SHADER ITSELF)*/ void main(){ vec4 new_color = vec4(0,0,0,0); vec2 n_coord = v_uv*iResolution.xy; if(RenderMaskActive == 1) { vec4 mask_color = texture(RenderMaskInput, v_uv); if(mask_color.rgb == vec3(0.0)) { fragColor = new_color; return; }} mainImage( new_color, n_coord ); fragColor = new_color;} /*---*/",
