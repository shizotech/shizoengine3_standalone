                                            "guid": "Jo3hzBe-BoJ",
                                            "h": 523,
                                            "is_active": 1,
                                            "is_active_internal": 0,
                                            "is_big": 0,
                                            "path": "assets/Shaders/Sources/Basic/CheckerboardPhaser.glsl",
                                            "w": 727,
