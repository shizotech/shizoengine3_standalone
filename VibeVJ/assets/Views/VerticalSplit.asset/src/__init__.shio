
#include "engine/generators/singleview"

managed split1 = None;
managed split2 = None;

managed view1 = None;
managed view2 = None;

ai_docs = R"(
This is a simple vertical splitter, capable of holding two generators or views on top of each other.

TOP_VIEW
--------
BOTTOM_VIEW
)";

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return;
	}
	
	view1.dispatch(cmd, value);
	view2.dispatch(cmd, value);
	
	return None;
}

entry(generator, parent) {
	split1 = parent.window().anchor(0).anchor_bottom(0.5,"percent").resizable_bottom(true).header_enabled(false);
	view1 = singleview(split1);
	split2 = parent.widget().anchor(0).anchor_top(0.5,"percent");
	view2 = singleview(split2);
	
	split1.on_resize([parent](size, old_size) {
		perc = size.y / parent.height();
		split1.anchor_bottom(1.0 - perc,"percent");
		split2.anchor_top(perc,"percent");
	});
	
	//Register as last focused for the AI agent, since clipview is usually instanced in a window, use the parent for parent_widget (so the headerbar can be clicked too)
	generator.on_get_status([this](){
		
		top_item = ["No item"];
		if(view1.item)
			top_item = [asset=view1.item.get_relative_path(), live_path=view1.item.node.get_full_path()];
		
		bottom_item = ["No item"];
		if(view2.item)
			bottom_item = [asset=view2.item.get_relative_path(), live_path=view2.item.node.get_full_path()];
		
		return [
			top_item = top_item,
			bottom_item = bottom_item,
			explanation = ai_docs,
		];
	});
	
	generator.register("set_item", [path="Path to the generator asset or shader", placement="Either one of 'TOP|BOTTOM'"], [this](args){
		
		if(!args.has("path") || !args.has("placement"))
			return [ok=false, error="Needs 'path' and 'placement' args."];
		
		new_item = None;
		
		if(args.placement == "TOP")
			new_item = view1.add_generator(view1.area, args.path);
		else if(args.placement == "BOTTOM")
			new_item = view2.add_generator(view2.area, args.path);
		
		if(new_item) {		
			return [
				ok = true,
				status = "New generator was set.",
			];
		}
		
		return [
			ok = false,
			error = "Could not add generator.",
		];
		
	}, "DANGEROUS: Set the generators, clears anything that is currently set.");
}

save_state() {
	return [
		view1 = view1.save_state(),
		view2 = view2.save_state(),
		split1_anchor = split1.anchor_bottom(),
		split2_anchor = split2.anchor_top(),	
	];
}

load_state(state) {
	if(state.split1_anchor ?? false)
		split1.anchor_bottom(state.split1_anchor, "percent");
	if(state.split2_anchor ?? false)
		split2.anchor_top(state.split2_anchor, "percent");
	view1.load_state(state.view1);
	view2.load_state(state.view2);
}