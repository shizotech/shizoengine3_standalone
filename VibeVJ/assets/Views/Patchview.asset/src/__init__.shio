
#include "engine/generators/generatorview"

managed view = None;

ai_docs = R"(
The patchview is a free node area where generators can be placed anywhere and linked with each other.
The user can move around and zoom around in it to build complex patches.
)";

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return;
	}
	
	return view.dispatch(cmd, value);
}

entry(generator, parent) {
	//A plain frame between the node and the canvas: the node lays its children out in a column, the frame lets the
	//zoom chip sit in its corner by anchors
	frame = parent.widget().anchor(0);
	view = generatorview(frame);
	//The patch view is there to see the patch: its nodes show their cables by default (#268)
	view.default_always_draw_links = true;
	//A canvas: dot grid with snapping, the zoom chip and its keys, new generators sized to their content on a free spot
	view.make_canvas(frame);

	//Register as last focused for the AI agent, since clipview is usually instanced in a window, use the parent for parent_widget (so the headerbar can be clicked too)
	generator.on_get_status([this](){
		
		current_items = [];
		
		for(i = 0; i < view.items.size(); i++) {
			item = view.items[i];
			entry = [
				asset=item.get_relative_path(), 
				live_path=item.node.get_full_path(),
				pos = std.string(item.window.position()),
			];
			//"size" is also the name of a method of a JSON object: a key of that name is set by index (AGENTS.MD,
			//Pitfalls), in the literal it was dropped and the AI never saw the sizes
			entry["size"] = std.string(item.window.size());
			current_items.push_back(entry);
		}
		
		return current_items;
	});
	
	generator.register("add_item", [path="Path to the generator asset or shader", x="X position of the new generator on the area (it moves into the visible part and to the nearest free spot if another generator is there)", y="Y position of the new generator on the area"], [this](args){
		
		if(!args.has("path") || !args.has("x") || !args.has("y"))
			return [ok=false, error="Needs 'path', 'x' and 'y' args."];
				
		managed cap = std.log_capture("error");   // or "all", "warn error", etc.
		item = view.add_generator(view.area, args.path, vec2f(args.x, args.y));
		if(item)
			view.settle_new(item); //sized to its content, moved to the nearest free spot if x, y is taken
		std.sleep(500);
		error_msg = cap.read(true);
		error_truncated = false;
		
		if(error_msg) {
			error_msg_lines = error_msg.split("\n");
			
			if(error_msg_lines.size() > 50) {
				error_msg = "";
				error_truncated = true;
				for(i = error_msg_lines.size() - 50; i < error_msg_lines.size(); i++) {
					error_msg += error_msg_lines[i] + "\n";
				}
			}
		}
		
		if(item) {		
		
			result = [
				ok = true,
				status = "New generator was added.",
				live_path=item.node.get_full_path(),
				pos = std.string(item.window.position()),
			];
			result["size"] = std.string(item.window.size()); //by index, see on_get_status
			if(error_msg) {
				result.status = "New generator was added, but produced error messages.";
				result.errors = error_msg;
				result.error_was_truncated = error_truncated;
			}
			return result;
		}
		
		if(error_msg) {
			return [
				ok = false,
				error = error_msg,
				error_was_truncated = error_truncated,
			];
		}
		
		return "Internal Error.";
		
	}, "Add a new generator to the area.");
}

//Called by the generator before this module goes (generator.free_module_content, #361): the managed globals of a
//module are not always released with it, and everything they hold then stays alive
on_free() {
	view = None;
}

save_state() {
	return view.save_state();
}

//Zoom and pan of the canvas, saved next to the state by the generator (generatoritem)
save_view() {
	return view.save_view();
}

load_view(v) {
	view.load_view(v);
}

load_state(state) {
	view.load_state(state);
}