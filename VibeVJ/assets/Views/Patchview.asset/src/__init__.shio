
#include "engine/generators/generatorview"

managed view = None;

ai_docs = R"(
The patchview is a free node area where generators can be placed anywhere and linked with each other.
The user can move around and zoom around in it to build complex patches.
)";

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return;
	}
	
	return view.dispatch(cmd, value);
}

entry(generator, parent) {
	view = generatorview(parent);

	//Register as last focused for the AI agent, since clipview is usually instanced in a window, use the parent for parent_widget (so the headerbar can be clicked too)
	generator.on_get_status([this](){
		
		current_items = [];
		
		for(i = 0; i < view.items.size(); i++) {
			item = view.items[i];
			current_items.push_back([
				asset=item.get_relative_path(), 
				live_path=item.node.get_full_path(),
				pos = std.string(item.window.position()),
				size = std.string(item.window.size()),			
			]);
		}
		
		return current_items;
	});
	
	generator.register("add_item", [path="Path to the generator asset or shader", x="X position of the new generator on the area", y="Y position of the new generator on the area"], [this](args){
		
		if(!args.has("path") || !args.has("x") || !args.has("y"))
			return [ok=false, error="Needs 'path', 'x' and 'y' args."];

		item = view.add_generator(view.area, args.path, vec2f(args.x, args.y));
		
		if(item) {		
			return [
				ok = true,
				status = "New generator was added.",
				live_path=item.node.get_full_path(),
				pos = std.string(item.window.position()),
				size = std.string(item.window.size()),
			];
		}
		
		return [
			ok = false,
			error = "Could not add generator.",
		];
		
	}, "Add a new generator to the area.");
}

save_state() {
	return view.save_state();
}

load_state(state) {
	view.load_state(state);
}