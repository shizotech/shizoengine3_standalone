
#include "engine/generators/splitpanes"

ai_docs = R"(
This is a horizontal splitter: two or more generators or views next to each other.

AREA_0 | AREA_1 | AREA_2 ...

"sizes" are the shares of the areas, together 1.0. set_split with a number sets the share of the LEFT area (0 means it is
basically not visible, 1 means it takes all of the room); with a list it sets every share.
)";

entry(generator, parent) {
	split_entry(generator, parent, true, ai_docs);
}
