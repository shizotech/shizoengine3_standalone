
#include "engine/generators/singleview"

managed split1 = None;
managed split2 = None;

managed view1 = None;
managed view2 = None;

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return;
	}
	
	view1.dispatch(cmd, value);
	view2.dispatch(cmd, value);
	
	return None;
}

entry(generator, parent) {
	split1 = parent.window().anchor(0).anchor_right(0.5,"percent").resizable_right(true).header_enabled(false);
	view1 = singleview(split1);
	split2 = parent.widget().anchor(0).anchor_left(0.5,"percent");
	view2 = singleview(split2);
	
	split1.on_resize([parent](size, old_size) {
		perc = size.x / parent.width();
		split1.anchor_right(1.0 - perc,"percent");
		split2.anchor_left(perc,"percent");
	});
}

save_state() {
	return [
		view1 = view1.save_state(),
		view2 = view2.save_state(),
		split1_anchor = split1.anchor_right(),
		split2_anchor = split2.anchor_left(),	
	];
}

load_state(state) {
	if(state.split1_anchor ?? false)
		split1.anchor_right(state.split1_anchor, "percent");
	if(state.split2_anchor ?? false)
		split2.anchor_left(state.split2_anchor, "percent");
	view1.load_state(state.view1);
	view2.load_state(state.view2);
}