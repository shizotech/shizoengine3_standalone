
// ============================================================================
//  LayerFader  (Utility generator) - asset entry point
//
//  IMPORTANT: The layerfader class lives in "layerfader.shio" (included
//  below), NOT in this file. Defining it here would nest the
//  clipview/generator class re-includes into the asset's std.module and
//  corrupt the global class table -> "Global scope has no task block!"
//  + "class not valid." on every class reference.
// ============================================================================

#include "engine/generators/clipview"
#include "layerfader"
import nanogui;
using eigen;

managed lf = None;

dispatcher(generator, cmd, value) {
	return lf ? lf.dispatcher(generator, cmd, value) : None;
}

entry(generator, area) {
	lf = layerfader(area, generator);
}

save_state() {
	return lf ? lf.save_state() : [];
}

load_state(state) {
	if(lf)
		lf.load_state(state);
}
