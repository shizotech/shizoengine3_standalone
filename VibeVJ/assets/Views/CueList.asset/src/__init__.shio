
#include "engine/generators/clipview"

import nanogui;
using nanogui;

ai_docs = R"(
The clipview is a generator which can hold other generators in a "grid" that can be triggered live.
While mainly used for shaders & visual effects (like resolume), it can also hold & trigger arbitrary generator assets.

The usual goto is to have shader "Sources" and then place shader "Effects" on them, either directly in the same cell as shaderstack, or in upper rows for input feed.

The order is as follows:

LAYER 1
^
LAYER 2
^ 
LAYER 3
^
...

Which means that sources should be cascaded UPSIDE-DOWN!

For example, if you put sources in row 2 and want to further process them with effects, then the effects must go in row 1 ('above' the sources).

The currently active generator of each row inside the grid is fed in a cascading way (like classical layer based video mixing).

Furthermore, each grid cell can hold multiple generators too, for fixed effect pipelines or just multi-asset cells.
So if you place a shader/asset into a cell which already holds items, then this new asset will be added to that cells stack.
For shaders specifically, this can be used to place fixed effects onto sources.

Note: For cascading to work correctly, shaders must be placed on consecutive layers. A shader can only cascade with the shader directly above or below it. For example, row 1 and 2 can be cascaded, but row 1 and 3 cannot directly.

- You can query the controls of the clipview directly to see more layer specific controls like the master dimmers, transition controls, autoplay etc.

- You will receive the fields "grid" for the entire clip grid and "layers" which refers to the top shader generator for each layer, which combines the inputs from the row and the previous layers with different blend modes (these generators hold the blendmode controls for each layer also).
)";


ctrls_area_size = 130;
cue_width = 120;

managed cue_area = None;
managed clips = None;

//Since it holds references to the clipview we cannot make this managed
cue_lists = [];

reset_cue_list = true;

cue_livemode_btn = None; 

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return;
	}
	
	return clips.dispatch(cmd, value);
}

entry(generator, area) {
	
	generator.window.fixed_size([1000,700]);
	
	area.layout(None);
	
	top_bar = area.widget().anchor_left(0).anchor_right(0).anchor_top(0).fixed_height(30).layout(nanogui.layout_horizontal());
	
	cue_livemode_btn = top_bar.pushbutton("LIVEMODE");
	cue_livemode_btn.on_change([](v){
		clips.livemode.pushed(v);
		cb = clips.livemode.on_change();
		cb(v);
		
		for(i = 0; i < cue_lists.size(); i++) {
			for(j = 0; j < cue_lists[i].triggers.size(); j++) {
				cue_lists[i].triggers[j].close_btn.visible(!v);
				cue_lists[i].triggers[j].btn.anchor_right(v ? 0 : 25);
			}
		}
	});
	
	edit_clips = top_bar.controlbutton("SHOW CLIPVIEW", "top_bar_ctrls").push(true);
	
	autoplay_btn = top_bar.controlbutton("AUTOPLAY").push(true);
	autoplay_btn.callback([](v) {
		for(i = 0; i < clips.layer_controls.size(); i++) {
			clips.layer_controls[i].autoplay_random.value(v);
		}
	});
	
	random_btn = top_bar.controlbutton("RANDOM", "top_bar_ctrls");
	random_btn.callback([](v){
		for(i = 0; i < cue_lists.size(); i++) {
			rnd = math.random_int(0, cue_lists[i].triggers.size()-1);
			cb = cue_lists[i].triggers[rnd].btn.on_change();
			cb(true);
		}
	});
	
	cue_area = area.hscroll().anchor(0).anchor_top(35).anchor_bottom(ctrls_area_size).content().layout(nanogui.layout_horizontal());
	
	cue_area.on_dragdrop_hover([](payload, pos) {
		return true;
	});
	
	cue_area.on_dragdrop([](payload, pos) {
		cb = clips.grid.on_cell_drop();
		
		//(payload, row, col)
		highest_row = -1;
		
		for(i = 0; i < cue_lists.size(); i++) {
			if(cue_lists[i].row > highest_row)
				highest_row = cue_lists[i].row;
		}
		
		cb(payload, highest_row+1, 0);
		
		return true;
	});
	
	clips = clipview(area);
	clips.cnt_area.visible(false).anchor(0).anchor_top(30).anchor_bottom(ctrls_area_size);
	
	clips.on_change([](item, row, col) {
		reset_cue_list = true;
	});
	
	edit_clips.callback([clips, cue_area](v) {
		clips.cnt_area.visible(v);
		cue_area.visible(!v);
	});
	
	ctrl_area = area.widget().anchor_left(0).anchor_right(0).anchor_bottom(0).fixed_height(ctrls_area_size).layout(nanogui.layout_vertical());
	
	ctrls_split = ctrl_area.widget().fixed_height(30);
	ctrls_split.controlslider("Macro 1").anchor(0).anchor_right(0.5,"percent");
	ctrls_split.controlslider("Macro 2").anchor(0).anchor_left(0.5,"percent");
	
	ctrls_split2 = ctrl_area.widget().fixed_height(30);
	ctrls_split2.controlslider("Macro 3").anchor(0).anchor_right(0.5,"percent");
	ctrls_split2.controlslider("Macro 4").anchor(0).anchor_left(0.5,"percent");
	
	ctrls_split3 = ctrl_area.widget().fixed_height(30);
	ctrls_split3.controlslider("Macro 5").anchor(0).anchor_right(0.5,"percent");
	ctrls_split3.controlslider("Macro 6").anchor(0).anchor_left(0.5,"percent");
	
	ctrls_split4 = ctrl_area.widget().fixed_height(30);
	ctrls_split4.controlslider("Macro 7").anchor(0).anchor_right(0.5,"percent");
	ctrls_split4.controlslider("Macro 8").anchor(0).anchor_left(0.5,"percent");
}

building_cue_list = false;

update(generator, tl_pos, pos_delta) {
	
	if(reset_cue_list) {
	
		if(building_cue_list)
			return;
		
		reset_cue_list = false;
		building_cue_list = true;
	
		for(i = 0; i < cue_lists.size(); i++) {
			if(cue_lists[i].row >= clips.grid.rows())
				std.free(cue_lists[i].area);
				cue_lists.erase(i);
				i--;
		}
		
		old_cue_list = cue_lists;
		
		cue_lists = [];
		
		new_cue_list = [];
		
		last_row = -1;
		last_cue_list = None;
		
		for(row = 0; row < clips.grid.rows(); row++) {
			for(col = 0; col < clips.grid.cols(); col++) {
				cell = clips.grid.get_item_at(row, col);
				if(cell && cell.attr.item && cell.attr.layer_name) {
					if(row != last_row) {
						last_row = row;
						
						//Check if we have an old cue list for this row...
						old_cue = None;
						for(i = 0; i < old_cue_list.size(); i++) {
							if(old_cue_list[i].row == row)
								old_cue = old_cue_list[i];
								old_cue_list.erase(i);
								break;
						}
						
						list = None;
						
						if(old_cue) {
							list = old_cue.area;
							last_cue_list = old_cue;
							old_cue.list_scroll.clear_children();
							old_cue.triggers = [];
							new_cue_list.push_back(old_cue);
							list.bring_to_front();
						}
						else {
							list = cue_area.widget().fixed_width(cue_width);
							list.on_draw([list](){
								//Use nanogui.nvg* functions
								nvgBeginPath();
								nvgRect(vec2f(0,0), list.size());
								nvgStrokeColor(vec4f(0.8,0.7,0.2,0.3));
								nvgStrokeWidth(2);
								nvgStroke();
							});
							
							list.on_dragdrop_hover([](payload, pos) {
								return true;
							});
							
							list.on_dragdrop([row](payload, pos) {
								cb = clips.grid.on_cell_drop();
								
								//(payload, row, col)
								drop_col = -1;
								for(col = 0; col < clips.grid.cols(); col++) {
									if(!clips.grid.get_item_at(row, col))
										drop_col = col;
										break;
								}
								
								if(drop_col >= 0)
									cb(payload, row, drop_col);
								
								return true;
							});
							
							layer_cell = clips.grid.get_header_left_item(row);
							name = list.textbox().value(layer_cell.attr.layer_name.value()).anchor_left(0).anchor_right(0).anchor_top(0).fixed_height(30);
							name.on_change([layer_cell](v) {
								layer_cell.attr.layer_name.value(v);
							});
							
							preview_shader = list.shader_view().anchor_left(0).anchor_right(0).anchor_top(30).fixed_height(80).shader(layer_cell.attr.shader_view.shader());
							
							dimmer = list.controlslider("Master", "cue_master_" + row).anchor_left(0).anchor_right(0).anchor_top(80 + 30).fixed_height(25);
							layer_cell.attr.master_ctrl.link_to(dimmer, "normalized");
							dimmer.link_to(layer_cell.attr.master_ctrl, "normalized");
							
							mix = list.controlslider("Mix", "cue_mix_" + row).anchor_left(0).anchor_right(0).anchor_top(80 + 55).fixed_height(25);
							layer_cell.attr.mix_ctrl.link_to(mix, "normalized");
							mix.link_to(layer_cell.attr.mix_ctrl, "normalized");
							
							trans = list.controlslider("Transition", "cue_trans_" + row).anchor_left(0).anchor_right(0).anchor_top(80 + 80).fixed_height(25);
							layer_cell.attr.trans_ctrl.link_to(trans, "normalized");
							trans.link_to(layer_cell.attr.trans_ctrl, "normalized");
							
							list_scoll_area = list.vscroll().anchor(0).anchor_top(80 + 110).anchor_bottom(50);
							
							list_scoll_area.on_draw([list_scoll_area](){
								//Use nanogui.nvg* functions
								nvgBeginPath();
								nvgRect(vec2f(1,1), list_scoll_area.size() - vec2f(2,2));
								nvgStrokeColor(vec4f(0.8,0.7,0.2,0.6));
								nvgStrokeWidth(1);
								nvgStroke();
							});
							
							list_scroll = list_scoll_area.content().layout(nanogui.layout_vertical());
							
							transport_ctrl_area = list.widget().anchor_left(0).anchor_right(0).anchor_bottom(3).fixed_height(45);
							go_up = transport_ctrl_area.controlbutton("^", "cue_transport_" + row).anchor_left(0).anchor_top(0).anchor_bottom(0.5, "percent").fixed_width(35).hide_config_menu();
							go_down = transport_ctrl_area.controlbutton("v", "cue_transport_" + row).anchor_left(0).anchor_top(0.5, "percent").anchor_bottom(0, "percent").fixed_width(35).hide_config_menu();
							trig_rnd = transport_ctrl_area.controlbutton("RND", "cue_transport_" + row).anchor(0).anchor_left(35).anchor_top(0).anchor_bottom(0.5, "percent").hide_config_menu();
							trig_stop = transport_ctrl_area.controlbutton("STOP", "cue_transport_" + row).anchor(0).anchor_left(35).anchor_top(0.5, "percent").anchor_bottom(0, "percent").hide_config_menu();
									
							new_cue_list.push_back([
								area = list,
								list_scroll = list_scroll,
								row = row,
								triggers = [],
							]);
							
							last_cue_list = new_cue_list[-1];
						
							go_down.callback([last_cue_list](v) {
								if(!v)
									return;
								
								idx = -1;
								for(i = 0; i < last_cue_list.triggers.size(); i++) {
									trigger = last_cue_list.triggers[i];
									if(trigger.btn.pushed())
										idx = i+1;
										break;
								}
								
								if(idx >= 0 && idx < last_cue_list.triggers.size()) {
									cb = last_cue_list.triggers[idx].btn.on_change();
									cb(true);
								}
								else if(idx == last_cue_list.triggers.size()) {
									cb = last_cue_list.triggers[0].btn.on_change();
									cb(true);
								}
							});
						
							go_up.callback([last_cue_list](v) {
								
								if(!v)
									return;
								
								idx = -999;
								for(i = 0; i < last_cue_list.triggers.size(); i++) {
									trigger = last_cue_list.triggers[i];
									if(trigger.btn.pushed())
										idx = i-1;
										break;
								}
								
								if(idx >= 0 && idx < last_cue_list.triggers.size()) {
									cb = last_cue_list.triggers[idx].btn.on_change();
									cb(true);
								}
								else if(idx == -1) {
									cb = last_cue_list.triggers[-1].btn.on_change();
									cb(true);
								}
							});
						
							trig_rnd.callback([last_cue_list](v) {
								if(!v)
									return;
								
								idx = math.random_int(0, last_cue_list.triggers.size()-1);
								if(idx >= 0) {
									cb = last_cue_list.triggers[idx].btn.on_change();
									cb(true);
								}
							});
							
							trig_stop.callback([layer_cell](v) {
								if(!v)
									return;
								
								layer_cell.attr.stop_btn.value(true);
								layer_cell.attr.stop_btn.value(false);
							});
						}
					}
					
					trigger_split = last_cue_list.list_scroll.widget().fixed_height(25);
					
					trigger_btn = trigger_split.pushbutton(cell.attr.layer_name.value()).anchor(0).anchor_right(25).fixed_height(25);
					trigger_btn.transparent(true);
					trigger_btn.on_draw([trigger_btn](){
						if(!trigger_btn.pushed())
							return;
						nvgBeginPath();
						nvgRect(vec2f(0,0), trigger_btn.size());
						//nvgStrokeColor(vec4f(0.8,0.7,0.2,0.6));
						//nvgStrokeWidth(2);
						//nvgStroke();						
						nvgFillColor(vec4f(0.8,0.7,0.2,0.3));
						nvgFill();
					});
					
					trigger_delete = trigger_split.button("X").anchor_right(0).fixed_width(25).fixed_height(25);
					trigger_delete.transparent(true);
					
					trigger_delete.on_click([cell](){
						cell.attr.item.on_close();
					});
					
					if(cue_livemode_btn.pushed())
						trigger_delete.visible(false);
						trigger_btn.anchor_right(0);
					
					if(row < clips.active_cells.size())
						trigger_btn.pushed(clips.active_cells[row] == cell);
					
					trigger_btn.on_change([trigger_btn, last_cue_list, cell](v) {
						
						for(i = 0; i < last_cue_list.triggers.size(); i++) {
							last_cue_list.triggers[i].btn.pushed(false);
						}
						
						if(v) {
							cb = cell.attr.trigger_btn.callback();
							cb(true);
							trigger_btn.pushed(true);
						}
					});
					
					last_cue_list.triggers.push_back([btn=trigger_btn, cell=cell, close_btn=trigger_delete]);
					
					cue_lists = new_cue_list;
				}
			}
		}
	
		for(i = 0; i < old_cue_list.size(); i++) {
			std.free(old_cue_list[i].area);
		}
		
		building_cue_list = false;
		
		return;
	}
	
	for(i = 0; i < cue_lists.size(); i++) {
		list = cue_lists[i];
		
		if(list.row >= clips.active_cells.size())
			break;
		
		active_cell = clips.active_cells[list.row];
		
		if(clips.layer_controls[list.row].transit_b)
			active_cell = clips.layer_controls[list.row].transit_b;
		if(clips.layer_controls[list.row].transit_c)
			active_cell = clips.layer_controls[list.row].transit_c;
		
		
		for(j = 0; j < list.triggers.size(); j++) {
			trigger = list.triggers[j];
			trigger.btn.pushed(active_cell == trigger.cell);
		}
	}
}

save_state() {
	return clips.save_state();
}

load_state(state) {
	return clips.load_state(state);
}