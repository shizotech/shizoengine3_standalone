                        "guid": "Nh3SJw1zKWv",
                        "h": 320,
                        "is_active": 1,
                        "is_active_internal": 1,
                        "is_big": 0,
                        "path": "assets/KundeVormHerrn/assets/Shaders/Sources/noise_wave/EvolvingBlob.glsl",
                        "w": 584,
                        "x": 0.0,
                        "y": 0.0
                    },
                    "row": 3
