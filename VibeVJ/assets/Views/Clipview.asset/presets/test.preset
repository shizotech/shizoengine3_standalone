                                {
                                    "fragment_source": "/*---AUTOMATICALLY INJECTED HEADER CODE (NOT DIRECTLY PART OF THE SHADER ITSELF)---*/\nprecision highp float; uniform vec3 iResolution;  uniform float iTime;  uniform float iTimeDelta;  uniform int iFrame; \n//@slidervec4\nuniform vec4 iMouse;\nuniform vec4 iDate; uniform float iSampleRate; uniform sampler2D iChannel0; uniform sampler2D iChannel1; uniform sampler2D iChannel2; uniform sampler2D iChannel3; uniform int RenderMaskActive; uniform sampler2D RenderMaskInput;\n/*---*/\n\n\n//@pushbutton displayname=\"No Alpha\"\nuniform int no_alpha;\n\nvoid mainImage( out vec4 fragColor, in vec2 p )\n{\n    p /= iResolution.xy;\n\n    fragColor = texture(iChannel0, p);\n\t\n\tif(no_alpha == 1)\n\t\tfragColor.a = 1.0;\n}\n\n/*AUTOMATICALLY INJECTED MAIN FUNCTION (NOT DIRECTLY PART OF THE SHADER ITSELF)*/ void main(){ vec4 new_color = vec4(0,0,0,0); vec2 n_coord = v_uv*iResolution.xy; if(RenderMaskActive == 1) { vec4 mask_color = texture(RenderMaskInput, v_uv); if(mask_color.rgb == vec3(0.0)) { fragColor = new_color; return; }} mainImage( new_color, n_coord ); fragColor = new_color;} /*---*/",
                                    "image_transform": {
