                            "enabled": 1,
                            "proj": [
                                {
                                    "fragment_source": "/*---AUTOMATICALLY INJECTED HEADER CODE (NOT DIRECTLY PART OF THE SHADER ITSELF)---*/\r\nprecision highp float; uniform vec3 iResolution;  uniform float iTime;  uniform float iTimeDelta;  uniform int iFrame; \r\n//@slidervec4\r\nuniform vec4 iMouse;\r\nuniform vec4 iDate; uniform float iSampleRate; uniform sampler2D iChannel0; uniform sampler2D iChannel1; uniform sampler2D iChannel2; uniform sampler2D iChannel3; uniform int RenderMaskActive; uniform sampler2D RenderMaskInput;\r\n/*---*/\r\n\n\r\n//@pushbutton displayname=\"No Alpha\"\r\nuniform int no_alpha;\r\n\r\nvoid mainImage( out vec4 fragColor, in vec2 p )\r\n{\r\n    p /= iResolution.xy;\r\n\r\n    fragColor = texture(iChannel0, p);\r\n\t\r\n\tif(no_alpha == 1)\r\n\t\tfragColor.a = 1.0;\r\n}\r\n\n/*AUTOMATICALLY INJECTED MAIN FUNCTION (NOT DIRECTLY PART OF THE SHADER ITSELF)*/ void main(){ vec4 new_color = vec4(0,0,0,0); vec2 n_coord = v_uv*iResolution.xy; if(RenderMaskActive == 1) { vec4 mask_color = texture(RenderMaskInput, v_uv); if(mask_color.rgb == vec3(0.0)) { fragColor = new_color; return; }} mainImage( new_color, n_coord ); fragColor = new_color;} /*---*/",
                                    "image_transform": {
                                        "rotation": 0.0,
