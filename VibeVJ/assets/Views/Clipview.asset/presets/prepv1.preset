                        "guid": "FoIfy6LI97-",
                        "h": 416,
                        "is_active": 1,
                        "is_active_internal": 0,
                        "is_big": 0,
                        "path": "assets/Shaders/Effects/Morph&Mirror/Morph.glsl",
                        "w": 700,
