                {
                    "col": 22,
                    "data": {
                        "data": [
                            {
                                "data": {
                                    "enabled": 0,
                                    "proj": [
                                        {
                                            "fragment_source": "/*---AUTOMATICALLY INJECTED HEADER CODE (NOT DIRECTLY PART OF THE SHADER ITSELF)---*/\nprecision highp float; uniform vec3 iResolution;  uniform float iTime;  uniform float iTimeDelta;  uniform int iFrame; \n//@slidervec4\nuniform vec4 iMouse;\nuniform vec4 iDate; uniform float iSampleRate; uniform sampler2D iChannel0; uniform sampler2D iChannel1; uniform sampler2D iChannel2; uniform sampler2D iChannel3; uniform int RenderMaskActive; uniform sampler2D RenderMaskInput;\n/*---*/\n\n// ==== Custom Uniform Controls ====\n\n//@float min=0.01 max=3.0 value=0.5\nuniform float plasma_speed;\n\n//@float min=0.0 max=3.0 value=1.0\nuniform float plasma_intensity;\n\n//@rgb value=(1.0,0.5,0.0)\nuniform vec3 plasma_colors;\n\n//@float min=0.1 max=10.0 value=3.0\nuniform float plasma_frequency;\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 uv = fragCoord.xy / iResolution.xy;\n    uv.x *= iResolution.x / iResolution.y;\n\n    float time = iTime * plasma_speed * 0.5;\n    float freq = plasma_frequency;\n\n    // Classic plasma algorithm using overlapping sine waves\n    float v = 0.0;\n    v += sin(uv.x * freq + time);\n    v += sin(uv.y * freq + time * 1.3);\n    v += sin((uv.x + uv.y) * freq + time * 0.7);\n    v += sin(sqrt(pow(uv.x - 0.5, 2) + pow(uv.y - 0.5, 2)) * freq * 2.0 - time * 1.5);\n    v += sin(sqrt(pow(uv.x + 0.3 - 0.5, 2) + pow(uv.y + 0.3 - 0.5, 2)) * freq * 1.5 + time);\n    v += sin(sqrt(pow(uv.x - 0.7 - 0.5, 2) + pow(uv.y - 0.7 - 0.5, 2)) * freq * 1.2 - time * 0.8);\n\n    v = v * 0.1666666 * plasma_intensity;\n    v = fract(v);\n\n    // Map to colors\n    vec3 color;\n    if (v < 0.333)\n    {\n        color = mix(vec3(0.0, 0.0, 0.2), vec3(1.0, 0.0, 0.0), v * 3.0);\n    }\n    else if (v < 0.666)\n    {\n        color = mix(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), (v - 0.333) * 3.0);\n    }\n    else\n    {\n        color = mix(vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0), (v - 0.666) * 3.0);\n    }\n\n    color *= plasma_colors;\n\n    fragColor = vec4(color, 1.0);\n}\n/*AUTOMATICALLY INJECTED MAIN FUNCTION (NOT DIRECTLY PART OF THE SHADER ITSELF)*/ void main(){ vec4 new_color = vec4(0,0,0,0); vec2 n_coord = v_uv*iResolution.xy; if(RenderMaskActive == 1) { vec4 mask_color = texture(RenderMaskInput, v_uv); if(mask_color.rgb == vec3(0.0)) { fragColor = new_color; return; }} mainImage( new_color, n_coord ); fragColor = new_color;} /*---*/",
