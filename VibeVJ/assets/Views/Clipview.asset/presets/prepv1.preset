                        "guid": "IVE7jGXXz46",
                        "h": 149,
                        "is_active": 1,
                        "is_active_internal": 0,
                        "is_big": 0,
                        "path": "assets/Shaders/Effects/morph/ShapeCloneMorph.glsl/presets/2Copies.preset",
                        "w": 594,
                        "x": 0.0,
                        "y": 0.0
