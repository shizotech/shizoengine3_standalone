
using eigen;
using nanogui;

managed shader = None;

managed size_x = None;
managed size_y = None;

managed scene_area = None;
managed scene_control_area = None;

managed all_scenes = [];

class FixtureScene {
	
	managed div = None;
	managed ctrl_area = None;
	managed select_btn = None;
	managed delete_btn = None;

	__init__() {
		div = scene_area.widget().fixed_height(25).anchor_left(0).anchor_right(0);
		
		select_btn = div.pushbutton("New Scene").anchor(0).anchor_right(25);
		delete_btn = div.button("X").anchor_right(0).fixed_width(25);

		select_btn.on_change([this](v){
			if(v) {
				for(i = 0; i < all_scenes.size(); i++)
					all_scenes[i].show(false);
			}
			
			show(true);	
		});

		delete_btn.on_click([this](){
			
			tmp = this;
			
			for(i = 0; i < all_scenes.size(); i++) {
				if(all_scenes[i] == this)
					all_scenes.erase(i);
					break;
			}
			
			std.free(tmp);
		});
		
		ctrl_area = scene_control_area.widget().anchor(0).layout(nanogui.layout_vertical());
		
		add_group_btn = ctrl_area.button("Add Group");
		test_btn = ctrl_area.button("Test");
		
		ctrl_area.visible(false);
		
		all_scenes.push_back(this);
		
		cb = select_btn.on_change();
		cb(true);
	}
	
	show(value) {
		select_btn.pushed(value);
		ctrl_area.visible(value);
	}
}

entry(generator, area) {	
	
	area.layout(None);
	
	left_ctrls = area.widget().anchor_left(0).anchor_top(0).anchor_bottom(25).fixed_width(200).layout(nanogui.layout_vertical());
	right_ctrls = area.widget().anchor_right(0).anchor_top(0).anchor_bottom(25).fixed_width(200).vscroll().content().layout(nanogui.layout_vertical()).fixed_width(200);
	
	shader_view = area.scrollarea().anchor_left(200).anchor_right(200).anchor_top(0).anchor_bottom(0).content();
	
	shader = shader_view.shader();
	
	size_x = left_ctrls.controlint("Width", "settings").value(generator.engine.project_width.value());
	size_y = left_ctrls.controlint("Height", "settings").value(generator.engine.project_height.value());
	
	size_cb = [size_x, size_y, shader_view](v) {
		shader.render_size(vec2i(size_x.value(), size_y.value()));
		shader_view.fixed_size(vec2i(size_x.value(), size_y.value()));
		shader_view.size(shader_view.fixed_size());
		shader_view.refresh_layout();
	};
	
	size_x.callback(size_cb);
	size_y.callback(size_cb);
	
	size_cb();


	add_scene = left_ctrls.button("Add Scene");
	
	scene_area = left_ctrls.vscroll().anchor(0).anchor_top(100).content().layout(nanogui.layout_vertical()).fixed_width(200);
	
	scene_control_area = right_ctrls;
	
	add_scene.on_click([](){
		new_scene = FixtureScene();
	});
	
	shader.on_mouse_button([](pos, button, down, mods) {
		if(button != 0)
			return false;
		std.print(pos);
		return true;
	});

	shader.on_draw([](){
		ctx = nanogui.current_context();
		ctx.nvgBeginPath();
		ctx.nvgRect(vec2f(0,0), vec2f(20,20));
		ctx.nvgFillColor(vec4f(1,0,0,1));
		ctx.nvgFill();
	});
}