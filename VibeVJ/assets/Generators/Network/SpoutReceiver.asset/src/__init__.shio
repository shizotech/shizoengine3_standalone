//Spout receiver: the picture of a Spout sender (Windows) or a Syphon server (macOS, #264) of another program on this
//computer, as an Out port. On Linux the controls stay (a project made elsewhere keeps its sender) and the picture area
//says so.
//The control IDs stay ("connect_sender", "Size" with "Width" / "Height", "VideoRouter" with "Enable Router" /
//"VideoRouterName", "OUT"): saved projects and links use them. Only the captions say what they are.

#include "engine/interfaces/videorouter"

using eigen;

managed video_router = None;

managed image = None;
managed selector = None;
managed connect_sender = None;

PANEL_W = 190;
PICK = "Pick a sender…";

output = None;
spout_available = false;

dispatcher(generator, cmd, value) {
	if(cmd == "get_default_output")
		return output;

	return None;
}

//A theme colour ({r,g,b,a} 0..1) as vec4f, the token default when the theme does not have it
theme_color(t, key, fallback) {
	if(t && t.has(key)) {
		c = t[key];
		return vec4f(c.r, c.g, c.b, c.a);
	}
	return fallback;
}

entry(generator, area) {
	area.layout(None);
	platform = std.os_platform().lowercase();
	mac = platform.starts("mac");
	spout_available = platform.starts("windows") || mac;
	share = mac ? "Syphon" : "Spout";
	t = area.theme().to_json();
	text_3 = theme_color(t, "disabled_text_color", vec4f(94 / 255.0, 94 / 255.0, 99 / 255.0, 1.0));

	control_tabs = area.vscroll().anchor_left(0).anchor_top(0).anchor_bottom(0).fixed_width(PANEL_W)
		.content().layout(nanogui.layout_vertical().spacing(4));

	image = area.spout_receiver();
	image.anchor_left(PANEL_W + 4).anchor_top(0).anchor_bottom(0).anchor_right(0);

	if(!spout_available) {
		area.label("Spout works on Windows, Syphon on macOS.").text_color(text_3)
			.anchor_left(PANEL_W + 12).anchor_right(8).anchor_top(8).fixed_height(28);
	}

	selector = control_tabs.combobox("sender_select").items([PICK]).tooltip("The " + share + " senders on this computer. Pick one to show its picture");
	selector.enabled(spout_available);
	connect_sender = control_tabs.controltext("connect_sender").caption("Sender").value("")
		.tooltip("The name of the " + share + " sender this shows: picked in the list above or typed. Empty: none");

	selector.on_open([](){
		selector.items([PICK] + image.senders());
	});

	selector.on_change([](v, text) {
		if(v == 0) {
			connect_sender.value("");
			return;
		}

		connect_sender.value(text);
	});

	size_vec = control_tabs.controlvector("Size").tooltip("The size of the picture that comes in");
	width = size_vec.controlint("Width").as_output(true).tooltip("Width of the picture, in pixels");
	height = size_vec.controlint("Height").as_output(true).tooltip("Height of the picture, in pixels");

	videorouter_vec = control_tabs.controlvector("VideoRouter", "video_router").caption("Video router").tooltip("Offers the picture by name in the Inputs of every shader ([[video router]])\n[[wiki:Output-and-Devices#receiving-video]]").expanded(false);
	videorouter_enable = videorouter_vec.controlbutton("Enable Router").caption("Enable router").tooltip("Offer the picture in the [[video router]]").push(1);
	videorouter_name = videorouter_vec.controltext("VideoRouterName").caption("Video router name").tooltip("The name other shaders pick it by").hide_config_menu();

	videorouter_enable.callback([videorouter_name](v){
		if(v) {
			if(!video_router)
				video_router = VideoRouter(videorouter_name.value(), output);
		}
		else
			video_router = None;
	});

	videorouter_name.callback([videorouter_name](v){
		if(video_router)
			video_router.name = v;
	});

	videorouter_name.value("SPOUT_"+std.random_hash(6));

	output = control_tabs.control("OUT").tooltip("The picture that comes in: [[link]] it onward\n[[wiki:Output-and-Devices#receiving-video]]").caption("Out").as_output(true);
	output.value(image);
	output.callback([output](v){ output.value(image); });

	connect_sender.callback([width, height](v) {
		if(!spout_available)
			return;
		if(!v) {
			image.disconnect();
			return;
		}
		image.connect(v);
		width.value(image.sender_width());
		height.value(image.sender_height());
	});

	if(spout_available)
		image.disconnect();
}

save_state() {
	return [
		connect_sender = connect_sender.value(),
	];
}

load_state(state) {
	if(state.connect_sender)
		connect_sender.value(state.connect_sender);
}
