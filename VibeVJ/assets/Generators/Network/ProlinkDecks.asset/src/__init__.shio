// ProlinkDecks generator
// Deck view of the CDJs like ShowKontrol: per deck title, artist, time, BPM and the preview waveform
// of the whole track, below them the scrolling detail waveforms with beat grid, cues and loops.
// The view is a routable video output (OUT), and every deck has controls for effects:
// BPM, BEAT, LOW / MID / HIGH (bass, mids, highs of the waveform at the playhead), PROGRESS,
// CUE RAMP, PLAYING, ON AIR.
//
// Uses the native module 'prolink' (shzmodule_prolink). It shares the connection with the
// ProlinkBridge generator when both use the same SOURCE / PORT.
import nanogui;
import prolink;

using eigen;
using nanogui;

managed device = None;

shader = None;
ctrl_out = None;
status = None;
source = None;
port_text = None;
deck_count = None;
zoom = None;
smoothing = None;

images = [];
revs = [];
views = [];       // player state per deck for the overlay
deck_ctrls = [];

demo_path = "";
open_source = -1;
open_port = "";
status_text = "";

// Layout, keep in sync with decks.glsl
TOP = 0.38;
GAP = 0.012;
PAD = 0.006;
HEAD = 0.42;
LM = 0.045;
RM = 0.075;

// nanovg text alignment flags
ALIGN_LEFT_MIDDLE = 17;
ALIGN_CENTER_MIDDLE = 18;
ALIGN_RIGHT_MIDDLE = 20;

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return None;
		shader.rendering_enabled(value);
		return None;
	}

	// Used by the clipview for shader routing
	if(cmd == "get_default_output")
		return ctrl_out;
}

open_device() {
	open_source = source.value();
	open_port = port_text.value();

	device.close();
	if(open_source == 1)
		device.replay(demo_path, 1.0, true);
	else
		device.open(open_port);
}

set_status(text) {
	if(text != status_text) {
		status_text = text;
		status.text(text);
	}
}

// 128.46 -> "128.5"
fmt1(x) {
	v = std.int(math.round(math.abs(x) * 10));
	s = std.string(v / 10) + "." + std.string(v - (v / 10) * 10);
	if(x < 0 && v > 0)
		s = "-" + s;
	return s;
}

// 1.2 -> "+1.20"
fmt_pitch(x) {
	v = std.int(math.round(math.abs(x) * 100));
	frac = v - (v / 100) * 100;
	s = std.string(v / 100) + ".";
	if(frac < 10)
		s = s + "0";
	s = s + std.string(frac);
	if(x < 0)
		return "-" + s;
	return "+" + s;
}

// ms -> "3:07.4"
fmt_time(ms) {
	t = std.int(math.abs(ms) / 100); // tenths
	minutes = t / 600;
	seconds = (t - minutes * 600) / 10;
	tenth = t - minutes * 600 - seconds * 10;
	s = std.string(minutes) + ":";
	if(seconds < 10)
		s = s + "0";
	return s + std.string(seconds) + "." + std.string(tenth);
}

clip(text, max_chars) {
	if(std.len(text) <= max_chars)
		return text;
	return text.substr(0, max_chars - 1) + "...";
}

draw_text(pos, text, size, face, color, align) {
	nvgFontSize(size);
	nvgFontFace(face);
	nvgFillColor(color);
	nvgTextAlign(align);
	nvgText(pos, text);
}

// Texts on top of the shader output (coordinates = output pixels)
draw_overlay() {
	rs = shader.render_size();
	w = rs.x * 1.0;
	h = rs.y * 1.0;
	n = deck_count.value();
	cols = 1;
	if(n > 1)
		cols = 2;
	prows = (n + cols - 1) / cols;
	ph = TOP * h / prows;

	white = vec4f(1, 1, 1, 1);
	grey = vec4f(0.6, 0.62, 0.68, 1);
	orange = vec4f(1, 0.62, 0.1, 1);

	for(i = 0; i < n; i++) {
		col = i - (i / cols) * cols;
		row = i / cols;
		x0 = (col * 1.0 / cols + PAD) * w;
		y0 = row * ph + GAP * 0.5 * h;
		pw = (1.0 / cols - 2.0 * PAD) * w;
		head = (ph - GAP * h) * HEAD;
		fs = head * 0.3;
		mid_y = y0 + head * 0.5;

		pl = views[i];

		// Deck number
		draw_text(vec2f(x0 + head * 0.35, mid_y), std.string(i + 1), head * 0.55, "sans-bold", grey, ALIGN_CENTER_MIDDLE);

		if(!pl || !pl.present) {
			draw_text(vec2f(x0 + head * 0.8, mid_y), "no player", fs, "sans", grey, ALIGN_LEFT_MIDDLE);
			continue;
		}

		// BPM and pitch on the right
		bpm_color = white;
		if(pl.master)
			bpm_color = orange;
		draw_text(vec2f(x0 + pw - fs * 0.4, y0 + head * 0.3), fmt1(pl.effectiveBpm), fs * 1.15, "mono", bpm_color, ALIGN_RIGHT_MIDDLE);
		draw_text(vec2f(x0 + pw - fs * 0.4, y0 + head * 0.72), fmt_pitch(pl.pitch) + "%", fs * 0.8, "mono", grey, ALIGN_RIGHT_MIDDLE);

		// Remaining time
		track = pl.track;
		if(track && track.durationMs && pl.positionMs)
			draw_text(vec2f(x0 + pw - fs * 5.2, mid_y), "-" + fmt_time(track.durationMs - pl.positionMs), fs, "mono", white, ALIGN_RIGHT_MIDDLE);

		// Title and artist
		max_chars = std.int((pw - head * 0.8 - fs * 9.5) / (fs * 0.55));
		title = "";
		artist = "";
		if(track) {
			if(track.title)
				title = track.title;
			else
				title = "loading...";
			if(track.artist)
				artist = track.artist;
		}
		draw_text(vec2f(x0 + head * 0.8, y0 + head * 0.32), clip(title, max_chars), fs, "sans-bold", white, ALIGN_LEFT_MIDDLE);
		draw_text(vec2f(x0 + head * 0.8, y0 + head * 0.72), clip(artist, max_chars), fs * 0.8, "sans", grey, ALIGN_LEFT_MIDDLE);
	}

	// Lanes: deck number left, pitch right
	top = (TOP + GAP) * h;
	lh = (h - top) / n;
	for(i = 0; i < n; i++) {
		cy = top + i * lh + (lh - GAP * 0.5 * h) * 0.5;
		fs = math.min(lh * 0.3, h * 0.035);
		draw_text(vec2f(LM * w * 0.5, cy), std.string(i + 1), fs * 1.3, "sans-bold", grey, ALIGN_CENTER_MIDDLE);
		pl = views[i];
		if(pl && pl.present)
			draw_text(vec2f(w - RM * w * 0.5, cy), fmt_pitch(pl.pitch) + "%", fs * 0.8, "mono", grey, ALIGN_CENTER_MIDDLE);
	}
}

entry(generator, area) {
	generator.window.fixed_size(vec2f(640, 720));

	top_area = area.vscroll().anchor(0).anchor_bottom(0);
	area = top_area.content().layout(nanogui.layout_vertical());

	// Read the source before the shader exists: a source set after the first frame is not compiled
	shader_src = fileio.read_string(generator.path + "/src/decks.glsl");
	shader = area.shader().fixed_height(340);
	shader.fragment_source(shader_src);
	shader.render_size(vec2i(1920, 1080));

	status = area.label("Not connected").fixed_height(24);

	ctrl_out = area.control("OUT").value(shader);
	ctrl_out.callback([](v) {
		// Always the shader, whatever tries to change it
		ctrl_out.value(shader);
	});

	settings = area.collapsable("Settings").content().layout(nanogui.layout_vertical());
	source = settings.controlcombo("SOURCE");
	source.items(["USB", "DEMO"]);
	port_text = settings.controltext("PORT (empty = auto)").value("");
	deck_count = settings.controlint("DECKS").min(1).max(4).value(4);
	zoom = settings.controlfloat("ZOOM (seconds)").min(1).max(60).value(8);
	smoothing = settings.controlslider("Level smoothing").value(0.5);

	for(d = 0; d < 4; d++) {
		name = std.string(d + 1);

		// Hidden image as texture input of the shader
		img = area.image().visible(false);
		tex = img.texture();
		tex.pixel_format("rgba").component_format("uint8").flip_y(false).size(vec2i(1, 1));
		tex.upload_data([0, 0, 0, 0]);
		shader.input("deck" + name, img);
		images.push_back(img);
		revs.push_back(-1);
		views.push_back(None);

		group = "deck" + name;
		cnt = area.collapsable("Deck " + name).content().layout(nanogui.layout_vertical());
		deck_ctrls.push_back([
			bpm = cnt.controlfloat("BPM", group).max(999),
			beat = cnt.controlslider("BEAT", group),
			low = cnt.controlslider("LOW", group),
			mid = cnt.controlslider("MID", group),
			high = cnt.controlslider("HIGH", group),
			progress = cnt.controlslider("PROGRESS", group),
			cue_ramp = cnt.controlslider("CUE RAMP", group),
			playing = cnt.controlslider("PLAYING", group),
			on_air = cnt.controlslider("ON AIR", group),
		]);
	}

	shader.render_draw([]() {
		draw_overlay();
	});

	// Same recording as the ProlinkBridge generator, so both share one replay
	demo_path = generator.path.replace("ProlinkDecks.asset", "ProlinkBridge.asset") + "/demo/demo_set.jsonl";

	device = prolink.device();
	open_device();
}

update(generator, tl_pos, pos_delta) {
	if(!device)
		return;

	// Source or port changed (also after loading a project)
	if(source.value() != open_source || port_text.value() != open_port)
		open_device();

	// Level smoothing: 0 = raw, 1 = slow
	k = 1.0 - smoothing.value() * 0.9;

	for(d = 0; d < 4; d++) {
		pl = device.player(d + 1);
		views[d] = pl;
		uniform_name = std.string(d + 1);

		// New waveform, beat grid or cues: upload the texture again
		info = device.deck_texture_info(d + 1);
		style = 0;
		rows = 1;
		detail_count = 0;
		preview_count = 0;
		if(info) {
			if(info.rev != revs[d]) {
				data = device.deck_texture(d + 1);
				if(data) {
					tex = images[d].texture();
					tex.size(vec2i(info.width, info.height));
					tex.upload_data(data);
					revs[d] = info.rev;
				}
			}
			if(revs[d] == info.rev) {
				style = 2;
				if(info.style == "3band")
					style = 1;
				rows = info.rows;
				detail_count = info.detailCount;
				preview_count = info.previewCount;
			}
		}
		shader.uniform("info" + uniform_name, vec4f(rows, detail_count, preview_count, style));

		ctrl = deck_ctrls[d];
		if(!pl || !pl.present) {
			shader.uniform("play" + uniform_name, vec4f(0, 0, 0, 0));
			ctrl.playing.value(0);
			ctrl.on_air.value(0);
			continue;
		}

		position = 0.0;
		if(pl.positionMs)
			position = pl.positionMs;
		progress = 0.0;
		if(pl.progress)
			progress = pl.progress;
		master = 0;
		if(pl.master)
			master = 1;
		air = 0;
		if(pl.onAir)
			air = 1;
		shader.uniform("play" + uniform_name, vec4f(position * 0.15, progress, master, air));

		ctrl.bpm.value(pl.effectiveBpm);
		ctrl.beat.value(pl.beatPhase);
		ctrl.low.value(math.lerp(ctrl.low.value(), pl.low, k));
		ctrl.mid.value(math.lerp(ctrl.mid.value(), pl.mid, k));
		ctrl.high.value(math.lerp(ctrl.high.value(), pl.high, k));
		ctrl.progress.value(progress);
		ctrl.cue_ramp.value(pl.cueRamp);
		ctrl.playing.value(pl.playing ? 1 : 0);
		ctrl.on_air.value(air);
	}

	shader.uniform("decks", deck_count.value() * 1.0);
	shader.uniform("zoom", zoom.value() * 150.0);

	if(device.connected())
		set_status("Connected: " + device.port());
	else if(device.error())
		set_status(device.error());
	else
		set_status("Connecting...");
}
