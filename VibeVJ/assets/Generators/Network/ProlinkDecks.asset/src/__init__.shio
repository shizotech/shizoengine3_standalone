// ProlinkDecks generator
// Deck view of the CDJs like ShowKontrol: per deck title, artist, time, BPM and the preview waveform
// of the whole track, below them the scrolling detail waveforms with beat grid, cues, loops and the
// phrases of rekordbox (Intro, Break, Buildup, Drop, Outro ... as a colored band at the bottom, if the track was
// analysed; a rising stretch at the end of a break before a drop is detected from the waveform as Buildup).
// Settings: DECKS (AUTO = one lane per CDJ that is there, or 1-4 fixed), LAYOUT (panels + lanes, or
// compact lanes with the infos in each lane), PLAYHEAD (how much of the past is visible), OVERVIEW
// (whole track as a bar in each lane), TEXT SIZE, OUTPUT (16:9, wider, a strip, Custom = OUTPUT WIDTH x OUTPUT HEIGHT, or
// Fit window = the shape of the generator window), ZOOM (seconds across the lanes at 1920 px width; wider outputs show more
// of what comes; also the zoom bar under the view and the + / - / 0 keys),
// STYLE (colours of the waveforms: CDJ like ShowKontrol / the CDJ-3000; VibeVJ in the accent colour of VibeVJ's UI;
// the chrome around them uses the Shizo UI tokens in both), Time display (remaining or elapsed time),
// HISTORY (the played tracks as a column right of the decks; folds to a narrow tab and back with a click into it, the
// H key, the history button in the zoom bar or HISTORY OPEN). The "History" section lists them and saves them as CSV/TXT.
// The view is a routable video output (OUT), and every deck has controls for effects:
// BPM, BEAT, LOW / MID / HIGH (bass, mids, highs of the waveform at the playhead), PROGRESS,
// CUE RAMP, PLAYING, ON AIR, PHRASE RAMP (0 at the start of the current phrase .. 1 at its end),
// BUILDUP (0 .. 1 through a buildup, 0 otherwise) and DROP (1 while a drop plays).
//
// Reads DJ Watch (the ESP32 in the DJ network, firmware repo prolink-bridge) through the native module 'prolink'
// (shzmodule_prolink). It shares the connection with the ProlinkBridge generator when both use the same SOURCE / PORT.
// SOURCE "NETWORK" reads a relay ESP32 in the light/VJ network over ShizoNet (prolink-bridge docs/relay-und-audio.md).
// SOURCE "NETWORK CARD" needs no DJ Watch: this computer joins the DJ network itself through a network card
// (device.lan(), see ProlinkBridge).
import nanogui;
import prolink;

using eigen;
using nanogui;

managed device = None;

shader = None;
ctrl_out = None;
status = None;
source = None;
port_text = None;
card_text = None;
listen_only = None;
deck_count = None;
layout_ctrl = None;
playhead_ctrl = None;
overview_ctrl = None;
text_size = None;
zoom = None;
zoom_text = None;
zoom_buttons = [];
output_ctrl = None;
output_index = -1;
width_ctrl = None;      // OUTPUT WIDTH / OUTPUT HEIGHT: size of a Custom output (the height also for Fit window)
height_ctrl = None;
pending_size = [x = 0, y = 0, frames = 0]; // a Custom / Fit window size waits until it stays the same (apply_output)
view_scroll = None;     // scroll area of the generator window: its size is the room for the view
view_w = 0.0;           // room for the view in the generator window (px), measured every frame
view_h = 0.0;
mixer_present = false;  // DJM on the network: only then does On Air tell whether the channel is open
zoom_label = "";        // text next to the zoom buttons (seconds visible in the lanes)
smoothing = None;
style_ctrl = None;
history_ctrl = None;
history_open_ctrl = None;
time_ctrl = None;

// Shizo UI tokens (design/tokens.json, version 0.3.0) for the chrome of the view: texts, badges, separators. The same
// values as UI_* in decks.glsl. The content (waveforms, beat grid, cues, loops, phrases) keeps the colours of the STYLE.
UI_CANVAS = vec4f(11 / 255.0, 11 / 255.0, 12 / 255.0, 1);    // canvas: ink on light fills, phrase separators
UI_SURFACE = vec3f(19 / 255.0, 19 / 255.0, 20 / 255.0);      // surface: deck panels (decks.glsl draws them)
UI_CONTROL = vec4f(37 / 255.0, 37 / 255.0, 40 / 255.0, 1);   // control
UI_CONTROL_HOVER = vec4f(46 / 255.0, 46 / 255.0, 50 / 255.0, 1);
UI_BEAT_OFF = vec4f(94 / 255.0, 94 / 255.0, 99 / 255.0, 0.6); // text_3 at 60 %: beats that are off, four empty slots
UI_TEXT = vec4f(237 / 255.0, 237 / 255.0, 237 / 255.0, 1);   // text: titles, values, Master badge
UI_TEXT_2 = vec4f(155 / 255.0, 155 / 255.0, 160 / 255.0, 1); // text_2: artist, pitch, labels
UI_TEXT_3 = vec4f(94 / 255.0, 94 / 255.0, 99 / 255.0, 1);    // text_3: hints, a stopped deck
UI_LINE_STRONG = vec4f(1, 1, 1, 0.12);                        // line_strong: separators
UI_ON = vec4f(63 / 255.0, 207 / 255.0, 142 / 255.0, 1);      // on / live: a playing deck, the On air badge
UI_ON_INK = vec4f(6 / 255.0, 33 / 255.0, 15 / 255.0, 1);     // on_ink: text on an `on` fill
UI_CUE = vec4f(240 / 255.0, 180 / 255.0, 76 / 255.0, 1);     // cue: comes next (the memory cue in the last 16 beats)
UI_ACCENT = vec3f(157 / 255.0, 133 / 255.0, 255 / 255.0);    // accent default; the VibeVJ style reads the theme's
UI_RADIUS_FIELD = 2;    // radius.field (px at 1080 lines): beat squares
UI_RADIUS_CONTROL = 3;  // radius.control: badges
UI_RADIUS_WINDOW = 4;   // radius.window: panels, lanes, history column (decks.glsl)
ui_px = 1.0;            // one design pixel in output pixels (output height / 1080), set by draw_overlay()
MIN_BADGE = 11;         // smallest font size of the badges and the history in output pixels (flat strips)

// Content colours of the current STYLE (apply_style), for the shader uniforms and the overlay
P = [];
accent3 = UI_ACCENT;    // VibeVJ accent (theme), read every few seconds
accent_frames = 0;
theme_widget = None;

// History of played tracks (prolink module, 30 s audible = played)
hist_items = [];      // oldest first: time, n, title, artist, bpm, key ...
hist_count = -1;      // device.history_count() when hist_items was fetched
hist_labels = [];     // the last tracks in the generator window
hist_info = None;
HIST_LABELS = 8;
hist_open = 1.0;      // 0 = folded to the tab, 1 = open; follows HISTORY OPEN smoothly
hist_rect = [x = 0.0, y = 0.0, w = 0.0, h = 0.0];  // history column in output pixels (clicks into the view)

// Current layout, computed in update() and used by the shader uniforms and the text overlay alike
lane_decks = [0, 1, 2, 3];  // deck index (0..3) per lane, -1 = none
nlanes = 4;
L = [top = 0.0, info_w = 0.0, right_w = 0.0, pbar = 0.0, scale = 1.0, compact = false, hist_w = 0.0, hist_full = 0.0,
	u = 1.0, pad_w = 0.0, span = 8.0, head = 0.42];  // u: design scale (design_scale()), pad_w: outer margin,
	// span: seconds across a lane, head: text part of a panel

images = [];
revs = [];
views = [];       // player state per deck for the overlay
marks = [];       // per deck: cues and phrases of the loaded track, its length, detail column and time at the playhead
deck_ctrls = [];

demo_path = "";
open_source = -1;
open_port = "";
open_card = "";
open_listen_only = -1;
status_text = "";
lan_status_ms = -100000.0;
// The DJ Watch program (_djwatch_standalone) hosts this view and has its own connection settings and history:
// standalone_ui() hides them here, and the deck values that only make sense for links in VibeVJ
connection_ui = true;
hist_section = None;
deck_sections = [];

SOURCE_USB = 0;
SOURCE_DEMO = 1;
SOURCE_NETWORK = 2;
SOURCE_LAN = 3;

LAYOUT_PANELS = 0;  // a row of deck panels on top, lanes below
LAYOUT_LANES = 1;   // lanes only, infos in each lane
OVERVIEW_AUTO = 0;  // on in the compact layout (the panels show the whole track otherwise)
OVERVIEW_ON = 1;
OVERVIEW_OFF = 2;
STYLE_CDJ = 0;
STYLE_VIBEVJ = 1;
HISTORY_OFF = 0;
HISTORY_COLUMN = 1;
HISTORY_W = 0.20;       // history column, fraction of the output width at 1920 x 1080
HISTORY_TAB = 0.024;    // the folded column: a narrow tab with the number of tracks
TIME_REMAINING = 0;     // Time display
TIME_ELAPSED = 1;

// Margins, the same constants as in decks.glsl (fractions of the output height)
GAP = 0.012;
PAD = 0.006;
HEAD = 0.42;            // text part of a panel (fraction of its height; more in flat strips: L.head)
PANELS_TOP = 0.30;      // height of the panel row
PANEL_HEAD_MIN = 70;    // the text part of a panel gets at least this many output pixels (three rows in flat strips)
PANELS_LEFT = 0.045;    // lane margin left in the panel layout (deck number)
PANELS_RIGHT = 0.06;    // lane margin right in the panel layout (BPM, pitch)
COMPACT_INFO = 0.19;    // info column of a compact lane (scaled with TEXT SIZE)
// The widths above are for 1920 x 1080; wider outputs and flat strips keep the same pixel widths and give the room to
// the waveforms, higher ones (4K) scale them up, narrower ones (Custom, Fit window) down: design_scale()

// OUTPUT sizes: name, width, height
OUTPUTS = [
	["1920 x 1080 (16:9)", 1920, 1080],
	["2560 x 1080 (21:9)", 2560, 1080],
	["3840 x 1080 (32:9)", 3840, 1080],
	["3840 x 2160 (16:9, 4K)", 3840, 2160],
	["1920 x 540 (strip 32:9)", 1920, 540],
	["1920 x 360 (strip 16:3)", 1920, 360],
	["Custom", 0, 0],       // OUTPUT WIDTH x OUTPUT HEIGHT
	["Fit window", 0, 0],   // OUTPUT HEIGHT, the width from the shape of the generator window
];
OUTPUT_CUSTOM = 6;      // index-based: new entries only at the end
OUTPUT_FIT = 7;
OUTPUT_W_MIN = 320;
OUTPUT_W_MAX = 7680;
OUTPUT_H_MIN = 120;
OUTPUT_H_MAX = 4320;
OUTPUT_SETTLE = 15;     // frames a Custom / Fit window size has to stay the same before the render target is resized
PREVIEW_RESERVE = 34;   // room under the view in the generator window: zoom bar and spacing
PREVIEW_MIN_H = 110;
ZOOM_DEFAULT = 8.0;      // RST
ZOOM_MIN = 1.0;
ZOOM_MAX = 60.0;
OVERVIEW_BAR = 0.17;    // overview bar, fraction of the lane height

LOOP_COLOR = vec4f(1, 0.72, 0.08, 1); // same as LOOP in decks.glsl

// Icons of the zoom bar (FontAwesome codes as in nanogui/icons.h)
ICON_ZOOM_IN = 61454;   // FA_SEARCH_PLUS 0xf00e
ICON_ZOOM_OUT = 61456;  // FA_SEARCH_MINUS 0xf010
ICON_FOLD = 61524;      // FA_CHEVRON_RIGHT 0xf054: fold the bar away to the right
ICON_UNFOLD = 61523;    // FA_CHEVRON_LEFT 0xf053
ICON_HISTORY = 61914;   // FA_HISTORY 0xf1da: fold / unfold the history column

// nanovg text alignment flags
ALIGN_LEFT_MIDDLE = 17;
ALIGN_CENTER_MIDDLE = 18;
ALIGN_RIGHT_MIDDLE = 20;

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return None;
		shader.rendering_enabled(value);
		return None;
	}

	// Used by the clipview for shader routing
	if(cmd == "get_default_output")
		return ctrl_out;
}

open_device() {
	open_source = source.value();
	open_port = port_text.value();
	open_card = card_text.value();
	open_listen_only = listen_only.value();
	source.visible(connection_ui);
	port_text.visible(connection_ui && open_source == SOURCE_USB);
	card_text.visible(connection_ui && open_source == SOURCE_LAN);
	listen_only.visible(connection_ui && open_source == SOURCE_LAN);

	device.close();
	// New source: its revisions start at 0 again, so upload every texture anew
	for(d = 0; d < revs.size(); d++)
		revs[d] = -1;
	if(open_source == SOURCE_DEMO)
		device.replay(demo_path, 1.0, true);
	else if(open_source == SOURCE_NETWORK)
		device.network();
	else if(open_source == SOURCE_LAN)
		device.lan(open_card, open_listen_only != 0);
	else
		device.open(open_port);
}

source_changed() {
	if(source.value() != open_source || port_text.value() != open_port)
		return true;
	return card_text.value() != open_card || listen_only.value() != open_listen_only;
}

// Status of the source "Network card" (DJ Watch without the hardware)
lan_status() {
	card = device.port();
	if(!card) {
		if(device.error())
			return device.error();
		return "Looking for CDJs on all network cards…";
	}
	esp = device.state().esp;
	devices = esp.devices ?? 0;
	// This computer's own broadcasts (ShizoNet, Art-Net broadcast) would land in the DJ network
	if(esp.djBroadcasts)
		return "Network card " + card + ": the computer's broadcasts go into the DJ network (wiki: network card)";
	if(devices == 0)
		return "Network card " + card + ": no CDJs yet";
	if(open_listen_only)
		return "Network card " + card + " (listen only)";
	if(esp.vcdj != "active")
		return "Network card " + card + ": joining the DJ network…";
	return "Network card " + card;
}

set_status(text) {
	if(text != status_text) {
		status_text = text;
		status.text(text);
	}
}

// 128.46 -> "128.5"
fmt1(x) {
	v = std.int(math.round(math.abs(x) * 10));
	s = std.string(v / 10) + "." + std.string(v - (v / 10) * 10);
	if(x < 0 && v > 0)
		s = "-" + s;
	return s;
}

// 1.2 -> "+1.20"
fmt_pitch(x) {
	v = std.int(math.round(math.abs(x) * 100));
	frac = v - (v / 100) * 100;
	s = std.string(v / 100) + ".";
	if(frac < 10)
		s = s + "0";
	s = s + std.string(frac);
	if(x < 0)
		return "-" + s;
	return "+" + s;
}

// ms -> "3:07.4"
fmt_time(ms) {
	t = std.int(math.abs(ms) / 100); // tenths
	minutes = t / 600;
	seconds = (t - minutes * 600) / 10;
	tenth = t - minutes * 600 - seconds * 10;
	s = std.string(minutes) + ":";
	if(seconds < 10)
		s = s + "0";
	return s + std.string(seconds) + "." + std.string(tenth);
}

clip(text, max_chars) {
	if(std.len(text) <= max_chars)
		return text;
	return text.substr(0, max_chars - 1) + "...";
}

draw_text(pos, text, size, face, color, align) {
	nvgFontSize(size);
	nvgFontFace(face);
	nvgFillColor(color);
	nvgTextAlign(align);
	nvgText(pos, text);
}

// A cut inside a multi-byte UTF-8 character (substr counts bytes) leaves the font decoder in a broken state:
// the "..." after it then has no width. That is how such a cut is recognised.
cut_ok(cut) {
	dots = nvgTextBounds(vec2f(0, 0), "...")[0];
	return nvgTextBounds(vec2f(0, 0), cut + "...")[0] - nvgTextBounds(vec2f(0, 0), cut)[0] > dots * 0.5;
}

// Text cut to max_w pixels with "..." at the end (font and size are set here, before measuring)
fit_text(text, size, face, max_w) {
	nvgFontSize(size);
	nvgFontFace(face);
	if(nvgTextBounds(vec2f(0, 0), text)[0] <= max_w)
		return text;
	// Binary search over the number of bytes that fit
	keep = 0;
	upper = text.length();
	for(k = 0; k < 16 && keep < upper; k++) {
		probe = math.floor((keep + upper + 1) * 0.5);
		cut = text.substr(0, probe).rtrim() + "...";
		if(nvgTextBounds(vec2f(0, 0), cut)[0] <= max_w)
			keep = probe;
		else
			upper = probe - 1;
	}
	// Back to the start of a character (at most 3 continuation bytes in UTF-8)
	for(k = 0; k < 3 && keep > 0 && !cut_ok(text.substr(0, keep)); k++)
		keep = keep - 1;
	return text.substr(0, keep).rtrim() + "...";
}

fill_rect(pos, size, color) {
	nvgBeginPath();
	nvgRect(pos, size);
	nvgFillColor(color);
	nvgFill();
}

pill_width(label, size) {
	nvgFontSize(size);
	nvgFontFace("sans-bold");
	return nvgTextBounds(vec2f(0, 0), label)[0] + size * 0.9;
}

// Text colour on a fill: canvas (dark) on light fills, text (light) on dark ones, whichever has more contrast
// (WCAG luminance; a dark theme accent like 70/37/205 needs light text)
ink_on(c) {
	lum = 0.2126 * math.pow(c.x, 2.2) + 0.7152 * math.pow(c.y, 2.2) + 0.0722 * math.pow(c.z, 2.2);
	return lum > 0.18 ? UI_CANVAS : UI_TEXT;
}

// The badges of a deck: label, shown, fill, text colour
pill_labels(pl) {
	sync_fill = vec4f(accent3.x, accent3.y, accent3.z, 1.0);
	return [["Master", pl.master, UI_TEXT, UI_CANVAS], ["On air", pl.onAir && mixer_present, UI_ON, UI_ON_INK],
		["Sync", pl.sync, sync_fill, ink_on(sync_fill)]];
}

// Width draw_pills() will use, without drawing
pills_width(pl, size) {
	labels = pill_labels(pl);
	wd = 0.0;
	for(i = 0; i < 3; i++) {
		if(labels[i][1])
			wd = wd + pill_width(labels[i][0], size) + size * 0.4;
	}
	return wd;
}

// Master, On air and Sync as small badges, right-aligned at x_right; returns the width used. Read from the left they
// are Master · On air · Sync, like the DJ Watch web UI and the lanes (top to bottom). Each one is a word, so it reads
// without its colour: Master light, On air in live green, Sync in the accent (it follows the master, like a link).
draw_pills(x_right, y, pl, size) {
	x = x_right;
	hh = size * 1.55;
	labels = pill_labels(pl);
	for(i = 2; i >= 0; i--) {
		if(!labels[i][1])
			continue;
		wd = pill_width(labels[i][0], size);
		x = x - wd;
		nvgBeginPath();
		nvgRoundedRect(vec2f(x, y - hh * 0.5), vec2f(wd, hh), math.min(UI_RADIUS_CONTROL * ui_px, hh * 0.5));
		nvgFillColor(labels[i][2]);
		nvgFill();
		draw_text(vec2f(x + wd * 0.5, y), labels[i][0], size, "sans-bold", labels[i][3], ALIGN_CENTER_MIDDLE);
		x = x - size * 0.4;
	}
	return x_right - x;
}

fill_tri(a, b, c3, color) {
	nvgBeginPath();
	nvgMoveTo(a);
	nvgLineTo(b);
	nvgLineTo(c3);
	nvgClosePath();
	nvgFillColor(color);
	nvgFill();
}

// "#e0301e" -> vec4f
hex_color(text, alpha) {
	digits = "0123456789abcdef";
	t = text.lowercase();
	v = [0, 0, 0];
	for(i = 0; i < 3; i++)
		v[i] = math.max(digits.find(t.substr(1 + i * 2, 1)), 0) * 16 + math.max(digits.find(t.substr(2 + i * 2, 1)), 0);
	return vec4f(v[0] / 255.0, v[1] / 255.0, v[2] / 255.0, alpha);
}

with_alpha(color, alpha) {
	return vec4f(color.x, color.y, color.z, alpha);
}

// vec3f helpers for the palette
c4(c, alpha) {
	return vec4f(c.x, c.y, c.z, alpha);
}

mix3(a, b, t) {
	return vec3f(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t);
}

scale3(c, k) {
	return vec3f(c.x * k, c.y * k, c.z * k);
}

// Content colours of the STYLE (waveforms, playhead, beat grid, loops): vec3f for the shader (decks.glsl).
// CDJ: like ShowKontrol / the CDJ-3000 (3-band blue / orange / white, red playhead, red downbeats).
// VIBEVJ: one accent colour (read from the theme, so it follows Appearance > Accent colour) for the waveform and the
// downbeats, a white playhead. The chrome (surfaces, texts, badges) is the same in both: the Shizo UI tokens (UI_*).
apply_style() {
	if(style_ctrl.value() != STYLE_VIBEVJ) {
		P = [
			style = STYLE_CDJ,
			low = vec3f(0.10, 0.36, 1.00), mid = vec3f(1.00, 0.64, 0.12), high = vec3f(0.96, 0.96, 1.00),
			playhead = vec3f(1.0, 0.16, 0.16), loop = vec3f(1.0, 0.72, 0.08), tick = vec3f(0.78, 0.78, 0.78),
			down = vec3f(1.0, 0.25, 0.2),
		];
		accent3 = UI_ACCENT;  // the CDJ style always uses the default accent (Sync badge), not the theme's
		accent_frames = 0;    // read the theme again when switching back to VibeVJ
		return None;
	}
	// Accent of the UI theme, read every 120 frames (to_json() is not free)
	if(accent_frames <= 0 && theme_widget) {
		accent_frames = 120;
		t = theme_widget.theme().to_json();
		if(t && t.accent_color)
			accent3 = vec3f(t.accent_color.r, t.accent_color.g, t.accent_color.b);
	}
	accent_frames = accent_frames - 1;
	A = accent3;
	T = vec3f(UI_TEXT.x, UI_TEXT.y, UI_TEXT.z);
	P = [
		style = STYLE_VIBEVJ,
		low = A, mid = mix3(A, T, 0.5), high = scale3(T, 0.62),
		playhead = T, loop = vec3f(0.95, 0.72, 0.25), tick = scale3(T, 0.5), down = A,
	];
}

// Palette to the shader; `lw` = line width in output pixels (2 at 1080 lines)
style_uniforms(lw) {
	shader.uniform("c_low", P.low);
	shader.uniform("c_mid", P.mid);
	shader.uniform("c_high", P.high);
	shader.uniform("c_playhead", P.playhead);
	shader.uniform("c_loop", P.loop);
	shader.uniform("c_tick", P.tick);
	shader.uniform("c_down", P.down);
	shader.uniform("radius", UI_RADIUS_WINDOW * lw * 0.5);
	shader.uniform("stripe", 2.0); // 4 px at 1080 lines, like a linked notch edge (size.calm_edge_linked)
}

// Colors of the phrase groups (CDJ: same as the web interface; VIBEVJ: tones of the UI plus the accent)
phrase_color(group) {
	if(P.style == STYLE_VIBEVJ) {
		if(group == "intro" || group == "outro")
			return UI_CONTROL_HOVER;
		if(group == "verse")
			return c4(mix3(accent3, UI_SURFACE, 0.5), 1.0);
		if(group == "break")
			return c4(scale3(accent3, 0.5), 1.0);
		if(group == "buildup")
			return vec4f(0.95, 0.70, 0.25, 1);
		if(group == "drop")
			return c4(accent3, 1.0);
		return UI_CONTROL;
	}
	if(group == "intro")
		return hex_color("#5b8def", 1.0);
	if(group == "verse")
		return hex_color("#47b6c9", 1.0);
	if(group == "break")
		return hex_color("#3d63b8", 1.0);
	if(group == "buildup")
		return hex_color("#f2c230", 1.0);
	if(group == "drop")
		return hex_color("#3ecf6e", 1.0);
	if(group == "outro")
		return hex_color("#7d84a0", 1.0);
	return hex_color("#888c99", 1.0);
}

// Color of the phrase name in the deck panel: in VIBEVJ the dark band tones are too faint as text on the panel,
// so they are lifted towards the text color
phrase_label_color(group) {
	c = phrase_color(group);
	if(P.style != STYLE_VIBEVJ || group == "buildup" || group == "drop")
		return c;
	return c4(mix3(vec3f(c.x, c.y, c.z), vec3f(UI_TEXT.x, UI_TEXT.y, UI_TEXT.z), 0.55), 1.0);
}

// Phrases as a colored band (x0, y, w x h) for the time ms_a..ms_b across the width. The name sits at the
// left edge of the visible part, where it fits; phrases that are over (before now_ms) are dimmed.
draw_phrase_band(phrases, x0, y, w, h, ms_a, ms_b, now_ms, lw) {
	if(!phrases || phrases.size() == 0 || h < 2 || ms_b <= ms_a)
		return None;
	k = w / (ms_b - ms_a);
	fs = h * 0.72;
	nvgSave();
	nvgScissor(vec2f(x0, y), vec2f(w, h));
	for(i = 0; i < phrases.size(); i++) {
		ph = phrases[i];
		if(std.is_none(ph.ms) || std.is_none(ph.endMs))
			continue;
		if(ph.endMs <= ms_a || ph.ms >= ms_b)
			continue;
		xs = x0 + (ph.ms - ms_a) * k;
		a = math.max(x0, xs);
		b = math.min(x0 + w, x0 + (ph.endMs - ms_a) * k);
		if(b - a < 0.5)
			continue;
		alpha = 0.9;
		if(now_ms >= 0 && ph.endMs <= now_ms)
			alpha = 0.4;
		color = phrase_color(ph.group);
		fill_rect(vec2f(a, y), vec2f(b - a, h), with_alpha(color, alpha));
		// Light text on dark (and dimmed) fields, dark text otherwise
		label = UI_CANVAS;
		if((0.3 * color.x + 0.59 * color.y + 0.11 * color.z) * (alpha + 0.05) < 0.42)
			label = UI_TEXT;
		fill_rect(vec2f(xs - lw * 0.5, y), vec2f(lw, h), UI_CANVAS);
		if(fs >= 8 * lw) {
			nvgFontSize(fs);
			nvgFontFace("sans-bold");
			if(nvgTextBounds(vec2f(0, 0), ph.name)[0] + 6 * lw < b - a)
				draw_text(vec2f(a + 3 * lw, y + h * 0.53), ph.name, fs, "sans-bold", label, ALIGN_LEFT_MIDDLE);
		}
	}
	nvgRestore();
}

// Phrases at the bottom of the scrolling waveform of deck d (same mapping as draw_detail_cues())
draw_detail_phrases(d, x0, y0, ww, wh, lw) {
	m = marks[d];
	if(!m.wave || !m.phrases || m.phrases.size() == 0)
		return None;
	span = L.span * 1000.0;
	ms = m.col / 0.15;
	f = playhead_ctrl.value() / 100.0;
	h = math.round(math.max(6 * lw, math.min(wh * 0.12, 16 * lw * L.scale)));
	draw_phrase_band(m.phrases, x0, y0 + wh - h, ww, h, ms - span * f, ms + span * (1 - f), ms, lw);
}

// Phrases along the bottom of the whole-track waveform of deck d
draw_preview_phrases(d, x0, y0, pw, ph, lw) {
	m = marks[d];
	if(!m.preview || m.dur <= 0 || !m.phrases || m.phrases.size() == 0)
		return None;
	h = math.round(math.max(3 * lw, math.min(ph * 0.16, 14 * lw * L.scale)));
	draw_phrase_band(m.phrases, x0, y0 + ph - h, pw, h, 0, m.dur, m.col / 0.15, lw);
}

// "Drop 12": the phrase at the playhead and the beats to the next one; "" without phrases
phrase_text(pl) {
	if(std.is_none(pl.phrase))
		return "";
	if(pl.beatsToPhrase && pl.beatsToPhrase > 0)
		return pl.phrase + " " + std.string(pl.beatsToPhrase);
	return pl.phrase;
}

is_loop(cue) {
	return cue.endMs && cue.endMs > cue.ms;
}

// Flag of a cue on the top edge y of a waveform: hot cues as a box with their letter right of the line
// (like on the CDJ), memory cues and loops as a triangle on the line. label: also the cue's comment.
draw_cue_flag(x, y, s, cue, color, label) {
	tx = x + s * 0.7;
	if(cue.hot) {
		nvgBeginPath();
		nvgRoundedRect(vec2f(x, y), vec2f(s, s), s * 0.18);
		nvgFillColor(color);
		nvgFill();
		draw_text(vec2f(x + s * 0.5, y + s * 0.54), cue.hot, s * 0.82, "sans-bold", with_alpha(UI_CANVAS, color.w), ALIGN_CENTER_MIDDLE);
		tx = x + s * 1.3;
	}
	else
		fill_tri(vec2f(x - s * 0.55, y), vec2f(x + s * 0.55, y), vec2f(x, y + s * 0.8), color);
	if(label && cue.comment && cue.comment != "")
		draw_text(vec2f(tx, y + s * 0.54), cue.comment, s * 0.72, "sans-bold", color, ALIGN_LEFT_MIDDLE);
}

// Cues and loops on the scrolling waveform of deck d (area x0, y0, ww x wh), same mapping as draw_detail()
draw_detail_cues(d, x0, y0, ww, wh, lw) {
	m = marks[d];
	if(!m.wave || !m.cues || m.cues.size() == 0)
		return None;
	cols = L.span * 150.0;
	head = x0 + ww * playhead_ctrl.value() / 100.0;
	s = math.max(math.min(wh * 0.08, 22 * lw), 9 * lw); // fits the headroom above the waveform (ROOM in decks.glsl)
	nvgSave();
	nvgScissor(vec2f(x0, y0), vec2f(ww, wh));
	for(i = 0; i < m.cues.size(); i++) {
		cue = m.cues[i];
		x = head + (cue.ms * 0.15 - m.col) / cols * ww;
		color = hex_color(cue.color, 1.0);
		if(is_loop(cue)) {
			color = LOOP_COLOR;
			x2 = head + (cue.endMs * 0.15 - m.col) / cols * ww;
			if(x2 >= x0 && x2 <= x0 + ww)
				fill_rect(vec2f(x2 - lw, y0), vec2f(2 * lw, wh), with_alpha(color, x2 < head ? 0.45 : 0.9));
		}
		if(x < x0 - s * 8 || x > x0 + ww + s)
			continue;
		if(x < head)
			color = with_alpha(color, 0.45); // already played, like the dimmed waveform
		fill_rect(vec2f(x - lw, y0), vec2f(2 * lw, wh), with_alpha(color, color.w * 0.9));
		draw_cue_flag(x, y0, s, cue, color, true);
	}
	// The playhead stays in front of a cue that sits right on it (as after loading a track)
	head_color = c4(P.playhead, 1.0);
	fill_rect(vec2f(head - lw, y0), vec2f(2 * lw, wh), head_color);
	fill_tri(vec2f(head - 5 * lw, y0), vec2f(head + 5 * lw, y0), vec2f(head, y0 + 5 * lw), head_color);
	fill_tri(vec2f(head - 5 * lw, y0 + wh), vec2f(head + 5 * lw, y0 + wh), vec2f(head, y0 + wh - 5 * lw), head_color);
	nvgRestore();
}

// Cue marks on the whole-track waveform of deck d (area x0, y0, pw x ph), same mapping as draw_preview()
draw_preview_cues(d, x0, y0, pw, ph, lw) {
	m = marks[d];
	if(!m.preview || m.dur <= 0 || !m.cues || m.cues.size() == 0)
		return None;
	s = math.max(math.min(ph * 0.2, 16 * lw), 7 * lw);
	nvgSave();
	nvgScissor(vec2f(x0, y0), vec2f(pw, ph));
	for(i = 0; i < m.cues.size(); i++) {
		cue = m.cues[i];
		x = x0 + cue.ms / m.dur * pw;
		color = is_loop(cue) ? LOOP_COLOR : hex_color(cue.color, 1.0);
		fill_rect(vec2f(x - lw * 0.5, y0), vec2f(lw, ph), with_alpha(color, 0.75));
		draw_cue_flag(x, y0, s, cue, color, false);
	}
	nvgRestore();
}

// Which decks get a lane: AUTO = the CDJs 1-4 that are there (in order), otherwise decks 1..n
compute_lanes() {
	lane_decks = [-1, -1, -1, -1];
	n = 0;
	mode = deck_count.value();
	if(mode == 0) {
		for(d = 0; d < 4; d++) {
			pl = views[d];
			if(pl && pl.present) {
				lane_decks[n] = d;
				n++;
			}
		}
		if(n == 0)
			n = 1; // waiting: one empty lane
	}
	else {
		n = mode;
		for(d = 0; d < n; d++)
			lane_decks[d] = d;
	}
	nlanes = n;
}

// One design pixel (of 1920 x 1080) in output pixels, for widths and texts: follows the height (4K = 2), stays 1 in flat
// strips (texts keep their size) and gets smaller on outputs narrower than 16:9 (Custom, Fit window), so the columns
// still fit
design_scale(fw, h) {
	return math.min(math.max(h / 1080.0, 1.0), fw / 1920.0);
}

// Line width in output pixels: 2 at 1080 lines, at least 1, narrow outputs limit it by their width (LW in decks.glsl)
line_width(fw, h) {
	return math.max(1.0, math.min(h / 540.0, fw / 960.0));
}

compute_layout() {
	compact = layout_ctrl.value() == LAYOUT_LANES;
	scale = 0.85 + text_size.value() * 0.4;
	overview = overview_ctrl.value();
	bar = overview == OVERVIEW_ON || (overview == OVERVIEW_AUTO && compact);
	L.compact = compact;
	L.scale = scale;
	L.pbar = bar ? OVERVIEW_BAR : 0.0;
	rs = shader.render_size();
	fw = rs.x * 1.0;
	h = rs.y * 1.0;
	u = design_scale(fw, h);
	L.u = u;
	// Widths are fractions of the output width, made for 1920 x 1080; k turns them into fractions of this output
	k = 1920.0 * u / fw;
	L.pad_w = PAD * k;
	target = history_open_ctrl.value() ? 1.0 : 0.0;
	hist_open = hist_open + (target - hist_open) * 0.3;
	if(math.abs(target - hist_open) < 0.01)
		hist_open = target;
	L.hist_w = 0.0;
	if(history_ctrl.value() == HISTORY_COLUMN)
		L.hist_w = (HISTORY_TAB + (HISTORY_W - HISTORY_TAB) * hist_open) * k;
	L.hist_full = HISTORY_W * k;
	if(compact) {
		L.top = 0.0;
		L.info_w = COMPACT_INFO * scale * k;
		L.right_w = 0.0;
	}
	else {
		// Panel row: 30 % of the height, outputs higher than 16:9 no more than their width needs. In flat strips the text
		// part grows to PANEL_HEAD_MIN (three readable rows), the whole-track waveform below it keeps its height.
		ph = math.min(PANELS_TOP * h, PANELS_TOP * 1080 * 1.2 * u) - PAD * h;
		head = math.max(ph * HEAD, math.min(PANEL_HEAD_MIN, h * 0.25));
		ph = math.min(head + ph * (1 - HEAD), h * 0.45);
		L.head = math.min(head / ph, 0.7);
		L.top = (ph + PAD * h) / h;
		L.info_w = PANELS_LEFT * k;
		L.right_w = PANELS_RIGHT * k;
	}
	// Seconds across the scrolling waveforms: ZOOM is the span at a 1920 px wide output (so 1920 x 1080 and 4K look as
	// before); wider outputs keep its seconds per pixel and show more, with the playhead at its place mostly of what comes
	gap = GAP * h;
	w = fw;
	if(L.hist_w > 0)
		w = fw - L.hist_w * fw - gap;
	ww = math.max(w - 2 * L.pad_w * fw - (L.info_w + L.right_w) * fw - gap * 0.5, 1.0);
	ref = ww - (fw - 1920.0 * u);  // the same lane at 1920 px width (the columns keep their pixel widths)
	L.span = math.max(zoom.value(), 0.1) * ww / math.max(ref, ww * 0.1);
}

// Four squares for the beat in the bar, the current one lit; the one in the downbeat colour of the beat grid
draw_beats(pos, size, beat_in_bar) {
	for(b = 0; b < 4; b++) {
		color = UI_BEAT_OFF;
		if(beat_in_bar == b + 1) {
			color = UI_TEXT;
			if(b == 0)
				color = c4(P.down, 1.0);
		}
		nvgBeginPath();
		nvgRoundedRect(vec2f(pos.x + b * size * 1.35, pos.y - size * 0.5), vec2f(size, size), math.min(UI_RADIUS_FIELD * ui_px, size * 0.5));
		nvgFillColor(color);
		nvgFill();
	}
	return size * 1.35 * 4;
}

// Playing: a play triangle in `on` green; stopped: a pause sign in text_3. Shape and colour, so it reads under stage
// light. Drawn right-aligned at x_right, centred on y (size s); returns the width used.
draw_play_state(x_right, y, s, playing) {
	w = s * 0.8;
	if(playing)
		fill_tri(vec2f(x_right - w, y - s * 0.5), vec2f(x_right - w, y + s * 0.5), vec2f(x_right, y), UI_ON);
	else {
		fill_rect(vec2f(x_right - w, y - s * 0.45), vec2f(w * 0.34, s * 0.9), UI_TEXT_3);
		fill_rect(vec2f(x_right - w * 0.34, y - s * 0.45), vec2f(w * 0.34, s * 0.9), UI_TEXT_3);
	}
	return w;
}

// "Cue 16" while a memory cue is coming (in the cue colour in the last 16 beats); "" otherwise
cue_text(pl) {
	if(!pl.beatsToCue || pl.beatsToCue < 0 || pl.beatsToCue > 64)
		return "";
	return "Cue " + std.string(pl.beatsToCue);
}

// Time display: remaining ("-3:07.4") or elapsed ("1:02.3"). "—" while a loaded track has no position (only the
// CDJ-3000 sends it) or no length, "" without a track
time_text(pl) {
	track = pl.track;
	if(!track)
		return "";
	if(std.is_none(pl.positionMs))
		return "—";
	if(time_ctrl.value() == TIME_ELAPSED)
		return fmt_time(pl.positionMs);
	if(track.durationMs)
		return "-" + fmt_time(track.durationMs - pl.positionMs);
	return "—";
}

title_of(pl) {
	track = pl.track;
	if(!track)
		return "No track";
	if(track.title)
		return track.title;
	if(!std.is_none(track.metaExpected) && !track.metaExpected)
		return "No metadata";
	return "Loading…";
}

// Infos in the text part of a panel (panel layout): 3 rows
draw_panel_text(pl, d, x0, y0, pw, head, c) {
	// Text size from the height of the panel; narrow panels (four decks, tall outputs) take it from their width
	base = math.min(head * 0.2, pw * 0.05);
	fs = base * L.scale;
	num = base * 3.1;
	nx = x0 + num * 0.75;
	tx = x0 + num * 1.25;
	draw_text(vec2f(nx, y0 + head * 0.5), std.string(d + 1), num, "sans-bold", pl && pl.master ? c.text : c.text_2, ALIGN_CENTER_MIDDLE);
	if(!pl || !pl.present) {
		draw_text(vec2f(tx, y0 + head * 0.5), "No player", fs, "sans", c.text_3, ALIGN_LEFT_MIDDLE);
		return None;
	}
	rx = x0 + pw - fs * 0.6;
	bpm_text = fmt1(pl.effectiveBpm);
	draw_text(vec2f(rx, y0 + head * 0.24), bpm_text, fs * 1.35, "mono", c.text, ALIGN_RIGHT_MIDDLE);
	bpm_w = nvgTextBounds(vec2f(0, 0), bpm_text)[0];
	pitch = fmt_pitch(pl.pitch) + "%";
	draw_text(vec2f(rx, y0 + head * 0.55), pitch, fs * 0.85, "mono", c.text_2, ALIGN_RIGHT_MIDDLE);
	pitch_w = nvgTextBounds(vec2f(0, 0), pitch)[0];
	time_str = time_text(pl);
	draw_text(vec2f(rx, y0 + head * 0.82), time_str, fs * 0.9, "mono", c.text, ALIGN_RIGHT_MIDDLE);
	time_x = rx - nvgTextBounds(vec2f(0, 0), time_str)[0] - fs * 0.35;
	time_x = time_x - draw_play_state(time_x, y0 + head * 0.82, fs * 0.55, pl.playing) - fs * 0.6; // left end of time + play state

	// Badges next to the BPM; where they would leave the title too little room (narrow panels) next to the pitch: the
	// title then reaches up to the BPM and the artist gives way
	text_w = rx - tx - fs * 6.5;
	ps = math.max(fs * 0.62, MIN_BADGE);
	pills_w = pills_width(pl, ps);
	title_w = text_w - pills_w;
	artist_w = text_w;
	if(pills_w > 0 && title_w < fs * 9) {
		px = rx - pitch_w - fs * 0.5;
		artist_w = px - pills_w - tx;
		title_w = rx - bpm_w - fs * 0.6 - tx;
		draw_pills(px, y0 + head * 0.55, pl, ps);
	}
	else
		draw_pills(rx - bpm_w - fs * 0.5, y0 + head * 0.24, pl, ps);
	nvgSave();
	nvgScissor(vec2f(tx, y0), vec2f(math.max(math.max(text_w, title_w), 1.0), head));
	draw_text(vec2f(tx, y0 + head * 0.24), fit_text(title_of(pl), fs * 1.05, "sans-bold", title_w), fs * 1.05, "sans-bold", c.text, ALIGN_LEFT_MIDDLE);
	if(pl.track && pl.track.artist && artist_w > fs * 2)
		draw_text(vec2f(tx, y0 + head * 0.55), fit_text(pl.track.artist, fs * 0.85, "sans", artist_w), fs * 0.85, "sans", c.text_2, ALIGN_LEFT_MIDDLE);
	nvgRestore();

	bx = tx + draw_beats(vec2f(tx, y0 + head * 0.83), fs * 0.6, pl.beatInBar) + fs * 0.6;
	cue = cue_text(pl);
	if(cue != "") {
		draw_text(vec2f(bx, y0 + head * 0.83), cue, fs * 0.8, "mono", pl.beatsToCue <= 16 ? c.cue : c.text_2, ALIGN_LEFT_MIDDLE);
		bx = bx + nvgTextBounds(vec2f(0, 0), cue)[0] + fs * 0.7;
	}
	phrase = phrase_text(pl);
	room = time_x - bx;
	if(phrase != "" && room > fs * 2)
		draw_text(vec2f(bx, y0 + head * 0.83), fit_text(phrase, fs * 0.8, "sans-bold", room), fs * 0.8, "sans-bold", phrase_label_color(pl.phraseGroup), ALIGN_LEFT_MIDDLE);
}

// Infos in the info column of a compact lane: number + BPM, title, artist, beats + cue + pitch + time, and the phrase in
// a row of its own when the lane is high enough (in the row above otherwise, where it often had no room)
draw_lane_text(pl, d, x0, y0, iw, lh, h, c) {
	fs = math.min(math.min(lh * 0.19, 54 * L.u) * L.scale, iw * 0.115); // iw already scales with TEXT SIZE
	block = fs * 3.9;
	phrase = "";
	phrase_row = false;
	if(pl && pl.present) {
		phrase = phrase_text(pl);
		phrase_row = phrase != "" && lh >= fs * 4.75;
		if(phrase_row)
			block = fs * 4.55;
	}
	else
		block = fs * 1.1; // only the number row
	y = y0 + math.max((lh - block) * 0.5, fs * 0.2);
	x = x0 + fs * 0.55;
	right = x0 + iw - fs * 0.45;

	nvgSave();
	nvgScissor(vec2f(x0, y0), vec2f(iw, lh));
	draw_text(vec2f(x, y + fs * 0.55), std.string(d + 1), fs * 1.1, "sans-bold", pl && pl.master ? c.text : c.text_2, ALIGN_LEFT_MIDDLE);
	if(!pl || !pl.present) {
		draw_text(vec2f(x + fs * 1.1, y + fs * 0.55), "No player", fs * 0.6, "sans", c.text_3, ALIGN_LEFT_MIDDLE);
		nvgRestore();
		return None;
	}
	bpm_text = fmt1(pl.effectiveBpm);
	draw_text(vec2f(right, y + fs * 0.55), bpm_text, fs * 1.0, "mono", c.text, ALIGN_RIGHT_MIDDLE);
	draw_pills(right - nvgTextBounds(vec2f(0, 0), bpm_text)[0] - fs * 0.35, y + fs * 0.55, pl, math.max(fs * 0.36, math.min(MIN_BADGE, fs * 0.6)));
	nvgRestore();

	nvgSave();
	nvgScissor(vec2f(x, y0), vec2f(math.max(right - x, 1.0), lh));
	tw = right - x;
	draw_text(vec2f(x, y + fs * 1.65), fit_text(title_of(pl), fs * 0.62, "sans-bold", tw), fs * 0.62, "sans-bold", c.text, ALIGN_LEFT_MIDDLE);
	if(pl.track && pl.track.artist)
		draw_text(vec2f(x, y + fs * 2.4), fit_text(pl.track.artist, fs * 0.52, "sans", tw), fs * 0.52, "sans", c.text_2, ALIGN_LEFT_MIDDLE);
	nvgRestore();

	row = y + fs * 3.35;
	bx = x + draw_beats(vec2f(x, row), fs * 0.36, pl.beatInBar) + fs * 0.3;
	cue = cue_text(pl);
	if(cue != "") {
		draw_text(vec2f(bx, row), cue, fs * 0.48, "mono", pl.beatsToCue <= 16 ? c.cue : c.text_2, ALIGN_LEFT_MIDDLE);
		bx = bx + nvgTextBounds(vec2f(0, 0), cue)[0] + fs * 0.3;
	}
	// Right to left: time, play state, pitch
	time_str = time_text(pl);
	draw_text(vec2f(right, row), time_str, fs * 0.48, "mono", c.text_2, ALIGN_RIGHT_MIDDLE);
	px = right - nvgTextBounds(vec2f(0, 0), time_str)[0] - fs * 0.2;
	px = px - draw_play_state(px, row, fs * 0.3, pl.playing) - fs * 0.3;
	pitch = fmt_pitch(pl.pitch) + "%";
	draw_text(vec2f(px, row), pitch, fs * 0.48, "mono", c.text_2, ALIGN_RIGHT_MIDDLE);
	if(phrase == "")
		return None;
	if(phrase_row) {
		draw_text(vec2f(x, y + fs * 4.12), fit_text(phrase, fs * 0.52, "sans-bold", right - x), fs * 0.52, "sans-bold", phrase_label_color(pl.phraseGroup), ALIGN_LEFT_MIDDLE);
		return None;
	}
	// The phrase in between, if there is room left
	room = px - nvgTextBounds(vec2f(0, 0), pitch)[0] - fs * 0.4 - bx;
	if(room > fs * 1.6)
		draw_text(vec2f(bx, row), fit_text(phrase, fs * 0.48, "sans-bold", room), fs * 0.48, "sans-bold", phrase_label_color(pl.phraseGroup), ALIGN_LEFT_MIDDLE);
}

// Chevron at center (size s) pointing left (dir -1) or right (dir 1)
draw_chevron(center, s, dir, color, lw) {
	nvgBeginPath();
	nvgMoveTo(vec2f(center.x - dir * s * 0.25, center.y - s * 0.5));
	nvgLineTo(vec2f(center.x + dir * s * 0.25, center.y));
	nvgLineTo(vec2f(center.x - dir * s * 0.25, center.y + s * 0.5));
	nvgStrokeColor(color);
	nvgStrokeWidth(lw * 2.0);
	nvgStroke();
}

// The folded column (x0, y0, tw x ch): chevron to open it, the number of tracks and "History" running downwards
draw_history_tab(x0, y0, tw, ch, fs, lw, c) {
	cx = x0 + tw * 0.5;
	y = y0 + fs * 1.3;
	draw_chevron(vec2f(cx, y), fs * 0.7, -1, c.text_2, lw);
	y = y + fs * 1.4;
	if(hist_items.size() > 0)
		draw_text(vec2f(cx, y), std.string(hist_items.size()), fs * 0.75, "mono", c.text, ALIGN_CENTER_MIDDLE);
	nvgSave();
	nvgTranslate(vec2f(cx, y + fs * 1.2));
	nvgRotate(math.PI * 0.5);
	draw_text(vec2f(0, 0), "History", fs * 0.85, "sans-bold", c.text_2, ALIGN_LEFT_MIDDLE);
	nvgRestore();
}

// History column (x0, y0, cw x ch, laid out for the open width full_w): newest track on top, time and deck on
// the left, title and artist right of it. While it folds the content slides out to the right.
draw_history(x0, y0, cw, ch, full_w, lw, c) {
	fs = math.max(math.min(ch * 0.02, 22 * L.u), MIN_BADGE) * L.scale; // narrow outputs: the column is narrower too
	nvgSave();
	nvgScissor(vec2f(x0, y0), vec2f(cw, ch));
	if(hist_open < 0.25) {
		draw_history_tab(x0, y0, cw, ch, fs, lw, c);
		nvgRestore();
		return None;
	}
	pad = fs * 0.8;
	x = x0 + pad;
	right = x0 + full_w - pad;
	y = y0 + pad + fs * 0.45;
	draw_text(vec2f(x, y), "History", fs * 0.75, "sans-bold", c.text_2, ALIGN_LEFT_MIDDLE);
	draw_chevron(vec2f(right - fs * 0.2, y), fs * 0.6, 1, c.text_2, lw);
	if(hist_items.size() > 0)
		draw_text(vec2f(right - fs * 0.9, y), std.string(hist_items.size()), fs * 0.75, "mono", c.text_2, ALIGN_RIGHT_MIDDLE);
	y = y + fs * 0.9;
	fill_rect(vec2f(x, y), vec2f(right - x, lw), UI_LINE_STRONG);
	y = y + fs * 0.6;
	if(hist_items.size() == 0)
		draw_text(vec2f(x, y + fs * 0.6), "No tracks played yet", fs * 0.8, "sans", c.text_3, ALIGN_LEFT_MIDDLE);
	nvgFontSize(fs * 0.8);
	nvgFontFace("mono");
	tx = x + nvgTextBounds(vec2f(0, 0), "00:00")[0] + fs * 0.7;
	row_h = fs * 2.5;
	for(i = hist_items.size() - 1; i >= 0 && y + row_h <= y0 + ch; i--) {
		e = hist_items[i];
		newest = i == hist_items.size() - 1;
		draw_text(vec2f(x, y + fs * 0.6), e.time, fs * 0.8, "mono", newest ? c.text : c.text_2, ALIGN_LEFT_MIDDLE);
		draw_text(vec2f(x, y + fs * 1.6), "Deck " + std.string(e.n), fs * 0.55, "sans-bold", c.text_2, ALIGN_LEFT_MIDDLE);
		title = e.title;
		if(std.is_none(title) || title == "")
			title = "Unknown track";
		draw_text(vec2f(tx, y + fs * 0.6), fit_text(title, fs, "sans-bold", right - tx), fs, "sans-bold", c.text, ALIGN_LEFT_MIDDLE);
		sub = fmt1(e.bpm) + " BPM";
		if(!std.is_none(e.artist) && e.artist != "")
			sub = e.artist + "  /  " + sub;
		draw_text(vec2f(tx, y + fs * 1.6), fit_text(sub, fs * 0.78, "sans", right - tx), fs * 0.78, "sans", c.text_2, ALIGN_LEFT_MIDDLE);
		y = y + row_h;
	}
	nvgRestore();
}

// Fold or unfold the history column; with HISTORY OFF it switches the column on
toggle_history() {
	if(history_ctrl.value() != HISTORY_COLUMN) {
		history_ctrl.value(HISTORY_COLUMN);
		history_open_ctrl.value(true);
		return None;
	}
	history_open_ctrl.value(!history_open_ctrl.value());
}

// Click into the view (widget pixels): true if it hit the history column, which then folds or unfolds
click_history(pos) {
	if(L.hist_w <= 0)
		return false;
	rs = shader.render_size();
	ww = shader.width() * 1.0;
	wh = shader.height() * 1.0;
	k = math.min(ww / rs.x, wh / rs.y);
	if(k <= 0)
		return false;
	x = (pos.x - (ww - rs.x * k) * 0.5) / k;
	y = (pos.y - (wh - rs.y * k) * 0.5) / k;
	if(x < hist_rect.x || x > hist_rect.x + hist_rect.w || y < hist_rect.y || y > hist_rect.y + hist_rect.h)
		return false;
	toggle_history();
	return true;
}

// Texts on top of the shader output (coordinates = output pixels). Same geometry as main() in decks.glsl.
draw_overlay() {
	rs = shader.render_size();
	fw = rs.x * 1.0;   // whole output; the decks use w (without the history column)
	h = rs.y * 1.0;
	n = nlanes;
	ui_px = h / 1080.0;
	// Text colours of the overlay (Shizo UI tokens)
	c = [text = UI_TEXT, text_2 = UI_TEXT_2, text_3 = UI_TEXT_3, cue = UI_CUE];
	pad_x = L.pad_w * fw;
	pad_y = PAD * h;
	gap = GAP * h;
	lw = line_width(fw, h);
	w = fw;
	if(L.hist_w > 0) {
		cw = L.hist_w * fw;
		w = fw - cw - gap;
		hist_rect = [x = fw - pad_x - cw, y = pad_y, w = cw, h = h - 2 * pad_y];
		draw_history(hist_rect.x, hist_rect.y, cw, hist_rect.h, L.hist_full * fw, lw, c);
	}

	if(L.top > 0) {
		pw = (w - 2 * pad_x - (n - 1) * gap) / n;
		ph = L.top * h - pad_y;
		for(i = 0; i < n; i++) {
			d = lane_decks[i];
			if(d < 0)
				continue;
			draw_panel_text(views[d], d, pad_x + i * (pw + gap), pad_y, pw, ph * L.head, c);
			draw_preview_phrases(d, pad_x + i * (pw + gap), pad_y + ph * L.head, pw, ph * (1 - L.head), lw);
			draw_preview_cues(d, pad_x + i * (pw + gap), pad_y + ph * L.head, pw, ph * (1 - L.head), lw);
		}
	}

	y0 = pad_y;
	if(L.top > 0)
		y0 = L.top * h + gap;
	lh = (h - pad_y - y0 - (n - 1) * gap) / n;
	iw = L.info_w * fw;
	for(i = 0; i < n; i++) {
		ly = y0 + i * (lh + gap);
		d = lane_decks[i];
		if(d < 0) {
			draw_text(vec2f(w * 0.5, ly + lh * 0.5), "Waiting for CDJs…", math.min(lh * 0.12, 32.4 * L.u), "sans", c.text_2, ALIGN_CENTER_MIDDLE);
			continue;
		}
		pl = views[d];

		// Cue flags on the waveforms, same areas as in main() of decks.glsl
		wx = pad_x + iw + gap * 0.5;
		ww = w - 2 * pad_x - L.right_w * fw - iw - gap * 0.5;
		bar = L.pbar * lh;
		if(bar > 0 && marks[d].preview) {
			draw_detail_phrases(d, wx, ly, ww, lh - bar, lw);
			draw_detail_cues(d, wx, ly, ww, lh - bar, lw);
			draw_preview_phrases(d, wx, ly + lh - bar + lw, ww, bar - lw, lw);
			draw_preview_cues(d, wx, ly + lh - bar + lw, ww, bar - lw, lw);
		}
		else {
			draw_detail_phrases(d, wx, ly, ww, lh, lw);
			draw_detail_cues(d, wx, ly, ww, lh, lw);
		}

		if(L.compact) {
			draw_lane_text(pl, d, pad_x, ly, iw, lh, h, c);
			continue;
		}
		// Panel layout: deck number left, BPM and pitch right
		fs = math.min(lh * 0.28, 37.8 * L.u) * L.scale;
		cy = ly + lh * 0.5;
		draw_text(vec2f(pad_x + iw * 0.5, cy), std.string(d + 1), fs * 1.3, "sans-bold", pl && pl.master ? c.text : c.text_2, ALIGN_CENTER_MIDDLE);
		if(pl && pl.present) {
			rx = w - pad_x - L.right_w * fw * 0.5;
			draw_text(vec2f(rx, cy - fs * 0.45), fmt1(pl.effectiveBpm), fs * 0.8, "mono", c.text, ALIGN_CENTER_MIDDLE);
			draw_text(vec2f(rx, cy + fs * 0.45), fmt_pitch(pl.pitch) + "%", fs * 0.65, "mono", c.text_2, ALIGN_CENTER_MIDDLE);
			// Master / On air / Sync under each other, centred under the pitch, if the lane is high enough (Master first:
			// in a short lane only the first one fits)
			ps = math.max(fs * 0.36, math.min(MIN_BADGE, fs * 0.6));
			py = cy + fs * 1.15;
			if(pl.master && py + ps < ly + lh) {
				draw_pills(rx + pill_width("Master", ps) * 0.5, py, [onAir = false, master = true, sync = false], ps);
				py = py + ps * 1.9;
			}
			if(pl.onAir && mixer_present && py + ps < ly + lh) {
				draw_pills(rx + pill_width("On air", ps) * 0.5, py, [onAir = true, master = false, sync = false], ps);
				py = py + ps * 1.9;
			}
			if(pl.sync && py + ps < ly + lh)
				draw_pills(rx + pill_width("Sync", ps) * 0.5, py, [onAir = false, master = false, sync = true], ps);
		}
	}
}

// History from the module, fetched again only when it changed
refresh_history() {
	count = device.history_count();
	if(count == hist_count)
		return None;
	hist_count = count;
	list = device.history();
	if(std.is_none(list))
		list = [];
	hist_items = list;
	if(hist_items.size() == 0)
		hist_info.caption("No tracks played yet");
	else
		hist_info.caption(std.string(hist_items.size()) + " tracks played (newest first):");
	for(i = 0; i < HIST_LABELS; i++) {
		k = hist_items.size() - 1 - i;
		text = "";
		if(k >= 0) {
			e = hist_items[k];
			text = e.time + "  " + std.string(e.n) + "  ";
			if(!std.is_none(e.artist) && e.artist != "")
				text = text + e.artist + " - ";
			title = e.title;
			if(std.is_none(title) || title == "")
				title = "Unknown track";
			text = text + title;
		}
		hist_labels[i].caption(text);
		hist_labels[i].visible(k >= 0);
	}
}

save_history(format) {
	path = device.history_save(format);
	if(std.is_none(path))
		hist_info.caption("Could not write the history file");
	else
		hist_info.caption("Saved: " + path);
}

// Seconds visible in the lanes, next to the zoom buttons: ZOOM at 1920 px width, more on wider outputs (compute_layout)
show_zoom() {
	v = L.span;
	text = std.string(std.int(math.round(v))) + " s";
	if(v < 9.95)
		text = fmt1(v) + " s";
	if(text != zoom_label) {
		zoom_label = text;
		zoom_text.caption(text);
	}
}

// Zoom in (-1) or out (+1) one step, about a factor 1.4; also shown next to the buttons
zoom_step(direction) {
	v = zoom.value();
	if(direction < 0)
		v = v / 1.41421356;
	else
		v = v * 1.41421356;
	v = math.min(math.max(v, ZOOM_MIN), ZOOM_MAX);
	if(v < 10)
		v = math.round(v * 10) / 10.0;
	else
		v = math.round(v);
	zoom.value(v);
}

zoom_reset() {
	zoom.value(ZOOM_DEFAULT);
}

clamp_int(v, lo, hi) {
	return std.int(math.min(math.max(v, lo), hi));
}

// Room for the view in the generator window: the width of its scroll area without the scroll bar (so the view does not
// jump when the bar comes or goes) and its height without the zoom bar. Two size reads per frame.
measure_view() {
	view_w = view_scroll.width() - view_scroll.scrollbar_width() - 4.0; // 4: padding of the vertical layout
	view_h = view_scroll.height() - PREVIEW_RESERVE * 1.0;
}

// Output size for the OUTPUT setting: a preset, Custom (OUTPUT WIDTH x OUTPUT HEIGHT) or Fit window (OUTPUT HEIGHT, the
// width from the shape of the room for the view, so the view fills the generator window)
output_target(index) {
	if(index == OUTPUT_CUSTOM)
		return vec2i(clamp_int(width_ctrl.value(), OUTPUT_W_MIN, OUTPUT_W_MAX), clamp_int(height_ctrl.value(), OUTPUT_H_MIN, OUTPUT_H_MAX));
	if(index == OUTPUT_FIT) {
		if(view_w < 50 || view_h < 50)
			return shader.render_size(); // collapsed or not laid out yet: keep the size
		oh = clamp_int(height_ctrl.value(), OUTPUT_H_MIN, OUTPUT_H_MAX);
		return vec2i(clamp_int(math.round(oh * view_w / view_h * 0.5) * 2, OUTPUT_W_MIN, OUTPUT_W_MAX), oh);
	}
	o = OUTPUTS[math.min(math.max(index, 0), OUTPUT_CUSTOM - 1)];
	return vec2i(o[1], o[2]);
}

// Shader output size from the OUTPUT setting. A preset applies at once; a Custom or Fit window size waits until it stayed
// the same for OUTPUT_SETTLE frames (typing a number, dragging the edge of the window), so the render target is not
// reallocated every frame
apply_output() {
	index = output_ctrl.value();
	now = false;
	if(index != output_index) {
		output_index = index;
		width_ctrl.visible(index == OUTPUT_CUSTOM);
		height_ctrl.visible(index == OUTPUT_CUSTOM || index == OUTPUT_FIT);
		width_ctrl.parent().refresh_layout();
		now = true;
	}
	size = output_target(index);
	rs = shader.render_size();
	if(size.x == rs.x && size.y == rs.y) {
		pending_size.frames = 0;
		return None;
	}
	if(size.x != pending_size.x || size.y != pending_size.y) {
		pending_size.x = size.x;
		pending_size.y = size.y;
		pending_size.frames = 0;
	}
	pending_size.frames = pending_size.frames + 1;
	if(!now && pending_size.frames < OUTPUT_SETTLE)
		return None;
	pending_size.frames = 0;
	shader.render_size(size);
}

// The view fills the width of the generator window at the aspect ratio of the output, at most as high as the window
// (then it letterboxes: keep_aspect_ratio). Follows the window when it is resized; changes only the layout.
fit_preview() {
	if(view_w < 50)
		return None;
	rs = shader.render_size();
	ph = clamp_int(math.round(view_w * rs.y / rs.x), PREVIEW_MIN_H, math.max(view_h, PREVIEW_MIN_H));
	if(ph != shader.fixed_height()) {
		shader.fixed_height(ph);
		shader.parent().refresh_layout();
	}
}

entry(generator, area) {
	generator.window.fixed_size(vec2f(640, 720));

	view_scroll = area.vscroll().anchor(0).anchor_bottom(0);
	area = view_scroll.content().layout(nanogui.layout_vertical());

	// Read the source before the shader exists: a source set after the first frame is not compiled
	shader_src = fileio.read_string(generator.path + "/src/decks.glsl");
	shader = area.shader().fixed_height(340); // fit_preview() follows the width of the window
	shader.fragment_source(shader_src);
	shader.render_size(vec2i(1920, 1080));

	shader.keep_aspect_ratio(true);
	// + and - zoom while the view has the focus (click into it), 0 resets
	shader.on_keyboard_character([](ch) {
		if(ch == "+")
			zoom_step(-1);
		else if(ch == "-")
			zoom_step(1);
		else if(ch == "0")
			zoom_reset();
		else if(ch == "h" || ch == "H")
			toggle_history();
	});
	// A click into the history column folds or unfolds it; other clicks keep their default (focus for the keys)
	shader.on_mouse_button([](pos, button, down, mods) {
		if(button != 0 || !down)
			return false;
		return click_history(pos);
	});

	// Zoom bar under the view, like on the CDJ / rekordbox: zoom in, RST, zoom out, fold away
	bar_row = area.widget().layout(nanogui.layout_horizontal()).fixed_height(26);
	status = bar_row.label("DJ Watch not connected").anchor_left(0).anchor_right(240);
	hist_btn = bar_row.button("").icon(ICON_HISTORY).tooltip("History (H)").anchor_right(202).fixed_width(30);
	zoom_text = bar_row.label("8 s").tooltip("Seconds visible in the lanes").anchor_right(150).fixed_width(48);
	zoom_in_btn = bar_row.button("").icon(ICON_ZOOM_IN).tooltip("Zoom in (+)").anchor_right(114).fixed_width(30);
	zoom_reset_btn = bar_row.button("Reset").tooltip("Reset zoom (0)").anchor_right(70).fixed_width(42);
	zoom_out_btn = bar_row.button("").icon(ICON_ZOOM_OUT).tooltip("Zoom out (-)").anchor_right(38).fixed_width(30);
	fold_btn = bar_row.button("").icon(ICON_FOLD).tooltip("Show or hide the zoom buttons").anchor_right(4).fixed_width(26).transparent(true);
	zoom_buttons = [zoom_text, zoom_in_btn, zoom_reset_btn, zoom_out_btn, hist_btn];
	hist_btn.on_click([]() { toggle_history(); });
	zoom_in_btn.on_click([]() { zoom_step(-1); });
	zoom_reset_btn.on_click([]() { zoom_reset(); });
	zoom_out_btn.on_click([]() { zoom_step(1); });
	fold_btn.on_click([fold_btn]() {
		show = !zoom_buttons[1].visible();
		for(i = 0; i < zoom_buttons.size(); i++)
			zoom_buttons[i].visible(show);
		fold_btn.icon(show ? ICON_FOLD : ICON_UNFOLD);
	});

	ctrl_out = area.control("OUT").caption("Out").value(shader).as_output(true);
	ctrl_out.callback([](v) {
		// Always the shader, whatever tries to change it
		ctrl_out.value(shader);
	});

	settings = area.collapsable("Settings").content().layout(nanogui.layout_vertical());
	source = settings.controlcombo("SOURCE").caption("Source");
	source.items(["USB", "Demo", "Network", "Network card"]).segmented(true); //index-based (SOURCE_USB = 0, …, SOURCE_LAN = 3)
	source.tooltip("Where the CDJ data comes from. USB: DJ Watch on this computer. Demo: a recorded set. Network: a DJ Watch relay over ShizoNet. Network card: no DJ Watch, this computer joins the DJ network itself\n[[wiki:Output-and-Devices#prolink-cdjs]]");
	port_text = settings.controltext("PORT (empty = auto)").caption("Port (empty = auto)").value("");
	card_text = settings.controltext("NETWORK CARD (empty = auto)").caption("Network card (empty = auto)").value("");
	card_text.tooltip("Network card in the DJ network: its name (Windows: \"Ethernet 2\", Linux: eth1, macOS: en7) or its address. Empty: the card on which CDJs show up\n[[wiki:Output-and-Devices#without-dj-watch-network-card]]");
	listen_only = settings.controlbutton("LISTEN ONLY").caption("Listen only").push(1).value(0);
	listen_only.tooltip("Send nothing into the DJ network: tempo and beats only, no track titles, waveforms or cues\n[[wiki:Output-and-Devices#without-dj-watch-network-card]]");
	// AUTO = one lane per CDJ that is there; older projects stored 1-4 here, which still means 1-4 lanes
	deck_count = settings.controlcombo("DECKS").caption("Decks").items(["Auto", "1", "2", "3", "4"]); //index-based (0 = auto)
	layout_ctrl = settings.controlcombo("LAYOUT").caption("Layout").items(["Decks and lanes", "Lanes only (compact)"]); //index-based (LAYOUT_LANES = 1)
	playhead_ctrl = settings.controlfloat("PLAYHEAD (% from left)").caption("Playhead from left").unit("%").min(10).max(50).value(30);
	overview_ctrl = settings.controlcombo("OVERVIEW IN LANES").caption("Overview in lanes").items(["Auto", "On", "Off"]).segmented(true); //index-based (OVERVIEW_AUTO, …)
	text_size = settings.controlslider("TEXT SIZE").caption("Text size").value(0.5);
	// New in October 2026 (OneLibraryCompanion, #354); index-based (TIME_ELAPSED = 1), older projects get Remaining
	time_ctrl = settings.controlcombo("Time display").items(["Remaining", "Elapsed"]).segmented(true)
		.tooltip("Time next to each deck: Remaining counts down to the end of the track, Elapsed counts up from its start\n[[wiki:Output-and-Devices#prolink-cdjs]]");
	zoom = settings.controlfloat("ZOOM (seconds)").caption("Zoom").unit("s").min(ZOOM_MIN).max(ZOOM_MAX).value(ZOOM_DEFAULT)
		.tooltip("Seconds across the lanes at an output 1920 px wide. Wider outputs show more of what comes at the same speed; the zoom bar shows the seconds visible\n[[wiki:Output-and-Devices#prolink-cdjs]]");
	output_ctrl = settings.controlcombo("OUTPUT").caption("Output"); //index-based: new sizes only at the end (OUTPUT_CUSTOM, OUTPUT_FIT)
	names = [];
	for(i = 0; i < OUTPUTS.size(); i++)
		names.push_back(OUTPUTS[i][0]);
	output_ctrl.items(names).tooltip("Size of the rendered view. Custom: Width x Height. Fit window: the shape of this window, Height high\n[[wiki:Output-and-Devices#prolink-cdjs]]");
	// New in October 2026: older projects get 1920 x 1080 here, which only Custom and Fit window read
	width_ctrl = settings.controlint("OUTPUT WIDTH").caption("Width (px)").min(OUTPUT_W_MIN).max(OUTPUT_W_MAX).value(1920).visible(false);
	height_ctrl = settings.controlint("OUTPUT HEIGHT").caption("Height (px)").min(OUTPUT_H_MIN).max(OUTPUT_H_MAX).value(1080).visible(false);
	style_ctrl = settings.controlcombo("STYLE").caption("Style").items(["CDJ", "VibeVJ"]).segmented(true); //index-based (STYLE_VIBEVJ = 1)
	history_ctrl = settings.controlcombo("HISTORY").caption("History").items(["Off", "Right column"]).segmented(true); //index-based (HISTORY_COLUMN = 1)
	history_open_ctrl = settings.controlbutton("HISTORY OPEN").caption("Show history").push(1).value(1);
	smoothing = settings.controlslider("Level smoothing").value(0.5);
	theme_widget = settings;
	apply_style();

	// Played tracks: the last ones here, all of them as CSV/TXT in Documents/prolink-history
	hist_section = area.collapsable("History");
	hist = hist_section.content().layout(nanogui.layout_vertical());
	hist_info = hist.label("No tracks played yet");
	hist_row = hist.widget().layout(nanogui.layout_horizontal()).fixed_height(30);
	save_csv = hist_row.button("Save CSV").anchor_left(0).fixed_width(100);
	save_txt = hist_row.button("Save TXT").anchor_left(104).fixed_width(100);
	clear_btn = hist_row.button("Clear").anchor_left(208).fixed_width(80);
	save_csv.on_click([]() { save_history("csv"); });
	save_txt.on_click([]() { save_history("txt"); });
	clear_btn.on_click([]() {
		device.history_clear();
		hist_count = -1;
	});
	for(i = 0; i < HIST_LABELS; i++)
		hist_labels.push_back(hist.label("").visible(false));

	for(d = 0; d < 4; d++) {
		name = std.string(d + 1);

		// Hidden image as texture input of the shader
		img = area.image().visible(false);
		tex = img.texture();
		tex.pixel_format("rgba").component_format("uint8").flip_y(false).size(vec2i(1, 1));
		tex.upload_data([0, 0, 0, 0]);
		shader.input("deck" + name, img);
		images.push_back(img);
		revs.push_back(-1);
		views.push_back(None);
		marks.push_back([cues = [], phrases = [], dur = 0.0, col = 0.0, wave = false, preview = false, tid = "", trev = -1]);

		group = "deck" + name;
		section = area.collapsable("Deck " + name);
		deck_sections.push_back(section);
		cnt = section.content().layout(nanogui.layout_vertical());
		deck_ctrls.push_back([
			bpm = cnt.controlfloat("BPM", group).max(999).as_output(true),
			beat = cnt.controlslider("BEAT", group).caption("Beat").as_output(true),
			low = cnt.controlslider("LOW", group).caption("Low").as_output(true),
			mid = cnt.controlslider("MID", group).caption("Mid").as_output(true),
			high = cnt.controlslider("HIGH", group).caption("High").as_output(true),
			progress = cnt.controlslider("PROGRESS", group).caption("Progress").as_output(true),
			cue_ramp = cnt.controlslider("CUE RAMP", group).caption("Cue ramp").as_output(true),
			playing = cnt.controlslider("PLAYING", group).caption("Playing").as_output(true),
			on_air = cnt.controlslider("ON AIR", group).caption("On air").as_output(true),
			phrase_ramp = cnt.controlslider("PHRASE RAMP", group).caption("Phrase ramp").as_output(true),
			buildup = cnt.controlslider("BUILDUP", group).caption("Buildup").as_output(true),
			drop = cnt.controlslider("DROP", group).caption("Drop").as_output(true),
		]);
	}

	shader.render_draw([]() {
		draw_overlay();
	});

	// Same recording as the ProlinkBridge generator, so both share one replay
	demo_path = generator.path.replace("ProlinkDecks.asset", "ProlinkBridge.asset") + "/demo/demo_set.jsonl";

	device = prolink.device();
	open_device();
}

// For the DJ Watch program: no Source / Port / Network card / Listen only (the program sets them through the
// controls), no History section and no deck values here
standalone_ui() {
	connection_ui = false;
	source.visible(false);
	port_text.visible(false);
	card_text.visible(false);
	listen_only.visible(false);
	hist_section.visible(false);
	for(i = 0; i < deck_sections.size(); i++)
		deck_sections[i].visible(false);
	source.parent().refresh_layout();
}

update(generator, tl_pos, pos_delta) {
	if(!device)
		return;

	// Source, port or network card changed (also after loading a project)
	if(source_changed())
		open_device();

	// Level smoothing: 0 = raw, 1 = slow
	k = 1.0 - smoothing.value() * 0.9;

	// A DJM on the network (device numbers from 33): only then is "On Air" meaningful
	mixer_present = false;
	for(m = 33; m <= 36; m++) {
		mp = device.player(m);
		if(mp && mp.present)
			mixer_present = true;
	}

	preview_styles = [0.0, 0.0, 0.0, 0.0];
	for(d = 0; d < 4; d++) {
		pl = device.player(d + 1);
		views[d] = pl;
		uniform_name = std.string(d + 1);

		// New waveform, beat grid or cues: upload the texture again
		info = device.deck_texture_info(d + 1);
		style = 0;
		rows = 1;
		detail_count = 0;
		preview_count = 0;
		if(info) {
			if(info.rev != revs[d]) {
				data = device.deck_texture(d + 1);
				if(data) {
					tex = images[d].texture();
					tex.size(vec2i(info.width, info.height));
					tex.upload_data(data);
					revs[d] = info.rev;
				}
			}
			if(revs[d] == info.rev) {
				style = 2;
				if(info.style == "3band")
					style = 1;
				// The firmware may fall back to another style for the preview than for the detail
				preview_styles[d] = 2.0;
				if(info.previewStyle == "3band")
					preview_styles[d] = 1.0;
				if(info.previewCount <= 0)
					preview_styles[d] = 0.0;
				rows = info.rows;
				detail_count = info.detailCount;
				preview_count = info.previewCount;
			}
		}
		shader.uniform("info" + uniform_name, vec4f(rows, detail_count, preview_count, style));
		marks[d].wave = style > 0 && detail_count > 0;
		marks[d].preview = preview_styles[d] > 0.5;
		marks[d].dur = info ? info.durationMs : 0.0;
		marks[d].col = 0.0;
		// Cues: player() leaves the cue list out (it runs every frame), so fetch the whole track when it or its
		// data change (new id or revision)
		tid = "";
		trev = -1;
		if(pl && pl.track && !std.is_none(pl.track.id)) {
			tid = pl.track.id;
			trev = 0;
			if(!std.is_none(pl.track.rev))
				trev = pl.track.rev;
		}
		if(tid != marks[d].tid || trev != marks[d].trev) {
			marks[d].tid = tid;
			marks[d].trev = trev;
			marks[d].cues = [];
			if(tid != "") {
				full = device.track(tid);
				if(full && full.cues)
					marks[d].cues = full.cues;
			}
		}
		marks[d].phrases = [];
		if(pl && pl.track && pl.track.phrases)
			marks[d].phrases = pl.track.phrases;

		ctrl = deck_ctrls[d];
		if(!pl || !pl.present) {
			shader.uniform("play" + uniform_name, vec4f(0, 0, 0, 0));
			ctrl.playing.value(0);
			ctrl.on_air.value(0);
			ctrl.phrase_ramp.value(0);
			ctrl.buildup.value(0);
			ctrl.drop.value(0);
			continue;
		}

		position = 0.0;
		if(pl.positionMs)
			position = pl.positionMs;
		progress = 0.0;
		if(pl.progress)
			progress = pl.progress;
		master = 0;
		if(pl.master)
			master = 1;
		// On Air comes from the mixer. Without a mixer on the network a playing deck counts as audible
		// (ON AIR control for effects); the view then shows no red on-air marks.
		air = 0;
		if(pl.onAir && mixer_present)
			air = 1;
		shader.uniform("play" + uniform_name, vec4f(position * 0.15, progress, master, air));
		if(!mixer_present && pl.playing)
			air = 1;
		marks[d].col = position * 0.15;

		ctrl.bpm.value(pl.effectiveBpm);
		ctrl.beat.value(pl.beatPhase);
		ctrl.low.value(math.lerp(ctrl.low.value(), pl.low, k));
		ctrl.mid.value(math.lerp(ctrl.mid.value(), pl.mid, k));
		ctrl.high.value(math.lerp(ctrl.high.value(), pl.high, k));
		ctrl.progress.value(progress);
		ctrl.cue_ramp.value(pl.cueRamp);
		ctrl.playing.value(pl.playing ? 1 : 0);
		ctrl.on_air.value(air);
		ctrl.phrase_ramp.value(pl.phraseRamp ? pl.phraseRamp : 0.0);
		buildup = 0.0;
		drop = 0;
		if(!std.is_none(pl.phraseGroup)) {
			if(pl.phraseGroup == "buildup")
				buildup = pl.phraseRamp;
			if(pl.phraseGroup == "drop")
				drop = 1;
		}
		ctrl.buildup.value(buildup);
		ctrl.drop.value(drop);
	}

	shader.uniform("pstyle", vec4f(preview_styles[0], preview_styles[1], preview_styles[2], preview_styles[3]));
	apply_style();
	rs = shader.render_size();
	style_uniforms(line_width(rs.x * 1.0, rs.y * 1.0));
	refresh_history();

	measure_view();
	apply_output();
	fit_preview();
	compute_lanes();
	compute_layout();
	show_zoom(); // also after MIDI, loading a project or a new output size
	shader.uniform("lanes", vec4f(lane_decks[0], lane_decks[1], lane_decks[2], lane_decks[3]));
	shader.uniform("nlanes", nlanes * 1.0);
	shader.uniform("top", L.top);
	shader.uniform("head", L.head);
	shader.uniform("info_w", L.info_w);
	shader.uniform("right_w", L.right_w);
	shader.uniform("pbar", L.pbar);
	shader.uniform("hist_w", L.hist_w);
	shader.uniform("pad_w", L.pad_w);
	shader.uniform("playhead", playhead_ctrl.value() / 100.0);
	shader.uniform("zoom", L.span * 150.0);

	if(open_source == SOURCE_LAN) {
		// device.state() builds every deck: a few times a second is enough for the status line
		now_ms = std.millis();
		if(now_ms - lan_status_ms > 250) {
			lan_status_ms = now_ms;
			set_status(lan_status());
		}
	}
	else if(device.connected() && open_source == SOURCE_DEMO)
		set_status("Demo set (no DJ Watch needed)");
	else if(device.connected())
		set_status("DJ Watch connected: " + device.port());
	else if(device.error())
		set_status(device.error());
	else
		set_status("Connecting to DJ Watch…");
}
