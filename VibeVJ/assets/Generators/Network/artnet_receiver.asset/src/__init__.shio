
managed vs = None;
managed start_universe = None;
managed start_channel = None;

artnet_active = true;

channel_max = 1;
channel_list = [];

last_universe = 0;
last_start_index = 1;

last_learn = None;
last_data = None;

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return;
		
		artnet_active = value;
	}
}

add_new_ctrl(ctrl_id, type="8bit")
{
	new_ctrl_cnt = vs.widget().fixed_height(30).anchor_left(0).anchor_right(0).layout(nanogui.layout_horizontal());
	
	universe = new_ctrl_cnt.controlint("U", ctrl_id).min(0).max(16).value(last_universe).anchor(0).clear_anchor_right().fixed_width(60);
	channel = new_ctrl_cnt.controlint("C", ctrl_id).min(1).max(512).value(last_start_index).anchor_left(50).clear_anchor_right().anchor_top(0).anchor_bottom(0).fixed_width(75);
	learn = new_ctrl_cnt.pushbutton("L").anchor_left(125).clear_anchor_right().anchor_top(0).anchor_bottom(0).fixed_width(25);
	
	learn.on_change([learn, channel, universe](v){
		if(last_learn)
			last_learn.learn.pushed(false);
		last_learn = None;
		if(v)
			last_learn = [learn=learn, channel=channel, universe=universe];
		learn.pushed(v);
	});
	
	universe.hide_config_menu();
	channel.hide_config_menu();
	
	val = new_ctrl_cnt.controlslider(ctrl_id, ctrl_id).anchor_left(150).anchor_right(35);

	del_btn = new_ctrl_cnt.button("X").anchor_right(0).fixed_width(25);

	universe.callback([](v){
		if(v != last_universe)
			last_start_index = 1;
		last_universe = v;
	});
	
	channel.callback([type](v){
		if(type == "8bit")
			last_start_index = v + 1;
		else
			last_start_index = v + 2;
	});
	
	channel_list[ctrl_id] = [cnt = new_ctrl_cnt, value=val, type=type, universe=universe, channel=channel];
	
	del_btn.on_click([new_ctrl_cnt, ctrl_id]()
	{
		if(channel_list.has(ctrl_id))
			channel_list.erase(ctrl_id);
		std.free(new_ctrl_cnt);
	});
	
	if(type == "8bit")
		last_start_index++;
	else if(type == "16bit")
		last_start_index = last_start_index + 2;
		
};

entry(generator, area) {
	engine = std.global("engine");
	//Pass the module instead of the generator, because of the RELOAD feature, the generator might not be destroyed while reloading...
	engine.register_artnet_callback(generator.module, [](uni, data) {
		
		//learn should always work
		if(last_learn) {
			if(last_data) {
				for(i = 0; i < 512; i++) {
					if(data[i] != last_data[i])
						last_learn.universe.value(uni);
						last_learn.channel.value(i+1);
						break;
				}
			}

			last_data = data;
		}
		
		if(!artnet_active)
			return;
		for(i = 0; i < channel_list.size(); i++) {
			chan = channel_list[i];
			if(chan.universe.value() + start_universe.value() != uni)
				continue;
			
			channel_index = (chan.channel.value() + (start_channel.value()-1)) - 1;
			
			if(chan.type == "8bit") {
				if(channel_index >= 0 && channel_index < 512)
					chan.value.value(data[channel_index] / 255.0);
			}
			else if(chan.type == "16bit"){
				if(channel_index >= 0 && channel_index < 511) {
					value = data[channel_index] * 256 + data[channel_index + 1];
					value = value / 65535.0;
					chan.value.value(value);
				}
			}
		}
		//std.print("ARTNET:", uni);	
	});
	
	area.layout(nanogui.layout_vertical());
	
	add_btn = area.button("ADD CHANNEL");
	add_16b_btn = area.button("ADD 16-BIT CHANNEL");
	start_universe = area.controlint("START UNIVERSE").min(0).max(16);
	start_channel = area.controlint("START CHANNEL").min(1).max(512).value(1);
	
	//Hacky
	vs = area.vscroll().anchor_top(130).anchor_bottom(0);
	vs.content().layout(nanogui.layout_vertical());
	
	add_btn.on_click([](){
		add_new_ctrl("CTRL"+channel_max, "8bit");
		channel_max++;
	});
	
	add_16b_btn.on_click([](){
		add_new_ctrl("CTRL"+channel_max, "16bit");
		channel_max++;
	});
}

save_state() {
	state = [channel_max=channel_max, channels=[]];
	for(i = 0; i < channel_list.size(); i++) {
		state.channels.push_back([
			ctrl_id=channel_list.key(i),
			value=channel_list[i].value.value(),
			type=channel_list[i].type,
			universe=channel_list[i].universe.value(),
			channel=channel_list[i].channel.value(),
		]);
	}
	return state;
}

load_state(state) {
	if(state.has("channel_max"))
		channel_max = state.channel_max;
	
	for(i = 0; i < state.channels.size(); i++) {
		
		chan = state.channels[i];
		add_new_ctrl(chan.ctrl_id, chan.type);
		
		new_chan = channel_list[chan.ctrl_id];
		new_chan.universe.value(chan.universe);
		new_chan.channel.value(chan.channel);
		new_chan.value.value(chan.value);
	}
}