
import nanogui;

managed vs = None;
managed channel_list_area = None;
managed start_universe = None;
managed start_channel = None;

artnet_active = true;

channel_max = 1;
channel_list = [];

net = None;

device = None;
device_list = [];
dev_name = None;
dev_ip = None;
dev_mac = None;

last_universe = 0;
last_start_index = 1;

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return;
		
		artnet_active = value;
	}
}

add_new_ctrl(ctrl_id, type="8bit")
{
	new_ctrl_cnt = channel_list_area.widget().fixed_height(30).anchor_left(0).anchor_right(0).layout(nanogui.layout_horizontal());
	
	universe = new_ctrl_cnt.controlint("U", ctrl_id).min(0).max(16).value(last_universe).anchor(0).clear_anchor_right().fixed_width(60);
	channel = new_ctrl_cnt.controlint("C", ctrl_id).min(1).max(512).value(last_start_index).anchor_left(50).clear_anchor_right().anchor_top(0).anchor_bottom(0).fixed_width(75);
	
	universe.hide_config_menu();
	channel.hide_config_menu();
	
	val = new_ctrl_cnt.controlslider(ctrl_id, ctrl_id).anchor_left(135).anchor_right(35);

	del_btn = new_ctrl_cnt.button("X").anchor_right(0).fixed_width(25);

	universe.callback([](v){
		if(v != last_universe)
			last_start_index = 1;
		last_universe = v;
	});
	
	channel.callback([type](v){
		if(type == "8bit")
			last_start_index = v + 1;
		else
			last_start_index = v + 2;
	});
	
	channel_list[ctrl_id] = [cnt = new_ctrl_cnt, value=val, type=type, universe=universe, channel=channel];
	
	del_btn.on_click([new_ctrl_cnt, ctrl_id]()
	{
		if(channel_list.has(ctrl_id))
			channel_list.erase(ctrl_id);
		std.free(new_ctrl_cnt);
	});
	
	if(type == "8bit") {
		last_start_index++;
		val.callback([universe, channel](v){
			if(!artnet_active)
				return;
			if(!device) {
				if(dev_mac.value())
					device = net.find_artnet_device(dev_mac.value());
					if(device)
						dev_ip.value(device.ip());
						dev_name.value(device.name());
				return;
			}
			
			u = start_universe.value() + universe.value();
			c = (start_channel.value() - 1) + (channel.value() - 1);
			
			res = device.set_artnet_channel(u, c, v*255.0);
		});
	}
	else if(type == "16bit") {
		last_start_index = last_start_index + 2;
		val.callback([universe, channel](v){
			if(!artnet_active)
				return;
			if(!device) {
				if(dev_mac.value())
					device = net.find_artnet_device(dev_mac.value());
					if(device)
						dev_ip.value(device.ip());
						dev_name.value(device.name());
				return;
			}
			
			value_16bit = v * 65535.0;
			current_coarse = std.int(value_16bit / 256.0);
			current_fine = std.int(math.mod(value_16bit,256.0));
			
			u = start_universe.value() + universe.value();
			c = (start_channel.value() - 1) + (channel.value() - 1);

			device.set_artnet_channel(u, c, current_coarse);
			device.set_artnet_channel(u, c+1, current_fine);
		});
	}
};

entry(generator, area) {
	area.layout(nanogui.layout_vertical());
	
	engine = std.global("engine");
	net = engine.net;
	
	selector = area.combobox().items(["Select"]);
	cnt = area.widget().layout(nanogui.layout_horizontal());
	dev_name = cnt.textbox().editable(false).value("<none>").anchor_left(0).anchor_right(0.666666666, "percent");
	dev_ip = cnt.textbox().editable(false).value("<none>").anchor_left(0.33333333, "percent").anchor_right(0.333333333, "percent");
	dev_mac = cnt.textbox().editable(false).value("<none>").anchor_left(0.6666666, "percent").anchor_right(0.0, "percent");
	
	selector.on_open([net, selector](){
		devs = net.artnet_devices();
		device_list.items = ["Select"];
		device_list.devs = [];
		for(i = 0; i < devs.size(); i++)
			device_list.items.push_back(devs[i].name());
			device_list.devs.push_back(devs[i]);
		selector.items(device_list.items);
	});
	selector.on_change([](v, text){
		if(v == 0) 
			device = None;
			dev_name.value("<none>");
			dev_ip.value("<none>");
			dev_mac.value("<none>");
			return;
		
		v--;
		
		if(v < 0 || v >= device_list.devs.size())
			return;
		
		dev = device_list.devs[v];
		dev_name.value(dev.name());
		dev_ip.value(dev.ip());
		dev_mac.value(dev.mac());
		device = dev;
	});
	
	add_btn = area.button("ADD CHANNEL");
	add_16b_btn = area.button("ADD 16-BIT CHANNEL");
	start_universe = area.controlint("START UNIVERSE").min(0).max(16);
	start_channel = area.controlint("START CHANNEL").min(1).max(512).value(1);
	
	//Hacky
	vs = area.vscroll().anchor_top(200).anchor_bottom(0);
	channel_list_area = vs.content().layout(nanogui.layout_vertical()).controlvector("Channels").expanded(true).content().layout(nanogui.layout_vertical());
	
	add_btn.on_click([](){
		add_new_ctrl("CTRL"+channel_max, "8bit");
		channel_max++;
	});
	
	add_16b_btn.on_click([](){
		add_new_ctrl("CTRL"+channel_max, "16bit");
		channel_max++;
	});
}

save_state() {
	state = [channel_max=channel_max, channels=[], mac=dev_mac.value()];
	for(i = 0; i < channel_list.size(); i++) {
		state.channels.push_back([
			ctrl_id=channel_list.key(i),
			value=channel_list[i].value.value(),
			type=channel_list[i].type,
			universe=channel_list[i].universe.value(),
			channel=channel_list[i].channel.value(),
		]);
	}
	return state;
}

load_state(state) {
	if(state.has("channel_max"))
		channel_max = state.channel_max;
	
	for(i = 0; i < state.channels.size(); i++) {
		
		chan = state.channels[i];
		add_new_ctrl(chan.ctrl_id, chan.type);
		
		new_chan = channel_list[chan.ctrl_id];
		new_chan.universe.value(chan.universe);
		new_chan.channel.value(chan.channel);
		new_chan.value.value(chan.value);
	}
	
	dev_mac.value(state.mac);
	
	if(dev_mac.value())
		device = net.find_artnet_device(dev_mac.value());
		if(device)
			dev_ip.value(device.ip());
			dev_name.value(device.name());
}