//NDI receiver: the picture of an NDI sender on the network, as an Out port.
//The control IDs stay ("connect_sender", "Flip Y", "Size" with "Width" / "Height", "VideoRouter" with "Enable Router" /
//"VideoRouterName", "OUT"): saved projects and links use them. Only the captions say what they are.

#include "engine/interfaces/videorouter"

using eigen;

managed video_router = None;

managed image = None;
managed selector = None;
managed connect_sender = None;
managed status = None;

PANEL_W = 190;
PICK = "Pick a sender…";

output = None;
flip_ctrl = None;

width = None;
height = None;
status_text = "";

dispatcher(generator, cmd, value) {
	if(cmd == "get_default_output")
		return output;

	return None;
}

//A theme colour ({r,g,b,a} 0..1) as vec4f, the token default when the theme does not have it
theme_color(t, key, fallback) {
	if(t && t.has(key)) {
		c = t[key];
		return vec4f(c.r, c.g, c.b, c.a);
	}
	return fallback;
}

set_status(text) {
	if(text != status_text) {
		status_text = text;
		status.caption(text);
	}
}

old_receivers = []; //receivers of an earlier sender, freed in update()

entry(generator, area) {
	area.layout(None);
	t = area.theme().to_json();
	text_2 = theme_color(t, "text_secondary_color", vec4f(155 / 255.0, 155 / 255.0, 160 / 255.0, 1.0));

	control_tabs = area.vscroll().anchor_left(0).anchor_top(0).anchor_bottom(0).fixed_width(PANEL_W)
		.content().layout(nanogui.layout_vertical().spacing(4));

	image = area.ndi_receiver().anchor_left(PANEL_W + 4).anchor_top(0).anchor_bottom(0).anchor_right(0);

	selector = control_tabs.combobox("sender_select").items([PICK]).tooltip("The NDI senders on the network. Pick one to show its picture");
	connect_sender = control_tabs.controltext("connect_sender").caption("Sender").value("")
		.tooltip("The name of the NDI sender this shows: picked in the list above or typed. Empty: none");
	status = control_tabs.label("No sender").text_color(text_2);

	image.sources();

	selector.on_open([](){
		selector.items([PICK] + image.sources());
	});

	selector.on_change([](v, text) {
		if(v == 0) {
			connect_sender.value("");
			return;
		}

		connect_sender.value(text);
	});

	flip_ctrl = control_tabs.controlbutton("Flip Y").caption("Flip Y").tooltip("Turns the picture upside down").push(1);
	flip_ctrl.callback([](v){
		image.invert(v);
	});

	size_vec = control_tabs.controlvector("Size").tooltip("The size of the picture that comes in");
	width = size_vec.controlint("Width").as_output(true).tooltip("Width of the picture that comes in, in pixels");
	height = size_vec.controlint("Height").as_output(true).tooltip("Height of the picture that comes in, in pixels");

	videorouter_vec = control_tabs.controlvector("VideoRouter", "video_router").caption("Video router").tooltip("Offers the picture by name in the Inputs of every shader ([[video router]])\n[[wiki:Output-and-Devices#receiving-video]]").expanded(false);
	videorouter_enable = videorouter_vec.controlbutton("Enable Router").caption("Enable router").tooltip("Offer the picture in the [[video router]]").push(1);
	videorouter_name = videorouter_vec.controltext("VideoRouterName").caption("Video router name").tooltip("The name other shaders pick it by").hide_config_menu();

	videorouter_enable.callback([videorouter_name](v){
		if(v) {
			if(!video_router)
				video_router = VideoRouter(videorouter_name.value(), output);
		}
		else
			video_router = None;
	});

	videorouter_name.callback([videorouter_name](v){
		if(video_router)
			video_router.name = v;
	});

	videorouter_name.value("NDI_"+std.random_hash(6));

	output = control_tabs.control("OUT").tooltip("The picture that comes in: [[link]] it onward\n[[wiki:Output-and-Devices#receiving-video]]").caption("Out").as_output(true);
	output.value(image);
	output.callback([output](v){ output.value(image); });

	//A new receiver for each sender (the widget keeps the picture of the one it was made for)
	connect_sender.callback([area](v) {

		//The old receiver is freed in the next update(), after Out points at the new one (it stayed in the window
		//under the new one before, one more for every change of the sender)
		if(image) {
			image.disconnect();
			image.visible(false);
			old_receivers.push_back(image);
		}

		image = None;
		image = area.ndi_receiver().anchor_left(PANEL_W + 4).anchor_top(0).anchor_bottom(0).anchor_right(0);
		image.invert(flip_ctrl.value());
		output.value(image);

		if(!v)
			return;

		image.connect(v);
	});

	image.disconnect();
}

update(generator, tl_pos, pos_delta) {
	for(i = 0; i < old_receivers.size(); i++)
		std.free(old_receivers[i]);
	old_receivers.clear();
	if(!image)
		return;
	width.value(image.source_width());
	height.value(image.source_height());

	name = connect_sender.value();
	if(!name)
		set_status("No sender");
	else if(image.is_connected())
		set_status("Connected");
	else
		set_status("Waiting for the sender…");
}

save_state() {
	return [
		connect_sender = connect_sender.value(),
	];
}

load_state(state) {
	if(state.connect_sender)
		connect_sender.value(state.connect_sender);
}
