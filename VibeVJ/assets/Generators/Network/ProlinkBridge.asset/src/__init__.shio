// ProlinkBridge generator (asset name and control IDs stay, saved projects use them)
// CDJ data (Pioneer Pro DJ Link) straight from DJ Watch (the ESP32 in the DJ network, hostname dj-watch.local;
// formerly called prolink-bridge) over USB, no bridge.py, no Art-Net. Needs the native module 'prolink' (shzmodule_prolink).
//
// - Sync timeline (ID "TIMELINE BPM SYNC") locks the VibeVJ timeline to the tempo master deck (like the audio analysis),
//   Bar lock also puts timeline positions 0, 4, 8 ... on the downbeat.
// - The output controls follow the tempo master deck and can be linked like any other control.
// - Low / Mid / High follow the waveform of the master deck at the playhead.
// - Source "Demo" replays a recorded DJ set (demo/demo_set.jsonl), no hardware needed.
// - Source "Network" takes the data from a relay ESP32 in the light/VJ network (ShizoNet) instead of USB:
//   the listener ESP32 sits in the DJ network, the relay passes its lines on (prolink-bridge docs/relay-und-audio.md).
// - Source "Network card" needs no DJ Watch: this computer joins the DJ network itself through one of its network
//   cards (prolink device.lan(), best a card of its own for the DJ network, apart from Art-Net). "Network card" empty =
//   the card on which CDJs show up; "Listen only" never sends anything (tempo and beats only, no track data).
//
// Firmware, protocol and wiring of DJ Watch (repository still named prolink-bridge): https://github.com/shizotech/prolink-bridge
import nanogui;
import prolink;

using eigen;

managed device = None;

status = None;
sync = None;
bar_lock = None;
source = None;
port_text = None;
card_text = None;
listen_only = None;
phase_offset = None;
pulse_ms = None;

bpm = None;
beat = None;
bar = None;
beat_pulse = None;
downbeat_pulse = None;
cue_beats = None;
cue_ramp = None;
drop_pulse = None;
progress = None;
playing = None;
on_air = None;
master_deck = None;
low = None;
mid = None;
high = None;

demo_path = "";
open_source = -1;
open_port = "";
open_card = "";
open_listen_only = -1;

SOURCE_USB = 0;
SOURCE_DEMO = 1;
SOURCE_NETWORK = 2;
SOURCE_LAN = 3;

// Wall-clock (ms) of the last master beat / downbeat / memory cue
last_beat_ms = -100000.0;
last_downbeat_ms = -100000.0;
last_drop_ms = -100000.0;
status_text = "";

dispatcher(generator, cmd, value) {

}

open_device() {
	open_source = source.value();
	open_port = port_text.value();
	open_card = card_text.value();
	open_listen_only = listen_only.value();
	port_text.visible(open_source == SOURCE_USB);
	card_text.visible(open_source == SOURCE_LAN);
	listen_only.visible(open_source == SOURCE_LAN);

	device.close();
	if(open_source == SOURCE_DEMO)
		device.replay(demo_path, 1.0, true);
	else if(open_source == SOURCE_NETWORK)
		device.network();
	else if(open_source == SOURCE_LAN)
		device.lan(open_card, open_listen_only != 0);
	else
		device.open(open_port);
}

source_changed() {
	if(source.value() != open_source || port_text.value() != open_port)
		return true;
	return card_text.value() != open_card || listen_only.value() != open_listen_only;
}

// Status of the source "Network card" (DJ Watch without the hardware)
lan_status(master_found) {
	card = device.port();
	if(!card) {
		if(device.error())
			return device.error();
		return "Looking for CDJs on all network cards…";
	}
	st = device.state();
	esp = st.esp;
	devices = esp.devices ?? 0;
	// This computer's own broadcasts (ShizoNet, Art-Net broadcast) would land in the DJ network
	if(esp.djBroadcasts)
		return "Network card " + card + ": the computer's broadcasts go into the DJ network (wiki: network card)";
	if(devices == 0)
		return "Network card " + card + ": no CDJs yet";
	if(!master_found) {
		if(open_listen_only)
			return "Network card " + card + " (listen only), no tempo master";
		if(esp.vcdj != "active")
			return "Network card " + card + ": joining the DJ network…";
		return "Network card " + card + ", no tempo master";
	}
	return "";
}

wrap_phase(p) {
	p = p + phase_offset.value();
	if(p >= 1.0)
		p -= 1.0;
	if(p < 0.0)
		p += 1.0;
	return p;
}

pulse(since_ms) {
	if(since_ms >= 0 && since_ms < pulse_ms.value())
		return 1.0;
	return 0.0;
}

set_status(text) {
	if(text != status_text) {
		status_text = text;
		status.text(text);
	}
}

//Other generators read the decks of this device and open no connection of their own (the sync of a video clip,
//engine/generators/extensions/video/video_module.shio, #460): std.global("prolink_sources") = [<key> = device]
prolink_source_key = "";

publish_device() {
	sources = std.global("prolink_sources");
	if(!sources.get())
		sources.set(std.json());
	if(!prolink_source_key)
		prolink_source_key = "src_" + std.random_hash(8);
	entries = sources.get();
	entries[prolink_source_key] = device;
}

on_free() {
	if(prolink_source_key)
		std.global("prolink_sources").remove(prolink_source_key);
}

entry(generator, area) {
	generator.window.fixed_size(vec2f(420, 560));

	top_area = area.vscroll().anchor(0).anchor_bottom(0);
	area = top_area.content().layout(nanogui.layout_vertical());

	status = area.label("DJ Watch not connected").fixed_height(24);

	sync = area.controlbutton("TIMELINE BPM SYNC").tooltip("The [[timeline]] follows the tempo master deck while it plays\n[[wiki:Output-and-Devices#prolink-cdjs]]").caption("Sync timeline").push(1).value(1);
	bar_lock = area.controlbutton("BAR LOCK").tooltip("Sync timeline also puts the bar of the timeline on the downbeat of the deck").caption("Bar lock").push(1).value(1);

	bpm = area.controlfloat("BPM").tooltip("The tempo of the master deck").max(999);
	beat = area.controlslider("BEAT").tooltip("Where the master deck is inside the current [[beat]], 0 to 1").caption("Beat");
	bar = area.controlslider("BAR").tooltip("Where the master deck is inside the current bar, 0 to 1").caption("Bar");
	beat_pulse = area.controlslider("BEAT PULSE").tooltip("1 on every beat of the master deck, for Pulse length").caption("Beat pulse");
	downbeat_pulse = area.controlslider("DOWNBEAT PULSE").tooltip("1 on every downbeat (the first beat of a bar), for Pulse length").caption("Downbeat pulse");

	cue_cnt = area.collapsable("Cue / Drop").content().layout(nanogui.layout_vertical());
	cue_beats = cue_cnt.controlfloat("BEATS TO CUE").tooltip("Beats until the next memory cue of the master deck. —: no cue ahead").caption("Cue in").unit("beats").decimals(0).value_word(-1, "—").min(-1).max(256);
	cue_ramp = cue_cnt.controlslider("CUE RAMP").tooltip("Rises from 0 to 1 over the last 16 beats before the next memory cue: for a build-up").caption("Cue ramp");
	drop_pulse = cue_cnt.controlslider("DROP PULSE").tooltip("1 when the master deck reaches a memory cue, for Pulse length").caption("Drop pulse");

	deck_cnt = area.collapsable("Deck").content().layout(nanogui.layout_vertical());
	progress = deck_cnt.controlslider("PROGRESS").tooltip("How far the track of the master deck has played, 0 to 1").caption("Progress");
	playing = deck_cnt.controlslider("PLAYING").tooltip("1 while the master deck plays").caption("Playing");
	on_air = deck_cnt.controlslider("ON AIR").tooltip("1 while the master deck is on air at the mixer").caption("On air");
	master_deck = deck_cnt.controlfloat("MASTER DECK").tooltip("The number of the tempo master deck. —: none").caption("Master deck").decimals(0).value_word(0, "—").max(64);

	// Bass, mids and highs of the waveform at the playhead: like an audio analysis, without an audio line
	level_cnt = area.collapsable("Levels").content().layout(nanogui.layout_vertical());
	low = level_cnt.controlslider("LOW").tooltip("The bass in the waveform at the playhead, 0 to 1").caption("Low");
	mid = level_cnt.controlslider("MID").tooltip("The mids in the waveform at the playhead, 0 to 1").caption("Mid");
	high = level_cnt.controlslider("HIGH").tooltip("The highs in the waveform at the playhead, 0 to 1").caption("High");

	settings = area.collapsable("Settings").content().layout(nanogui.layout_vertical());
	source = settings.controlcombo("SOURCE").tooltip("USB: DJ Watch on USB. Demo: a recorded set. Network: a relay over ShizoNet. Network card: no DJ Watch, this computer joins the DJ network\n[[wiki:Output-and-Devices#prolink-cdjs]]").caption("Source");
	source.items(["USB", "Demo", "Network", "Network card"]).segmented(true); //index-based (SOURCE_USB = 0, …, SOURCE_LAN = 3)
	source.tooltip("Where the CDJ data comes from. USB: DJ Watch on this computer. Demo: a recorded set. Network: a DJ Watch relay over ShizoNet. Network card: no DJ Watch, this computer joins the DJ network itself\n[[wiki:Output-and-Devices#prolink-cdjs]]");
	port_text = settings.controltext("PORT (empty = auto)").tooltip("USB: the port of DJ Watch. Empty: it is found by itself").caption("Port (empty = auto)").value("");
	card_text = settings.controltext("NETWORK CARD (empty = auto)").tooltip("Network card: the card in the DJ network, name or address. Empty: the card on which CDJs show up\n[[wiki:Output-and-Devices#without-dj-watch-network-card]]").caption("Network card (empty = auto)").value("");
	card_text.tooltip("Network card in the DJ network: its name (Windows: \"Ethernet 2\", Linux: eth1, macOS: en7) or its address. Empty: the card on which CDJs show up\n[[wiki:Output-and-Devices#without-dj-watch-network-card]]");
	listen_only = settings.controlbutton("LISTEN ONLY").tooltip("Network card: send nothing into the DJ network. Then only tempo, beats and on air come in, no titles, waveforms or cues\n[[wiki:Output-and-Devices#without-dj-watch-network-card]]").caption("Listen only").push(1).value(0);
	listen_only.tooltip("Send nothing into the DJ network: tempo and beats only, no track titles, waveforms or cues\n[[wiki:Output-and-Devices#without-dj-watch-network-card]]");
	phase_offset = settings.controlslider("Phase offset").tooltip("Moves the beat earlier or later, up to half a beat").unit("beats").min(-0.5).max(0.5).value(0.0);
	pulse_ms = settings.controlfloat("Pulse ms").tooltip("How long the pulses stay at 1, 10 to 1000 ms").caption("Pulse length").unit("ms").min(10).max(1000).value(100);

	demo_path = generator.path + "/demo/demo_set.jsonl";

	device = prolink.device();
	publish_device();
	open_device();
}

update(generator, tl_pos, pos_delta) {
	if(!device)
		return;

	// Source, port or network card changed (also after loading a project)
	if(source_changed())
		open_device();

	now = std.millis();

	// Beats and memory cues of the master deck. ageMs = how long ago it happened.
	events = device.events();
	for(i = 0; i < events.size(); i++) {
		e = events[i];
		if(e.type == "beat" && e.master) {
			last_beat_ms = now - e.ageMs;
			if(e.bb == 1)
				last_downbeat_ms = now - e.ageMs;
		}
		else if(e.type == "cue" && e.master) {
			last_drop_ms = now - e.ageMs;
			//the lighting desk: cues that start on a drop (#719)
			desk = std.global("engine").desk;
			if(desk)
				desk.music_event("drop");
		}
	}

	beat_pulse.value(pulse(now - last_beat_ms));
	downbeat_pulse.value(pulse(now - last_downbeat_ms));
	drop_pulse.value(pulse(now - last_drop_ms));

	m = device.master();

	if(!m) {
		playing.value(0);
		master_deck.value(0);
		if(open_source == SOURCE_LAN)
			set_status(lan_status(false));
		else if(device.connected())
			set_status("DJ Watch connected, no tempo master");
		else if(device.error())
			set_status(device.error());
		else
			set_status("Connecting to DJ Watch…");
		return;
	}

	bpm.value(m.effectiveBpm);
	beat.value(wrap_phase(m.beatPhase));
	bar.value(m.barPhase);
	cue_beats.value(m.beatsToCue);
	cue_ramp.value(m.cueRamp);
	playing.value(m.playing ? 1 : 0);
	on_air.value(m.onAir ? 1 : 0);
	master_deck.value(m.n);
	low.value(m.low);
	mid.value(m.mid);
	high.value(m.high);

	// Track length: CDJ-3000 position packets, else the metadata
	length_ms = m.lengthS * 1000.0;
	title = "Deck " + std.string(m.n);
	track = m.track;
	if(track) {
		if(track.dur)
			length_ms = track.dur * 1000.0;
		if(track.title)
			title = title + ": " + track.title;
		if(track.artist)
			title = title + " - " + track.artist;
	}
	set_status(title);

	// Position is only known for CDJ-3000 (None otherwise)
	if(m.positionMs) {
		if(length_ms > 0)
			progress.value(math.clamp(m.positionMs / length_ms, 0.0, 1.0));
	}

	// Only follow a running deck: a stopped one has no phase, the timeline then runs freely
	if(sync.value() && m.playing && m.effectiveBpm > 0) {
		timeline = std.global("timeline");
		timeline.set_bpm(m.effectiveBpm);
		if(bar_lock.value() && m.beatInBar > 0) {
			// Phase offset is in beats, the bar has 4
			bar_phase = math.fract(m.barPhase + phase_offset.value() / 4.0);
			timeline.nudge_bar(bar_phase, 4, true);
		}
		else
			timeline.lock_position(wrap_phase(m.beatPhase));
	}
}
