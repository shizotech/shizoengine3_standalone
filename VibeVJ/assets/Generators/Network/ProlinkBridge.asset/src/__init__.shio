// ProlinkBridge generator (asset name and control IDs stay, saved projects use them)
// CDJ data (Pioneer Pro DJ Link) straight from DJ Watch (the ESP32 in the DJ network, hostname dj-watch.local;
// formerly called prolink-bridge) over USB, no bridge.py, no Art-Net. Needs the native module 'prolink' (shzmodule_prolink).
//
// - Sync timeline (ID "TIMELINE BPM SYNC") locks the VibeVJ timeline to the deck that gives the tempo (like the audio
//   analysis), Bar lock also puts timeline positions 0, 4, 8 ... on the downbeat.
// - Tempo from (ID "TEMPO FROM"): which deck that is. Auto: the tempo master deck, else the deck that is on air and
//   playing, else a playing one (device.lead(): rank master x4 + (on air and playing) x2 + playing, so with CDJs and
//   Denon players the master that is also live wins); or a fixed deck 1-6. The deck gets "sendingBpm" in player(n)
//   while the timeline follows it (the SEND BPM marker of a deck view). The timeline passes the tempo on to lighting
//   desks and Ableton Link (TC popup, tempo_panel.shio).
// - The output controls follow that deck and can be linked like any other control.
// - Low / Mid / High follow the waveform of the master deck at the playhead.
// - Now playing (ID "NOW PLAYING"): the deck whose track the audience hears (device.now_playing(): the mix status of the
//   prolink module, set in the History of Prolink Decks or DJ Watch), its title in the line under it.
// - Source "Demo" replays a recorded DJ set (demo/demo_set.jsonl), no hardware needed.
// - Source "Network" takes the data from a relay ESP32 in the light/VJ network (ShizoNet) instead of USB:
//   the listener ESP32 sits in the DJ network, the relay passes its lines on (prolink-bridge docs/relay-und-audio.md).
// - Mixer: the channel faders, EQ and VU meters of the DJ mixer (Pioneer DJM with "Mixer data" on, source Network card;
//   Denon mixers: faders) per channel as outputs, FADER / VU of the channel of the deck it follows (Tempo from). "Enhanced on air" keeps ON AIR
//   at 1 while a deck that was on air plays on through a short fader dip.
// - Source "Network card" needs no DJ Watch: this computer joins the DJ network itself through one of its network
//   cards (prolink device.lan(), best a card of its own for the DJ network, apart from Art-Net). "Network card" empty =
//   the card on which CDJs show up; "Listen only" never sends anything (tempo and beats only, no track data).
//   Denon players (Engine DJ, StageLinQ) on the same card(s) come in the same way: player number = deck (stagelinq/ of the
//   prolink module); "Listen only" shows them as devices only.
//
// Firmware, protocol and wiring of DJ Watch (repository still named prolink-bridge): https://github.com/shizotech/prolink-bridge
import nanogui;
import prolink;

using eigen;

managed device = None;

status = None;
sync = None;
bar_lock = None;
source = None;
port_text = None;
card_text = None;
listen_only = None;
phase_offset = None;
pulse_ms = None;
tempo_from = None;

bpm = None;
beat = None;
bar = None;
beat_pulse = None;
downbeat_pulse = None;
cue_beats = None;
cue_ramp = None;
drop_pulse = None;
progress = None;
playing = None;
on_air = None;
master_deck = None;
now_playing_deck = None;
now_playing_label = None;
now_playing_text = "";
low = None;
mid = None;
high = None;

// Mixer (channel faders, EQ, VU; prolink device.mixer())
fader = None;          // FADER / VU: the channel of the master deck
vu = None;
crossfader = None;
mixer_ctrls = [];      // per mixer channel 1-4: [fader, vu, low, mid, high]
mixer_data = None;     // settings: DJM mixer data (bridge identity), enhanced on air, its hold time
enhanced = None;
live_hold = None;
sent_mixer = -1;       // value last sent to the session, -1 = nothing yet (sent only when on, or after a change)
sent_enhanced = -1;
sent_hold = -1.0;

demo_path = "";
open_source = -1;
open_port = "";
open_card = "";
open_listen_only = -1;

SOURCE_USB = 0;
SOURCE_DEMO = 1;
SOURCE_NETWORK = 2;
SOURCE_LAN = 3;

// Wall-clock (ms) of the last master beat / downbeat / memory cue
last_beat_ms = -100000.0;
last_downbeat_ms = -100000.0;
last_drop_ms = -100000.0;
status_text = "";

dispatcher(generator, cmd, value) {

}

open_device() {
	open_source = source.value();
	open_port = port_text.value();
	open_card = card_text.value();
	open_listen_only = listen_only.value();
	port_text.visible(open_source == SOURCE_USB);
	card_text.visible(open_source == SOURCE_LAN);
	listen_only.visible(open_source == SOURCE_LAN);

	device.close();
	sent_mixer = -1;
	sent_enhanced = -1;
	sent_hold = -1.0;
	if(open_source == SOURCE_DEMO)
		device.replay(demo_path, 1.0, true);
	else if(open_source == SOURCE_NETWORK)
		device.network();
	else if(open_source == SOURCE_LAN)
		device.lan(open_card, open_listen_only != 0);
	else
		device.open(open_port);
}

source_changed() {
	if(source.value() != open_source || port_text.value() != open_port)
		return true;
	return card_text.value() != open_card || listen_only.value() != open_listen_only;
}

// Mixer settings into the session. The first time only what is on: another generator on the same connection (Prolink
// Decks) may have switched it on. Mixer data (bridge identity) only for the source Network card, never Listen only.
apply_mixer_settings() {
	if(!device.connected())
		return None;
	want = 0;
	if(open_source == SOURCE_LAN && !open_listen_only && mixer_data.value())
		want = 1;
	if(open_source == SOURCE_LAN && want != sent_mixer && (sent_mixer >= 0 || want)) {
		device.mixer_bridge(want != 0);
		sent_mixer = want;
	}
	else if(sent_mixer < 0)
		sent_mixer = want;
	on = enhanced.value() ? 1 : 0;
	hold = live_hold.value();
	if((on != sent_enhanced || hold != sent_hold) && (sent_enhanced >= 0 || on)) {
		device.enhanced_on_air(on != 0, hold);
		sent_enhanced = on;
		sent_hold = hold;
	}
	else if(sent_enhanced < 0) {
		sent_enhanced = on;
		sent_hold = hold;
	}
}

value_or_zero(v) {
	if(std.is_none(v))
		return 0.0;
	return v;
}

// Mixer channels 1-4 into the outputs; 0 where the mixer sends nothing
update_mixer(m) {
	mx = device.mixer();
	chans = [];
	if(mx && mx.ch)
		chans = mx.ch;
	for(c = 0; c < mixer_ctrls.size(); c++) {
		ctrl = mixer_ctrls[c];
		ch = None;
		if(c < chans.size())
			ch = chans[c];
		if(!ch) {
			ctrl[0].value(0);
			ctrl[1].value(0);
			continue;
		}
		ctrl[0].value(value_or_zero(ch.fader));
		ctrl[1].value(value_or_zero(ch.vu));
		ctrl[2].value(value_or_zero(ch.eqLow));
		ctrl[3].value(value_or_zero(ch.eqMid));
		ctrl[4].value(value_or_zero(ch.eqHigh));
	}
	crossfader.value(mx ? value_or_zero(mx.crossfader) : 0.0);
	if(m) {
		fader.value(value_or_zero(m.fader));
		vu.value(value_or_zero(m.vu));
	}
	else {
		fader.value(0);
		vu.value(0);
	}
}

// Denon units (StageLinQ) with a running connection, from the "sl" status of the Denon listener of the session
denon_players(esp) {
	sl = esp.stagelinq;
	if(!sl || !sl.devices)
		return 0;
	n = 0;
	for(d : sl.devices)
		if(d.connected)
			n++;
	return n;
}

// Status of the source "Network card" (DJ Watch without the hardware): Pioneer CDJs and Denon players
lan_status(master_found) {
	card = device.port();
	if(!card) {
		if(device.error())
			return device.error();
		return "Looking for CDJs and Denon players on all network cards…";
	}
	st = device.state();
	esp = st.esp;
	devices = esp.devices ?? 0;
	denon = denon_players(esp);
	// This computer's own broadcasts (ShizoNet, Art-Net broadcast) would land in the DJ network
	if(esp.djBroadcasts)
		return "Network card " + card + ": the computer's broadcasts go into the DJ network (wiki: network card)";
	if(devices == 0 && denon == 0)
		return "Network card " + card + ": no CDJs or Denon players yet";
	if(!master_found) {
		if(open_listen_only)
			return "Network card " + card + " (listen only), no tempo master";
		if(denon == 0 && esp.vcdj != "active")
			return "Network card " + card + ": joining the DJ network…";
		return "Network card " + card + ", no tempo master";
	}
	return "";
}

wrap_phase(p) {
	p = p + phase_offset.value();
	if(p >= 1.0)
		p -= 1.0;
	if(p < 0.0)
		p += 1.0;
	return p;
}

pulse(since_ms) {
	if(since_ms >= 0 && since_ms < pulse_ms.value())
		return 1.0;
	return 0.0;
}

set_status(text) {
	if(text != status_text) {
		status_text = text;
		status.text(text);
	}
}

//Other generators read the decks of this device and open no connection of their own (the sync of a video clip,
//engine/generators/extensions/video/video_module.shio, #460): std.global("prolink_sources") = [<key> = device]
prolink_source_key = "";

publish_device() {
	sources = std.global("prolink_sources");
	if(!sources.get())
		sources.set(std.json());
	if(!prolink_source_key)
		prolink_source_key = "src_" + std.random_hash(8);
	entries = sources.get();
	entries[prolink_source_key] = device;
}

on_free() {
	if(prolink_source_key)
		std.global("prolink_sources").remove(prolink_source_key);
}

entry(generator, area) {
	generator.window.fixed_size(vec2f(420, 560));

	top_area = area.vscroll().anchor(0).anchor_bottom(0);
	area = top_area.content().layout(nanogui.layout_vertical());

	status = area.label("DJ Watch not connected").fixed_height(24);

	sync = area.controlbutton("TIMELINE BPM SYNC").tooltip("The [[timeline]] follows the tempo master deck while it plays\n[[wiki:Output-and-Devices#prolink-cdjs]]").caption("Sync timeline").push(1).value(1);
	bar_lock = area.controlbutton("BAR LOCK").tooltip("Sync timeline also puts the bar of the timeline on the downbeat of the deck").caption("Bar lock").push(1).value(1);

	bpm = area.controlfloat("BPM").tooltip("The tempo of the master deck").max(999);
	beat = area.controlslider("BEAT").tooltip("Where the master deck is inside the current [[beat]], 0 to 1").caption("Beat");
	bar = area.controlslider("BAR").tooltip("Where the master deck is inside the current bar, 0 to 1").caption("Bar");
	beat_pulse = area.controlslider("BEAT PULSE").tooltip("1 on every beat of the master deck, for Pulse length").caption("Beat pulse");
	downbeat_pulse = area.controlslider("DOWNBEAT PULSE").tooltip("1 on every downbeat (the first beat of a bar), for Pulse length").caption("Downbeat pulse");

	cue_cnt = area.collapsable("Cue / Drop").content().layout(nanogui.layout_vertical());
	cue_beats = cue_cnt.controlfloat("BEATS TO CUE").tooltip("Beats until the next memory cue of the master deck. —: no cue ahead").caption("Cue in").unit("beats").decimals(0).value_word(-1, "—").min(-1).max(256);
	cue_ramp = cue_cnt.controlslider("CUE RAMP").tooltip("Rises from 0 to 1 over the last 16 beats before the next memory cue: for a build-up").caption("Cue ramp");
	drop_pulse = cue_cnt.controlslider("DROP PULSE").tooltip("1 when the master deck reaches a memory cue, for Pulse length").caption("Drop pulse");

	deck_cnt = area.collapsable("Deck").content().layout(nanogui.layout_vertical());
	progress = deck_cnt.controlslider("PROGRESS").tooltip("How far the track of the master deck has played, 0 to 1").caption("Progress");
	playing = deck_cnt.controlslider("PLAYING").tooltip("1 while the master deck plays").caption("Playing");
	on_air = deck_cnt.controlslider("ON AIR").tooltip("1 while the master deck is on air at the mixer").caption("On air");
	fader = deck_cnt.controlslider("FADER").tooltip("The channel fader at the mixer of the deck these outputs follow (Tempo from), 0 to 1 (DJM: Mixer data on; Denon mixers). 0 when the mixer sends no faders").caption("Fader").as_output(true);
	vu = deck_cnt.controlslider("VU").tooltip("The level meter at the mixer of the deck these outputs follow (Tempo from), 0 to 1 (DJM: Mixer data on). 0 when the mixer sends none").caption("VU").as_output(true);
	master_deck = deck_cnt.controlfloat("MASTER DECK").tooltip("The number of the tempo master deck. —: none").caption("Master deck").decimals(0).value_word(0, "—").max(64);
	now_playing_deck = deck_cnt.controlfloat("NOW PLAYING").tooltip("The deck whose track the audience hears now (the track the history counts). —: none\n[[wiki:Output-and-Devices#history-and-playlist]]").caption("Now playing").decimals(0).value_word(0, "—").max(64);
	now_playing_label = deck_cnt.label("").fixed_height(22);

	// Bass, mids and highs of the waveform at the playhead: like an audio analysis, without an audio line
	level_cnt = area.collapsable("Levels").content().layout(nanogui.layout_vertical());
	low = level_cnt.controlslider("LOW").tooltip("The bass in the waveform at the playhead, 0 to 1").caption("Low");
	mid = level_cnt.controlslider("MID").tooltip("The mids in the waveform at the playhead, 0 to 1").caption("Mid");
	high = level_cnt.controlslider("HIGH").tooltip("The highs in the waveform at the playhead, 0 to 1").caption("High");

	// The DJ mixer per channel (player n plays on channel n unless set otherwise; Denon: what the mixer says)
	mixer_cnt = area.collapsable("Mixer").content().layout(nanogui.layout_vertical());
	crossfader = mixer_cnt.controlslider("CROSSFADER").tooltip("The crossfader of the mixer, 0 = side A, 1 = side B").caption("Crossfader").as_output(true);
	for(c = 1; c <= 4; c++) {
		group = "mixer_ch" + std.string(c);
		label = "Ch " + std.string(c) + " ";
		mixer_ctrls.push_back([
			mixer_cnt.controlslider("FADER", group).tooltip("The fader of mixer channel " + std.string(c) + ", 0 to 1").caption(label + "fader").as_output(true),
			mixer_cnt.controlslider("VU", group).tooltip("The level meter of mixer channel " + std.string(c) + ", 0 to 1 (DJM only)").caption(label + "VU").as_output(true),
			mixer_cnt.controlslider("EQ LOW", group).tooltip("The low EQ knob of channel " + std.string(c) + ", 0.5 = flat (DJM only)").caption(label + "EQ low").as_output(true),
			mixer_cnt.controlslider("EQ MID", group).tooltip("The mid EQ knob of channel " + std.string(c) + ", 0.5 = flat (DJM only; DJM-V10: HI MID)").caption(label + "EQ mid").as_output(true),
			mixer_cnt.controlslider("EQ HIGH", group).tooltip("The high EQ knob of channel " + std.string(c) + ", 0.5 = flat (DJM only)").caption(label + "EQ high").as_output(true),
		]);
	}

	settings = area.collapsable("Settings").content().layout(nanogui.layout_vertical());
	source = settings.controlcombo("SOURCE").tooltip("USB: DJ Watch on USB. Demo: a recorded set. Network: a relay over ShizoNet. Network card: no DJ Watch, this computer joins the DJ network (CDJs and Denon players)\n[[wiki:Output-and-Devices#prolink-cdjs]]").caption("Source");
	source.items(["USB", "Demo", "Network", "Network card"]).segmented(true); //index-based (SOURCE_USB = 0, …, SOURCE_LAN = 3)
	source.tooltip("Where the CDJ data comes from. USB: DJ Watch on this computer. Demo: a recorded set. Network: a DJ Watch relay over ShizoNet. Network card: no DJ Watch, this computer joins the DJ network itself (Pioneer CDJs and Denon players)\n[[wiki:Output-and-Devices#prolink-cdjs]]");
	port_text = settings.controltext("PORT (empty = auto)").tooltip("USB: the port of DJ Watch. Empty: it is found by itself").caption("Port (empty = auto)").value("");
	card_text = settings.controltext("NETWORK CARD (empty = auto)").tooltip("Network card: the card in the DJ network, name or address. Empty: the card on which CDJs show up (Denon players: every card)\n[[wiki:Output-and-Devices#without-dj-watch-network-card]]").caption("Network card (empty = auto)").value("");
	card_text.tooltip("Network card in the DJ network: its name (Windows: \"Ethernet 2\", Linux: eth1, macOS: en7) or its address. Empty: the card on which CDJs show up (Denon players: every card)\n[[wiki:Output-and-Devices#without-dj-watch-network-card]]");
	listen_only = settings.controlbutton("LISTEN ONLY").tooltip("Network card: send nothing into the DJ network. Then only tempo, beats and on air come in, no titles, waveforms or cues\n[[wiki:Output-and-Devices#without-dj-watch-network-card]]").caption("Listen only").push(1).value(0);
	listen_only.tooltip("Send nothing into the DJ network: tempo and beats only, no track titles, waveforms or cues\n[[wiki:Output-and-Devices#without-dj-watch-network-card]]");
	phase_offset = settings.controlslider("Phase offset").tooltip("Moves the beat earlier or later, up to half a beat").unit("beats").min(-0.5).max(0.5).value(0.0);
	tempo_from = settings.controlcombo("TEMPO FROM").caption("Tempo from").items(["Auto", "Deck 1", "Deck 2", "Deck 3", "Deck 4", "Deck 5", "Deck 6"]); //index-based: 0 = auto, n = deck n
	tempo_from.tooltip("The deck whose tempo and beat the [[timeline]] follows (and so the lighting desks and Ableton Link). Auto: the tempo master deck, else the deck that is on air and playing, else a playing one\n[[wiki:Lighting-Desk#which-deck-gives-the-tempo]]");
	mixer_data = settings.controlbutton("MIXER DATA").caption("Mixer data (DJM)").push(1).value(0)
		.tooltip("Network card: this computer also announces itself as a PRO DJ LINK Bridge, so a Pioneer DJM sends its faders, EQ and level meters. A DJM decides on the first announcement it sees: if it refuses, switch the mixer off and on\n[[wiki:Output-and-Devices#mixer-data]]");
	enhanced = settings.controlbutton("ENHANCED ON AIR").caption("Enhanced on air").push(1).value(0)
		.tooltip("A deck that was on air and keeps playing stays on air through a short fader dip or a sing-along with the fader down (for Hold)\n[[wiki:Output-and-Devices#mixer-data]]");
	live_hold = settings.controlfloat("LIVE HOLD").caption("Hold").unit("s").min(0).max(120).value(10)
		.tooltip("How long a playing deck stays on air with its channel closed (Enhanced on air). 0: as long as it plays");
	pulse_ms = settings.controlfloat("Pulse ms").tooltip("How long the pulses stay at 1, 10 to 1000 ms").caption("Pulse length").unit("ms").min(10).max(1000).value(100);

	demo_path = generator.path + "/demo/demo_set.jsonl";

	device = prolink.device();
	publish_device();
	open_device();
}

update(generator, tl_pos, pos_delta) {
	if(!device)
		return;

	// Source, port or network card changed (also after loading a project)
	if(source_changed())
		open_device();

	now = std.millis_steady();

	// The deck that gives the tempo (Tempo from); marked as sending while the timeline follows it
	m = device.lead(tempo_from.value(), sync.value() ? true : false);
	lead_n = m ? m.n : 0;

	// Beats of that deck and memory cues of the master deck. ageMs = how long ago it happened.
	events = device.events();
	for(i = 0; i < events.size(); i++) {
		e = events[i];
		if(e.type == "beat" && e.n == lead_n) {
			last_beat_ms = now - e.ageMs;
			if(e.bb == 1)
				last_downbeat_ms = now - e.ageMs;
		}
		else if(e.type == "cue" && e.master) {
			last_drop_ms = now - e.ageMs;
			//the lighting desk: cues that start on a drop (#719)
			desk = std.global("engine").desk;
			if(desk)
				desk.music_event("drop");
		}
	}

	// The track the audience hears (prolink mix status)
	np = device.now_playing();
	now_playing_deck.value(np ? np.n : 0);
	np_text = np ? "Now playing: deck " + std.string(np.n) + (np.title ? "  " + np.title + (np.artist ? " - " + np.artist : "") : "") : "";
	if(np_text != now_playing_text) {
		now_playing_text = np_text;
		now_playing_label.caption(np_text);
	}

	beat_pulse.value(pulse(now - last_beat_ms));
	downbeat_pulse.value(pulse(now - last_downbeat_ms));
	drop_pulse.value(pulse(now - last_drop_ms));

	apply_mixer_settings();
	update_mixer(m); // m: the deck of Tempo from (device.lead)

	if(!m) {
		playing.value(0);
		master_deck.value(0);
		if(open_source == SOURCE_LAN)
			set_status(lan_status(false));
		else if(device.connected())
			set_status(tempo_from.value() > 0 ? "Deck " + std.string(tempo_from.value()) + " has no tempo" : "DJ Watch connected, no deck plays");
		else if(device.error())
			set_status(device.error());
		else
			set_status("Connecting to DJ Watch…");
		return;
	}

	bpm.value(m.effectiveBpm);
	beat.value(wrap_phase(m.beatPhase));
	bar.value(m.barPhase);
	cue_beats.value(m.beatsToCue);
	cue_ramp.value(m.cueRamp);
	playing.value(m.playing ? 1 : 0);
	on_air.value(m.live || m.onAir ? 1 : 0); // live: Enhanced on air (= onAir when it is off)
	master_deck.value(device.master() ? device.master().n : 0);
	low.value(m.low);
	mid.value(m.mid);
	high.value(m.high);

	// Track length: CDJ-3000 position packets, else the metadata
	length_ms = m.lengthS * 1000.0;
	title = "Deck " + std.string(m.n) + (m.master ? "" : " (tempo)");
	track = m.track;
	if(track) {
		if(track.dur)
			length_ms = track.dur * 1000.0;
		if(track.title)
			title = title + ": " + track.title;
		if(track.artist)
			title = title + " - " + track.artist;
	}
	set_status(title);

	// Position is only known for CDJ-3000 (None otherwise)
	if(m.positionMs) {
		if(length_ms > 0)
			progress.value(math.clamp(m.positionMs / length_ms, 0.0, 1.0));
	}

	// Only follow a running deck: a stopped one has no phase, the timeline then runs freely
	if(sync.value() && m.playing && m.effectiveBpm > 0) {
		timeline = std.global("timeline");
		timeline.set_bpm(m.effectiveBpm, true); //measured: the lighting desks get it steadied
		if(bar_lock.value() && m.beatInBar > 0) {
			// Phase offset is in beats, the bar has 4
			bar_phase = math.fract(m.barPhase + phase_offset.value() / 4.0);
			timeline.nudge_bar(bar_phase, 4, true);
		}
		else
			timeline.lock_position(wrap_phase(m.beatPhase));
	}
}
