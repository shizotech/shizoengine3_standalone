//Art-Net sender: rows with a slider that send single channels to one Art-Net node.
//The control IDs stay ("U", "C", CTRLn of each row, "START UNIVERSE", "START CHANNEL", the vector "Channels"): saved
//projects, links, MIDI mappings and the preset CHEAP_MVHEAD use them. Only the captions say what they are.
//The node is remembered by its MAC address (save_state key "mac").

import nanogui;

using eigen;

managed vs = None;
managed channel_list_area = None;
managed start_universe = None;
managed start_channel = None;
managed empty_label = None;

ROW = 28;
GAP = 4;
UNIVERSE_W = 92;
CHANNEL_W = 100;
NO_NODE = "No node";

artnet_active = true;

channel_max = 1;
channel_list = [];

net = None;

device = None;
device_mac = "";   //the MAC of the node the rows send to, "" = none
device_list = [];
selector = None;
node_info = None;

last_universe = 0;
last_start_index = 1;
last_find = 0; //std.millis() of the last look for a saved node that has not answered (update)

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return;

		artnet_active = value;
	}
}

//A theme colour ({r,g,b,a} 0..1) as vec4f, the token default when the theme does not have it
theme_color(t, key, fallback) {
	if(t && t.has(key)) {
		c = t[key];
		return vec4f(c.r, c.g, c.b, c.a);
	}
	return fallback;
}

//Two halves of a row with a gap between them
row_half(row, right) {
	half = row.widget().anchor_top(0).anchor_bottom(0);
	if(right)
		half.anchor_left(0.5, "percent").anchor_right(0);
	else
		half.anchor_left(0).anchor_right(0.5, "percent");
	return half;
}

//Rows removed since the last frame: freed at the start of update(), where no widget event is running
pending_free = [];
flush_pending_free() {
	if(pending_free.size() == 0)
		return;
	for(i = 0; i < pending_free.size(); i++)
		std.free(pending_free[i]);
	pending_free.clear();
}

//Every row once to the node: when it is picked or found again (the faders send only when they move)
send_all() {
	if(!artnet_active || !device)
		return;
	for(i = 0; i < channel_list.size(); i++) {
		e = channel_list[i];
		v = e.value.value();
		u = start_universe.value() + e.universe.value();
		c = (start_channel.value() - 1) + (e.channel.value() - 1);
		if(e.type == "16bit") {
			value_16bit = v * 65535.0;
			device.set_artnet_channel(u, c, std.int(value_16bit / 256.0));
			device.set_artnet_channel(u, c + 1, std.int(math.mod(value_16bit, 256.0)));
		}
		else
			device.set_artnet_channel(u, c, v * 255.0);
	}
}

update_empty() {
	if(empty_label)
		empty_label.visible(channel_list.size() == 0);
}

//The list of nodes: device_list.items are its entries, device_list.devs the node of each entry after "No node"
//(None for a saved node that has not answered yet). It is rebuilt only here, never inside on_change: items() deletes
//the item buttons, and the click of one of them is still running there. syncing keeps the selected() of this function
//from running on_change again
syncing = false;
set_list(items, devs, sel) {
	device_list.items = items;
	device_list.devs = devs;
	syncing = true;
	selector.items(items);
	selector.selected(sel);
	syncing = false;
}

//The line under the list
show_info() {
	if(!device_mac)
		node_info.caption("Pick the node the rows send to");
	else if(device)
		node_info.caption("IP " + device.ip() + " · MAC " + device_mac);
	else
		node_info.caption("MAC " + device_mac + " · not found on the network");
}

//The picked node alone in the list (at the start, after a load, when the node answers)
show_device(name) {
	if(!device_mac)
		set_list([NO_NODE], [], 0);
	else if(device)
		set_list([NO_NODE, device.name()], [device], 1);
	else
		set_list([NO_NODE, name ?? device_mac], [None], 1);
	show_info();
}

//The node of device_mac, found again when it was not there yet (it answers a while after the start)
find_device() {
	if(!device && device_mac) {
		device = net.find_artnet_device(device_mac);
		if(device)
			show_device(None);
	}
	return device;
}

update(generator, tl_pos, pos_delta) {
	flush_pending_free();

	//A saved node that was not there at the load is looked for once a second. Before, only a moved fader looked for
	//it: a node switched on later got nothing until then, and the list kept saying "not found" (#436)
	if(device_mac && !device && std.millis() - last_find > 1000) {
		last_find = std.millis();
		if(find_device())
			send_all();
	}
}

add_new_ctrl(ctrl_id, type="8bit")
{
	row = channel_list_area.widget().fixed_height(ROW).anchor_left(0).anchor_right(0);

	universe = row.controlint("U", ctrl_id).caption("Universe").tooltip("The [[art-net|Art-Net]] universe this row sends to").min(0).max(32767).value(last_universe)
		.anchor_left(0).anchor_top(0).anchor_bottom(0).fixed_width(UNIVERSE_W);
	channel = row.controlint("C", ctrl_id).caption("Channel").tooltip(type == "16bit" ? "The first of the two channels this row sends to, 1 to 511" : "The channel this row sends to, 1 to 512")
		.min(1).max(512).value(last_start_index)
		.anchor_left(UNIVERSE_W + GAP).anchor_top(0).anchor_bottom(0).fixed_width(CHANNEL_W);

	universe.hide_config_menu();
	channel.hide_config_menu();

	tip = type == "16bit" ? "What the two channels send, 0 to 1 as 0 to 65535 (the first channel coarse, the second fine)" : "What the channel sends, 0 to 1 as 0 to 255";
	val = row.controlslider(ctrl_id, ctrl_id).caption(ctrl_id.replace("CTRL", "Value ")).tooltip(tip)
		.anchor_left(UNIVERSE_W + GAP + CHANNEL_W + GAP).anchor_right(ROW + GAP).anchor_top(0).anchor_bottom(0);

	del_btn = row.button("").icon(nanogui.icon("times")).danger("hover").tooltip("Remove this row")
		.anchor_right(0).anchor_top(0).anchor_bottom(0).fixed_width(ROW);

	universe.callback([](v){
		if(v != last_universe)
			last_start_index = 1;
		last_universe = v;
	});

	channel.callback([type](v){
		if(type == "8bit")
			last_start_index = v + 1;
		else
			last_start_index = v + 2;
	});

	channel_list[ctrl_id] = [cnt = row, value=val, type=type, universe=universe, channel=channel];

	del_btn.on_click([row, ctrl_id]()
	{
		if(channel_list.has(ctrl_id))
			channel_list.erase(ctrl_id);
		//Not freed inside the click of its own button: hidden now, freed in the next update()
		row.visible(false);
		pending_free.push_back(row);
		update_empty();
	});

	if(type == "8bit") {
		last_start_index++;
		val.callback([universe, channel](v){
			if(!artnet_active)
				return;
			//No node: nothing to send to
			if(!find_device())
				return;

			u = start_universe.value() + universe.value();
			c = (start_channel.value() - 1) + (channel.value() - 1);

			device.set_artnet_channel(u, c, v*255.0);
		});
	}
	else if(type == "16bit") {
		last_start_index = last_start_index + 2;
		val.callback([universe, channel](v){
			if(!artnet_active)
				return;
			if(!find_device())
				return;

			value_16bit = v * 65535.0;
			current_coarse = std.int(value_16bit / 256.0);
			current_fine = std.int(math.mod(value_16bit,256.0));

			u = start_universe.value() + universe.value();
			c = (start_channel.value() - 1) + (channel.value() - 1);

			device.set_artnet_channel(u, c, current_coarse);
			device.set_artnet_channel(u, c+1, current_fine);
		});
	}

	update_empty();
};

entry(generator, area) {
	generator.window.fixed_size(vec2f(480, 400));
	area.layout(None);

	engine = std.global("engine");
	net = engine.net;
	t = area.theme().to_json();
	text_2 = theme_color(t, "text_secondary_color", vec4f(155 / 255.0, 155 / 255.0, 160 / 255.0, 1.0));
	text_3 = theme_color(t, "disabled_text_color", vec4f(94 / 255.0, 94 / 255.0, 99 / 255.0, 1.0));

	//The node: picked from the nodes that answered (Devices › Network › Artnet), shown with its IP and MAC
	selector = area.combobox().items([NO_NODE]).anchor_left(0).anchor_right(0).anchor_top(0).fixed_height(ROW);
	selector.tooltip("The [[art-net|Art-Net]] node the rows send to. The list shows the nodes that answered on the network\n[[wiki:Output-and-Devices#art-net]]");
	node_info = area.label("").text_color(text_2).anchor_left(4).anchor_right(0).anchor_top(ROW + GAP).fixed_height(ROW - 8);

	selector.on_open([](){
		devs = net.artnet_devices();
		items = [NO_NODE];
		nodes = [];
		sel = 0;
		for(i = 0; i < devs.size(); i++) {
			items.push_back(devs[i].name());
			nodes.push_back(devs[i]);
			if(device_mac && devs[i].mac() == device_mac)
				sel = i + 1;
		}
		//A picked node that has not answered stays in the list, so opening it does not forget the node
		if(device_mac && sel == 0) {
			items.push_back(device_mac + " (not found)");
			nodes.push_back(None);
			sel = items.size() - 1;
		}
		set_list(items, nodes, sel);
	});
	selector.on_change([](v, text){
		if(syncing)
			return;
		if(v == 0) {
			device = None;
			device_mac = "";
			show_info();
			return;
		}
		v--;
		if(v < 0 || v >= device_list.devs.size())
			return;
		//None: the saved node that has not answered, it stays picked
		if(device_list.devs[v]) {
			device = device_list.devs[v];
			device_mac = device.mac();
			send_all();
		}
		show_info();
	});
	show_device(None);

	top = ROW + GAP + ROW - 8 + GAP;
	add_row = area.widget().anchor_left(0).anchor_right(0).anchor_top(top).fixed_height(ROW);
	add_btn = row_half(add_row, false).button("Add channel").icon(nanogui.icon("plus")).anchor_left(0).anchor_right(GAP / 2).anchor_top(0).anchor_bottom(0)
		.tooltip("A row with a slider that sends one channel (0 to 255) to the node picked above\n[[wiki:Output-and-Devices#art-net]]");
	add_16b_btn = row_half(add_row, true).button("Add 16-bit channel").icon(nanogui.icon("plus")).anchor_left(GAP / 2).anchor_right(0).anchor_top(0).anchor_bottom(0)
		.tooltip("A row that sends two channels as one value (0 to 65535)\n[[wiki:Output-and-Devices#art-net]]");

	start_row = area.widget().anchor_left(0).anchor_right(0).anchor_top(top + ROW + GAP).fixed_height(ROW);
	start_universe = row_half(start_row, false).controlint("START UNIVERSE").caption("Start universe").tooltip("Added to the universe of every row").min(0).max(32767)
		.anchor_left(0).anchor_right(GAP / 2).anchor_top(0).anchor_bottom(0);
	start_channel = row_half(start_row, true).controlint("START CHANNEL").caption("Start channel").tooltip("Shifts the channel of every row: 1 keeps them where they are").min(1).max(512).value(1)
		.anchor_left(GAP / 2).anchor_right(0).anchor_top(0).anchor_bottom(0);

	vs = area.vscroll().anchor_left(0).anchor_right(0).anchor_top(top + 2 * (ROW + GAP) + GAP).anchor_bottom(0);
	channel_list_area = vs.content().layout(nanogui.layout_vertical()).controlvector("Channels").tooltip("The rows: each sends one channel, or two for 16-bit").expanded(true)
		.content().layout(nanogui.layout_vertical().spacing(GAP));

	empty_label = channel_list_area.label("Add a channel to send it").text_color(text_3);

	add_btn.on_click([](){
		add_new_ctrl("CTRL"+channel_max, "8bit");
		channel_max++;
	});

	add_16b_btn.on_click([](){
		add_new_ctrl("CTRL"+channel_max, "16bit");
		channel_max++;
	});
}

save_state() {
	state = [channel_max=channel_max, channels=[], mac=device_mac];
	for(i = 0; i < channel_list.size(); i++) {
		state.channels.push_back([
			ctrl_id=channel_list.key(i),
			value=channel_list[i].value.value(),
			type=channel_list[i].type,
			universe=channel_list[i].universe.value(),
			channel=channel_list[i].channel.value(),
		]);
	}
	return state;
}

load_state(state) {
	if(state.has("channel_max"))
		channel_max = state.channel_max;

	for(i = 0; i < state.channels.size(); i++) {

		chan = state.channels[i];
		add_new_ctrl(chan.ctrl_id, chan.type);

		new_chan = channel_list[chan.ctrl_id];
		new_chan.universe.value(chan.universe);
		new_chan.channel.value(chan.channel);
		new_chan.value.value(chan.value);
	}

	//Projects before #436 saved "<none>" without a node
	mac = state.has("mac") ? state.mac : "";
	if(!mac || mac == "<none>")
		mac = "";
	device_mac = mac;
	device = None;
	find_device();
	show_device(None);
}
