// XYPathPad generator
// An editable X / Y field (a bipolar area from -1 to +1 on both axes) on which freely
// draggable points form a path. A travelling point walks this path evenly in time:
// every stretch between two points takes the same time.
//
// The sampled path position (a bipolar -1..1 value on each axis) is combined
// with the Input X / Input Y controls and the result is written to the
// Output X / Output Y controls (pure outputs, written on every update).
//
// Path mode:   Closed = the path is looped (the last point connects back to the first)
//              Open   = the path has a distinct start and end point.
// Travel mode: Loop   = after the last point the walk restarts from the front.
//              Bounce = after the last point the walk reverses back to the start.
//
// Graph points use the standard [[x, y, weight], ...] format with x/y in 0..1.
// They are interpreted bipolar: value = 2 * coord - 1, so the middle of the pad
// is 0 and the edges are -1 / +1.
import nanogui;

// nvg* drawing helpers (used by the point-marker overlay) + vec2f/vec4f types.
using nanogui;
using eigen;

// Controls
path_graph = None;
travel = None;      // beats for one full traversal of the path
mode = None;        // 0 = Loop, 1 = Bounce
shape = None;       // 0 = Closed (looped), 1 = Open (start + end)
combine = None;     // 0 = Add, 1 = Subtract, 2 = Multiply
in_x = None;
in_y = None;
out_x = None;
out_y = None;

// Free-running clock
walk_time = 0.0;

// Clamp a value into [-1, 1].
clamp_bipolar(v) {
	if(v < -1.0)
		return -1.0;
	if(v > 1.0)
		return 1.0;
	return v;
}

// Combine a path value with an input value according to the combine mode.
combine_value(pv, iv, mode_idx) {
	if(mode_idx == 0)
		return clamp_bipolar(pv + iv);   // Add
	else if(mode_idx == 1)
		return clamp_bipolar(pv - iv);   // Subtract
	else
		return clamp_bipolar(pv * iv);   // Multiply
}

// Convert a graph coord (0..1) into a bipolar path value (-1..1).
to_bipolar(c) {
	return clamp_bipolar(2.0 * c - 1.0);
}

// Sample the path at an even per-segment position.
// `seg` selects the current segment index, `frac` the 0..1 progress within it.
// Returns the sampled [x, y] as bipolar values.
sample_path(points, seg, frac) {
	n = points.size();
	if(n == 0)
		return [0.0, 0.0];
	if(n == 1)
		return [to_bipolar(points[0][0]), to_bipolar(points[0][1])];

	i0 = seg;
	i1 = i0 + 1;
	if(i1 >= n)
		i1 = 0;

	x0 = points[i0][0];
	y0 = points[i0][1];
	x1 = points[i1][0];
	y1 = points[i1][1];

	// Straight line between the two points.
	x = x0 + (x1 - x0) * frac;
	y = y0 + (y1 - y0) * frac;

	return [to_bipolar(x), to_bipolar(y)];
}

// A colour of the UI theme as vec4f (alpha 1), or the fallback when the theme has no such key.
theme_color(t, key, fallback) {
	if(t && t.has(key)) {
		c = t[key];
		return vec4f(c.r, c.g, c.b, c.a);
	}
	return fallback;
}

entry(generator, area) {
	//Wide enough for the switches next to the fields (at the default width their texts were cut off)
	generator.window.fixed_size(vec2f(520, 360));
	area.layout(nanogui.layout_vertical());

	// State colours of the theme for the point markers: on (green) = start, accent = end
	t = area.theme().to_json();
	c_start = theme_color(t, "on_color", vec4f(63.0 / 255.0, 207.0 / 255.0, 142.0 / 255.0, 1.0));
	c_end = theme_color(t, "accent_color", vec4f(157.0 / 255.0, 133.0 / 255.0, 1.0, 1.0));

	// ---- Editable XY path field ----
	path_box = area.widget().fixed_height(220);
	path_graph = path_box.graph("Path").anchor(0);
	path_graph.allow_new_points(true);
	path_graph.editable(true);
	path_graph.vertex_mode(true);
	path_graph.grid(0.25);
	path_graph.points([[0.25, 0.25, 0.0], [0.75, 0.25, 0.0], [0.75, 0.75, 0.0], [0.25, 0.75, 0.0]]);
	path_graph.tooltip("Drag a point to move it, click an empty spot to add a point at the end of the path, right click a point to remove it. The middle is 0, the edges -1 and 1. The green ring marks the start, the ring in the accent colour the end of an open path");

	// The point role markers (on_draw) are registered at the END of entry(): the overlay
	// captures path_graph AND the `shape` combo BY VALUE, and `shape` is still None here.

	// ---- Path / travel controls (one 28 px row, widths in percent so the row fills the window) ----
	row = area.widget().fixed_height(28).anchor_left(0).anchor_right(0).fixed_width(360);
	travel = row.controlslider("Travel").unit("beats").tooltip("How many [[beat|beats]] one walk along the path takes. Every stretch between two points takes the same time").min(0.25).max(16).value(2.0)
		.anchor_top(0).anchor_bottom(0).anchor_left(0).anchor_right(0.6, "percent");
	mode = row.controlcombo("Mode").tooltip("Loop: from the last point back to the first. Bounce: back and forth")
		.anchor_top(0).anchor_bottom(0).anchor_left(0.4, "percent").anchor_right(0.3, "percent");
	mode.items(["Loop", "Bounce"]).segmented(true);
	shape = row.controlcombo("Path").tooltip("Closed: the last point connects to the first. Open: the path has a start and an end")
		.anchor_top(0).anchor_bottom(0).anchor_left(0.7, "percent").anchor_right(0);
	shape.items(["Closed", "Open"]).segmented(true);

	// ---- Input controls (linkable) ----
	in_row = area.widget().fixed_height(28).anchor_left(0).anchor_right(0).fixed_width(240);
	combine = in_row.controlcombo("Combine").tooltip("How the point on the path and Input X / Y make the output: added, subtracted or multiplied")
		.anchor_top(0).anchor_bottom(0).anchor_left(0).anchor_right(0.6, "percent");
	combine.items(["Add", "Subtract", "Multiply"]).segmented(true);
	in_x = in_row.controlslider("Input X").tooltip("Combined with X of the path, -1 to 1. [[link]] something into it").min(-1).max(1).value(0.0)
		.anchor_top(0).anchor_bottom(0).anchor_left(0.4, "percent").anchor_right(0.3, "percent");
	in_y = in_row.controlslider("Input Y").tooltip("Combined with Y of the path, -1 to 1. [[link]] something into it").min(-1).max(1).value(0.0)
		.anchor_top(0).anchor_bottom(0).anchor_left(0.7, "percent").anchor_right(0);

	// ---- Output controls (pure outputs: update() writes them every frame) ----
	out_row = area.widget().fixed_height(28).anchor_left(0).anchor_right(0).fixed_width(240);
	out_x = out_row.controlslider("Output X").as_output(true).tooltip("X of the point, combined with Input X, -1 to 1. A [[pure output]]: [[link]] it into what should move").min(-1).max(1).value(0.0)
		.anchor_top(0).anchor_bottom(0).anchor_left(0).anchor_right(0.5, "percent");
	out_y = out_row.controlslider("Output Y").as_output(true).tooltip("Y of the point, combined with Input Y, -1 to 1. A [[pure output]]: [[link]] it into what should move\n[[wiki:Assets#generators--utility]]").min(-1).max(1).value(0.0)
		.anchor_top(0).anchor_bottom(0).anchor_left(0.5, "percent").anchor_right(0);

	// ---- Point role markers (registered LAST) ----
	// Overlay drawn on top of the graph's own handles:
	//   first point -> ring in the theme's on colour (green): start of the path
	//   last point  -> ring in the theme's accent colour: end of the path, only in Open mode
	// In Closed mode the path is looped, so there is no distinct end point and no end marker.
	//
	// Registered at the END of entry() so `shape` already exists. Everything it uses
	// (path_graph, shape, the colours) is captured BY VALUE: on_draw runs on the render
	// thread where the module scope is not active, so no globals or module functions in it,
	// and the closure keeps its own references if the render thread draws once more after
	// the module globals are reset.
	path_graph.on_draw([path_graph, shape, c_start, c_end]() {
		pts = path_graph.points();
		n = pts.size();
		sz = path_graph.size();
		if(n > 0) {
			radius = 7.5;
			// First point: start
			p0 = pts[0];
			nvgBeginPath();
			nvgCircle(vec2f(p0[0] * sz.x, (1.0 - p0[1]) * sz.y), radius);
			nvgStrokeWidth(2.5);
			nvgStrokeColor(c_start);
			nvgStroke();

			// Last point: end, but only for an Open path (shape != Closed)
			if(shape.value() != 0) {
				if(n > 1) {
					p1 = pts[n - 1];
					nvgBeginPath();
					nvgCircle(vec2f(p1[0] * sz.x, (1.0 - p1[1]) * sz.y), radius);
					nvgStrokeWidth(2.5);
					nvgStrokeColor(c_end);
					nvgStroke();
				}
			}
		}
	});
}

update(generator, tl_pos, pos_delta) {
	pts = path_graph.points();
	n = pts.size();

	if(n < 2) {
		// With a single (or no) point there is no path to walk.
		p0 = (n == 1) ? to_bipolar(pts[0][0]) : 0.0;
		p1 = (n == 1) ? to_bipolar(pts[0][1]) : 0.0;
		out_x.value(combine_value(p0, in_x.value(), combine.value()));
		out_y.value(combine_value(p1, in_y.value(), combine.value()));
		return;
	}

	// Number of segments depends on the path shape.
	segments = (shape.value() == 0) ? n : (n - 1);
	if(segments < 1)
		segments = 1;

	// Advance the walk clock (even time across the whole traversal).
	travel_beats = travel.value();
	if(travel_beats < 0.001)
		travel_beats = 0.001;
	walk_time = walk_time + pos_delta / travel_beats;

	// Build a phase in [0,1) depending on Loop / Bounce.
	phase = 0.0;
	if(mode.value() == 0) {
		// Loop: restart from the front.
		phase = math.mod(walk_time, 1.0);
	}
	else {
		// Bounce: triangle wave -> forward then backward.
		cyc = math.mod(walk_time, 2.0);
		phase = (cyc < 1.0) ? cyc : (2.0 - cyc);
	}

	// Even distribution of time across segments.
	total = phase * std.float(segments);
	seg = std.int(math.floor(total));
	if(seg >= segments)
		seg = segments - 1;
	frac = total - std.float(seg);

	res = sample_path(pts, seg, frac);

	out_x.value(combine_value(res[0], in_x.value(), combine.value()));
	out_y.value(combine_value(res[1], in_y.value(), combine.value()));
}

save_state() {
	state = [
		travel=travel.value(),
		mode=mode.value(),
		shape=shape.value(),
		combine=combine.value(),
		in_x=in_x.value(),
		in_y=in_y.value(),
		path=path_graph.points(),
	];
	return state;
}

load_state(state) {
	if(state.has("travel"))
		travel.value(state.travel);
	if(state.has("mode"))
		mode.value(state.mode);
	if(state.has("shape"))
		shape.value(state.shape);
	if(state.has("combine"))
		combine.value(state.combine);
	if(state.has("in_x"))
		in_x.value(state.in_x);
	if(state.has("in_y"))
		in_y.value(state.in_y);
	if(state.has("path"))
		path_graph.points(state.path);
}
