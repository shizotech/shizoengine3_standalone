// XY Pad generator
// A field to click or drag on. The point sets the two controls X and Y, each from 0 to 1:
//   X: 0 = left edge, 1 = right edge
//   Y: 0 = top edge, 1 = bottom edge (screen direction)
// The mapping is x = pos.x / width, y = pos.y / height of the field, as in the first version
// of this pad, so saved projects and links keep their orientation.
// X and Y are normal controls (not pure outputs): a link or MIDI into them moves the dot too,
// because the dot is drawn from their values every frame.
import nanogui;

// nvg* drawing functions + vec2f / vec4f
using nanogui;
using eigen;

pad = None;
x = None;
y = None;

clamp01(v) {
	if(v < 0.0)
		return 0.0;
	if(v > 1.0)
		return 1.0;
	return v;
}

// A colour of the UI theme as vec4f, or the fallback when the theme has no such key.
theme_color(t, key, fallback) {
	if(t && t.has(key)) {
		c = t[key];
		return vec4f(c.r, c.g, c.b, c.a);
	}
	return fallback;
}

// Set X / Y from a point in the field's own coordinates, clamped to the field.
set_from_point(px, py) {
	w = std.float(pad.width());
	h = std.float(pad.height());
	if(w <= 0.0 || h <= 0.0)
		return;
	x.value(clamp01(px / w));
	y.value(clamp01(py / h));
}

entry(generator, area) {
	area.layout(None);

	// Theme colours, read once here and captured by value in on_draw (it runs on the render thread)
	t = area.theme().to_json();
	c_field = theme_color(t, "input_fill", vec4f(22.0 / 255.0, 23.0 / 255.0, 26.0 / 255.0, 1.0));
	c_grid = theme_color(t, "border_light", vec4f(1.0, 1.0, 1.0, 0.07));
	accent = theme_color(t, "accent_color", vec4f(157.0 / 255.0, 133.0 / 255.0, 1.0, 1.0));
	c_dot = vec4f(accent.x, accent.y, accent.z, 1.0);
	c_cross = vec4f(c_dot.x, c_dot.y, c_dot.z, 0.35);

	// The field fills the window above the row of the two value fields (28 px row, 4 px gap)
	pad = area.widget().anchor(0).anchor_bottom(32).cursor(2); // 2 = crosshair
	pad.tooltip("Click or drag: X from left (0) to right (1), Y from top (0) to bottom (1)");

	x = area.controlslider("x").caption("X").tooltip("Where the point is from left (0) to right (1). [[link]] it into what should move, or [[link]] something into it to move the point").anchor_bottom(0).fixed_height(28).anchor_left(0).anchor_right(0.5, "percent");
	y = area.controlslider("y").caption("Y").tooltip("Where the point is from top (0) to bottom (1). [[link]] it into what should move, or [[link]] something into it to move the point\n[[wiki:Assets#generators--utility]]").anchor_bottom(0).fixed_height(28).anchor_right(0).anchor_left(0.5, "percent");

	// A click sets the point at once; returning true makes the field the drag target
	pad.on_mouse_button([](pos, btn, down, mod) {
		if(btn != 0)
			return false;
		if(down)
			set_from_point(pos.x, pos.y);
		return true;
	});

	// Drag positions come in the coordinates of the parent: subtract the field's position.
	// btn is the mouse state here (1 = left button held).
	pad.on_mouse_drag([](pos, rel, btn, mod) {
		if((btn & 1) == 0)
			return false;
		p = pad.position();
		set_from_point(pos.x - p.x, pos.y - p.y);
		return true;
	});

	pad.on_draw([pad, x, y, c_field, c_grid, c_dot, c_cross]() {
		sz = pad.size();
		w = sz.x;
		h = sz.y;

		// Field
		nvgBeginPath();
		nvgRoundedRect(vec2f(0, 0), vec2f(w, h), 2.0);
		nvgFillColor(c_field);
		nvgFill();

		// Grid in quarters
		nvgBeginPath();
		for(i = 1; i < 4; i++) {
			gx = math.floor(w * i / 4.0) + 0.5;
			gy = math.floor(h * i / 4.0) + 0.5;
			nvgMoveTo(vec2f(gx, 0));
			nvgLineTo(vec2f(gx, h));
			nvgMoveTo(vec2f(0, gy));
			nvgLineTo(vec2f(w, gy));
		}
		nvgStrokeWidth(1.0);
		nvgStrokeColor(c_grid);
		nvgStroke();

		// The point, from the values of X and Y (also when a link moves them)
		vx = x.value();
		vy = y.value();
		if(vx < 0.0)
			vx = 0.0;
		if(vx > 1.0)
			vx = 1.0;
		if(vy < 0.0)
			vy = 0.0;
		if(vy > 1.0)
			vy = 1.0;
		px = vx * w;
		py = vy * h;

		nvgBeginPath();
		nvgMoveTo(vec2f(px, 0));
		nvgLineTo(vec2f(px, h));
		nvgMoveTo(vec2f(0, py));
		nvgLineTo(vec2f(w, py));
		nvgStrokeWidth(1.0);
		nvgStrokeColor(c_cross);
		nvgStroke();

		nvgBeginPath();
		nvgCircle(vec2f(px, py), 6.0);
		nvgFillColor(c_dot);
		nvgFill();
		nvgStrokeWidth(2.0);
		nvgStrokeColor(c_field);
		nvgStroke();
	});
}
