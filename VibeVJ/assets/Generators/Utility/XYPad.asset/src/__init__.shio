
is_dragging = false;

entry(generator, area) {
	area.layout(None);
	pad = area.widget().anchor(0).anchor_bottom(30);
	x = area.controlslider("x").anchor_bottom(0).fixed_height(30).anchor_left(0).anchor_right(0.5,"percent");
	y = area.controlslider("y").anchor_bottom(0).fixed_height(30).anchor_right(0).anchor_left(0.5,"percent");
	
	pad.on_mouse_button([](pos, btn, down, mod) {
		if(btn == 0)
			is_dragging = down;
	});
	
	pad.on_mouse_motion([pad, x,y](pos, rel, btn, mod) {
		if(is_dragging) {
			x.value(pos.x / std.float(pad.width()));
			y.value(pos.y / std.float(pad.height()));
		}
	});
}
