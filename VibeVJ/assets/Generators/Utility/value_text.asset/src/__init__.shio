// Value Text generator
// Shows the value of whatever is linked into Input as text: numbers with up to three decimals
// (0.5, not 0.500000), text as it is.

// A number as short text: up to three decimals, trailing zeros dropped (0.5, 2, -0.125, 1234.568).
format_number(v) {
	neg = v < 0.0;
	scaled = math.round(math.abs(v) * 1000.0);
	whole = math.floor(scaled / 1000.0);
	frac = std.int(scaled - whole * 1000.0);
	s = std.string(std.int(whole));
	if(frac > 0) {
		d1 = std.int(frac / 100);
		d2 = std.int(frac / 10) % 10;
		d3 = frac % 10;
		if(d3 != 0)
			s = s + "." + d1 + d2 + d3;
		else if(d2 != 0)
			s = s + "." + d1 + d2;
		else
			s = s + "." + d1;
	}
	if(neg && (whole > 0 || frac > 0))
		s = "-" + s;
	return s;
}

// Any value as text: numbers formatted, text as it is, nothing as "—".
value_to_text(v) {
	t = std.type(v);
	if(t == "float")
		return format_number(v);
	if(t == "int")
		return std.string(v);
	if(t == "string")
		return v;
	if(t == "none")
		return "—";
	return std.string(v);
}

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	ctrl = area.control("Input").tooltip("[[link]] any control into it: its value shows as text below\n[[wiki:Assets#generators--utility]]");
	txt = area.textbox().editable(false).placeholder("Link a control into Input to see its value");

	ctrl.callback([txt](v) {
		txt.value(value_to_text(v));
	});
}
