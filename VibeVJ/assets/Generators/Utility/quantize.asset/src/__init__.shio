// Quantize generator
// Rounds Input down to one of Steps levels from 0 up: with Steps = 4 the Output is 0, 0.25, 0.5 or 0.75.
// An Input of exactly 1 gives the top level too (0.75 with 4 steps), not a lone extra level of 1.

// The level of v for n steps: floor(v * n) / n, with the step index kept within 0 .. n - 1.
quantize_value(v, n) {
	if(n < 1)
		n = 1;
	i = math.floor(v * n);
	if(i > n - 1)
		i = n - 1;
	if(i < 0)
		i = 0;
	return i / std.float(n);
}

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	in = area.controlslider("Input").tooltip("The value to round. [[link]] something into it");
	// Before, Steps started at 0, which divided by zero: it now starts at 4 and cannot go below 1
	steps = area.controlint("steps").caption("Steps").min(1).value(4).tooltip("Into how many steps the range from 0 to 1 is cut. 4: 0, 0.25, 0.5, 0.75");
	out = area.controlslider("Out").caption("Output").as_output(true).tooltip("The input, rounded down to the steps. A [[pure output]]: [[link]] it into what should move in steps\n[[wiki:Assets#generators--utility]]");

	in.callback([steps, out](v) {
		out.value(quantize_value(v, steps.value()));
	});
	// A new number of steps applies at once, not only on the next change of Input
	steps.callback([in, out](n) {
		out.value(quantize_value(in.value(), n));
	});
}
