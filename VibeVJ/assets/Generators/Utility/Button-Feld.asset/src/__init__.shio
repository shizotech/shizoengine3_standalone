import nanogui;

managed grid = None;

buttons = [];
ui = [];

// Map a mode string to its combobox index (items = ["Flash","Relative","Absolute"]).
mode_to_index(m) {
	if(m == "Flash")
		return 0;
	if(m == "Relative")
		return 1;
	if(m == "Absolute")
		return 2;
	return 0;
}



// Central output computation. Drives the per-button output slider based on
// the selected mode and the switch (controlbutton) state.
//   FLASH:    switch on -> output = val, switch off -> output = 0
//   ABSOLUTE: switch on -> output = val, switch off -> output = input
//   RELATIVE: switch on -> output = val * input, switch off -> output = input
update_output(idx) {
	cfg = buttons[idx];
	u = ui[idx];
	if(u == None)
		return;
	mode = u.mode_box.selected_text();
	// Use the source-of-truth cfg.switch (bool) instead of the widget mirror
	// (u.switch_btn.value()) which lags by one event and caused the switch
	// toggle to not be reflected in absolute/relative mode.
	sw = cfg.switch;
	input_val = u.input.value();
	val_val = cfg.value;
	out = 0.0;
	if(mode == "Flash") {
		if(sw != 0)
			out = val_val;
		else
			out = 0.0;
	}
	else if(mode == "Absolute") {
		if(sw != 0)
			out = val_val;
		else
			out = input_val;
	}
	else if(mode == "Relative") {
		if(sw != 0)
			out = val_val * input_val;
		else
			out = input_val;
	}
	cfg.output = out;
	// Keep the SWITCH Bx controlbutton widget visually in sync with cfg.switch.
	u.switch_btn.value(cfg.switch, false, false);
	// Set the output slider without re-triggering its own value callback.
	u.output.value(out, false, false);
}

build_button(parent, idx) {
	cfg = [id="B"+idx, name="B"+idx, mode="Flash", value=0.0, switch=false, input=0.0, output=0.0];
	buttons.push_back(cfg);

	// Compact cell: only main button + settings popup button
	cell = parent.widget().layout(nanogui.layout_vertical()).fixed_width(160).fixed_height(70);

	// Main action button (caption shows the button name; clicking it computes output)
	btn = cell.button(cfg.name).anchor_left(0).anchor_right(0);

	// Small settings button (button_popup) positioned below the main button
	popup = cell.button_popup("⚙ B"+idx).side("bottom");

	// Popup menu content (vertical layout) holds all setting widgets
	content = popup.popup().content().layout(nanogui.layout_vertical());

	name_box = content.textbox().editable(true).value(cfg.name).anchor_left(0).anchor_right(0);
	mode_box = content.combobox().items(["Flash","Relative","Absolute"]).anchor_left(0).anchor_right(0);
	mode_box.selected(mode_to_index(cfg.mode));
	val = content.controlslider("VAL B"+idx, "B"+idx).min(0).max(1.0).value(cfg.value).anchor_left(0).anchor_right(0);
	switch_btn = content.controlbutton("SWITCH B"+idx, "B"+idx).push(1).fixed_width(120).anchor_left(0).anchor_right(0);
	input = content.controlslider("INPUT B"+idx, "B"+idx).min(0).max(1.0).value(cfg.input).anchor_left(0).anchor_right(0);
	output = content.controlslider("OUTPUT B"+idx, "B"+idx).min(0).max(1.0).value(cfg.output).anchor_left(0).anchor_right(0);

	ui.push_back([name_box=name_box, mode_box=mode_box, val=val, btn=btn,
	               switch_btn=switch_btn, input=input, output=output]);

	// (a) Switch change -> update output
	switch_btn.callback([idx, cfg](v){
		cfg.switch = v != 0;
		update_output(idx);
	});

	// (b) val change -> update output
	val.callback([cfg, idx](v){
		cfg.value = v;
		update_output(idx);
	});

	// (c) Input change -> update output
	input.callback([cfg, idx](v){
		cfg.input = v;
		update_output(idx);
	});

	// (d) Mode change -> update output
	mode_box.on_change([cfg, idx](i, text){
		cfg.mode = text;
		update_output(idx);
	});

	// Main action button:
	//   FLASH:    momentary switch -> ON while held, OFF on release (cfg.switch = down)
	//   RELATIVE/ABSOLUTE: keep click-to-toggle, triggered only on release so a
	//            normal click toggles exactly once.
	btn.on_mouse_button([idx, cfg](pos, mbtn, down, mods) {
		if(cfg.mode == "Flash") {
			cfg.switch = down;
		}
		else if(down == false) {
			cfg.switch = !cfg.switch;
		}
		update_output(idx);
	});

	// Keep the main button caption synced with the editable name field
	name_box.on_change([cfg, btn](v){
		if(v)
			cfg.name = v;
		if(v && btn)
			btn.caption(v);
	});

	// Initial output state
	update_output(idx);
}

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	grid = area.widget().layout(nanogui.layout_vertical());
	for(i = 0; i < 3; i++) {
		row = grid.widget().layout(nanogui.layout_horizontal());
		for(j = 0; j < 3; j++) {
			build_button(row, j + i*3);
		}
	}
}

save_state() {
	state = [
		buttons = buttons
	];
	return state;
}

load_state(state) {
	if(state.has("buttons")) {
		for(i = 0; i < state.buttons.size(); i++) {
			if(i >= buttons.size())
				break;
			b = state.buttons[i];
			cfg = buttons[i];
			cfg.name = b.name;
			cfg.mode = b.mode;
			cfg.value = b.value;
			cfg.switch = b.switch;
			cfg.input = b.input;
			cfg.output = b.output;

			if(i < ui.size()) {
				cfg_ui = ui[i];
				cfg_ui.name_box.value(b.name);
				cfg_ui.btn.caption(b.name);
				cfg_ui.mode_box.selected(mode_to_index(b.mode));
				cfg_ui.val.value(b.value, false, false);
				cfg_ui.switch_btn.value(b.switch, false, false);
				cfg_ui.input.value(b.input, false, false);
				cfg_ui.output.value(b.output, false, false);
				update_output(i);
			}
		}
	}
}
