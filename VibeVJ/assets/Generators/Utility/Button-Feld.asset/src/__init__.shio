// Button field generator (the asset folder keeps its first name "Button-Feld": projects reference the path)
// A fixed grid of 3 x 3 buttons. Each button has a settings popup with its name, a mode and three values,
// and an Output to link into what it should switch:
//   Flash:    pressed -> Value, released -> 0 (on only while held)
//   Absolute: on -> Value, off -> Input (a click switches on / off)
//   Relative: on -> Value x Input, off -> Input (a click switches on / off)
// The controls keep their first IDs ("VAL B0", "SWITCH B0", "INPUT B0", "OUTPUT B0" in group "B0"):
// saved projects, links and MIDI mappings address them. Only their captions changed.
import nanogui;

managed grid = None;

buttons = [];
ui = [];

// Map a mode string to its combobox index (items = ["Flash","Relative","Absolute"]).
mode_to_index(m) {
	if(m == "Flash")
		return 0;
	if(m == "Relative")
		return 1;
	if(m == "Absolute")
		return 2;
	return 0;
}



// Central output computation. Drives the per-button output slider based on
// the selected mode and the switch (controlbutton) state.
//   Flash:    switch on -> output = value, switch off -> output = 0
//   Absolute: switch on -> output = value, switch off -> output = input
//   Relative: switch on -> output = value * input, switch off -> output = input
update_output(idx) {
	cfg = buttons[idx];
	u = ui[idx];
	if(u == None)
		return;
	mode = u.mode_box.selected_text();
	// Use the source-of-truth cfg.switch (bool) instead of the widget mirror
	// (u.switch_btn.value()) which lags by one event and caused the switch
	// toggle to not be reflected in absolute/relative mode.
	sw = cfg.switch;
	input_val = u.input.value();
	val_val = cfg.value;
	out = 0.0;
	if(mode == "Flash") {
		if(sw != 0)
			out = val_val;
		else
			out = 0.0;
	}
	else if(mode == "Absolute") {
		if(sw != 0)
			out = val_val;
		else
			out = input_val;
	}
	else if(mode == "Relative") {
		if(sw != 0)
			out = val_val * input_val;
		else
			out = input_val;
	}
	cfg.output = out;
	// Keep the switch controlbutton (ID "SWITCH Bx") visually in sync with cfg.switch.
	u.switch_btn.value(cfg.switch, false, false);
	// Set the output slider without re-triggering its own value callback.
	u.output.value(out, false, false);
}

build_button(parent, idx) {
	cfg = [id="B"+idx, name="B"+idx, mode="Flash", value=0.0, switch=false, input=0.0, output=0.0];
	buttons.push_back(cfg);

	// Compact cell: main button + settings popup button. The cells of a row share its width
	// (a third each, percent anchors), so the grid stretches with the window.
	col = idx % 3;
	cell = parent.widget().layout(nanogui.layout_vertical().spacing(4))
		.anchor_top(0).anchor_bottom(0).anchor_left(col / 3.0, "percent").anchor_right((2 - col) / 3.0, "percent");

	// Main action button (caption shows the button name; clicking it computes output)
	btn = cell.button(cfg.name).fixed_height(28).anchor_left(0).anchor_right(0)
		.tooltip("Flash: on while you hold it. Absolute, Relative: a click switches it on or off");

	// Settings button (button_popup) below the main button
	popup = cell.button_popup("Settings").icon(nanogui.icon("cog")).side("bottom").fixed_height(28)
		.tooltip("Settings of this button: name, mode, value, input and output");

	// Popup menu content (vertical layout) holds all setting widgets
	content = popup.popup().content().layout(nanogui.layout_vertical());

	name_box = content.textbox().editable(true).value(cfg.name).placeholder("Name of the button").tooltip("The name on the button").anchor_left(0).anchor_right(0);
	// Item order is saved as the mode text and mapped by mode_to_index(): keep it
	mode_box = content.combobox().items(["Flash","Relative","Absolute"]).tooltip("Flash: the value while on, else 0. Absolute: the value while on, else the input. Relative: value times input while on, else the input").anchor_left(0).anchor_right(0);
	mode_box.selected(mode_to_index(cfg.mode));
	val = content.controlslider("VAL B"+idx, "B"+idx).caption("Value").tooltip("The value this button gives while it is on").min(0).max(1.0).value(cfg.value).anchor_left(0).anchor_right(0);
	switch_btn = content.controlbutton("SWITCH B"+idx, "B"+idx).caption("Switch").tooltip("The button: on or off. [[link]] something into it or map it to a pad").push(1).anchor_left(0).anchor_right(0);
	input = content.controlslider("INPUT B"+idx, "B"+idx).caption("Input").tooltip("What goes out while the button is off (Absolute, Relative)").min(0).max(1.0).value(cfg.input).anchor_left(0).anchor_right(0);
	// A pure output: the script writes it on every change, a link into it would be overwritten
	output = content.controlslider("OUTPUT B"+idx, "B"+idx).caption("Output").as_output(true).tooltip("What this button gives. A [[pure output]]: [[link]] it into what it should switch\n[[wiki:Assets#generators--utility]]").min(0).max(1.0).value(cfg.output).anchor_left(0).anchor_right(0);

	ui.push_back([name_box=name_box, mode_box=mode_box, val=val, btn=btn,
	               switch_btn=switch_btn, input=input, output=output]);

	// (a) Switch change -> update output
	switch_btn.callback([idx, cfg](v){
		cfg.switch = v != 0;
		update_output(idx);
	});

	// (b) Value change -> update output
	val.callback([cfg, idx](v){
		cfg.value = v;
		update_output(idx);
	});

	// (c) Input change -> update output
	input.callback([cfg, idx](v){
		cfg.input = v;
		update_output(idx);
	});

	// (d) Mode change -> update output
	mode_box.on_change([cfg, idx](i, text){
		cfg.mode = text;
		update_output(idx);
	});

	// Main action button (left mouse button only):
	//   Flash:    momentary switch -> on while held, off on release (cfg.switch = down)
	//   Relative / Absolute: click-to-toggle, triggered only on release so a
	//            normal click toggles exactly once.
	// Returning true keeps the button as the drag target, so the release reaches it also when
	// the mouse left the button while held (before, a Flash button then stayed on).
	btn.on_mouse_button([idx, cfg](pos, mbtn, down, mods) {
		if(mbtn != 0)
			return false;
		if(cfg.mode == "Flash") {
			cfg.switch = down;
		}
		else if(down == false) {
			cfg.switch = !cfg.switch;
		}
		update_output(idx);
		return true;
	});

	// Keep the main button caption synced with the editable name field
	name_box.on_change([cfg, btn](v){
		if(v)
			cfg.name = v;
		if(v && btn)
			btn.caption(v);
	});

	// Initial output state
	update_output(idx);
}

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	grid = area.widget().layout(nanogui.layout_vertical().spacing(8));
	for(i = 0; i < 3; i++) {
		// One row of three cells: main button (28) + gap (4) + settings button (28)
		row = grid.widget().fixed_height(60).anchor_left(0).anchor_right(0).fixed_width(360);
		for(j = 0; j < 3; j++) {
			build_button(row, j + i*3);
		}
	}
}

save_state() {
	state = [
		buttons = buttons
	];
	return state;
}

load_state(state) {
	if(state.has("buttons")) {
		for(i = 0; i < state.buttons.size(); i++) {
			if(i >= buttons.size())
				break;
			b = state.buttons[i];
			cfg = buttons[i];
			cfg.name = b.name;
			cfg.mode = b.mode;
			cfg.value = b.value;
			cfg.switch = b.switch;
			cfg.input = b.input;
			cfg.output = b.output;

			if(i < ui.size()) {
				cfg_ui = ui[i];
				cfg_ui.name_box.value(b.name);
				cfg_ui.btn.caption(b.name);
				cfg_ui.mode_box.selected(mode_to_index(b.mode));
				cfg_ui.val.value(b.value, false, false);
				cfg_ui.switch_btn.value(b.switch, false, false);
				cfg_ui.input.value(b.input, false, false);
				cfg_ui.output.value(b.output, false, false);
				update_output(i);
			}
		}
	}
}
