 // EnvelopeOutput generator
 // Exposes an "Option" slider that has an editable envelope (graph), that can
 // be run FREE (free-running clock) or SYNC (locked to the beat/timeline, like
 // LFOSynth), and outputs the sampled envelope value into a bottom "Output"
 // slider (Regler) that the engine can consume.
 //
 // Envelope points use the standard graph/envelope format:
 //   [[x, y, weight], ...]  with x in 0..1, y in 0..1.
 // The generator samples the (piecewise) curve itself so beat-sync is
 // deterministic and independent of the clip playback system.
 import nanogui;

 // Controls (created in entry)
 base = None;      // Option slider (base level / where the envelope lives)
 env_graph = None; // Editable envelope graph
 rate = None;      // Beats per full envelope loop (higher = slower)
 phase = None;     // Phase offset 0..1
 mode = None;      // 0 = FREE, 1 = SYNC
 out = None;       // Output slider (Regler)

 // Free-running clock state
 free_time = 0.0;

 // Sample a piecewise-linear envelope (points [[x,y,w],...], x/y in 0..1) at
 // phase ph (0..1). Weight is ignored (linear interpolation).
 sample_env(points, ph) {
 	n = points.size();
 	if(n == 0)
 		return 0.0;
 	if(n == 1)
 		return points[0][1];

 	// Clamp ph into the point range.
 	if(ph < points[0][0])
 		return points[0][1];
 	if(ph > points[n-1][0])
 		return points[n-1][1];

 	for(i = 0; i < n-1; i++) {
 		x0 = points[i][0];
 		x1 = points[i+1][0];
 		if(ph >= x0 && ph <= x1) {
 			span = x1 - x0;
 			if(span <= 0.0)
 				return points[i+1][1];
 			f = (ph - x0) / span;
 			return points[i][1] + (points[i+1][1] - points[i][1]) * f;
 		}
 	}
 	return points[n-1][1];
 }

 entry(generator, area) {
 	area.layout(nanogui.layout_vertical());

 	// ---- Option slider + editable envelope graph ----
	base = area.controlslider("Option").min(0).max(1).value(0.5).fixed_height(24);
	env_box = area.widget().fixed_height(140);
	env_graph = env_box.graph("Envelope").anchor(0);
	env_graph.envelope_mode(true);
	env_graph.editable(true);
	env_graph.points([[0.0, 0.0, 0.0], [0.5, 1.0, 0.0], [1.0, 0.0, 0.0]]);

 	// ---- Sync / timing controls ----
 	row = area.widget().fixed_height(24).anchor_left(0).anchor_right(0).layout(nanogui.layout_horizontal());
 	mode = row.controlcombo("Mode").fixed_width(90);
 	mode.items(["FREE", "SYNC"]);
 	rate = row.controlslider("Beats").min(0.5).max(8).value(1.0).fixed_width(110);
 	phase = row.controlslider("Phase").min(0).max(1).value(0.0).fixed_width(110);

 	// ---- Output slider (Regler) ----
 	out = area.controlslider("Output").min(0).max(1).value(0.0).fixed_height(30);
 }

 update(generator, tl_pos, pos_delta) {
	// Compute the current envelope phase (0..1) for the beat clock.
	ph = 0.0;
	if(mode.value() == 0) {
 		// FREE: free-running, pos_delta is in beats.
 		free_time = free_time + pos_delta / rate.value();
 		ph = math.mod(free_time + phase.value(), 1.0);
 	}
 	else {
 		// SYNC: locked to the timeline (tl_pos is in beats), loops every 'rate' beats.
 		ph = math.mod(tl_pos / rate.value() + phase.value(), 1.0);
 	}

 	// Sample the envelope and drive the output slider.
 	v = sample_env(env_graph.points(), ph);
 	if(v < 0.0)
 		v = 0.0;
 	if(v > 1.0)
 		v = 1.0;
 	out.value(v);
 }

 save_state() {
 	state = [mode=mode.value(), rate=rate.value(), phase=phase.value(), option=base.value(), env=env_graph.points()];
 	return state;
 }

 load_state(state) {
 	if(state.has("mode"))
 		mode.value(state.mode);
 	if(state.has("rate"))
 		rate.value(state.rate);
 	if(state.has("phase"))
 		phase.value(state.phase);
 	if(state.has("option"))
 		base.value(state.option);
 	if(state.has("env"))
 		env_graph.points(state.env);
 }
