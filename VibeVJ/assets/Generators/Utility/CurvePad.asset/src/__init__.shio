 // CurvePad generator
 // An X/Y pad (built on the same editable point graph used to edit envelope
 // points) where you create points. A path (LINE when curvature = 0, smooth
 // CURVE when curvature > 0) is drawn between the points as a closed loop, and
 // a travelling point is driven along it. The travelling point is FREE / SYNC
 // (beat) clockable, and its current position lands in the X / Y output sliders
 // (Regler) at the bottom.
 //
 // Path points use the standard graph point format: [[x, y, weight], ...]
 // with x/y in 0..1.
 import nanogui;

 // Controls
 path_graph = None; // Editable point graph (the path)
 curvature = None;  // 0 = LINE, higher = CURVE
 speed = None;      // Beats per full loop
 phase = None;      // Phase offset 0..1
 mode = None;       // 0 = FREE, 1 = SYNC
 out_x = None;      // Output slider X (Regler)
 out_y = None;      // Output slider Y (Regler)

 // Free-running clock state
 free_time = 0.0;

 // Sample the (closed) path at position p (in "point units" 0..n).
 // Returns the sampled [x, y].
 sample_path(points, p, curv) {
 	n = points.size();
 	if(n == 0)
 		return [0.5, 0.5];
 	if(n == 1)
 		return points[0];

 	// Wrap the position into the 0..n range (closed loop).
 	p = math.mod(p, std.float(n));

 	idx = math.floor(p);
 	if(idx >= std.float(n))
 		idx = std.float(n) - 1.0;
 	frac = p - idx;

 	i0 = std.int(idx);
	i1 = std.int(math.mod(i0 + 1, std.float(n)));
	im1 = std.int(math.mod(i0 - 1 + n, std.float(n)));
	ip1 = std.int(math.mod(i1 + 1, std.float(n)));

 	x0 = points[i0][0];
 	y0 = points[i0][1];
 	x1 = points[i1][0];
 	y1 = points[i1][1];
 	xm1 = points[im1][0];
 	ym1 = points[im1][1];
 	xp1 = points[ip1][0];
 	yp1 = points[ip1][1];

 	x = 0.0;
 	y = 0.0;
 	if(curv <= 0.001) {
 		// Straight line (LINE)
 		x = x0 + (x1 - x0) * frac;
 		y = y0 + (y1 - y0) * frac;
 	}
 	else {
 		// Smooth (CURVE) Catmull-Rom, curvature scales the tangents.
 		t1x = (x1 - xm1) * 0.5 * curv;
 		t1y = (y1 - ym1) * 0.5 * curv;
 		t0x = (xp1 - x0) * 0.5 * curv;
 		t0y = (yp1 - y0) * 0.5 * curv;

 		a = x0 + t0x;
 		b = x1 - t1x;
 		c = x0;
 		d = x1;
 		x = (1.0 - frac) * ((1.0 - frac) * c + frac * a) + frac * ((1.0 - frac) * b + frac * d);

 		a = y0 + t0y;
 		b = y1 - t1y;
 		c = y0;
 		d = y1;
 		y = (1.0 - frac) * ((1.0 - frac) * c + frac * a) + frac * ((1.0 - frac) * b + frac * d);
 	}

 	if(x < 0.0)
 		x = 0.0;
 	if(x > 1.0)
 		x = 1.0;
 	if(y < 0.0)
 		y = 0.0;
 	if(y > 1.0)
 		y = 1.0;

 	return [x, y];
 }

 entry(generator, area) {
 	area.layout(nanogui.layout_vertical());

 	// ---- Path point editor (same editing style as envelope graphs) ----
	path_box = area.widget().fixed_height(200);
	path_graph = path_box.graph("Path").anchor(0);
	path_graph.allow_new_points(true);
	path_graph.editable(true);
	path_graph.vertex_mode(true);
	path_graph.values_mode(true);
	path_graph.loop(true);
	path_graph.points([[0.5, 0.2, 0.0], [0.8, 0.5, 0.0], [0.5, 0.8, 0.0], [0.2, 0.5, 0.0]]);

 	// ---- Path controls ----
 	row = area.widget().fixed_height(24).anchor_left(0).anchor_right(0).layout(nanogui.layout_horizontal());
 	curvature = row.controlslider("Curve").min(0).max(1).value(0.0).fixed_width(120);
 	speed = row.controlslider("Beats").min(0.5).max(8).value(1.0).fixed_width(110);
 	phase = row.controlslider("Phase").min(0).max(1).value(0.0).fixed_width(110);
 	mode = row.controlcombo("Mode").fixed_width(90);
 	mode.items(["FREE", "SYNC"]);

 	// ---- Output sliders (Regler) ----
 	out_row = area.widget().fixed_height(30).anchor_left(0).anchor_right(0).layout(nanogui.layout_horizontal());
 	out_x = out_row.controlslider("X").min(0).max(1).value(0.0).fixed_width(150);
 	out_y = out_row.controlslider("Y").min(0).max(1).value(0.0).fixed_width(150);
 }

 update(generator, tl_pos, pos_delta) {
 	pts = path_graph.points();
 	// Compute the path position p (in point units) for the beat clock.
 	p = 0.0;
 	if(mode.value() == 0) {
 		// FREE: free-running, pos_delta is in beats.
 		free_time = free_time + pos_delta / speed.value();
 		p = math.mod(free_time, 1.0) * pts.size();
 	}
 	else {
 		// SYNC: locked to the timeline (tl_pos is in beats).
 		p = math.mod(tl_pos / speed.value(), 1.0) * pts.size();
 	}

 	// Sample the path at p and drive the output sliders.
 	res = sample_path(pts, p, curvature.value());
 	out_x.value(res[0]);
 	out_y.value(res[1]);
 }

 save_state() {
 	state = [mode=mode.value(), speed=speed.value(), phase=phase.value(), curve=curvature.value(), path=path_graph.points()];
 	return state;
 }

 load_state(state) {
 	if(state.has("mode"))
 		mode.value(state.mode);
 	if(state.has("speed"))
 		speed.value(state.speed);
 	if(state.has("phase"))
 		phase.value(state.phase);
 	if(state.has("curve"))
 		curvature.value(state.curve);
 	if(state.has("path"))
 		path_graph.points(state.path);
 }
