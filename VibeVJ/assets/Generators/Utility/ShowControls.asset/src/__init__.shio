//Show controls (#428): a surface of faders, knobs, buttons and toggles for a show, placed by hand.
//Every control is a normal control of the program: it is linked, MIDI mapped, renamed (its options, Main) and saved
//like any other. Several surfaces make a show UI: put them into areas, tabs or a Patchview like any generator.
//Edit: add, move (drag), resize (drag the corner), remove (×). The places snap to a grid of GRID px.

import nanogui;

using eigen;
using nanogui;

GRID = 10;

managed toolbar = None;
managed canvas = None;
edit_btn = None;
add_buttons = [];

items = []; //[kind=, id=, ctrl=, overlay=]
editing = false;
c_accent = None; //the accent of the theme (edit frames), read in entry()

//A theme colour ({r,g,b,a} 0..1) as vec4f, the token default when the theme does not have it
theme_color(t, key, fallback) {
	if(t && t.has(key)) {
		c = t[key];
		return vec4f(c.r, c.g, c.b, c.a);
	}
	return fallback;
}

//Size of a new control of each kind
default_size(kind) {
	if(kind == "fader")
		return vec2f(70, 220);
	if(kind == "knob")
		return vec2f(80, 100);
	return vec2f(100, 50);
}

kind_name(kind) {
	if(kind == "fader")
		return "Fader";
	if(kind == "knob")
		return "Knob";
	if(kind == "toggle")
		return "Toggle";
	return "Button";
}

snap(v) {
	return math.round(v / GRID) * GRID;
}

count_kind(kind) {
	n = 0;
	for(i = 0; i < items.size(); i++) {
		if(items[i].kind == kind)
			n++;
	}
	return n;
}

//A free place for a new control: right of the last one in the top row, else below
free_place(size) {
	x = GRID;
	y = GRID;
	for(i = 0; i < items.size(); i++) {
		p = items[i].ctrl.position();
		s = items[i].ctrl.fixed_size();
		if(p.y < GRID * 2 && p.x + s.x + GRID > x)
			x = p.x + s.x + GRID;
	}
	if(x + size.x > canvas.width() && canvas.width() > 0) {
		x = GRID;
		y = GRID;
		for(i = 0; i < items.size(); i++) {
			p = items[i].ctrl.position();
			s = items[i].ctrl.fixed_size();
			if(p.y + s.y + GRID > y)
				y = p.y + s.y + GRID;
		}
	}
	return vec2f(snap(x), snap(y));
}

//The control itself: name and group stay the same for its id, so links, MIDI and its value come back with a project
make_control(kind, id) {
	ctrl = None;
	if(kind == "fader")
		ctrl = canvas.controlslider("Fader", id).style("fader");
	else if(kind == "knob")
		ctrl = canvas.controlslider("Knob", id).style("knob");
	else if(kind == "toggle")
		ctrl = canvas.controlbutton("Toggle", id).push(1);
	else
		ctrl = canvas.controlbutton("Button", id).hold(true);
	return ctrl;
}

place(item, pos, size) {
	item.ctrl.position(pos).fixed_size(size).size(size);
	item.overlay.position(pos).fixed_size(size).size(size);
}

remove_control(item) {
	for(i = 0; i < items.size(); i++) {
		if(items[i].id == item.id) {
			if(item.overlay)
				std.free(item.overlay);
			std.free(item.ctrl);
			items.erase(i);
			return;
		}
	}
}

//In edit mode a frame over the control takes the mouse: a drag moves it, a drag at the lower right corner resizes it
make_overlay(item) {
	ctrl = item.ctrl;
	overlay = canvas.widget().position(ctrl.position()).fixed_size(ctrl.fixed_size()).size(ctrl.fixed_size()).visible(editing);
	overlay.tooltip("Drag to move, drag the lower right corner to resize. Leave Edit to play the control.");

	remove = overlay.button("").icon(nanogui.icon("times")).anchor_right(2).anchor_top(2).fixed_size(vec2f(22, 22)).danger("hover")
		.tooltip("Remove this control");
	remove.on_click([item](){
		remove_control(item);
	});

	//Render thread: only what is captured by value (the accent of the theme: the control is selected for editing)
	accent = vec4f(c_accent.x, c_accent.y, c_accent.z, 0.9);
	overlay.on_draw([overlay, accent](){
		s = overlay.size();
		nvgBeginPath();
		nvgRect(vec2f(1, 1), s - vec2f(2, 2));
		nvgStrokeColor(accent);
		nvgStrokeWidth(1.5);
		nvgStroke();
		//The corner that resizes
		nvgBeginPath();
		nvgRect(s - vec2f(12, 12), vec2f(10, 10));
		nvgFillColor(accent);
		nvgFill();
	});

	item.drag = None; //[at_corner=, start_pos=, start_size=, moved=]
	overlay.on_mouse_button([item, overlay](pos, btn, down, mods){
		if(btn != 0)
			return false;
		if(down) {
			s = overlay.size();
			corner = (pos.x > s.x - 16) && (pos.y > s.y - 16);
			item.drag = [
				at_corner = corner ? true : false, //not "resize": a JSON object has a method of that name
				start_pos = item.ctrl.position(),
				start_size = item.ctrl.fixed_size(),
				moved = vec2f(0, 0),
			];
			return true;
		}
		//Release: onto the grid
		if(item.drag) {
			p = item.ctrl.position();
			s = item.ctrl.fixed_size();
			place(item, vec2f(snap(p.x), snap(p.y)), vec2f(math.max(GRID * 3, snap(s.x)), math.max(GRID * 3, snap(s.y))));
		}
		item.drag = None;
		return true;
	});
	overlay.on_mouse_drag([item](pos, rel, btn, mods){
		if(!item.drag)
			return false;
		item.drag.moved = item.drag.moved + rel;
		if(item.drag.at_corner) {
			s = item.drag.start_size + item.drag.moved;
			place(item, item.drag.start_pos, vec2f(math.max(GRID * 3, s.x), math.max(GRID * 3, s.y)));
		}
		else {
			p = item.drag.start_pos + item.drag.moved;
			place(item, vec2f(math.max(0, p.x), math.max(0, p.y)), item.drag.start_size);
		}
		return true;
	});

	item.overlay = overlay;
}

add_control(kind, id = "", pos = None, size = None) {
	is_new = !id;
	if(is_new)
		id = std.random_hash(8);
	if(!size)
		size = default_size(kind);
	if(!pos)
		pos = free_place(size);

	ctrl = make_control(kind, id);
	ctrl.position(pos).fixed_size(size).size(size);
	if(is_new)
		ctrl.display_name(kind_name(kind) + " " + (count_kind(kind) + 1));

	item = [kind = kind, id = id, ctrl = ctrl, overlay = None];
	items.push_back(item);
	make_overlay(item);
	return item;
}

set_editing(v) {
	editing = v ? true : false;
	for(i = 0; i < items.size(); i++) {
		items[i].overlay.visible(editing);
		//On top of its control
		if(editing)
			items[i].overlay.bring_to_front();
	}
	for(i = 0; i < add_buttons.size(); i++) {
		add_buttons[i].visible(editing);
	}
	edit_btn.pushed(editing);
	toolbar.refresh_layout();
}

entry(generator, area) {
	generator.window.fixed_size(vec2f(640, 340));
	area.layout(None);
	c_accent = theme_color(area.theme().to_json(), "accent_color", vec4f(157 / 255.0, 133 / 255.0, 255 / 255.0, 1.0));

	toolbar = area.widget().anchor_left(0).anchor_right(0).anchor_top(0).fixed_height(28).layout(nanogui.layout_horizontal().spacing(4));
	edit_btn = toolbar.pushbutton("Edit").icon(nanogui.icon("pen"))
		.tooltip("Edit the surface: add controls, move them, resize them, remove them. Off: play them.\n[[wiki:Assets#show-controls]]");
	edit_btn.on_change([](v){
		set_editing(v);
	});

	kinds = ["fader", "knob", "button", "toggle"];
	tips = [
		"Add a vertical fader",
		"Add a knob, turned with an up / down drag",
		"Add a button that is on while it is held",
		"Add a button that switches on and off",
	];
	for(i = 0; i < kinds.size(); i++) {
		kind = kinds[i];
		b = toolbar.button(kind_name(kind)).icon(nanogui.icon("plus")).tooltip(tips[i]);
		b.on_click([kind](){
			add_control(kind);
		});
		add_buttons.push_back(b);
	}

	canvas = area.widget().anchor_left(0).anchor_right(0).anchor_top(32).anchor_bottom(0);
	canvas.layout(None);

	//A new surface starts in edit mode with one fader, so it shows what it is for
	add_control("fader");
	set_editing(true);
}

save_state() {
	saved = [];
	for(i = 0; i < items.size(); i++) {
		p = items[i].ctrl.position();
		s = items[i].ctrl.fixed_size();
		saved.push_back([kind = items[i].kind, id = items[i].id, x = p.x, y = p.y, w = s.x, h = s.y]);
	}
	return [items = saved, editing = editing];
}

load_state(state) {
	for(items.size()) {
		remove_control(items[0]);
	}
	if(state.items ?? false) {
		for(i = 0; i < state.items.size(); i++) {
			it = state.items[i];
			add_control(it.kind, it.id, vec2f(it.x, it.y), vec2f(it.w, it.h));
		}
	}
	set_editing(state.editing ?? false);
}
