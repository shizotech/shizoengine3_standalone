// Control 4 generator
// Four plain values from 0 to 1, to set by hand or by MIDI and to link into other controls.
// A link from one of them moves everything it is linked into, so one fader can drive several values.

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	area.controlslider("Control 1").tooltip("A free value from 0 to 1: [[link]] it into what it should move, or map it to MIDI");
	area.controlslider("Control 2").tooltip("A free value from 0 to 1: [[link]] it into what it should move, or map it to MIDI");
	area.controlslider("Control 3").tooltip("A free value from 0 to 1: [[link]] it into what it should move, or map it to MIDI");
	area.controlslider("Control 4").tooltip("A free value from 0 to 1: [[link]] it into what it should move, or map it to MIDI\n[[wiki:Assets#generators--utility]]");
}
