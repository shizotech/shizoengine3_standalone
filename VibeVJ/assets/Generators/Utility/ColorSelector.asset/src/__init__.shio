
using eigen;

grid = None;

brightness = None;

smoothing = None;

active_colors = [];

hsv_to_rgb(h,  s,  v)
{
    h = h - math.floor(h); // wrap hue into [0, 1)

    c = v * s;
    x = c * (1.0 - math.abs(math.mod(h * 6.0, 2.0) - 1.0));
    m = v - c;

    r = 0.0;
	g = 0.0;
	b = 0.0;

    h6 = h * 6.0;

    if (h6 < 1.0)
        r = c; 
		g = x; 
		b = 0.0;
    else if (h6 < 2.0)
        r = x;
		g = c;
		b = 0.0;
    else if (h6 < 3.0)
        r = 0.0;
		g = c;
		b = x;
    else if (h6 < 4.0)
        r = 0.0;
		g = x;
		b = c;
    else if (h6 < 5.0)
        r = x;
		g = 0.0;
		b = c;
    else
        r = c;
		g = 0.0;
		b = x;

    return [
        r + m,
        g + m,
        b + m
    ];
}

rgb_to_hsv(r, g, b)
{
    maxc = math.max(r, math.max(g, b));
    minc = math.min(r, math.min(g, b));
    delta = maxc - minc;

    h = 0.0;
    s = 0.0;
    v = maxc;

    // Saturation
    if (maxc != 0.0)
        s = delta / maxc;

    // Hue
    if (delta != 0.0)
    {
        if (maxc == r)
            h = math.mod((g - b) / delta, 6.0);
        else if (maxc == g)
            h = ((b - r) / delta) + 2.0;
        else
            h = ((r - g) / delta) + 4.0;

        h = h / 6.0;

        // Wrap hue into [0, 1)
        if (h < 0.0)
            h = h + 1.0;
    }

    return [
        h,
        s,
        v
    ];
}

color_for_index(i, count)
{
    h = std.float(i) / std.float(count);

    return hsv_to_rgb(
        h,
        0.85,   // saturation
        1.0     // brightness
    );
}

set_size(targets, colors) {
	
	grid.rows(targets).cols(colors);
	
	active_colors.resize(targets);
	
	for(j = 0; j < colors; j++) {
		
		item = None;
		trigger_btn = None;
		
		if(grid.get_header_top_item(j))
			item = grid.get_header_top_item(j);
			trigger_btn = item.attr.trigger_btn;
		else
			item = grid.add_header_top_item(j);
			trigger_btn = item.controlbutton("toptrigger_"+j).anchor(0).transparent(1).hide_config_menu(true);
			item.attr.trigger_btn = trigger_btn;
			
		if(j == 0)
			item.attr.color = vec4f(0,0,0,1);
		else if(j == 1)
			item.attr.color = vec4f(1,1,1,1);
		else
			col = color_for_index(j-2,colors-2);
			item.attr.color = vec4f(col[0],col[1],col[2],1.0);

		item.on_draw([item, trigger_btn](){
			ctx = nanogui.current_context();
			ctx.nvgBeginPath();
			ctx.nvgRect(vec2f(0,0), vec2f(item.width(), item.height()));
			ctx.nvgFillColor(item.attr.color);
			ctx.nvgFill();
			
			if(trigger_btn.value()) {
				ctx.nvgBeginPath();
				ctx.nvgRect(vec2f(0,0), vec2f(item.width(), item.height()));ctx.nvgStrokeColor(vec4f(0,0,0,1));
				ctx.nvgStrokeWidth(3);
				ctx.nvgStroke();
			}
		});
		
		trigger_btn.callback([targets, j](v){
				for(i = 0; i < targets; i++) {
					grid.get_item_at(i,j).attr.trigger_btn.value(true);
				}
			});
	}
	
	for(i = 0; i < targets; i++) {
		
		left_item = None;
		
		if(!grid.get_header_left_item(i))
		{
			left_item = grid.add_header_left_item(i);
			left_item.controltext("target_name_"+i).value("Color "+(i+1)).anchor(0).anchor_right(100).hide_config_menu();
			
			rgb_out_scroll = left_item.vscroll().anchor_right(0).anchor_top(0).anchor_bottom(0).fixed_width(100).content().layout(nanogui.layout_vertical());
			
			rgb_out_vec = rgb_out_scroll.controlvector("RGB", "rgbout_"+i);	
			r = rgb_out_vec.controlfloat("R", "r_"+i).min(0).max(1);
			g = rgb_out_vec.controlfloat("G", "g_"+i).min(0).max(1);
			b = rgb_out_vec.controlfloat("B", "b_"+i).min(0).max(1);
			
			hsv_out_vec = rgb_out_scroll.controlvector("HSV", "hsvout_"+i);	
			h = hsv_out_vec.controlfloat("H", "h_"+i).min(0).max(1);
			s = hsv_out_vec.controlfloat("S", "s_"+i).min(0).max(1);
			v = hsv_out_vec.controlfloat("V", "v_"+i).min(0).max(1);
			
			r.smoothing(smoothing.value());
			g.smoothing(smoothing.value());
			b.smoothing(smoothing.value());
			h.smoothing(smoothing.value());
			s.smoothing(smoothing.value());
			v.smoothing(smoothing.value());		
			
			left_item.attr.r = r;
			left_item.attr.g = g;
			left_item.attr.b = b;
			left_item.attr.h = h;
			left_item.attr.s = s;
			left_item.attr.v = v;
		}
		else
			left_item = grid.get_header_left_item(i);
		
		//add new color trigger buttons...
		for(j = 0; j < colors; j++) {
			
			item = None;
			trigger_btn = None;
			
			if(grid.get_item_at(i,j))
				item = grid.get_item_at(i,j);
				trigger_btn = item.attr.trigger_btn;
			else
				item = grid.add_item(i,j);			
				trigger_btn = item.controlbutton("trigger_"+i+"_"+j).anchor(0).transparent(1).push(1).hide_config_menu(true);		
				item.attr.trigger_btn = trigger_btn;
			
			trigger_btn.callback([i,j,trigger_btn,item,left_item](v){
				if(!v) {
					if(active_colors[i] == trigger_btn)
						trigger_btn.value(true, false);
					return;
				}
				else if(active_colors[i] == trigger_btn)
					return;
				
				if(active_colors[i])
					old_trigger = active_colors[i];
					active_colors[i] = None;
					old_trigger.value(0, false);	
				if(v)
					active_colors[i] = trigger_btn;
					trigger_btn.value(true, false);
					left_item.attr.r.value(item.attr.color.x * brightness.value());
					left_item.attr.g.value(item.attr.color.y * brightness.value());
					left_item.attr.b.value(item.attr.color.z * brightness.value());
					hsv = rgb_to_hsv(left_item.attr.r.value(), left_item.attr.g.value(), left_item.attr.b.value());
					left_item.attr.h.value(hsv[0]);
					left_item.attr.s.value(hsv[1]);
					left_item.attr.v.value(hsv[2]);
				else if(j > 1)
					grid.get_item_at(i,0).attr.trigger_btn.value(true);
			});
			
			if(j == 0)
				item.attr.color = vec4f(0,0,0,1);
			else if(j == 1)
				item.attr.color = vec4f(1,1,1,1);
			else
				col = color_for_index(j-2,colors-2);
				item.attr.color = vec4f(col[0],col[1],col[2],1.0);

			item.on_draw([item, trigger_btn](){
				ctx = nanogui.current_context();
				ctx.nvgBeginPath();
				ctx.nvgCircle(vec2f(item.width()/2.0,item.height()/2.0), math.min(item.width(), item.height())/2.0 - 3.0);
				ctx.nvgFillColor(item.attr.color);
				ctx.nvgFill();
				
				if(trigger_btn.value()) {
					ctx.nvgBeginPath();
					ctx.nvgCircle(vec2f(item.width()/2.0,item.height()/2.0), math.min(item.width(), item.height())/2.0 - 3.0);
					ctx.nvgStrokeColor(vec4f(0,0,0,1));
					ctx.nvgStrokeWidth(3);
					ctx.nvgStroke();
					
					ctx.nvgBeginPath();
					ctx.nvgRect(vec2f(0,0), vec2f(item.width(), item.height()));ctx.nvgStrokeColor(vec4f(0,0,0,1));
					ctx.nvgStrokeColor(vec4f(0.6,0.5,0,1));
					ctx.nvgStrokeWidth(3);
					ctx.nvgStroke();
					
					cx = item.width() / 2.0;
					cy = item.height() / 2.0;
					size = 8.0;

					ctx.nvgBeginPath();

					ctx.nvgMoveTo(vec2f(cx - size, cy - size));
					ctx.nvgLineTo(vec2f(cx + size, cy + size));

					ctx.nvgMoveTo(vec2f(cx + size, cy - size));
					ctx.nvgLineTo(vec2f(cx - size, cy + size));

					ctx.nvgStrokeColor(vec4f(0,0,0,1));
					ctx.nvgStrokeWidth(2);
					ctx.nvgStroke();
				}
			});
		}
		
		
		//hsv_out_vec = left_item.controlvector("HSV", "hsvout_"+i).anchor_left(0.5,"percent").anchor_right(0).anchor_top(35).fixed_height(30);
	}
}

entry(generator, area) {
	
	num_targets = area.controlint("Num Targets").anchor_left(0).anchor_top(0).anchor_right(0.75, "percent").fixed_height(30).min(1);
	num_colors = area.controlint("Num Colors").anchor_left(0.25, "percent").anchor_top(0).anchor_right(0.5, "percent").fixed_height(30).min(1);
	
	brightness = area.controlslider("Brightness").anchor_left(0.5, "percent").anchor_top(0).anchor_right(0.25, "percent").fixed_height(30).value(1.0);
	smoothing = area.controlslider("Smoothing").anchor_left(0.75, "percent").anchor_top(0).anchor_right(0).fixed_height(30);
	
	grid = area.gridview()
		.anchor(0).anchor_top(70)
		.header_left_width(275)
		.header_top_height(60)
		.rows(0).cols(0)
		.show_grid(true);

	num_targets.callback([num_targets, num_colors](v){
		set_size(num_targets.value(), num_colors.value());
	});
	
	num_colors.callback(num_targets.callback());
	
	num_targets.value(1);
	num_colors.value(1);
	
	smoothing.callback([](v){
		v = 1.0 - v;
		v = math.pow(v,4);
		v = 1.0 - v;
		for(i = 0; i < grid.rows(); i++) {
			left_item = grid.get_header_left_item(i);
			if(left_item)
				left_item.attr.r.smoothing(v);
				left_item.attr.g.smoothing(v);
				left_item.attr.b.smoothing(v);
				left_item.attr.h.smoothing(v);
				left_item.attr.s.smoothing(v);
				left_item.attr.v.smoothing(v);
		}
	});
}

save_state() {
	states = [];
	states.cell_size_x = grid.cell_size().x;
	states.cell_size_y = grid.cell_size().y;
	states.spacing_x = grid.spacing().x;
	states.spacing_y = grid.spacing().y;
	return states;
}

load_state(states) {
	grid.cell_size(vec2f(states.cell_size_x, states.cell_size_y));
	grid.spacing(vec2f(states.spacing_x, states.spacing_y));
}