// Color Selector generator
// A grid of colours: one row per target, one column per colour (black, white, then hues around the circle).
// A click on a colour sets that target's RGB and HSV outputs (scaled by Brightness, gliding by Smoothing);
// a click on a column header sets every target to that colour.
// The selected colour of a row is marked in the theme's accent colour (selection), the swatches are content.

import nanogui;

using nanogui; //For nvg*
using eigen;

grid = None;

// Theme colours for the selection marks (read in entry(), captured by value in on_draw)
c_select = vec4f(157.0 / 255.0, 133.0 / 255.0, 1.0, 1.0);   // accent: selected colour
c_ring = vec4f(22.0 / 255.0, 23.0 / 255.0, 26.0 / 255.0, 1.0); // field: ring that parts the mark from the swatch

brightness = None;

smoothing = None;

active_colors = [];

hsv_to_rgb(h,  s,  v)
{
    h = h - math.floor(h); // wrap hue into [0, 1)

    c = v * s;
    x = c * (1.0 - math.abs(math.mod(h * 6.0, 2.0) - 1.0));
    m = v - c;

    r = 0.0;
	g = 0.0;
	b = 0.0;

    h6 = h * 6.0;

    if (h6 < 1.0)
        r = c; 
		g = x; 
		b = 0.0;
    else if (h6 < 2.0)
        r = x;
		g = c;
		b = 0.0;
    else if (h6 < 3.0)
        r = 0.0;
		g = c;
		b = x;
    else if (h6 < 4.0)
        r = 0.0;
		g = x;
		b = c;
    else if (h6 < 5.0)
        r = x;
		g = 0.0;
		b = c;
    else
        r = c;
		g = 0.0;
		b = x;

    return [
        r + m,
        g + m,
        b + m
    ];
}

rgb_to_hsv(r, g, b)
{
    maxc = math.max(r, math.max(g, b));
    minc = math.min(r, math.min(g, b));
    delta = maxc - minc;

    h = 0.0;
    s = 0.0;
    v = maxc;

    // Saturation
    if (maxc != 0.0)
        s = delta / maxc;

    // Hue
    if (delta != 0.0)
    {
        if (maxc == r)
            h = math.mod((g - b) / delta, 6.0);
        else if (maxc == g)
            h = ((b - r) / delta) + 2.0;
        else
            h = ((r - g) / delta) + 4.0;

        h = h / 6.0;

        // Wrap hue into [0, 1)
        if (h < 0.0)
            h = h + 1.0;
    }

    return [
        h,
        s,
        v
    ];
}

// A colour of the UI theme as vec4f (alpha 1), or the fallback when the theme has no such key.
theme_color(t, key, fallback) {
	if(t && t.has(key)) {
		c = t[key];
		return vec4f(c.r, c.g, c.b, c.a);
	}
	return fallback;
}

// Smoothing slider (0..1) to the smoothing of the outputs: most of the travel is in the slow end.
smoothing_curve(v) {
	v = 1.0 - v;
	v = math.pow(v, 4);
	return 1.0 - v;
}

color_for_index(i, count)
{
    h = std.float(i) / std.float(count);

    return hsv_to_rgb(
        h,
        0.85,   // saturation
        1.0     // brightness
    );
}

set_size(targets, colors) {
	
	grid.rows(targets).cols(colors);
	
	active_colors.resize(targets);

	// Local copies: the on_draw closures run on the render thread and capture them by value
	sel_col = c_select;
	ring_col = c_ring;
	
	for(j = 0; j < colors; j++) {
		
		item = None;
		trigger_btn = None;
		
		if(grid.get_header_top_item(j))
			item = grid.get_header_top_item(j);
			trigger_btn = item.attr.trigger_btn;
		else
			item = grid.add_header_top_item(j);
			trigger_btn = item.controlbutton("toptrigger_"+j).anchor(0).transparent(1).hide_config_menu(true).tooltip("Set every target to this colour");
			item.attr.trigger_btn = trigger_btn;
			
		if(j == 0)
			item.attr.color = vec4f(0,0,0,1);
		else if(j == 1)
			item.attr.color = vec4f(1,1,1,1);
		else
			col = color_for_index(j-2,colors-2);
			item.attr.color = vec4f(col[0],col[1],col[2],1.0);

		item.on_draw([item, trigger_btn, sel_col](){
			nvgBeginPath();
			nvgRect(vec2f(0,0), vec2f(item.width(), item.height()));
			nvgFillColor(item.attr.color);
			nvgFill();
			
			if(trigger_btn.value()) {
				nvgBeginPath();
				nvgRect(vec2f(1.5,1.5), vec2f(item.width() - 3.0, item.height() - 3.0));
				nvgStrokeColor(sel_col);
				nvgStrokeWidth(3);
				nvgStroke();
			}
		});
		
		trigger_btn.callback([targets, j](v){
				for(i = 0; i < targets; i++) {
					grid.get_item_at(i,j).attr.trigger_btn.value(true);
				}
			});
	}
	
	for(i = 0; i < targets; i++) {
		
		left_item = None;
		
		if(!grid.get_header_left_item(i))
		{
			left_item = grid.add_header_left_item(i);
			left_item.controltext("target_name_"+i).value("Target "+(i+1)).anchor(0).anchor_right(100).hide_config_menu().tooltip("Name of this target");
			
			rgb_out_scroll = left_item.vscroll().anchor_right(0).anchor_top(0).anchor_bottom(0).fixed_width(100).content().layout(nanogui.layout_vertical());
			
			rgb_out_vec = rgb_out_scroll.controlvector("RGB", "rgbout_"+i).tooltip("Red, green and blue of the chosen colour, 0 to 1, times Brightness: [[link]] them into what should take the colour");
			r = rgb_out_vec.controlfloat("R", "r_"+i).min(0).max(1);
			g = rgb_out_vec.controlfloat("G", "g_"+i).min(0).max(1);
			b = rgb_out_vec.controlfloat("B", "b_"+i).min(0).max(1);
			
			hsv_out_vec = rgb_out_scroll.controlvector("HSV", "hsvout_"+i).tooltip("Hue, saturation and value (brightness) of the chosen colour, 0 to 1: [[link]] them into what should take the colour");
			h = hsv_out_vec.controlfloat("H", "h_"+i).min(0).max(1);
			s = hsv_out_vec.controlfloat("S", "s_"+i).min(0).max(1);
			v = hsv_out_vec.controlfloat("V", "v_"+i).min(0).max(1);
			
			// The same curve as the Smoothing callback (before, new rows got the raw slider value)
			sm = smoothing_curve(smoothing.value());
			r.smoothing(sm);
			g.smoothing(sm);
			b.smoothing(sm);
			h.smoothing(sm);
			s.smoothing(sm);
			v.smoothing(sm);
			
			left_item.attr.r = r;
			left_item.attr.g = g;
			left_item.attr.b = b;
			left_item.attr.h = h;
			left_item.attr.s = s;
			left_item.attr.v = v;
		}
		else
			left_item = grid.get_header_left_item(i);
		
		//add new color trigger buttons...
		for(j = 0; j < colors; j++) {
			
			item = None;
			trigger_btn = None;
			
			if(grid.get_item_at(i,j))
				item = grid.get_item_at(i,j);
				trigger_btn = item.attr.trigger_btn;
			else
				item = grid.add_item(i,j);			
				trigger_btn = item.controlbutton("trigger_"+i+"_"+j).anchor(0).transparent(1).push(1).hide_config_menu(true).tooltip("Pick this colour for the target of this row");
				item.attr.trigger_btn = trigger_btn;
			
			trigger_btn.callback([i,j,trigger_btn,item,left_item](v){
				if(!v) {
					if(active_colors[i] == trigger_btn)
						trigger_btn.value(true, false);
					return;
				}
				else if(active_colors[i] == trigger_btn)
					return;
				
				if(active_colors[i])
					old_trigger = active_colors[i];
					active_colors[i] = None;
					old_trigger.value(0, false);	
				if(v)
					active_colors[i] = trigger_btn;
					trigger_btn.value(true, false);
					left_item.attr.r.value(item.attr.color.x * brightness.value());
					left_item.attr.g.value(item.attr.color.y * brightness.value());
					left_item.attr.b.value(item.attr.color.z * brightness.value());
					hsv = rgb_to_hsv(left_item.attr.r.value(), left_item.attr.g.value(), left_item.attr.b.value());
					left_item.attr.h.value(hsv[0]);
					left_item.attr.s.value(hsv[1]);
					left_item.attr.v.value(hsv[2]);
				else if(j > 1)
					grid.get_item_at(i,0).attr.trigger_btn.value(true);
			});
			
			if(j == 0)
				item.attr.color = vec4f(0,0,0,1);
			else if(j == 1)
				item.attr.color = vec4f(1,1,1,1);
			else
				col = color_for_index(j-2,colors-2);
				item.attr.color = vec4f(col[0],col[1],col[2],1.0);

			item.on_draw([item, trigger_btn, sel_col, ring_col](){
				cx = item.width() / 2.0;
				cy = item.height() / 2.0;
				rad = math.min(item.width(), item.height())/2.0 - 3.0;

				nvgBeginPath();
				nvgCircle(vec2f(cx, cy), rad);
				nvgFillColor(item.attr.color);
				nvgFill();
				
				if(trigger_btn.value()) {
					// Selected: the cell outlined in the accent colour, the swatch parted from it by a ring
					// in the field colour, and a check mark that contrasts with the swatch
					nvgBeginPath();
					nvgCircle(vec2f(cx, cy), rad);
					nvgStrokeColor(ring_col);
					nvgStrokeWidth(3);
					nvgStroke();
					
					nvgBeginPath();
					nvgRect(vec2f(1.5,1.5), vec2f(item.width() - 3.0, item.height() - 3.0));
					nvgStrokeColor(sel_col);
					nvgStrokeWidth(3);
					nvgStroke();
					
					swatch = item.attr.color;
					lum = 0.2126 * swatch.x + 0.7152 * swatch.y + 0.0722 * swatch.z;
					mark = lum > 0.5 ? vec4f(0, 0, 0, 0.85) : vec4f(1, 1, 1, 0.9);
					size = 7.0;

					nvgBeginPath();
					nvgMoveTo(vec2f(cx - size, cy));
					nvgLineTo(vec2f(cx - size * 0.3, cy + size * 0.7));
					nvgLineTo(vec2f(cx + size, cy - size * 0.7));
					nvgStrokeColor(mark);
					nvgStrokeWidth(2.5);
					nvgStroke();
				}
			});
		}
		
		
		//hsv_out_vec = left_item.controlvector("HSV", "hsvout_"+i).anchor_left(0.5,"percent").anchor_right(0).anchor_top(35).fixed_height(30);
	}
}

entry(generator, area) {
	
	t = area.theme().to_json();
	c_select = theme_color(t, "accent_color", c_select);
	c_ring = theme_color(t, "input_fill", c_ring);

	// One 28 px row of four controls, a quarter of the width each (IDs "Num Targets" / "Num Colors" stay)
	num_targets = area.controlint("Num Targets").caption("Targets").tooltip("How many targets, one row each, each with its own colour outputs\n[[wiki:Assets#generators--utility]]").anchor_left(0).anchor_top(0).anchor_right(0.75, "percent").fixed_height(28).min(1);
	num_colors = area.controlint("Num Colors").caption("Colours").tooltip("How many colours to choose from, one column each: black, white and hues around the colour circle").anchor_left(0.25, "percent").anchor_top(0).anchor_right(0.5, "percent").fixed_height(28).min(1);
	
	brightness = area.controlslider("Brightness").tooltip("Scales R, G and B of a colour when it is picked").anchor_left(0.5, "percent").anchor_top(0).anchor_right(0.25, "percent").fixed_height(28).value(1.0);
	smoothing = area.controlslider("Smoothing").tooltip("How slowly a target glides to its new colour. 0: at once").anchor_left(0.75, "percent").anchor_top(0).anchor_right(0).fixed_height(28);
	
	// The grid below the row, 8 px apart
	grid = area.gridview()
		.anchor(0).anchor_top(36)
		.header_left_width(275)
		.header_top_height(60)
		.rows(0).cols(0)
		.show_grid(true);

	num_targets.callback([num_targets, num_colors](v){
		set_size(num_targets.value(), num_colors.value());
	});
	
	num_colors.callback(num_targets.callback());
	
	num_targets.value(1);
	num_colors.value(1);
	
	smoothing.callback([](v){
		v = smoothing_curve(v);
		for(i = 0; i < grid.rows(); i++) {
			left_item = grid.get_header_left_item(i);
			if(left_item)
				left_item.attr.r.smoothing(v);
				left_item.attr.g.smoothing(v);
				left_item.attr.b.smoothing(v);
				left_item.attr.h.smoothing(v);
				left_item.attr.s.smoothing(v);
				left_item.attr.v.smoothing(v);
		}
	});
}

save_state() {
	states = [];
	states.cell_size_x = grid.cell_size().x;
	states.cell_size_y = grid.cell_size().y;
	states.spacing_x = grid.spacing().x;
	states.spacing_y = grid.spacing().y;
	return states;
}

load_state(states) {
	if(states.has("cell_size_x") && states.has("cell_size_y"))
		grid.cell_size(vec2f(states.cell_size_x, states.cell_size_y));
	if(states.has("spacing_x") && states.has("spacing_y"))
		grid.spacing(vec2f(states.spacing_x, states.spacing_y));
}