// Loop trigger (#680, step 4): a clip on the main timeline that starts a loop timeline of the view Loops while the
// playhead is inside it. Dropped onto a lane like any asset: clip_start starts the loop it names, clip_stop stops it
// again (Stop at the end). From the start: the loop begins its turn when the clip begins; off: it runs from where the
// main timeline is, so it meets the other loops on the bars (as its Start button does).
// The loop is kept by its guid (and its name, when the guid is gone: a project that made the loop again).

managed pick = None;
managed from_start = None;
managed stop_at_end = None;
managed status = None;
loop_guid = "";
loop_name = "";
guids = [];

loops_view() {
	tl = std.global("timeline");
	return tl ? tl.loops : None;
}

//The loop entry of loops.shio, None when there is none
find_loop() {
	lv = loops_view();
	if(!lv)
		return None;
	e = loop_guid != "" ? lv.find(loop_guid) : None;
	if(!e && loop_name != "")
		e = lv.find(loop_name);
	return e;
}

show() {
	e = find_loop();
	text = loop_guid == "" ? "Pick the loop this clip starts" : (e ? e.clock.name + (e.clock.running ? ": running" : ": stopped") : "The loop " + loop_name + " is not there");
	if(status.caption() != text)
		status.caption(text);
}

//The names of the loops, the one chosen selected
fill() {
	lv = loops_view();
	names = ["(no loop)"];
	guids = [""];
	if(lv) {
		for(e : lv.loops) {
			names.push_back(e.clock.name);
			guids.push_back(e.clock.guid);
		}
	}
	at = 0;
	for(i = 0; i < guids.size(); i++) {
		if(guids[i] != "" && guids[i] == loop_guid)
			at = i;
	}
	if(at == 0 && loop_guid != "") {
		names.push_back(loop_name + " (not there)");
		guids.push_back(loop_guid);
		at = guids.size() - 1;
	}
	pick.items(names);
	pick.selected(at);
	show();
}

start_loop() {
	e = find_loop();
	if(!e)
		return;
	if(from_start.value()) {
		e.clock.reset();
		e.clock.running = true;
	}
	else
		e.clock.start(loops_view().main_pos());
	show();
}

stop_loop() {
	e = find_loop();
	if(!e || !stop_at_end.value())
		return;
	e.clock.stop();
	show();
}

dispatcher(generator, cmd, value) {
	if(cmd == "clip_start")
		start_loop();
	else if(cmd == "clip_stop")
		stop_loop();
}

entry(generator, area) {
	area.layout(nanogui.layout_vertical());
	area.label("Loop").font_size(13).fixed_height(18);
	pick = area.combobox().anchor_left(0).anchor_right(0).fixed_height(26)
		.tooltip("The [[loop]] of the view Loops this clip starts while the playhead is inside it\n[[wiki:Timeline#loop-timelines]]");
	pick.on_open([](){
		fill();
	});
	pick.on_change([](index, text){
		if(index < 0 || index >= guids.size())
			return;
		loop_guid = guids[index];
		lv = loops_view();
		e = lv && loop_guid != "" ? lv.find(loop_guid) : None;
		loop_name = e ? e.clock.name : "";
		show();
	});
	from_start = area.controlbutton("FROM START").caption("From the start").push(true).value(1);
	from_start.get_button().tooltip("On: the loop begins its turn when the clip begins. Off: it runs from where the main timeline is, so loops meet on the bars");
	stop_at_end = area.controlbutton("STOP AT END").caption("Stop at the end").push(true).value(1);
	stop_at_end.get_button().tooltip("On: the loop stops when the playhead leaves the clip. Off: it runs on");
	status = area.label("").font_size(13).fixed_height(20);
	fill();
	generator.on_get_status([](){
		e = find_loop();
		return [loop = loop_name, guid = loop_guid, there = e ? true : false, running = e && e.clock.running ? true : false,
			explanation = "A clip of the timeline that starts the loop timeline it names while the playhead is inside it (clip_start) and stops it at its end (Stop at the end). set_loop picks the loop by its guid or name."];
	});
	generator.register("set_loop", [
		loop = "&string(): The loop timeline (its guid, name or index, get_timeline_loops).",
	], [](args){
		lv = loops_view();
		e = lv ? lv.find(args.loop) : None;
		if(!e)
			return [ok = false, error = "No such loop timeline."];
		loop_guid = e.clock.guid;
		loop_name = e.clock.name;
		fill();
		return [ok = true, loop = loop_name, guid = loop_guid];
	}, "Picks the loop timeline this clip starts.");
}

save_state() {
	return [loop = loop_guid, name = loop_name];
}

load_state(state) {
	loop_guid = state.has("loop") ? state.loop : "";
	loop_name = state.has("name") ? state.name : "";
	if(pick)
		fill();
}
