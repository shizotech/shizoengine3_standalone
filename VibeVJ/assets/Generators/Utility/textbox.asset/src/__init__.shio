// Textbox generator
// A free text field for notes. The text is saved with the project.

textarea = None;

entry(generator, area) {
	textarea = area.textarea().anchor(3);
}

save_state() {
	return [
		text = textarea.text(),
	];
}

load_state(state) {
	if(state.has("text"))
		textarea.text(state.text);
}
