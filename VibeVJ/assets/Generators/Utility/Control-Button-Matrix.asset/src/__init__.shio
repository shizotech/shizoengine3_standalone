// Control Button Matrix generator
// A grid of Rows x Columns buttons. Each button has a settings popup with its name, a mode and three values,
// and an Output to link into what it should switch:
//   Flash:    pressed -> Value, released -> 0 (on only while held)
//   Absolute: on -> Value, off -> Input (a click switches on / off)
//   Relative: on -> Value x Input, off -> Input (a click switches on / off)
// The controls keep their first IDs ("MODE B0_0", "VAL B0_0", "SWITCH B0_0", "INPUT B0_0", "OUTPUT B0_0",
// the button "B0_0" in group "BTN B0_0", "ROWS" / "COLS"): saved projects, links and MIDI mappings address
// them. Only their captions changed.
import nanogui;

managed grid = None;
managed rows_ctrl = None;
managed cols_ctrl = None;

buttons = [];
ui = [];

// Map a mode string to its combobox index (items = ["Flash","Relative","Absolute"]).
mode_to_index(m) {
	if(m == "Flash")
		return 0;
	if(m == "Relative")
		return 1;
	if(m == "Absolute")
		return 2;
	return 0;
}


// Resolve the selected combo item text from its selected index + items list.
// 'nanogui.midicontrolcombo' has no 'selected_text' member (verified via docs),
// so we derive the text by indexing items() with selected_index().
mode_text(combo) {
	items = combo.items();
	idx = combo.selected_index();
	return items[idx];
}

// Central output computation. Drives the per-button output slider based on
// the selected mode and the switch (controlbutton) state.
//   Flash:    switch on -> output = value, switch off -> output = 0
//   Absolute: switch on -> output = value, switch off -> output = input
//   Relative: switch on -> output = value * input, switch off -> output = input
update_output(idx) {
	cfg = buttons[idx];
	u = ui[idx];
	if(u == None)
		return;
	mode = mode_text(u.mode_box);
	// Use the source-of-truth cfg.switch (bool) instead of the widget mirror
	// (u.switch_btn.value()) which lags by one event and caused the switch
	// toggle to not be reflected in absolute/relative mode.
	sw = cfg.switch;
	input_val = u.input.value();
	val_val = cfg.value;
	out = 0.0;
	if(mode == "Flash") {
		if(sw != 0)
			out = val_val;
		else
			out = 0.0;
	}
	else if(mode == "Absolute") {
		if(sw != 0)
			out = val_val;
		else
			out = input_val;
	}
	else if(mode == "Relative") {
		if(sw != 0)
			out = val_val * input_val;
		else
			out = input_val;
	}
	cfg.output = out;
	// Keep the switch controlbutton (ID "SWITCH Bx") visually in sync with cfg.switch.
	u.switch_btn.value(cfg.switch, false, false);
	// Set the output slider without re-triggering its own value callback.
	u.output.value(out, false, false);
}

// prev: the settings this button had before the grid was rebuilt (same id), or None
build_button(parent, idx, name, col, cols, prev) {
	cfg = [id=name, name=name, mode="Flash", value=0.0, switch=false, input=0.0, output=0.0];
	if(prev) {
		cfg.name = prev.name;
		cfg.mode = prev.mode;
		cfg.value = prev.value;
		cfg.input = prev.input;
	}
	buttons.push_back(cfg);

	// Compact cell: main button + settings popup button. The cells of a row share its width
	// (percent anchors), so the grid stretches with the window.
	cell = parent.widget().layout(nanogui.layout_vertical().spacing(4))
		.anchor_top(0).anchor_bottom(0).anchor_left(col / std.float(cols), "percent").anchor_right((cols - 1 - col) / std.float(cols), "percent");

	// Main action button (its control ID stays the first name, it shows the current name)
	btn = cell.controlbutton(name, "BTN " + name).hold(true).anchor_left(0).anchor_right(0)
		.tooltip("Flash: on while you hold it. Absolute, Relative: a click switches it on or off. Map it to a pad or [[link]] something into it");
	btn.display_name(cfg.name);

	// Settings button (button_popup) below the main button
	popup = cell.button_popup("Settings").icon(nanogui.icon("cog")).side("bottom").fixed_height(28)
		.tooltip("Settings of this button: name, mode, value, input and output");

	// Popup menu content (vertical layout) holds all setting widgets
	content = popup.popup().content().layout(nanogui.layout_vertical());

	name_box = content.textbox().editable(true).value(cfg.name).placeholder("Name of the button").tooltip("The name on the button").anchor_left(0).anchor_right(0);
	// Item order is saved (as an index) and mapped by mode_to_index(): keep it
	mode_box = content.controlcombo("MODE " + name).caption("Mode").tooltip("Flash: the value while on, else 0. Absolute: the value while on, else the input. Relative: value times input while on, else the input").items(["Flash","Relative","Absolute"]).anchor_left(0).anchor_right(0);
	mode_box.value(mode_to_index(cfg.mode));
	val = content.controlslider("VAL " + name, name).caption("Value").tooltip("The value this button gives while it is on").min(0).max(1.0).value(cfg.value).anchor_left(0).anchor_right(0);
	switch_btn = content.controlbutton("SWITCH " + name, name).caption("Switch").tooltip("The button: on or off. [[link]] something into it or map it to a pad").push(1).anchor_left(0).anchor_right(0);
	input = content.controlslider("INPUT " + name, name).caption("Input").tooltip("What goes out while the button is off (Absolute, Relative)").min(0).max(1.0).value(cfg.input).anchor_left(0).anchor_right(0);
	// A pure output: the script writes it on every change, a link into it would be overwritten
	output = content.controlslider("OUTPUT " + name, name).caption("Output").as_output(true).tooltip("What this button gives. A [[pure output]]: [[link]] it into what it should switch\n[[wiki:Assets#generators--utility]]").min(0).max(1.0).value(cfg.output).anchor_left(0).anchor_right(0);

	ui.push_back([name_box=name_box, mode_box=mode_box, val=val, btn=btn,
	               switch_btn=switch_btn, input=input, output=output]);

	// (a) Switch change -> update output
	switch_btn.callback([idx, cfg](v){
		cfg.switch = v != 0;
		update_output(idx);
	});

	// (b) Value change -> update output
	val.callback([cfg, idx](v){
		cfg.value = v;
		update_output(idx);
	});

	// (c) Input change -> update output
	input.callback([cfg, idx](v){
		cfg.input = v;
		update_output(idx);
	});

	// (d) Mode change -> update output
	mode_box.callback([mode_box, cfg, idx](i){
		cfg.mode = mode_text(mode_box);
		update_output(idx);
	});

	// Main action button:
	//   Flash:    momentary switch -> on while held, off on release (cfg.switch = down)
	//   Relative / Absolute: click-to-toggle, triggered only on release so a
	//            normal click toggles exactly once.
	btn.callback([idx, cfg](v) {
		if(cfg.mode == "Flash") {
			cfg.switch = v;
		}
		else if(v == 0) {
			cfg.switch = !cfg.switch;
		}
		update_output(idx);
	});

	// Keep the main button caption synced with the editable name field
	name_box.on_change([cfg, btn](v){
		if(v)
			cfg.name = v;
		if(v && btn)
			btn.display_name(v);
	});

	// Initial output state
	update_output(idx);
}

// Rebuild the button grid from the current Rows / Columns values.
// A button that exists before and after (same row and column) keeps its name, mode, value and input;
// before, every change of Rows or Columns reset all buttons.
rebuild_grid() {
	// (a) Remember the settings by button id, clear the grid and reset the data lists.
	prev = std.json();
	for(b : buttons)
		prev[b.id] = b;
	if(grid != None)
		grid.clear_children();
	buttons = [];
	ui = [];

	// (b) Read the current dimensions from the controlint widgets.
	rows = rows_ctrl.value();
	cols = cols_ctrl.value();

	// (c) Rebuild: outer loop over rows, inner over cols.
	for(r = 0; r < rows; r++) {
		// One row of cells: main control button (default control height) + gap (4) + settings button (28)
		row = grid.widget().fixed_height(64).anchor_left(0).anchor_right(0).fixed_width(120 * cols);
		for(c = 0; c < cols; c++) {
			id = "B" + r + "_" + c;
			build_button(row, r * cols + c, id, c, cols, prev.has(id) ? prev[id] : None);
		}
	}
}

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	// Dimension controls (IDs "ROWS" / "COLS"), side by side in one 28 px row
	size_row = area.widget().fixed_height(28).anchor_left(0).anchor_right(0).fixed_width(240);
	rows_ctrl = size_row.controlint("ROWS", "cmm_rows").tooltip("How many rows of buttons").caption("Rows").min(1).value(3)
		.anchor_top(0).anchor_bottom(0).anchor_left(0).anchor_right(0.5, "percent");
	cols_ctrl = size_row.controlint("COLS", "cmm_cols").tooltip("How many columns of buttons\n[[wiki:Assets#generators--utility]]").caption("Columns").min(1).value(3)
		.anchor_top(0).anchor_bottom(0).anchor_left(0.5, "percent").anchor_right(0);

	// Grid container (persistent reference, children rebuilt on demand)
	grid = area.widget().layout(nanogui.layout_vertical().spacing(8));

	// Changing either dimension rebuilds the whole grid.
	rows_ctrl.callback([](v){
		rebuild_grid();
	});
	cols_ctrl.callback([](v){
		rebuild_grid();
	});

	// Initial grid build.
	rebuild_grid();
}

save_state() {
	state = [
		rows = rows_ctrl.value(),
		cols = cols_ctrl.value(),
		buttons = buttons
	];
	return state;
}

load_state(state) {
	// Restore dimensions without triggering the rebuild callbacks.
	if(state.has("rows"))
		rows_ctrl.value(state.rows, false, false);
	if(state.has("cols"))
		cols_ctrl.value(state.cols, false, false);

	// Rebuild the grid so the buttons list matches the saved dimensions.
	rebuild_grid();

	// Restore per-button fields onto the freshly built buttons.
	if(state.has("buttons")) {
		for(i = 0; i < state.buttons.size(); i++) {
			if(i >= buttons.size())
				break;
			b = state.buttons[i];
			cfg = buttons[i];
			cfg.name = b.name;
			cfg.mode = b.mode;
			cfg.value = b.value;
			cfg.switch = b.switch;
			cfg.input = b.input;
			cfg.output = b.output;

			if(i < ui.size()) {
				cfg_ui = ui[i];
				cfg_ui.name_box.value(b.name);
				cfg_ui.btn.display_name(b.name);
				cfg_ui.mode_box.value(mode_to_index(b.mode));
				cfg_ui.val.value(b.value, false, false);
				cfg_ui.switch_btn.value(b.switch, false, false);
				cfg_ui.input.value(b.input, false, false);
				cfg_ui.output.value(b.output, false, false);
				update_output(i);
			}
		}
	}
}
