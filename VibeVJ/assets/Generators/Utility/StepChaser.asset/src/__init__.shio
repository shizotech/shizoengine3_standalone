// StepChaser generator
// A syncbar step sequencer. Each bar (Takt) is split into a configurable number
// of count positions (Zaehlzeiten / steps). For every step you can either set a
// target Value, or mark the step as HOLD (keep the previous value). When a step
// boundary is reached the block's output slider is driven toward the step value
// with a per-step FadeIn (attack) time, and released with a per-step FadeOut
// time.
//
// Blocks are stacked below each other on the SAME grid, so each block exposes its
// own output controlslider (multiple outputs). Each block's table has three rows:
// Value, FadeOut, FadeIn. Columns are the steps and stay aligned across blocks.
//
// Timing is SYNC only (beat-locked): tl_pos is the timeline position in beats.
import nanogui;

// Global controls
steps_ctrl = None;     // number of steps (Zaehlzeiten) per bar
bar_ctrl = None;       // bar length in beats

// Block bookkeeping
// block_next_id is a MONOTONIC counter: it is never decremented, so control
// ids / group names stay unique and the displayed numbering can never go
// backwards or collide with an existing block after a removal.
block_next_id = 0;
blocks = [];           // list of block records (json)
managed block_list_area = None;

// Deferred teardown request.
// IMPORTANT (crash / ghost-widget safety):
//   No widget may be freed inside a callback of a widget that is currently
//   dispatching an event - the free is ignored there and the block stays
//   visible in the GUI. Removal therefore only marks the block (and stops its
//   output right away); the real teardown runs at the top of update().
pending_rebuild = false;

// ---- Table cell layout constants ----
cell_w = 70;           // width of a step cell (columns align across blocks)
row_h = 26;            // height of a value row
header_h = 56;         // height of the step header (number + mode control)
hold_btn_h = 28;       // height of the CHANGE/HOLD option control (must fit its caption)

// Clamp a value into [0, 1].
clamp01(v) {
	if(v < 0.0)
		return 0.0;
	if(v > 1.0)
		return 1.0;
	return v;
}

// ---- Hold mode (CHANGE / HOLD) ----
// The mode is stored per step in b.hold[i]; the UI widget is a normal option
// control (controlcombo) with the two modes as items, so it never springs back
// like a momentary button would. These helpers keep data and UI in sync.
hold_mode_items = ["CHANGE", "HOLD"];

// Set the hold mode of one step and update the option control (no callback loop).
set_hold_mode(b, i, on) {
	if(i >= b.hold.size())
		return;
	b.hold[i] = on ? true : false;
	if(i < b.hmode.size())
		b.hmode[i].value(on ? 1 : 0, false, false);
}

// Rebuild the step columns of a block whenever the step count changes.
rebuild_block(b) {
	n = steps_ctrl.value();

	// Tear down old cells
	for(i = 0; i < b.cells.size(); i++)
		std.free(b.cells[i].item);
	b.cells.clear();

	b.val = [];
	b.fo = [];
	b.fi = [];
	b.hold = [];
	b.hmode = [];

	// Column header strip: step number + the mode option control.
	// The header must be tall enough for the number label AND the full control,
	// otherwise only the top pixels of the control would be visible.
	b.header_row.clear_children();
	for(i = 0; i < n; i++) {
		col = b.header_row.widget().fixed_width(cell_w).fixed_height(header_h).layout(nanogui.layout_vertical());
		col.label(std.string(i + 1)).fixed_height(14).alignment("center");
		// Normal option button: the two modes are items of a combo control, so the
		// selection is a persistent state instead of a momentary button press.
		mode_ctrl = col.controlcombo("H" + std.string(i + 1), "hold_" + b.id + "_" + std.string(i));
		mode_ctrl.items(hold_mode_items).fixed_width(cell_w).fixed_height(hold_btn_h).hide_config_menu(true);
		mode_ctrl.callback([b, i](v) {
			set_hold_mode(b, i, std.int(v) == 1);
		});
		b.hold.push_back(false);
		b.hmode.push_back(mode_ctrl);
		mode_ctrl.value(0, false, false);
		b.cells.push_back([item=col]);
	}

	// Build one row of controlfloat cells for a given row id.
	build_row(b, row_name, n) {
		roww = b.rows[row_name];
		roww.clear_children();
		listref = b[row_name];
		listref.clear();
		for(i = 0; i < n; i++) {
			cf = roww.controlfloat(row_name + std.string(i + 1), b.id + "_" + row_name + "_" + std.string(i));
			cf.fixed_width(cell_w).fixed_height(row_h);
			listref.push_back(cf);
		}
	}

	build_row(b, "val", n);
	build_row(b, "fo", n);
	build_row(b, "fi", n);

	// Defaults for new cells: no fades at all (instant gate)
	for(i = 0; i < n; i++) {
		b.val[i].value(1.0);
		b.fo[i].value(0.0);
		b.fi[i].value(0.0);
	}
}

// Re-number the visible block containers consecutively (Output 1..N).
// Uses the current position in the block list, so the numbering never goes
// negative and never collides after a removal.
renumber_blocks() {
	for(i = 0; i < blocks.size(); i++) {
		b = blocks[i];
		b.num = i + 1;
		if(b.box != None)
			b.box.title("Output " + std.string(b.num));
	}
}

// Add a new block (a table on the shared grid + its own output slider).
// uid = stable unique id -> the control group ("out_B<uid>") can never collide
// with another block, even after removals. num = consecutive display number.
add_block(uid = -1) {
	if(uid < 0) {
		uid = block_next_id;
		block_next_id++;
	}
	else if(uid >= block_next_id)
		block_next_id = uid + 1;

	bid = "B" + uid;

	b = [id=bid, uid=uid, num=blocks.size() + 1, val=[], fo=[], fi=[], hold=[], hmode=[], cells=[], prev_out=0.0, out=None, box=None, pending_remove=0];

	block_box = block_list_area.collapsable("Output " + std.string(b.num)).expanded(true);
	b.box = block_box;
	inner = block_box.content().layout(nanogui.layout_vertical());

	b.header_row = inner.widget().fixed_height(header_h).anchor_left(0).layout(nanogui.layout_horizontal());

	b.val_row = inner.widget().fixed_height(row_h).anchor_left(0).layout(nanogui.layout_horizontal());
	b.fo_row = inner.widget().fixed_height(row_h).anchor_left(0).layout(nanogui.layout_horizontal());
	b.fi_row = inner.widget().fixed_height(row_h).anchor_left(0).layout(nanogui.layout_horizontal());

	b.rows = [header=b.header_row, val=b.val_row, fo=b.fo_row, fi=b.fi_row];

	// Output slider (Regler) for this block.
	// The control's full name is "Out@out_B<uid>" - the uid is never reused, so
	// it stays globally unique inside the node and is never affected by the
	// renumbering of the collapsable titles after a removal.
	out_row = inner.widget().fixed_height(24).anchor_left(0).anchor_right(0).layout(nanogui.layout_horizontal());
	inner.label("Value").fixed_width(cell_w);
	out = out_row.controlslider("Out", "out_" + bid);
	out.min(0).max(1).value(0.0);
	b.out = out;

	rebuild_block(b);

	blocks.push_back(b);
}

// Apply removals that were requested from button callbacks.
// Called from update() only - no widget event is on the stack there, so
// freeing the widgets actually works and the block disappears from the GUI.
flush_pending_rebuild() {
	if(pending_rebuild != true)
		return;

	for(i = blocks.size() - 1; i >= 0; i--) {
		b = blocks[i];
		if(b.pending_remove != 1)
			continue;
		// Free only the block's root container; it owns all child widgets
		// (cells, sliders, rows). Freeing children AND the box double-frees
		// and corrupts other blocks' controls.
		if(b.box != None)
			std.free(b.box);
		b.box = None;
		b.out = None;
		b.cells.clear();
		b.val.clear();
		b.fo.clear();
		b.fi.clear();
		b.hold.clear();
		b.hmode.clear();
		blocks.erase(i);
	}

	block_list_area.refresh_layout();
	renumber_blocks();
	pending_rebuild = false;
}

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	// Global step / bar controls
	top = area.widget().fixed_height(24).anchor_left(0).anchor_right(0).layout(nanogui.layout_horizontal());
	steps_ctrl = top.controlslider("Steps").min(1).max(16).value(4).fixed_width(110);
	bar_ctrl = top.controlslider("Bar").min(1).max(16).value(4).fixed_width(110);

	// Row legend labels
	top.widget().fixed_width(90).label("Value / FadeOut / FadeIn").fixed_height(24);

	add_btn = area.button("ADD BLOCK");
	del_btn = area.button("REMOVE BLOCK");

	// Scrollable stack of blocks
	vs = area.vscroll();
	block_list_area = vs.content().layout(nanogui.layout_vertical());
	steps_ctrl.callback([steps_ctrl]() {
		for(i = 0; i < blocks.size(); i++)
			rebuild_block(blocks[i]);
	});

	add_btn.on_click([]() {
		if(blocks.size() < 8)
			add_block();
	});

	// REMOVE must NOT destroy widgets from inside its own click callback:
	// the free is ignored there, so the block would stay visible in the GUI.
	// Only mark + hide here; the actual teardown happens in flush_pending_rebuild().
	del_btn.on_click([]() {
		if(blocks.size() == 0)
			return;
		b = blocks[blocks.size() - 1];
		if(b.pending_remove == 1)
			return;
		b.pending_remove = 1;
		// Stop the output immediately so the removed value is no longer driven.
		b.out = None;
		b.prev_out = 0.0;
		// Hide the whole block container right away (no widget free here).
		if(b.box != None)
			b.box.visible(false);
		pending_rebuild = true;
	});

	// Default blocks
	add_block();
}

update(generator, tl_pos, pos_delta) {
	flush_pending_rebuild();

	n = steps_ctrl.value();
	if(n < 1)
		n = 1;

	bar_len = bar_ctrl.value();
	if(bar_len < 0.001)
		bar_len = 0.001;
	step_dur = bar_len / std.float(n);

	// Position within the current bar (beats), 0..bar_len
	bar_pos = tl_pos - math.floor(tl_pos / bar_len) * bar_len;

	step = std.int(math.floor(bar_pos / step_dur));
	if(step >= n)
		step = n - 1;
	if(step < 0)
		step = 0;
	local = bar_pos - std.float(step) * step_dur;

	for(bi = 0; bi < blocks.size(); bi++) {
		b = blocks[bi];

		// Defensive: skip blocks whose output control was removed / invalidated.
		if(std.is_none(b.out))
			continue;

		// Guard against a block that has no cells (e.g. mid-rebuild)
		if(b.val.size() <= step) {
			b.out.value(b.prev_out);
			continue;
		}

		fi = b.fi[step].value();
		fo = b.fo[step].value();

		// Keep fade times within the step duration
		if(fi < 0.0)
			fi = 0.0;
		if(fo < 0.0)
			fo = 0.0;
		if(fi + fo > step_dur) {
			scale = (fi + fo > 0.0) ? step_dur / (fi + fo) : 1.0;
			fi = fi * scale;
			fo = fo * scale;
		}

		out_val = 0.0;
		if(b.hold[step]) {
			// HOLD: keep the previous output value, no gate.
			out_val = b.prev_out;
		}
		else {
			target = clamp01(b.val[step].value());
			hold_dur = step_dur - fi - fo;
			if(fi > 0.0 && local < fi) {
				// FadeIn from the previous value into the target.
				out_val = b.prev_out + (target - b.prev_out) * (local / fi);
			}
			else if(local < fi + hold_dur) {
				// Hold the target.
				out_val = target;
			}
			else {
				// FadeOut toward 0.
				rem = step_dur - local;
				frac = (fo > 0.0) ? (rem / fo) : 0.0;
				if(frac < 0.0)
					frac = 0.0;
				if(frac > 1.0)
					frac = 1.0;
				out_val = target * frac;
			}
			out_val = clamp01(out_val);
			b.prev_out = out_val;
		}

		b.out.value(out_val);
	}
}

save_state() {
	state = [steps=steps_ctrl.value(), bar=bar_ctrl.value(), blocks=[]];
	for(bi = 0; bi < blocks.size(); bi++) {
		b = blocks[bi];
		if(b.pending_remove == 1)
			continue;
		out_val = (b.out != None) ? b.out.value() : 0.0;
		rec = [uid=b.uid, val=[], fo=[], fi=[], hold=[], out=out_val];
		for(i = 0; i < b.val.size(); i++) {
			rec.val.push_back(b.val[i].value());
			rec.fo.push_back(b.fo[i].value());
			rec.fi.push_back(b.fi[i].value());
			rec.hold.push_back(b.hold[i]);
		}
		state.blocks.push_back(rec);
	}
	return state;
}

load_state(state) {
	if(state.has("bar"))
		bar_ctrl.value(state.bar);
	// Rebuild blocks from saved data (steps applied after, to size the cells).
	if(state.has("blocks")) {
		saved_steps = steps_ctrl.value();
		if(state.has("steps"))
			steps_ctrl.value(state.steps);

		// Tear down existing blocks (free root container of each block)
		for(bi = 0; bi < blocks.size(); bi++) {
			b = blocks[bi];
			if(b.box != None)
				std.free(b.box);
			b.out = None;
		}
		blocks.clear();
		block_list_area.refresh_layout();
		block_next_id = 0;
		pending_rebuild = false;

		for(bi = 0; bi < state.blocks.size(); bi++) {
			rec = state.blocks[bi];
			add_block(rec.has("uid") ? rec.uid : -1);
			b = blocks[blocks.size() - 1];
			for(i = 0; i < rec.val.size(); i++) {
				if(i < b.val.size()) {
					b.val[i].value(rec.val[i]);
					b.fo[i].value(rec.fo[i]);
					b.fi[i].value(rec.fi[i]);
					set_hold_mode(b, i, rec.hold[i] ? true : false);
				}
			}
			if(rec.has("out"))
				b.out.value(rec.out);
		}
	}
	else if(state.has("steps")) {
		steps_ctrl.value(state.steps);
		for(bi = 0; bi < blocks.size(); bi++)
			rebuild_block(blocks[bi]);
	}
}
