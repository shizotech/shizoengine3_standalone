// StepChaser generator (Utility)
// A step sequencer locked to the beat. Every bar (Bar length, in beats) is cut into Steps. For every step you set a
// Value or switch it to Hold (keep the output as it is). When a step starts, the block's output moves to the step
// value over the step's Fade in, and falls back to 0 over its Fade out at the end of the step.
//
// Blocks are stacked below each other, each one a collapsible table with its own Output. A table has a header row
// (step number + Change / Hold) and the rows Value, Fade out, Fade in; the columns are the steps and line up across
// blocks.
//
// Math/StepChaser is the other step chaser: one big grid, Free or Sync, a name per block, and Hold there keeps the
// last value that was set. Both stay, projects use both.
//
// Timing is Sync only (beat-locked): tl_pos is the timeline position in beats.
//
// Control IDs (saved projects, links): "Steps", "Bar", per block (uid u) "out_B<u>@Out" and per step i (from 0)
// "hold_B<u>_<i>@H<i+1>", "B<u>_val_<i>@val<i+1>", "B<u>_fo_<i>@fo<i+1>", "B<u>_fi_<i>@fi<i+1>".
import nanogui;

// Global controls
steps_ctrl = None;     // number of steps per bar
bar_ctrl = None;       // bar length in beats

// Block bookkeeping
// block_next_id is a MONOTONIC counter: it is never decremented, so control
// ids / group names stay unique and the displayed numbering can never go
// backwards or collide with an existing block after a removal.
block_next_id = 0;
blocks = [];           // list of block records (json)
managed block_list_area = None;
max_blocks = 8;

// Deferred teardown request.
// IMPORTANT (crash / ghost-widget safety):
//   No widget may be freed inside a callback of a widget that is currently
//   dispatching an event - the free is ignored there and the block stays
//   visible in the GUI. Removal therefore only marks the block (and stops its
//   output right away); the real teardown runs at the top of update().
pending_rebuild = false;

// ---- Table cell layout constants ----
cell_w = 70;           // width of a step cell (columns align across blocks)
row_h = 28;            // height of a value row
label_w = 72;          // the row names in front of the cells (Value, Fade out, Fade in)
header_h = 48;         // height of the step header (number + mode control)
hold_btn_h = 28;       // height of the Change / Hold control

// A cell of a row cut into n equal parts, with a 4 px gap to the next cell. The control in it fills it.
row_cell(row, i, n) {
	l = std.float(i) / std.float(n);
	r = std.float(n - 1 - i) / std.float(n);
	return row.widget().anchor_top(0).anchor_bottom(0).anchor_left(l, "percent").anchor_right(r, "percent");
}
cell_gap(i, n) {
	return (i < n - 1) ? 4 : 0;
}

// The number of steps as a whole number, 1..16. Steps is a slider, so its value can lie between two numbers
// (before #436 a value like 4.4 made 5 columns but timed the bar as 4.4 steps).
steps_count() {
	n = std.int(math.round(steps_ctrl.value()));
	if(n < 1)
		n = 1;
	if(n > 16)
		n = 16;
	return n;
}

// Clamp a value into [0, 1].
clamp01(v) {
	if(v < 0.0)
		return 0.0;
	if(v > 1.0)
		return 1.0;
	return v;
}

// ---- Hold mode (Change / Hold) ----
// The mode is stored per step in b.hold[i]; the UI widget is a normal option
// control (controlcombo) with the two modes as items, so it never springs back
// like a momentary button would. These helpers keep data and UI in sync.
hold_mode_items = ["Change", "Hold"]; //index-based (0 = change, 1 = hold)

// Set the hold mode of one step and update the option control (no callback loop).
set_hold_mode(b, i, on) {
	if(i >= b.hold.size())
		return;
	b.hold[i] = on ? true : false;
	if(i < b.hmode.size())
		b.hmode[i].value(on ? 1 : 0, false, false);
}

// Rebuild the step columns of a block whenever the number of steps changes. The values of the steps that stay are
// kept (before #436 every step went back to the defaults, also when the slider only moved a little).
rebuild_block(b) {
	n = steps_count();

	// Remember the current values
	old_val = [];
	old_fo = [];
	old_fi = [];
	old_hold = [];
	for(i = 0; i < b.val.size(); i++) {
		old_val.push_back(b.val[i].value());
		old_fo.push_back(b.fo[i].value());
		old_fi.push_back(b.fi[i].value());
		old_hold.push_back((i < b.hold.size()) ? b.hold[i] : false);
	}

	// Tear down old cells
	for(i = 0; i < b.cells.size(); i++)
		std.free(b.cells[i].item);
	b.cells.clear();

	b.val = [];
	b.fo = [];
	b.fi = [];
	b.hold = [];
	b.hmode = [];
	b.steps = n;

	// Column header strip: step number + the mode option control.
	// The header must be tall enough for the number label AND the full control,
	// otherwise only the top pixels of the control would be visible.
	b.header_row.clear_children();
	b.header_row.label("Step").fixed_width(label_w).alignment("left");
	for(i = 0; i < n; i++) {
		col = b.header_row.widget().fixed_width(cell_w).fixed_height(header_h).layout(nanogui.layout_vertical());
		col.label(std.string(i + 1)).fixed_height(14).alignment("center");
		// A combo with the two modes, so the choice is a state (not a momentary button press).
		mode_ctrl = col.controlcombo("H" + std.string(i + 1), "hold_" + b.id + "_" + std.string(i)).caption("Step " + std.string(i + 1)).tooltip("Change: this step plays its Value. Hold: the output stays as it is during this step");
		mode_ctrl.items(hold_mode_items).fixed_width(cell_w).fixed_height(hold_btn_h).hide_config_menu(true);
		mode_ctrl.callback([b, i](v) {
			set_hold_mode(b, i, std.int(v) == 1);
		});
		b.hold.push_back(false);
		b.hmode.push_back(mode_ctrl);
		mode_ctrl.value(0, false, false);
		b.cells.push_back([item=col]);
	}

	// Build one row of controlfloat cells for a given row id.
	build_row(b, row_name, row_caption, row_unit, row_tooltip, n) {
		roww = b.rows[row_name];
		roww.clear_children();
		roww.label(row_caption).fixed_width(label_w).alignment("left");
		listref = b[row_name];
		listref.clear();
		for(i = 0; i < n; i++) {
			cf = roww.controlfloat(row_name + std.string(i + 1), b.id + "_" + row_name + "_" + std.string(i)).caption(row_caption + " " + std.string(i + 1)).tooltip(row_tooltip);
			cf.fixed_width(cell_w).fixed_height(row_h);
			if(row_unit != "")
				cf.unit(row_unit);
			listref.push_back(cf);
		}
	}

	build_row(b, "val", "Value", "", "The value this step goes to, 0 to 1", n);
	build_row(b, "fo", "Fade out", "", "How many [[beat|beats]] the output takes to fall back to 0 at the end of this step", n); //no unit in a 70 px cell: it left no room for the number
	build_row(b, "fi", "Fade in", "", "How many [[beat|beats]] the output takes to reach the value of this step at its start", n);

	// Values: the old ones where there were steps, else the defaults (no fades at all: an instant gate)
	for(i = 0; i < n; i++) {
		if(i < old_val.size()) {
			b.val[i].value(old_val[i]);
			b.fo[i].value(old_fo[i]);
			b.fi[i].value(old_fi[i]);
			set_hold_mode(b, i, old_hold[i] ? true : false);
		}
		else {
			b.val[i].value(1.0);
			b.fo[i].value(0.0);
			b.fi[i].value(0.0);
		}
	}
}

// Re-number the visible block containers consecutively (Output 1..N).
// Uses the current position in the block list, so the numbering never goes
// negative and never collides after a removal.
renumber_blocks() {
	for(i = 0; i < blocks.size(); i++) {
		b = blocks[i];
		b.num = i + 1;
		if(b.box != None)
			b.box.title("Output " + std.string(b.num));
	}
}

// Add a new block (a table on the shared grid + its own output slider).
// uid = stable unique id -> the control group ("out_B<uid>") can never collide
// with another block, even after removals. num = consecutive display number.
add_block(uid = -1) {
	if(uid < 0) {
		uid = block_next_id;
		block_next_id++;
	}
	else if(uid >= block_next_id)
		block_next_id = uid + 1;

	bid = "B" + uid;

	b = [id=bid, uid=uid, num=blocks.size() + 1, val=[], fo=[], fi=[], hold=[], hmode=[], cells=[], steps=0, prev_out=0.0, out=None, box=None, pending_remove=0];

	block_box = block_list_area.collapsable("Output " + std.string(b.num)).expanded(true);
	b.box = block_box;
	inner = block_box.content().layout(nanogui.layout_vertical());

	b.header_row = inner.widget().fixed_height(header_h).anchor_left(0).layout(nanogui.layout_horizontal());

	b.val_row = inner.widget().fixed_height(row_h).anchor_left(0).layout(nanogui.layout_horizontal());
	b.fo_row = inner.widget().fixed_height(row_h).anchor_left(0).layout(nanogui.layout_horizontal());
	b.fi_row = inner.widget().fixed_height(row_h).anchor_left(0).layout(nanogui.layout_horizontal());

	b.rows = [header=b.header_row, val=b.val_row, fo=b.fo_row, fi=b.fi_row];

	// Output of this block.
	// The control's full name is "out_B<uid>@Out" - the uid is never reused, so
	// it stays globally unique inside the node and is never affected by the
	// renumbering of the collapsable titles after a removal.
	out = inner.controlslider("Out", "out_" + bid).caption("Output").tooltip("The output of this block, 0 to 1. A [[pure output]]: [[link]] it into what should follow the steps\n[[wiki:Assets#generators--utility]]");
	out.min(0).max(1).value(0.0).as_output(true);
	b.out = out;

	rebuild_block(b);

	blocks.push_back(b);
}

// Apply removals that were requested from button callbacks.
// Called from update() only - no widget event is on the stack there, so
// freeing the widgets actually works and the block disappears from the GUI.
flush_pending_rebuild() {
	if(pending_rebuild != true)
		return;

	for(i = blocks.size() - 1; i >= 0; i--) {
		b = blocks[i];
		if(b.pending_remove != 1)
			continue;
		// Free only the block's root container; it owns all child widgets
		// (cells, sliders, rows). Freeing children AND the box double-frees
		// and corrupts other blocks' controls.
		if(b.box != None)
			std.free(b.box);
		b.box = None;
		b.out = None;
		b.cells.clear();
		b.val.clear();
		b.fo.clear();
		b.fi.clear();
		b.hold.clear();
		b.hmode.clear();
		blocks.erase(i);
	}

	block_list_area.refresh_layout();
	renumber_blocks();
	pending_rebuild = false;
}

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	// [ Steps | Bar length ]
	top = area.widget().fixed_height(28).anchor_left(0).anchor_right(0).fixed_width(240);
	steps_ctrl = row_cell(top, 0, 2).controlslider("Steps").tooltip("Into how many steps the bar is cut, 1 to 16").min(1).max(16).value(4).decimals(0).anchor(0).anchor_right(cell_gap(0, 2));
	bar_ctrl = row_cell(top, 1, 2).controlslider("Bar").caption("Bar length").unit("beats").tooltip("How many [[beat|beats]] one bar lasts. The chaser follows the [[timeline]]").min(1).max(16).value(4).anchor(0);

	// [ Add output | Remove output ]
	btn_row = area.widget().fixed_height(28).anchor_left(0).anchor_right(0).fixed_width(240);
	add_btn = row_cell(btn_row, 0, 2).button("Add output").icon(nanogui.icon("plus")).tooltip("Another block of steps with its own output, up to 8\n[[wiki:Assets#generators--utility]]").anchor(0).anchor_right(cell_gap(0, 2));
	del_btn = row_cell(btn_row, 1, 2).button("Remove output").icon(nanogui.icon("minus")).tooltip("Removes the last block").danger("hover").anchor(0);

	// Scrollable stack of blocks
	vs = area.vscroll();
	block_list_area = vs.content().layout(nanogui.layout_vertical());
	// Rebuild only when the whole number of steps changes (the slider calls this on every move)
	steps_ctrl.callback([steps_ctrl](v) { // the control passes its value (#203: without it, "Too many params" and no rebuild)
		n = steps_count();
		for(i = 0; i < blocks.size(); i++) {
			if(blocks[i].steps != n)
				rebuild_block(blocks[i]);
		}
	});

	add_btn.on_click([]() {
		if(blocks.size() < max_blocks)
			add_block();
	});

	// REMOVE must NOT destroy widgets from inside its own click callback:
	// the free is ignored there, so the block would stay visible in the GUI.
	// Only mark + hide here; the actual teardown happens in flush_pending_rebuild().
	del_btn.on_click([]() {
		if(blocks.size() == 0)
			return;
		b = blocks[blocks.size() - 1];
		if(b.pending_remove == 1)
			return;
		b.pending_remove = 1;
		// Stop the output immediately so the removed value is no longer driven.
		b.out = None;
		b.prev_out = 0.0;
		// Hide the whole block container right away (no widget free here).
		if(b.box != None)
			b.box.visible(false);
		pending_rebuild = true;
	});

	// Default blocks
	add_block();
}

update(generator, tl_pos, pos_delta) {
	flush_pending_rebuild();

	n = steps_count();

	bar_len = bar_ctrl.value();
	if(bar_len < 0.001)
		bar_len = 0.001;
	step_dur = bar_len / std.float(n);

	// Position within the current bar (beats), 0..bar_len
	bar_pos = tl_pos - math.floor(tl_pos / bar_len) * bar_len;

	step = std.int(math.floor(bar_pos / step_dur));
	if(step >= n)
		step = n - 1;
	if(step < 0)
		step = 0;
	local = bar_pos - std.float(step) * step_dur;

	for(bi = 0; bi < blocks.size(); bi++) {
		b = blocks[bi];

		// Defensive: skip blocks whose output control was removed / invalidated.
		if(std.is_none(b.out))
			continue;

		// Guard against a block that has no cells (e.g. mid-rebuild)
		if(b.val.size() <= step) {
			b.out.value(b.prev_out);
			continue;
		}

		fi = b.fi[step].value();
		fo = b.fo[step].value();

		// Keep fade times within the step duration
		if(fi < 0.0)
			fi = 0.0;
		if(fo < 0.0)
			fo = 0.0;
		if(fi + fo > step_dur) {
			scale = (fi + fo > 0.0) ? step_dur / (fi + fo) : 1.0;
			fi = fi * scale;
			fo = fo * scale;
		}

		out_val = 0.0;
		if(b.hold[step]) {
			// Hold: keep the previous output value, no gate.
			out_val = b.prev_out;
		}
		else {
			target = clamp01(b.val[step].value());
			hold_dur = step_dur - fi - fo;
			if(fi > 0.0 && local < fi) {
				// Fade in from the previous value into the target.
				out_val = b.prev_out + (target - b.prev_out) * (local / fi);
			}
			else if(local < fi + hold_dur) {
				// Hold the target.
				out_val = target;
			}
			else {
				// Fade out toward 0.
				rem = step_dur - local;
				frac = (fo > 0.0) ? (rem / fo) : 0.0;
				if(frac < 0.0)
					frac = 0.0;
				if(frac > 1.0)
					frac = 1.0;
				out_val = target * frac;
			}
			out_val = clamp01(out_val);
			b.prev_out = out_val;
		}

		b.out.value(out_val);
	}
}

save_state() {
	state = [steps=steps_ctrl.value(), bar=bar_ctrl.value(), blocks=[]];
	for(bi = 0; bi < blocks.size(); bi++) {
		b = blocks[bi];
		if(b.pending_remove == 1)
			continue;
		out_val = (b.out != None) ? b.out.value() : 0.0;
		rec = [uid=b.uid, val=[], fo=[], fi=[], hold=[], out=out_val];
		for(i = 0; i < b.val.size(); i++) {
			rec.val.push_back(b.val[i].value());
			rec.fo.push_back(b.fo[i].value());
			rec.fi.push_back(b.fi[i].value());
			rec.hold.push_back(b.hold[i]);
		}
		state.blocks.push_back(rec);
	}
	return state;
}

load_state(state) {
	if(state.has("bar"))
		bar_ctrl.value(state.bar);
	// Rebuild blocks from saved data (steps applied after, to size the cells).
	if(state.has("blocks")) {
		saved_steps = steps_ctrl.value();
		if(state.has("steps"))
			steps_ctrl.value(state.steps);

		// Tear down existing blocks (free root container of each block)
		for(bi = 0; bi < blocks.size(); bi++) {
			b = blocks[bi];
			if(b.box != None)
				std.free(b.box);
			b.out = None;
		}
		blocks.clear();
		block_list_area.refresh_layout();
		block_next_id = 0;
		pending_rebuild = false;

		for(bi = 0; bi < state.blocks.size(); bi++) {
			rec = state.blocks[bi];
			add_block(rec.has("uid") ? rec.uid : -1);
			b = blocks[blocks.size() - 1];
			for(i = 0; i < rec.val.size(); i++) {
				if(i < b.val.size()) {
					b.val[i].value(rec.val[i]);
					b.fo[i].value(rec.fo[i]);
					b.fi[i].value(rec.fi[i]);
					set_hold_mode(b, i, rec.hold[i] ? true : false);
				}
			}
			if(rec.has("out"))
				b.out.value(rec.out);
		}
	}
	else if(state.has("steps")) {
		steps_ctrl.value(state.steps);
		for(bi = 0; bi < blocks.size(); bi++)
			rebuild_block(blocks[bi]);
	}
}
