//A generator written as a class (#202): the contract in engine/contracts/generator_module.shio, see its README.md.
//
//The asset exports create(generator, node). The engine checks the object it returns against the contract when the
//asset loads (a missing method is an error in the log then, not in a frame), sets generator / node and calls build().
//Every method but build() is optional; hooks() names the ones the engine calls every frame.
//
//It follows the rules of the other generators (design/README.md): a caption and a tooltip on every control, values with
//units, a segmented control for a short list, the output flagged as a pure output.

#include "engine/contracts/generator_module"

import nanogui;

class ExampleWave : GeneratorModule
{
	freq = None;
	out = None;
	shape = None;
	phase = 0.0;

	build(generator, node) {
		node.layout(nanogui.layout_vertical());
		//widget.control* controls: a unique name (+ group) within this node, saved and linked by the engine.
		//The name is the ID and never changes; .caption("…") changes what the user reads.
		shape = node.controlcombo("Shape").tooltip("Sine: a round wave. Square: on or off");
		shape.items(["Sine", "Square"]).segmented(true); //index-based (0 = sine, 1 = square): the order stays
		freq = node.controlslider("Frequency").unit("per beat").value(0.25).tooltip("How many waves per [[beat]]");
		//The module writes it every frame: a pure output (no input notch, nothing can be linked into it)
		out = node.controlslider("Output").as_output(true).tooltip("The wave, from 0 to 1. A [[pure output]]: [[link]] it into what should move\n[[wiki:Assets#generators--math]]");
	}

	//The module's own data: what the controls do not keep (they are saved by the engine). Here where the wave is.
	save_state() {
		return [phase = phase];
	}

	load_state(state) {
		if(!state)
			return;
		if(state.has("phase"))
			phase = state.phase;
		//Projects before #436 kept the shape here (a primitive list then)
		if(state.has("shape"))
			shape.value(state.shape);
	}

	hooks() {
		return ["update"];
	}

	update(tl_pos, delta) {
		phase += delta * freq.value();
		phase -= math.floor(phase); //0..1, no precision lost after hours
		v = math.sin(phase * 2.0 * math.PI);
		if(shape.value() == 1)
			v = v >= 0 ? 1.0 : -1.0;
		out.value(0.5 + v / 2.0);
	}

	//The output for the routing of other views (a command of GENERATOR_COMMANDS, as a method of the mixin VideoIO
	//would be; here without the mixin, the default dispatch() finds it by name)
	get_default_output() {
		return out;
	}
}

create(generator, node) {
	return ExampleWave();
}
