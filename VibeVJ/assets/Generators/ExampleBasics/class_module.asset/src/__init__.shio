//A generator written as a class (#202): the contract in engine/contracts/generator_module.shio, see its README.md.
//
//The asset exports create(generator, node). The engine checks the object it returns against the contract when the
//asset loads (a missing method is an error in the log then, not in a frame), sets generator / node and calls build().
//Every method but build() is optional; hooks() names the ones the engine calls every frame.

#include "engine/contracts/generator_module"

import nanogui;

class ExampleWave : GeneratorModule
{
	freq = None;
	out = None;
	shape = None;   //a primitive control: not saved by the link system, so the module saves it itself
	phase = 0.0;

	build(generator, node) {
		node.layout(nanogui.layout_vertical());
		//widget.control* controls: a unique name (+ group) within this node, saved and linked by the engine
		freq = node.controlslider("Frequency").unit("per beat").value(0.25);
		out = node.controlslider("Output").as_output(true);
		shape = node.combobox().items(["Sine", "Square"]).selected(0);
	}

	//The module's own data: what the controls do not keep
	save_state() {
		return [shape = shape.selected()];
	}

	load_state(state) {
		if(state && state.has("shape"))
			shape.selected(state.shape);
	}

	hooks() {
		return ["update"];
	}

	update(tl_pos, delta) {
		phase += delta * freq.value();
		v = math.sin(phase * 2.0 * math.PI);
		if(shape.selected() == 1)
			v = v >= 0 ? 1.0 : -1.0;
		out.value(0.5 + v / 2.0);
	}

	//The output for the routing of other views (a command of GENERATOR_COMMANDS, as a method of the mixin VideoIO
	//would be; here without the mixin, the default dispatch() finds it by name)
	get_default_output() {
		return out;
	}
}

create(generator, node) {
	return ExampleWave();
}
