
import nanogui;

using nanogui; //To expose nvg* functions
using eigen; //For vec2f etc

entry(generator, area) {
	shader = area.shader().anchor(3);
	shader.render_draw([]() {
		nvgBeginPath();
		nvgRect(vec2f(8,8), vec2f(48,48));   // coordinates = output texture pixels
		nvgFillColor(vec4f(0,1,0,1));
		nvgFill();
	});
}

save_state() {
	return [];
}

load_state(state) {
	
}