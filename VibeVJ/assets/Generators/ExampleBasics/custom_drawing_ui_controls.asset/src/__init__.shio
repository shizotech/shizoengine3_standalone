
import nanogui;

//To expose nanogui.nvg* nanovg functions globally
using nanogui;

//For vec2f etc
using eigen;

entry(generator, area) {
	
	//UI Controls are split into primitive UI controls, which are static and should only be used for functions where the global routing system wouldnt make sense
	//e.g.
	//area.button();
	//area.slider();
	//area.combobox();
	//Those also need to be serialized as they are not saved!
	
	//Most of the time you want to use "midicontrols"
	//area.controlslider(...);
	//area.controlint(...);
	//area.controlcombo(...);
	//These controls are the standard in this program and are MIDI-mappable and linkable controls
	//They are also auto-serialized so there is no need to save them, they will be set to their saved value automatically when a project is loaded.
	
	// You can use widgets to draw custom controls
	custom_control = area.widget();
	custom_control.on_draw([](){
		//Use nanogui.nvg* functions
	});
	
	//use this in combination with
	//custom_control.on_mouse(...) ... etc to create fully custom interactive UI controls

	
	// Draw on a shader if you need it rendered as routable video output.	
	shader = area.shader().anchor(3);
	shader.render_draw([]() {
		nvgBeginPath();
		nvgRect(vec2f(8,8), vec2f(48,48));   // coordinates = output texture pixels
		nvgFillColor(vec4f(0,1,0,1));
		nvgFill();
	});
	
	//Dont forget to add a controlio to make it routable...
	ctrl_out = area.control("OUT").value(shader);
	ctrl_out.callback([ctrl_out, shader](v) {
		//Reset when something tries to change it...
		ctrl_out.value(shader);
	});
}

save_state() {
	return [];
}

load_state(state) {
	
}