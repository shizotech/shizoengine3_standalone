
import nanogui;

//To expose nanogui.nvg* nanovg functions globally
using nanogui;

//For vec2f etc
using eigen;

shader = None;

ctrl_out = None;

//Know how:
//- each nanogui widget has an ".attr" field which can be used to store arbitrary data inside a widget itself (convenience function)
//- For example widget.attr.some_state = "Active";

//Dispatcher is used for various host-client interactions
dispatcher(generator, cmd, value) {
	
	//Proven pattern
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return None;
		
		shader.rendering_enabled(value); //Disable rendering
		return None;
	}

	if(cmd == "get_default_output") //This is used in the clipview for shader routing
		return ctrl_out; //Return the midicontrol instead of the shader itself (as per protocol) so the value can be fetched dynamically when it changes
		
	//Maybe also add "get_default_input" should also be a midicontrol
}

entry(generator, area) {
	
	generator.window.fixed_size(vec2i(400,600));
	
	area.layout(None);
	
	//UI Controls are split into primitive UI controls, which are static and should only be used for functions where the global routing system wouldnt make sense
	
	//All nanogui UI widgets are member functions of nanogui.widget
	
	//---Primitive--- (non-permanent state controls)
	
	//Those also need to be serialized as they are not saved!
	//Split widget
	primitive_ctrls_area = area.widget().anchor(0).anchor_bottom(0.5, "percent");
	primitive_ctrls_area.layout(nanogui.layout_vertical());
	prim_btn = primitive_ctrls_area.button("Add Magic");
	prim_btn2 = primitive_ctrls_area.pushbutton("Enable Magic");
	
	//Look up each widget to get the exact callbacks that the widget supports, as their names can differ between different widget types.
	prim_btn.on_click([]() {
		std.print("Clicked!");
	});
	
	prim_btn2.on_change([](v) {
		std.print("Changed: " + v);
	});
	
	prim_splitter = primitive_ctrls_area.widget().fixed_height(30);
	prim_splitter.button("Left").anchor(0).anchor_right(0.5, "percent");
	prim_splitter.button("Right").anchor(0).anchor_left(0.5, "percent");
	
	prim_slider = primitive_ctrls_area.slider("Coolness");
	prim_combo = primitive_ctrls_area.combobox().items(["One", "Two", "Three"]);
	prim_label = primitive_ctrls_area.label("Hello world");
	
	//More advanced stuff
	prim_collapse = primitive_ctrls_area.collapsable("I can be expanded");
	prim_collapse.content().layout(nanogui.layout_vertical());
	prim_collapse.button("One"); //prim_collapse has a content_widget, it will be automatically assigned to it.
	prim_collapse.button("Two");
	prim_collapse.button("Three");
	
	//There is also widget.vscroll() widget.hscroll() widget.tabwidget() and widget.scrollarea() which work similarly.
	
	//---Engine Controls--- (permanent state controls)
	
	//Most of the time you want to use "midicontrols", which are for persistent state settings.
	
	//IMPORTANT: Each midicontrol must be UNIQUE (name+group), there CANNOT be two controls with the same name+group within the same modmatrixnode (globally or within different modmatrixnode parents its ok)
	//Use the widget.control(name,group) group parameter to give them unique identities and group logical controls
	
	midi_ctrls_area = area.widget().anchor(0).anchor_top(0.5, "percent");
	midi_ctrls_area.layout(nanogui.layout_vertical());

	slid1 = midi_ctrls_area.controlslider("Slider1", "group1");
	slid2 = midi_ctrls_area.controlslider("Slider2", "group1");
	
	second_slid1 = midi_ctrls_area.controlslider("Slider1", "group2");
	second_slid2 = midi_ctrls_area.controlslider("Slider2", "group2");

	//For dynamic controls you can generate a hash with std.random_hash() for example, or set group by some index.
	//Just make sure that the control when its loaded gets the same name/group !
	
	//The name is visible in the UI as the controls name, but you can leave the "internal" name as is and change the display name with
	//control.display_name(...)
	
	shader_split = midi_ctrls_area.widget().fixed_height(200);
	
	//---CUSTOM CONTROLS---
	
	//You can use widgets to draw custom controls using nanovg (most nanovg functions are available in the "nanogui" namespace.
	//You can use them directly with 'using nanogui'
	
	custom_control = shader_split.widget();
	custom_control.anchor(0).anchor_right(0.5, "percent");
	custom_control.on_draw([custom_control](){
		//Use nanogui.nvg* functions
		nvgBeginPath();
		nvgRect(vec2f(0,0), custom_control.size());   // coordinates = output texture pixels
		nvgFillColor(vec4f(0,1,0,1));
		nvgFill();
		
		//Can also use nvgText etc (check docs)...
	});
	
	//Can also add custom button handlers...
	custom_control.on_mouse_button([](pos, btn, down, mod) {
		std.print(pos); //Pos on the widget itself
		std.print(btn);
		std.print(down);
		std.print(mod);
		
		//!!! Note the "left mouse button" is btn==0, the right mouse button is btn==1
		
		return true; //Mark consumed, can also call return mouse_button_default(pos, btn, down, mod); To run the default handler.
	});
	
	custom_control.on_mouse_drag([](pos, rel, btn, mod) {
		std.print(pos);
		std.print(rel);
		std.print(btn);
		std.print(mod);
		
		//!!! Note the "left mouse button" is btn==1, the right mouse button is btn==2 here (which are button flags for this function)
		
		return true; //Mark consumed, can also call return mouse_button_default(pos, btn, down, mod); To run the default handler.
	});
	
	//There is also on_mouse_motion and more callbacks in the "widget" baseclass.
	
	//---VIDEO ENGINE AND VISUAL ASSETS---

	// Draw with nanovg on a shader if you need it rendered as routable video output (e.g. for text etc), and not just on the UI for widget controls.	
	shader = shader_split.shader();
	shader.anchor(0).anchor_left(0.5, "percent");
	
	//Note this is currently called AFTER the shader pass (like an overlay)
	//So there is currently no way to read back the rendered nanovg in the fragment shader, but you can still use a second shader and route them if you wish to do so.
	//Shader widgets have "input()" which accepts other shaders to set uniform sampler2D inputs.
	
	shader.render_draw([shader]() {
		rs = shader.render_size();
		rs = vec2f(rs.x, rs.y); //render_size returns vec2i, however the nanovg functions currently ONLY accept vec2f, which is why we need to convert...
		nvgBeginPath();
		nvgRect(vec2f(0,0), rs);   // coordinates = output texture pixels
		nvgFillColor(vec4f(1,0,0,1));
		nvgFill();
	});
	
	//!!! NOTE
	//use shader.keep_aspect_ratio(false); to stretch the shader to the widget size
	//If you dont want that, you have to calculate the actual point on the shader in mouse callbacks based on the aspect ratio of the rendersize.
	//Because the shader widget auto fits the shader into the widgets dimension while keeping the aspect ratio (letterboxing) so keep that in mind.
	
	//Dont forget to add a controlio to make it routable inside the program...
	ctrl_out = area.control("OUT").value(shader).as_output(true);
	ctrl_out.callback([ctrl_out, shader](v) {
		//Reset when something tries to change it...
		ctrl_out.value(shader);
	});
}

