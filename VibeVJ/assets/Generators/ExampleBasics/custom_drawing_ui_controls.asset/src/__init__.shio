//Example for asset authors (assets/ASSET_GUIDE.MD): primitive widgets, link system controls (widget.control*), a
//custom drawn control and a shader drawn with nanovg. It follows the rules of the other generators (design/README.md):
//captions in sentence case, a tooltip on every control, colours from the theme, 28 px rows.

import nanogui;

//To expose nanogui.nvg* nanovg functions globally
using nanogui;

//For vec2f etc
using eigen;

ROW = 28;
GAP = 4;

shader = None;

ctrl_out = None;

//Know how:
//- each nanogui widget has an ".attr" field which can be used to store arbitrary data inside a widget itself (convenience function)
//- For example widget.attr.some_state = "Active";

//Dispatcher is used for various host-client interactions
dispatcher(generator, cmd, value) {

	//Proven pattern
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return None;

		shader.rendering_enabled(value); //Disable rendering
		return None;
	}

	if(cmd == "get_default_output") //This is used in the clipview for shader routing
		return ctrl_out; //Return the midicontrol instead of the shader itself (as per protocol) so the value can be fetched dynamically when it changes

	//Maybe also add "get_default_input" should also be a midicontrol
}

//Colours come from the theme, never typed in: {r,g,b,a} 0..1 per key (on_color, accent_color, cue_color, danger_color,
//text_color, text_secondary_color, disabled_text_color, value_fill_color, input_fill, panel_fill, border_light).
//The fallback is the token default (design/tokens.json) for a theme without the key.
theme_color(t, key, fallback) {
	if(t && t.has(key)) {
		c = t[key];
		return vec4f(c.r, c.g, c.b, c.a);
	}
	return fallback;
}

entry(generator, area) {

	generator.window.fixed_size(vec2i(420, 640));

	area.layout(None);

	//Read the theme once here; the draw callbacks get the colours by value (see on_draw below)
	t = area.theme().to_json();
	c_field = theme_color(t, "input_fill", vec4f(14 / 255.0, 14 / 255.0, 15 / 255.0, 1.0));
	c_grid = theme_color(t, "border_light", vec4f(1.0, 1.0, 1.0, 0.16));
	c_accent = theme_color(t, "accent_color", vec4f(157 / 255.0, 133 / 255.0, 255 / 255.0, 1.0));

	//UI Controls are split into primitive UI controls, which are static and should only be used for functions where the global routing system wouldnt make sense

	//All nanogui UI widgets are member functions of nanogui.widget

	//---Primitive--- (non-permanent state controls)

	//Those also need to be serialized as they are not saved!
	//The upper 40 % of the window. In a vertical layout leave the controls at their default height
	primitive_ctrls_area = area.widget().anchor(0).anchor_bottom(0.6, "percent");
	primitive_ctrls_area.layout(nanogui.layout_vertical().spacing(GAP));
	//Buttons say what happens, in sentence case. Every control has a tooltip
	prim_btn = primitive_ctrls_area.button("Add magic").tooltip("A primitive button: prints to the log when clicked");
	prim_btn2 = primitive_ctrls_area.pushbutton("Enable magic").tooltip("A primitive toggle: prints its state to the log");

	//Look up each widget to get the exact callbacks that the widget supports, as their names can differ between different widget types.
	prim_btn.on_click([]() {
		std.print("Clicked!");
	});

	prim_btn2.on_change([](v) {
		std.print("Changed: " + v);
	});

	//A row of 28 px split in two halves that fill it: percent anchors for the halves, pixel anchors inside them for the gap
	//(an edge has one anchor, a second call replaces the first)
	prim_splitter = primitive_ctrls_area.widget().fixed_height(ROW);
	left_half = prim_splitter.widget().anchor(0).anchor_right(0.5, "percent");
	right_half = prim_splitter.widget().anchor(0).anchor_left(0.5, "percent");
	left_half.button("Left").tooltip("The left half of a row").anchor(0).anchor_right(GAP / 2);
	right_half.button("Right").tooltip("The right half of a row").anchor(0).anchor_left(GAP / 2);

	prim_slider = primitive_ctrls_area.slider("Coolness").tooltip("A primitive slider: not saved, not linkable");
	prim_combo = primitive_ctrls_area.combobox().items(["One", "Two", "Three"]).tooltip("A primitive list");
	prim_label = primitive_ctrls_area.label("Hello world");

	//More advanced stuff
	prim_collapse = primitive_ctrls_area.collapsable("I can be expanded");
	prim_collapse.content().layout(nanogui.layout_vertical().spacing(GAP));
	prim_collapse.button("One").tooltip("A button in a section"); //prim_collapse has a content_widget, it will be automatically assigned to it.
	prim_collapse.button("Two").tooltip("A button in a section");
	prim_collapse.button("Three").tooltip("A button in a section");

	//There is also widget.vscroll() widget.hscroll() widget.tabwidget() and widget.scrollarea() which work similarly.

	//---Engine Controls--- (permanent state controls)

	//Most of the time you want to use "midicontrols", which are for persistent state settings.

	//IMPORTANT: Each midicontrol must be UNIQUE (name+group), there CANNOT be two controls with the same name+group within the same modmatrixnode (globally or within different modmatrixnode parents its ok)
	//Use the widget.control(name,group) group parameter to give them unique identities and group logical controls

	midi_ctrls_area = area.widget().anchor(0).anchor_top(0.4, "percent");
	midi_ctrls_area.layout(nanogui.layout_vertical().spacing(GAP));

	//The name (first argument) is the ID: saved projects, links and MIDI mappings use it, so it never changes.
	//What the user reads is the caption: .caption("…") changes the visible text, the ID stays.
	slid1 = midi_ctrls_area.controlslider("Slider1", "group1").caption("Speed").unit("per beat").tooltip("A link system control with a unit: saved with the project, linkable, MIDI mappable");
	slid2 = midi_ctrls_area.controlslider("Slider2", "group1").caption("Level").tooltip("A link system control without a unit, 0 to 1");

	second_slid1 = midi_ctrls_area.controlslider("Slider1", "group2").caption("Delay").unit("beats").tooltip("The same name as Speed, another group: a control of its own");
	second_slid2 = midi_ctrls_area.controlslider("Slider2", "group2").caption("Mix").value_word(0, "Off").tooltip("0 is shown as Off: a sentinel value as a word");

	//For dynamic controls you can generate a hash with std.random_hash() for example, or set group by some index.
	//Just make sure that the control when its loaded gets the same name/group !

	//A row the module writes itself every frame (an LFO's Output) is a pure output: .as_output(true), no input notch

	shader_split = midi_ctrls_area.widget().fixed_height(180);

	//---CUSTOM CONTROLS---

	//You can use widgets to draw custom controls using nanovg (most nanovg functions are available in the "nanogui" namespace.
	//You can use them directly with 'using nanogui'

	custom_control = shader_split.widget().anchor(0).anchor_right(0.5, "percent")
		.widget().anchor(0).anchor_right(GAP / 2); //the left half, with a gap to the shader
	custom_control.tooltip("A control drawn with nanovg: click or drag to move the point");
	custom_control.attr.point = [x = 0.5, y = 0.5];

	//on_draw runs on the render thread without the module scope: no globals and no functions of the module in it.
	//Capture what it needs BY VALUE (widgets, colours) and keep changing state in the widget's attr.
	custom_control.on_draw([custom_control, c_field, c_grid, c_accent](){
		s = custom_control.size();
		w = s.x * 1.0;
		h = s.y * 1.0;
		//The field (input_fill)
		nvgBeginPath();
		nvgRect(vec2f(0, 0), vec2f(w, h));
		nvgFillColor(c_field);
		nvgFill();
		//A grid in quarters (border_light)
		nvgBeginPath();
		for(i = 1; i < 4; i++) {
			nvgMoveTo(vec2f(w * i / 4.0, 0));
			nvgLineTo(vec2f(w * i / 4.0, h));
			nvgMoveTo(vec2f(0, h * i / 4.0));
			nvgLineTo(vec2f(w, h * i / 4.0));
		}
		nvgStrokeColor(c_grid);
		nvgStrokeWidth(1.0);
		nvgStroke();
		//The point (accent: selected)
		p = custom_control.attr.point;
		nvgBeginPath();
		nvgCircle(vec2f(p.x * w, p.y * h), 6.0);
		nvgFillColor(c_accent);
		nvgFill();

		//Can also use nvgText etc (check docs)...
	});

	//Mouse handlers run in the module scope (not on the render thread). pos is on the widget itself
	custom_control.on_mouse_button([custom_control](pos, btn, down, mod) {
		//!!! Note the "left mouse button" is btn==0, the right mouse button is btn==1
		if(btn != 0 || !down)
			return false;
		//Drag positions come in the coordinates of the PARENT (a press in on_mouse_button in the widget's own ones):
		//subtract the widget's position
		s = custom_control.size();
		o = custom_control.position();
		if(s.x > 0 && s.y > 0)
			custom_control.attr.point = [x = math.clamp((pos.x - o.x) / s.x, 0.0, 1.0), y = math.clamp((pos.y - o.y) / s.y, 0.0, 1.0)];

		return true; //Mark consumed, can also call return mouse_button_default(pos, btn, down, mod); To run the default handler.
	});

	custom_control.on_mouse_drag([custom_control](pos, rel, btn, mod) {
		//!!! Note the "left mouse button" is btn==1, the right mouse button is btn==2 here (which are button flags for this function)
		//Drag positions come in the coordinates of the PARENT (a press in on_mouse_button in the widget's own ones):
		//subtract the widget's position
		s = custom_control.size();
		o = custom_control.position();
		if(s.x > 0 && s.y > 0)
			custom_control.attr.point = [x = math.clamp((pos.x - o.x) / s.x, 0.0, 1.0), y = math.clamp((pos.y - o.y) / s.y, 0.0, 1.0)];
		return true;
	});

	//There is also on_mouse_motion and more callbacks in the "widget" baseclass.

	//---VIDEO ENGINE AND VISUAL ASSETS---

	// Draw with nanovg on a shader if you need it rendered as routable video output (e.g. for text etc), and not just on the UI for widget controls.
	shader = shader_split.widget().anchor(0).anchor_left(0.5, "percent").shader();
	shader.anchor(0).anchor_left(GAP / 2);
	shader.tooltip("A shader drawn with nanovg: its picture goes out through Out");

	//Note this is currently called AFTER the shader pass (like an overlay)
	//So there is currently no way to read back the rendered nanovg in the fragment shader, but you can still use a second shader and route them if you wish to do so.
	//Shader widgets have "input()" which accepts other shaders to set uniform sampler2D inputs.

	//The picture is content, not chrome: its colours are your own (here red)
	shader.render_draw([shader]() {
		rs = shader.render_size();
		rs = vec2f(rs.x, rs.y); //render_size returns vec2i, however the nanovg functions currently ONLY accept vec2f, which is why we need to convert...
		nvgBeginPath();
		nvgRect(vec2f(0,0), rs);   // coordinates = output texture pixels
		nvgFillColor(vec4f(1,0,0,1));
		nvgFill();
	});

	//!!! NOTE
	//use shader.keep_aspect_ratio(false); to stretch the shader to the widget size
	//If you dont want that, you have to calculate the actual point on the shader in mouse callbacks based on the aspect ratio of the rendersize.
	//Because the shader widget auto fits the shader into the widgets dimension while keeping the aspect ratio (letterboxing) so keep that in mind.

	//Dont forget to add a controlio to make it routable inside the program...
	//An Out port is a pure output (as_output(true)): it sends, nothing can be linked into it
	ctrl_out = midi_ctrls_area.control("OUT").caption("Out").value(shader).as_output(true)
		.tooltip("The picture of the shader: [[link]] it onward");
	ctrl_out.callback([ctrl_out, shader](v) {
		//Reset when something tries to change it...
		ctrl_out.value(shader);
	});
}

save_state() {
	//TODO: Save states
	return [];
}

load_state(state) {
	//TODO: Load states
}
