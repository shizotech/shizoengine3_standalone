// Trigger generator (the Trigger CHOP of TouchDesigner): an envelope that starts when something happens
// The gate opens when Input rises above Threshold (Source Input), on every Every beats of the timeline (Source Beat),
// or while the Trigger button is held (a MIDI pad mapped to it). Then the Output rises to 1 in Attack seconds, falls
// to the Sustain level in Decay seconds and stays there while the gate is open. When it closes, the Output falls to
// 0 in Release seconds. Gate gives the gate itself (0 or 1). In Source Beat the gate stays open half the time to the
// next beat. Times are seconds, so the shape is the same at every tempo.
import nanogui;

source = None;
in = None;
threshold = None;
every = None;
button = None;
attack = None;
decay = None;
sustain = None;
release = None;
out = None;
gate_out = None;

env = 0.0;
stage = 0;          // 0 release / rest, 1 attack, 2 decay and sustain
gate = false;
last_ms = -1;
last_beat = None;

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	source = area.controlcombo("Source").tooltip("Input: the gate opens when Input rises above Threshold. Beat: on every Every beats of the [[timeline]]");
	source.items(["Input", "Beat"]).segmented(true); //index-based (0 = input, 1 = beat)
	in = area.controlslider("Input").tooltip("Source Input: [[link]] a value into it (the audio analysis, a MIDI pad, a button)");
	threshold = area.controlslider("Threshold").value(0.5).tooltip("Source Input: the gate opens when Input rises above it and closes when it falls below again");
	every = area.controlslider("Every").unit("beats").min(0.25).max(8).value(1).tooltip("Source Beat: how many [[beat|beats]] from one trigger to the next");
	button = area.controlbutton("Trigger").tooltip("Opens the gate while it is held, in every Source. Map a MIDI pad to it");
	attack = area.controlslider("Attack").unit("s").min(0).max(4).value(0.02).tooltip("Seconds from 0 up to 1 when the gate opens");
	decay = area.controlslider("Decay").unit("s").min(0).max(4).value(0.3).tooltip("Seconds from 1 down to the Sustain level");
	sustain = area.controlslider("Sustain").value(0.4).tooltip("The level the Output holds while the gate stays open");
	release = area.controlslider("Release").unit("s").min(0).max(8).value(0.6).tooltip("Seconds down to 0 when the gate closes");

	out = area.controlslider("Output").as_output(true).tooltip("The envelope, from 0 to 1. A [[pure output]]: [[link]] it into what should flash or swell\n[[wiki:Assets#generators--math]]");
	gate_out = area.controlslider("Gate").as_output(true).tooltip("1 while the gate is open, else 0. A [[pure output]]");
}

// Moves v towards target by at most step
approach(v, target, step) {
	if(math.abs(target - v) <= step)
		return target;
	return (target > v) ? v + step : v - step;
}

update(generator, tl_pos, pos_delta) {
	now = std.millis();
	if(last_ms < 0)
		last_ms = now;
	dt = (now - last_ms) / 1000.0;
	last_ms = now;
	if(dt > 0.25)
		dt = 0.25;

	// The gate of this frame
	is_open = button.value() ? true : false;
	fire = false;
	if(source.value() == 1) {
		e = every.value();
		if(e < 0.01)
			e = 0.01;
		beat = math.floor(tl_pos / e);
		// A new beat while the timeline runs fires again, even when the gate is still open
		if(!std.is_none(last_beat) && beat != last_beat && pos_delta > 0)
			fire = true;
		last_beat = beat;
		if(pos_delta > 0 && tl_pos / e - beat < 0.5)
			is_open = true;
	}
	else {
		th = threshold.value();
		v = in.value();
		if(gate)
			is_open = is_open || v >= th - 0.02;
		else
			is_open = is_open || v >= th;
	}

	if((is_open && !gate) || fire)
		stage = 1;
	if(!is_open)
		stage = 0;
	gate = is_open;

	if(stage == 1) {
		a = attack.value();
		env = (a <= 0.0001) ? 1.0 : approach(env, 1.0, dt / a);
		if(env >= 1.0)
			stage = 2;
	}
	else if(stage == 2) {
		d = decay.value();
		s = sustain.value();
		env = (d <= 0.0001) ? s : approach(env, s, (1.0 - s) * dt / d);
	}
	else {
		r = release.value();
		env = (r <= 0.0001) ? 0.0 : approach(env, 0.0, dt / r);
	}

	if(out.value() != env)
		out.value(env);
	g = gate ? 1.0 : 0.0;
	if(gate_out.value() != g)
		gate_out.value(g);
}
