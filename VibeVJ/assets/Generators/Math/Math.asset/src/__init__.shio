// Math generator (the Math CHOP of TouchDesigner): combines two values and shapes the result
// Output = Range(Function(A Combine B)), then Clamp. A and B take any number (link the BPM, an LFO, a fader into
// them); the Output is a plain number too. With the defaults (A + B, B = 0, no function, range 0..1 to 0..1) the
// Output is A.
//   Combine:  A + B, A - B, A * B, A / B (0 when B is 0), Min, Max, Average, Difference |A - B|, Power A^B, Modulo
//   Function: No function, Absolute, Negate, One minus (1 - x), Square, Square root, Sine (one wave per 1: 0.5 + 0.5 sin(2 pi x)),
//             Floor, Round, Fraction (the part after the point: a ramp that wraps), Step (1 from 0.5 on)
//   Range:    From low .. From high goes to To low .. To high (a straight line through both points), Clamp keeps it
//             between To low and To high
// The control IDs ("A", "B", "Combine", ...) are what projects and links store: keep them.
import nanogui;

a_in = None;
b_in = None;
combine = None;
func = None;
from_low = None;
from_high = None;
to_low = None;
to_high = None;
clamp_btn = None;
out = None;

COMBINE_ITEMS = ["A + B", "A - B", "A * B", "A / B", "Min", "Max", "Average", "Difference", "Power", "Modulo"];
FUNCTION_ITEMS = ["No function", "Absolute", "Negate", "One minus", "Square", "Square root", "Sine", "Floor", "Round", "Fraction", "Step"];

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	a_in = area.controlfloat("A").decimals(3).tooltip("The first value. [[link]] anything into it: a fader, an LFO, the BPM");
	b_in = area.controlfloat("B").decimals(3).tooltip("The second value. Leave it at 0 with A + B, or link something into it");
	combine = area.controlcombo("Combine").tooltip("How A and B make one value: A + B, A - B, A * B, A / B (0 when B is 0), Min, Max, Average, Difference (A - B without sign), Power (A to the power of B), Modulo (the rest of A / B)");
	combine.items(COMBINE_ITEMS); //index-based (0 = A + B, ...): new kinds only at the end
	func = area.controlcombo("Function").tooltip("Shapes the combined value: Absolute, Negate, One minus (1 - x), Square, Square root, Sine (0.5 + 0.5 sin, one wave per 1: turns a ramp into a wave), Floor, Round, Fraction (the part after the point), Step (0 below 0.5, 1 from 0.5)");
	func.items(FUNCTION_ITEMS); //index-based (0 = none, ...): new kinds only at the end

	range_vec = area.controlvector("Range").tooltip("Maps the value: From low goes to To low, From high to To high, in a straight line");
	from_low = range_vec.controlfloat("From low").decimals(3).value(0).tooltip("This value becomes To low");
	from_high = range_vec.controlfloat("From high").decimals(3).value(1).tooltip("This value becomes To high");
	to_low = range_vec.controlfloat("To low").decimals(3).value(0).tooltip("What From low becomes");
	to_high = range_vec.controlfloat("To high").decimals(3).value(1).tooltip("What From high becomes");
	clamp_btn = area.controlbutton("Clamp").push(1).tooltip("Keeps the Output between To low and To high");

	out = area.controlfloat("Output").decimals(3).as_output(true).tooltip("The result. A [[pure output]]: [[link]] it into what should move\n[[wiki:Assets#generators--math]]");
}

combine_values(kind, a, b) {
	if(kind == 1)
		return a - b;
	if(kind == 2)
		return a * b;
	if(kind == 3)
		return b == 0.0 ? 0.0 : a / b;
	if(kind == 4)
		return math.min(a, b);
	if(kind == 5)
		return math.max(a, b);
	if(kind == 6)
		return (a + b) * 0.5;
	if(kind == 7)
		return math.abs(a - b);
	if(kind == 8) {
		//A negative number has no real power of a fraction: the power of its size, with its sign
		p = math.pow(math.abs(a), b);
		return a < 0.0 ? -p : p;
	}
	if(kind == 9)
		return b == 0.0 ? 0.0 : a - math.floor(a / b) * b;
	return a + b;
}

apply_function(kind, x) {
	if(kind == 1)
		return math.abs(x);
	if(kind == 2)
		return -x;
	if(kind == 3)
		return 1.0 - x;
	if(kind == 4)
		return x * x;
	if(kind == 5)
		return x <= 0.0 ? 0.0 : math.sqrt(x);
	if(kind == 6)
		return 0.5 + 0.5 * math.sin(2.0 * math.PI * x);
	if(kind == 7)
		return math.floor(x);
	if(kind == 8)
		return math.round(x);
	if(kind == 9)
		return x - math.floor(x);
	if(kind == 10)
		return x >= 0.5 ? 1.0 : 0.0;
	return x;
}

update(generator, tl_pos, pos_delta) {
	x = combine_values(combine.value(), std.float(a_in.value()), std.float(b_in.value()));
	x = apply_function(func.value(), x);

	fl = std.float(from_low.value());
	fh = std.float(from_high.value());
	tl = std.float(to_low.value());
	th = std.float(to_high.value());
	if(fh != fl)
		x = tl + (x - fl) * (th - tl) / (fh - fl);
	else
		x = tl;
	if(clamp_btn.value())
		x = math.clamp(x, math.min(tl, th), math.max(tl, th));
	//A NaN or an infinity (a power of a huge number) would stick in every control it is linked into
	if(x != x || math.abs(x) > 1e12)
		x = 0.0;

	if(out.value() != x)
		out.value(x);
}
