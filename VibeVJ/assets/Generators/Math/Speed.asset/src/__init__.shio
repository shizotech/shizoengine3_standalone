// Speed generator (the Speed CHOP of TouchDesigner): turns a speed into a position that runs on
// Input is a speed: the Output moves forward by Input x Rate every beat (Unit per beat, it stops with the timeline) or
// every second (Unit per second). A change of the speed never makes the Output jump, so audio energy linked into
// Input makes a pattern run faster when the music is loud and slow down, not stand still, when it is quiet (Minimum).
// Wrap: the Output runs from 0 to 1 and starts again at 0 (a phase, an offset that loops). Ping-pong: up and down.
// Reset sets it back to 0.
import nanogui;

in = None;
rate = None;
minimum = None;
unit = None;
wrap = None;
reset = None;
out = None;

phase = 0.0;
last_ms = -1;

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	in = area.controlslider("Input").value(0.5).tooltip("The speed, 0 to 1. [[link]] something into it: the audio energy, a fader");
	rate = area.controlslider("Rate").min(0).max(4).value(0.25).tooltip("How many runs from 0 to 1 at Input 1, per beat or per second (Unit)");
	minimum = area.controlslider("Minimum").value(0.0).tooltip("The speed when Input is 0, as a part of Rate: keeps it moving slowly");
	unit = area.controlcombo("Unit").tooltip("Per beat: counts the [[beat|beats]] of the [[timeline]] and stops when it stops. Per second: runs always");
	unit.items(["Per beat", "Per second"]).segmented(true); //index-based (0 = per beat, 1 = per second)
	wrap = area.controlcombo("Wrap").tooltip("Wrap: from 0 to 1, then again from 0. Ping-pong: from 0 to 1 and back");
	wrap.items(["Wrap", "Ping-pong"]).segmented(true); //index-based (0 = wrap, 1 = ping-pong)
	reset = area.controlbutton("Reset").tooltip("Sets the Output back to 0 (while held). Map a MIDI pad to it or [[link]] a beat into it");

	out = area.controlslider("Output").as_output(true).tooltip("The position, from 0 to 1. A [[pure output]]: [[link]] it into an offset, a rotation, a phase\n[[wiki:Assets#generators--math]]");
}

update(generator, tl_pos, pos_delta) {
	now = std.millis();
	if(last_ms < 0)
		last_ms = now;
	dt = (now - last_ms) / 1000.0;
	last_ms = now;
	if(dt > 0.25)
		dt = 0.25;

	if(reset.value()) {
		phase = 0.0;
	}
	else {
		step = (unit.value() == 0) ? pos_delta : dt;
		m = minimum.value();
		speed = m + (1.0 - m) * in.value();
		phase += speed * rate.value() * step;
		// Keep it small: two runs are one ping-pong cycle
		phase = phase - math.floor(phase / 2.0) * 2.0;
	}

	v = phase - math.floor(phase);
	if(wrap.value() == 1)
		v = (phase < 1.0) ? phase : 2.0 - phase;
	if(out.value() != v)
		out.value(v);
}
