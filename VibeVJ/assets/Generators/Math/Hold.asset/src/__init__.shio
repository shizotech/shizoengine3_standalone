// Hold generator (the Hold CHOP of TouchDesigner): sample and hold
// At each trigger the Output takes the value of Input and keeps it until the next trigger. A trigger is Trigger rising
// above Threshold (Source Trigger input), every Every beats of the timeline (Source Beat), or a press of Sample.
//   Mode Sample: takes the value at the trigger. Track: follows Input while the trigger is open (Trigger above
//                Threshold, the first half of the beat, Sample held) and holds when it closes.
//   Value Input: the value of Input. Random: a new random number from 0 to 1 at each trigger (stepped noise).
// Smooth glides to a new value instead of jumping (seconds).
import nanogui;

source = None;
in = None;
trig = None;
threshold = None;
every = None;
sample_btn = None;
mode = None;
value_kind = None;
glide = None;
out = None;

held = 0.0;         // the value held now
shown = 0.0;        // the Output (glides towards held)
gate = false;
btn_was = false;
last_beat = None;
last_ms = -1;

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	source = area.controlcombo("Source").tooltip("Trigger input: when Trigger rises above Threshold. Beat: every Every beats of the [[timeline]]. Sample triggers in both");
	source.items(["Trigger input", "Beat"]).segmented(true); //index-based (0 = trigger input, 1 = beat)
	in = area.controlslider("Input").tooltip("The value that is held. [[link]] something that moves into it: the audio energy, an LFO, noise");
	trig = area.controlslider("Trigger").tooltip("Source Trigger input: [[link]] a beat, a button or a pulse into it");
	threshold = area.controlslider("Threshold").value(0.5).tooltip("A trigger when Trigger rises above it; it has to fall below again for the next one");
	every = area.controlslider("Every").unit("beats").min(0.25).max(16).value(1).tooltip("Source Beat: how many [[beat|beats]] from one trigger to the next");
	sample_btn = area.controlbutton("Sample").tooltip("Takes the value now, in every Source. Map a MIDI pad to it");
	mode = area.controlcombo("Mode").tooltip("Sample: takes the value at the trigger. Track: follows Input while the trigger is open and holds when it closes");
	mode.items(["Sample", "Track"]).segmented(true); //index-based (0 = sample, 1 = track)
	value_kind = area.controlcombo("Value").tooltip("Input: holds the value of Input. Random: a new random value at each trigger (stepped noise)");
	value_kind.items(["Input", "Random"]).segmented(true); //index-based (0 = input, 1 = random)
	glide = area.controlslider("Smooth").unit("s").min(0).max(4).value(0).tooltip("Seconds the Output takes to glide to a new value. 0: it jumps");

	out = area.controlslider("Output").as_output(true).tooltip("The held value. A [[pure output]]: [[link]] it into what should change in steps\n[[wiki:Assets#generators--math]]");
}

take() {
	held = value_kind.value() == 1 ? math.rand() : std.float(in.value());
}

update(generator, tl_pos, pos_delta) {
	now = std.millis();
	if(last_ms < 0) {
		last_ms = now;
		held = std.float(in.value());
		shown = held;
	}
	dt = (now - last_ms) / 1000.0;
	last_ms = now;
	if(dt > 0.25)
		dt = 0.25;

	fire = false;
	is_open = sample_btn.value() ? true : false;
	if(is_open && !btn_was)
		fire = true;
	btn_was = is_open;

	if(source.value() == 1) {
		e = every.value();
		if(e < 0.01)
			e = 0.01;
		beat = math.floor(tl_pos / e);
		if(!std.is_none(last_beat) && beat != last_beat && pos_delta > 0)
			fire = true;
		last_beat = beat;
		if(pos_delta > 0 && tl_pos / e - beat < 0.5)
			is_open = true;
	}
	else {
		th = threshold.value();
		v = trig.value();
		if(gate) {
			if(v < th - 0.02)
				gate = false;
		}
		else if(v >= th) {
			gate = true;
			fire = true;
		}
		is_open = is_open || gate;
	}

	if(fire || (mode.value() == 1 && is_open && value_kind.value() == 0))
		take();

	g = glide.value();
	if(g <= 0.0001)
		shown = held;
	else
		shown += (held - shown) * (1.0 - math.exp(-3.0 * dt / g));

	if(out.value() != shown)
		out.value(shown);
}

save_state() {
	return [held = held];
}

load_state(state) {
	if(state && state.has("held")) {
		held = std.float(state.held);
		shown = held;
		last_ms = std.millis();
	}
}
