// ============================================================================
// StepChaser (Math) - bar-synced step sequencer / value chaser
// ============================================================================
// The bar (Bar length, in beats) is cut into Steps (columns). Each step either gets
// its own Value (0..1) or is flagged Hold: then the last value that was set
// explicitly is kept for that step.
//
// When a step is reached its value is played:
//   attack  current output -> Value over Fade in    (beats)
//   hold    Value for the rest of the step
//   release Value -> 0 over Fade out                 (beats, at the END of the step)
// Hold steps never release, so the value simply stays.
// Fade in / Fade out are per step and clamped to the length of the step.
//
// UI: a nanogui.gridview table.
//   columns  = steps (1..16)
//   rows     = 3 rows per BLOCK  ->  row 0: Hold + Value   row 1: Fade out   row 2: Fade in
//   top header = step numbers, left header (rowspan 3) = the block:
//     row 0: name + remove button, row 1: Level (a bar), row 2: Output
// Blocks are stacked on the SAME grid, so several blocks give several
// independent outputs (one linkable Output per block).
//
// Utility/StepChaser is the other step chaser: one collapsible table per output, Sync only, and Hold keeps the
// output as it is at that moment (also halfway through a fade). Both stay, projects use both.
//
// Control IDs (saved projects, links): "Mode", "Beats per Bar", "Counts per Bar", per block (group "block<id>")
// "Name", "Wert" (Level), "OUT" (Output) and per step "Hold S<n>", "Wert S<n>" (Value), "FadeOut S<n>",
// "FadeIn S<n>". The save keys keep the old names too (wert = value).
//
// IMPORTANT (crash safety):
//   No widget teardown may ever happen inside a callback of a widget that is
//   currently dispatching an event. Removing a block therefore only marks the
//   block and hides its header immediately; the actual grid rebuild runs at the
//   top of update(), where no widget event is on the call stack.
// ============================================================================

import nanogui;
using eigen;

max_steps = 16;   // maximum steps per bar
max_blocks = 32;  // maximum stacked blocks
max_fade = 8.0;   // maximum Fade in / Fade out in beats

// Grid cell size. A cell holds one 28 px row with 4 px above and below, so the
// three rows of the left header line up with the three rows of the steps.
cell_w = 130;
cell_h = 36;
pad = 4;                  // space around a control in a cell
row_h = cell_h - 2 * pad; // 28
hold_w = 56;              // Hold toggle (shares row 0 with Value)

// Default per-step values.
default_wert = 1.0;
default_fade_in = 0.0;
default_fade_out = 0.0;
default_hold = 0;

// Widgets
grid = None;
mode = None;        // 0 = sync, 1 = free
beats_ctrl = None;  // beats per bar
steps_ctrl = None;  // steps per bar

// Block records (ordered). Stable ids keep control group names stable.
block_max_id = 0;
blocks = [];

// Clock
free_time = 0.0;

// Deferred grid teardown request (see IMPORTANT note above).
pending_rebuild = false;

// Unique control group for a block. Control names are unique inside a group,
// so a block's controls read as e.g. "block3@Wert S1", "block3@OUT".
grp(bid) {
    return "block" + bid;
}

// Grow / shrink a block's per-step arrays to n.
resize_block(rec, n) {
    if(n < 1)
        n = 1;
    for(i = rec.wert.size(); i < n; i++) {
        rec.wert.push_back(default_wert);
        rec.fade_in.push_back(default_fade_in);
        rec.fade_out.push_back(default_fade_out);
        rec.hold.push_back(default_hold);
    }
    if(rec.wert.size() > n) {
        rec.wert.resize(n);
        rec.fade_in.resize(n);
        rec.fade_out.resize(n);
        rec.hold.resize(n);
    }
}

// Build one block inside the grid. Must only be called from rebuild_grid().
build_block(b) {
    rec = blocks[b];
    bid = rec.id;
    group = grp(bid);
    n_steps = steps_ctrl.value();
    base = b * 3;

    // Left header spans the three rows of the block.
    left = grid.add_header_left_item(base);
    left.rowspan(3);

    // Row 0: name + remove
    name_ctrl = left.controltext("Name", group).tooltip("The name of this block");
    name_ctrl.value(rec.name, false, false)
        .anchor_left(pad).anchor_top(pad).anchor_right(pad + row_h + 4).fixed_height(row_h)
        .hide_config_menu(true);
    name_ctrl.callback([rec](v) {
        rec.name = v;
    });

    // Remove must NOT destroy itself -> mark + hide, rebuild deferred to update().
    del_btn = left.button("").icon(nanogui.icon("trash")).tooltip("Remove this block").danger("hover")
        .anchor_right(pad).anchor_top(pad).fixed_width(row_h).fixed_height(row_h);
    del_btn.on_click([rec, left]() {
        rec.pending_remove = 1;
        rec.env = 0.0;
        left.visible(false);
        pending_rebuild = true;
    });

    // Row 1: the current value as a bar
    readout_ctrl = left.controlslider("Wert", group).caption("Level").as_output(true).tooltip("The value of this block right now, as a bar. A [[pure output]], the same as Output");
    readout_ctrl.min(0).max(1).value(rec.env, false, false)
        .anchor_left(pad).anchor_top(cell_h + pad).anchor_right(pad).fixed_height(row_h)
        .hide_config_menu(true);

    // Row 2: the output
    out_ctrl = left.controlfloat("OUT", group).caption("Output").as_output(true).tooltip("The output of this block, 0 to 1. A [[pure output]]: [[link]] it into what should follow the steps\n[[wiki:Assets#generators--math]]");
    out_ctrl.min(0).max(1).value(rec.env, false, false)
        .anchor_left(pad).anchor_top(2 * cell_h + pad).anchor_right(pad).fixed_height(row_h)
        .hide_config_menu(true);

    rec.name_ctrl = name_ctrl;
    rec.readout_ctrl = readout_ctrl;
    rec.out_ctrl = out_ctrl;

    // Per-step cells.
    for(s = 0; s < n_steps; s++) {
        // Row 0: Hold toggle + Value.
        wert_item = grid.add_item(base + 0, s);
        wert_item.children_visible(true);

        hold_ctrl = wert_item.controlbutton("Hold S" + (s + 1), group).caption("Hold").tooltip("Hold: this step keeps the last value that was set, without fading");
        hold_ctrl.push(1).hide_config_menu(true)
            .anchor_left(pad).anchor_top(pad).fixed_width(hold_w).fixed_height(row_h);
        hold_ctrl.value(rec.hold[s], false, false);
        hold_ctrl.callback([rec, s](v) {
            rec.hold[s] = (v) ? 1 : 0;
        });

        wert_ctrl = wert_item.controlfloat("Wert S" + (s + 1), group).caption("Value").tooltip("The value this step goes to, 0 to 1");
        wert_ctrl.min(0).max(1).value(rec.wert[s], false, false).hide_config_menu(true)
            .anchor_left(pad + hold_w + 4).anchor_top(pad).anchor_right(pad).fixed_height(row_h);
        wert_ctrl.callback([rec, s](v) {
            rec.wert[s] = v;
        });

        // Row 1: Fade out.
        fo_item = grid.add_item(base + 1, s);
        fo_ctrl = fo_item.controlslider("FadeOut S" + (s + 1), group).caption("Fade out").unit("beats").tooltip("How long the value takes to fall back to 0 at the end of this step");
        fo_ctrl.min(0).max(max_fade).value(rec.fade_out[s], false, false).hide_config_menu(true)
            .anchor_left(pad).anchor_top(pad).anchor_right(pad).fixed_height(row_h);
        fo_ctrl.callback([rec, s](v) {
            rec.fade_out[s] = v;
        });

        // Row 2: Fade in.
        fi_item = grid.add_item(base + 2, s);
        fi_ctrl = fi_item.controlslider("FadeIn S" + (s + 1), group).caption("Fade in").unit("beats").tooltip("How long the output takes to reach the value of this step at its start");
        fi_ctrl.min(0).max(max_fade).value(rec.fade_in[s], false, false).hide_config_menu(true)
            .anchor_left(pad).anchor_top(pad).anchor_right(pad).fixed_height(row_h);
        fi_ctrl.callback([rec, s](v) {
            rec.fade_in[s] = v;
        });
    }
}

// Tear the table down and rebuild it from the current block list.
// NEVER call this from inside a widget event callback.
rebuild_grid() {
    n_steps = steps_ctrl.value();
    if(n_steps < 1)
        n_steps = 1;
    if(n_steps > max_steps)
        n_steps = max_steps;

    grid.clear_children();
    grid.rows(blocks.size() * 3).cols(n_steps);

    for(s = 0; s < n_steps; s++) {
        top = grid.add_header_top_item(s);
        top.label("Step " + (s + 1)).anchor(0).font_size(13);
    }

    for(b = 0; b < blocks.size(); b++) {
        resize_block(blocks[b], n_steps);
        build_block(b);
    }

    pending_rebuild = false;
}

// Apply removals that were requested from button callbacks, then rebuild.
// Called from update() only - no widget event is on the stack there.
flush_pending_rebuild() {
    if(pending_rebuild != true)
        return;

    for(b = blocks.size() - 1; b >= 0; b--) {
        if(blocks[b].pending_remove == 1)
            blocks.erase(b);
    }

    rebuild_grid();
}

add_block() {
    if(blocks.size() >= max_blocks)
        return;

    block_max_id = block_max_id + 1;
    rec = [id=block_max_id, name="Block " + block_max_id,
        wert=[], fade_in=[], fade_out=[], hold=[],
        pending_remove=0,
        last_step=-1, prev_env=0.0, hold_value=0.0, env=0.0,
        name_ctrl=None, readout_ctrl=None, out_ctrl=None];

    resize_block(rec, steps_ctrl.value());
    blocks.push_back(rec);
    rebuild_grid();
}

// A cell of a row cut into n equal parts, with a 4 px gap to the next cell. The control in it fills it.
row_cell(row, i, n) {
    l = std.float(i) / std.float(n);
    r = std.float(n - 1 - i) / std.float(n);
    return row.widget().anchor_top(0).anchor_bottom(0).anchor_left(l, "percent").anchor_right(r, "percent");
}
cell_gap(i, n) {
    return (i < n - 1) ? 4 : 0;
}

entry(generator, area) {
    // Top row by anchors, the table below it fills the rest of the window
    area.layout(None);

    // [ Mode | Bar length | Steps | Add block ]
    top_row = area.widget().fixed_height(28)
        .anchor_left(0).anchor_top(0).anchor_right(0);

    // 0 = sync (timeline position), 1 = free (own clock).
    mode = row_cell(top_row, 0, 4).controlcombo("Mode").tooltip("Sync: follows the position of the [[timeline]]. Free: counts on its own").anchor(0).anchor_right(cell_gap(0, 4));
    mode.items(["Sync", "Free"]).segmented(true); //index-based (0 = sync, 1 = free)

    beats_ctrl = row_cell(top_row, 1, 4).controlslider("Beats per Bar").caption("Bar length").unit("beats").tooltip("How many [[beat|beats]] one bar of the chaser lasts").min(0.1).max(32).value(4.0).anchor(0).anchor_right(cell_gap(1, 4));
    steps_ctrl = row_cell(top_row, 2, 4).controlint("Counts per Bar").caption("Steps").tooltip("Into how many steps (columns) the bar is cut").min(1).max(max_steps).value(4).anchor(0).anchor_right(cell_gap(2, 4));

    add_btn = row_cell(top_row, 3, 4).button("Add block").icon(nanogui.icon("plus")).tooltip("Another row of steps with its own output\n[[wiki:Assets#generators--math]]").anchor(0).anchor_top(2).anchor_bottom(2);
    add_btn.on_click([]() {
        add_block();
    });

    grid = area.gridview()
        .anchor(0).anchor_top(36)
        .header_left_width(200)
        .header_top_height(28)
        .cell_size(vec2f(cell_w, cell_h))
        .rows(0).cols(0)
        .show_grid(true);

    // Changing the number of steps rebuilds the table (values kept in records).
    steps_ctrl.callback([](v) {
        for(b = 0; b < blocks.size(); b++) {
            blocks[b].last_step = -1;
        }
        rebuild_grid();
    });

    add_block();
}

update(generator, tl_pos, pos_delta) {
    flush_pending_rebuild();

    n_steps = steps_ctrl.value();
    if(n_steps < 1)
        n_steps = 1;
    if(n_steps > max_steps)
        n_steps = max_steps;

    // Clock selection.
    clock = 0.0;
    if(mode.value() == 1) {
        free_time = free_time + pos_delta;
        clock = free_time;
    }
    else {
        clock = tl_pos;
    }
    if(clock < 0.0)
        clock = 0.0;

    step_len = beats_ctrl.value() / std.float(n_steps);
    if(step_len <= 0.0)
        step_len = 1.0;

    current_step = math.floor(clock / step_len);

    for(b = 0; b < blocks.size(); b++) {
        rec = blocks[b];
        resize_block(rec, n_steps);

        s = math.mod(current_step, n_steps);
        if(s < 0)
            s = 0;

        // Step boundary crossed -> latch the target for this step.
        if(current_step != rec.last_step) {
            rec.prev_env = rec.env;
            rec.last_step = current_step;
            if(rec.hold[s] == 0)
                rec.hold_value = rec.wert[s];
        }

        held = (rec.hold[s] != 0);
        target = held ? rec.hold_value : rec.wert[s];

        fi = rec.fade_in[s];
        if(fi < 0.0)
            fi = 0.0;
        fo = rec.fade_out[s];
        if(fo < 0.0)
            fo = 0.0;
        // Hold steps never release.
        if(held)
            fo = 0.0;

        // Clamp fades to the length of the step.
        fi_eff = math.min(fi, step_len);
        fo_eff = math.min(fo, step_len - fi_eff);

        step_start = std.float(current_step) * step_len;
        p = clock - step_start;
        if(p < 0.0)
            p = 0.0;

        from = rec.prev_env;

        if(p < fi_eff) {
            // Attack: from -> target.
            rec.env = from + (target - from) * (p / fi_eff);
        }
        else if(p < step_len - fo_eff) {
            // Sustain at target (or held value).
            rec.env = target;
        }
        else {
            if(fo_eff > 0.0) {
                // Release: target -> 0 at the end of the step.
                q = (p - (step_len - fo_eff)) / fo_eff;
                if(q > 1.0)
                    q = 1.0;
                rec.env = target * (1.0 - q);
            }
            else {
                rec.env = target;
            }
        }

        if(rec.env < 0.0)
            rec.env = 0.0;
        if(rec.env > 1.0)
            rec.env = 1.0;

        if(rec.out_ctrl != None)
            rec.out_ctrl.value(rec.env, false, false);
        if(rec.readout_ctrl != None)
            rec.readout_ctrl.value(rec.env, false, false);
    }
}

save_state() {
    state = [
        mode=mode.value(),
        beats=beats_ctrl.value(),
        steps=steps_ctrl.value(),
        block_max_id=block_max_id,
        blocks=[],
    ];

    for(b = 0; b < blocks.size(); b++) {
        rec = blocks[b];
        blk = [id=rec.id, name=rec.name, steps=[]];
        for(s = 0; s < rec.wert.size(); s++) {
            blk.steps.push_back([
                wert=rec.wert[s],
                fade_in=rec.fade_in[s],
                fade_out=rec.fade_out[s],
                hold=rec.hold[s],
            ]);
        }
        state.blocks.push_back(blk);
    }

    return state;
}

load_state(state) {
    if(state.has("mode"))
        mode.value(state.mode, false, false);
    if(state.has("beats"))
        beats_ctrl.value(state.beats, false, false);
    if(state.has("steps"))
        steps_ctrl.value(state.steps, false, false);
    if(state.has("block_max_id"))
        block_max_id = state.block_max_id;

    n_steps = steps_ctrl.value();

    blocks.clear();
    if(state.has("blocks")) {
        for(b = 0; b < state.blocks.size(); b++) {
            blk = state.blocks[b];
            rec = [id=blk.id, name=blk.name,
                wert=[], fade_in=[], fade_out=[], hold=[],
                pending_remove=0,
                last_step=-1, prev_env=0.0, hold_value=0.0, env=0.0,
                name_ctrl=None, readout_ctrl=None, out_ctrl=None];

            if(blk.has("steps")) {
                for(s = 0; s < blk.steps.size(); s++) {
                    cell = blk.steps[s];
                    rec.wert.push_back((cell.has("wert")) ? cell.wert : default_wert);
                    rec.fade_in.push_back((cell.has("fade_in")) ? cell.fade_in : default_fade_in);
                    rec.fade_out.push_back((cell.has("fade_out")) ? cell.fade_out : default_fade_out);
                    rec.hold.push_back((cell.has("hold")) ? cell.hold : default_hold);
                }
            }

            resize_block(rec, n_steps);
            blocks.push_back(rec);
        }
    }

    rebuild_grid();
}
