// Lag generator (the Lag / Filter CHOP of TouchDesigner)
// Output follows Input, but not at once: Rise is the time it takes to go up, Fall the time to go down, in seconds
// (so it also works while the timeline stands still). A jumpy value (audio energy, a MIDI fader, a beat) becomes a
// smooth one, or a quick attack with a slow fall.
// Mode Smooth: exponential, fast at first and slower near the target. Linear: a constant speed (a slew limiter: from
// 0 to 1 in Rise seconds). Spring: overshoots and swings back, Bounce sets how much, Rise how long a swing takes. The Output stays within 0 .. 1.
import nanogui;

in = None;
mode = None;
rise = None;
fall = None;
bounce = None;
out = None;

value = 0.0;
velocity = 0.0;
last_ms = -1;

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	in = area.controlslider("Input").tooltip("The value to follow. [[link]] something jumpy into it: the audio analysis, a MIDI fader, a beat");
	mode = area.controlcombo("Mode").tooltip("Smooth: fast at first, slower near the target. Linear: a constant speed. Spring: overshoots and swings back");
	mode.items(["Smooth", "Linear", "Spring"]).segmented(true); //index-based (0 = smooth, 1 = linear, 2 = spring)
	rise = area.controlslider("Rise").unit("s").min(0).max(10).value(0.3).tooltip("How long the Output takes to go up to a higher Input, in seconds. 0: at once");
	fall = area.controlslider("Fall").unit("s").min(0).max(10).value(1.0).tooltip("How long the Output takes to go down to a lower Input, in seconds. 0: at once");
	bounce = area.controlslider("Bounce").value(0.5).tooltip("Spring only: 0 no overshoot, 1 swings for a long time");

	out = area.controlslider("Output").as_output(true).tooltip("The Input, smoothed. A [[pure output]]: [[link]] it into what should move\n[[wiki:Assets#generators--math]]");
}

// One step of dt seconds towards target t
lag_step(t, dt) {
	m = mode.value();
	// The spring swings both ways, so it keeps one time: Rise
	secs = (t > value || m == 2) ? rise.value() : fall.value();
	if(secs <= 0.0001) {
		value = t;
		velocity = 0.0;
		return;
	}
	if(m == 1) {
		// Linear: the whole range (1) in `secs` seconds
		step = dt / secs;
		if(math.abs(t - value) <= step)
			value = t;
		else if(t > value)
			value += step;
		else
			value -= step;
		velocity = 0.0;
	}
	else if(m == 2) {
		// Spring: a damped oscillator with its period about `secs`; Bounce 0 is critically damped
		w = 2.0 * math.PI / secs;
		damping = 2.0 * (1.0 - bounce.value() * 0.95) * w;
		velocity += (w * w * (t - value) - damping * velocity) * dt;
		value += velocity * dt;
	}
	else {
		// Smooth: 95 % of the way after `secs` seconds
		value += (t - value) * (1.0 - math.exp(-3.0 * dt / secs));
		velocity = 0.0;
	}
}

update(generator, tl_pos, pos_delta) {
	now = std.millis();
	if(last_ms < 0) {
		last_ms = now;
		value = in.value();
		out.value(value);
		return;
	}
	dt = (now - last_ms) / 1000.0;
	last_ms = now;
	// A stall (a project load, a dialog) is no jump
	if(dt > 0.25)
		dt = 0.25;
	if(dt <= 0.0)
		return;

	// Small steps keep the spring stable at low frame rates
	steps = math.ceil(dt / 0.01);
	if(steps < 1)
		steps = 1;
	t = in.value();
	for(i = 0; i < steps; i++)
		lag_step(t, dt / steps);

	if(value < 0.0) {
		value = 0.0;
		velocity = 0.0;
	}
	if(value > 1.0) {
		value = 1.0;
		velocity = 0.0;
	}
	if(out.value() != value)
		out.value(value);
}
