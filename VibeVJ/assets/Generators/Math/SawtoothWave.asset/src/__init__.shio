import nanogui;

mode = None;
freq = None;
bias = None;
gain = None;

out = None;

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	mode = area.controlcombo("mode");
	mode.items(["FREE", "SYNC"]);
	freq = area.controlslider("Frequency").value(0.25);
	bias = area.controlslider("Bias").min(-1).max(1).value(0);
	gain = area.controlslider("Gain").max(2).value(1.0);

	out = area.controlslider("Output");
}

free_time = 0;
update(generator, tl_pos, pos_delta) {

	v = 0.0;
	phase = 0.0;

	if(mode.value() == 0) {
		free_time += pos_delta * freq.value();
		phase = free_time;
	}
	else {
		phase = tl_pos * freq.value();
	}

	// Sawtooth wave in [-1, 1], period = 1.0 cycle
	p = math.mod(phase, 1.0);
	v = 2.0 * p - 1.0;

	// Apply gain and bias
	v = v * gain.value() + bias.value();

	// Convert [-1, 1] to [0, 1]
	v = 0.5 + v / 2.0;

	out.value(v);
}

save_state() {
	state = [
		mode=mode.value(),
		freq=freq.value(),
		bias=bias.value(),
		gain=gain.value(),
	];
	return state;
}

load_state(state) {
	if(state.has("mode"))
		mode.value(state.mode);
	if(state.has("freq"))
		freq.value(state.freq);
	if(state.has("bias"))
		bias.value(state.bias);
	if(state.has("gain"))
		gain.value(state.gain);
}
