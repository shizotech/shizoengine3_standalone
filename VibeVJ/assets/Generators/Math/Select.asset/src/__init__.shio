// Select generator (the Switch / Select CHOP of TouchDesigner): picks one of up to 8 values
// Inputs sets how many there are. Which one goes to the Output: Index (a whole number, 1 = Input 1: link the Count of
// Count into it) or Position (0 to 1 across the inputs: link a fader or an LFO into it); the one moved last wins.
// Fade glides from the value picked before to the new one (seconds); both keep following their inputs meanwhile.
// The inputs take any number (link LFOs, faders, the BPM); the Output is a plain number.
import nanogui;

MAX_INPUTS = 8;

def show_inputs();
def set_pick(p);

count_ctrl = None;
index_ctrl = None;
position_ctrl = None;
fade = None;
inputs = [];
out = None;
picked_out = None;

pick = 0;           // the input picked now, from 0
from_pick = 0;      // the one picked before (Fade)
blend = 1.0;        // 0 = from_pick, 1 = pick
last_ms = -1;

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	count_ctrl = area.controlint("Inputs").min(2).max(MAX_INPUTS).value(4).tooltip("How many inputs there are to pick from");
	index_ctrl = area.controlint("Index").min(1).max(MAX_INPUTS).value(1).tooltip("Which input goes to the Output: 1 is Input 1. [[link]] the Count of a Count into it, or map MIDI buttons");
	position_ctrl = area.controlslider("Position").tooltip("Which input goes to the Output, 0 to 1 across the inputs: 0 the first, 1 the last. [[link]] a fader or an LFO into it");
	fade = area.controlslider("Fade").unit("s").min(0).max(10).value(0).tooltip("Seconds the Output takes to glide to the newly picked input. 0: it jumps");

	ins = area.controlvector("Values").tooltip("The values to pick from");
	for(i = 0; i < MAX_INPUTS; i++)
		inputs.push_back(ins.controlfloat("Input " + (i + 1)).decimals(3).value(i / std.float(MAX_INPUTS - 1)).tooltip("A value to pick. [[link]] anything into it"));

	out = area.controlfloat("Output").decimals(3).as_output(true).tooltip("The value of the picked input. A [[pure output]]: [[link]] it into what should change\n[[wiki:Assets#generators--math]]");
	picked_out = area.controlint("Picked").as_output(true).tooltip("Which input is picked, 1 to Inputs. A [[pure output]]");

	index_ctrl.callback([](v) {
		set_pick(std.int(v) - 1);
	});
	position_ctrl.callback([](v) {
		n = math.clamp(count_ctrl.value(), 2, MAX_INPUTS);
		set_pick(std.int(math.round(math.clamp(v, 0.0, 1.0) * (n - 1))));
	});
	count_ctrl.callback([](v) {
		show_inputs();
	});
	show_inputs();
}

// Only the inputs in use are shown
show_inputs() {
	n = math.clamp(count_ctrl.value(), 2, MAX_INPUTS);
	for(i = 0; i < inputs.size(); i++)
		inputs[i].visible(i < n);
}

set_pick(p) {
	n = math.clamp(count_ctrl.value(), 2, MAX_INPUTS);
	p = std.int(math.clamp(p, 0, n - 1));
	if(p == pick)
		return;
	//a pick during a fade starts from where the Output is: the old pair becomes the start
	from_pick = blend < 0.5 ? from_pick : pick;
	pick = p;
	blend = fade.value() > 0.0001 ? 0.0 : 1.0;
}

update(generator, tl_pos, pos_delta) {
	now = std.millis();
	if(last_ms < 0)
		last_ms = now;
	dt = (now - last_ms) / 1000.0;
	last_ms = now;
	if(dt > 0.25)
		dt = 0.25;

	n = math.clamp(count_ctrl.value(), 2, MAX_INPUTS);
	if(pick > n - 1)
		pick = n - 1;
	if(from_pick > n - 1)
		from_pick = n - 1;

	f = fade.value();
	if(blend < 1.0)
		blend = f <= 0.0001 ? 1.0 : math.min(1.0, blend + dt / f);
	v = std.float(inputs[pick].value());
	if(blend < 1.0) {
		s = blend * blend * (3.0 - 2.0 * blend);
		v = std.float(inputs[from_pick].value()) + (v - std.float(inputs[from_pick].value())) * s;
	}

	if(out.value() != v)
		out.value(v);
	if(picked_out.value() != pick + 1)
		picked_out.value(pick + 1);
}

save_state() {
	return [pick = pick];
}

load_state(state) {
	if(state && state.has("pick")) {
		pick = std.int(state.pick);
		from_pick = pick;
		blend = 1.0;
	}
}
