import nanogui;

mode = None;
freq = None;
bias = None;
gain = None;

out = None;

entry(generator, area) {
	area.layout(nanogui.layout_vertical());
	
	mode = area.controlcombo("mode").caption("Mode").tooltip("Sync: locked to the position of the [[timeline]], so it lines up with the [[beat]]. Free: keeps its own phase, a change of the frequency does not jump");
	mode.items(["Free", "Sync"]).segmented(true); //index-based (0 = free, 1 = sync)
	freq = area.controlslider("Frequency").unit("per beat").value(0.25).tooltip("How many waves per [[beat]]");
	bias = area.controlslider("Bias").min(-1).max(1).value(0).tooltip("Moves the wave up or down");
	gain = area.controlslider("Gain").max(2).value(1.0).tooltip("How big the wave is. 0: flat, 1: from 0 to 1");

	out = area.controlslider("Output").as_output(true).tooltip("The wave, from 0 to 1. A [[pure output]]: [[link]] it into what should move\n[[wiki:Assets#generators--math]]");
}

free_time = 0;
update(generator, tl_pos, pos_delta) {

	v = 0.0;
	phase = 0.0;

	if(mode.value() == 0) {
		free_time += pos_delta * freq.value();
		phase = free_time;
	}
	else {
		//Sync: the frequency counts in both modes, like Sine, Saw and Square (#321)
		phase = tl_pos * freq.value();
	}

	// Triangle wave in [-1, 1], period = 1.0
	// p in [0,0.25): 4p          (0 -> 1)
	// p in [0.25,0.5): 2 - 4p    (1 -> 0)
	// p in [0.5,0.75): 2 - 4p    (0 -> -1)
	// p in [0.75,1.0]: 4p - 4    (-1 -> 0)
	p = math.mod(phase, 1.0);
	if(p < 0.25) {
		v = 4.0 * p;
	}
	else if(p < 0.5) {
		v = 2.0 - 4.0 * p;
	}
	else if(p < 0.75) {
		v = 2.0 - 4.0 * p;
	}
	else {
		v = 4.0 * p - 4.0;
	}

	// Apply gain and bias
	v = v * gain.value() + bias.value();

	// Convert [-1, 1] to [0, 1]
	v = 0.5 + v / 2.0;

	out.value(v);
}
