import nanogui;

mode = None;
freq = None;
bias = None;
gain = None;

out = None;

entry(generator, area) {
	area.layout(nanogui.layout_vertical());
	
	mode = area.controlcombo("mode");
	mode.items(["FREE", "SYNC"]);
	freq = area.controlslider("Frequency").value(0.25);
	bias = area.controlslider("Bias").min(-1).max(1).value(0);
	gain = area.controlslider("Gain").max(2).value(1.0);

	out = area.controlslider("Output");
}

free_time = 0;
update(generator, tl_pos, pos_delta) {

	v = 0.0;
	phase = 0.0;

	if(mode.value() == 0) {
		free_time += pos_delta * freq.value();
		phase = free_time;
	}
	else {
		phase = tl_pos;
	}

	// Triangle wave in [-1, 1], period = 1.0
	// p in [0,0.25): 4p          (0 -> 1)
	// p in [0.25,0.5): 2 - 4p    (1 -> 0)
	// p in [0.5,0.75): 2 - 4p    (0 -> -1)
	// p in [0.75,1.0]: 4p - 4    (-1 -> 0)
	p = math.mod(phase, 1.0);
	if(p < 0.25) {
		v = 4.0 * p;
	}
	else if(p < 0.5) {
		v = 2.0 - 4.0 * p;
	}
	else if(p < 0.75) {
		v = 2.0 - 4.0 * p;
	}
	else {
		v = 4.0 * p - 4.0;
	}

	// Apply gain and bias
	v = v * gain.value() + bias.value();

	// Convert [-1, 1] to [0, 1]
	v = 0.5 + v / 2.0;

	out.value(v);
}
