// Count generator (the Count CHOP of TouchDesigner): counts events
// An event is Input rising above Threshold (Source Input), every Every beats of the timeline (Source Beat), or a press
// of Count (a MIDI pad mapped to it, a link). Each event adds Step to Count, which runs from 0 to Steps - 1:
//   Wrap:      after the last value again from 0 (a cycle: 0 1 2 3 0 1 ...)
//   Ping-pong: up and down again (0 1 2 3 2 1 0 ...)
//   Stop:      stays at the last value until Reset
//   Random:    a random other value at each event
// Reset (held, or linked) sets Count back to Start. Output is Count as 0 .. 1 (Count / (Steps - 1)), for a slider;
// Count itself is a whole number, for the Index of Select or a column of a Clipview.
import nanogui;

source = None;
in = None;
threshold = None;
every = None;
count_btn = None;
step_ctrl = None;
steps_ctrl = None;
mode = None;
start_ctrl = None;
reset = None;
count_out = None;
out = None;

count = 0;
direction = 1;      // Ping-pong: 1 up, -1 down
gate = false;       // Input is above Threshold
btn_was = false;
last_beat = None;

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	source = area.controlcombo("Source").tooltip("Input: counts when Input rises above Threshold. Beat: counts every Every beats of the [[timeline]]. Count counts in both");
	source.items(["Input", "Beat"]).segmented(true); //index-based (0 = input, 1 = beat)
	in = area.controlslider("Input").tooltip("Source Input: [[link]] a value into it (a beat, a button, the audio analysis)");
	threshold = area.controlslider("Threshold").value(0.5).tooltip("Source Input: an event when Input rises above it; it has to fall below again for the next one");
	every = area.controlslider("Every").unit("beats").min(0.25).max(16).value(1).tooltip("Source Beat: how many [[beat|beats]] from one event to the next");
	count_btn = area.controlbutton("Count button").caption("Count").tooltip("Counts once per press, in every Source. Map a MIDI pad to it");
	step_ctrl = area.controlint("Step").min(-16).max(16).value(1).tooltip("Added at each event: 1 counts up, -1 down, 2 every second value");
	steps_ctrl = area.controlint("Steps").min(2).max(1024).value(4).tooltip("How many values Count runs through: 0 to Steps - 1");
	mode = area.controlcombo("Mode").tooltip("At the end: Wrap starts again at 0, Ping-pong turns back, Stop stays there until Reset. Random: a random other value at each event");
	mode.items(["Wrap", "Ping-pong", "Stop", "Random"]).segmented(true); //index-based (0 = wrap, 1 = ping-pong, 2 = stop, 3 = random)
	start_ctrl = area.controlint("Start").min(0).max(1023).value(0).tooltip("The value after Reset");
	reset = area.controlbutton("Reset").tooltip("Sets Count back to Start (while held). Map a MIDI pad to it or [[link]] something into it");

	count_out = area.controlint("Count").as_output(true).tooltip("The count, a whole number from 0 to Steps - 1. A [[pure output]]: [[link]] it into the Index of Select or anything that takes a number");
	out = area.controlslider("Output").as_output(true).tooltip("The count as 0 to 1 (Count / (Steps - 1)). A [[pure output]]: [[link]] it into a slider\n[[wiki:Assets#generators--math]]");
}

// One event: the next value
advance(n) {
	m = mode.value();
	stp = step_ctrl.value();
	if(m == 3) {
		if(n < 2)
			return;
		//another value than now, all others alike
		r = math.random_int(0, n - 2);
		if(r >= count)
			r += 1;
		count = std.int(math.clamp(r, 0, n - 1));
		return;
	}
	if(m == 1) {
		if(stp == 0)
			return;
		next = count + stp * direction;
		if(next > n - 1 || next < 0) {
			direction = -direction;
			next = count + stp * direction;
		}
		count = std.int(math.clamp(next, 0, n - 1));
		return;
	}
	next = count + stp;
	if(m == 2)
		count = std.int(math.clamp(next, 0, n - 1));
	else
		count = std.int(next - math.floor(next / n) * n); //wraps both ways
}

update(generator, tl_pos, pos_delta) {
	n = math.max(steps_ctrl.value(), 2);
	if(count > n - 1)
		count = n - 1;

	events = 0;
	b = count_btn.value() ? true : false;
	if(b && !btn_was)
		events++;
	btn_was = b;

	if(source.value() == 1) {
		e = every.value();
		if(e < 0.01)
			e = 0.01;
		beat = math.floor(tl_pos / e);
		if(!std.is_none(last_beat) && beat != last_beat && pos_delta > 0)
			events++;
		last_beat = beat;
	}
	else {
		th = threshold.value();
		v = in.value();
		if(gate) {
			if(v < th - 0.02)
				gate = false;
		}
		else if(v >= th) {
			gate = true;
			events++;
		}
	}

	r = reset.value() ? true : false;
	if(r) {
		count = std.int(math.clamp(start_ctrl.value(), 0, n - 1));
		direction = 1;
	}
	else {
		for(i = 0; i < events; i++)
			advance(n);
	}

	if(count_out.value() != count)
		count_out.value(count);
	v = count / std.float(n - 1);
	if(out.value() != v)
		out.value(v);
}

// The count goes on where it was after a load (the controls hold everything else)
save_state() {
	return [count = count, direction = direction];
}

load_state(state) {
	if(!state)
		return;
	if(state.has("count"))
		count = std.int(state["count"]);
	if(state.has("direction"))
		direction = state.direction;
}
