
mode = None;
freq = None;
bias = None;
gain = None;
saturation = None;

out = None;

entry(generator, area) {
	area.layout(nanogui.layout_vertical());
	
	mode = area.controlcombo("mode");
	mode.items(["FREE", "SYNC"]);
	freq = area.controlslider("Frequency").value(0.25);
	bias = area.controlslider("Bias").min(-1).max(1).value(0);
	gain = area.controlslider("Gain").max(2).value(1.0);
	saturation = area.controlslider("Saturation").value(0.0);

	out = area.controlslider("Output");
}

free_time = 0;
update(generator, tl_pos, pos_delta) {
	
	v = 0.0;
	
	if(mode.value() == 0) {
		free_time += pos_delta * freq.value();
		v = math.sin(free_time * 2.0 * math.PI);
	}
	else {
		v = math.sin(tl_pos * 2.0 * math.PI * freq.value());
	}

	// Saturate sine towards square
	s = saturation.value();
	exponent = 1.0 / (1.0 + s * 20.0);
	v = math.sign(v) * math.pow(math.abs(v), exponent);

	// Apply gain and bias
	v = v * gain.value() + bias.value();

	// Convert [-1, 1] to [0, 1]
	v = 0.5 + v / 2.0;

	out.value(v);
}