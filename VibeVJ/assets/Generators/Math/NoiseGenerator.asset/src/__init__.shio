// Noise generator
// Emits a new random value at a user-configurable rate. A "Type" combo
// selects WHITE or PINK noise, and a "Rate" slider controls how often a
// new value is produced. The current value is written to the "Output"
// controlslider, ready to be consumed by other nodes.
import nanogui;

type_combo = None;
rate = None;
out = None;

// Pink-noise filter state (Paul Kellet one-pole approximation).
// Each white sample is fed through:
//   a = 0.02; b = 0.3; c = 0.5;
//   b0 = b0 * a + white * b;
//   b1 = b1 * a + white * c;
//   b2 = b2 * a + white;
//   pink = (b0 + b1 + b2 + white * 0.1) * 1.5;
// This maps a [0,1] white sample into a [0,1] pink sample.
pink_b0 = 0.0;
pink_b1 = 0.0;
pink_b2 = 0.0;

// Emission timing
acc = 0.0;
last_value = 0.5;

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	type_combo = area.controlcombo("Type");
	type_combo.items(["WHITE", "PINK"]);
	type_combo.selected_index(0);

	// Minimum rate of 1.0 prevents a zero-division when computing the
	// emission interval (1.0 / rate).
	rate = area.controlslider("Rate").min(1).max(20).value(2.0);

	out = area.controlslider("Output");
}

update(generator, tl_pos, pos_delta) {
	// Emit a new sample at the configured rate (values per second).
	acc += pos_delta;
	interval = 1.0 / rate.value();

	if(acc >= interval) {
		acc = 0.0;

		white = math.random_float(0.0, 1.0);

		if(type_combo.value() == 0) {
			// White noise: use the [0,1] sample directly.
			last_value = white;
		}
		else {
			// Pink noise: one-pole Paul Kellet filter over the white sample.
			a = 0.02;
			b = 0.3;
			c = 0.5;
			pink_b0 = pink_b0 * a + white * b;
			pink_b1 = pink_b1 * a + white * c;
			pink_b2 = pink_b2 * a + white;
			v = (pink_b0 + pink_b1 + pink_b2 + white * 0.1) * 1.5;
			if(v < 0.0)
				v = 0.0;
			if(v > 1.0)
				v = 1.0;
			last_value = v;
		}

		out.value(last_value);
	}
}

save_state() {
	state = [
		type=type_combo.value(),
		rate=rate.value(),
		out=out.value(),
	];
	return state;
}

load_state(state) {
	if(state.has("type"))
		type_combo.value(state.type);
	if(state.has("rate"))
		rate.value(state.rate);
}
