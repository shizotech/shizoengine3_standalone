// LFO Clock generator
// BPM-driven beat clock / metronome LFO. On each beat boundary the Output
// control is pulsed to 1.0, then it decays linearly toward 0 over the
// configured decay duration. Useful as a one-shot-per-beat "kick" for
// triggering effects in time with a tempo.
import nanogui;

bpm = None;
beats = None;
decay = None;
out = None;

// Beat-accumulation runtime
acc = 0.0;
pulse = 0.0;
decay_time = 0.0;

entry(generator, area) {
	area.layout(nanogui.layout_vertical());

	// Tempo in beats per minute (20..240, default 120).
	bpm = area.controlslider("BPM").min(20).max(240).value(120);

	// Beats / subdivision per measure (1..8, default 4).
	// Beat interval = (60 / BPM) / beats.
	beats = area.controlslider("Beats").min(1).max(8).value(4);

	// Decay (pulse width) in seconds (0.01..2.0, default 0.2).
	decay = area.controlslider("Decay").min(0.01).max(2.0).value(0.2);

	out = area.controlslider("Output");
}

update(generator, tl_pos, pos_delta) {
	beat_interval = (60.0 / bpm.value()) / beats.value();

	acc += pos_delta;

	// Cross one or more beat boundaries (only `for` loops are allowed,
	// so guard with a cap to avoid an unbounded loop).
	if(beat_interval > 0.0) {
		for(i = 0; i < 100; i++) {
			if(acc >= beat_interval) {
				acc -= beat_interval;
				pulse = 1.0;
				decay_time = 0.0;
			}
			else {
				break;
			}
		}
	}

	// Linear decay of the pulse toward 0 over the configured decay duration.
	decay_time += pos_delta;
	if(decay.value() > 0.0)
		pulse = pulse * (1.0 - decay_time / decay.value());
	else
		pulse = 0.0;

	if(pulse < 0.0)
		pulse = 0.0;
	if(pulse > 1.0)
		pulse = 1.0;

	out.value(pulse);
}

save_state() {
	state = [
		bpm=bpm.value(),
		beats=beats.value(),
		decay=decay.value(),
	];
	return state;
}

load_state(state) {
	if(state.has("bpm"))
		bpm.value(state.bpm);
	if(state.has("beats"))
		beats.value(state.beats);
	if(state.has("decay"))
		decay.value(state.decay);
}
