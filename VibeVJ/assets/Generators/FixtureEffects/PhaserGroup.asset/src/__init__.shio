
engine = None;

target_list = None;

control_targets = [];

priority_ctrl = None;

clip_transit_active = false;
clip_is_transit_a = true;
clip_transition_value = 1.0;
clip_is_preview = false;

add_target(guid = "", open_settings = false) {
	
	if(!guid)
		guid = std.random_hash();
	
	cnt = target_list.widget().layout(nanogui.layout_vertical());

	splitter = cnt.widget().fixed_height(30).layout(nanogui.layout_horizontal());
	slider = splitter.controlslider("Control", guid).anchor(0).anchor_right(50);
	settings_btn = splitter.pushbutton("S").anchor_right(25).fixed_width(25).pushed(open_settings);
	delete_btn = splitter.button("X").anchor_right(0).fixed_width(25);

	setts = cnt.widget().layout(nanogui.layout_vertical());

	setts.visible(open_settings);
	
	settings_btn.on_change([setts](v){
		setts.visible(v);
	});

	control_targets[guid] = [
		cnt=cnt,
		guid=guid,
		slider=slider,
	];

	delete_btn.on_click([guid, cnt](){
		control_targets.erase(guid);
		std.free(cnt);
	});
	
	current_target = control_targets[guid];
	
	target_fixture = setts.combobox().items(["Select Fixture"]);
	target_fixture.on_open([target_fixture](){
		
		items = ["Select Fixture"];
		
		for(i = 0; i < engine.fixtures.size(); i++) {
			items.push_back(fileio.pure_name(engine.fixtures.key(i)));
		}
		
		target_fixture.items(items);
	});
	
	target_channel = setts.combobox().items(["Select Channel"]);
	target_channel.on_open([target_channel, target_fixture](){
		
		items = ["Select Channel"];
		target_channel.items(items);
		
		id = target_fixture.selected();
		if(id == 0)
			return;
		id--;
		if(id >= engine.fixtures.size())
			return;
		
		fixture_config = fileio.read_json(engine.fixtures.key(id));

		for(i = 0; i < fixture_config.channels.size(); i++) {
			if(fixture_config.channels[i].batch_count > 1) {				
				for(j = 0; j < fixture_config.channels[i].batch_count; j++) {
					if(fixture_config.channels[i].type == "RGB")
						items.push_back(fixture_config.channels[i].name + " - R" + " (" + (j+1) + ")");
						items.push_back(fixture_config.channels[i].name + " - G" + " (" + (j+1) + ")");
						items.push_back(fixture_config.channels[i].name + " - B" + " (" + (j+1) + ")");
					else if(fixture_config.channels[i].type == "RGBW")
						items.push_back(fixture_config.channels[i].name + " - R" + " (" + (j+1) + ")");
						items.push_back(fixture_config.channels[i].name + " - G" + " (" + (j+1) + ")");
						items.push_back(fixture_config.channels[i].name + " - B" + " (" + (j+1) + ")");
						items.push_back(fixture_config.channels[i].name + " - W" + " (" + (j+1) + ")");
					else
						items.push_back(fixture_config.channels[i].name + " (" + (j+1) + ")");
				}
			}
			else {
				if(fixture_config.channels[i].type == "RGB")
					items.push_back(fixture_config.channels[i].name + " - R");
					items.push_back(fixture_config.channels[i].name + " - G");
					items.push_back(fixture_config.channels[i].name + " - B");
				else if(fixture_config.channels[i].type == "RGBW")
					items.push_back(fixture_config.channels[i].name + " - R");
					items.push_back(fixture_config.channels[i].name + " - G");
					items.push_back(fixture_config.channels[i].name + " - B");
					items.push_back(fixture_config.channels[i].name + " - W");
				else
					items.push_back(fixture_config.channels[i].name);
			}
		}
		
		target_channel.items(items);
	});
	
	target_channel.on_change([target_fixture, slider, current_target](index, txt){
		
		if(index == 0)
			return;
		index--;
		target_name = fileio.pure_name(engine.fixtures.key(target_fixture.selected()-1));
		slider.display_name(target_name + " > " + txt);
		
		current_target.target_fixture = engine.fixtures.key(target_fixture.selected()-1);
		current_target.target_control_name = txt;
		current_target.target_control_index = index;
		current_target.target_controls = [];
	});
	
	current_target.phase_mode = setts.controlcombo("phase_mode", guid).items(["INDEX", "CENTER UV", "LEFT UV", "RIGHT UV"]);
	current_target.phase_duration = setts.controlfloat("Phase Delay", guid).min(0).value(1.0);
	current_target.start_device = setts.controlint("Start device", guid).min(0).max(99999);
	current_target.end_device = setts.controlint("End device", guid).min(-1).max(99999).value(-1);
	current_target.auto_mirrorx = setts.controlbutton("Auto Mirror X", guid).push(1);
	current_target.auto_mirrory = setts.controlbutton("Auto Mirror Y", guid).push(1);
}

#include "engine/generators/generatorview"

managed view = None;

dispatcher(generator, cmd, value) {
	if(cmd == "active") {
		clip_transit_active = false;
		if(value && !generator.active_btn.value())
			return;
	}
	
	if(cmd == "transition")
		if(value.value != 1.0)
			clip_transit_active = true;
		else
			clip_transit_active = false;
		clip_transition_value = value.value;
		clip_is_transit_a = value.is_transit_a;
	
	if(cmd == "clip_preview")
		clip_is_preview = value;
	
	return view.dispatch(cmd, value);
}

entry(generator, area) {
	
	area.layout(None);

	ctrl_area = area.widget().anchor_top(0).anchor_right(0).anchor_bottom(0).fixed_width(250);
	view_area = area.widget().anchor_top(0).anchor_left(0).anchor_right(250).anchor_bottom(0);
	
	ctrl_area.layout(nanogui.layout_vertical());
	
	view = generatorview(view_area);
	view.area.fixed_size(vec2f(1024,1024));
	
	engine = generator.engine;
	
	add_target_btn = ctrl_area.button("Add Target").anchor_top(0).anchor_left(0).anchor_right(0).fixed_height(27);
	priority_ctrl = ctrl_area.controlint("Priority").anchor_top(30).anchor_left(0).anchor_right(0).fixed_height(30);
	
	add_target_btn.on_click([](){
		add_target("", true);
	});

	//Weird that I have to set fixed_width for this...
	target_list = ctrl_area.vscroll().anchor(0).anchor_top(60).content().layout(nanogui.layout_vertical()).fixed_width(ctrl_area.fixed_width());	
}

current_timeline = 0;

update_control_target(target) {
	if(!target.target_control_name ?? false)
		return;

	//Important TODO:
	//Instead of having "target_buffers" and a buffer for each fixture instance, instead have one "delay_buffer" and indivisual read heads for each fixture
	//The last read head then pops the buffer when necessary, uses way less memory

	if(!target.target_controls && target.target_control_name && target.target_fixture) {
		if(engine.fixture_menu.active_fixtures.has(target.target_fixture)) {
			targets = engine.fixture_menu.active_fixtures[target.target_fixture].instances_controls;
			target_instance = engine.fixtures[target.target_fixture].instances;
			for(i = 0; i < targets.size(); i++) {
				target_ctrls = targets[i];
				if(target,target_control_index < target_ctrls.size())
					target.target_controls.push_back([
						control=target_ctrls[target.target_control_index],
						uv = target_instance[i].uv_pos,
					]);
			}
			
			target.target_buffers = [];
			target.target_buffers.resize(target.target_controls.size());
		}
	}

	phase_mode = target.phase_mode.value();
	max_index = target.target_controls.size();

	set_control_value(ctrl, value) {
		
		//Use short names here for faster internal string checks
		current_frame = nanogui.current_context().frame_index();
		current_prio = priority_ctrl.value();
		
		if(current_frame == ctrl.attr.ph_id) {
			if(current_prio < ctrl.attr.ph_pr)
				return;
		}
		
		ctrl.attr.ph_pr = clip_is_preview ? 999999 : current_prio;
		ctrl.attr.ph_id = current_frame;
		
		//std.print(ctrl.attr);
		
		if(!clip_transit_active)
			ctrl.value(value);
			return;

		//Since all of these controls should be sliders, envelope_value should be safe here
		//We use this instead of value() so envelopes set on the control do not affect the calculations here...
		if(clip_is_transit_a)
			ctrl.value(ctrl.envelope_value() * (1.0 - clip_transition_value) + value * clip_transition_value);
		else
			ctrl.value(ctrl.envelope_value() * (1.0 - clip_transition_value) + value * clip_transition_value);
	}

	if(phase_mode == 0) {
		for(i = 0; i < max_index; i++) {
	
			phase_perc = i / std.float(max_index-1);	
			value_delay = target.phase_duration.value()*phase_perc;
			value = target.slider.value();
			
			if(target.auto_mirrorx.value() && target.target_controls[i].uv.x < 0.0)
				value = 1.0 - value;
			if(target.auto_mirrory.value() && target.target_controls[i].uv.y < 0.0)
				value = 1.0 - value;
			
			if(value_delay <= 0.0001)
				set_control_value(target.target_controls[i].control, value);
			else
				target.target_buffers[i].push_back([time=current_timeline+value_delay, value=value]);
				target_buffer = target.target_buffers[i];
				if(current_timeline >= target_buffer[0].time)
					set_control_value(target.target_controls[i].control, target_buffer[0].value);
					target_buffer.erase(0);
		}
	}
}

update_pre(generator, tl_pos, pos_delta) {	
	current_timeline = tl_pos;
}

update_post(generator) {
	for(i = 0; i < control_targets.size(); i++) {
		update_control_target(control_targets[i]);
	}
}

save_state() {
	state = [view=view.save_state()];
	
	for(i = 0; i < control_targets.size(); i++) {
		state.items[control_targets[i].guid] = [
			fixture=control_targets[i].target_fixture,
			control_name=control_targets[i].target_control_name,
			control_index=control_targets[i].target_control_index,
		];
	}
	
	return state;
}

load_state(state) {
	
	control_targets.clear();
	
	for(i = 0; i < state.items.size(); i++) {
		guid = state.items.key(i);
		add_target(guid);
		control_targets[guid].target_fixture = state.items[i].fixture;
		control_targets[guid].target_control_name = state.items[i].control_name;
		control_targets[guid].target_control_index = state.items[i].control_index;
	}
	
	view.load_state(state.view);
}
