
// Audio analysis (beat, BPM, FFT, energy) of the sound card input, or of the audio a prolink-bridge
// ESP32 sends (onboard microphone or line-in, firmware command "audio mic|line"):
//   SOURCE "ESP32 USB":     the ESP32 on USB (shares the port with the Prolink generators)
//   SOURCE "ESP32 NETWORK": a relay ESP32 in the network over ShizoNet (the prolink module receives it)
// The analysis runs in a subprocess (engine/processes/audio_process.shio); for the ESP32 it gets
// the samples over ipc instead of opening the sound card.
import subprocess;
import ipc;
import prolink;

using eigen;

managed audio_check_thread = None;
managed audio_process = None;
managed ipc_handle = None;
managed ipc_handle_in = None;

ipc_name = "shizoserver_" + std.random_hash();

SOURCE_LOCAL = 0;
SOURCE_ESP_USB = 1;
SOURCE_ESP_NETWORK = 2;

managed esp = None;      // prolink connection for SOURCE "ESP32 USB"
audio_source = -1;       // source the subprocess was started for
source_ctrl = None;
esp_port = None;
esp_status = None;
esp_status_text = "";
net_origin = 0;          // 1 = listener behind the relay, 2 = relay; the first one wins until it stops
net_last_ms = 0;
last_audio_ms = 0;
last_audio_rate = 0;
pcm_paused_until = 0;    // ipc queue full (analysis not reading): don't block the UI with more sends
settings_sent_ms = 0;    // settings go out every SETTINGS_MS (the subprocess exits after 3 s without)
SETTINGS_MS = 250;
MAX_PCM_PER_FRAME = 12;  // older chunks after a stall are dropped (stale for beat tracking anyway)

dispatcher(generator, cmd, value) {
	
}

restart_timeout = 0;

restart_audio_process() {
	if(!audio_process || audio_process.exited()) {
		
		if(restart_timeout) {
			if((std.millis() - restart_timeout) < 1000 * 4)
				return;
		}
		
		restart_timeout = std.millis();
		
		std.print("starting audio...");
		
		try {
			audio_process = None;
		
			exe_path = std.local_executable();
			
			args = [
				exe_path,
				"engine.processes.audio_process",
				ipc_name,
			];
			if(audio_source != SOURCE_LOCAL)
				args.push_back("external");

			audio_process = subprocess.process();
			audio_process.terminate_on_destroy(true);
			audio_process.start(args, std.wd(), false);
			audio_process.terminate_on_destroy(true);
			
			std.print("audio started.");
		}
		catch(e) {}
	}	
}

set_esp_status(text) {
	if(esp_status && text != esp_status_text) {
		esp_status_text = text;
		esp_status.text(text);
	}
}

// Samples for the subprocess: binary int16 little-endian mono, as delivered by prolink
send_pcm(rate, data) {
	// Only while the analysis runs: during a restart nobody reads the queue, and every send would block
	if(!ipc_handle_in || !audio_process || audio_process.exited())
		return;
	if(pcm_paused_until && std.millis() < pcm_paused_until)
		return;
	ok = ipc_handle_in.send([
		type = "pcm",
		rate = rate,
		data = data,
	]);
	if(!ok) {
		pcm_paused_until = std.millis() + 2000;
		return;
	}
	pcm_paused_until = 0;
	last_audio_ms = std.millis();
	last_audio_rate = rate;
}

// Source changed (also after loading a project): restart the subprocess with or without sound card
apply_source() {
	audio_source = source_ctrl.value();
	esp = None;
	net_origin = 0;
	last_audio_ms = 0;
	if(audio_source == SOURCE_ESP_USB) {
		esp = prolink.device();
		esp.open(esp_port.value());
	}
	audio_process = None; // terminates the old one
	restart_timeout = 0;
	restart_audio_process();
}

update_esp() {
	if(audio_source == SOURCE_LOCAL) {
		set_esp_status("Sound card");
		return;
	}
	
	if(audio_source == SOURCE_ESP_USB && esp) {
		chunks = esp.take_audio(false); // only rate and data are used, skip the per-sample float list
		first = 0;
		if(chunks.size() > MAX_PCM_PER_FRAME)
			first = chunks.size() - MAX_PCM_PER_FRAME;
		for(i = first; i < chunks.size(); i++)
			send_pcm(chunks[i].rate, chunks[i].data);
	}
	
	if(audio_source == SOURCE_ESP_NETWORK) {
		// Listener and relay may both send audio: stay with the first one until it stops for a second
		now = std.millis();
		chunks = prolink.take_net_audio(false);
		first = 0;
		if(chunks.size() > MAX_PCM_PER_FRAME * 2)
			first = chunks.size() - MAX_PCM_PER_FRAME * 2; // two sources possible
		for(i = first; i < chunks.size(); i++) {
			c = chunks[i];
			if(c.source != net_origin) {
				if(net_origin && now - net_last_ms < 1000)
					continue;
				net_origin = c.source;
			}
			net_last_ms = now;
			send_pcm(c.rate, c.data);
		}
	}
	
	if(last_audio_ms && std.millis() - last_audio_ms < 1000) {
		via = "USB";
		if(audio_source == SOURCE_ESP_NETWORK) {
			via = "relay";
			if(net_origin == 1)
				via = "listener via relay";
		}
		set_esp_status("ESP32 " + via + ": " + std.string(last_audio_rate / 1000) + " kHz");
	}
	else if(audio_source == SOURCE_ESP_USB && esp && !esp.connected())
		set_esp_status("ESP32 not connected");
	else
		set_esp_status("No audio from the ESP32 (firmware: audio mic|line)");
}

shader_src = R"(
#version 330 core

uniform sampler2D fftTexture;

float line(float y, float center, float width)
{
    return 1.0 - smoothstep(width, width * 2.0, abs(y - center));
}

void main()
{
    vec2 uv = v_uv;

    vec3 color = vec3(0.015, 0.018, 0.025);

    // ------------------------------------------------------------
    // Background Grid
    // ------------------------------------------------------------
    float gridX = smoothstep(0.98,1.0,abs(fract(uv.x*32.0)-0.5)*2.0);
    float gridY = smoothstep(0.98,1.0,abs(fract(uv.y*16.0)-0.5)*2.0);

    color += vec3(0.04)*(gridX+gridY)*0.25;

    // ============================================================
    // FFT
    // ============================================================
    if(uv.y < 0.5)
    {
        vec2 fuv = vec2(uv.x,0.25);

        float fft = clamp(texture(fftTexture,fuv).r,0.0,1.0);

        // Scale into top half
        fft *= 0.48;

        float bar = step(uv.y, fft);

        // Nice vertical gradient
        vec3 barColor =
            mix(vec3(0.0,0.5,1.0),
                vec3(0.0,1.0,0.75),
                fft*2.0);

        // Glow around bar edge
        float glow = exp(-80.0*abs(uv.y-fft));

        color += barColor * bar;
        color += barColor * glow * 0.7;

        // Peak highlight
        color += vec3(1.0) * line(uv.y, fft, 0.002);

        // Reflection
        color += barColor * bar *
                 (1.0-uv.y*2.0) *
                 0.18;
    }

    // ============================================================
    // Waveform
    // ============================================================
    else
    {
        vec2 wuv = vec2(uv.x,0.75);

        float sample = texture(fftTexture,wuv).r;
        sample = clamp(sample,-1.0,1.0);

        float center = 0.75;

        float ypos = center + sample*0.20;

        float waveform = line(uv.y,ypos,0.003);

        vec3 waveColor = vec3(1.0,0.35,0.15);

        color += waveColor * waveform;

        // Glow
        color += waveColor * waveform * 2.0;

        // Fill to center
        float fill = smoothstep(0.0,0.01,
            abs(uv.y-center)-abs(sample*0.20));

        color += waveColor*(1.0-fill)*0.18;

        // Center line
        color += vec3(0.25)*line(uv.y,center,0.0015);
    }

    // Divider
    color += vec3(0.15) * line(uv.y,0.5,0.001);

    // Mild vignette
    float vignette =
        smoothstep(1.2,0.3,length(uv-0.5));

    color *= vignette;

    // Gamma
    color = pow(color, vec3(0.85));

    fragColor = vec4(color,1.0);
}

)";

entry(generator, area) {	

	generator.window.fixed_size(vec2f(500,550));

	top_area = area.vscroll().anchor(0).anchor_bottom(0);
	//out_area = area.widget().anchor_bottom(0).fixed_height(20);
	
	area = top_area.content().layout(nanogui.layout_vertical());

	sync = area.controlbutton("TIMELINE BPM SYNC").push(1);
	
	source_ctrl = area.controlcombo("SOURCE");
	source_ctrl.items(["LOCAL", "ESP32 USB", "ESP32 NETWORK"]);
	esp_status = area.label("Sound card").fixed_height(20);
	
	out = area.control("FFT TEXTURE OUT", "output_ctrls");

	bpm = area.controlfloat("BPM").max(999);
	beat = area.controlslider("BEAT");
	
	low_energy = area.controlslider("LOW ENERGY");
	mid_energy = area.controlslider("MID ENERGY");
	high_energy = area.controlslider("HIGH ENERGY");
	
	beat_cnt = area.collapsable("Settings").content().layout(nanogui.layout_vertical());
	fix_bpm = beat_cnt.controlfloat("Fix BPM").min(-1).max(999).value(-1);
	phase = beat_cnt.controlslider("Phase offset").min(-0.5).max(0.5).value(0.0);
	
	break_treshold = beat_cnt.controlslider("Break Treshold").value(0.3);
	drop_treshold = beat_cnt.controlslider("Drop Treshold").value(0.6);
	
	low_energy_cutoff = beat_cnt.controlslider("Low Energy Cutoff").min(20).max(20000).value(250);
	high_energy_cutoff = beat_cnt.controlslider("High Energy Cutoff").min(20).max(20000).value(4000);
	esp_port = beat_cnt.controltext("ESP32 PORT (empty = auto)").value("");
	
	vars_cnt = area.collapsable("Analysis").content().layout(nanogui.layout_vertical());
	
	score = vars_cnt.controlslider("SCORE").max(10000);
	break_ctrl = vars_cnt.controlslider("BREAK");
	break_ctrl2 = vars_cnt.controlslider("BREAK INV");
	
	fft_cnt = area.collapsable("FFT").content().layout(nanogui.layout_vertical());
	
	fft_band_smoothing = fft_cnt.controlslider("Band Smoothing").max(50).value(5);
	fft_attack = fft_cnt.controlslider("Attack").value(0.2);
	fft_decay =  fft_cnt.controlslider("Decay").value(1.0);
	fft_release = fft_cnt.controlslider("Release").value(0.08);
	fft_nfloor = fft_cnt.controlslider("Noise Floor").value(0.6);
	
	fft_shader = area.shader();
	fft_shader.fragment_source(shader_src);
	fft_shader.render_size(vec2i(1024,256));
	
	fft_image = fft_cnt.image().visible(false);
	fft_texture = fft_image.texture();
	fft_texture.pixel_format("r").component_format("float32").size(vec2i(512,2));
	
	fft_shader.input("fftTexture", fft_image);
	
	ipc_handle = ipc.ipc();
	ipc_handle_in = ipc.ipc();
	
	ipc_handle.connect(ipc_name, true);

	get_phase = [phase](current_phase) {
		current_phase = phase.value() + current_phase;
		if(current_phase > 1.0)
			current_phase -= 1.0;
		if(current_phase < 0.0)
			current_phase += 1.0;
		return current_phase;
	};
	
	ipc_handle.on_message([beat, bpm, score, break_ctrl, break_ctrl2, get_phase, fft_texture,
	low_energy, mid_energy, high_energy](msg) {
		if(msg.type == "info") {
			beat.value(get_phase(msg.phase));
			score.value(msg.cum_score);
			bpm_delta = msg.bpm - bpm.value();
			bpm.value(bpm.value() + bpm_delta * 0.1);
			break_ctrl.value(msg.break_detected);
			break_ctrl2.value(!msg.break_detected);
			
			low_energy.value(msg.energy[0]);
			mid_energy.value(msg.energy[1]);
			high_energy.value(msg.energy[2]);
			
			texture_buffer = msg.normalized_bands + msg.waveform;
			
			fft_texture.upload_data(texture_buffer);
		}
		else if(msg.type == "beat")
		{
			//todo trigger beat control or something
		}
	});
	
	audio_source = source_ctrl.value();
	if(audio_source == SOURCE_ESP_USB) {
		esp = prolink.device();
		esp.open(esp_port.value());
	}
	// Created here (process A), the subprocess only opens it: the channel survives its restarts
	ipc_handle_in.connect(ipc_name+ "_in", true);
	
	restart_audio_process();
	
	timeline = std.global("timeline");
	
	generator.pre_callback([timeline, beat, bpm, sync, fix_bpm, break_treshold, drop_treshold,
	fft_band_smoothing, fft_attack, fft_decay, fft_release, fft_nfloor,
	low_energy_cutoff, high_energy_cutoff](generator, tl_pos, pos_delta){	
		
		// Settings a few times per second, and only while the analysis runs: nobody reads the queue during a
		// restart, and once it is full every send blocks the UI for up to 5 s
		now = std.millis();
		alive = audio_process && !audio_process.exited();
		if(alive && now - settings_sent_ms >= SETTINGS_MS && (!pcm_paused_until || now >= pcm_paused_until)) {
			settings_sent_ms = now;
			ok = ipc_handle_in.send([
				fix_bpm = fix_bpm.value(),
				break_treshold = break_treshold.value(),
				drop_treshold = drop_treshold.value(),
				band_smoothing = fft_band_smoothing.value(),
				attack = fft_attack.value(),
				release = fft_release.value(),
				decay = fft_decay.value(),
				noise_floor = fft_nfloor.value(),
				low_cutoff = low_energy_cutoff.value(),
				high_cutoff = high_energy_cutoff.value(),
			]);
			if(!ok)
				pcm_paused_until = now + 2000;
		}
		
		if(source_ctrl.value() != audio_source)
			apply_source();
		update_esp();
		
		restart_audio_process();
		
		current_phase = beat.value();
		
		if(sync.value())
			timeline.set_bpm(bpm.value());
			timeline.nudge_position(current_phase);
	});
	
	out.value(fft_image);
	out.callback([out, fft_image](v){
		//Reset value back to shader...
		out.value(fft_image);
	});
}