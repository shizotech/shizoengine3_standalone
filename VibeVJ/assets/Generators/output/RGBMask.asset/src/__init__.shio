//RGB mask: the average colour of a part of a picture. Draw rectangles or lines on the picture (In); Red, Green, Blue
//and Out give the average colour inside them, for a lamp that follows that part of the picture.
//
//Three shaders: the view on the right shows the picture with the shapes drawn over it (on_draw), a hidden mask shader
//paints the shapes white on black into its texture (render_draw), and a hidden averaging shader keeps the picture only
//where the mask is white. Its pixels are read back and averaged on the CPU after each frame (update_post).
//The draw callbacks run on the render thread: they only use what they capture by value, the shapes are kept in the
//view's attr (view_shader.attr.shapes / .drag / .kind).
//The control IDs stay ("Shape" is new, "RES", "IN", "R", "G", "B", "OUT"), and so do the save_state keys.

import nanogui; //For nvg*

using eigen;
using nanogui;

managed view_shader = None;
managed mask_shader = None;
managed avg_shader = None;
managed in_ctrl = None;
managed out_r = None;
managed out_g = None;
managed out_b = None;
managed out_color = None;
managed color_disp = None;
managed shape_select = None;
managed clear_btn = None;
managed res_ctrl = None;
RES_SIZES = [16, 32, 64, 128, 256, 512];
RES_ITEMS = ["16 px", "32 px", "64 px", "128 px", "256 px", "512 px"];

managed default_input = None;
managed default_output = None;

LEFT_W = 160;
GAP = 4;

// Mask shapes: normalized [x1, y1, x2, y2, type] entries, type 0 = rectangle, 1 = line.
mask_shapes = [];
current_shape_type = 0;

dispatcher(generator, cmd, value) {
	if(cmd == "get_default_input")
		return default_input;
	if(cmd == "get_default_output")
		return default_output;
}

//A theme colour ({r,g,b,a} 0..1) as vec4f, the token default when the theme does not have it
theme_color(t, key, fallback) {
	if(t && t.has(key)) {
		c = t[key];
		return vec4f(c.r, c.g, c.b, c.a);
	}
	return fallback;
}

// Hidden mask shader: outputs pure black. The mask shapes are painted white on top by its render_draw callback, so the
// texture is white exactly where the user drew a shape.
mask_shader_src = R"(
#version 330 core

void main()
{
    fragColor = vec4(0.0);
}
)";

// Averaging shader: renders the picture, but only where the mask is non-black.
avg_shader_src = R"(
#version 330 core

uniform sampler2D input;
uniform sampler2D mask;

void main()
{
    vec4 in_color = texture(input, v_uv);
    vec4 m = texture(mask, v_uv);

    float mmax = max(m.r, max(m.g, m.b));

    if(mmax <= 0.001)
    {
        fragColor = vec4(0.0);
        return;
    }

    fragColor = in_color;
}
)";

// Display shader of the view: shows the picture; the shapes are drawn over it.
view_shader_src = R"(
#version 330 core

uniform sampler2D input;

void main()
{
    fragColor = texture(input, v_uv);
}
)";

//The shapes (and the one being drawn) to the view's attr, where the draw callbacks read them
publish_shapes() {
	view_shader.attr.shapes = mask_shapes;
	view_shader.attr.kind = current_shape_type;
}

// Compute the average color of the masked-in picture on the CPU and push it to the outputs. Called after each frame.
update_post(generator) {
	buffer = avg_shader.pixel_buffer();
	n = buffer.size();
	if(n == 0)
		return;

	px = n / 3;
	sr = 0.0;
	sg = 0.0;
	sb = 0.0;
	cnt = 0;

	for(i = 0; i < px; i++) {
		r = buffer[i*3];
		g = buffer[i*3+1];
		b = buffer[i*3+2];
		// Only count non-black (masked-in) pixels
		if(r != 0 || g != 0 || b != 0) {
			sr += r;
			sg += g;
			sb += b;
			cnt++;
		}
	}

	r_avg = 0.0;
	g_avg = 0.0;
	b_avg = 0.0;
	if(cnt > 0) {
		r_avg = sr / cnt / 255.0;
		g_avg = sg / cnt / 255.0;
		b_avg = sb / cnt / 255.0;
	}

	// notify_links=true so linked controls get updated.
	out_r.value(r_avg, false, true);
	out_g.value(g_avg, false, true);
	out_b.value(b_avg, false, true);
	out_color.value([r=r_avg, g=g_avg, b=b_avg]);
	color_disp.rgb(r_avg, g_avg, b_avg);
}

entry(generator, area) {
	generator.window.fixed_size(vec2f(560, 520));

	area.layout(None);
	t = area.theme().to_json();
	c_accent = theme_color(t, "accent_color", vec4f(157 / 255.0, 133 / 255.0, 255 / 255.0, 1.0));
	c_text_3 = theme_color(t, "disabled_text_color", vec4f(94 / 255.0, 94 / 255.0, 99 / 255.0, 1.0));

	// ---- Left column: shape, clear, resolution, In ----
	left_ctrls = area.widget().anchor_left(0).anchor_top(0).anchor_bottom(0).fixed_width(LEFT_W).layout(nanogui.layout_vertical().spacing(GAP));

	shape_select = left_ctrls.controlcombo("Shape").tooltip("What a drag on the picture draws: a rectangle or a line");
	shape_select.items(["Rectangle", "Line"]).segmented(true, false); //index-based (0 = rectangle, 1 = line)
	shape_select.callback([](v) {
		current_shape_type = v;
		publish_shapes();
	});

	clear_btn = left_ctrls.button("Clear").icon(nanogui.icon("trash")).danger("hover").tooltip("Removes the shapes you drew");
	clear_btn.on_click([]() {
		mask_shapes = [];
		view_shader.attr.drag = None;
		publish_shapes();
	});

	// ---- Right area: the picture with the shapes, below it the colour ----
	OUT_H = 40 + 4 * (30 + GAP);
	right_area = area.widget().anchor_left(LEFT_W + 8).anchor_right(0).anchor_top(0).anchor_bottom(0);

	// (1) The view: the picture, the shapes are drawn over it. Stretched to the widget, so the shapes (in 0..1 of the
	// widget) lie on the same part of the picture as in the mask.
	view_shader = right_area.shader().anchor_left(0).anchor_right(0).anchor_top(0).anchor_bottom(OUT_H + GAP);
	view_shader.fragment_source(view_shader_src);
	view_shader.render_size(vec2i(360, 240));
	view_shader.keep_aspect_ratio(false);
	view_shader.tooltip("Drag on the picture to draw a shape: the colour is averaged inside the shapes");
	view_shader.attr.drag = None;
	publish_shapes();

	// Shapes in the accent colour (selection), the one being drawn fainter. Render thread: only captured values.
	view_shader.on_draw([view_shader, c_accent, c_text_3]() {
		s = view_shader.size();
		shapes = view_shader.attr.shapes ?? [];
		fill = vec4f(c_accent.x, c_accent.y, c_accent.z, 0.25);
		line = vec4f(c_accent.x, c_accent.y, c_accent.z, 0.9);
		if(shapes.size() == 0 && !view_shader.attr.drag) {
			nvgFontSize(13);
			nvgFontFace("sans");
			nvgFillColor(c_text_3);
			nvgTextAlign(18);
			nvgText(vec2f(s.x / 2.0, s.y / 2.0), "Drag on the picture to draw a shape");
		}
		for(i = 0; i < shapes.size(); i++) {
			shp = shapes[i];
			x1 = shp.x1 * s.x;
			y1 = shp.y1 * s.y;
			x2 = shp.x2 * s.x;
			y2 = shp.y2 * s.y;

			nvgBeginPath();
			if(shp.type == 1) {
				nvgMoveTo(vec2f(x1, y1));
				nvgLineTo(vec2f(x2, y2));
				nvgStrokeWidth(6.0);
				nvgStrokeColor(line);
				nvgStroke();
			} else {
				nvgRect(vec2f(math.min(x1, x2), math.min(y1, y2)), vec2f(math.abs(x2 - x1), math.abs(y2 - y1)));
				nvgFillColor(fill);
				nvgFill();
				nvgStrokeWidth(1.5);
				nvgStrokeColor(line);
				nvgStroke();
			}
		}

		d = view_shader.attr.drag;
		if(d) {
			x1 = d.x1 * s.x;
			y1 = d.y1 * s.y;
			x2 = d.x2 * s.x;
			y2 = d.y2 * s.y;
			nvgBeginPath();
			if(view_shader.attr.kind == 1) {
				nvgMoveTo(vec2f(x1, y1));
				nvgLineTo(vec2f(x2, y2));
				nvgStrokeWidth(6.0);
				nvgStrokeColor(vec4f(c_accent.x, c_accent.y, c_accent.z, 0.6));
				nvgStroke();
			} else {
				nvgRect(vec2f(math.min(x1, x2), math.min(y1, y2)), vec2f(math.abs(x2 - x1), math.abs(y2 - y1)));
				nvgFillColor(vec4f(c_accent.x, c_accent.y, c_accent.z, 0.15));
				nvgFill();
				nvgStrokeWidth(1.5);
				nvgStrokeColor(vec4f(c_accent.x, c_accent.y, c_accent.z, 0.6));
				nvgStroke();
			}
		}
	});

	// Drag to draw a new shape; the points are kept in 0..1 of the view
	view_shader.on_mouse_button([](pos, button, down, mods) {
		if(button != 0)
			return false;
		w = view_shader.width();
		h = view_shader.height();
		if(w <= 0 || h <= 0)
			return true;
		// The press comes as a Vector2i: pos.x / w was an integer division (0), every shape started in the corner
		x = math.clamp(std.float(pos.x) / w, 0.0, 1.0);
		y = math.clamp(std.float(pos.y) / h, 0.0, 1.0);
		if(down) {
			view_shader.attr.drag = [x1 = x, y1 = y, x2 = x, y2 = y];
			return true;
		}
		d = view_shader.attr.drag;
		if(d) {
			// The end is where the drag was last: a release outside the view comes in the coordinates of its parent,
			// not of the view. A click without a drag draws nothing
			if(math.abs(d.x2 - d.x1) * w > 2 || math.abs(d.y2 - d.y1) * h > 2)
				mask_shapes.push_back([x1 = d.x1, y1 = d.y1, x2 = d.x2, y2 = d.y2, type = current_shape_type]);
			view_shader.attr.drag = None;
			publish_shapes();
		}
		return true;
	});
	view_shader.on_mouse_drag([](pos, rel, button, mods) {
		d = view_shader.attr.drag;
		if(!d)
			return false;
		w = view_shader.width();
		h = view_shader.height();
		// Drag positions come in the coordinates of the parent: subtract the view's position
		p = view_shader.position();
		if(w > 0 && h > 0) {
			d.x2 = math.clamp((pos.x - p.x) / w, 0.0, 1.0);
			d.y2 = math.clamp((pos.y - p.y) / h, 0.0, 1.0);
		}
		return true;
	});

	// (2) Hidden mask shader: white shapes on black, painted into its texture by render_draw.
	mask_shader = right_area.shader().visible(false).fixed_height(20);
	mask_shader.fragment_source(mask_shader_src);
	mask_shader.render_size(vec2i(32, 32));
	mask_shader.pixel_readback(true);
	mask_shader.output_component_format("uint8");
	mask_shader.output_pixel_format("rgb");
	mask_shader.render_draw([mask_shader, view_shader]() {
		rs = mask_shader.render_size();
		sx = rs.x * 1.0;
		sy = rs.y * 1.0;
		shapes = view_shader.attr.shapes ?? [];
		white = vec4f(1, 1, 1, 1);
		for(i = 0; i < shapes.size(); i++) {
			shp = shapes[i];
			x1 = shp.x1 * sx;
			y1 = shp.y1 * sy;
			x2 = shp.x2 * sx;
			y2 = shp.y2 * sy;
			nvgBeginPath();
			if(shp.type == 1) {
				nvgMoveTo(vec2f(x1, y1));
				nvgLineTo(vec2f(x2, y2));
				nvgStrokeWidth(math.max(1.0, sx / 45.0)); // as wide as the line in the view (6 px of about 270)
				nvgStrokeColor(white);
				nvgStroke();
			} else {
				nvgRect(vec2f(math.min(x1, x2), math.min(y1, y2)), vec2f(math.max(1.0, math.abs(x2 - x1)), math.max(1.0, math.abs(y2 - y1))));
				nvgFillColor(white);
				nvgFill();
			}
		}
	});

	// (3) Hidden averaging shader (picture + mask).
	avg_shader = right_area.shader().visible(false).fixed_height(20);
	avg_shader.fragment_source(avg_shader_src);
	avg_shader.render_size(vec2i(32, 32));
	avg_shader.pixel_readback(true);
	avg_shader.output_component_format("uint8");
	avg_shader.output_pixel_format("rgb");

	// The mask shader goes into the "mask" uniform of the averaging shader, the picture into "input" (In). input()
	// takes a shader (a picture source): its texture was dropped there, the mask stayed unbound and the averaging
	// read the picture as its mask, so the colour was always the one of the whole picture (#436)
	avg_shader.input("mask", mask_shader);

	// Resolution of the hidden mask and averaging shaders. Low (32) is fast and enough for an average.
	res_ctrl = left_ctrls.controlcombo("RES", "uniforms").caption("Resolution").tooltip("The size the picture and the shapes are shrunk to before the colour is averaged. Low is fast and is enough for an average");
	res_ctrl.items(RES_ITEMS); //index-based, the same order as before (16 … 512)
	res_ctrl.selected_index(1); // 32
	res_ctrl.callback([](v) {
		if(v == None || v < 0 || v >= RES_SIZES.size())
			return;
		res = RES_SIZES[v];
		mask_shader.render_size(vec2i(res, res));
		avg_shader.render_size(vec2i(res, res));
	});

	// In: the picture (created after the view and averaging shaders, its callbacks use them)
	in_ctrl = left_ctrls.control("IN", "input_ctrls").caption("In").tooltip("The picture to read the colour from: [[link]] a picture into it");
	in_ctrl.on_unlink([](c1, c2) {
		if(c2 == in_ctrl) {
			view_shader.input("input", None);
			avg_shader.input("input", None);
		}
	});
	in_ctrl.callback([](v) {
		view_shader.input("input", v);
		avg_shader.input("input", v);
	});
	default_input = in_ctrl;

	// (4) The colour and the outputs, below the view
	out_area = right_area.widget().anchor_left(0).anchor_right(0).anchor_bottom(0).fixed_height(OUT_H).layout(nanogui.layout_vertical().spacing(GAP));
	color_disp = out_area.color_selector().fixed_height(40).tooltip("The average colour inside the shapes");

	// Written after every frame: pure outputs
	out_r = out_area.controlslider("R", "output_ctrls").caption("Red").as_output(true).tooltip("Red of the average colour inside the shapes, 0 to 1. A [[pure output]]").min(0).max(1.0);
	out_g = out_area.controlslider("G", "output_ctrls").caption("Green").as_output(true).tooltip("Green of the average colour inside the shapes, 0 to 1. A [[pure output]]").min(0).max(1.0);
	out_b = out_area.controlslider("B", "output_ctrls").caption("Blue").as_output(true).tooltip("Blue of the average colour inside the shapes, 0 to 1. A [[pure output]]").min(0).max(1.0);

	// The whole colour in one (r, g, b)
	out_color = out_area.control("OUT", "output_ctrls").caption("Out").as_output(true)
		.tooltip("The average colour inside the shapes: [[link]] it into a lamp, it follows that part of the picture\n[[wiki:Assets#generators--output]]");
	default_output = out_color;
}

save_state() {
	return [
		r = out_r.value(),
		g = out_g.value(),
		b = out_b.value(),
		shape_type = current_shape_type,
		shapes = mask_shapes,
		res = res_ctrl.value(),
	];
}

load_state(state) {
	if(state.has("r"))
		out_r.value(state.r, false, true);
	if(state.has("g"))
		out_g.value(state.g, false, true);
	if(state.has("b"))
		out_b.value(state.b, false, true);
	if(state.has("shape_type")) {
		current_shape_type = state.shape_type;
		shape_select.value(current_shape_type);
	}
	if(state.has("shapes"))
		mask_shapes = state.shapes;
	if(state.has("res"))
		res_ctrl.value(state.res, false, false);
	if(state.has("r") && state.has("g") && state.has("b"))
		color_disp.rgb(state.r, state.g, state.b);
	publish_shapes();
}
