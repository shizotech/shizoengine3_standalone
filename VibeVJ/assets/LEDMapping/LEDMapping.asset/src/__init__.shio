
using eigen;
using nanogui;

managed shader = None;

managed size_x = None;
managed size_y = None;

managed scene_area = None;
managed scene_control_area = None;

managed scene_instances = [];
active_scene = None; //NOT managed!
active_group = None;
active_segment = None;

//Raw json structure, should not contain objects / classes only raw json setup from which everything is build dynamically.
fixture_scenes = [];

//Temp
active_drag_start = None;
active_drag_end = None;

current_grid = 3;
snap_to_grid = true;
auto_index = true;

def build_scenes();

quantize_grid(pos)
{
	if(!snap_to_grid)
		return pos;
	
	size = shader.size();
	grid = current_grid * 4;
	
	grid_step_x = size.x / grid;
	grid_step_y = size.y / grid;

	pos.x = (math.round(pos.x / grid_step_x)) * grid_step_x;
	pos.y = (math.round(pos.y / grid_step_y)) * grid_step_y;

	return pos;
}

vec_to_json(v) {
	return [
		x = v.x,
		y = v.y,
	];
}

json_to_vec(v) {
	return vec2f(v.x, v.y);
}

class FixtureSegment {
	
	segment = None;
	segment_index = 0;
	
	managed area = None;
	
	__init__(parent, group, index) {
		segment_index = index;
		segment = group.segments[segment_index];
		
		area = parent.area.widget().layout(nanogui.layout_vertical());
		area.pushbutton("Segment");
	}
}

class FixtureGroup {
	
	group = None; //shared pointer to fixture_scenes[...].groups[index]
	group_index = 0;
	
	managed area = None;
	managed edit_btn = None;
	managed segments_area = None;
	managed segments = [];
	
	__init__(parent, scene, index) {
		group_index = index;
		group = scene.groups[group_index];
		
		select_div = parent.group_area.widget().fixed_height(25).anchor_left(0).anchor_right(0);
		group_name = select_div.textbox(group.name).anchor(0).anchor_right(75);
		group_name.on_change([this](v){
			group.name = v;
		});
		edit_btn = select_div.pushbutton("EDIT").anchor_right(25).fixed_width(50);
		delete_btn = select_div.button("X").anchor_right(0).fixed_width(25);
		
		area = parent.group_area.widget().layout(nanogui.layout_vertical());
		
		delete_btn.on_click([parent, index](){
			parent.scene.groups.erase(index);
			parent.build_groups();
		});

		edit_btn.on_change([this, area](v){
			area.visible(v);
			if(active_group == this) {
				active_group = v ? this : None;
			}
			else if(v) {
				if(active_group)
					active_group.edit_btn.pushed(false);
					active_group.area.visible(false);
				active_group = this;
				this.edit_btn.pushed(true);
			}
			
			scene_control_area.refresh_layout();
		});
		
		area.combobox().items(["None"]);
		area.pushbutton("TRANSFORM");
		area.button("RESET TRANSFORM");
		area.button("MIRROR X");
		area.button("MIRROR Y");
		
		
		area.visible(false);
		
		build_segments();
	}
	
	build_segments() {
		segments = [];
		
		for(i = 0; i < group.segments.size(); i++) {
			seg = FixtureSegment(this, group, i);
			segments.push_back(seg);
		}
		
		scene_control_area.refresh_layout();
	}
	
	draw_segments(ctx, is_active) {
		if(group.segments ?? false)
		{
			draw_color = is_active ? vec4f(0.0, 0.4, 0.8, 0.8) : vec4f(0.8, 0.8, 0.8, 0.6);
			
			for(i = 0; i < group.segments.size(); i++) {
				start_pos = json_to_vec(group.segments[i].start_pos) * shader.size();
				end_pos = json_to_vec(group.segments[i].end_pos) * shader.size();

				ctx.nvgBeginPath();
			
				ctx.nvgMoveTo(vec2f(start_pos.x, start_pos.y));
				ctx.nvgLineTo(vec2f(end_pos.x, end_pos.y));
				ctx.nvgStrokeWidth(10.0);
				ctx.nvgStrokeColor(draw_color);
				ctx.nvgStroke();
			}
		}
	}
	
	//NORMALIZED coords!
	new_segment(start_pos, end_pos) {
		if(!group.segments)
			group.segments = [];
		
		group.segments.push_back([
			start_pos = vec_to_json(start_pos),
			end_pos = vec_to_json(end_pos),
		]);
		
		build_segments();
	}		
}

class FixtureScene {	
	scene = None; //Direct shared pointer to the corresponding fixture_scenes entry
	scene_index = 0;
	
	managed groups = [];
	
	managed top_group_area = None;
	managed group_area = None;
	managed select_div = None;
	managed select_btn = None;
	
	group_counter = 1;
	
	active_group_btn = None;
	
	__init__(index) {
		scene_index = index;
		scene = fixture_scenes[scene_index];

		select_div = scene_area.widget().fixed_height(25).anchor_left(0).anchor_right(0);
		scene_name = select_div.textbox(scene.name).anchor(0).anchor_right(75);
		scene_name.on_change([this, scene](v){
			scene.name = v;
		});
		select_btn = select_div.pushbutton("EDIT").anchor_right(25).fixed_width(50);
		delete_btn = select_div.button("X").anchor_right(0).fixed_width(25);
		
		select_btn.on_change([this](v){
			select_fixture(v);
			select_btn.pushed(v);
		});
		
		delete_btn.on_click([this, index](){
			fixture_scenes.erase(index);
			build_scenes();
		});
	}
	
	select_fixture(selected = true) {
		
		for(i = 0; i < scene_instances.size(); i++) {
			scene_instances[i].groups = [];
			scene_instances[i].select_btn.pushed(false);
		}
		
		top_group_area = None;
		active_scene = None;
		
		if(!selected)
			return;
		
		active_scene = this;

		top_group_area = scene_control_area.widget().anchor(0).layout(nanogui.layout_vertical());
		
		add_group_btn = top_group_area.button("Add Group");
		add_group_btn.on_click([this, scene](){
			if(!scene.groups)
				scene.groups = [];
			this.group_counter++;
			scene.groups.push_back([
				name="New Group " + this.group_counter,
			]);
			build_groups();
		});
		
		top_group_area.pushbutton("Auto Index").pushed(auto_index).on_change([](v){ auto_index = v; });
		top_group_area.pushbutton("Snap to Grid").pushed(snap_to_grid).on_change([](v){ snap_to_grid = v; });
		grid_div = top_group_area.widget().fixed_height(30).anchor_left(0).anchor_right(0);
		grid_label = grid_div.label("Grid").anchor_left(0).anchor_right(0.5, "percent").fixed_height(30);
		grid = grid_div.intbox().value(current_grid).anchor_left(0.5,"percent").anchor_right(0).fixed_height(30);
		grid.value_callback([](v){
			current_grid = v;
		});
		
		build_groups();
	}
	
	build_groups() {
		
		groups = [];
		
		group_area = scene_control_area.vscroll().anchor(0).anchor_top(150);
		group_area.content().layout(nanogui.layout_vertical());
		
		for(i = 0; i < scene.groups.size(); i++) {
			group = FixtureGroup(this, scene, i);
			groups.push_back(group);
		}
		
		group_counter = groups.size();
		
		scene_control_area.refresh_layout();
	}

	draw_groups(ctx) {
		if(!groups)
			return;
		for(i = 0; i < groups.size(); i++) {
			if(groups[i] != active_group)
				groups[i].draw_segments(ctx, false);
		}
	}
}

build_scenes() {
	
	scene_instances = [];
	
	// Very special function, this avoids reloading same project GUID's while the current objects may not be destroyed yet
	for(!scene_area.screen().garbage_cleared()) {
		std.sleep(0);
	}
	
	for(i = 0; i < fixture_scenes.size(); i++) {
		scene = FixtureScene(i);
		scene_instances.push(scene);
	}
}


entry(generator, area) {	
	
	area.layout(None);
	
	left_ctrls = area.widget().anchor_left(0).anchor_top(0).anchor_bottom(30).fixed_width(200).layout(nanogui.layout_vertical());
	right_ctrls = area.widget().anchor_right(0).anchor_top(0).anchor_bottom(30).fixed_width(200).layout(nanogui.layout_vertical());
	
	in_ctrl = area.control("IN").anchor_left(0).anchor_bottom(0).fixed_height(30).fixed_width(200);
	out_ctrl = area.control("OUT").anchor_right(0).anchor_bottom(0).fixed_height(30).fixed_width(200);
	
	shader_view = area.scrollarea().anchor_left(200).anchor_right(200).anchor_top(0).anchor_bottom(0).content();
	
	shader = shader_view.shader();
	
	size_x = left_ctrls.controlint("Width", "settings").value(generator.engine.project_width.value());
	size_y = left_ctrls.controlint("Height", "settings").value(generator.engine.project_height.value());
	
	size_cb = [size_x, size_y, shader_view](v) {
		shader.render_size(vec2i(size_x.value(), size_y.value()));
		shader_view.fixed_size(vec2i(size_x.value(), size_y.value()));
		shader_view.size(shader_view.fixed_size());
		shader_view.refresh_layout();
	};
	
	size_x.callback(size_cb);
	size_y.callback(size_cb);
	
	size_cb();

	add_scene = left_ctrls.button("Add Scene");
	
	scene_area = left_ctrls.vscroll().anchor(0).anchor_top(100).content().layout(nanogui.layout_vertical()).fixed_width(200);
	
	scene_control_area = right_ctrls;
	
	add_scene.on_click([](){
		
		fixture_scenes.push_back([
			name="New Scene",
		]);
		
		build_scenes();
	});
	
	shader.on_mouse_button([](pos, button, down, mods) {
		if(button != 0)
			return false;
		std.print(pos);
		if(down)
			active_drag_start = quantize_grid(pos);
		else
			active_drag_end = quantize_grid(pos);
			
			if(active_drag_start && active_drag_end)
				uv_start = vec2f(active_drag_start.x / std.float(shader.width()), active_drag_start.y / std.float(shader.height()));
				uv_end = vec2f(active_drag_end.x / std.float(shader.width()), active_drag_end.y / std.float(shader.height()));
				if(active_group)
					active_group.new_segment(uv_start, uv_end);
			
			active_drag_start = None;
			active_drag_end = None;
		return true;
	});
	
	shader.on_mouse_motion([](pos, rel, button, mods) {
		if(active_drag_start)
			active_drag_end = quantize_grid(pos);
		return true;
	});

	shader.on_draw([](){		
		s = shader.size();

		ctx = nanogui.current_context();
		
		if(active_scene) {
			grid = current_grid;

			grid_step_x = s.x / grid;
			grid_step_y = s.y / grid;

			ctx.nvgBeginPath();

			// Vertical lines
			for(xx = 0; xx <= s.x; xx += grid_step_x) {
				ctx.nvgMoveTo(vec2f(xx, 0));
				ctx.nvgLineTo(vec2f(xx, s.y));
			}

			// Horizontal lines
			for(yy = 0; yy <= s.y; yy += grid_step_y) {
				ctx.nvgMoveTo(vec2f(0, yy));
				ctx.nvgLineTo(vec2f(s.x, yy));
			}

			ctx.nvgStrokeColor(vec4f(1, 1, 1, 0.25));
			ctx.nvgStrokeWidth(1.0);
			ctx.nvgStroke();
			
			active_scene.draw_groups(ctx);
		}
	
		if(active_group) {
			active_group.draw_segments(ctx, true);
		}
	
		if(active_drag_start && active_drag_end) {
			
			ctx.nvgBeginPath();
			
			ctx.nvgMoveTo(vec2f(active_drag_start.x, active_drag_start.y));
			ctx.nvgLineTo(vec2f(active_drag_end.x, active_drag_end.y));
			ctx.nvgStrokeWidth(10.0);
			if(active_group)
				ctx.nvgStrokeColor(vec4f(0.4, 0.8, 0, 0.8));
			else
				ctx.nvgStrokeColor(vec4f(0.8, 0.4, 0, 0.8));
			ctx.nvgStroke();
		}
		
	});
}

save_state() {
	return [
		fixture_scenes=fixture_scenes,
	];
}

load_state(state) {
	fixture_scenes = state.fixture_scenes;
	build_scenes();
}