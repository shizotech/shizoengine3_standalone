using eigen;

//The Tools button at the right end of the top bar (#975): the menus there is one of in the program, that are not a view
//and not an asset (the fixture setup, the stage (#980), the fixture editor). Not every project needs them, but when one does they must be
//one click away; before #975 they were buttons in Devices › Fixtures (still there).
//
//- A click on the button opens the list, a click on a menu opens it in a view tab (assetbrowser.open_menu_asset), or
//  brings its tab to the front. The list marks the menus that have a tab.
//- A menu of the list is a .menu file (entry(parent), menu_name(); menu_keep() true keeps it when its tab closes,
//  menu_shown() / menu_hidden() are called when it comes back / goes: assetbrowser.park_menu_tab).
//- A new one: a row in TOOL_MENUS. The command palette (Ctrl+K) lists them as well (palette.shio add_actions).

//[path, name, icon (a name of nanogui.icon or a Font Awesome code), tooltip]
TOOL_MENUS = [
	["engine/menus/fixtures/setup.menu", "Fixture setup", "th",
		"Where the lamps of the [[project]] are set up: the [[fixture setup]] with the stage plan, the 3D view, the nodes and the universe map\n[[wiki:Output-and-Devices#set-up-your-lamps]]"],
	["engine/menus/stage/stage.menu", "Stage", 0xf1b2, //Font Awesome "cube" (no name in nanogui.icon)
		"The room, the set and the decoration in 3D: model files (STEP, 3MF, STL, OBJ, GLB) placed on the stage, with the lamps of the fixture setup\n[[wiki:Stage]]"],
	["engine/menus/fixtures/editor.menu", "Fixture editor", "pen",
		"Make a [[fixture]] type: its name, its channels and their types\n[[wiki:Output-and-Devices#make-a-fixture-file]]"],
];

TOOLS_MENU_WIDTH = 240;
TOOLS_ICON = 0xf552; //Font Awesome "toolbox" (nanogui.icon() has no name for it)

class tools_menu
{
	managed button = None;
	asset_menu = None;

	//The button goes into bar, its right edge `right` pixels from the right end; size and top as the other buttons
	__init__(bar, asset_menu, right, top, size) {
		this.asset_menu = asset_menu;
		button = bar.button_popup("").icon(TOOLS_ICON).side("bottom")
			.tooltip("Tools: the [[fixture setup]] and the fixture editor, the menus that are not a view\n[[wiki:The-Screen#tools]]")
			.anchor_top(top).anchor_right(right).fixed_width(size).fixed_height(size).overlay(true);
		button.on_screen(true).autoclose(true);
		button.popup().content().layout(nanogui.layout_vertical()).fixed_width(TOOLS_MENU_WIDTH);
		//Built when it opens: which of them have a tab changes in the meantime
		button.on_change([this](v){
			if(v)
				this.fill();
		});
	}

	fill() {
		menu = button.popup().content();
		menu.clear_children();
		head = menu.widget().anchor_left(0).anchor_right(0).fixed_height(24);
		head.label("Tools").font_size(13).text_color(vec4f(0.608, 0.608, 0.627, 1.0)).alignment("left")
			.anchor_top(0).anchor_bottom(0).anchor_left(8).anchor_right(0);
		for(i = 0; i < TOOL_MENUS.size(); i++) {
			t = TOOL_MENUS[i];
			path = t[0];
			is_open = asset_menu.menu_open(path);
			row = menu.widget().anchor_left(0).anchor_right(0).fixed_height(30);
			item = row.button(t[1]).icon(std.is_string(t[2]) ? nanogui.icon(t[2]) : t[2]).alignment("left").tooltip(t[3])
				.anchor(0);
			if(is_open) {
				//A dot like the badge of a view tab: it has a tab now, the click brings it to the front
				row.label("open").font_size(12).alignment("right").text_color(vec4f(0.247, 0.812, 0.557, 1.0))
					.anchor_top(0).anchor_bottom(0).anchor_right(10).fixed_width(60);
			}
			item.on_click([this, path](){
				this.button.close();
				this.open(path);
			});
		}
		menu.parent().refresh_layout();
	}

	open(path) {
		return asset_menu.open_menu_asset(path);
	}
}
