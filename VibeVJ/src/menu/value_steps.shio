//Undo / redo of values (#350, step 3). nanogui reports every value the user changes (nanogui.on_value_change): a
//slider dragged (the whole drag, from press to release, is one change), a toggle clicked, an entry chosen from a list,
//a number or a text typed and confirmed, a turn of the mouse wheel. Each one becomes a step of the history, in the order
//it happened, between the steps of the layout and of the links.
//Values that links, MIDI, the timeline, smoothing or scripts set are not reported, so they are no steps; in show mode
//nothing is recorded (the faders of a show are no edits).
//Turns of the wheel and keys on the same control less than a second apart are one step (history.extend).
//A step finds its control again by its path. When it is gone (its generator was deleted outside the history), the step
//is skipped with a warning.

value_steps_set(ctx, path, value) {
	ctrl = ctx.get_control_by_path(path);
	if(!ctrl) {
		std.warn("Undo / redo: the control " + path + " no longer exists, the step is skipped");
		return;
	}
	ctrl.value(value);
}

//One change as a step of history
value_steps_push(history, ctx, path, info) {
	old = info.old;
	value = info.value;
	redo = [ctx, path, value](){ value_steps_set(ctx, path, value); };
	//A tick of the wheel, a key: the step before goes on when it is the same control
	if(info.how != "mouse" && history.extend("value " + info.how + " " + path, redo))
		return;
	history.push(info.name != "" ? "Value: " + info.name : "Value",
		[ctx, path, old](){ value_steps_set(ctx, path, old); },
		redo,
		"value " + info.how + " " + path);
}

//Records the user's changes of values into history. blocked(): true while nothing may be recorded (a step of the layout
//runs, a project loads). While the history undoes or redoes a step it records nothing either (history.busy).
value_steps_attach(history, ctx, blocked) {
	nanogui.on_value_change([history, ctx, blocked](path, info){
		if(!history || history.busy || nanogui.show_mode() || (blocked && blocked()))
			return;
		value_steps_push(history, ctx, path, info);
	});
}
