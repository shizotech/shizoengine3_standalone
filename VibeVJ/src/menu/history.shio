
//Undo / redo (#350): the steps the user did, each with a name and the two functions that take it back and do it
//again. One history for the program; a project that is loaded starts a new one.
//What a step holds is up to its maker. The layout (generators.shio) stores a description of the layout before and
//after the step and rebuilds it; views are moved, not reloaded.
class history
{
	steps = [];     //[name=, undo=, redo=]
	done = 0;       //steps[0 .. done - 1] are done, the ones after it were undone and can be done again
	most = 100;     //older steps are dropped
	busy = false;   //a step is being undone or redone: nothing is recorded meanwhile
	on_change = None; //callback(): what can be undone or redone changed (the buttons of the top bar)

	push(name, undo_fn, redo_fn) {
		if(busy)
			return;

		//A new step ends what was undone: it cannot be done again
		for(steps.size() > done)
			steps.erase(steps.size() - 1);

		steps.push_back([name = name, undo = undo_fn, redo = redo_fn]);
		for(steps.size() > most)
			steps.erase(0);
		done = steps.size();
		changed();
	}

	can_undo() {
		return done > 0;
	}

	can_redo() {
		return done < steps.size();
	}

	//The name of the step Undo takes back, "" when there is none
	undo_name() {
		return can_undo() ? steps[done - 1].name : "";
	}

	redo_name() {
		return can_redo() ? steps[done].name : "";
	}

	undo() {
		if(busy || !can_undo())
			return false;
		busy = true;
		step = steps[done - 1];
		try {
			step.undo();
		}
		catch(e) {
			std.error("Undo failed: " + step.name);
		}
		done--;
		busy = false;
		changed();
		return true;
	}

	redo() {
		if(busy || !can_redo())
			return false;
		busy = true;
		step = steps[done];
		try {
			step.redo();
		}
		catch(e) {
			std.error("Redo failed: " + step.name);
		}
		done++;
		busy = false;
		changed();
		return true;
	}

	clear() {
		steps = [];
		done = 0;
		changed();
	}

	changed() {
		if(std.is_function(on_change))
			on_change();
	}
}
