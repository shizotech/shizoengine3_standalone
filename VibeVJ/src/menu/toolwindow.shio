
using eigen;

TOOLWINDOW_NAV_WIDTH = 190;
TOOLWINDOW_NAV_COLOR = vec4f(0.086, 0.086, 0.094, 1.0);  //a step darker than the window (surface_1)
TOOLWINDOW_NAV_ACTIVE = vec4f(0.160, 0.160, 0.175, 1.0); //the entry of the page that shows
TOOLWINDOW_ACCENT = vec4f(0.616, 0.522, 1.0, 1.0);
TOOLWINDOW_TEXT_2 = vec4f(0.608, 0.608, 0.627, 1.0);

//The visible tool window that was shown last, or None (#376)
toolwindow_in_front(engine) {
	front = None;
	tools = engine.env.toolwindows;
	if(!tools)
		return None;
	for(i = 0; i < tools.size(); i++) {
		if(tools[i].visible() && (!front || tools[i].raised > front.raised))
			front = tools[i];
	}
	return front;
}

//A window that floats over the program, for things that are not part of the layout: the settings (#356), later a
//wiki or other tools.
//- It has the header of a generator window: title, move by the header, a close button.
//- It stays above the views, the sidebar and the timeline, also when one of them gets the focus.
//- Closing only hides it, so what is in it keeps its state. Esc closes the one with the focus, else the one in front
//  (generators.shio); the one shown last is in front.
//Content: the caller builds into "window". For a window with several pages: side_nav(parent) once, then
//add_page(name, icon) per page; section() and note() give the pages their headings.
class toolwindow
{
	managed window = None;
	engine = None;
	placed = false; //centered on the first show(), afterwards it stays where the user put it
	raised = 0;     //when it was shown last (engine.env.toolwindow_raises): the one shown last is in front (#376)
	width = 0;
	height = 0;

	//Pages listed at the left side (side_nav)
	nav = None;
	stack = None;
	pages = [];        //[row=, mark=, outer=]
	shown_page = 0;    //index of the page that shows
	on_page = None;    //callback(index): a page is about to show (to fill it when it is first needed)

	__init__(engine, title, width = 760, height = 560) {
		this.engine = engine;
		this.width = width;
		this.height = height;

		window = engine.screen.window(title);
		window.title(title)
			.fixed_size(vec2f(width, height))
			.movable(true)
			.resizable(true)
			.overlay(true)
			.visible(false);

		close_btn = window.button_panel().button("").icon(nanogui.icon("times")).tooltip("Close (Esc)").danger("hover")
			.anchor_top(0).anchor_bottom(0).anchor_right(0).fixed_width(25);
		close_btn.on_click([this](){
			this.hide();
		});

		//For Esc (generators.shio, shortcut)
		if(!engine.env.toolwindows)
			engine.env.toolwindows = [];
		engine.env.toolwindows.push_back(this);
	}

	// =========================================================================
	// Pages at the side
	// =========================================================================

	//The list of pages at the left edge of parent (the window, or a node in it) and the room for the pages beside it
	side_nav(parent) {
		nav = parent.widget_solid().background_color(TOOLWINDOW_NAV_COLOR)
			.anchor_left(0).anchor_top(0).anchor_bottom(0).fixed_width(TOOLWINDOW_NAV_WIDTH)
			.layout(nanogui.layout_vertical());
		nav.label("").fixed_height(6);
		stack = parent.widget().anchor(0).anchor_left(TOOLWINDOW_NAV_WIDTH);
	}

	//One page: an entry in the list, and its content, laid out top to bottom. It scrolls when it is higher than the
	//window. Returns the content. scroll = false: the page is one plain widget that fills the room, for content that
	//scrolls by itself (a text)
	add_page(name, icon = "", scroll = true) {
		index = pages.size();

		//The entry: a row that is lighter and has an accent mark at its left edge while its page shows
		row = nav.widget_solid().background_color(TOOLWINDOW_NAV_COLOR).anchor_left(0).anchor_right(0).fixed_height(34);
		mark = row.widget_solid().background_color(TOOLWINDOW_ACCENT)
			.anchor_left(0).anchor_top(6).anchor_bottom(6).fixed_width(3).visible(false);
		btn = row.button(name).alignment("left").transparent(true).anchor(0).anchor_left(8);
		if(icon)
			btn.icon(nanogui.icon(icon));
		btn.on_click([this, index](){
			this.show_page(index);
		});

		//Only the page that shows is visible: the room for the pages then has one child that counts
		outer = None;
		content = None;
		if(scroll) {
			outer = stack.vscroll().anchor(0).anchor_left(16).anchor_right(16);
			content = outer.content().layout(nanogui.layout_vertical());
			content.label("").fixed_height(8);
		}
		else {
			outer = stack.widget().anchor(0);
			content = outer;
		}

		pages.push_back([row = row, mark = mark, outer = outer]);
		if(index == 0) {
			row.background_color(TOOLWINDOW_NAV_ACTIVE);
			mark.visible(true);
		}
		else
			outer.visible(false);
		return content;
	}

	show_page(index) {
		if(index < 0 || index >= pages.size())
			return;
		if(std.is_function(on_page))
			on_page(index);
		shown_page = index;
		for(i = 0; i < pages.size(); i++) {
			shown = i == index;
			if((pages[i].outer.visible() ? 1 : 0) != (shown ? 1 : 0)) {
				pages[i].outer.visible(shown);
				pages[i].mark.visible(shown);
				pages[i].row.background_color(shown ? TOOLWINDOW_NAV_ACTIVE : TOOLWINDOW_NAV_COLOR);
			}
		}
	}

	//A heading in a page, with room above it
	section(page, title) {
		page.label("").fixed_height(10);
		return page.label(title).font_size(16).fixed_height(26);
	}

	//A line of explanation in a page
	note(page, text) {
		return page.label(text).font_size(13).text_color(TOOLWINDOW_TEXT_2).fixed_height(20);
	}

	// =========================================================================
	// Show and hide
	// =========================================================================

	visible() {
		return window.visible() ? true : false;
	}

	show() {
		if(!placed) {
			placed = true;
			screen = engine.screen;
			fit_screen();
			x = std.int((screen.width() - window.width()) / 2);
			y = std.int((screen.height() - window.height()) / 2);
			window.position(vec2f(x > 0 ? x : 0, y > 0 ? y : 0));
		}
		fit_screen();
		window.visible(true);
		window.focus(true);
		engine.env.toolwindow_raises = (engine.env.toolwindow_raises ? engine.env.toolwindow_raises : 0) + 1;
		raised = engine.env.toolwindow_raises;
	}

	//On a small screen or window the tool window gets smaller (its own size is the most it gets) and moves back
	//onto the screen, so its title bar and close button can always be reached
	fit_screen() {
		screen = engine.screen;
		margin = 8;
		//The size it has (also one the user gave it), at least its own size, at most the screen
		w = math.min(math.max(window.width(), width), screen.width() - margin * 2);
		h = math.min(math.max(window.height(), height), screen.height() - margin * 2);
		if(w < 320) w = 320;
		if(h < 240) h = 240;
		if(math.abs(window.width() - w) > 0.5 || math.abs(window.height() - h) > 0.5) {
			window.fixed_size(vec2f(w, h));
			window.size(vec2f(w, h));
		}
		pos = window.position();
		x = math.clamp(pos.x, 0.0, math.max(0.0, screen.width() - w));
		y = math.clamp(pos.y, 0.0, math.max(0.0, screen.height() - h));
		if(x != pos.x || y != pos.y)
			window.position(vec2f(x, y));
	}

	hide() {
		window.visible(false);
		//#376: the tool window that is still open gets the focus, so Esc closes it next
		front = toolwindow_in_front(engine);
		if(front)
			front.window.focus(true);
	}

	//Another size for the window (a picture viewer fits its picture). It is centered again
	resize(new_width, new_height) {
		width = new_width;
		height = new_height;
		window.fixed_size(vec2f(width, height));
		window.size(vec2f(width, height));
		placed = false;
	}

	toggle() {
		if(visible())
			hide();
		else
			show();
	}
}
