
#include "assetbrowser/assetbrowser"
#include "timeline/timeline"
#include "generators/generators"

using eigen;

class main_menu
{
	managed asset_menu = None;
	managed generators_menu = None;
	managed timeline_menu = None;

	managed sidebar_visible = true;

	__init__(engine) {
		asset_menu = assetbrowser(engine, this);
		generators_menu = generators(engine, this);
		timeline_menu = timeline(engine, this);	
	}

	//Hide or show the sidebar (project, assets, devices, chat); the views and the timeline take its space
	toggle_sidebar() {
		this.sidebar_visible = !this.sidebar_visible;
		this.asset_menu.window.visible(this.sidebar_visible);
		left = this.sidebar_visible ? this.asset_menu.window.size().x : 0;
		this.generators_menu.window.anchor_left(left);
		this.timeline_menu.window.anchor_left(left);
		return this.sidebar_visible;
	}
}