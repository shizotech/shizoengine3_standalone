
#include "history"
#include "link_steps"
#include "value_steps"
#include "toolwindow"
#include "logwindow"
#include "palette"
#include "menubar"
#include "perfoverlay"
#include "helpwindow"
#include "assetbrowser/assetbrowser"
#include "timeline/timeline"
#include "generators/generators"

using eigen;

class main_menu
{
	managed asset_menu = None;
	managed generators_menu = None;
	managed timeline_menu = None;
	managed help = None; //the wiki in the program (#357): F1, or the ? button of the top bar
	managed log = None;  //errors and warnings: toasts and the window Log (#539)
	managed palette = None; //Ctrl+K: search actions, assets, projects and the wiki (#535)
	managed perf = None;    //Ctrl+Shift+P: FPS, frame time, the most expensive generators (#537)
	managed menubar = None; //macOS: the menu bar (File, Edit, View, ...); nothing elsewhere

	managed sidebar_visible = true;
	sidebar_auto_hidden = false; //the window got narrow and the sidebar went (window_resized); it comes back when wide again

	__init__(engine) {
		//First, so it also gets what goes wrong while the rest is built
		log = logwindow(engine);
		asset_menu = assetbrowser(engine, this);
		generators_menu = generators(engine, this);
		timeline_menu = timeline(engine, this);
		help = helpwindow(engine);
		palette = command_palette(engine, this);
		perf = perf_overlay(engine);
		if(std.os_platform() == "macos")
			menubar = menu_bar(engine, this);
		engine.env.perf = perf;

		//The program window changed size (dragged, zoomed, the full screen, another interface size): everything that is
		//laid out against it follows
		engine.screen.on_window_resize([this](new_size, old_size){
			this.window_resized(new_size, old_size);
		});
		fit_sidebar(engine.screen.width(), 0);

		//F1 opens the wiki on the page for the part of the screen the mouse is in (generators.shio sets the views
		//and the sidebar): the timeline and the settings window are made after it
		timeline_menu.window.on_mouse_enter([engine](pos, enter){
			if(enter)
				engine.env.help_region = "Timeline";
		});
		asset_menu.settings.window.on_mouse_enter([engine](pos, enter){
			if(enter)
				engine.env.help_region = "Settings";
		});
	}

	//Narrower than this the sidebar leaves the room to the views and the timeline by itself (the timeline bar would be
	//cut off), wider it comes back if it left this way. The button in the top bar still shows and hides it at any width
	SIDEBAR_AUTO_WIDTH = 1200;

	window_resized(new_size, old_size) {
		timeline_menu.window_resized(new_size, old_size);
		fit_sidebar(new_size.x, old_size.x);
		//A tool window (Settings, Help, Log, ...) stays on the screen
		tools = engine_ref().env.toolwindows;
		if(tools) {
			for(i = 0; i < tools.size(); i++)
				tools[i].fit_screen();
		}
	}

	engine_ref() {
		return std.global("engine");
	}

	fit_sidebar(width, old_width) {
		narrow = width < SIDEBAR_AUTO_WIDTH;
		was_narrow = old_width > 0 && old_width < SIDEBAR_AUTO_WIDTH;
		if(narrow && (old_width == 0 || !was_narrow) && sidebar_visible) {
			sidebar_auto_hidden = true;
			generators_menu.show_sidebar(this, false);
		}
		else if(!narrow && was_narrow && sidebar_auto_hidden) {
			sidebar_auto_hidden = false;
			if(!sidebar_visible)
				generators_menu.show_sidebar(this, true);
		}
	}

	//Hide or show the sidebar (project, assets, devices, chat, mcp); the views and the timeline take its space
	toggle_sidebar() {
		this.sidebar_visible = !this.sidebar_visible;
		this.asset_menu.window.visible(this.sidebar_visible);
		left = this.sidebar_visible ? this.asset_menu.window.size().x : 0;
		this.generators_menu.window.anchor_left(left);
		this.timeline_menu.window.anchor_left(left);
		return this.sidebar_visible;
	}
}