
#include "history"
#include "link_steps"
#include "toolwindow"
#include "helpwindow"
#include "assetbrowser/assetbrowser"
#include "timeline/timeline"
#include "generators/generators"

using eigen;

class main_menu
{
	managed asset_menu = None;
	managed generators_menu = None;
	managed timeline_menu = None;
	managed help = None; //the wiki in the program (#357): F1, or the ? button of the top bar

	managed sidebar_visible = true;

	__init__(engine) {
		asset_menu = assetbrowser(engine, this);
		generators_menu = generators(engine, this);
		timeline_menu = timeline(engine, this);
		help = helpwindow(engine);

		//F1 opens the wiki on the page for the part of the screen the mouse is in (generators.shio sets the views
		//and the sidebar): the timeline and the settings window are made after it
		timeline_menu.window.on_mouse_enter([engine](pos, enter){
			if(enter)
				engine.env.help_region = "Timeline";
		});
		asset_menu.settings.window.on_mouse_enter([engine](pos, enter){
			if(enter)
				engine.env.help_region = "Settings";
		});
	}

	//Hide or show the sidebar (project, assets, devices, chat, mcp); the views and the timeline take its space
	toggle_sidebar() {
		this.sidebar_visible = !this.sidebar_visible;
		this.asset_menu.window.visible(this.sidebar_visible);
		left = this.sidebar_visible ? this.asset_menu.window.size().x : 0;
		this.generators_menu.window.anchor_left(left);
		this.timeline_menu.window.anchor_left(left);
		return this.sidebar_visible;
	}
}