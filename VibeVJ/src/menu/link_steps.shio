//Undo / redo of links (#387). nanogui reports every link the user makes, removes or changes (nanogui.on_link_change):
//dragged or dropped, the unlink button and type list of a link menu, a cable pulled or laid again by hand, the Links
//view. Each change becomes one step of the history, in the order it happened, between the steps of the layout.
//Links that modules and assets make by themselves, and links being loaded, are not reported, so they are no steps.
//A step finds its controls again by their paths. When one of them is gone (its generator was deleted outside the
//history), the step is skipped with a warning.
//Not part of it: the place of a link in the Links view (a link made again comes last), and generators moved or copied
//to another view (#348).

link_steps_ends(ctx, from_path, to_path) {
	a = ctx.get_control_by_path(from_path);
	b = ctx.get_control_by_path(to_path);
	if(!a || !b) {
		std.warn("Undo / redo: a control of the link " + from_path + " -> " + to_path + " no longer exists, the step is skipped");
		return None;
	}
	return [a = a, b = b];
}

//The link from_path -> to_path with this type (0..2) and bend ([x, y] or None)
link_steps_set(ctx, from_path, to_path, type, bend) {
	ends = link_steps_ends(ctx, from_path, to_path);
	if(!ends)
		return;
	ends.a.link_to(ends.b, type);
	ends.a.link_bend(ends.b, bend);
}

link_steps_remove(ctx, from_path, to_path) {
	ends = link_steps_ends(ctx, from_path, to_path);
	if(ends)
		ends.a.unlink_from(ends.b);
}

link_steps_bend(ctx, from_path, to_path, bend) {
	ends = link_steps_ends(ctx, from_path, to_path);
	if(ends)
		ends.a.link_bend(ends.b, bend);
}

//One change as a step of history
link_steps_push(history, ctx, kind, from_path, to_path, info) {
	if(kind == "link") {
		history.push("Link",
			[ctx, from_path, to_path](){ link_steps_remove(ctx, from_path, to_path); },
			[ctx, from_path, to_path, info](){ link_steps_set(ctx, from_path, to_path, info.type, info.bend); });
	}
	else if(kind == "unlink") {
		history.push("Unlink",
			[ctx, from_path, to_path, info](){ link_steps_set(ctx, from_path, to_path, info.old_type, info.old_bend); },
			[ctx, from_path, to_path](){ link_steps_remove(ctx, from_path, to_path); });
	}
	else if(kind == "type") {
		history.push("Link type",
			[ctx, from_path, to_path, info](){ link_steps_set(ctx, from_path, to_path, info.old_type, info.bend); },
			[ctx, from_path, to_path, info](){ link_steps_set(ctx, from_path, to_path, info.type, info.bend); });
	}
	else if(kind == "bend") {
		history.push("Cable",
			[ctx, from_path, to_path, info](){ link_steps_bend(ctx, from_path, to_path, info.old_bend); },
			[ctx, from_path, to_path, info](){ link_steps_bend(ctx, from_path, to_path, info.bend); });
	}
}

//Records the changes of links into history. blocked(): true while nothing may be recorded (a step of the layout runs,
//a project loads). While the history undoes or redoes a step it records nothing either (history.busy).
link_steps_attach(history, ctx, blocked) {
	nanogui.on_link_change([history, ctx, blocked](kind, from_path, to_path, info){
		if(!history || history.busy || (blocked && blocked()))
			return;
		link_steps_push(history, ctx, kind, from_path, to_path, info);
	});
}
