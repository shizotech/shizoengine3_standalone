// Issue #501: the network cards Art-Net and ShizoNet use. ArtPoll, ArtSync and the ShizoNet beacons go out over them,
// and nodes are only accepted from their networks. "All" (default, as before), "Network cards" (no docker / VPN /
// WSL / Hyper-V switches / bridges) or the cards picked here. Personal: the cards belong to this machine, so the choice
// is kept in the style file, not in the project, and __init__.shio applies it before the ShizoNet server starts.
class network_cards_menu {

	parent = None;
	mode_select = None;
	list_box = None;
	picked = []; //names of the picked cards (mode "Picked")

	__init__(parent) {
		this.parent = parent;

		now = shizonet.use_interfaces();
		mode = 0;
		if(now != "all") {
			if(now.size() == 1 && now[0] == "physical")
				mode = 1;
			else {
				mode = 2;
				for(name : now)
					if(name != "none")
						picked.push_back(name);
			}
		}

		mode_select = parent.combobox().fixed_height(28).items(["All", "Network cards", "Picked"]).segmented(true)
			.tooltip("Which network cards [[art-net|Art-Net]] and ShizoNet use: they look for nodes over them and only accept nodes from their networks. "
				+ "Network cards leaves out docker, VPN, WSL and Hyper-V switches. Picked: only the cards switched on below. Personal: the same for every project.\n[[wiki:Output-and-Devices#network-cards]]");
		mode_select.selected(mode);
		mode_select.on_change([this](v, txt) {
			//Picked with nothing picked yet: start with the cards "Network cards" would use
			if(v == 2 && this.picked.size() == 0) {
				for(c : shizonet.interfaces())
					if(c.physical && c.up && !c.loopback && !this.picked.has_value(c.name))
						this.picked.push_back(c.name);
			}
			this.apply();
			this.build_list();
		});

		//The rows are rebuilt by the mode switch and Refresh, never by a click on one of them (clear_children)
		list_box = parent.widget().anchor_left(0).anchor_right(0).layout(nanogui.layout_vertical());

		refresh = parent.button("Refresh").tooltip("Read the network cards again, e.g. after plugging in a USB adapter or a cable.");
		refresh.on_click([this]() {
			this.build_list();
		});

		build_list();
	}

	//One row per card: name, address, virtual / down. In "Picked" a switch, else whether it is used
	build_list() {
		list_box.clear_children();
		mode = mode_select.selected();
		seen = [];
		// macOS: the name of the network settings first ("Wi-Fi (en0)"); on Windows the description is the long name
		// of the adapter, there the name is the one of the settings already
		mac = std.os_platform().lowercase().starts("mac");
		for(c : shizonet.interfaces()) {
			if(c.loopback || seen.has_value(c.name))
				continue;
			seen.push_back(c.name);
			text = mac && c.description != "" ? c.description + " (" + c.name + ")" : c.name;
			if(c.ip != "")
				text += " · " + c.ip;
			if(!c.physical)
				text += " · virtual";
			if(!c.up)
				text += " · down";
			if(mode == 2) {
				btn = list_box.pushbutton(text).anchor_left(0).anchor_right(0);
				btn.pushed(picked.has_value(c.name));
				name = c.name;
				btn.on_change([this, name](v) {
					this.pick(name, v);
				});
			}
			else
				list_box.label(text + (c.used ? " · used" : " · not used")).font_size(13).fixed_height(22);
		}
		if(seen.size() == 0)
			list_box.label("No network card found").font_size(13).fixed_height(22);
	}

	pick(name, on) {
		if(on && !picked.has_value(name))
			picked.push_back(name);
		if(!on)
			picked.erase_value(name);
		apply();
	}

	//To ShizoNet and into the style file. Picked without any card: none is used ("none" matches no card; an empty
	//list would mean every card)
	apply() {
		mode = mode_select.selected();
		selection = "all";
		if(mode == 1)
			selection = "physical";
		else if(mode == 2)
			selection = picked.size() > 0 ? picked.copy() : ["none"];
		shizonet.use_interfaces(selection);
		style = fileio.read_json(STYLE_FILE);
		style.network_interfaces = selection;
		fileio.write_json(STYLE_FILE, style);
	}
}
