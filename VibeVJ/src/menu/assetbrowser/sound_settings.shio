//Settings > Sound (#460 point 5): where the sound of video clips plays. The main output (the system's default or a
//device chosen by name) and the pre-listen output (headphones) for the clips with Pre-listen on. Personal, kept in the
//style file by device name (video_audio_output / video_audio_prelisten), applied at start up (sound_settings_apply).
//nanogui keeps a chosen device that is missing and takes it again when it is back; the lists here follow the devices
//while the window is open (tick, every 2 s).

SOUND_SETTINGS_TEXT_2 = vec4f(0.608, 0.608, 0.627, 1.0);
SOUND_SETTINGS_REFRESH_MS = 2000;

//At start up: the outputs chosen in the style file
sound_settings_apply(style) {
	if(style.has("video_audio_output"))
		nanogui.video_audio_output(std.string(style.video_audio_output));
	if(style.has("video_audio_prelisten"))
		nanogui.video_audio_prelisten_output(std.string(style.video_audio_prelisten));
}

class sound_settings
{
	engine = None;
	settings = None; //the tool window of the settings
	managed output_select = None;
	managed prelisten_select = None;
	managed status = None;
	output_names = [];    //the device of each item of output_select ("" = default)
	prelisten_names = []; //the device of each item of prelisten_select ("" = off)
	devices_seen = None;
	refresh_ms = 0;

	__init__(engine, settings, page) {
		this.engine = engine;
		this.settings = settings;

		settings.section(page, "Sound of video clips");
		settings.note(page, "Personal: the same for every project, kept by the name of the device.");
		settings.note(page, "A device that is not connected is kept: the default output plays meanwhile, and the device again when it is back.");

		page.label("Main output").font_size(13).fixed_height(20);
		output_select = page.combobox().fixed_height(28).anchor_left(0).anchor_right(0)
			.tooltip("Where the sound of the clips with Audio on plays.\n[[wiki:Settings#sound]]");
		output_select.on_change([this](v, txt) {
			if(v < 0 || v >= this.output_names.size())
				return;
			this.choose("video_audio_output", this.output_names[v]);
		});

		page.label("Pre-listen output").font_size(13).fixed_height(20);
		prelisten_select = page.combobox().fixed_height(28).anchor_left(0).anchor_right(0)
			.tooltip("Headphones: the clips with Pre-listen on play here instead of the main output, so you hear them before the audience does.\n[[wiki:Settings#sound]]");
		prelisten_select.on_change([this](v, txt) {
			if(v < 0 || v >= this.prelisten_names.size())
				return;
			this.choose("video_audio_prelisten", this.prelisten_names[v]);
		});

		status = page.label("").font_size(13).text_color(SOUND_SETTINGS_TEXT_2).wrap(true).anchor_left(0).anchor_right(0);
		detect = page.button("Look for devices").icon(nanogui.icon("sync")).fixed_height(28).anchor_left(0).anchor_right(0)
			.tooltip("Asks the system for its sound devices again. While this window is open the lists also follow by themselves.\n[[wiki:Settings#sound]]");
		detect.on_click([this](){
			this.refresh(true);
		});

		refresh(true);
	}

	//A choice: applied at once and kept in the style file
	choose(key, name) {
		if(key == "video_audio_output")
			nanogui.video_audio_output(name);
		else
			nanogui.video_audio_prelisten_output(name);
		style = fileio.read_json(STYLE_FILE);
		style[key] = name;
		fileio.write_json(STYLE_FILE, style);
		refresh(true);
	}

	//The items: the default (or off), every device, and a chosen one that is missing
	items_for(devices, chosen, first) {
		names = [""];
		items = [first];
		for(d : devices) {
			names.push_back(d);
			items.push_back(d);
		}
		listed = false;
		for(d : devices)
			if(d == chosen)
				listed = true;
		if(chosen && !listed) {
			names.push_back(chosen);
			items.push_back(chosen + " (not connected)");
		}
		selected = 0;
		for(i = 0; i < names.size(); i++)
			if(names[i] == chosen)
				selected = i;
		return [names = names, items = items, selected = selected];
	}

	refresh(force) {
		devices = [];
		key = "";
		for(d : nanogui.video_audio_devices()) {
			devices.push_back(std.string(d));
			key = key + std.string(d) + "\n";
		}
		st = nanogui.video_audio_status();
		key = key + "|" + st.output + "|" + st.prelisten_output;
		if(force || key != devices_seen) {
			devices_seen = key;
			out = items_for(devices, st.output, "System default");
			output_names = out.names;
			output_select.items(out.items);
			output_select.selected(out.selected);
			pre = items_for(devices, st.prelisten_output, "Off");
			prelisten_names = pre.names;
			prelisten_select.items(pre.items);
			prelisten_select.selected(pre.selected);
		}

		text = "";
		if(st.playing)
			text = "Plays on " + st.playing + (st.fallback ? " (the chosen one is not connected)" : "") + ".";
		else if(st.error)
			text = st.error + ".";
		else
			text = "Opened with the first clip that has Audio, Pre-listen or Audio analysis on.";
		if(st.prelisten_output) {
			if(st.prelisten_playing)
				text = text + " Pre-listen on " + st.prelisten_playing + ".";
			else if(st.prelisten_error)
				text = text + " " + st.prelisten_error + ".";
		}
		if(devices.size() == 0)
			text = text + " The system reports no sound device.";
		status.caption(text);
	}

	//Every frame (__init__.shio): the lists follow the devices while the window is open
	tick() {
		if(!settings.visible())
			return;
		now = std.millis();
		if(now - refresh_ms < SOUND_SETTINGS_REFRESH_MS)
			return;
		refresh_ms = now;
		refresh(false);
	}
}
