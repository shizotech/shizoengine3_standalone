#include "miniagent/miniagent"

CHAT_MENU_CONFIG_PATH = "configs/openai_api.json";

system_user_prompt = R"(
# SYSTEM CONTEXT

You currently operate within the VibeVJ Software as a live agent.

I will give you an instruction and you will choose one of the following execution paths:

## DIRECT OPERATION

If the request suggests actions within the currently running program or the currently open project, use DIRECT OPERATION.

In this mode, you operate VibeVJ through the available VibeVJ tools.

- Load the `vibevj` skill.
- Use the VibeVJ tools to perform the requested actions.
- Do NOT operate on the filesystem level when the requested action can be performed through the running program.
- Do NOT directly modify source files.
- Do NOT read files from the current directory unless absolutely necessary.
- You may list files from the asset directory (`assets/`) to get a grip on what assets are available to the program.
- Do NOT read or inspect asset source/content unless you actually need to understand it to complete the request.
- Prefer using your intuition and the available tools over researching how the program works.
- Choose the fastest reasonable path to the requested result.
- Only investigate or inspect additional information when something does not work as expected or when the information is genuinely required.
- Operate confidently and intuitively, like an experienced pro-user of the software rather than a researcher trying to understand the software from scratch.

Examples that trigger DIRECT OPERATION:

- When the user asks to edit settings
- When the user asks to build a show
- When the user asks to edit the current show
- When the user asks to configure or operate something in the running program
- When the user asks to change parameters or program state
- When the user asks to perform an action that the VibeVJ tools can directly accomplish

## EDIT MODE

If the request suggests changes to the engine source code or requires creating/modifying assets, use EDIT MODE.

In this mode, follow your normal implementation routines to make the requested changes to the actual program source or assets.

Examples:

- When the user asks to create a new asset
- When the user asks to edit an existing asset
- When the user explicitly asks to change functionality of the engine
- When the user explicitly asks to fix or modify engine source code
- When the requested change cannot be performed through the running VibeVJ program and requires source-level changes

Be careful when making changes to engine core files.

Ask for confirmation before modifying engine core files.

Do not modify engine source code merely because doing so would be an alternative way of accomplishing a DIRECT OPERATION request.

## MODE SELECTION

Choose the execution path based on what the user is asking you to accomplish.

The important distinction is:

- If the user wants something done in the currently running VibeVJ program, use DIRECT OPERATION.
- If the user wants to change how VibeVJ itself works, use EDIT MODE.
- If the user wants to create or modify an asset, use EDIT MODE.
- If the user wants to configure, manipulate, or operate the current program state, use DIRECT OPERATION.

Do not interpret a request as EDIT MODE simply because source code could potentially be used to accomplish it.

Prefer DIRECT OPERATION whenever the requested result can be achieved through the running program.

## NOT SURE

If you are unsure which execution path applies, assume DIRECT OPERATION.

Load the `vibevj` skill and attempt to accomplish the request using the VibeVJ tools.

Only use EDIT MODE when it is clear that source-level or asset-level changes are actually required.

# INSTRUCTION

)";

class chat_menu {
	
	managed area = None;
	managed planner = None;
	managed init_thread = None;
	
	__init__(parent) {
		area = parent.widget().anchor(0);	
		init_thread = std.thread([this]() {
			this.build_menu();
		});
		init_thread.run();
	}
	
	build_menu() {
		if(!fileio.exists(CHAT_MENU_CONFIG_PATH))
			build_config_menu();
		else {
			build_start_menu();
		}
	}
	
	build_start_menu() {
		config_area = area.widget().anchor(0).layout(nanogui.layout_vertical());
		connect_btn = config_area.pushbutton("Connect");
		connect_btn.on_click([this, config_area, connect_btn](){
			connect_btn.pushed(false);
			connect_btn.enabled(false);
			cfg = fileio.read_json(CHAT_MENU_CONFIG_PATH);
			if(try_connect(cfg.api, cfg.token, cfg.model))
				build_chat_menu();
			else
				build_config_menu();
			std.free(config_area);
		});
	}
	
	build_config_menu() {
		config_area = area.widget().anchor(0).layout(nanogui.layout_vertical());
		
		add_ctrl = [config_area](name, default_value) {
			div = config_area.widget().fixed_height(30).layout(nanogui.layout_horizontal());
			div.label(name).anchor_left(0).anchor_top(0).anchor_bottom(0).fixed_width(75);
			return div.textbox().anchor(0).anchor_left(75).placeholder(default_value);
		};
		
		api = add_ctrl("API", "https://shizotech.com/llm/v1");
		auth = add_ctrl("Token", "sk-xxx");
		model = add_ctrl("Model", "<can be empty>");
		context_size = add_ctrl("Context Size", "<auto detect>");
		max_running_agents = add_ctrl("Max Active Agents", -1);
		
		connect_btn = config_area.pushbutton("Connect");
		connect_btn.on_click([this, connect_btn, config_area, api, auth, model, context_size, max_running_agents](){
			connect_btn.pushed(false);
			connect_btn.enabled(false);
			if(this.try_connect(api.value(), auth.value(), model.value(), context_size.value(), max_running_agents.value())) {
				model_cfg = ModelConfig();
				model_cfg.set(api.value(), auth.value(), model.value(), context_size.value(), max_running_agents.value());
				model_cfg.save(CHAT_MENU_CONFIG_PATH);
				std.free(config_area);
				this.build_chat_menu();
			}
			else
				connect_btn.enabled(true);
		});
	}
	
	build_chat_menu() {
		chatarea = area.vscroll().scroll(1.0).anchor(0).anchor_bottom(175).content().layout(nanogui.layout_vertical());
		current_type = area.textbox().editable(false).anchor_left(0).anchor_right(0).anchor_bottom(150).fixed_height(25);
		prompt = area.textarea("").editable(true).anchor_left(0).anchor_right(100).anchor_bottom(0).fixed_height(150);
		send_btn = area.button("SEND").anchor_right(0).anchor_bottom(120).fixed_width(100).fixed_height(30);
		stop_btn = area.button("STOP").anchor_right(0).anchor_bottom(90).fixed_width(100).fixed_height(30);
		clear_btn = area.button("CLEAR").anchor_right(0).anchor_bottom(60).fixed_width(100).fixed_height(30);

		cfg = ModelConfig();
		cfg.load(CHAT_MENU_CONFIG_PATH);
		
		planner = miniagent(cfg, "adaptive"); //So that the local agent.space aswell as the global agent.space are visible
		
		model_select = None;
		
		models = planner.get_models();
		if(models.data) {
			model_list = [];
			for(i = 0; i < models.data.size(); i++) {
				model_list.push_back(models.data[i].id);
			}
			
			model_select = area.combobox().anchor_right(0).anchor_bottom(30).fixed_width(100).fixed_height(30).items(model_list);
		
		}
		
		stop_btn.on_click([planner, send_btn](){
			planner.stop();
			send_btn.enabled(true);
		});
		
		clear_btn.on_click([planner, chatarea](){
			planner.set_history(None);
			chatarea.clear_children();
		});
		
		send_btn.on_click([this, send_btn, prompt, chatarea, model_select]() {
			
			send_btn.pushed(false);
			send_btn.enabled(false);
			prompt_text = prompt.value();
			prompt.value("");
			try {
				last_state = "";
				last_chat_msg = None;
				
				new_user_msg = chatarea.textarea(prompt_text).wrap_text(true);
				new_user_msg.fixed_height(50);
				
				if(model_select) {
					planner.set_model(model_select.selected_text());
				}
				
				planner.on_action = [&last_state, &last_chat_msg, chatarea](action) {
					if(action.text) {
						if(*last_state != "text")
							*last_state = "text";
							*last_chat_msg = chatarea.textarea().wrap_text(true);
							std.cout("\n");
						
						stdfcol("white");
						std.cout(action.text);
						last_chat_msg.append(action.text);
					}
					
					if(action.reasoning) {
						if(*last_state != "reasoning")
							*last_state = "reasoning";
							*last_chat_msg = chatarea.collapsable("Thinking...").content().layout(nanogui.layout_vertical()).textarea().wrap_text(true);
							std.cout("\n");
						
						stdfcol("yellow");
						std.cout(action.reasoning);
						last_chat_msg.append(action.reasoning);
					}
					
					if(action.tool) {
						if(*last_state != "tool")
							*last_state = "tool";
							*last_chat_msg = chatarea.collapsable(action.tool.name + "() " + (action.tool.args.has("path") ? "> " + action.tool.args.path : "")).content().layout(nanogui.layout_vertical()).textarea().wrap_text(true).value(action.tool.args);
							std.cout("\n\n");
							
						stdfcol("yellow");
						std.cout("[TOOL] ");
						stdfcol("magenta");
						std.cout(action.tool.name + "()", action.tool.args.has("path") ? "> " + action.tool.args.path : "", "\n");
						stdfcol("white");
					}
				};
				
				planner.env.focus_path = [];
				result = planner.task(system_user_prompt + prompt_text);
				
				if(last_chat_msg)
					last_chat_msg.append("\n");
				
			}
			catch(e) {}
			send_btn.enabled(true);
		});
		
		engine = std.global("engine");

		current_type.on_draw([engine, current_type](){
			if(engine.ai_last_interface)
				current_type.value("Focus on:    " + fileio.file_name(engine.ai_last_interface.target.get_relative_path()));
			else
				current_type.value("Focus on:    <click anywhere to focus>");
		});
	}
	
	try_connect(api, token, model) {
		
		api = api.removesuffix("/v1/");
		api = api.removesuffix("/v1");
		api = api.removesuffix("/");
		
		try {			
			//Test the api once
			gpt = generic_agent(api, model, None, token);
			gpt.on_reason = [](txt) {
				std.cout(txt);
			};
			gpt.on_text = [](txt) {
				std.cout(txt);
			};
			std.cout("\n\n");
			test_result = gpt.text("This is a system test.\nAnswer with 'hello world'.\nDo not write anything else.");
			std.cout("\n\n");
			std.sleep(500);
			if(!test_result)
				return false;
			test_result = test_result.lowercase();
			if(test_result.find("hello world") < 0)
				std.cout("could not get an answer from the API!\n\n");
				std.print(test_result);
				return false;
				
			std.cout("online.\n\n");
			return true;
		}
		catch(e) {}
		
		return false;
	}
}