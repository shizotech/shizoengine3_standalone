#include "miniagent/miniagent"
#include "engine/interfaces/aiinterface"

CHAT_MENU_CONFIG_PATH = "configs/openai_api.json";

system_user_prompt = R"(
# SYSTEM CONTEXT

You currently operate within the VibeVJ Software as a live agent.

- Load the `vibevj` skill first, before doing anything.

# INSTRUCTION

)";

continue_system_prompt = R"(
# User Interrupt — Resume Task Tree

The previous agent execution was interrupted because new information was received from the user.

You must now evaluate the new user information and decide how the current task should continue.

The new user information may:
* change the direction of the current work;
* add new requirements;
* modify existing requirements;
* invalidate part of the previous approach;
* require stopping or abandoning some work;
* require no meaningful change to the current approach.

Adapt the course of the task as necessary to incorporate the new information.

## New user information

<USER_QUERY>

[USER_QUERY]

</USER_QUERY>

## Resuming interrupted work

The interruption halted the currently running task tree.

Unless the new user information explicitly requires the work to be aborted, resume the previously running work.

Previously running tasks must be continued because they were halted by the interruption, not because they naturally finished.

The task hierarchy must resume recursively:

1. Continue the task's previously running child tasks using `task_continue`.
2. When a resumed child continues, it must pass the interruption and the relevant new user information to its own previously running child tasks.
3. Each resumed child must continue its own previously running children in the same way.
4. Continue this recursively until the previously running branches of the task tree have been resumed.

Do not recreate previously running tasks with `task_start`.

Do not continue tasks that had already reached a terminal state before the interruption.

The existing task hierarchy, task state, milestones, reports, and executors remain authoritative.

## Downstream notification

When continuing a previously running child, provide a system notification explaining that:

* the child was halted because a new user query arrived;
* the child should resume its previous work;
* the new user information must be taken into account;
* the child must pass the same notification and relevant user instructions to its own previously running children when continuing them.

The notification must include the exact user instructions from the new query whenever they are relevant to that child.

Do not paraphrase away important user instructions.

## User instructions have priority

The new user information is now part of the active task context.

Determine how it affects the existing task before continuing.

The previous task remains valid where it does not conflict with the new information.

When the new information conflicts with the previous approach, adapt the approach instead of blindly continuing the old plan.

A child may change its implementation strategy, decomposition, contracts, or course of action when necessary to satisfy the updated requirements.

Do not interpret the interruption itself as a request to stop the work.

Only stop or abandon previously running work when:
* the new user information explicitly requires it; or
* continuing it is no longer consistent with the updated task.

## Important

The goal is to resume the existing task tree with the new user information incorporated, not to start a new task from scratch.

Preserve useful previous progress and milestones.

Re-evaluate the next actions in light of the new information.

Resume the work and continue normally.
)";

class chat_menu {
	
	managed area = None;
	managed planner = None;
	managed init_thread = None;
	
	prompt_buffer = "";
	
	__init__(parent) {
		area = parent.widget().anchor(0);	
		init_thread = std.thread([this]() {
			this.build_menu();
		});
		init_thread.run();
	}
	
	build_menu() {
		if(!fileio.exists(CHAT_MENU_CONFIG_PATH))
			build_config_menu();
		else {
			build_start_menu();
		}
	}
	
	build_start_menu() {
		config_area = area.widget().anchor(0).layout(nanogui.layout_vertical());
		connect_btn = config_area.pushbutton("Connect");
		connect_btn.on_click([this, config_area, connect_btn](){
			connect_btn.pushed(false);
			connect_btn.enabled(false);
			cfg = ModelConfig();
			cfg.load(CHAT_MENU_CONFIG_PATH);
			if(try_connect(cfg.url, cfg.token, cfg.name))
				build_chat_menu();
			else
				build_config_menu();
			std.free(config_area);
		});
	}
	
	build_config_menu() {
		config_area = area.widget().anchor(0).layout(nanogui.layout_vertical());
		
		add_ctrl = [config_area](name, default_value) {
			div = config_area.widget().fixed_height(30).layout(nanogui.layout_horizontal());
			div.label(name).anchor_left(0).anchor_top(0).anchor_bottom(0).fixed_width(75);
			return div.textbox().anchor(0).anchor_left(75).placeholder(default_value);
		};
		
		api = add_ctrl("API", "https://shizotech.com/llm/v1");
		auth = add_ctrl("Token", "sk-xxx");
		model = add_ctrl("Model", "<can be empty>");
		context_size = add_ctrl("Context Size", "<auto detect>");
		max_running_agents = add_ctrl("Max Active Agents", -1);
		
		connect_btn = config_area.pushbutton("Connect");
		connect_btn.on_click([this, connect_btn, config_area, api, auth, model, context_size, max_running_agents](){
			connect_btn.pushed(false);
			connect_btn.enabled(false);
			if(this.try_connect(api.value(), auth.value(), model.value())) {
				model_cfg = ModelConfig();
				model_cfg.set(api.value(), auth.value(), model.value(), context_size.value(), max_running_agents.value());
				model_cfg.save(CHAT_MENU_CONFIG_PATH);
				std.free(config_area);
				this.build_chat_menu();
			}
			else
				connect_btn.enabled(true);
		});
	}
	
	build_chat_menu() {
		chatarea = area.vscroll().scroll(1.0).anchor(0).anchor_bottom(175).content().layout(nanogui.layout_vertical());
		current_type = area.textbox().editable(false).anchor_left(0).anchor_right(0).anchor_bottom(150).fixed_height(25);
		prompt = area.textarea("").editable(true).anchor_left(0).anchor_right(100).anchor_bottom(0).fixed_height(150);
		send_btn = area.button("SEND").anchor_right(0).anchor_bottom(120).fixed_width(100).fixed_height(30);
		stop_btn = area.button("STOP").anchor_right(0).anchor_bottom(90).fixed_width(100).fixed_height(30);
		clear_btn = area.button("CLEAR").anchor_right(0).anchor_bottom(60).fixed_width(100).fixed_height(30);
		effort_select = area.combobox().anchor_right(0).anchor_bottom(30).fixed_width(100).fixed_height(30).items(["low", "medium", "high"]);
		effort_select.selected(2);
		
		cfg = ModelConfig();
		cfg.load(CHAT_MENU_CONFIG_PATH);
		
		planner = miniagent(cfg, "adaptive"); 
		planner.set_reasoning_effort("high");
		planner.load_skill("vibevj"); //Preload skill so loading the tools doesnt cause a prefix cache reset
		
		model_select = None;
		
		models = planner.get_models();
		if(models.data) {
			model_list = [];
			for(i = 0; i < models.data.size(); i++) {
				model_list.push_back(models.data[i].id);
			}
			
			model_select = area.combobox().anchor_right(0).anchor_bottom(0).fixed_width(100).fixed_height(30).items(model_list);
		}
		
		effort_select.on_change([planner](v, txt) {
			planner.set_reasoning_effort(txt);
		});
		
		stop_btn.on_click([planner, send_btn](){
			planner.stop();
			send_btn.enabled(true);
		});
		
		clear_btn.on_click([planner, chatarea](){
			planner.set_history(None);
			chatarea.clear_children();
		});
		
		send_btn.on_click([this, send_btn, prompt, chatarea, model_select]() {
			
			prompt_text = prompt.value();
			prompt.value("");
			try {
				last_state = "";
				last_chat_msg = None;
				
				new_user_msg = chatarea.textarea(prompt_text).wrap_text(true);
				new_user_msg.fixed_height(140);
				
				if(!planner.running) {
					if(model_select) {
						planner.set_model(model_select.selected_text());
					}
					
					planner.on_action = [&last_state, &last_chat_msg, chatarea](action) {
						if(action.text) {
							if(*last_state != "text")
								*last_state = "text";
								*last_chat_msg = chatarea.textarea().wrap_text(true);
								std.cout("\n");
							
							stdfcol("white");
							std.cout(action.text);
							last_chat_msg.append(action.text);
						}
						
						if(action.reasoning) {
							if(*last_state != "reasoning")
								*last_state = "reasoning";
								*last_chat_msg = chatarea.collapsable("Thinking...").content().layout(nanogui.layout_vertical()).textarea().wrap_text(true);
								std.cout("\n");
							
							stdfcol("yellow");
							std.cout(action.reasoning);
							last_chat_msg.append(action.reasoning);
						}
						
						if(action.tool) {
							if(*last_state != "tool")
								*last_state = "tool";
								*last_chat_msg = chatarea.collapsable(action.tool.name + "() " + (action.tool.args.has("path") ? "> " + action.tool.args.path : "")).content().layout(nanogui.layout_vertical()).textarea().wrap_text(true);
								tool_arg_str = std.string(action.tool.args);
								tool_arg_str = tool_arg_str.strip();
								last_chat_msg.append(tool_arg_str);
								std.cout("\n\n");
								
							stdfcol("yellow");
							std.cout("[TOOL] ");
							stdfcol("magenta");
							std.cout(action.tool.name + "()", action.tool.args.has("path") ? "> " + action.tool.args.path : "", "\n");
							stdfcol("white");
						}
					};
				
					planner.env.focus_path = [];
				}
				
				std.thread(this.run_planner).run(prompt_text);
				
				if(last_chat_msg)
					last_chat_msg.append("\n");
				
			}
			catch(e) {}
		});
		
		engine = std.global("engine");

		current_type.on_draw([engine, current_type](){
			text = "Focus on:    <click anywhere to focus>";
			if(engine.ai_last_interface)
				text = "Focus on:    " + fileio.file_name(engine.ai_last_interface.target.get_relative_path());
			//Another agent (MCP client) changed something: show it, both may control the same generators
			other = ai_activity_text("chat");
			if(other)
				text += "    |    " + other;
			current_type.value(text);
		});
	}
	
	run_planner(prompt) {
		
		if(!planner.running) {
			prompt_buffer = "";
			planner.send_prompt(system_user_prompt + prompt);
			return;
		}
		else {
			if(prompt_buffer)
				prompt_buffer += "\n\n---\n\n" + prompt;
				return;
			else
				prompt_buffer = prompt;
		}
		
		planner.wait_finish();
		
		final_prompt = continue_system_prompt.replace("[USER_QUERY]", prompt_buffer);
		prompt_buffer = "";
		
		planner.send_prompt(final_prompt);
	}
	
	try_connect(api, token, model) {
		
		api = api.removesuffix("/v1/");
		api = api.removesuffix("/v1");
		api = api.removesuffix("/");
		
		try {			
			//Test the api once
			gpt = generic_agent(api, model, None, token);
			gpt.on_reason = [](txt) {
				std.cout(txt);
			};
			gpt.on_text = [](txt) {
				std.cout(txt);
			};
			std.cout("\n\n");
			test_result = gpt.text("This is a system test.\nAnswer with 'hello world'.\nDo not write anything else.");
			std.cout("\n\n");
			std.sleep(500);
			if(!test_result)
				return false;
			test_result = test_result.lowercase();
			if(test_result.find("hello world") < 0)
				std.cout("could not get an answer from the API!\n\n");
				std.print(test_result);
				return false;
				
			std.cout("online.\n\n");
			return true;
		}
		catch(e) {}
		
		return false;
	}
}