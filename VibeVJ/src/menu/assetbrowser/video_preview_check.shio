// Videos in the Assets tab (#460 point 7, src/menu/assetbrowser/video_preview.shio): the texts (length, frame rate,
// the info line), filebrowser.note() (the text at the right end of a row), the notes of the video rows read with
// nanogui.video_probe, and the preview window that opens when the mouse rests on a video.
//
// Why it is here and not in _testing: video_preview.shio includes the app by paths relative to the app folder, so it
// runs from the app folder (as engine/menus/fixtures/stage3d_check.shio):
//   cd _shizoengine3 && shz src/menu/assetbrowser/video_preview_check.shio
//   (Linux, headless: LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -a shz src/menu/assetbrowser/video_preview_check.shio)
// The clips are those of _testing/video/clips. Without FFmpeg 9 the parts that read a file are skipped.
// Passes when it prints "ALL PASSED" and the process exits with code 0.
import nanogui;
using eigen;
using nanogui;

#include "src/menu/assetbrowser/video_preview"

CLIPS = "../_testing/video/clips";

ok = true;
check(cond, what) {
	if(!cond) {
		std.print("FAIL " + what);
		ok = false;
	}
}

// ---- the texts, no file ----
check(video_preview_duration_text(0) == "", "no length: no text");
check(video_preview_duration_text(0.44) == "0.4 s", "under a second: " + video_preview_duration_text(0.44));
check(video_preview_duration_text(3.0) == "0:03", "3 s: " + video_preview_duration_text(3.0));
check(video_preview_duration_text(83.4) == "1:23", "83.4 s: " + video_preview_duration_text(83.4));
check(video_preview_duration_text(3723) == "1:02:03", "3723 s: " + video_preview_duration_text(3723));
check(video_preview_duration_text(59.6) == "1:00", "59.6 s rounds to a minute: " + video_preview_duration_text(59.6));
check(video_preview_fps_text(30.0) == "30" && video_preview_fps_text(29.97002997) == "29.97" && video_preview_fps_text(23.976) == "23.98",
	"frame rates: " + video_preview_fps_text(29.97002997) + ", " + video_preview_fps_text(23.976));
check(video_preview_codec_name("hap") == "HAP" && video_preview_codec_name("h264") == "H.264" && video_preview_codec_name("foo") == "FOO",
	"codec names");
info = [ok = 1, error = "", codec = "hap", format = "mov", width = 1920, height = 1080, fps = 30.0, duration = 83.4, alpha = 0,
	audio = 1, intra_only = 1];
line = video_preview_info_text(info);
check(line == "1:23 · 1920 × 1080 · 30 fps · HAP · plays backwards · sound", "info line: " + line);
info.audio = 0;
info.intra_only = 0;
info.alpha = 1;
info.codec = "prores";
line = video_preview_info_text(info);
check(line == "1:23 · 1920 × 1080 · 30 fps · ProRes with alpha", "info line without sound: " + line);
check(video_preview_info_text([ok = 0, error = "no such file"]) == "Cannot be read: no such file", "a file that cannot be read");
check(video_preview_info_text(None) == "Cannot be read", "no info (no FFmpeg)");

// ---- filebrowser.note ----
ctx = nanogui.context();
scr = ctx.screen("Video preview check", 900, 600, true, false, false);
scr.visible(1);
side = scr.window("Assets");
side.position(vec2f(0, 0)).fixed_size(vec2f(300, 560));
fb = side.filebrowser(CLIPS);
fb.anchor(0);
std.sleep(500);

hap = fileio.absolute_path(CLIPS + "/counter_hap.mov");
fb.note(hap, "9:99");
check(fb.note(hap) == "9:99", "note() reads back: '" + fb.note(hap) + "'");
check(fb.note(CLIPS + "/counter_hap.mov") == "9:99", "a relative path names the same row");
fb.note(hap, "");
check(fb.note(hap) == "", "an empty text removes the note");
fb.note(hap, "1:00");
fb.clear_notes();
check(fb.note(hap) == "", "clear_notes()");

// ---- the notes of the video rows and the preview (needs FFmpeg 9) ----
if(!nanogui.video_available()) {
	std.print("SKIP the files: no FFmpeg 9 (" + nanogui.video_error() + ")");
}
else {
	engine = [screen = scr];
	vp = video_preview(engine, side);

	// the rows in sight get their length, a few files per call
	rows = fb.item_rects();
	videos = 0;
	for(r : rows) {
		if(!r.dir && video_convert_is_video(r.path))
			videos++;
	}
	check(videos >= 4, "video rows in sight: " + videos);
	for(i = 0; i < 40; i++)
		vp.update_notes(fb);
	check(fb.note(hap) == "0:03", "the row of counter_hap.mov shows its length: '" + fb.note(hap) + "'");
	noted = 0;
	for(r : rows) {
		if(!r.dir && video_convert_is_video(r.path) && fb.note(r.path) != "")
			noted++;
	}
	check(noted == videos, "every video row in sight has its length: " + noted + " of " + videos);
	readme = fileio.absolute_path(CLIPS + "/README.md");
	check(fb.note(readme) == "", "no note on a file that is no video");
	// a file that changed is read again: the note set by hand is replaced once the stamp is not the one kept
	vp.notes[hap].stamp = -1;
	fb.note(hap, "x");
	for(i = 0; i < 5; i++)
		vp.update_notes(fb);
	check(fb.note(hap) == "0:03", "a changed file is read again: '" + fb.note(hap) + "'");

	// the preview: only for a video, only after the mouse rested
	vp.hover(readme, 100);
	std.sleep(VIDEO_PREVIEW_DELAY + 100);
	vp.tick();
	check(!vp.window.visible(), "no preview for a file that is no video");
	vp.hover(hap, 120);
	vp.tick();
	check(!vp.window.visible(), "no preview before the mouse rested");
	std.sleep(VIDEO_PREVIEW_DELAY + 100);
	vp.tick();
	check(vp.window.visible(), "the preview opens after the mouse rested");
	text = vp.info_lbl.caption();
	check(text.find("0:03") >= 0 && text.find("HAP") >= 0 && text.find("plays backwards") >= 0 && text.find("sound") < 0,
		"the info line of counter_hap.mov: " + text);
	check(vp.caption.caption() == "counter_hap.mov", "the caption is the file name: " + vp.caption.caption());
	check(vp.window.position().x >= side.position().x + side.size().x, "the window opens beside the sidebar: x " + vp.window.position().x);
	std.sleep(600);
	check(!std.is_none(vp.video) && vp.video.valid() && vp.video.playing() && vp.video.loop(), "the clip plays in a loop");
	check(!vp.video.audio(), "without sound");
	children = vp.window.child_count();

	// another clip in the same window; the old widget goes
	vp.hover(fileio.absolute_path(CLIPS + "/counter_h264_audio.mp4"), 200);
	std.sleep(VIDEO_PREVIEW_DELAY + 100);
	vp.tick();
	text = vp.info_lbl.caption();
	check(text.find("H.264") >= 0 && text.find("sound") >= 0 && text.find("plays backwards") < 0, "the info line of an H.264 clip with sound: " + text);
	std.sleep(300);
	check(vp.window.child_count() == children, "the old video widget went: " + vp.window.child_count() + " children, " + children + " before");

	// the mouse leaves: gone
	vp.hover("", 0);
	check(!vp.window.visible() && std.is_none(vp.video), "the preview goes when the mouse leaves");
}

std.print(ok ? "ALL PASSED" : "FAILED");
std.exitprocess(ok ? 0 : 1);
