
class artnet_menu {

	__init__(engine, parent) {

		//The ID stays "ArtNetSync" (projects and MIDI mappings use it), the caption says what it is (#436)
		enable_netsync = parent.controlbutton("ArtNetSync").caption("Art-Net sync").tooltip("Sends an [[art-net|Art-Net]] sync after every frame, so all nodes update at the same moment.")
			.anchor_left(0).anchor_right(0)
			.push(1)
			.hide_config_menu();
				
		enable_netsync.callback([engine](v) {
			engine.net.artnet_sync(v);
		});
		
		enable_netsync.value(1);
		
		engine.net.on_connect([this, parent](dev){	
			if(dev.type() != "artnet")
				return;

			//The node by its name, with its IP and MAC in one line (two read-only text fields before, #436)
			dev_menu = parent.collapsable(dev.name()).content().layout(nanogui.layout_vertical());
			t = parent.theme().to_json();
			c = t && t.has("text_secondary_color") ? t.text_secondary_color : None;
			info = dev_menu.label("IP " + dev.ip() + " · MAC " + dev.mac()).anchor_left(0).anchor_right(0);
			if(c)
				info.text_color(vec4f(c.r, c.g, c.b, c.a));
		});
	}
}