
using eigen;

#include "artnet_menu"
#include "network_cards_menu"
#include "fixture_menu"
#include "mcp_menu"
#include "chat_menu"
#include "projects_menu"
#include "shader_preview"
#include "midi_controller_menu"
#include "display_settings"
#include "engine/generators/extensions/video/video_convert"

save_in_progress = false;
load_in_progress = false;

class assetbrowser
{
	managed window = None;
	managed scale_widget = None;
	band = 0; //macOS: height of the band at the top that holds the traffic lights (window_buttons_band), 0 = none
	managed fixtures = None;
	managed artnet = None;
	managed network_cards = None; //Devices > Network > Network cards (#501)
	managed midi_controller = None; //the virtual MIDI controller (#343)
	managed shizonet = None;
	managed chat = None;
	managed mcp = None;
	managed show_links = None;
	on_cable_view = None; //callback(enabled): the Cable view switch changed (by click, MIDI or a loaded project)

	//The project actions (#360), run by the Projects tab (#479), and the settings window, opened from the top bar
	project_actions = None; //[new=, load=, save=, save_as=, exit=], functions
	managed projects = None; //the Projects tab (projects_menu.shio)
	tabs = None; //the tabs of the sidebar
	projects_tab = None;
	managed settings = None; //the settings window (#356)
	managed display_page = None; //Settings > Display (#593, display_settings.shio)
	midi_mapping_buttons = []; //[button=, name=, device=] the "MIDI mapping" button of every MIDI device with an input
	midi_learn_btn = None; //Devices > MIDI > MIDI learn

	//"Convert" of a video or a folder in the list (#278, #460): the running jobs (nanogui.video_convert, a job is
	//cancelled when it is dropped), the menu of the right click and the line at the bottom of the list that shows how
	//far they are. Formats and sizes: engine/generators/extensions/video/video_convert.shio
	filebrowser = None;     //the list of the Assets tab
	managed preview = None; //the preview of a shader the mouse rests on (#536, shader_preview.shio)
	menu_tabs = [];         //[path=, name=]: the tab name of every .menu opened so far (#575, open_menu_asset)
	convert_jobs = [];      //[job=, name=, label=, folder=, stopped=]; folder: a job of the folder queue
	convert_btn = None;
	convert_status = None;
	convert_note = "";      //what the last job said when it ended, shown for a few seconds
	convert_note_until = 0;
	convert_refresh = 0;
	convert_format = 0;     //index into VIDEO_CONVERT_FORMATS: personal, style.json convert_format (#460)
	convert_size = 0;       //index into VIDEO_CONVERT_SIZES: style.json convert_size
	//Convert videos in a folder: one job after the other, [path=, format_index=, size_index=] waiting; what came of them so far
	convert_queue = [];
	convert_queue_stats = [total = 0, done = 0, skipped = 0, failed = 0];
	convert_pumping = false; //pump_convert_queue runs: a second caller returns (see there)
	//The menu of the last right click: its path, whether it is a folder, the videos in it, its action entry
	convert_menu_path = "";
	convert_menu_folder = false;
	convert_menu_videos = [];
	convert_entry = None;

	//Videos that VibeVJ plays (generatoritem.shio)
	is_video_file(path) {
		return video_convert_is_video(path);
	}

	//A job is running or waiting for this copy
	convert_busy(target) {
		for(entry : convert_jobs) {
			if(entry.job.target() == target)
				return true;
		}
		for(item : convert_queue) {
			if(video_convert_target(item.path, item.format_index, item.size_index) == target)
				return true;
		}
		return false;
	}

	convert_queue_active() {
		if(convert_queue.size() > 0)
			return true;
		for(entry : convert_jobs) {
			if(entry.folder)
				return true;
		}
		return false;
	}

	start_convert(path, format_index, size_index, folder) {
		job = nanogui.video_convert(path, video_convert_target(path, format_index, size_index),
			VIDEO_CONVERT_FORMATS[format_index].id, VIDEO_CONVERT_SIZES[size_index]);
		if(!job)
			return false;
		convert_jobs.push_back([job = job, name = fileio.file_name(path), label = video_convert_label(format_index, size_index), folder = folder]);
		convert_refresh = 0;
		return true;
	}

	//Every video of a folder into the queue, with the format and size of now. The draw callback of the tab starts the
	//jobs (update_converts), not this click
	start_folder_convert(dir) {
		if(!convert_queue_active())
			convert_queue_stats = [total = 0, done = 0, skipped = 0, failed = 0];
		for(path : video_convert_folder_videos(dir)) {
			if(convert_busy(video_convert_target(path, convert_format, convert_size)))
				continue;
			convert_queue.push_back([path = path, format_index = convert_format, size_index = convert_size]);
			convert_queue_stats.total = convert_queue_stats.total + 1;
		}
		if(convert_queue.size() == 0 && convert_queue_stats.total == 0) {
			convert_note = "Nothing to convert in " + fileio.file_name(dir);
			convert_note_until = std.millis() + 8000;
		}
		convert_refresh = 0;
	}

	stop_folder_convert() {
		convert_queue = [];
		for(i = 0; i < convert_jobs.size(); i++) {
			if(convert_jobs[i].folder) {
				convert_jobs[i].job.cancel();
				convert_jobs[i].stopped = true; //ends without a "failed" note
			}
		}
		convert_note = "Folder conversion stopped";
		convert_note_until = std.millis() + 8000;
		convert_queue_stats = [total = 0, done = 0, skipped = 0, failed = 0];
		convert_refresh = 0;
	}

	//Starts the next job of the folder queue when none of it runs. A file that is in the format already, or whose copy
	//exists, is left out; at most a few files are read per call, so a folder of such files does not stop the screen.
	//fileio calls give the script to other threads while they wait (a click, the draw callback): without the flag a
	//second pump started the next file of the folder at the same time (seen on Linux, #460)
	pump_convert_queue() {
		if(convert_pumping)
			return;
		convert_pumping = true;
		try {
			pump_convert_queue_step();
		}
		catch(e) {
			std.warn("Folder conversion: " + e);
		}
		convert_pumping = false;
	}

	pump_convert_queue_step() {
		for(entry : convert_jobs) {
			if(entry.folder)
				return;
		}
		reads = 0;
		for(convert_queue.size() > 0 && reads < 4) {
			item = convert_queue[0];
			convert_queue.erase(0);
			reads++;
			if(video_convert_skip_reason(item.path, item.format_index, item.size_index)) {
				convert_queue_stats.skipped = convert_queue_stats.skipped + 1;
				continue;
			}
			if(start_convert(item.path, item.format_index, item.size_index, true))
				return;
			convert_queue_stats.failed = convert_queue_stats.failed + 1;
		}
		if(convert_queue.size() > 0 || convert_queue_stats.total == 0)
			return;
		st = convert_queue_stats;
		convert_note = "Folder done: " + std.string(st.done) + " converted";
		if(st.skipped)
			convert_note = convert_note + ", " + std.string(st.skipped) + " left out (in the format already or converted before)";
		if(st.failed)
			convert_note = convert_note + ", " + std.string(st.failed) + " failed";
		convert_note_until = std.millis() + 10000;
		convert_queue_stats = [total = 0, done = 0, skipped = 0, failed = 0];
		if(filebrowser)
			filebrowser.refresh();
	}

	//Called from the draw callback of the asset tab, at most four times a second
	update_converts() {
		text = "";
		running = [];
		for(i = 0; i < convert_jobs.size(); i++) {
			entry = convert_jobs[i];
			if(!entry.job.finished()) {
				running.push_back(entry);
				text = text + (text ? ", " : "") + entry.name + " to " + entry.label + ": " + std.string(std.int(math.round(entry.job.progress() * 100))) + " %";
				continue;
			}
			if(entry.has("stopped"))
				continue;
			if(entry.job.ok()) {
				convert_note = fileio.file_name(entry.job.target()) + " is ready";
				if(entry.folder)
					convert_queue_stats.done = convert_queue_stats.done + 1;
				if(filebrowser && !entry.folder)
					filebrowser.refresh();
			}
			else {
				convert_note = "Converting " + entry.name + " failed: " + entry.job.error();
				if(entry.folder)
					convert_queue_stats.failed = convert_queue_stats.failed + 1;
			}
			convert_note_until = std.millis() + 8000;
		}
		convert_jobs = running;
		pump_convert_queue();

		st = convert_queue_stats;
		if(text) {
			text = "Converting " + text;
			if(st.total > 1)
				text = text + " (folder: " + std.string(std.int(math.min(st.done + st.skipped + st.failed + 1, st.total))) + " of " + std.string(st.total) + ")";
		}
		else if(convert_note && std.millis() < convert_note_until)
			text = convert_note;
		else
			convert_note = "";

		convert_status.caption(text).visible(text ? true : false);
	}

	save_convert_settings() {
		try {
			style = fileio.read_json(STYLE_FILE);
			style.convert_format = VIDEO_CONVERT_FORMATS[convert_format].id;
			style.convert_size = VIDEO_CONVERT_SIZES[convert_size];
			fileio.write_json(STYLE_FILE, style);
		}
		catch(e) {}
	}

	//Caption, tooltip and state of the action entry of the menu, for the format and size chosen
	update_convert_entry() {
		if(!convert_entry)
			return;
		label = video_convert_label(convert_format, convert_size);
		enabled = true;
		caption = "";
		tip = "";
		if(convert_menu_folder) {
			n = convert_menu_videos.size();
			caption = "Convert " + std.string(n) + (n == 1 ? " video" : " videos") + " here to " + label;
			if(n == 0) {
				caption = "No videos in this folder";
				enabled = false;
			}
			tip = "Converts the videos in this folder (not in its subfolders) to " + label + ", one after the other; the line at the bottom shows how far it is. "
				+ "Left out: files that are " + VIDEO_CONVERT_FORMATS[convert_format].name + " already, files whose copy exists, and the copies Convert made.\n[[wiki:Video#converting]]";
		}
		else {
			path = convert_menu_path;
			target = video_convert_target(path, convert_format, convert_size);
			caption = "Convert to " + label;
			if(convert_busy(target)) {
				caption = "Converting to " + label + "...";
				enabled = false;
			}
			else {
				reason = video_convert_skip_reason(path, convert_format, convert_size);
				if(reason) {
					caption = reason.substr(0, 1).uppercase() + reason.substr(1, reason.size() - 1);
					enabled = false;
				}
			}
			tip = "A copy in " + label + " next to the file, " + fileio.file_name(target) + ": every frame stands on its own, so it can be positioned without waiting and played backwards.\n[[wiki:Video#converting]]";
		}
		convert_entry.caption(caption).tooltip(tip).enabled(enabled);
	}

	//The menu of a right click on a video or a folder: format, size, the action, and Stop while a folder converts
	fill_convert_menu(path) {
		menu = convert_btn.popup().content();
		menu.clear_children();
		convert_entry = None;
		convert_menu_path = path;
		convert_menu_folder = fileio.is_directory(path);
		convert_menu_videos = convert_menu_folder ? video_convert_folder_videos(path) : [];

		tips = "";
		for(f : VIDEO_CONVERT_FORMATS)
			tips = tips + (tips ? "\n" : "") + f.tip;
		menu.label("Format").anchor_left(4);
		format_select = menu.combobox().fixed_height(26).items(video_convert_format_names(true)).segmented(true).anchor_left(0).anchor_right(0)
			.tooltip(tips + "\n[[wiki:Video#converting]]");
		format_select.selected(convert_format);
		format_select.on_change([this](v, txt){
			this.convert_format = v;
			this.save_convert_settings();
			this.update_convert_entry();
		});
		menu.label("Size").anchor_left(4);
		size_select = menu.combobox().fixed_height(26).items(video_convert_size_names()).segmented(true).anchor_left(0).anchor_right(0)
			.tooltip("Original: the size of the file. 1080p, 720p, ...: scaled down (never up, the aspect kept) so that the shorter side has at most that many pixels, e.g. 1920x1080 from 4K\n[[wiki:Video#converting]]");
		size_select.selected(convert_size);
		size_select.on_change([this](v, txt){
			this.convert_size = v;
			this.save_convert_settings();
			this.update_convert_entry();
		});

		convert_entry = menu.button("").alignment("left").anchor_left(0).anchor_right(0).fixed_height(28).icon(nanogui.icon("exchange_alt"));
		convert_entry.on_click([this](){
			this.convert_btn.close();
			if(this.convert_menu_folder)
				this.start_folder_convert(this.convert_menu_path);
			else
				this.start_convert(this.convert_menu_path, this.convert_format, this.convert_size, false);
		});
		update_convert_entry();

		if(convert_queue_active()) {
			left = convert_queue.size() + 1;
			stop = menu.button("Stop converting the folder (" + std.string(left) + " left)").alignment("left").anchor_left(0).anchor_right(0).fixed_height(28)
				.icon(nanogui.icon("stop")).tooltip("Cancels the running job of the folder conversion and the files still waiting; the copies made so far stay");
			stop.on_click([this](){
				this.convert_btn.close();
				this.stop_folder_convert();
			});
		}
	}

	//macOS: a band of this height at the top for the traffic lights, the tabs below it (0 = none, the tabs at the top)
	window_buttons_band(height) {
		band = height;
		scale_widget.anchor_top(height);
	}

	__init__(engine, main_menu) {
	
		project_env = std.global("project");
	
		window = engine.screen.window("");
		window.anchor_top(0)
			.anchor_bottom(0)
			.anchor_left(0)
			.fixed_width(300)
			.movable(false)
			.margin(0)
			.resizable_right(true);
			
		window.on_resize([main_menu](new_size, old_size){
			main_menu.generators_menu.window.anchor_left(new_size.x);
			main_menu.timeline_menu.window.anchor_left(new_size.x);
		});
		
		scale_widget = window.scrollarea().anchor(0).fit_mode(true).zoom_on_scroll(false);
		//The band of the traffic lights (macOS) is the title bar of the sidebar: a press moves the window, a double click
		//zooms it. The right edge still resizes the sidebar
		window.on_mouse_button([this, engine](pos, btn, down, mods){
			if(this.band > 0 && pos.y < this.band && btn == 0 && down) {
				engine.screen.begin_drag();
				return true;
			}
			return this.window.mouse_button_default(pos, btn, down, mods);
		});
		tabs = scale_widget.tabwidget();
		tabs.anchor(0).anchor_right(5);
		
		tabs.on_mouse_button([this, engine, tabs](pos, btn, down, mods)
		{
			if(!tabs.mouse_button_default(pos, btn, down, mods) && down && pos.y < tabs.header_height())
				engine.screen.begin_drag();		
		});
		
		//The settings have a window of their own (#356), opened from the menu and the gear of the top bar.
		//Its controls keep their place in the tree of nodes ("project_ctrls" / "top_controls_node"): projects, links
		//and MIDI mappings address them by that path, as they did in the Project tab of the sidebar
		settings = toolwindow(engine, "Settings", 760, 560);
		project_node = settings.window.matrixnode("project_ctrls", "project_ctrls").anchor(0);
		ctrls_panel = project_node.matrixnode("project_controls", "top_controls_node").anchor(0);
		//The pages are listed at the left side, each with headings for its parts
		settings.side_nav(ctrls_panel);
		page_project = settings.add_page("Project", "file");
		page_links = settings.add_page("Links", "link");
		page_appearance = settings.add_page("Appearance", "eye");
		page_output = settings.add_page("Output", "desktop");
		page_display = settings.add_page("Display", "expand_arrows_alt");

		//The name of the project is shown in the top bar (generators.shio sets project_env.label)
		set_project_label = [project_env](text){
			if(project_env.label)
				project_env.label.text(text);
		};

		settings.section(page_project, "Output size");
		settings.note(page_project, "Saved with the project. New shaders and the mapping tools start with this size.");

		//Where the size comes from (#593): the first output display of Settings > Display (it follows when displays are
		//plugged in or out, and at another venue), or set by hand. A width or height typed in sets it to by hand
		engine.project_size_source = page_project.controlcombo("Target Size Source", "project_ctrls").caption("Size from")
			.items(["Output displays", "Manual"]).segmented(true).anchor_left(0).anchor_right(0).hide_config_menu()
			.tooltip("Output displays: the size of the first output display (Settings > Display), also at another venue. Manual: the width and height below.\n[[wiki:Settings#project]]");
		engine.project_width = page_project.controlint("Target Width", "project_ctrls").tooltip("The width of the output in pixels. New [[shader|shaders]] and the mapping tools start with this size.\n[[wiki:Settings#project]]").caption("Target width").value(1920).anchor_left(0).anchor_right(0).hide_config_menu();
		engine.project_height = page_project.controlint("Target Height", "project_ctrls").tooltip("The height of the output in pixels. New [[shader|shaders]] and the mapping tools start with this size.\n[[wiki:Settings#project]]").caption("Target height").value(1080).anchor_left(0).anchor_right(0).hide_config_menu();

		//Common sizes, 21:9 and 32:9 among them: one sets the size and Manual
		preset_sizes = [];
		preset_items = ["Common size…"];
		for(group : DISPLAY_PRESETS) {
			for(sz : group.sizes) {
				preset_sizes.push_back(sz);
				preset_items.push_back(display_size_text(sz[0], sz[1]));
			}
		}
		size_preset = page_project.combobox().fixed_height(28).items(preset_items).anchor_left(0).anchor_right(0)
			.tooltip("Sets the size to a common one (and Size from to Manual).\n[[wiki:Settings#project]]");
		size_preset.selected(0);
		size_preset.on_change([engine, preset_sizes, size_preset](v, txt) {
			if(v <= 0)
				return;
			sz = preset_sizes[v - 1];
			engine.project_size_source.value(1);
			engine.project_width.value(sz[0]);
			engine.project_height.value(sz[1]);
			size_preset.selected(0);
		});

		//A size typed in by hand while it came from the displays: from now on by hand. Not while a project loads (its
		//saved size: engine.load_project sets engine.load_in_progress, New project the one of this file, #642) or while
		//the displays set it
		size_by_hand = [engine](v) {
			if(engine.load_in_progress || load_in_progress || !engine.displays || engine.displays.applying)
				return;
			if(engine.project_size_source.value() == 0)
				engine.project_size_source.value(1);
		};
		engine.project_width.callback(size_by_hand);
		engine.project_height.callback(size_by_hand);
		engine.project_size_source.callback([engine](v) {
			if(v == 0 && engine.displays)
				engine.displays.apply_project_size();
		});
			
		settings.section(page_project, "Timing");
		settings.note(page_project, "Saved with the project.");

		target_fps = page_project.controlint("Target FPS").tooltip("How many frames per second VibeVJ draws. 0: no limit.\n[[wiki:Settings#project]]")
			.anchor_left(0).anchor_right(0)
			.value(engine.screen.refresh_rate())
			.hide_config_menu();			
		target_fps.callback([](v){
			ctx = nanogui.current_context();
			if(v <= 0)
				ctx.fps(-1); //infinite FPS
			else
				ctx.fps(math.max(30,v));
		});
		
		engine.env.default_sync_mode = page_project.controlcombo("DefaultSync", "timectrls").tooltip("How the time of a new [[shader]] runs: on its own, set by hand, or with the [[timeline]].\n[[wiki:Settings#default-sync]]").caption("Default sync").items(["Free", "Manual", "Sync"]).segmented(true); //index-based
		
		real_fps = page_project.controlint("Current FPS").tooltip("The frames per second VibeVJ reaches right now.\n[[wiki:Settings#project]]")
			.anchor_left(0).anchor_right(0)
			.value(engine.screen.refresh_rate())
			.hide_config_menu();

		//Autosave (__init__.shio): how often the open project is written to the autosave folder. Personal, kept in the
		//style file
		settings.section(page_project, "Autosave");
		settings.note(page_project, "Personal: the same for every project. Never in show mode. If VibeVJ does not close properly, the next start offers the autosave.");
		autosave_items = [];
		autosave_index = 0;
		for(i = 0; i < AUTOSAVE_MINUTES.size(); i++) {
			minutes = AUTOSAVE_MINUTES[i];
			autosave_items.push_back(minutes == 0 ? "Off" : std.string(minutes) + " min");
			if(minutes == engine.autosave_minutes)
				autosave_index = i;
		}
		autosave_select = page_project.combobox().fixed_height(28).items(autosave_items).segmented(true).tooltip("How often the open project is saved to the [[autosave]] folder, never in [[show mode]]. It never replaces your own save.\n[[wiki:Settings#autosave]]");
		autosave_select.selected(autosave_index);
		autosave_select.on_change([engine](v, txt) {
			engine.autosave_minutes = AUTOSAVE_MINUTES[v];
			style = fileio.read_json(STYLE_FILE);
			style.autosave_minutes = AUTOSAVE_MINUTES[v];
			fileio.write_json(STYLE_FILE, style);
		});

		//Link overview: draws every link whose two controls are visible on screen (saved with the project).
		//Generators with "always draw links" on draw their own links regardless of this switch.
		settings.section(page_links, "Cables");
		settings.note(page_links, "Saved with the project.");

		show_links = page_links.controlbutton("Show all links", "project_ctrls").tooltip("[[cable view|Cable view]]: draws every [[link]] on the screen as a cable. The link button in the bar of the [[timeline]] is the same switch.").caption("Cable view").push(1).anchor_left(0).anchor_right(0).hide_config_menu();
		show_links.callback([this](v){
			nanogui.link_overview(v);
			if(this.on_cable_view)
				this.on_cable_view(v);
		});
		
		//Visible controls whose link partner is off screen get a badge with the number of such links
		offscreen_links = page_links.controlbutton("Off-screen link hints", "project_ctrls").tooltip("While the [[cable view]] is on: a badge on a control counts its [[link|links]] that end where you cannot see them.\n[[wiki:Settings#cable-view-and-off-screen-link-hints]]").push(1).anchor_left(0).anchor_right(0).hide_config_menu();
		offscreen_links.callback([](v){
			nanogui.link_overview_offscreen(v);
		});

		//Focus of the cable view (#381): the cables of the selected generators at full strength, the others dimmed
		focus_links = page_links.controlbutton("Only the selection", "project_ctrls").tooltip("While generators are selected (a frame or a click in a Patchview): only their [[link|cables]] at full strength, all others dimmed and without cards. Without a selection every cable shows.\n[[wiki:Linking#seeing-your-links]]").push(1).anchor_left(0).anchor_right(0).hide_config_menu();
		focus_links.callback([](v){
			nanogui.cable_focus_selection(v);
		});
		
		//Appearance: the accent colour of the UI, applied live and kept in the style file
		appearance_content = page_appearance;

		//Interface size: everything bigger or smaller, on top of the scale of the system (a 4K screen at 100 % in
		//Linux, a projector far away). Personal, kept in the style file, applied at start up
		settings.section(appearance_content, "Interface size");
		settings.note(appearance_content, "Personal: the same for every project. 100 % is the scale of your system.");
		settings.note(appearance_content, "Auto: 100 %, more only on a screen as dense as 4K without system scaling.");
		ui_row = appearance_content.widget().fixed_height(28).anchor_left(0).anchor_right(0);
		ui_slider = ui_row.slider("Size").min_value(50).max_value(200).decimals(0).unit("%")
			.value(math.round(engine.screen.ui_scale() * 100))
			.anchor_left(0).anchor_right(80).anchor_top(0).anchor_bottom(0)
			.tooltip("How big buttons, text and windows are drawn, 50 to 200 %. Applied when you let go.\n[[wiki:Settings#interface-size]]");
		ui_auto = ui_row.button("Auto").anchor_right(0).anchor_top(0).anchor_bottom(0).fixed_width(70)
			.tooltip("The size that suits this screen (see the note above).\n[[wiki:Settings#interface-size]]");
		//In steps of 5 %. The size changes when the slider is let go: a change while dragging would move the slider
		//under the mouse. Its caption says whether VibeVJ chose the size (Auto)
		ui_snap = [](v) {
			return std.int(math.round(v / 5.0)) * 5;
		};
		ui_caption = [ui_slider, engine]() {
			auto_now = true;
			try {
				auto_now = !engine.has_ui_scale(fileio.read_json(STYLE_FILE));
			}
			catch(e) {}
			ui_slider.caption(auto_now ? "Size (auto)" : "Size");
		};
		ui_caption();
		ui_apply = [ui_slider, ui_snap, ui_caption, engine]() {
			pct = ui_snap(ui_slider.value());
			ui_slider.value(pct);
			style = fileio.read_json(STYLE_FILE);
			style.ui_scale = pct / 100.0;
			fileio.write_json(STYLE_FILE, style);
			//At once: the views and the timeline follow the new size (on_window_resize in timeline.shio)
			engine.screen.ui_scale(pct / 100.0);
			ui_caption();
		};
		ui_slider.on_mouse_button([ui_slider, ui_apply](pos, btn, down, mods) {
			handled = ui_slider.mouse_button_default(pos, btn, down, mods);
			if(btn == 0 && !down)
				ui_apply();
			return handled;
		});
		ui_auto.on_click([ui_slider, ui_caption, engine]() {
			style = fileio.read_json(STYLE_FILE);
			style.ui_scale = "auto";
			fileio.write_json(STYLE_FILE, style);
			scale = engine.auto_ui_scale();
			engine.screen.ui_scale(scale);
			ui_slider.value(math.round(scale * 100));
			ui_caption();
		});

		settings.section(appearance_content, "Accent colour");
		settings.note(appearance_content, "Personal: the same for every project.");
		accent_picker = appearance_content.color_selector().fixed_height(260);
		accent_now = engine.screen.theme().to_json().accent_color;
		if(accent_now)
			accent_picker.rgba(accent_now.r, accent_now.g, accent_now.b, 1.0);

		apply_accent = [engine](c) {
			accent = [r=c.x, g=c.y, b=c.z, a=1.0];
			theme = engine.screen.theme();
			theme_json = theme.to_json();
			theme_json.accent_color = accent;
			theme.from_json(theme_json);
			style = fileio.read_json(STYLE_FILE);
			style.accent_color = accent;
			fileio.write_json(STYLE_FILE, style);
		};
		accent_picker.on_color_change(apply_accent);

		accent_reset = appearance_content.button("Reset accent colour").tooltip("Back to violet");
		accent_reset.on_click([accent_picker, apply_accent](){
			accent_picker.rgba(157.0 / 255.0, 133.0 / 255.0, 255.0 / 255.0, 1.0); //Shizo UI accent (design/tokens.json)
			apply_accent(accent_picker.rgba());
		});

		//Depth (#651): sections and panels flat, or on a slightly lighter panel with light and dark edges. Personal, part of
		//the theme in the style file
		settings.section(appearance_content, "Depth");
		depth_select = appearance_content.combobox().fixed_height(28).items(["Flat", "Subtle", "Strong"]).segmented(true).tooltip("How much sections and panels stand out from what is around them: flat, a subtle panel with light and dark edges, or a stronger one.\n[[wiki:Settings#depth]]");
		depth_now = engine.screen.theme().to_json().depth;
		depth_select.selected(depth_now == None ? 1 : math.clamp(std.int(depth_now), 0, 2));
		depth_select.on_change([engine](v, txt) {
			theme = engine.screen.theme();
			theme_json = theme.to_json();
			theme_json.depth = v;
			theme.from_json(theme_json);
			style = fileio.read_json(STYLE_FILE);
			style.depth = v;
			fileio.write_json(STYLE_FILE, style);
		});

		//Calm notches (Shizo UI): thin edges at rest that open on hover, everywhere or only in the Clipview. Personal, kept in the style file
		settings.section(appearance_content, "Calm notches");
		calm_select = appearance_content.combobox().fixed_height(28).items(["Everywhere", "Clipview only"]).segmented(true).tooltip("Where a free [[notch]] shows its grey edge while it rests.\n[[wiki:Settings#calm-notches]]");
		calm_select.selected(nanogui.calm_notches() == "clipview" ? 1 : 0);
		calm_select.on_change([](v, txt) {
			mode = v == 1 ? "clipview" : "everywhere";
			nanogui.calm_notches(mode);
			style = fileio.read_json(STYLE_FILE);
			style.calm_notches = mode;
			fileio.write_json(STYLE_FILE, style);
		});

		//Linked notches (Shizo UI): a linked notch is open at full width (default) or stays its coloured edge until hovered.
		//Personal, kept in the style file
		settings.section(appearance_content, "Linked notches");
		linked_select = appearance_content.combobox().fixed_height(28).items(["Open", "Edge only"]).segmented(true).tooltip("How a [[notch]] with a [[link]] rests: open at full width, or as a thin coloured edge.\n[[wiki:Settings#linked-notches]]");
		linked_select.selected(nanogui.linked_notches() == "edge" ? 1 : 0);
		linked_select.on_change([](v, txt) {
			mode = v == 1 ? "edge" : "open";
			nanogui.linked_notches(mode);
			style = fileio.read_json(STYLE_FILE);
			style.linked_notches = mode;
			fileio.write_json(STYLE_FILE, style);
		});

		//Area headers (#347): they stay, with the content below them (default), or they only come at the top edge of an
		//area, over its content. A single area can differ (its menu). Personal, kept in the style file
		settings.section(appearance_content, "Area headers");
		headers_select = appearance_content.combobox().fixed_height(28).items(["Always", "Auto-hide"]).segmented(true).tooltip("Whether the [[header]] of an [[area]] always shows, or only while the mouse is at its top edge.\n[[wiki:The-Screen#the-header-of-an-area]]");
		headers_select.selected(engine.env.area_headers_auto_hide ? 1 : 0);
		headers_select.on_change([engine](v, txt) {
			engine.env.area_headers_auto_hide = v == 1 ? 1 : 0;
			style = fileio.read_json(STYLE_FILE);
			style.area_headers = v == 1 ? "auto_hide" : "always";
			fileio.write_json(STYLE_FILE, style);
			if(engine.env.refresh_areas)
				engine.env.refresh_areas();
		});

		//Display (#593): the connected displays, their role and resolution (display_settings.shio)
		display_page = display_settings(engine, settings, page_display);

		//Blackout (#538): how it comes back. Personal, kept in the style file
		settings.section(page_output, "Blackout");
		settings.note(page_output, nanogui.key_text("Personal. Ctrl+B or the Blackout button of the timeline: black at once, back with this fade."));
		blackout_items = [];
		blackout_index = 0;
		for(i = 0; i < BLACKOUT_FADES.size(); i++) {
			sec = BLACKOUT_FADES[i];
			blackout_items.push_back(BLACKOUT_FADE_NAMES[i]);
			if(engine.blackout && math.abs(sec - engine.blackout.fade_back) < 0.01)
				blackout_index = i;
		}
		blackout_select = page_output.combobox().fixed_height(28).items(blackout_items).segmented(true).tooltip("How long the outputs take to come back after a [[blackout]].\n[[wiki:Output-and-Devices#blackout]]");
		blackout_select.selected(blackout_index);
		blackout_select.on_change([engine](v, txt) {
			if(engine.blackout)
				engine.blackout.fade_back = BLACKOUT_FADES[v];
			style = fileio.read_json(STYLE_FILE);
			style.blackout_fade = BLACKOUT_FADES[v];
			fileio.write_json(STYLE_FILE, style);
		});

		settings.section(page_output, "NDI");
		settings.note(page_output, "Sends the program output as an NDI stream.");

		//Move areas with (#347): the modifier that grabs an area anywhere, not only by its head. Some window managers
		//move a window with Alt + drag and never pass it on. Personal, kept in the style file
		settings.section(appearance_content, "Move areas with");
		settings.note(appearance_content, "Hold it and drag anywhere in an area to move its view.");
		grab_modes = ["alt", "ctrl+alt", "none"];
		grab_select = appearance_content.combobox().fixed_height(28).items(["Alt + drag", "Ctrl + Alt + drag", "Off"]).segmented(true).tooltip("The key that moves a [[view]] by a drag anywhere in its [[area]].\n[[wiki:Settings#move-areas-with]]");
		grab_now = nanogui.grab_modifier();
		grab_select.selected(grab_now == "ctrl+alt" ? 1 : (grab_now == "none" ? 2 : 0));
		grab_select.on_change([grab_modes](v, txt) {
			nanogui.grab_modifier(grab_modes[v]);
			style = fileio.read_json(STYLE_FILE);
			style.grab_modifier = grab_modes[v];
			fileio.write_json(STYLE_FILE, style);
		});

		ndi_vec = page_output.controlvector("NDI Stream", "output_ctrls_ndi").caption("NDI stream").expanded(true);
		ndi_enable = ndi_vec.controlbutton("Enable NDI", "ndi").tooltip("Sends the whole window of VibeVJ as an NDI stream over the network.\n[[wiki:Output-and-Devices#the-whole-window-as-ndi]]").push(1);
		ndi_name = ndi_vec.controltext("NDI Name", "ndi").caption("NDI name").hide_config_menu();
		
		ndi_enable.callback([ndi_name, ctrls_panel](v){
			scr = ctrls_panel.screen();
			scr.ndi_source_name(ndi_name.value());
			scr.ndi_enabled(v);
		});
		
		ndi_name.callback([ctrls_panel](v) {
			scr = ctrls_panel.screen();
			scr.ndi_source_name(v);
		});
		
		ndi_name.value("ProgramOut");
		
		ctx = nanogui.current_context();
		ctx.on_fps_update([real_fps](fps){
			real_fps.value(fps);
		});
		
		//CALLBACKS
		//TODO: move these to the engine class save/load functions
		save_callback = [this, engine](){			
			engine.save_project();
			//A first save creates the project folder: it shows up in the Projects tab right away (#315)
			engine.env.recent_dirty = true;
		};

		saveas_callback = [engine, project_env, save_callback, set_project_label](){
			form = [
				[id="name",  	label="Project name",  	type="text",   	placeholder = project_env.name ?? "New project"],
			];
			
			res = engine.screen.modal_form(form, "Save project", "Save", "Cancel");		
			if(res.choice != "submit")
				return;
			
			//std.print(res);
			
			if(!res.values.name)
				return;
			
			project_env.name = res.values.name;
			set_project_label(project_env.name);

			save_callback();
		};

		//The project actions as functions (#360): the Projects tab runs them (projects_menu.shio, #479)
		do_save_as = [saveas_callback](){
			try {
				saveas_callback();
			}
			catch(e) {}
		};

		do_save = [saveas_callback, save_callback, project_env](){
			try {
				if(!project_env.name) {
					return saveas_callback();
				}
				save_callback();
			}
			catch(e) {}
		};

		do_new = [engine, project_env, set_project_label](){
			if(save_in_progress || load_in_progress)
				return;
			
			res = engine.screen.modal_yes_no_cancel("Create a new project?", "New project");

			if(res != "yes")
				return;
			
			engine.screen.status_overlay("Loading...");
			load_in_progress = true;
			
			std.free(engine.main_generator_view.item);
			
			for(i = 0; i < engine.load_hooks.size(); i++) {
				hook_name = engine.load_hooks.key(i);
				try {
					engine.load_hooks[i](None);
				}
				catch(e) {
					std.error("Cannot run load hook: " + engine.load_hooks.key(i));
				}
			}
			
			//The Blackout button is cleared too: the outputs stay as they are (engine/blackout.shio)
			if(engine.blackout)
				engine.blackout.loading = true;
			nanogui.deserialize_controls([clear=true]);
			if(engine.blackout) {
				engine.blackout.loading = false;
				engine.blackout.sync();
			}
			//A new project takes its size from the output displays (#593)
			engine.project_size_source.value(0);
			if(engine.displays)
				engine.displays.apply_project_size();
						
			set_project_label("<New Project>");

			fileio.remove("engine/last_project.dat");

			project_env.name = None;

			engine.screen.status_overlay("");
			load_in_progress = false;
		};
		
		load_project = [engine](project_name){		
			//engine.load_project refuses a name with no projects/<name> folder and says so (#315)
			if(!engine.load_project(project_name))
				return false;
			
			engine.env.recent_dirty = true;
			return true;
		};
		
		//A template of ./templates (#425): it opens as a new project without a name, Save asks for one
		load_template = [engine](template_name){
			if(!engine.load_project(template_name, "templates"))
				return false;
			
			engine.env.recent_dirty = true;
			return true;
		};
		
		do_load = [engine, project_env, load_project](){

			form = [
				[id="name",  	label="Project name",  	type="text",   	placeholder = project_env.name ?? "New project"],
			];
			
			res = engine.screen.modal_form(form, "Load project", "Load", "Cancel");		
			if(res.choice != "submit")
				return;
			
			if(!res.values.name)
				return;
			
			load_project(res.values.name);
		};

		//Same decision as the window close: an unnamed project is asked about first (#314)
		do_exit = [engine](){
			if(engine.confirm_quit())
				std.exitprocess(0);
		};

		engine.env.load_project = load_project;
		engine.env.load_template = load_template;
		engine.env.save_project = save_callback;
		//The "Save as…" flow of this tab, reused by the Exit / window close question (#314)
		engine.env.save_project_as = saveas_callback;

		project_actions = [new=do_new, load=do_load, save=do_save, save_as=do_save_as, exit=do_exit];
		//Ctrl+S and Ctrl+Shift+S (generators.shio app_key): the same as Save and Save as… of the Projects tab
		engine.env.project_save = do_save;
		engine.env.project_save_as = do_save_as;

		//The Projects tab (#479), before Assets as until #360: the actions, an overview of the open project, all
		//projects and templates. The engine rebuilds its lists from its frame update (#315): at start up, after a
		//load or save, when the tab comes to the front
		projects_tab = tabs.add_tab("Projects");
		projects = projects_menu(projects_tab, engine, main_menu, project_actions);
		engine.env.recent_dirty = true;
		engine.env.refresh_recent = [this](){
			this.projects.refresh();
		};
		tabs.on_change([this](index){
			if(this.tabs.tab_at(index) == this.projects_tab)
				this.projects.shown();
		});
		
		asset_tab = tabs.add_tab("Assets");
		
		filebrowser = asset_tab.filebrowser("assets");
		filebrowser.anchor(0);

		//Not listed: asset.json, the id of an asset folder (engine/generators/asset_resolver.shio, #202), and the views
		//that the user does not pick ("toolbar": false in their view.json): the two splits, which an area makes itself
		//(Split right, Split down, a drop on an edge)
		not_listed = ["asset.json"];
		view_dirs = fileio.dirs("assets/Views", false);
		for(i = 0; i < view_dirs.size(); i++) {
			try {
				meta_path = "assets/Views/" + view_dirs[i] + "/view.json";
				if(!fileio.exists(meta_path))
					continue;
				meta = fileio.read_json(meta_path);
				if(meta && meta.has("toolbar") && !meta.toolbar)
					not_listed.push_back("Views/" + view_dirs[i]);
			}
			catch(e) {}
		}
		filebrowser.exclude(not_listed);

		//A view (or a preset of one) dragged from here goes to the view under the cursor like any other asset: a
		//Patchview, a Clipview or a CueList takes it in, so views nest into each other (#425, no layout_paths as in
		//#362). The split zones of an area only show where nothing in it takes the drop
		
		engine.filebrowser = filebrowser;
		
		//Double click: a .menu runs in a new tab, a text file (code, shader, JSON, Markdown, preset) opens in a code tab.
		//Pictures, videos, sound and the like are not text: they are dragged onto a view instead
		filebrowser.on_double_click([main_menu](path){
			ext = fileio.file_ext(path);
			if(ext == "menu")
				return this.open_menu_asset(path);
			text_files = [shio=1, glsl=1, frag=1, vert=1, fs=1, json=1, preset=1, md=1, txt=1, csv=1, ini=1, cfg=1, xml=1,
				html=1, css=1, js=1, py=1, h=1, c=1, cpp=1, yaml=1, yml=1, MD=1, TXT=1, JSON=1];
			if(!text_files.has(ext))
				return false;
			new_tab = main_menu.generators_menu.subviews.add_tab(fileio.pure_name(path), true);
			new_tab.codebox(fileio.read_string(path)).anchor(0);
			return true;
		});

		//Right click on a video: Convert makes a copy next to it (name_hap.mov, #278), in the format and size chosen in the
		//menu (#460); on a folder it converts every video in it, one after the other. In a HAP file every frame stands on
		//its own, so the clip can be positioned without waiting and played backwards. The menu hangs on a button of no
		//size that is put under the cursor (like the menu of an area, singleview.shio)
		convert_btn = asset_tab.button_popup("").side("auto").transparent(true)
			.anchor_left(0).anchor_top(0).fixed_width(1).fixed_height(1).overlay(true);
		convert_btn.on_screen(true).autoclose(true);
		convert_btn.popup().content().layout(nanogui.layout_vertical());
		convert_btn.popup().content().fixed_width(320);
		convert_status = asset_tab.label("").wrap(true).anchor_left(8).anchor_right(8).anchor_bottom(6).overlay(true).visible(false);
		try {
			style = fileio.read_json(STYLE_FILE);
			if(style && style.has("convert_format"))
				convert_format = video_convert_format_index(style.convert_format);
			if(style && style.has("convert_size"))
				convert_size = video_convert_size_index(style.convert_size);
		}
		catch(e) {}

		filebrowser.on_context_menu([this](pos){
			path = this.filebrowser.path_at(pos);
			if(!path || this.convert_btn.pushed())
				return;
			if(!fileio.is_directory(path) && !this.is_video_file(path))
				return;
			this.fill_convert_menu(path);

			//2 px beside the cursor, so a second right click at the same spot does not hit the button
			this.convert_btn.anchor_left(pos.x - 2).anchor_top(pos.y - 2);
			this.convert_btn.pushed(true);
		});

		//Rest the mouse on a shader in the list: it runs in a small window beside the sidebar (#536). The list keeps its
		//own hover (mouse_motion_default)
		preview = shader_preview(engine, window);
		engine.env.shader_preview = preview;   //ticks in on_frame_finished of the engine
		filebrowser.on_mouse_motion([this](p, rel, button, mods){
			fb = this.filebrowser;
			fb.mouse_motion_default(p, rel, button, mods);
			if(button != 0) {
				this.preview.hover("", 0); //a drag: no preview
				return;
			}
			this.preview.hover(fb.path_at(p), fb.absolute_position().y + p.y);
		});
		filebrowser.on_mouse_enter([this](pos, enter){
			if(!enter)
				this.preview.hover("", 0);
		});

		asset_tab.on_draw([this](){
			if(this.convert_jobs.size() == 0 && this.convert_queue.size() == 0 && !this.convert_note)
				return;
			now = std.millis();
			if(now - this.convert_refresh < 250)
				return;
			this.convert_refresh = now;
			this.update_converts();
		});
		
		
		device_tab = tabs.add_tab("Devices").anchor(0).vscroll().anchor(0).content();
		
		ctrls_panel = device_tab.matrixnode("device_controls", "device_controls_node").layout(nanogui.layout_vertical()).anchor(0);
		
		midi_vec = ctrls_panel.collapsable("MIDI").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		
		midi_learn_global = midi_vec.pushbutton("MIDI learn").tooltip("[[midi learn|MIDI learn]] for all devices: click a control, then move a fader or hit a pad.").latched_style("cue"); //learning waits for a MIDI message: cue (amber), not on
		this.midi_learn_btn = midi_learn_global;
		midi_learn_global.on_change([this](v) {
			//One learn mode at a time: the overlay maps either MIDI or Art-Net
			if(v)
				this.stop_artnet_learn();
			nanogui.midi_learn(v);
		});

		//The virtual controller (#343); its window and device are made below, after the device handler
		controller_btn = midi_vec.button("Virtual controller").icon(nanogui.icon("th")).anchor_left(0).anchor_right(0)
			.tooltip("Knobs, faders, buttons and pads on the screen that send MIDI like a controller (device " + MIDI_CONTROLLER_DEVICE + "): "
				+ "[[midi learn|MIDI learn]] and show prep without hardware.\n[[wiki:MIDI#the-virtual-controller]]");
		controller_btn.on_click([this]() {
			this.midi_controller.show();
		});
		
		nanogui.mididevicehandler([this, midi_vec](dev){
			
			dev_collapsable = midi_vec.collapsable(dev.device_name());
			dev_vec = dev_collapsable.anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());	
			
			dev.on_open([dev, dev_collapsable]() {
				dev_collapsable.title(dev.device_name());
			});
			dev.on_close([dev, dev_collapsable]() {
				dev_collapsable.title(dev.device_name() + " · Offline");
			});
			
			if(dev.has_input()) {
				midi_learn = dev_vec.pushbutton("MIDI mapping").tooltip("[[midi learn|MIDI learn]] for this device only: messages of other controllers are ignored.");
				this.midi_mapping_buttons.push_back([button = midi_learn, name = dev.device_name(), device = dev]);
				midi_learn.on_change([this, dev](v) {
					//One device maps at a time: turning one on replaces the device before it, so its button goes
					//off too. Before, the first button stayed pressed although it no longer mapped (#374)
					if(v) {
						this.stop_artnet_learn();
						for(i = 0; i < this.midi_mapping_buttons.size(); i++) {
							entry = this.midi_mapping_buttons[i];
							if(entry.name != dev.device_name())
								entry.button.pushed(false);
						}
					}
					dev.midi_learn(v);
				});
				dev_vec.control("IN " + dev.device_name()).caption("In · " + dev.device_name());
			}
			if(dev.has_output())
				dev_vec.control("OUT " + dev.device_name()).caption("Out · " + dev.device_name());
		});

		//After the device handler, so its device gets a section like a plugged in one
		midi_controller = midi_controller_menu(engine);
		
		network_vec = ctrls_panel.collapsable("Network").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		
		artnet_vec = network_vec.collapsable("Art-Net").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		artnet = artnet_menu(engine, artnet_vec);
		artnet.on_learn = [this](v) {
			if(v)
				this.stop_midi_learn();
		};
		
		//The cards Art-Net and ShizoNet use (#501)
		cards_vec = network_vec.collapsable("Network cards").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		network_cards = network_cards_menu(cards_vec);

		shizonet_vec = network_vec.collapsable("ShizoNet").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		enable_shizonet = shizonet_vec.controlbutton("Shizonet").tooltip("ShizoNet on or off. Off: VibeVJ stops looking for ShizoNet devices and talking to them. [[art-net|Art-Net]] keeps running.\n[[wiki:Output-and-Devices#shizonet]]").push(1).value(1).hide_config_menu().anchor_left(0).anchor_right(0);
		//The module switch is net.enabled (shizonet_enabled): off stops the ShizoNet device polling,
		//connections and traffic; Art-Net keeps running (#318).
		enable_shizonet.callback([engine](v) {
			engine.net.enabled(v);
		});
		
		//WLED and MQTT get their sections back once they have settings (empty sections are hidden, Shizo UI)
			
		fixtures_vec = ctrls_panel.collapsable("Fixtures").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		fixtures = fixtures_menu(engine, fixtures_vec);		
		//The setup and the editor of the [[fixture|fixtures]] (#575): they were opened by menu files in
		//assets/Fixtures, which is unpractical. The buttons live here, next to the lamps they set up.
		fixture_setup_btn = fixtures_vec.button("Fixture setup").icon(nanogui.icon("th"))
			.tooltip("Where the lamps of the [[project]] are set up: the [[fixture setup]] with the stage plan, the nodes and the universe map\n[[wiki:Output-and-Devices#set-up-your-lamps]]")
			.anchor_left(0).anchor_right(0).fixed_height(28);
		fixture_setup_btn.on_click([this](){
			this.open_menu_asset("engine/menus/fixtures/setup.menu");
		});
		fixture_editor_btn = fixtures_vec.button("Fixture editor")
			.tooltip("Make a [[fixture]] type: its name, its channels and their types\n[[wiki:Output-and-Devices#make-a-fixture-file]]")
			.anchor_left(0).anchor_right(0).fixed_height(28);
		fixture_editor_btn.on_click([this](){
			this.open_menu_asset("engine/menus/fixtures/editor.menu");
		});
			
		chat_tab = tabs.add_tab("Chat");
		chat = chat_menu(chat_tab);
		
		//MCP server for external agents, runs next to the Chat agent (issue #274)
		mcp_tab = tabs.add_tab("MCP");
		mcp = mcp_menu(mcp_tab);

		//The program starts on the assets, as before the Projects tab came back; the last project opens by itself
		tabs.set_active_tab(asset_tab);
		
	}

	//A .menu file opens in a tab of the view bar: a double click in the list, or a button of the
	//Devices tab (#575). A menu that is open comes to the front instead of a second tab
	//MIDI learn and Art-Net learn share the overlay of the controls: turning one on turns the other off
	stop_midi_learn() {
		if(midi_learn_btn && midi_learn_btn.pushed()) {
			midi_learn_btn.pushed(false);
			nanogui.midi_learn(false);
		}
		for(i = 0; i < midi_mapping_buttons.size(); i++) {
			entry = midi_mapping_buttons[i];
			if(entry.button.pushed()) {
				entry.button.pushed(false);
				entry.device.midi_learn(false);
			}
		}
	}

	stop_artnet_learn() {
		if(artnet)
			artnet.learn(false);
	}

	open_menu_asset(path) {
		//The tab is named by the menu_name() of the module, which is only known once it is loaded: the name a path
		//got the last time is looked up, the file name is the guess for a menu without menu_name()
		menu_name = fileio.pure_name(path);
		for(i = 0; i < menu_tabs.size(); i++) {
			if(menu_tabs[i].path == path)
				menu_name = menu_tabs[i].name;
		}
		subviews = std.global("engine").menu.generators_menu.subviews;
		for(i = 0; i < subviews.tab_count(); i++) {
			if(subviews.tab_name(i) == menu_name) {
				subviews.set_active_tab(subviews.tab_at(i));
				return true;
			}
		}
		//A local, and every tab frees its own module: one member for all of them destroyed the module of the menu
		//opened before (its tab went empty) as soon as a second one opened
		mod = std.module();
		mod.load_file(path);
		if(!mod.has("entry")) {
			std.error("Menu loader has no entry point: " + path);
			std.free(mod);
			return false;
		}
		if(mod.has("menu_name"))
			menu_name = mod.call("menu_name");
		known = false;
		for(i = 0; i < menu_tabs.size(); i++) {
			if(menu_tabs[i].path == path) {
				menu_tabs[i].name = menu_name;
				known = true;
			}
		}
		if(!known)
			menu_tabs.push_back([path = path, name = menu_name]);
		new_tab = subviews.add_tab(menu_name, true);
		try {
			mod.call("entry", new_tab);
		}
		catch(e) {
			std.free(mod);
			return false;
		}
		new_tab.on_destroy([mod](){
			std.free(mod);
		});
		return true;
	}
}