
using eigen;

#include "artnet_menu"
#include "fixture_menu"
#include "mcp_menu"
#include "chat_menu"
#include "projects_menu"

save_in_progress = false;
load_in_progress = false;

class assetbrowser
{
	managed window = None;
	managed scale_widget = None;
	managed fixtures = None;
	managed artnet = None;
	managed shizonet = None;
	managed chat = None;
	managed mcp = None;
	managed show_links = None;
	on_cable_view = None; //callback(enabled): the Cable view switch changed (by click, MIDI or a loaded project)

	//The project actions (#360), run by the Projects tab (#479), and the settings window, opened from the top bar
	project_actions = None; //[new=, load=, save=, save_as=, exit=], functions
	managed projects = None; //the Projects tab (projects_menu.shio)
	tabs = None; //the tabs of the sidebar
	projects_tab = None;
	managed settings = None; //the settings window (#356)
	midi_mapping_buttons = []; //[button=, name=] the "MIDI mapping" button of every MIDI device with an input

	//"Convert to HAP" of a video in the list (#278): the running jobs (nanogui.video_convert, a job is cancelled when
	//it is dropped), the menu of the right click and the line at the bottom of the list that shows how far they are
	filebrowser = None;     //the list of the Assets tab
	convert_jobs = [];      //[job=, name=]
	convert_btn = None;
	convert_status = None;
	convert_note = "";      //what the last job said when it ended, shown for a few seconds
	convert_note_until = 0;
	convert_refresh = 0;

	//Videos that VibeVJ plays (generatoritem.shio)
	is_video_file(path) {
		ext = fileio.file_ext(path).lowercase();
		return ext == "mp4" || ext == "mov" || ext == "m4v" || ext == "mkv" || ext == "webm" || ext == "avi" || ext == "mxf" ||
			ext == "mpg" || ext == "mpeg" || ext == "ts" || ext == "wmv";
	}

	hap_copy_of(path) {
		return fileio.file_dir(path) + "/" + fileio.pure_name(path) + "_hap.mov";
	}

	start_convert(path) {
		job = nanogui.video_convert(path, hap_copy_of(path), "hap");
		if(!job)
			return;
		convert_jobs.push_back([job = job, name = fileio.file_name(path)]);
		convert_refresh = 0;
		update_converts();
	}

	//Called from the draw callback of the asset tab, at most four times a second
	update_converts() {
		text = "";
		running = [];
		for(i = 0; i < convert_jobs.size(); i++) {
			entry = convert_jobs[i];
			if(!entry.job.finished()) {
				running.push_back(entry);
				text = text + (text ? ", " : "") + entry.name + " " + std.string(std.int(math.round(entry.job.progress() * 100))) + " %";
				continue;
			}
			if(entry.job.ok()) {
				convert_note = fileio.file_name(entry.job.target()) + " is ready";
				if(filebrowser)
					filebrowser.refresh();
			}
			else
				convert_note = "Converting " + entry.name + " failed: " + entry.job.error();
			convert_note_until = std.millis() + 8000;
		}
		convert_jobs = running;

		if(text)
			text = "Converting to HAP: " + text;
		else if(convert_note && std.millis() < convert_note_until)
			text = convert_note;
		else
			convert_note = "";

		convert_status.caption(text).visible(text ? true : false);
	}

	__init__(engine, main_menu) {
	
		project_env = std.global("project");
	
		window = engine.screen.window("");
		window.anchor_top(0)
			.anchor_bottom(0)
			.anchor_left(0)
			.fixed_width(300)
			.movable(false)
			.margin(0)
			.resizable_right(true);
			
		window.on_resize([main_menu](new_size, old_size){
			main_menu.generators_menu.window.anchor_left(new_size.x);
			main_menu.timeline_menu.window.anchor_left(new_size.x);
		});
		
		scale_widget = window.scrollarea().anchor(0).fit_mode(true).zoom_on_scroll(false);
		tabs = scale_widget.tabwidget();
		tabs.anchor(0).anchor_right(5);
		
		tabs.on_mouse_button([this, engine, tabs](pos, btn, down, mods)
		{
			if(!tabs.mouse_button_default(pos, btn, down, mods) && down && pos.y < tabs.header_height())
				engine.screen.begin_drag();		
		});
		
		//The settings have a window of their own (#356), opened from the menu and the gear of the top bar.
		//Its controls keep their place in the tree of nodes ("project_ctrls" / "top_controls_node"): projects, links
		//and MIDI mappings address them by that path, as they did in the Project tab of the sidebar
		settings = toolwindow(engine, "Settings", 760, 560);
		project_node = settings.window.matrixnode("project_ctrls", "project_ctrls").anchor(0);
		ctrls_panel = project_node.matrixnode("project_controls", "top_controls_node").anchor(0);
		//The pages are listed at the left side, each with headings for its parts
		settings.side_nav(ctrls_panel);
		page_project = settings.add_page("Project", "file");
		page_links = settings.add_page("Links", "link");
		page_appearance = settings.add_page("Appearance", "eye");
		page_output = settings.add_page("Output", "desktop");

		//The name of the project is shown in the top bar (generators.shio sets project_env.label)
		set_project_label = [project_env](text){
			if(project_env.label)
				project_env.label.text(text);
		};

		settings.section(page_project, "Output size");
		settings.note(page_project, "Saved with the project. New shaders and the mapping tools start with this size.");

		engine.project_width = page_project.controlint("Target Width", "project_ctrls").tooltip("The width of the output in pixels. New [[shader|shaders]] and the mapping tools start with this size.\n[[wiki:Settings#project]]").caption("Target width").value(1920).anchor_left(0).anchor_right(0).hide_config_menu();
		engine.project_height = page_project.controlint("Target Height", "project_ctrls").tooltip("The height of the output in pixels. New [[shader|shaders]] and the mapping tools start with this size.\n[[wiki:Settings#project]]").caption("Target height").value(1080).anchor_left(0).anchor_right(0).hide_config_menu();
			
		settings.section(page_project, "Timing");
		settings.note(page_project, "Saved with the project.");

		target_fps = page_project.controlint("Target FPS").tooltip("How many frames per second VibeVJ draws. 0: no limit.\n[[wiki:Settings#project]]")
			.anchor_left(0).anchor_right(0)
			.value(engine.screen.refresh_rate())
			.hide_config_menu();			
		target_fps.callback([](v){
			ctx = nanogui.current_context();
			if(v <= 0)
				ctx.fps(-1); //infinite FPS
			else
				ctx.fps(math.max(30,v));
		});
		
		engine.env.default_sync_mode = page_project.controlcombo("DefaultSync", "timectrls").tooltip("How the time of a new [[shader]] runs: on its own, set by hand, or with the [[timeline]].\n[[wiki:Settings#default-sync]]").caption("Default sync").items(["Free", "Manual", "Sync"]).segmented(true); //index-based
		
		real_fps = page_project.controlint("Current FPS").tooltip("The frames per second VibeVJ reaches right now.\n[[wiki:Settings#project]]")
			.anchor_left(0).anchor_right(0)
			.value(engine.screen.refresh_rate())
			.hide_config_menu();
		
		//Link overview: draws every link whose two controls are visible on screen (saved with the project).
		//Generators with "always draw links" on draw their own links regardless of this switch.
		settings.section(page_links, "Cables");
		settings.note(page_links, "Saved with the project.");

		show_links = page_links.controlbutton("Show all links", "project_ctrls").tooltip("[[cable view|Cable view]]: draws every [[link]] on the screen as a cable. The link button in the bar of the [[timeline]] is the same switch.").caption("Cable view").push(1).anchor_left(0).anchor_right(0).hide_config_menu();
		show_links.callback([this](v){
			nanogui.link_overview(v);
			if(this.on_cable_view)
				this.on_cable_view(v);
		});
		
		//Visible controls whose link partner is off screen get a badge with the number of such links
		offscreen_links = page_links.controlbutton("Off-screen link hints", "project_ctrls").tooltip("While the [[cable view]] is on: a badge on a control counts its [[link|links]] that end where you cannot see them.\n[[wiki:Settings#cable-view-and-off-screen-link-hints]]").push(1).anchor_left(0).anchor_right(0).hide_config_menu();
		offscreen_links.callback([](v){
			nanogui.link_overview_offscreen(v);
		});

		//Focus of the cable view (#381): the cables of the selected generators at full strength, the others dimmed
		focus_links = page_links.controlbutton("Only the selection", "project_ctrls").tooltip("While generators are selected (a frame or a click in a Patchview): only their [[link|cables]] at full strength, all others dimmed and without cards. Without a selection every cable shows.\n[[wiki:Linking#seeing-your-links]]").push(1).anchor_left(0).anchor_right(0).hide_config_menu();
		focus_links.callback([](v){
			nanogui.cable_focus_selection(v);
		});
		
		//Appearance: the accent colour of the UI, applied live and kept in the style file
		appearance_content = page_appearance;

		//Interface size: everything bigger or smaller, on top of the scale of the system (a 4K screen at 100 % in
		//Linux, a projector far away). Personal, kept in the style file, applied at start up
		settings.section(appearance_content, "Interface size");
		settings.note(appearance_content, "Personal: the same for every project. 100 % is the scale of your system. Takes effect the next time VibeVJ starts.");
		ui_sizes = [0.9, 1.0, 1.1, 1.25, 1.5, 2.0];
		ui_now = engine.screen.ui_scale();
		ui_index = 1;
		for(i = 0; i < ui_sizes.size(); i++) {
			if(math.abs(ui_sizes[i] - ui_now) < 0.01)
				ui_index = i;
		}
		ui_select = appearance_content.combobox().fixed_height(28).items(["90 %", "100 %", "110 %", "125 %", "150 %", "200 %"]).segmented(true)
			.tooltip("How big buttons, text and windows are drawn. Useful on a 4K screen without system scaling, or far from the screen.\n[[wiki:Settings#interface-size]]");
		ui_select.selected(ui_index);
		ui_select.on_change([ui_sizes](v, txt) {
			style = fileio.read_json(STYLE_FILE);
			style.ui_scale = ui_sizes[v];
			fileio.write_json(STYLE_FILE, style);
		});

		settings.section(appearance_content, "Accent colour");
		settings.note(appearance_content, "Personal: the same for every project.");
		accent_picker = appearance_content.color_selector().fixed_height(260);
		accent_now = engine.screen.theme().to_json().accent_color;
		if(accent_now)
			accent_picker.rgba(accent_now.r, accent_now.g, accent_now.b, 1.0);

		apply_accent = [engine](c) {
			accent = [r=c.x, g=c.y, b=c.z, a=1.0];
			theme = engine.screen.theme();
			theme_json = theme.to_json();
			theme_json.accent_color = accent;
			theme.from_json(theme_json);
			style = fileio.read_json(STYLE_FILE);
			style.accent_color = accent;
			fileio.write_json(STYLE_FILE, style);
		};
		accent_picker.on_color_change(apply_accent);

		accent_reset = appearance_content.button("Reset accent colour").tooltip("Back to violet");
		accent_reset.on_click([accent_picker, apply_accent](){
			accent_picker.rgba(157.0 / 255.0, 133.0 / 255.0, 255.0 / 255.0, 1.0); //Shizo UI accent (design/tokens.json)
			apply_accent(accent_picker.rgba());
		});

		//Calm notches (Shizo UI): thin edges at rest that open on hover, everywhere or only in the Clipview. Personal, kept in the style file
		settings.section(appearance_content, "Calm notches");
		calm_select = appearance_content.combobox().fixed_height(28).items(["Everywhere", "Clipview only"]).segmented(true).tooltip("Where a free [[notch]] shows its grey edge while it rests.\n[[wiki:Settings#calm-notches]]");
		calm_select.selected(nanogui.calm_notches() == "clipview" ? 1 : 0);
		calm_select.on_change([](v, txt) {
			mode = v == 1 ? "clipview" : "everywhere";
			nanogui.calm_notches(mode);
			style = fileio.read_json(STYLE_FILE);
			style.calm_notches = mode;
			fileio.write_json(STYLE_FILE, style);
		});

		//Linked notches (Shizo UI): a linked notch is open at full width (default) or stays its coloured edge until hovered.
		//Personal, kept in the style file
		settings.section(appearance_content, "Linked notches");
		linked_select = appearance_content.combobox().fixed_height(28).items(["Open", "Edge only"]).segmented(true).tooltip("How a [[notch]] with a [[link]] rests: open at full width, or as a thin coloured edge.\n[[wiki:Settings#linked-notches]]");
		linked_select.selected(nanogui.linked_notches() == "edge" ? 1 : 0);
		linked_select.on_change([](v, txt) {
			mode = v == 1 ? "edge" : "open";
			nanogui.linked_notches(mode);
			style = fileio.read_json(STYLE_FILE);
			style.linked_notches = mode;
			fileio.write_json(STYLE_FILE, style);
		});

		//Area headers (#347): they stay, with the content below them (default), or they only come at the top edge of an
		//area, over its content. A single area can differ (its menu). Personal, kept in the style file
		settings.section(appearance_content, "Area headers");
		headers_select = appearance_content.combobox().fixed_height(28).items(["Always", "Auto-hide"]).segmented(true).tooltip("Whether the [[header]] of an [[area]] always shows, or only while the mouse is at its top edge.\n[[wiki:The-Screen#the-header-of-an-area]]");
		headers_select.selected(engine.env.area_headers_auto_hide ? 1 : 0);
		headers_select.on_change([engine](v, txt) {
			engine.env.area_headers_auto_hide = v == 1 ? 1 : 0;
			style = fileio.read_json(STYLE_FILE);
			style.area_headers = v == 1 ? "auto_hide" : "always";
			fileio.write_json(STYLE_FILE, style);
			if(engine.env.refresh_areas)
				engine.env.refresh_areas();
		});

		settings.section(page_output, "NDI");
		settings.note(page_output, "Sends the program output as an NDI stream.");

		//Move areas with (#347): the modifier that grabs an area anywhere, not only by its head. Some window managers
		//move a window with Alt + drag and never pass it on. Personal, kept in the style file
		settings.section(appearance_content, "Move areas with");
		settings.note(appearance_content, "Hold it and drag anywhere in an area to move its view.");
		grab_modes = ["alt", "ctrl+alt", "none"];
		grab_select = appearance_content.combobox().fixed_height(28).items(["Alt + drag", "Ctrl + Alt + drag", "Off"]).segmented(true).tooltip("The key that moves a [[view]] by a drag anywhere in its [[area]].\n[[wiki:Settings#move-areas-with]]");
		grab_now = nanogui.grab_modifier();
		grab_select.selected(grab_now == "ctrl+alt" ? 1 : (grab_now == "none" ? 2 : 0));
		grab_select.on_change([grab_modes](v, txt) {
			nanogui.grab_modifier(grab_modes[v]);
			style = fileio.read_json(STYLE_FILE);
			style.grab_modifier = grab_modes[v];
			fileio.write_json(STYLE_FILE, style);
		});

		ndi_vec = page_output.controlvector("NDI Stream", "output_ctrls_ndi").caption("NDI stream").expanded(true);
		ndi_enable = ndi_vec.controlbutton("Enable NDI", "ndi").tooltip("Sends the whole window of VibeVJ as an NDI stream over the network.\n[[wiki:Output-and-Devices#the-whole-window-as-ndi]]").push(1);
		ndi_name = ndi_vec.controltext("NDI Name", "ndi").caption("NDI name").hide_config_menu();
		
		ndi_enable.callback([ndi_name, ctrls_panel](v){
			scr = ctrls_panel.screen();
			scr.ndi_source_name(ndi_name.value());
			scr.ndi_enabled(v);
		});
		
		ndi_name.callback([ctrls_panel](v) {
			scr = ctrls_panel.screen();
			scr.ndi_source_name(v);
		});
		
		ndi_name.value("ProgramOut");
		
		ctx = nanogui.current_context();
		ctx.on_fps_update([real_fps](fps){
			real_fps.value(fps);
		});
		
		//CALLBACKS
		//TODO: move these to the engine class save/load functions
		save_callback = [this, engine](){			
			engine.save_project();
			//A first save creates the project folder: it shows up in the Projects tab right away (#315)
			engine.env.recent_dirty = true;
		};

		saveas_callback = [engine, project_env, save_callback, set_project_label](){
			form = [
				[id="name",  	label="Project name",  	type="text",   	placeholder = project_env.name ?? "New project"],
			];
			
			res = engine.screen.modal_form(form, "Save project", "Save", "Cancel");		
			if(res.choice != "submit")
				return;
			
			//std.print(res);
			
			if(!res.values.name)
				return;
			
			project_env.name = res.values.name;
			set_project_label(project_env.name);

			save_callback();
		};

		//The project actions as functions (#360): the Projects tab runs them (projects_menu.shio, #479)
		do_save_as = [saveas_callback](){
			try {
				saveas_callback();
			}
			catch(e) {}
		};

		do_save = [saveas_callback, save_callback, project_env](){
			try {
				if(!project_env.name) {
					return saveas_callback();
				}
				save_callback();
			}
			catch(e) {}
		};

		do_new = [engine, project_env, set_project_label](){
			if(save_in_progress || load_in_progress)
				return;
			
			res = engine.screen.modal_yes_no_cancel("Create a new project?", "New project");

			if(res != "yes")
				return;
			
			engine.screen.status_overlay("Loading...");
			load_in_progress = true;
			
			std.free(engine.main_generator_view.item);
			
			for(i = 0; i < engine.load_hooks.size(); i++) {
				hook_name = engine.load_hooks.key(i);
				try {
					engine.load_hooks[i](None);
				}
				catch(e) {
					std.error("Cannot run load hook: " + engine.load_hooks.key(i));
				}
			}
			
			nanogui.deserialize_controls([clear=true]);
						
			set_project_label("<New Project>");

			fileio.remove("engine/last_project.dat");

			project_env.name = None;

			engine.screen.status_overlay("");
			load_in_progress = false;
		};
		
		load_project = [engine](project_name){		
			//engine.load_project refuses a name with no projects/<name> folder and says so (#315)
			if(!engine.load_project(project_name))
				return false;
			
			engine.env.recent_dirty = true;
			return true;
		};
		
		//A template of ./templates (#425): it opens as a new project without a name, Save asks for one
		load_template = [engine](template_name){
			if(!engine.load_project(template_name, "templates"))
				return false;
			
			engine.env.recent_dirty = true;
			return true;
		};
		
		do_load = [engine, project_env, load_project](){

			form = [
				[id="name",  	label="Project name",  	type="text",   	placeholder = project_env.name ?? "New project"],
			];
			
			res = engine.screen.modal_form(form, "Load project", "Load", "Cancel");		
			if(res.choice != "submit")
				return;
			
			if(!res.values.name)
				return;
			
			load_project(res.values.name);
		};

		//Same decision as the window close: an unnamed project is asked about first (#314)
		do_exit = [engine](){
			if(engine.confirm_quit())
				std.exitprocess(0);
		};

		engine.env.load_project = load_project;
		engine.env.load_template = load_template;
		engine.env.save_project = save_callback;
		//The "Save as…" flow of this tab, reused by the Exit / window close question (#314)
		engine.env.save_project_as = saveas_callback;

		project_actions = [new=do_new, load=do_load, save=do_save, save_as=do_save_as, exit=do_exit];

		//The Projects tab (#479), before Assets as until #360: the actions, an overview of the open project, all
		//projects and templates. The engine rebuilds its lists from its frame update (#315): at start up, after a
		//load or save, when the tab comes to the front
		projects_tab = tabs.add_tab("Projects");
		projects = projects_menu(projects_tab, engine, main_menu, project_actions);
		engine.env.recent_dirty = true;
		engine.env.refresh_recent = [this](){
			this.projects.refresh();
		};
		tabs.on_change([this](index){
			if(this.tabs.tab_at(index) == this.projects_tab)
				this.projects.shown();
		});
		
		asset_tab = tabs.add_tab("Assets");
		
		filebrowser = asset_tab.filebrowser("assets");
		filebrowser.anchor(0);

		//Views that the user does not pick are not listed ("toolbar": false in their view.json): the two splits,
		//which an area makes itself (Split right, Split down, a drop on an edge)
		not_listed = [];
		view_dirs = fileio.dirs("assets/Views", false);
		for(i = 0; i < view_dirs.size(); i++) {
			try {
				meta_path = "assets/Views/" + view_dirs[i] + "/view.json";
				if(!fileio.exists(meta_path))
					continue;
				meta = fileio.read_json(meta_path);
				if(meta && meta.has("toolbar") && !meta.toolbar)
					not_listed.push_back("Views/" + view_dirs[i]);
			}
			catch(e) {}
		}
		filebrowser.exclude(not_listed);

		//A view (or a preset of one) dragged from here goes to the view under the cursor like any other asset: a
		//Patchview, a Clipview or a CueList takes it in, so views nest into each other (#425, no layout_paths as in
		//#362). The split zones of an area only show where nothing in it takes the drop
		
		engine.filebrowser = filebrowser;
		
		//Double click: a .menu runs in a new tab, a text file (code, shader, JSON, Markdown, preset) opens in a code tab.
		//Pictures, videos, sound and the like are not text: they are dragged onto a view instead
		filebrowser.on_double_click([main_menu](path){
			ext = fileio.file_ext(path);
			if(ext == "menu") {
				module = std.module();
				module.load_file(path);
				
				if(!module.has("entry")) {
					std.error("Menu loader has no entry point: " + path);
					std.free(module);
					return false;
				}
				new_tab = main_menu.generators_menu.subviews.add_tab(fileio.pure_name(path), true);
				try {
					module.call("entry", new_tab);
				}
				catch(e) { return false; }
				
				new_tab.on_destroy([module](){
					std.free(module);
				});
				return true;
			}
			text_files = [shio=1, glsl=1, frag=1, vert=1, fs=1, json=1, preset=1, md=1, txt=1, csv=1, ini=1, cfg=1, xml=1,
				html=1, css=1, js=1, py=1, h=1, c=1, cpp=1, yaml=1, yml=1, MD=1, TXT=1, JSON=1];
			if(!text_files.has(ext))
				return false;
			new_tab = main_menu.generators_menu.subviews.add_tab(fileio.pure_name(path), true);
			new_tab.codebox(fileio.read_string(path)).anchor(0);
			return true;
		});

		//Right click on a video: Convert to HAP makes name_hap.mov next to it (#278). In a HAP file every frame stands on
		//its own, so the clip can be positioned without waiting and played backwards. The menu hangs on a button of no
		//size that is put under the cursor (like the menu of an area, singleview.shio)
		convert_btn = asset_tab.button_popup("").side("auto").transparent(true)
			.anchor_left(0).anchor_top(0).fixed_width(1).fixed_height(1).overlay(true);
		convert_btn.on_screen(true).autoclose(true);
		convert_btn.popup().content().layout(nanogui.layout_vertical());
		convert_btn.popup().content().fixed_width(240);
		convert_status = asset_tab.label("").wrap(true).anchor_left(8).anchor_right(8).anchor_bottom(6).overlay(true).visible(false);

		filebrowser.on_context_menu([this](pos){
			path = this.filebrowser.path_at(pos);
			if(!path || !this.is_video_file(path) || this.convert_btn.pushed())
				return;

			menu = this.convert_btn.popup().content();
			menu.clear_children();
			target = this.hap_copy_of(path);
			busy = false;
			for(i = 0; i < this.convert_jobs.size(); i++) {
				if(this.convert_jobs[i].job.target() == target)
					busy = true;
			}
			caption = "Convert to HAP";
			if(busy)
				caption = "Converting to HAP...";
			else if(fileio.exists(target))
				caption = "HAP copy exists: " + fileio.file_name(target);
			entry = menu.button(caption).alignment("left").anchor_left(0).anchor_right(0).fixed_height(28).icon(nanogui.icon("exchange_alt"));
			entry.tooltip("A copy in [[hap|HAP]] next to the file, " + fileio.file_name(target) + ": it can be positioned without waiting and played backwards.\n[[wiki:Video#which-files-play-well]]");
			if(busy || fileio.exists(target))
				entry.enabled(false);
			entry.on_click([this, path](){
				this.convert_btn.close();
				this.start_convert(path);
			});

			//2 px beside the cursor, so a second right click at the same spot does not hit the button
			this.convert_btn.anchor_left(pos.x - 2).anchor_top(pos.y - 2);
			this.convert_btn.pushed(true);
		});

		asset_tab.on_draw([this](){
			if(this.convert_jobs.size() == 0 && !this.convert_note)
				return;
			now = std.millis();
			if(now - this.convert_refresh < 250)
				return;
			this.convert_refresh = now;
			this.update_converts();
		});
		
		
		device_tab = tabs.add_tab("Devices").anchor(0).vscroll().anchor(0).content();
		
		ctrls_panel = device_tab.matrixnode("device_controls", "device_controls_node").layout(nanogui.layout_vertical()).anchor(0);
		
		midi_vec = ctrls_panel.collapsable("MIDI").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		
		midi_learn_global = midi_vec.pushbutton("MIDI learn").tooltip("[[midi learn|MIDI learn]] for all devices: click a control, then move a fader or hit a pad.").latched_style("cue"); //learning waits for a MIDI message: cue (amber), not on
		midi_learn_global.on_change([](v) {
			nanogui.midi_learn(v);
		});
		
		nanogui.mididevicehandler([this, midi_vec](dev){
			
			dev_collapsable = midi_vec.collapsable(dev.device_name());
			dev_vec = dev_collapsable.anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());	
			
			dev.on_open([dev, dev_collapsable]() {
				dev_collapsable.title(dev.device_name());
			});
			dev.on_close([dev, dev_collapsable]() {
				dev_collapsable.title(dev.device_name() + " · Offline");
			});
			
			if(dev.has_input()) {
				midi_learn = dev_vec.pushbutton("MIDI mapping").tooltip("[[midi learn|MIDI learn]] for this device only: messages of other controllers are ignored.");
				this.midi_mapping_buttons.push_back([button = midi_learn, name = dev.device_name()]);
				midi_learn.on_change([this, dev](v) {
					//One device maps at a time: turning one on replaces the device before it, so its button goes
					//off too. Before, the first button stayed pressed although it no longer mapped (#374)
					if(v) {
						for(i = 0; i < this.midi_mapping_buttons.size(); i++) {
							entry = this.midi_mapping_buttons[i];
							if(entry.name != dev.device_name())
								entry.button.pushed(false);
						}
					}
					dev.midi_learn(v);
				});
				dev_vec.control("IN " + dev.device_name()).caption("In · " + dev.device_name());
			}
			if(dev.has_output())
				dev_vec.control("OUT " + dev.device_name()).caption("Out · " + dev.device_name());
		});
		
		network_vec = ctrls_panel.collapsable("Network").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		
		artnet_vec = network_vec.collapsable("Artnet").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		artnet = artnet_menu(engine, artnet_vec);
		
		shizonet_vec = network_vec.collapsable("Shizonet").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		enable_shizonet = shizonet_vec.controlbutton("Shizonet").tooltip("ShizoNet on or off. Off: VibeVJ stops looking for ShizoNet devices and talking to them. [[art-net|Art-Net]] keeps running.\n[[wiki:Output-and-Devices#shizonet]]").push(1).value(1).hide_config_menu().anchor_left(0).anchor_right(0);
		//The module switch is net.enabled (shizonet_enabled): off stops the ShizoNet device polling,
		//connections and traffic; Art-Net keeps running (#318).
		enable_shizonet.callback([engine](v) {
			engine.net.enabled(v);
		});
		
		//WLED and MQTT get their sections back once they have settings (empty sections are hidden, Shizo UI)
			
		fixtures_vec = ctrls_panel.collapsable("Fixtures").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		fixtures = fixtures_menu(engine, fixtures_vec);		
			
		chat_tab = tabs.add_tab("Chat");
		chat = chat_menu(chat_tab);
		
		//MCP server for external agents, runs next to the Chat agent (issue #274)
		mcp_tab = tabs.add_tab("MCP");
		mcp = mcp_menu(mcp_tab);

		//The program starts on the assets, as before the Projects tab came back; the last project opens by itself
		tabs.set_active_tab(asset_tab);
		
	}
}