
using eigen;

#include "artnet_menu"
#include "fixture_menu"
#include "chat_menu"

save_in_progress = false;
load_in_progress = false;

class assetbrowser
{
	managed window = None;
	managed scale_widget = None;
	managed fixtures = None;
	managed artnet = None;
	managed shizonet = None;
	managed chat = None;

	__init__(engine, main_menu) {
	
		project_env = std.global("project");
	
		window = engine.screen.window("");
		window.anchor_top(0)
			.anchor_bottom(0)
			.anchor_left(0)
			.fixed_width(300)
			.movable(false)
			.margin(0)
			.resizable_right(true);
			
		window.on_resize([main_menu](new_size, old_size){
			main_menu.generators_menu.window.anchor_left(new_size.x);
			main_menu.timeline_menu.window.anchor_left(new_size.x);
		});
		
		scale_widget = window.scrollarea().anchor(0).fit_mode(true).zoom_on_scroll(false);
		tabs = scale_widget.tabwidget();
		tabs.anchor(0).anchor_right(5);
		
		tabs.on_mouse_button([this, engine, tabs](pos, btn, down, mods)
		{
			if(!tabs.mouse_button_default(pos, btn, down, mods) && down && pos.y < tabs.header_height())
				engine.screen.begin_drag();		
		});
		
		project_tab = tabs.add_tab("Project").matrixnode("project_ctrls", "project_ctrls").anchor(0).layout(nanogui.layout_vertical());
		
		project_label = project_tab.label("<New Project>").font_size(24).alignment("center");
		
		new_option = project_tab.button("New");
		new_option.alignment("left");
		
		load_option = project_tab.button("Load");
		load_option.alignment("left");

		save_option = project_tab.button("Save");
		save_option.alignment("left");
		
		saveas_option = project_tab.button("Save as");
		saveas_option.alignment("left");
		
		exit_option = project_tab.button("Exit").alignment("left");
		exit_option.on_click([engine](){
			engine.save_project();
			std.exitprocess(0);
		});
		
		settings_option = project_tab.collapsable("Settings");
		
		ctrls_panel = settings_option.matrixnode("project_controls", "top_controls_node").layout(nanogui.layout_vertical()).anchor_left(0).anchor_right(0);
				
		engine.project_width = ctrls_panel.controlint("Target Width", "project_ctrls").value(1920).anchor_left(0).anchor_right(0).hide_config_menu();
		engine.project_height = ctrls_panel.controlint("Target Height", "project_ctrls").value(1080).anchor_left(0).anchor_right(0).hide_config_menu();
			
		target_fps = ctrls_panel.controlint("Target FPS")
			.anchor_left(0).anchor_right(0)
			.value(engine.screen.refresh_rate())
			.hide_config_menu();			
		target_fps.callback([](v){
			ctx = nanogui.current_context();
			if(v <= 0)
				ctx.fps(-1); //infinite FPS
			else
				ctx.fps(math.max(30,v));
		});
		
		real_fps = ctrls_panel.controlint("Current FPS")
			.anchor_left(0).anchor_right(0)
			.value(engine.screen.refresh_rate())
			.hide_config_menu();
		
		ctx = nanogui.current_context();
		ctx.on_fps_update([real_fps](fps){
			real_fps.value(fps);
		});
		
		//CALLBACKS
		//TODO: move these to the engine class save/load functions
		save_callback = [this, engine, project_env](){			
			
			if(!project_env.name)
				return;
			
			if(save_in_progress || load_in_progress)
				return;
			
			engine.screen.status_overlay("Saving...");
			save_in_progress = true;

			if(engine.fixtures)
				tmp_fixtures = engine.fixtures.copy();
				tmp_fixtures.remove_all_keys("device");
				fileio.write_json("projects/" + project_env.name + "/" + "fixture_setup.json", tmp_fixtures);
			
			for(i = 0; i < engine.save_hooks.size(); i++) {
				hook_name = engine.save_hooks.key(i);
				try {
					hook_data = engine.save_hooks[i]();
					fileio.write_json("projects/" + project_env.name + "/" + hook_name + ".json", hook_data);
				}
				catch(e) {
					std.error("Cannot run save hook: " + engine.save_hooks.key(i));
				}
			}
			
			fileio.write_json("projects/" + project_env.name + "/controls.json", nanogui.serialize_controls());
			
			fileio.write_json("projects/" + project_env.name + "/ui_settings.json", [
				filebrowser_scale = this.scale_widget.scale(),
			]);
			
			engine.screen.status_overlay("");
			save_in_progress = false;
		};

		saveas_callback = [engine, project_env, save_callback, project_label](){
			form = [
				[id="name",  	label="Project Name",  	type="text",   	placeholder = project_env.name ?? "New Project"],
			];
			
			res = engine.screen.modal_form(form, "Choose project name", "save", "cancel");		
			if(res.choice != "submit")
				return;
			
			//std.print(res);
			
			if(!res.values.name)
				return;
			
			project_env.name = res.values.name;
			project_label.text(project_env.name);		

			fileio.write_string("engine/last_project.dat", res.values.name);

			save_callback();
		};

		saveas_option.on_click([saveas_option, saveas_callback](){
			saveas_option.pushed(false);
			try {
				saveas_callback();
			}
			catch(e) {}
		});

		save_option.on_click([save_option, saveas_callback, save_callback, project_env](){
			save_option.pushed(false);
			try {
				if(!project_env.name) {
					return saveas_callback();
				}
				save_callback();
			}
			catch(e) {}		
		});
	
		new_option.on_click([new_option, engine, project_env, project_label](){
			new_option.pushed(false);
			if(save_in_progress || load_in_progress)
				return;
			
			res = engine.screen.modal_yes_no_cancel("Create a new project?", "New Project");

			if(res != "yes")
				return;
			
			engine.screen.status_overlay("Loading...");
			load_in_progress = true;
			
			std.free(engine.main_generator_view.item);
			
			for(i = 0; i < engine.load_hooks.size(); i++) {
				hook_name = engine.load_hooks.key(i);
				try {
					engine.load_hooks[i](None);
				}
				catch(e) {
					std.error("Cannot run load hook: " + engine.load_hooks.key(i));
				}
			}
			
			nanogui.deserialize_controls([clear=true]);
						
			project_label.text("<New Project>");	

			fileio.remove("engine/last_project.dat");

			engine.screen.status_overlay("");
			load_in_progress = false;
		});
		
		load_project = [this, engine, project_env, project_label](project_name){		
			if(save_in_progress || load_in_progress)
				return;
			
			std.print("Loading: " + project_name);
			
			project_env.name = project_name;
			project_label.text(project_env.name);		
			
			fileio.write_string("engine/last_project.dat", project_name);
			
			engine.screen.status_overlay("Loading...");
			load_in_progress = true;
			
			if(fileio.exists("projects/" + project_env.name + "/" + "fixture_setup.json"))
				engine.fixtures = fileio.read_json("projects/" + project_env.name + "/" + "fixture_setup.json");
			
			for(i = 0; i < engine.load_hooks.size(); i++) {
				hook_name = engine.load_hooks.key(i);
				try {
					hook_data = fileio.read_json("projects/" + project_env.name + "/" + hook_name + ".json");
					engine.load_hooks[i](hook_data);
				}
				catch(e) {
					std.error("Cannot load hook: " + engine.load_hooks.key(i));
				}
			}
			
			nanogui.deserialize_controls(fileio.read_json("projects/" + project_env.name + "/controls.json"));
			
			ui_settings = fileio.read_json("projects/" + project_env.name + "/ui_settings.json");
			if(ui_settings.filebrowser_scale)
				this.scale_widget.scale(ui_settings.filebrowser_scale);
			
			engine.screen.status_overlay("");
			load_in_progress = false;
		};
		
		load_option.on_click([load_option, engine, project_env, project_label, load_project](){
			
			load_option.pushed(false);
			
			form = [
				[id="name",  	label="Project Name",  	type="text",   	placeholder = project_env.name ?? "New Project"],
			];
			
			res = engine.screen.modal_form(form, "Load Project", "load", "cancel");		
			if(res.choice != "submit")
				return;
			
			if(!res.values.name)
				return;
			
			load_project(res.values.name);
		});
		
		projects_recent = project_tab.collapsable("Recent...").content().layout(nanogui.layout_vertical());
		
		project_dirs = fileio.dirs("projects", false);
		
		for(i = 0; i < project_dirs.size(); i++) {
			project_name = project_dirs[i];
			launch_btn = projects_recent.button(project_name).alignment("left");
			launch_btn.on_click([project_name, load_project](){
				load_project(project_name);
			});
		}
		
		engine.env.load_project = load_project;
		engine.env.save_project = save_callback;
		
		asset_tab = tabs.add_tab("Assets");
		
		filebrowser = asset_tab.filebrowser("assets");
		filebrowser.anchor(0);
		
		engine.filebrowser = filebrowser;
		
		filebrowser.on_double_click([main_menu](path){
			std.print(path);
			new_tab = main_menu.generators_menu.subviews.add_tab(fileio.pure_name(path), true);
			
			if(fileio.file_ext(path) == "menu") {
				module = std.module();
				module.load_file(path);
				
				if(!module.has("entry"))
					std.error("Menu loader has no entry point.");
					return false;		
				try {
					module.call("entry", new_tab);
				}
				catch(e) { return false; }
				
				new_tab.on_destroy([module](){
					std.free(module);
				});
			}
			else
				new_tab.codebox(fileio.read_string(path)).anchor(0);
		});
		
		
		device_tab = tabs.add_tab("Devices").anchor(0).vscroll().anchor(0).content();
		
		ctrls_panel = device_tab.matrixnode("device_controls", "device_controls_node").layout(nanogui.layout_vertical()).anchor(0);
		
		midi_vec = ctrls_panel.collapsable("MIDI").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		
		midi_learn_global = midi_vec.pushbutton("MIDI LEARN");
		midi_learn_global.on_change([](v) {
			nanogui.midi_learn(v);
		});
		
		nanogui.mididevicehandler([this, midi_vec](dev){
			
			dev_collapsable = midi_vec.collapsable(dev.device_name());
			dev_vec = dev_collapsable.anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());	
			
			dev.on_open([dev, dev_collapsable]() {
				dev_collapsable.title(dev.device_name());
			});
			dev.on_close([dev, dev_collapsable]() {
				dev_collapsable.title(dev.device_name() + " (OFFLINE)");
			});
			
			if(dev.has_input()) {
				midi_learn = dev_vec.pushbutton("MIDI MAPPING");
				midi_learn.on_change([dev](v) {
					dev.midi_learn(v);
				});
				dev_vec.control("IN " + dev.device_name());
			}
			if(dev.has_output())
				dev_vec.control("OUT " + dev.device_name());
		});
		
		network_vec = ctrls_panel.collapsable("NETWORK").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		
		artnet_vec = network_vec.collapsable("Artnet").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		artnet = artnet_menu(engine, artnet_vec);
		
		shizonet_vec = network_vec.collapsable("Shizonet").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		enable_shizonet = shizonet_vec.controlbutton("Shizonet").push(1).value(1).hide_config_menu().anchor_left(0).anchor_right(0);
		
		wled_vec = network_vec.collapsable("WLED").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		mqtt_vec = network_vec.collapsable("MQTT").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
			
		fixtures_vec = ctrls_panel.collapsable("FIXTURES").anchor_left(0).anchor_right(0).content().layout(nanogui.layout_vertical());
		fixtures = fixtures_menu(engine, fixtures_vec);		
			
		chat_tab = tabs.add_tab("Chat");
		chat = chat_menu(chat_tab);
		
	}
}