//Settings > Display (#593): every connected display with the size the system runs it at, its role and the resolution
//the picture is made in for it (src/displays.shio keeps them, per display name, in the style file).
//The rows are built again when displays are plugged in or out or a choice changed: at the end of a frame
//(displays_manager.tick), never inside the callback of one of their own widgets, as clear_children() deletes them at once.

DISPLAY_SETTINGS_TEXT_2 = vec4f(0.608, 0.608, 0.627, 1.0);
DISPLAY_SETTINGS_ROLE_WIDTH = 250;

class display_settings
{
	engine = None;
	settings = None; //the tool window of the settings
	managed rows = None;
	managed summary = None;

	__init__(engine, settings, page) {
		this.engine = engine;
		this.settings = settings;

		settings.section(page, "Displays");
		settings.note(page, "Personal: kept for each display by its name, also when the order of the displays changes.");
		settings.note(page, "Control: a screen of the operator (FOH). Output: a projector, an LED wall: the picture is made for it.");
		summary = page.label("").font_size(13).fixed_height(20).anchor_left(0).anchor_right(0);
		detect = page.button("Detect displays").icon(nanogui.icon("sync")).fixed_height(28).anchor_left(0).anchor_right(0)
			.tooltip("Looks at the connected displays again. VibeVJ also notices by itself when one is plugged in or out.\n[[wiki:Settings#display]]");
		detect.on_click([engine](){
			engine.displays.refresh();
		});
		rows = page.widget().layout(nanogui.layout_vertical()).anchor_left(0).anchor_right(0);

		engine.displays.on_page_rebuild = [this](){
			this.rebuild();
		};
		rebuild();
	}

	rebuild() {
		ds = engine.displays;
		rows.clear_children();

		size = ds.output_size();
		outs = ds.outputs();
		if(size)
			summary.caption("Picture size of the outputs: " + display_size_text(size[0], size[1]) + ", from " + outs[0].name +
				(outs.size() > 1 ? " (the first of " + outs.size() + " outputs)" : ""));
		else
			summary.caption("No output display: the project keeps the size set under Project.");

		if(ds.connected.size() == 0) {
			rows.label("The system reports no display.").font_size(13).text_color(DISPLAY_SETTINGS_TEXT_2).fixed_height(24);
			return;
		}
		for(d : ds.connected)
			add_row(d);
	}

	add_row(d) {
		ds = engine.displays;
		key = d.store_name;

		rows.label("").fixed_height(8);
		title = "Display " + (d.index + 1) + " · " + d.name + (d.window ? " · VibeVJ is here" : "");
		rows.label(title).font_size(15).fixed_height(24).anchor_left(0).anchor_right(0);
		info = "Runs at " + display_size_text(d.width, d.height) + (d.hz > 0 ? ", " + d.hz + " Hz" : "") +
			(d.scale > 0 && math.abs(d.scale - 1.0) > 0.01 ? ", system scale " + std.int(math.round(d.scale * 100)) + " %" : "");
		rows.label(info).font_size(13).text_color(DISPLAY_SETTINGS_TEXT_2).fixed_height(20).anchor_left(0).anchor_right(0);

		row = rows.widget().fixed_height(28).anchor_left(0).anchor_right(0);

		//Role: Auto (Control on the display of the window, Output on the others), Control or Output
		auto_name = d.role_auto ? DISPLAY_ROLE_NAMES[d.role] : (d.window ? "Control" : "Output");
		role_select = row.combobox().items(["Auto (" + auto_name + ")", "Control", "Output"]).segmented(true)
			.anchor_left(0).anchor_top(0).anchor_bottom(0).fixed_width(DISPLAY_SETTINGS_ROLE_WIDTH)
			.tooltip("Control: a screen of the operator, it shows VibeVJ. Output: a projector or LED wall; the project size follows the outputs.\n[[wiki:Settings#display]]");
		role_select.selected(d.role_auto ? 0 : d.role + 1);
		role_select.on_change([ds, key](v, txt) {
			ds.set_role(key, v - 1);
		});

		//Resolution: Auto, the common ones (marked when the display lists them), the other sizes it lists, Custom
		modes = ds.modes(d.index);
		choices = [[w = 0, h = 0]];
		items = ["Auto · " + display_size_text(d.width, d.height)];
		selected = 0;
		for(group : DISPLAY_PRESETS) {
			for(sz : group.sizes) {
				listed = false;
				for(m : modes) {
					if(m.w == sz[0] && m.h == sz[1])
						listed = true;
				}
				choices.push_back([w = sz[0], h = sz[1]]);
				items.push_back(display_size_text(sz[0], sz[1]) + (listed ? " · the display lists it" : ""));
				if(!d.res_auto && d.res_w == sz[0] && d.res_h == sz[1])
					selected = choices.size() - 1;
			}
		}
		extra = 0;
		for(m : modes) {
			known = false;
			for(c : choices) {
				if(c.w == m.w && c.h == m.h)
					known = true;
			}
			if(known || extra >= 6)
				continue;
			extra++;
			choices.push_back([w = m.w, h = m.h]);
			items.push_back(display_size_text(m.w, m.h) + " · the display lists it");
			if(!d.res_auto && d.res_w == m.w && d.res_h == m.h)
				selected = choices.size() - 1;
		}
		//A size of its own that is in no list
		if(!d.res_auto && selected == 0) {
			choices.push_back([w = d.res_w, h = d.res_h]);
			items.push_back("Custom: " + display_size_text(d.res_w, d.res_h));
			selected = choices.size() - 1;
		}
		custom_index = choices.size();
		items.push_back("Custom…");

		res_select = row.combobox().items(items)
			.anchor_left(DISPLAY_SETTINGS_ROLE_WIDTH + 10).anchor_right(0).anchor_top(0).anchor_bottom(0)
			.tooltip("The size the picture is made in for this display. Auto: the size the system runs it at. Pick another for a display that reports a wrong one (scaler, splitter, LED processor).\n[[wiki:Settings#display]]");
		res_select.selected(selected);
		res_select.on_change([this, ds, key, choices, custom_index, d](v, txt) {
			if(v == custom_index) {
				form = [
					[id = "width",  label = "Width (pixels)",  type = "text", placeholder = std.string(d.res_w)],
					[id = "height", label = "Height (pixels)", type = "text", placeholder = std.string(d.res_h)],
				];
				res = this.engine.screen.modal_form(form, "Resolution of " + d.name, "OK", "Cancel");
				w = 0;
				h = 0;
				if(res.choice == "submit") {
					w = std.int(res.values.width ? res.values.width : d.res_w);
					h = std.int(res.values.height ? res.values.height : d.res_h);
				}
				if(w >= 16 && h >= 16 && w <= 16384 && h <= 16384)
					ds.set_resolution(key, w, h);
				else
					ds.refresh(); //Cancel: the list shows the resolution it had
				return;
			}
			ds.set_resolution(key, choices[v].w, choices[v].h);
		});
	}
}
