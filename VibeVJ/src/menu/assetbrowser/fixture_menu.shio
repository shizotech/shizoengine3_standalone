
global_arranger = None;
global_editor = None;
global_fixture_menu = None;

class fixture_item {
	path = "";
	managed area = None;
	managed scroll_area = None;
	managed channels = [];
	
	managed total_byte_count = None;
	
	__init__(editor, parent, _path) {
	
		path = _path;
	
		fixture_config = fileio.read_json(path);
		
		if(fixture_config.type != "fixture")
			std.error("json file is not a fixture!");
			return None;
	
		area = parent.widget().anchor(0);

		fixture_name = area.textbox(fileio.pure_name(path)).anchor_left(0).anchor_right(0).anchor_top(0).fixed_height(30);
		
		add_channel = area.button("Add Channel").anchor_left(0).anchor_right(0).anchor_top(30).fixed_height(30);
	
		splitter = area.widget().anchor_left(0).anchor_right(0).anchor_top(60).fixed_height(30);
		splitter.label("Total count:").anchor_left(0).fixed_width(100);
		total_byte_count = splitter.intbox().anchor(0).anchor_left(100);

		scroll_area = area.vscroll().anchor_left(0).anchor_right(0).anchor_top(90).anchor_bottom(0).content().layout(nanogui.layout_vertical());
	
		fixture_name.on_change([this, fixture_name, editor](txt) {
			//Construct path on the fly based on name
			old_path = this.path;
			this.path = fileio.file_dir(old_path) + "/" + txt + ".json";
			fileio.rename(old_path, this.path);
			editor.filebrowser.refresh();
			if(global_arranger)
				global_arranger.filebrowser.refresh();
		});
		
		add_channel.on_click([this](){
			create_channel();
		});
		
		if(fixture_config.channels) {
			for(i = 0; i < fixture_config.channels.size(); i++) {
				chan_config = fixture_config.channels[i];
				chan = create_channel(chan_config.name);
				chan.type_select.selected(chan_config.type_id);
				chan.channel_count.value(chan_config.batch_count);
			}
		}
	}
	
	create_channel(name = "") {
		if(!name)
			name = "New channel";
		
		cnt = scroll_area.widget().layout(nanogui.layout_horizontal()).fixed_height(35);
			
		type_select = cnt.combobox().fixed_width(100);
		type_select.items(["8-bit","16-bit","RGB","RGBW"]);
		type_select.on_change([this](index,txt){
			this.save();
		});
		
		channel_count = cnt.intbox().anchor_left(100).fixed_width(50).min_value(1).max_value(999999).value(1);
		channel_count.value_callback([this](v){
			this.save();
		});
		
		channel_name = cnt.textbox(name).anchor_left(150).anchor_right(25);
		channel_name.on_change([this](txt){
			this.save();
		});
		
		channel_delete = cnt.button("X").anchor_right(0).fixed_width(25);
		
		channel_delete.on_click([this, cnt](){
			for(i = 0; i < channels.size(); i++) {
				if(channels[i].cnt == cnt)
					channels.erase(i);
					break;
			}
			
			std.free(cnt);
			
			this.save();
		});
		
		channels.push_back([
			cnt = cnt,
			type_select = type_select,
			channel_name = channel_name,
			channel_count = channel_count,
		]);
		
		this.save();
		
		return channels[-1];
	}
	
	save() {
		
		managed _grd = std.critical_section();
		
		channel_json = [];
		
		for(i = 0; i < channels.size(); i++) {
			type_text = channels[i].type_select.selected_text();
			type_size = 1;
			if(type_text == "16-bit")
				type_size = 2;
			else if(type_text == "RGB")
				type_size = 3;
			else if(type_text == "RGBW")
				type_size = 4;
			
			channel_json.push_back([
				name=channels[i].channel_name.value(),
				type=type_text,
				type_id = channels[i].type_select.selected(),
				batch_count = channels[i].channel_count.value(),
				byte_count = type_size,
			]);
		}
		
		fileio.write_json(path, [
			type = "fixture",
			channels = channel_json,
		]);
		
		calculate_total_size();
	}
	
	calculate_total_size() {
		total_bytes = 0;
		for(i = 0; i < channels.size(); i++) {
			type_text = channels[i].type_select.selected_text();
			type_size = 1;
			if(type_text == "16-bit")
				type_size = 2;
			else if(type_text == "RGB")
				type_size = 3;
			else if(type_text == "RGBW")
				type_size = 4;
			total_bytes += type_size * channels[i].channel_count.value();
		}
		total_byte_count.value(total_bytes);
		return total_bytes;
	}
}

class fixture_editor {
	managed filebrowser = None;
	managed opened_fixture = None;
	managed fixture_area = None;
	
	__init__(engine, _parent) {
		parent = _parent;
		
		new_fixture = parent.button("Create new fixture").fixed_width(250).anchor_top(0).anchor_left(0);
		
		filebrowser = parent.filebrowser("assets/fixtures");
		filebrowser.anchor(0).anchor_top(30).clear_anchor_right().fixed_width(250);
	
		fixture_area = parent.widget().anchor(0).anchor_left(250);
	
		new_fixture.on_click([this]() {
			dirs = filebrowser.selected_paths();
			
			dir = dirs ? dirs[0] : "assets/fixtures";
			
			if(fileio.is_file(dir))
				dir = fileio.file_dir(dir);

			fixture_path = "";
			
			if(fileio.exists(dir + "/new_fixture.json")) {
				for(i = 2; i < 9999; i++) {
					if(!fileio.exists(dir + "/new_fixture (" + i + ").json"))
						fixture_path = dir + "/new_fixture (" + i + ").json";
						break;
				}
			}
			else
				fixture_path = dir + "/new_fixture.json";
			
			fileio.write_json(fixture_path, [type="fixture"]);
			this.filebrowser.refresh();
			if(global_arranger)
				global_arranger.filebrowser.refresh();
		});
		
		filebrowser.on_double_click([this, engine](path){
			form = [
				[id="name",  	label="New Name",  	type="text",   	placeholder = fileio.pure_name(path)],
			];
			
			res = engine.screen.modal_form(form, "Choose fixture name", "save", "cancel");		
			if(res.choice != "submit")
				return;
			
			fileio.rename(path, fileio.file_dir(path) + "/" + fileio.pure_name(res.values.name) + ".json");
			
			filebrowser.refresh();
			if(global_arranger)
				global_arranger.filebrowser.refresh();
		});
		
		filebrowser.on_click([this, engine](path){		
			open_fixture(path);
		});
	}
	
	open_fixture(path) {
		if(opened_fixture)
			opened_fixture = None;
		opened_fixture = fixture_item(this, fixture_area, path);
	}
}

class fixture_instance {
	
	managed window = None;
	
	__init__(_window) {
		window = _window;
		
		draw_widget = window.pushbutton(" ").anchor(10);
		
		draw_widget.on_draw([draw_widget](){
				ctx = nanogui.current_context();
				ctx.nvgBeginPath();
				ctx.nvgRect(vec2f(5,5), vec2f(draw_widget.width()-10,draw_widget.height()-10));
				ctx.nvgFillColor(vec4f(1,0,0,1));
				ctx.nvgFill();
				
		});
	}
}

class fixture_arranger {
	
	engine = None;
	managed filebrowser = None;
	managed fixture_list = None;
	managed fixture_settings = None;
	managed fixture_area = None;
	managed spatial_fixtures = [];
	
	fixture_types = []; //Should not be managed
	active_fixture_settings = None;
	
	device_list = [];
	
	__init__(_engine, parent) {
		
		engine = _engine;
		
		open_editor = parent.button("Fixture Editor").fixed_width(250).anchor_top(0).anchor_left(0);
		open_editor.on_click([this, engine](){
			
			if(global_editor)
				return;
			
			editor_tab = engine.menu.generators_menu.add_tab("Fixture Editor").anchor_bottom(3);
			global_editor = fixture_editor(engine, editor_tab);
			editor_tab.on_destroy([global_editor](){
				std.free(global_editor);
			});
		});
		
		filebrowser = parent.filebrowser("assets/fixtures");
		filebrowser.anchor(0).anchor_top(30).clear_anchor_right().fixed_width(250);

		fixture_list = parent.widget().anchor(0).anchor_left(250).clear_anchor_right().fixed_width(150).layout(nanogui.layout_vertical());
		fixture_list.label("Drop Fixtures here...");
		fixture_list.on_dragdrop_hover([this](payload, pos) {
			return true;
		});
		
		fixture_list.on_dragdrop([this](payload, pos) {
			path = fileio.relative_path_cwd(payload.path);	
			this.add_fixture(path);
			//Handle payload.paths for multi-file later...
			
			return true;
		});
	
		fixture_settings = parent.widget().anchor(0).anchor_left(250 + 150).clear_anchor_right().fixed_width(200);
	
		fixture_area = parent.scrollarea().anchor(0).anchor_left(300 + 300);
		fixture_area.fit_content();
		
		fixture_area_content = fixture_area.content();
		
		fixture_area_content.fixed_size(vec2f(2200,2200));
		
		fixture_area_content.on_dragdrop_hover([this](payload, pos) {
			return true;
		});
		
		fixture_area_content.on_dragdrop([this](payload, pos) {
			path = fileio.relative_path_cwd(payload.path);	
			this.add_spatial_fixture(path, pos);
			//Handle payload.paths for multi-file later...
			
			return true;
		});
		
		fixture_area_content.on_draw([fixture_area_content](){
				ctx = nanogui.current_context();
				ctx.nvgBeginPath();
				ctx.nvgMoveTo(vec2f(fixture_area_content.width()/2,0));
				ctx.nvgLineTo(vec2f(fixture_area_content.width()/2, fixture_area_content.height()));
				ctx.nvgMoveTo(vec2f(0,fixture_area_content.height()/2));
				ctx.nvgLineTo(vec2f(fixture_area_content.width(), fixture_area_content.height()/2));
				ctx.nvgStrokeColor(vec4f(0.8,0.65,0.34,1));
				ctx.nvgStrokeWidth(4);
				ctx.nvgStroke();
			
				gs = 100;
				w = fixture_area_content.width();
				h = fixture_area_content.height();

				ctx.nvgBeginPath();

				// Vertical grid lines
				for (x = 0; x <= w; x += gs) {
					ctx.nvgMoveTo(vec2f(x, 0));
					ctx.nvgLineTo(vec2f(x, h));
				}

				// Horizontal grid lines
				for (y = 0; y <= h; y += gs) {
					ctx.nvgMoveTo(vec2f(0, y));
					ctx.nvgLineTo(vec2f(w, y));
				}

				ctx.nvgStrokeColor(vec4f(0.3, 0.3, 0.3, 1));
				ctx.nvgStrokeWidth(1);
				ctx.nvgStroke();
			
		});
		
		for(i = 0; i < engine.fixtures.size(); i++) {
			add_fixture(engine.fixtures[i].path);
		}
	}
	
	add_fixture(path) {
		
		if(fixture_types.has(path))
			fixture_types[path].btn.pushed(true);
			return;
		
		splitter = fixture_list.widget().fixed_height(25).layout(nanogui.layout_horizontal());		
		btn = splitter.pushbutton(fileio.pure_name(path) + " >").fixed_height(25).anchor_right(25).anchor_left(0);
		del_btn = splitter.button("X").anchor_right(0).fixed_width(25);
		
		del_btn.on_click([this, path, splitter, btn](){
			
			if(btn.pushed) {
				spatial_fixtures = [];
			}
			
			engine.fixtures.erase(path);
			fixture_types.erase(path);
			
			if(this.active_fixture_settings.btn == btn)
				std.free(this.active_fixture_settings.cnt);
				this.active_fixture_settings = [];
				
			std.free(splitter);
			global_fixture_menu.build_fixture_menu();
		});
		
		if(!engine.fixtures.has(path)) {
			engine.fixtures[path] = [
				path=path,
				instances=[
					[
						name = "",
						device_mac = "",
						device_ip = "",
						universe=0,
						start_channel=0,
						batch_count=1,
					],
				],
			];
		}
		
		engine_fixture = engine.fixtures[path];
				
		btn.on_change([this, path, btn, engine_fixture](v){
			if(this.active_fixture_settings.cnt)
				std.free(this.active_fixture_settings.cnt);
			if(this.active_fixture_settings.btn && this.active_fixture_settings.btn != btn)
				this.active_fixture_settings.btn.pushed(false);
			
			if(v) {
				cnt = fixture_settings.widget().anchor(0).layout(nanogui.layout_vertical());
				
				add_new_type = cnt.button("Add New Instance");
				add_new_type.fixed_height(25);
				
				splitter = cnt.widget().fixed_height(25);
				splitter.label("Total count:").anchor_left(0).fixed_width(100);
				total_count = splitter.intbox().anchor(0).anchor_left(100).min_value(1).max_value(9999).value(1);
				total_count.value(engine_fixture.instances.size());
				
				cnt_items = cnt.vscroll().anchor(0).anchor_top(50).content().layout(nanogui.layout_vertical());
				
				add_instance_ctrls = [this, cnt_items, engine_fixture](num) {
					dev_name = engine_fixture.instances[num-1].name ?? "Device #"+num;
					name_label = cnt_items.textbox(dev_name).fixed_height(30).font_size(28);
					selector = cnt_items.combobox().fixed_height(20).items(["Select Target"]);
					
					splitter = cnt_items.widget().fixed_height(25);
					splitter.label("IP:").anchor_left(0).fixed_width(50);	
					dev_ip = splitter.textbox(engine_fixture.instances[num-1].device_ip ?? "<none>").anchor(0).anchor_left(50);
					
					splitter = cnt_items.widget().fixed_height(25);
					splitter.label("MAC:").anchor_left(0).fixed_width(50);
					dev_mac = splitter.textbox(engine_fixture.instances[num-1].device_mac ?? "<none>").anchor(0).anchor_left(50);
					
					splitter = cnt_items.widget().fixed_height(25);
					splitter.label("Uni:").anchor_left(0).fixed_width(50);	
					dev_uni = splitter.intbox().anchor(0).anchor_left(50).min_value(0).max_value(15).value(engine_fixture.instances[num-1].universe);
					
					splitter = cnt_items.widget().fixed_height(25);
					splitter.label("Adr:").anchor_left(0).fixed_width(50);
					dev_adr = splitter.intbox().anchor(0).anchor_left(50).min_value(1).max_value(511).value(engine_fixture.instances[num-1].start_channel);				
					
					splitter = cnt_items.widget().fixed_height(25);
					splitter.label("Count:").anchor_left(0).fixed_width(50);
					dev_count = splitter.intbox().anchor(0).anchor_left(50).min_value(1).max_value(9999).value(engine_fixture.instances[num-1].batch_count);
					
					name_label.on_change([this, engine_fixture, num](txt){
						engine_fixture.instances[num-1].name = txt;
						global_fixture_menu.build_fixture_menu();
					});			
					dev_uni.value_callback([this, engine_fixture, num](v){
						engine_fixture.instances[num-1].universe = v;
					});
					dev_adr.value_callback([this, engine_fixture, num](v){
						engine_fixture.instances[num-1].start_channel = v;
					});
					dev_count.value_callback([this, engine_fixture, num](v){
						engine_fixture.instances[num-1].batch_count = v;
						global_fixture_menu.build_fixture_menu();
					});
					
					net = this.engine.net;
					
					selector.on_open([this, net, selector](){
						devs = net.artnet_devices();
						this.device_list.items = ["Select Target"];
						this.device_list.devs = [];
						for(i = 0; i < devs.size(); i++)
							this.device_list.items.push_back(devs[i].name());
							this.device_list.devs.push_back(devs[i]);
						selector.items(this.device_list.items);
					});
					selector.on_change([this, dev_mac, dev_ip, num, engine_fixture](v, text){
						if(v == 0) 
							dev_ip.value("<none>");
							dev_mac.value("<none>");
							engine_fixture.instances[num-1].device_mac = "";
							engine_fixture.instances[num-1].device_ip = "";
							engine_fixture.instances[num-1].device = None;
							return;
						
						v--;
						
						if(v < 0 || v >= this.device_list.devs.size())
							return;
						
						dev = this.device_list.devs[v];
						dev_ip.value(dev.ip());
						dev_mac.value(dev.mac());
						
						engine_fixture.instances[num-1].device_mac = dev.mac();
						engine_fixture.instances[num-1].device_ip = dev.ip();
						engine_fixture.instances[num-1].device = dev;
					});
				};
				
				build_items = [this, engine_fixture, cnt_items, add_instance_ctrls]() {
					cnt_items.clear_children();
					
					spatial_fixtures = [];
					
					for(i = 0; i < engine_fixture.instances.size(); i++) {
						add_instance_ctrls(i+1);
						add_spatial_fixture(engine_fixture, i);
					}
					
					global_fixture_menu.build_fixture_menu();
				};
				
				add_new_type.on_click([this,engine,engine_fixture,build_items,total_count](){

					engine_fixture.instances.push_back(
					[
						name = "",
						device_mac = "",
						device_ip = "",
						universe=0,
						start_channel=0,
						batch_count=1,
					]);
					
					total_count.value(total_count.value()+1);
					
					build_items();
				});

				total_count.value_callback([this, total_count, engine_fixture, build_items](v){
					for(engine_fixture.instances.size() > total_count.value()) {
						engine_fixture.instances.erase(-1);
					}
					for(engine_fixture.instances.size() < total_count.value()) {
						engine_fixture.instances.push_back(
						[
							device_mac = "",
							device_ip = "",
							universe=0,
							start_channel=0,
							batch_count=1,
						]);
					}
					build_items();
				});

				build_items();

				this.active_fixture_settings = [
					btn=btn,
					cnt=cnt,
				];
			}
		});
	
		fixture_types[path] = [
			btn = btn,
			engine_fixture = engine_fixture,
		];
		
		global_fixture_menu.build_fixture_menu();
	}
	
	add_spatial_fixture(engine_fixture, index) {
		
		inst = engine_fixture.instances[index];
		
		row = index / fixture_area.content().width();
		column = math.mod(index, fixture_area.content().width());
		
		window = fixture_area.window(inst.name ?? "Device #"+index)
			.position(vec2f(column * 100,row * 100))
			.fixed_size(vec2f(100,100))
			.movable(true).resizable(true);
		
		if(inst.uv_pos ?? false) {
			area_size = fixture_area.content().size();

			size = vec2f(inst.uv_size.w, inst.uv_size.h) * area_size;

			pos = ((vec2f(inst.uv_pos.x, inst.uv_pos.y) + vec2f(1,1)) / 2.0) * area_size - size/2.0;
			
			window.position(pos).fixed_size(size);
		}
		
		adjust_item = [this, window, inst]() {	
			gs = 100;

			pos = window.position();
			pos.x = std.int(pos.x / gs);
			pos.y = std.int(pos.y / gs);
			window.position(pos * gs);
			
			size = window.size();
			size.x = math.max(1, std.int(size.x / gs));
			size.y = math.max(1, std.int(size.y / gs));
			window.size(size * gs);
			
			size = window.fixed_size();
			size.x = math.max(1, std.int(size.x / gs));
			size.y = math.max(1, std.int(size.y / gs));
			window.fixed_size(size * gs);
			
			pos = window.position();
			size = window.size();
			uv_pos = (pos + size/2.0) / fixture_area.content().size();
			uv_pos = uv_pos*2.0 - vec2f(1,1);
			uv_size = size / fixture_area.content().size();
			inst.uv_pos = [x=uv_pos.x, y=uv_pos.y];
			inst.uv_size = [w=uv_size.x, h=uv_size.y];
		};
		
		window.on_move_finished([adjust_item](p1,p2){
			adjust_item();
		});
		window.on_resize([adjust_item](p1,p2){
			adjust_item();
		});
		
		new_fixture = fixture_instance(window);
		spatial_fixtures.push_back(new_fixture);
	
		close_btn = window.button_panel().button("X").anchor_top(0).anchor_bottom(0).anchor_right(0).fixed_width(25);
		close_btn.on_click([this, new_fixture](){
			for(i = 0; i < this.spatial_fixtures.size(); i++) {
				if(this.spatial_fixtures[i] == new_fixture)
					this.spatial_fixtures.erase(i);
					break;
			}
			
			if(new_fixture)
				std.free(new_fixture);
		});
	
		window.button_panel().label(window.title()).anchor_top(0).anchor_bottom(0).anchor_left(0).anchor_right(25);
	
		adjust_item();
	}

}

class fixtures_menu {
	
	engine = None;

	managed fixture_controls = None;
	managed active_fixtures = [];

	__init__(_engine, parent) {
		engine = _engine;
		
		engine.fixture_menu = this;
		global_fixture_menu = this;
		
		open_arrangement = parent.button("Fixture Setup");
		
		open_arrangement.on_click([this,engine](){
			if(global_arranger)
				return;
			
			arranger_tab = engine.menu.generators_menu.add_tab("Fixture Setup").anchor_bottom(3);
			global_arranger = fixture_arranger(engine, arranger_tab);
			arranger_tab.on_destroy([global_arranger](){
				std.free(global_arranger);
			});
		});
		
		engine.load_hooks["fixture_menu"] = [this](states){					
			this.build_fixture_menu();
		};
		
		fixture_controls = parent.matrixnode("fixture_menu").layout(nanogui.layout_vertical());
		
	}
	
	build_fixture_menu() {
		
		for(i = 0; i < active_fixtures.size(); i++) {
			if(!engine.fixtures.has(active_fixtures.key(i)))
				std.free(active_fixtures[i].entry);
				active_fixtures.erase(i);
				i--;
		}
		
		for(i = 0; i < engine.fixtures.size(); i++) {
			
			entry = None;
			
			pure_name = fileio.pure_name(engine.fixtures.key(i));
			
			active_fix = None;
			
			instances = [];
			
			conf = fileio.read_json(engine.fixtures.key(i));
			
			if(active_fixtures.has(engine.fixtures.key(i)))
				active_fix = active_fixtures[engine.fixtures.key(i)];
				entry = active_fix.entry;
			else {
				entry = fixture_controls.collapsable(pure_name);
				entry.content().layout(nanogui.layout_vertical());
				active_fixtures[engine.fixtures.key(i)] = [entry=entry, instances=[], controls=[]];
				active_fix = active_fixtures[engine.fixtures.key(i)];
				
				control_dimmers = entry.collapsable("Dimmers").content().layout(nanogui.layout_vertical());
				control_flashers = entry.collapsable("Flashers").content().layout(nanogui.layout_vertical());
				
				//Flashers should have desired value and "Flash!" button which overrides the current input completely
				
				active_fix.dimmer_controls = [];
				active_fix.flasher_controls = [];

				for(k = 0; k < conf.channels.size(); k++) {
					chan = conf.channels[k];
					for(h = 0; h < chan.batch_count; h++) {
						ctrl_name = chan.name;
						if(h > 0)
							ctrl_name += " (" + (h+1) + ")";

						ctrl = control_dimmers.controlslider("DIM " + ctrl_name, "dim_" + chan.name + "_" + k);
						ctrl.value(1.0);
						active_fix.dimmer_controls.push_back(ctrl);
						splitter = control_flashers.widget().fixed_height(30).layout(nanogui.layout_horizontal());	
						
						ctrl = splitter.controlslider(ctrl_name, "flash_" + chan.name + "_" + k).fixed_height(30).anchor_right(100).anchor_left(0);;
						flash_btn = splitter.controlbutton("FLASH", "flashbtn_" + chan.name + "_" + k).anchor_right(0).fixed_width(100);
						active_fix.flasher_controls.push_back([btn=flash_btn,ctrl=ctrl,target_ctrls=[]]); 
						target_ctrls =  active_fix.flasher_controls[-1].target_ctrls;
						flash_btn.hold(true);
						flash_btn.callback([target_ctrls](v) {
							for(tt = 0; tt < target_ctrls.size(); tt++) {
								target_ctrls[tt].value(target_ctrls[tt].value()); //Value doesnt matter here as its overwritten in the ctrl's callback anyways when flash btn is active
							}
						});
						ctrl.callback([target_ctrls, flash_btn](v) {
							if(flash_btn.value()) {
								for(tt = 0; tt < target_ctrls.size(); tt++) {
									target_ctrls[tt].value(v);
								}
							}
						});
					}
				}
			}
			
			total_byte_count = 0;
			for(j = 0; j < conf.channels.size(); j++) {
				total_byte_count += conf.channels[j].byte_count;
			}
			
			for(j = 0; j < engine.fixtures[i].instances.size(); j++) {
				instances.push_back(engine.fixtures[i].instances[j]);
				if(engine.fixtures[i].instances[j].batch_count > 1) {
					for(k = 1; k < engine.fixtures[i].instances[j].batch_count; k++) {
						instances.push_back(engine.fixtures[i].instances[j].copy());
						instances[-1].batch_count=1;
						instances[-1].start_channel += total_byte_count * k;
						instances[-1].batch_index = k+1;
					}
				}
			}
			
			start_index = 0;
			if(active_fix.instances)
				for(instances.size() < active_fix.instances.size()) {
					std.free(active_fix.instances[-1]);
					active_fix.instances.erase(-1);
				}
				start_index = active_fix.instances.size();
			
			index_counter = start_index;
			
			//Potentially update changed names
			for(j = 0; j < start_index; j++) {
				
				inst = instances[j];
				inst_entry_name = instances[j].name ?? instances[j].name : pure_name;
				
				if(inst.batch_index ?? false)
					if(!instances[j].name)
						inst_entry_name += " #"+(index_counter);
					inst_entry_name += " ("+inst.batch_index+")";
				else
					if(!instances[j].name)
						inst_entry_name += " #"+(index_counter+1);
					index_counter++;
				active_fix.instances[j].title(inst_entry_name);
			}
			
			for(j = start_index; j < instances.size(); j++) {
				inst = instances[j];
				inst_entry_name = instances[j].name ?? instances[j].name : pure_name;
				
				if(inst.batch_index ?? false)
					if(!instances[j].name)
						inst_entry_name += " #"+(index_counter);
					inst_entry_name += " ("+inst.batch_index+")";
				else
					if(!instances[j].name)
						inst_entry_name += " #"+(index_counter+1);
					index_counter++;

				inst_entry = entry.collapsable(inst_entry_name);
				inst_content = inst_entry.content().layout(nanogui.layout_vertical());
				active_fix.instances.push_back(inst_entry);
				
				if(!active_fix.instances_controls)
					active_fix.instances_controls = [];
				active_fix.instances_controls.push_back([]);
				
				offset = 0;
				control_index = 0;
				
				for(k = 0; k < conf.channels.size(); k++) {
					chan = conf.channels[k];
					for(h = 0; h < chan.batch_count; h++) {
						ctrl_name = chan.name;
						if(h > 0)
							ctrl_name += " (" + (h+1) + ")";
						
						dimmer_ctrl = active_fix.dimmer_controls[control_index];
						flasher_ctrl = active_fix.flasher_controls[control_index];
						
						if(chan.type == "8-bit") {
							ctrl = inst_content.controlslider(ctrl_name, chan.name + "_" + k + "_" + j);						
							ctrl.callback([this, inst, offset, dimmer_ctrl, flasher_ctrl](v){
								if(!inst.device)
									if(inst.device_mac)
										inst.device = this.engine.net.find_artnet_device(inst.device_mac);
										if(inst.device)
											inst.device_ip = inst.device.ip();
									if(!inst.device)
										return;								
								//First scale based on dimmer here
								v = v * dimmer_ctrl.value();
								//Check if flasher is active and override value if so, ignoring dimmer...
								if(flasher_ctrl.btn.value())
									v = flasher_ctrl.ctrl.value();
								inst.device.set_artnet_channel(inst.universe, inst.start_channel+offset, v * 255.0);
							});
							
							active_fix.instances_controls[-1].push_back(ctrl);
							flasher_ctrl.target_ctrls.push_back(ctrl);
						}
						else if(chan.type == "16-bit") {
							ctrl = inst_content.controlslider(ctrl_name, chan.name + "_" + k + "_" + j);
							ctrl.callback([this, inst, offset, dimmer_ctrl, flasher_ctrl](v){
								if(!inst.device)
									if(inst.device_mac)
										inst.device = this.engine.net.find_artnet_device(inst.device_mac);
										if(inst.device)
											inst.device_ip = inst.device.ip();
									if(!inst.device)
										return;
								
								v = v * dimmer_ctrl.value();							
								if(flasher_ctrl.btn.value())
									v = flasher_ctrl.ctrl.value();
								value_16bit = v * 65535.0;
								current_coarse = std.int(value_16bit / 256.0);
								current_fine = std.int(math.mod(value_16bit,256.0));

								inst.device.set_artnet_channel(inst.universe, inst.start_channel+offset, current_coarse);
								inst.device.set_artnet_channel(inst.universe, inst.start_channel+offset+1, current_fine);
							});
							
							active_fix.instances_controls[-1].push_back(ctrl);
							flasher_ctrl.target_ctrls.push_back(ctrl);
						}
						else if(chan.type == "RGB") {
							ctrl_group = chan.name + "_" + k + "_" + j;
							
							rgb_vec = inst_content.controlvector(ctrl_name, ctrl_group);
							color_selector = rgb_vec.color_selector();
							
							r_comp = rgb_vec.controlslider("R", ctrl_group);
							g_comp = rgb_vec.controlslider("G", ctrl_group);
							b_comp = rgb_vec.controlslider("B", ctrl_group);
							
							active_fix.instances_controls[-1].push_back(r_comp);
							active_fix.instances_controls[-1].push_back(g_comp);
							active_fix.instances_controls[-1].push_back(b_comp);
							flasher_ctrl.target_ctrls.push_back(r_comp);
							flasher_ctrl.target_ctrls.push_back(g_comp);
							flasher_ctrl.target_ctrls.push_back(b_comp);
							
							color_selector.on_color_change([r_comp,g_comp,b_comp](col) {
								r_comp.value(col.x);
								g_comp.value(col.y);
								b_comp.value(col.z);
							});
							
							r_comp.callback([this, inst, offset, color_selector, dimmer_ctrl, flasher_ctrl](v){
								if(!inst.device)
									if(inst.device_mac)
										inst.device = this.engine.net.find_artnet_device(inst.device_mac);
										if(inst.device)
											inst.device_ip = inst.device.ip();
									if(!inst.device)
										return;	
								v = v * dimmer_ctrl.value();							
								if(flasher_ctrl.btn.value())
									v = flasher_ctrl.ctrl.value();	
								inst.device.set_artnet_channel(inst.universe, inst.start_channel+offset, v * 255.0);
							});
							g_comp.callback([this, inst, offset, color_selector, dimmer_ctrl, flasher_ctrl](v){
								if(!inst.device)
									if(inst.device_mac)
										inst.device = this.engine.net.find_artnet_device(inst.device_mac);
										if(inst.device)
											inst.device_ip = inst.device.ip();
									if(!inst.device)
										return;
								v = v * dimmer_ctrl.value();							
								if(flasher_ctrl.btn.value())
									v = flasher_ctrl.ctrl.value();	
								inst.device.set_artnet_channel(inst.universe, inst.start_channel+offset+1, v * 255.0);
							});
							b_comp.callback([this, inst, offset, color_selector, dimmer_ctrl, flasher_ctrl](v){
								if(!inst.device)
									if(inst.device_mac)
										inst.device = this.engine.net.find_artnet_device(inst.device_mac);
										if(inst.device)
											inst.device_ip = inst.device.ip();
									if(!inst.device)
										return;	
								v = v * dimmer_ctrl.value();							
								if(flasher_ctrl.btn.value())
									v = flasher_ctrl.ctrl.value();	
								inst.device.set_artnet_channel(inst.universe, inst.start_channel+offset+2, v * 255.0);
							});
						}						
						else if(chan.type == "RGBW") {
							ctrl_group = chan.name + "_" + k + "_" + j;
							
							rgb_vec = inst_content.controlvector(ctrl_name, ctrl_group);
							color_selector = rgb_vec.color_selector();
							
							r_comp = rgb_vec.controlslider("R", ctrl_group);
							g_comp = rgb_vec.controlslider("G", ctrl_group);
							b_comp = rgb_vec.controlslider("B", ctrl_group);
							w_comp = rgb_vec.controlslider("W", ctrl_group);
							
							active_fix.instances_controls[-1].push_back(r_comp);
							active_fix.instances_controls[-1].push_back(g_comp);
							active_fix.instances_controls[-1].push_back(b_comp);
							active_fix.instances_controls[-1].push_back(w_comp);
							flasher_ctrl.target_ctrls.push_back(r_comp);
							flasher_ctrl.target_ctrls.push_back(g_comp);
							flasher_ctrl.target_ctrls.push_back(b_comp);
							flasher_ctrl.target_ctrls.push_back(w_comp);
							
							color_selector.on_color_change([r_comp,g_comp,b_comp,w_comp](col) {
								w = math.min(col.x, math.min(col.y, col.z));
								
								r_comp.value(col.x - w);
								g_comp.value(col.y - w);
								b_comp.value(col.z - w);
								w_comp.value(w);
							});
							
							w_comp.callback([this, inst, offset, color_selector, dimmer_ctrl, flasher_ctrl](v){
								if(!inst.device)
									if(inst.device_mac)
										inst.device = this.engine.net.find_artnet_device(inst.device_mac);
										if(inst.device)
											inst.device_ip = inst.device.ip();
									if(!inst.device)
										return;	
								v = v * dimmer_ctrl.value();							
								if(flasher_ctrl.btn.value())
									v = flasher_ctrl.ctrl.value();		
								inst.device.set_artnet_channel(inst.universe, inst.start_channel+offset+3, v * 255.0);
							});			

							update_rgbw = [this, inst, offset, r_comp, g_comp, b_comp, w_comp, dimmer_ctrl, flasher_ctrl](v) {
								r = r_comp.value();
								g = g_comp.value();
								b = b_comp.value();

								w = math.min(r, g, b);
								
								w_comp.value(w);

								if(!inst.device)
									if(inst.device_mac)
										inst.device = this.engine.net.find_artnet_device(inst.device_mac);
										if(inst.device)
											inst.device_ip = inst.device.ip();

								if(!inst.device)
									return;
								
								r = (r - w) * dimmer_ctrl.value();
								g = (g - w) * dimmer_ctrl.value();
								b = (b - w) * dimmer_ctrl.value();
						
								if(flasher_ctrl.btn.value())
									r = 0;
									g = 0;
									b = 0;
	
								inst.device.set_artnet_channel(
									inst.universe,
									inst.start_channel + offset,
									r * 255.0
								);

								inst.device.set_artnet_channel(
									inst.universe,
									inst.start_channel + offset + 1,
									g * 255.0
								);

								inst.device.set_artnet_channel(
									inst.universe,
									inst.start_channel + offset + 2,
									b * 255.0
								);
							};

							r_comp.callback(update_rgbw);

							g_comp.callback(update_rgbw);

							b_comp.callback(update_rgbw);
						}
						else
							std.error("Unrecognized fixture channel type: ", chan.type);
						
						control_index++;
						offset += chan.byte_count;
					}
				}
			}
		}
	}
}