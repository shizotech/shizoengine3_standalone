//Issue #273: the clock of a Loop. A loop is a timeline of its own with a fixed length in beats that wraps. It runs
//along the main timeline: it moves while the main timeline plays (its BPM, its Play) and stands still while it stops,
//but it has a phase of its own that can be started, stopped, reset, doubled and halved.
//turns counts the turns since the last reset (2.25 = two turns and a quarter). It is the time source a synced control
//follows (nanogui.sync_source): SYNC / PINGPONG use its fraction, TRIGGER / LOOP the turns that passed, so one turn of
//the loop is what one beat of the main timeline is to them. No UI here (loops.shio), so it can be tested on its own.
//A loop is also a timeline with clips (#680): its cursor is position(), from offset over length beats, again and again.
//Chase (#680 step 4): while it runs, its place in the turn is the place of the main timeline (main_pos * rate / length
//turns) instead of counting on by itself: when the main timeline chases a timecode or a MIDI clock, a locate of the
//master moves the loop too, and the loop is where it would be had it run from beat 0.

LOOP_RATE_MIN = 0.0625; //1/16
LOOP_RATE_MAX = 16.0;

class loop_clock
{
	guid = "";
	name = "Loop";
	length = 4.0;     //beats per turn
	offset = 0.0;     //the beat of its timeline the turn starts at (the loop range in its ruler, #680)
	rate = 1.0;       //x2 / /2: turns this much faster or slower
	running = false;
	chase = false;    //its turn follows the place of the main timeline (#680 step 4)
	turns = 0.0;      //turns since the last reset

	//delta_beats: how far the main timeline moved in this frame (0 while it stops); main_pos: where it is now
	advance(delta_beats, main_pos = None) {
		if(!running || length <= 0)
			return;
		if(chase && !std.is_none(main_pos)) {
			turns = main_pos * rate / length;
			return;
		}
		turns += delta_beats * rate / length;
	}

	//Where the loop is in its turn, 0..1
	phase() {
		return turns - math.floor(turns);
	}

	//The beat inside the turn, 0..length
	beat() {
		return phase() * length;
	}

	//The cursor of its timeline (#680): offset .. offset + length
	position() {
		return offset + phase() * length;
	}

	//Runs on from where the main timeline is: a loop of 4 beats started on beat 6 is half way through its turn, so
	//loops started at different times still meet on the bars. The turns that passed stay (TRIGGER / LOOP count on)
	start(main_pos) {
		if(running)
			return;
		running = true;
		if(length <= 0)
			return;
		aligned = math.fract(main_pos * rate / length);
		whole = math.floor(turns);
		turns = whole + aligned < turns ? whole + 1 + aligned : whole + aligned;
	}

	stop() {
		running = false;
	}

	//Phase back to 0, now: the next turn starts at this moment of the main timeline
	reset() {
		turns = 0.0;
	}

	double() {
		rate = math.min(rate * 2.0, LOOP_RATE_MAX);
	}

	half() {
		rate = math.max(rate / 2.0, LOOP_RATE_MIN);
	}

	set_length(beats) {
		length = math.max(beats, 0.25);
	}

	save() {
		return [guid = guid, name = name, length = length, offset = offset, rate = rate, running = running ? 1 : 0, chase = chase ? 1 : 0, turns = turns];
	}

	load(d) {
		guid = d.guid ?? guid;
		name = d.name ?? name;
		length = d.length ?? length;
		offset = d.has("offset") ? d.offset : 0.0;
		rate = d.rate ?? rate;
		running = d.running ? true : false;
		chase = d.has("chase") && d.chase ? true : false;
		turns = d.turns ?? 0.0;
	}
}
