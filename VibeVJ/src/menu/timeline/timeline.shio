
using eigen;

#include "engine/generators/generatorview"

class timeline
{
	managed window = None;
	managed cursor_pos = None;
	managed play_btn = None;
	managed stop_btn = None;
	managed bpm_ctrl = None;
	managed snap_btn = None;
	managed show_btn = None;
	managed cable_btn = None;
	managed collapse_btn = None;
	managed menu = None;
	managed screen = None;
	managed timeline_generators = None;
	
	nudge_factor = 1.0;
	tap_times = []; //std.millis() of the recent taps on Tap
	show_press = 0; //std.millis() of the press on the show mode button
	expanded_top = 0.0; //top edge of the timeline before the last collapse, 0 = never collapsed

	// Persistent state — keep these between calls
	phase_integral = 0.0;
	smoothed_pd    = 0.0;
	last_nudge     = 1.0;
	last_phase     = 0.0;

	// nudge_bar(): whole beats the timeline is off, and for how many calls in a row
	bar_offset_last  = 0;
	bar_offset_count = 0;
	
	__init__(engine, main_menu) {

		engine.timeline = this;
		menu = main_menu;
		screen = engine.screen;

		engine_global = std.global("timeline");
		engine_global.set(this);

		window = engine.screen.window(" ");
		window.anchor_bottom(0)
			.anchor_left(main_menu.asset_menu.window.fixed_width())
			.anchor_right(0)
			.position(vec2f(0,engine.screen.height() - 35))
			.fixed_height(35)
			.movable_y(true)
			.clamp_move(false);
		
		window.on_layout([this, engine, main_menu](){			
			pos = this.window.position();
			generators_window = main_menu.generators_menu.window;
			
			if(pos.y < 120)
				pos.y = 120;
				this.window.y(pos.y);
			
			if(pos.y < generators_window.y() + generators_window.height())
				generators_window.fixed_height(pos.y);
				generators_window.refresh_layout();
				
			this.window.fixed_height(engine.screen.height() - pos.y);
		});
		
		window.on_move([this](pos, old_pos) {
			this.place(pos.y);
		});
		
		timeline_node = window.matrixnode("timeline").anchor(0);
		
		timeline_widget = timeline_node.timeline("Timeline").anchor(0);
		
		button_panel = window.button_panel().matrixnode("timeline_header").anchor(0).layout(nanogui.layout_horizontal());
		
		//The four view tools (sidebar, collapse, cable view, show mode) sit 4 px apart (a zero-width gap adds one more
		//layout spacing of 2 px); the rest of the bar keeps 2 px, so narrow screens lose nothing more
		view_gap = [button_panel]() {
			button_panel.widget().fixed_width(0);
		};
		sidebar_btn = button_panel.button("").icon(nanogui.icon("bars")).tooltip("Show / hide the sidebar");
		sidebar_btn.on_click([main_menu](){
			main_menu.toggle_sidebar();
		});
		
		view_gap();
		collapse_btn = button_panel.button("").icon(nanogui.icon("chevron_up")).tooltip("Open or collapse the timeline");
		collapse_btn.on_click([this](){
			this.toggle_collapse();
		});

		view_gap();
		//Cable view, the same switch as Project > Settings > Cable view (saved with the project): every link on screen as a
		//cable. Next to the lock, as the opposite mode: wiring vs. performing. Locked while in show mode, which has no cables.
		//Local cable views (the link icon in a generator header, Always draw links): a small accent bubble on the top
		//right corner counts them. Hovering the button for a moment while there are any splits it: the broken link slides
		//in on its right half and ends them all. The button keeps its width; the global cable view stays as it is
		show_links = main_menu.asset_menu.show_links;
		cable_btn = button_panel.pushbutton("").icon(nanogui.icon("link")).fixed_width(44).tooltip("Cable view: show every link");
		cable_btn.pushed(show_links.value() != 0);
		cable_btn.on_change([show_links](pushed){
			show_links.value(pushed ? 1 : 0);
		});
		main_menu.asset_menu.on_cable_view = [this](v){
			this.cable_btn.pushed(v != 0);
		};
		cable_btn.split_icon(nanogui.icon("unlink")).split_enabled(false).on_split_click([](){
			nanogui.always_draw_links_off();
		});
		//Kept current every frame: generators switch their link icon, get closed or loaded at any time
		//The bubble only while the global cable view is off: with it on every cable shows anyway
		cable_btn.on_draw([cable_btn](){
			n = nanogui.show_mode() ? 0 : std.int(nanogui.local_cable_views());
			count = n > 0 ? std.string(n) : "";
			badge = cable_btn.pushed() ? "" : count;
			if(cable_btn.badge() != badge)
				cable_btn.badge(badge);
			tip = "End all local cable views (" + count + ")";
			if(cable_btn.split_tooltip() == tip)
				return;
			cable_btn.split_enabled(n > 0);
			cable_btn.split_tooltip(tip);
		});
		
		view_gap();
		//Show mode (#285): a click locks notches and editing for performing; leaving needs a hold, so a stray touch
		//during the show does not unlock it. It sits at the start of the bar: the bar does not wrap, and on narrow
		//screens (1280 px, or 1920 px at 150 % scaling) everything after the view switch is cut off.
		//A toggle button so it is green ("on", like Play) while the show runs, which marks show mode; its own handler
		//below decides when it toggles, the button's default click never runs
		show_btn = button_panel.pushbutton("").icon(nanogui.icon("unlock")).fixed_width(44).tooltip("Show mode: lock notches and editing");
		show_btn.on_mouse_button([this](pos, btn, down, mods) {
			if(btn != 0)
				return true;
			if(down) {
				this.show_press = std.millis();
				return true;
			}
			if(!nanogui.show_mode())
				this.set_show_mode(true);
			else if(std.millis() - this.show_press >= 400)
				this.set_show_mode(false);
			return true;
		});

		//A hairline between the view tools (sidebar, collapse, cable view, show mode) and the transport
		transport_gap = button_panel.widget().fixed_width(13);
		transport_gap.widget_solid().anchor_left(6).fixed_width(1).anchor_top(2).anchor_bottom(2).background_color(vec4f(1.0, 1.0, 1.0, 0.12));
		
		//IDs stay in capitals (MIDI mappings, links, projects), the captions are plain words
		play_btn = button_panel.controlbutton("PLAY").caption("Play").push(true).fixed_width(44);
		stop_btn = button_panel.controlbutton("STOP").caption("Stop").fixed_width(44);
		follow_btn = button_panel.controlbutton("FOLLOW").caption("Follow").push(true).fixed_width(44);
		//Transport as icons with tooltips (Shizo UI); Play and Follow are green while on
		play_btn.get_button().caption("").icon(nanogui.icon("play")).tooltip("Play");
		stop_btn.get_button().caption("").icon(nanogui.icon("stop")).tooltip("Stop and go back to the start");
		follow_btn.get_button().caption("").icon(nanogui.icon("crosshairs")).tooltip("Follow the playhead");
		bpm_ctrl = button_panel.controlfloat("BPM").readout(true).fixed_width(125).value(150);
		
		//Tap tempo: the average of the taps, a pause of two seconds starts over
		tap_btn = button_panel.button("Tap").fixed_width(44).tooltip("Tap the tempo");
		tap_btn.on_click([this](){
			now = std.millis();
			n = this.tap_times.size();
			if(n > 0 && now - this.tap_times[n - 1] > 2000)
				this.tap_times = [];
			this.tap_times.push_back(now);
			n = this.tap_times.size();
			if(n < 2)
				return;
			first = n > 8 ? n - 8 : 0;
			span = this.tap_times[n - 1] - this.tap_times[first];
			if(span > 0)
				this.bpm_ctrl.value(60000.0 * (n - 1 - first) / span);
		});
		
		//Start at 0, so an unset value never shows as 1.18e-38
		beat_ctrl = button_panel.controlfloat("BEAT").caption("Beat").readout(true).decimals(2).fixed_width(125).value(0);
		//Shown as bar.beat.tick (4 beats per bar); the value stays the position in beats, editing takes beats
		pos_ctrl = button_panel.controlfloat("POSITION").caption("Bar").bars(4).readout(true).fixed_width(200).value(0);
		cursor_pos = pos_ctrl;
		
		stop_btn.callback([play_btn, pos_ctrl](v){
			if(!v)
				return;
			play_btn.value(0);
			pos_ctrl.value(0);
		});
		
		pos_ctrl.callback([timeline_widget, beat_ctrl](v) {
			beat_ctrl.value(math.fract(v));
			timeline_widget.cursor(v);
		});
		
		timeline_widget.scrub_callback([pos_ctrl](pos) {
			pos_ctrl.value(pos);
		});
		
		
		timeline_generators = generatorview(timeline_node);
		timeline_generators.area.visible(false);
		timeline_generators.grid_size = 32.0;
		
		//Compared as an index (0 timeline, else the generator view)
		select_mode = button_panel.controlcombo("view_mode_switch").caption("View").items(["Timeline", "Loops", "Patch"]).segmented(true, false).fixed_width(230);
		select_mode.callback([timeline_widget, timeline_generators](v) {
			timeline_widget.visible(v == 0);
			timeline_generators.area.visible(v != 0);
		});
		
		snap_btn = button_panel.controlbutton("SNAP WINDOWS").caption("Snap windows").push(1).value(1);
		snap_btn.get_button().tooltip("The view area above follows the timeline when you move or collapse it");

		engine.save_hooks["timeline_generators"] = [timeline_generators](){		
			return timeline_generators.save_state();
		};
		
		engine.load_hooks["timeline_generators"] = [timeline_generators](states){					
			return timeline_generators.load_state(states);
		};
	}


	//Puts the top edge of the timeline at y, clamped so 120 px of views stay above and the bar stays visible.
	//The views follow when they are snapped or would overlap the timeline. Returns the clamped y.
	place(y) {
		h = screen.height();
		y = math.clamp(y, 120.0, h - 35.0);
		window.y(y);
		window.fixed_height(h - y);
		window.refresh_layout();
		
		views = menu.generators_menu.window;
		if(snap_btn.value() || y < views.y() + views.height()) {
			views.fixed_height(y - views.y());
			views.refresh_layout();
		}
		
		collapse_btn.icon(nanogui.icon(y >= h - 35.0 ? "chevron_up" : "chevron_down"));
		return y;
	}
	
	collapsed() {
		return window.y() >= screen.height() - 35.0;
	}
	
	//The chevron: collapse to the bar, a second click opens the timeline again at its last height
	toggle_collapse() {
		h = screen.height();
		if(!collapsed()) {
			expanded_top = window.y();
			place(h);
			return;
		}
		place(expanded_top > 0.0 ? expanded_top : h * 0.6);
	}

	set_bpm(bpm) {
		bpm_ctrl.value(bpm);
	}
	
	set_show_mode(enabled) {
		nanogui.show_mode(enabled);
		show_btn.icon(nanogui.icon(enabled ? "lock" : "unlock"));
		show_btn.pushed(enabled);
		show_btn.tooltip(enabled ? "Hold to leave show mode" : "Show mode: lock notches and editing");
		cable_btn.enabled(!enabled);
		cable_btn.tooltip(enabled ? "Cable view: not in show mode" : "Cable view: show every link");
	}

	phase_distance(desired, actual)
	{
		d = desired - actual;
		d -= math.floor(d + 0.5);
		return d;
	}

	nudge_position(phase)
	{
		real_frac = math.fract(phase);
		cur_frac  = math.fract(cursor_pos.value());

		// 1. Continuous phase distance (not just on wrap)
		pd = phase_distance(real_frac, cur_frac);

		// 2. Hysteresis: prevent 180° flips from noise when near ambiguity
		//    If we were locked (small error) and suddenly jump near ±0.5,
		//    clamp toward the previous direction instead of flipping.
		if (math.abs(pd) > 0.45 && math.abs(smoothed_pd) < 0.25)
		{
			pd = math.sign(smoothed_pd) * 0.45;
		}

		// 3. Smooth the error (low-pass). This also filters out single-frame
		//    ambiguity flips that slip past the hysteresis.
		smoothed_pd = math.lerp(smoothed_pd, pd, 0.25);

		// 4. Integral term: learns the permanent BPM offset.
		//    This is what eliminates steady-state error without snapping.
		//    Only integrate when we have reasonable confidence (error < 0.3).
		if (math.abs(smoothed_pd) < 0.3)
		{
			phase_integral += smoothed_pd * 0.003;
		}
		// Clamp so a transient doesn't wind us up forever
		phase_integral = math.clamp(phase_integral, -0.08, 0.08);

		// 5. Proportional term: pulls phase into alignment.
		//    Use a gentler curve than pow(4) — pow(1.5) or even linear
		//    gives much faster convergence while still being soft.
		p_term = math.sign(smoothed_pd) * math.pow(math.abs(smoothed_pd), 1.5) * 0.25;

		// 6. Combine: 1.0 = nominal speed
		nudge = 1.0 + phase_integral + p_term;

		// 7. Rate-limit the nudge itself so the cursor never jerks
		nudge = math.lerp(last_nudge, nudge, 0.35);
		last_nudge = nudge;

		last_phase = phase;
		nudge_factor = nudge;
	}

	// Tighter phase lock for precise clocks (CDJs over Pro DJ Link): tempo and beat times are exact,
	// so there is no noise to filter and no permanent offset to learn. Proportional only,
	// time constant about 60 / (2 * bpm) seconds, speed change limited to +-20 %.
	lock_position(phase)
	{
		pd = phase_distance(math.fract(phase), math.fract(cursor_pos.value()));
		nudge_factor = 1.0 + math.clamp(pd * 2.0, -0.2, 0.2);
		last_phase = phase;
	}

	// Lock the timeline to the bar of an external clock (e.g. the CDJ tempo master), so a
	// position of 0, 4, 8 ... is the downbeat. bar_phase: 0..1 over one bar.
	// precise = true uses lock_position() instead of the smoothed nudge_position().
	// The beat phase is pulled in smoothly by nudge_position(). Whole beats that are off cannot be
	// nudged, so once the same offset was seen for a few calls the cursor jumps by those beats
	// (the beat phase stays continuous, only bar-synced things jump once).
	nudge_bar(bar_phase, beats_per_bar = 4, precise = false)
	{
		desired = bar_phase * beats_per_bar;
		cur = cursor_pos.value();
		actual = cur - math.floor(cur / beats_per_bar) * beats_per_bar;

		// Offset in beats, wrapped to [-beats_per_bar/2, beats_per_bar/2)
		d = desired - actual;
		d -= math.floor(d / beats_per_bar + 0.5) * beats_per_bar;
		k = math.round(d);

		// Only trust whole-beat offsets while the beat phase itself is close (no flip at the
		// beat boundary) and the offset stays the same for a few frames.
		if (k != 0 && math.abs(d - k) < 0.25)
		{
			if (k == bar_offset_last)
				bar_offset_count++;
			else
			{
				bar_offset_last = k;
				bar_offset_count = 1;
			}

			if (bar_offset_count >= 3)
			{
				cursor_pos.value(cur + k);
				bar_offset_last = 0;
				bar_offset_count = 0;
			}
		}
		else
		{
			bar_offset_last = 0;
			bar_offset_count = 0;
		}

		if (precise)
			lock_position(desired);
		else
			nudge_position(desired);
	}
}