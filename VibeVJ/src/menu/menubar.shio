
//The menu bar of macOS (nanogui.menu_bar). Elsewhere there is none, and nothing here runs.
//An item with a shortcut and no action sends that key to the program, as pressing it would: the shortcut does what it does
//everywhere else (Cmd is Ctrl for the program), so a menu item and its key can never do different things.
//An item with an action runs that action here (things that have no key, or whose key would get in the way of typing).
//(The field is "shortcut": "key" is not kept in an object written in a script)

class menu_bar
{
	engine = None;
	main_menu = None;

	__init__(engine, main_menu) {
		this.engine = engine;
		this.main_menu = main_menu;

		menus = [
			[app = true, items = [
				[title = "About VibeVJ", action = "about"],
				"-",
				[title = "Settings…", shortcut = "cmd+,", action = "settings"]
			]],
			[title = "File", items = [
				[title = "New Project", shortcut = "cmd+n", action = "new"],
				[title = "Open Project…", shortcut = "cmd+o", action = "open"],
				"-",
				[title = "Save", shortcut = "cmd+s"],
				[title = "Save As…", shortcut = "cmd+shift+s"],
				"-",
				[title = "Command Palette…", shortcut = "cmd+k"]
			]],
			[title = "Edit", items = [
				[title = "Undo", shortcut = "cmd+z"],
				[title = "Redo", shortcut = "cmd+shift+z"],
				"-",
				[title = "Cut", shortcut = "cmd+x"],
				[title = "Copy", shortcut = "cmd+c"],
				[title = "Paste", shortcut = "cmd+v"],
				[title = "Select All", shortcut = "cmd+a"]
			]],
			[title = "View", items = [
				[title = "Show / Hide Sidebar", action = "sidebar"],
				"-",
				[title = "Split Area Right", shortcut = "cmd+e"],
				[title = "Split Area Down", shortcut = "cmd+shift+e"],
				[title = "Duplicate Area", shortcut = "cmd+d"],
				[title = "Maximize Area", shortcut = "cmd+return"],
				[title = "Close Area", shortcut = "cmd+w"],
				"-",
				[title = "Next View Tab", shortcut = "ctrl+tab"],
				[title = "Previous View Tab", shortcut = "ctrl+shift+tab"],
				"-",
				[title = "Zoom to Fit", shortcut = "cmd+0"],
				[title = "Actual Size", shortcut = "cmd+1"],
				"-",
				[title = "Performance Overlay", shortcut = "cmd+shift+p"],
				[title = "Cable View", action = "cables"]
			]],
			[title = "Show", items = [
				[title = "Play / Pause", action = "play"],
				[title = "Stop", action = "stop"],
				[title = "Tap Tempo", action = "tap"],
				"-",
				[title = "Blackout", shortcut = "cmd+b"],
				[title = "Show Mode", action = "show_mode"]
			]],
			[title = "Window", role = "window", items = [
				[title = "Minimize", role = "minimize"],
				[title = "Zoom", role = "zoom"],
				[title = "Enter Full Screen", role = "fullscreen"],
				"-",
				[title = "Log", action = "log"],
				"-",
				[title = "Bring All to Front", role = "front"]
			]],
			[title = "Help", role = "help", items = [
				[title = "VibeVJ Help", shortcut = "cmd+?", action = "help"],
				[title = "Getting Started", action = "help:Getting-Started"],
				[title = "Keyboard Shortcuts", action = "help:Shortcuts-and-Tips"],
				[title = "Troubleshooting", action = "help:Troubleshooting"]
			]]
		];

		nanogui.menu_bar("VibeVJ", menus, [this](action){
			this.run(action);
		});
	}

	run(action) {
		e = engine;
		mm = main_menu;
		actions = mm.asset_menu.project_actions;
		try {
			if(action == "about")
				mm.help.open("README");
			else if(action == "settings")
				mm.asset_menu.settings.show();
			else if(action == "new")
				actions.new();
			else if(action == "open")
				actions.load();
			else if(action == "sidebar")
				mm.generators_menu.show_sidebar(mm, !mm.sidebar_visible);
			else if(action == "cables") {
				btn = mm.asset_menu.show_links;
				btn.value(btn.value() ? 0 : 1);
			}
			else if(action == "play")
				e.timeline.toggle_play();
			else if(action == "stop")
				e.timeline.stop();
			else if(action == "tap")
				e.timeline.tap();
			else if(action == "show_mode")
				e.timeline.set_show_mode(!nanogui.show_mode());
			else if(action == "log")
				mm.log.open();
			else if(action == "help")
				mm.help.open("");
			else if(action.starts("help:"))
				mm.help.open(action.substr(5));
		}
		catch(err) {
			std.warn("Menu " + action + ": " + err);
		}
	}
}
