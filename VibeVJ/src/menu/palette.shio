using eigen;

//The command palette (#535): Ctrl+K opens one search field over what VibeVJ can do. Type a few letters, the list shows
//what matches, Enter runs the first one (Up / Down choose another, Esc closes):
//- Actions: Save, Blackout, Play, Split right, Settings, ... with their key on the right
//- Assets: generators, shaders, views, pictures, videos, presets: added to the area under the mouse, like a drop
//- Projects and templates: open one
//- Wiki pages: the Help window opens there
//The keys of the list are taken in generators.shio (palette_key), before the search field gets them.

PALETTE_WIDTH = 640;
PALETTE_ROWS = 10;
PALETTE_ROW_HEIGHT = 30;
PALETTE_INPUT_HEIGHT = 36;
PALETTE_TOP = 110;
PALETTE_PAD = 20;            //the window around its content
PALETTE_COLOR_SURFACE = vec4f(0.118, 0.118, 0.129, 0.98);
PALETTE_COLOR_SELECTED = vec4f(0.200, 0.180, 0.300, 1.0);
PALETTE_COLOR_TEXT_2 = vec4f(0.608, 0.608, 0.627, 1.0);
PALETTE_ASSET_DIRS = [asset = 1, glsl = 1];
PALETTE_ASSET_FILES = [png = 1, jpg = 1, jpeg = 1, mp4 = 1, mov = 1, m4v = 1, mkv = 1, webm = 1, avi = 1, preset = 1];

class command_palette
{
	managed window = None;
	managed input = None;
	managed list = None;
	engine = None;
	main_menu = None;
	items = [];      //[title=, hint=, kind=, words=, run=]
	results = [];    //the items that show
	rows = [];
	selected = 0;

	__init__(engine, main_menu) {
		this.engine = engine;
		this.main_menu = main_menu;
		engine.env.palette = this;

		window = engine.screen.window("");
		window.header_enabled(false).movable(false).resizable(false).overlay(true).visible(false)
			.fixed_size(vec2f(PALETTE_WIDTH, PALETTE_INPUT_HEIGHT + 16));
		input = window.textbox("").placeholder("Search actions, assets, projects and the wiki")
			.anchor_left(8).anchor_right(8).anchor_top(8).fixed_height(PALETTE_INPUT_HEIGHT)
			.tooltip("Ctrl+K: what VibeVJ can do. Enter runs the first, Up / Down choose, Esc closes.\n[[wiki:Shortcuts-and-Tips#the-command-palette]]");
		input.on_edit([this](v){
			this.filter(v);
		});
		list = window.widget().anchor_left(8).anchor_right(8).anchor_top(PALETTE_INPUT_HEIGHT + 12).fixed_height(0);
	}

	visible() {
		return window.visible() ? true : false;
	}

	toggle() {
		if(visible())
			close();
		else
			open();
	}

	open() {
		collect();
		input.value("");
		filter("");
		scr = engine.screen;
		x = std.int((scr.width() - PALETTE_WIDTH) / 2);
		window.position(vec2f(x > 0 ? x : 0, PALETTE_TOP));
		window.visible(true);
		window.focus(true);
		input.focus(true);
	}

	close() {
		window.visible(false);
	}

	//Up, Down, Enter, Esc while the palette is open (generators.shio). true: the key was used
	key(key, mods) {
		if(key == 256) { //Esc
			close();
			return true;
		}
		if(key == 264 || key == 265) { //Down, Up
			move(key == 264 ? 1 : -1);
			return true;
		}
		if(key == 257 || key == 335) { //Enter
			run(selected);
			return true;
		}
		return false;
	}

	move(step) {
		if(results.size() == 0)
			return;
		selected = (selected + step + results.size()) % results.size();
		show_rows();
	}

	run(index) {
		if(index < 0 || index >= results.size())
			return;
		item = results[index];
		close();
		try {
			item.run();
		}
		catch(e) {
			std.warn("Command palette: " + item.title + ": " + e);
		}
	}

	// What can be found

	add(title, hint, kind, run) {
		hint = nanogui.key_text(hint); //"⌘S" on a Mac
		items.push_back([title = title, hint = hint, kind = kind, words = (title + " " + hint + " " + kind).lowercase(), run = run]);
	}

	collect() {
		items = [];
		add_actions();
		add_projects();
		add_assets();
		add_wiki();
	}

	add_actions() {
		e = engine;
		mm = main_menu;
		gm = mm.generators_menu;
		actions = mm.asset_menu.project_actions;
		add("Save", "Ctrl+S", "action", [e](){ e.env.project_save(); });
		add("Save as…", "Ctrl+Shift+S", "action", [e](){ e.env.project_save_as(); });
		add("New project", "Projects", "action", [actions](){ actions.new(); });
		add("Open project…", "Projects", "action", [actions](){ actions.load(); });
		add("Blackout on / off", "Ctrl+B", "action", [e](){ e.blackout.toggle(); });
		add("Play / pause", "Space", "action", [e](){ e.timeline.toggle_play(); });
		add("Stop", "Shift+Space", "action", [e](){ e.timeline.stop(); });
		add("Tap tempo", "T", "action", [e](){ e.timeline.tap(); });
		add("Show mode on / off", "Timeline", "action", [e](){ e.timeline.set_show_mode(!nanogui.show_mode()); });
		add("Cable view on / off", "Timeline", "action", [mm](){
			btn = mm.asset_menu.show_links;
			btn.value(btn.value() ? 0 : 1);
		});
		add("Sidebar show / hide", "Top bar", "action", [mm, gm](){ gm.show_sidebar(mm, !mm.sidebar_visible); });
		add("Full screen", "F11", "action", [e](){
			if(e.screen.fill_monitor_available())
				e.screen.fill_monitor(!e.screen.fill_monitor());
		});
		add("Settings", "Top bar", "action", [mm](){ mm.asset_menu.settings.show(); });
		add("Help (the wiki)", "F1", "action", [mm](){ mm.help.open(""); });
		add("Log: errors and warnings", "Top bar", "action", [mm](){ mm.log.open(); });
		add("Performance overlay", "Ctrl+Shift+P", "action", [mm](){ mm.perf.toggle(); });
		add("Exit", "Projects", "action", [actions](){ actions.exit(); });
		//The layout: not in show mode, like their keys
		if(!nanogui.show_mode()) {
			add("Undo", "Ctrl+Z", "action", [gm](){ gm.undo_history.undo(); });
			add("Redo", "Ctrl+Y", "action", [gm](){ gm.undo_history.redo(); });
			add("Split right", "Ctrl+E", "action", [gm](){ a = gm.find_active_area(true); if(a) a.split_empty("right"); });
			add("Split down", "Ctrl+Shift+E", "action", [gm](){ a = gm.find_active_area(true); if(a) a.split_empty("bottom"); });
			add("Duplicate area", "Ctrl+D", "action", [gm](){ a = gm.find_active_area(true); if(a) a.duplicate(); });
			add("Maximize area", "Ctrl+Space", "action", [gm](){ a = gm.find_active_area(true); if(a) a.toggle_maximize(); });
		}
	}

	add_projects() {
		eng = engine;
		try {
			names = fileio.dirs("projects", false);
			for(name : names) {
				n = name;
				add(n, "Open project", "project", [eng, n](){ eng.env.load_project(n); });
			}
			if(fileio.is_directory("templates")) {
				names = fileio.dirs("templates", false);
				for(name : names) {
					n = name;
					add(n, "New project from template", "template", [eng, n](){ eng.env.load_template(n); });
				}
			}
		}
		catch(err) {}
	}

	//Generators (.asset), shaders (.glsl), pictures, videos and presets below assets/: into the area under the mouse
	add_assets() {
		if(nanogui.show_mode())
			return; //dropping assets is locked in show mode
		gm = main_menu.generators_menu;
		try {
			for(dir : fileio.dirs("assets", true)) {
				ext = fileio.file_ext(dir).lowercase();
				if(PALETTE_ASSET_DIRS.has(ext))
					add_asset(gm, dir);
			}
			for(file : fileio.files("assets", true)) {
				f = std.string(file).replace("\\", "/");
				ext = fileio.file_ext(f).lowercase();
				if(PALETTE_ASSET_FILES.has(ext) && !f.contains(".asset/") && !f.contains(".glsl/"))
					add_asset(gm, f);
			}
		}
		catch(e) {}
	}

	add_asset(gm, rel) {
		rel = std.string(rel).replace("\\", "/");
		path = "assets/" + rel;
		folder = fileio.file_dir(rel);
		add(fileio.file_name(rel), "Add · " + folder, "asset", [gm, path](){
			area = gm.find_active_area(true);
			if(!area)
				return;
			area.step("Add view", [area, path](){
				area.drop_path(path, "center");
			});
		});
	}

	add_wiki() {
		mm = main_menu;
		try {
			for(file : fileio.files("wiki", false)) {
				if(fileio.file_ext(file).lowercase() != "md")
					continue;
				page = fileio.pure_name(file);
				if(page == "README")
					continue;
				p = page;
				add(page.replace("-", " "), "Wiki", "wiki", [mm, p](){ mm.help.open(p); });
			}
		}
		catch(e) {}
	}

	// The list

	//All words of the query in the item. Those whose title starts with the query first, then those whose title has
	//it, then the rest; each group in the order of collect() (actions, projects, assets, wiki)
	filter(query) {
		q = std.string(query).lowercase().trim();
		words = q == "" ? [] : q.split(" ");
		first = [];
		second = [];
		third = [];
		for(item : items) {
			ok = true;
			for(w : words) {
				if(w != "" && !item.words.contains(w)) {
					ok = false;
					break;
				}
			}
			if(!ok)
				continue;
			t = item.title.lowercase();
			if(q != "" && t.starts(q))
				first.push_back(item);
			else if(q != "" && t.contains(q))
				second.push_back(item);
			else
				third.push_back(item);
			if(first.size() >= PALETTE_ROWS)
				break;
		}
		results = [];
		groups = [first, second, third];
		for(group : groups) {
			for(item : group) {
				if(results.size() >= PALETTE_ROWS)
					break;
				results.push_back(item);
			}
		}
		selected = 0;
		show_rows();
	}

	show_rows() {
		for(row : rows)
			std.free(row);
		rows = [];
		for(i = 0; i < results.size(); i++) {
			item = results[i];
			row = list.widget_solid().background_color(i == selected ? PALETTE_COLOR_SELECTED : PALETTE_COLOR_SURFACE)
				.anchor_left(0).anchor_right(0).anchor_top(i * PALETTE_ROW_HEIGHT).fixed_height(PALETTE_ROW_HEIGHT - 2);
			row.label(item.title).font_size(15).anchor_left(10).anchor_right(240).anchor_top(5).fixed_height(20);
			row.label(item.hint).font_size(12).text_color(PALETTE_COLOR_TEXT_2).alignment("right")
				.anchor_right(10).fixed_width(230).anchor_top(7).fixed_height(18);
			btn = row.button("").transparent(true).anchor(0);
			index = i;
			btn.on_click([this, index](){
				this.run(index);
			});
			rows.push_back(row);
		}
		list_h = results.size() * PALETTE_ROW_HEIGHT;
		list.fixed_height(list_h);
		h = PALETTE_INPUT_HEIGHT + 12 + list_h + PALETTE_PAD;
		window.fixed_size(vec2f(PALETTE_WIDTH, h));
		window.size(vec2f(PALETTE_WIDTH, h));
	}
}
