

STYLE_FILE = "engine/style.json";

//Autosave: the open project is written here every few minutes (Settings > Project). Outside projects/, so it is no
//project of the list. A save of the project and a normal exit remove it: one that is still there at start up means
//VibeVJ did not close properly, and the start up offers to restore it
AUTOSAVE_DIR = "autosave";
AUTOSAVE_MINUTES = [0, 1, 2, 5, 10]; //the choices in the settings, 0 is off
AUTOSAVE_DEFAULT = 5;
