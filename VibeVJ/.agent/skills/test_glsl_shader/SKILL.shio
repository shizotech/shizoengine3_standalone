
import nanogui;

using eigen;

shadertoy_header = "precision highp float; uniform vec3 iResolution;  uniform float iTime;  uniform float iTimeDelta; uniform int iFrame; uniform vec4 iMouse; uniform vec4 iDate; uniform float iSampleRate; uniform sampler2D iChannel0; uniform sampler2D iChannel1; uniform sampler2D iChannel2; uniform sampler2D iChannel3; uniform int RenderMaskActive; uniform sampler2D RenderMaskInput;";

shadertoy_main = "void main(){ vec4 new_color = vec4(0,0,0,0); vec2 n_coord = v_uv*iResolution.xy; if(RenderMaskActive == 1) { vec4 mask_color = texture(RenderMaskInput, v_uv); if(mask_color.rgb == vec3(0.0)) { fragColor = new_color; return; }} mainImage( new_color, n_coord ); fragColor = new_color;}";

test_shader(path) {
	
	if(!fileio.is_file(path)) {
		return [
			ok = false,
			error = "Path is not a file.",
		];
	}
	
	if(!fileio.exists(path)) {
		return [
			ok = false,
			error = "File not found.",
		];
	}
	
	full_shader = shadertoy_header + "\n" + fileio.read_string(path).replace("\r","") + shadertoy_main;
	
	resolve_includes = None;
	resolve_includes = [&resolve_includes](wd, path) {
		shader_src = fileio.read_string(wd + "/" + path);
		shader_lines = shader_src.split("\n");
		shader_src = "";
		for(i = 0; i < shader_lines.size(); i++) {
			if(shader_lines[i].starts("#include"))
				include_file = shader_lines[i].removeprefix("#include").strip().extract_quotes();
				include_file = wd + "/" + include_file;
				if(fileio.exists(include_file))
					shader_src += resolve_includes(fileio.file_dir(include_file), fileio.file_name(include_file)).strip();
				else
					std.error("Cannot read include file: " + include_file);
				continue;
			shader_src += shader_lines[i] + "\n";
		}
		return shader_src;
	};
	
	if(full_shader.find("#include") >= 0) {
		include_file = path;
		full_shader = resolve_includes(fileio.file_dir(include_file), fileio.file_name(include_file)).strip();
	}
	
	ctx = nanogui.current_context() ? nanogui.current_context() : nanogui.context();
	scr = nanogui.current_screen() ? nanogui.current_screen() : ctx.screen();
	managed cnt = scr.widget().anchor(0);
	managed shader = cnt.shader().anchor(0);
	shader.render_size(vec2i(128,128));
	shader.fragment_source(full_shader);
	shader.compile();
	
	full_shader_lines = full_shader.split("\n");
	
	full_shader = "";
	
	for(i = 0; i < full_shader_lines.size(); i++)
		full_shader += (i+1) + "| " + full_shader_lines[i] + "\n";
	
	compile_error = shader.compile_error();
	
	if(compile_error.empty())
		compile_error = "No compile errors.";
		//full_shader = "<truncated>";
	
	return [final_shader_with_lines = full_shader, error = compile_error];
}

add_tools(agt)
{
	agt.add_tool(
		"compile_glsl_file",
		"Compile a glsl file to catch potential compilation errors.",
		[
			path = "&string(): Path to the .glsl file",
			//context = "&string(): Context for this action",
		],
		[](agt, args)
		{		
			return test_shader(args.path);
		}
	);
}