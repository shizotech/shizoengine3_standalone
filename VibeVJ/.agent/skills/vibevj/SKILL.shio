
add_tools(agt)
{

	//PushFocus() PopFocus() FocusStack() ? So agent can investigate generators recursively?

	//Also add search and list_capabilities later...
	agt.add_tool(
		"vibevj_get_focus",
		"Returns the last generator that the user has clicked on.",
		None,
		[](agt, args)
		{		
			item = std.global("engine").ai_last_item;
			if(!item) {
				return [
					ok = false,
					status = "No item focused.",
				];
			}
			
			result = [type = std.string(item.target)];	
			src_file = item.query("get_source_file");
			if(src_file)
				result.source_file = src_file;
			status = item.query("get_target_status");
			if(status)
				result.status = status;
			
			result.actions = [];
			
			for(i = 0; i < item.queries.size(); i++) {
				result.actions.push_back([
					action=item.queries.key(i),
					args=item.queries[i].args,
					description=item.queries[i].description,
				]);
			}

			return result;
		}
	);
	
	agt.add_tool(
		"vibevj_query",
		"Query information and set properties of the currently focused generator.",
		[
			action = "&string(): The name of the action to execute.",
			args = "&any(): Arguments for the action",
		],
		[](agt, args)
		{		
			item = std.global("engine").ai_last_item;
			if(!item) {
				return [
					ok = false,
					status = "No item focused.",
				];
			}
			
			return item.query(args.action, args.args);
		}
	);
}
	