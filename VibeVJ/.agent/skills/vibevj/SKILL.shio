
import nanogui;

using eigen;

shadertoy_header = "precision highp float; uniform vec3 iResolution;  uniform float iTime;  uniform float iTimeDelta; uniform int iFrame; uniform vec4 iMouse; uniform vec4 iDate; uniform float iSampleRate; uniform sampler2D iChannel0; uniform sampler2D iChannel1; uniform sampler2D iChannel2; uniform sampler2D iChannel3; uniform int RenderMaskActive; uniform sampler2D RenderMaskInput;";

shadertoy_main = "void main(){ vec4 new_color = vec4(0,0,0,0); vec2 n_coord = v_uv*iResolution.xy; if(RenderMaskActive == 1) { vec4 mask_color = texture(RenderMaskInput, v_uv); if(mask_color.rgb == vec3(0.0)) { fragColor = new_color; return; }} mainImage( new_color, n_coord ); fragColor = new_color;}";

sanitize_focus_path(focus_path) {
	tmp = focus_path.copy();
	tmp.remove_all_keys("interface");
	return tmp;
}

add_tools(agt)
{

	//PushFocus() PopFocus() FocusStack() ? So agent can investigate generators recursively?

	//Also add search and list_capabilities later...
	agt.add_tool(
		"vibevj_get_focus",
		"Returns the current focus path or the last generator that the user has clicked on.",
		None,
		[](agt, args)
		{		
			interface = None;
			
			try {
				if(!agt.env.focus_path) {	
				
					engine = std.global("engine");
					interface = engine.ai_last_interface;
					
					if(!interface) {
						if(!engine.main_generator_view.item) {
							engine.main_generator_view.add_generator(engine.main_generator_view.area, "engine/assets/singleview.asset");
						}
						
						interface = engine.main_generator_view.item.ai_interface;
					}
					
					parent_list = [[interface=interface, file_path=interface.target.get_relative_path(), live_path=interface.target.get_live_path(), type = std.string(interface.target)]];
					
					inode = interface.target.node.parent_node();
					
					for(inode) {
						generator = inode.attr.generator;
						if(generator)
							parent_list.insert(0, [
								interface = generator.ai_interface,
								file_path = generator.get_relative_path(), 
								live_path = generator.get_live_path(),
								type = std.string(generator),
							]);
						inode = inode.parent_node();
					}
					
					agt.env.focus_path = parent_list;
				}
				else
					interface = agt.env.focus_path[-1].interface;
				
				sanitized_focus_path = sanitize_focus_path(agt.env.focus_path);
				result = [focus_path=sanitized_focus_path];	
				src_file = interface.query("get_source_file", None, "chat");
				if(src_file.ok && src_file.value)
					result.source_file = src_file.value;
				status = interface.query("get_target_status", None, "chat");
				if(status.ok && status.value)
					result.status = status.value;
				
				result.actions = [];
				
				queries = interface.list_queries();
				for(i = 0; i < queries.size(); i++) {
					result.actions.push_back([
						action=queries[i].name,
						args=queries[i].args,
						description=queries[i].description,
					]);
				}

				return result;
			}
			catch(e) {
				std.print("BROKEN FOCUS PATH!");
				std.print(agt.env.focus_path);
				agt.env.focus_path = [];
				std.print("RESET FOCUS PATH!");
			}
		}
	);
	
	agt.add_tool(
		"vibevj_query",
		"Query information and set properties of the currently focused generator.",
		[
			action = "&string(): The name of the action to execute.",
			args = "&any(): Arguments for the action",
		],
		[](agt, args)
		{		
			interface = None;
			
			if(!agt.env.focus_path) {	
			
				engine = std.global("engine");
				interface = engine.ai_last_interface;
				
				if(!interface) {
					if(!engine.main_generator_view.item) {
						engine.main_generator_view.add_generator(engine.main_generator_view.area, "engine/assets/singleview.asset");
					}
					
					interface = engine.main_generator_view.item.ai_interface;
				}
				
				parent_list = [[interface=interface, file_path=interface.target.get_relative_path(), live_path=interface.target.get_live_path(), type = std.string(interface.target)]];
				
				inode = interface.target.node.parent_node();
				
				for(inode) {
					generator = inode.attr.generator;
					if(generator)
						parent_list.insert(0, [
							interface = generator.ai_interface,
							file_path = generator.get_relative_path(), 
							live_path = generator.get_live_path(),
							type = std.string(generator),
						]);
					inode = inode.parent_node();
				}
				
				agt.env.focus_path = parent_list;
			}
			else
				interface = agt.env.focus_path[-1].interface;
			
			if(!interface) {
				std.print(agt.env.focus_path);
				return [
					ok = false,
					status = "No item focused.",
				];
			}
			
			//[ok = true, value = ...] or [ok = false, error = "..."] (see engine/interfaces/aiinterface.shio)
			return interface.query(args.action, args.args, "chat");
		}
	);
	
	agt.add_tool(
		"vibevj_push_focus",
		"Focus on another generator.",
		[
			live_path = "&string(): The live path to the generator to focus on.",
		],
		[](agt, args)
		{		
			if(!agt.env.focus_path)
				agt.env.focus_path = [];
		
			node = nanogui.current_context().get_modmatrix_node_by_path(args.live_path);
			
			if(!node) {
				return [
					ok=false,
					error="The generator live path does not exist.",
				];
			}
			
			generator = node.attr.generator;
			
			if(agt.env.focus_path && agt.env.focus_path[-1].interface == generator.ai_interface) {
				return [
					ok=false,
					error="The generator is already focused.",
				];
			}
			
			agt.env.focus_path.push_back([interface=generator.ai_interface, file_path=generator.get_relative_path(), live_path=args.live_path, type = std.string(generator)]);
						
			sanitized_focus_path = sanitize_focus_path(agt.env.focus_path);
			return sanitized_focus_path;
		}
	);
	
	agt.add_tool(
		"vibevj_pop_focus",
		"Go back to the previous focused generator",
		None,
		[](agt, args)
		{		
			ctx = nanogui.current_context();
			
			if(agt.env.focus_path && agt.env.focus_path.size() > 1)
				agt.env.focus_path.pop_back();
			else {
				return [
					ok = false,
					error = "Cannot pop first entry!",
				];
			}
			
			sanitized_focus_path = sanitize_focus_path(agt.env.focus_path);
			return sanitized_focus_path;
		}
	);
	
	//The fixture setup is no generator: its queries are on engine.patch_ai (engine/patch/patch_ai.shio), the same ones the
	//MCP server serves with the live_path "fixture_setup"
	agt.add_tool(
		"vibevj_fixture_setup",
		"Work on the fixture setup (the patch): the lamps with their Art-Net node, universe, DMX address and place on the stage plan, groups (the order of a Phaser), nodes added by IP, and DMX channels that two senders (lamps, LEDMapper segments) write. Call it with action 'list_queries' to see every action with its arguments. Actions: list_fixtures, list_fixture_types, add_fixtures, set_fixture, address_fixtures, arrange_fixtures, remove_fixtures, list_fixture_groups, add_fixture_group, set_fixture_group, remove_fixture_group, list_artnet_nodes, add_artnet_node, remove_artnet_node, get_dmx_universe, get_dmx_conflicts, highlight_fixtures, set_fixture_test (hold lamps at values to test them), clear_fixture_test, get_fixture_values, set_fixture_values (keep values for good).",
		[
			action = "&string(): The action (list_queries lists them with their arguments).",
			args = "any(): Arguments of the action as a JSON object (not a string).",
		],
		[](agt, args)
		{
			interface = std.global("engine").patch_ai;
			if(!interface)
				return [ok = false, error = "The fixture setup is not available."];
			if(args.action == "list_queries")
				return [ok = true, value = interface.list_queries()];
			//[ok = true, value = ...] or [ok = false, error = "..."] (see engine/interfaces/aiinterface.shio)
			return interface.query(args.action, args.geti("args"), "chat");
		}
	);

	//The lighting desk is no generator either: engine.desk.ai (engine/patch/desk_runtime.shio), live_path "desk" over MCP
	agt.add_tool(
		"vibevj_desk",
		"The lighting desk (#719): programmer, palettes, cue stacks and executors over every lamp of the fixture setup, the virtual ones too (MapLab slices: ProjectionZone with Dimmer, Colour, Pan, Tilt, Zoom, Rotate, Strobe; shaders: Look lamps read with LampValues). Actions: desk_command (args.command: a command line as a lighting operator types it, e.g. 'group \"Front pars\" at 50', 'all at color red', 'palette 2', 'store cue 3 fade 2', 'go stack Main', 'off', 'clear', 'store cue 4 name Drop starts phrase', 'phrases match' (DJ Link: each new phrase of the DJ plays the cue named like it, no agent needed), 'music phrase Drop' (tries it without CDJs); 'help' lists them), get_desk_state (palettes, stacks with their cues, what plays), get_lamp_values (args.fixtures: lamps; what their controls have now).",
		[
			action = "&string(): desk_command, get_desk_state or get_lamp_values (list_queries lists them with their arguments).",
			args = "any(): Arguments of the action as a JSON object (not a string).",
		],
		[](agt, args)
		{
			desk = std.global("engine").desk;
			if(!desk || !desk.ai)
				return [ok = false, error = "The lighting desk is not available."];
			if(args.action == "list_queries")
				return [ok = true, value = desk.ai.list_queries()];
			return desk.ai.query(args.action, args.geti("args"), "chat");
		}
	);

	agt.add_tool(
		"vibevj_link_controls",
		"Link two controls (ctrl_source -> ctrl_target) using their **full_path**.\nYou need to obtain both controls **full_path** first by inspecting them.",
		[
			full_path_source = "&string(): The full path of the source control.",
			full_path_target = "&string(): The full path of the target control.",
			link_type = ["normalized", "absolute", "inverted_normalized"],
		],
		[](agt, args)
		{		
			ctx = nanogui.current_context();
				
			local_ctrl = ctx.get_control_by_path(args.full_path_source);
			other_ctrl = ctx.get_control_by_path(args.full_path_target);
			
			if(local_ctrl && other_ctrl) {
				local_ctrl.link_to(other_ctrl, args.link_type);
				return [
					ok = 1,
				];
			}	
			
			return [
				ok = 0,
				error = "One of the controls was not found. Make sure to use the right **full_path** obtained by the **get_local_control** query of a generator.",
			];
		}
	);		
	
	agt.add_tool(
		"vibevj_unlink_controls",
		"Unlink two controls (ctrl_source -> ctrl_target) using their **full_path**.\nYou need to obtain both controls **full_path** first by inspecting them.",
		[
			full_path_source = "&string(): The full path of the source control.",
			full_path_target = "&string(): The full path of the target control.",
		],
		[](agt, args)
		{		
			ctx = nanogui.current_context();
				
			local_ctrl = ctx.get_control_by_path(args.full_path_source);
			other_ctrl = ctx.get_control_by_path(args.full_path_target);
			
			if(local_ctrl && other_ctrl) {
				local_ctrl.unlink_from(other_ctrl);
				return [
					ok = 1,
				];
			}	
			
			return [
				ok = 0,
				error = "One of the controls was not found. Make sure to use the right **full_path** obtained by the **get_local_control** query of a generator.",
			];
		}
	);		
	
	agt.add_tool(
		"vibevj_remove_generator",
		"DANGEROUS: Remove a specific generator by its exact path.",
		[
			live_path = "&string(): The live path to the generator to focus on.",
		],
		[](agt, args)
		{		
			node = nanogui.current_context().get_modmatrix_node_by_path(args.live_path);
			
			if(!node) {
				return [
					ok=false,
					error="The generator live path does not exist.",
				];
			}
			
			generator = node.attr.generator;
			
			if(generator.on_close)
				generator.on_close();
			else
				std.free(generator);
			
			//Potentially fix focuspath...
			for(i = 0; i < agt.env.focus_path.size(); i++) {
				if(!agt.env.focus_path[i].interface) {
					agt.env.focus_path.erase(i);
					i--;
				}
			}
			
			return [
				ok = true,
				status = "Removed generator",
			];
		}
	);
	
	//The pictures come from engine.ai_capture (engine/interfaces/ai_capture.shio), the same ones the MCP server serves
	agt.add_tool(
		"vibevj_capture",
		"Capture a screenshot to inspect it visually.\nWithout 'live_path': the whole screen. With 'live_path': the window of that generator with its controls; with 'picture' 1 only its picture (a Camera: what the camera sees).",
		[
			live_path = "string(): OPTIONAL The live path of the generator.",
			picture = "int(0,1): OPTIONAL 1 = only the picture of the generator, without its controls.",
			width = "int(64,4096): OPTIONAL Width of the image in pixels.",
		],
		[](agt, args)
		{
			try {
				shot = std.global("engine").ai_capture.capture(args.geti("live_path"), args.geti("picture") ? true : false, args.geti("width"));
				return agt.inject_visual_prompt(fileio.read_file(shot.path), "png", "Here is the requested image: the " + shot.what + " (" + shot.width + " x " + shot.height + " pixels).");
			}
			catch(e) {
				return [ok = false, error = std.string(e)];
			}
		}
	);

	agt.add_tool(
		"vibevj_list_cameras",
		"Lists the Camera generators (assets/Generators/Input/Camera.asset) with their live_path and what each shows (camera, picture, size). Their queries list_cameras and set_camera pick the camera.",
		None,
		[](agt, args)
		{
			return [cameras = std.global("engine").ai_capture.cameras()];
		}
	);

	agt.add_tool(
		"vibevj_camera_capture",
		"Look through a camera: the picture of a Camera generator. With 'fixtures' and 'values' the lamps are first held at test values (as the fixture setup action set_fixture_test) and the picture is taken 'wait_ms' later, so you see what the lamps do. The lamps stay held until vibevj_fixture_setup action clear_fixture_test.",
		[
			live_path = "string(): OPTIONAL The live path of the Camera generator (default: the only one, vibevj_list_cameras).",
			fixtures = "array(string): OPTIONAL Lamps (ids or names) to set first.",
			values = "any(): OPTIONAL What the lamps send, an object: {\"dimmer\": 1, \"color\": [1, 0, 0], \"pan_degrees\": 270, \"tilt\": 0.5}.",
			dark_others = "int(0,1): OPTIONAL 1 holds every other lamp dark.",
			wait_ms = "int(0,10000): OPTIONAL Milliseconds between setting the lamps and the picture (default 600).",
			width = "int(64,4096): OPTIONAL Width of the image in pixels (default 1024).",
		],
		[](agt, args)
		{
			try {
				test = None;
				if(args.geti("fixtures"))
					test = [fixtures = args.fixtures, values = args.geti("values") ?? [], dark_others = args.geti("dark_others") ?? 0];
				shot = std.global("engine").ai_capture.camera_capture(args.geti("live_path"), test, args.geti("wait_ms"), args.geti("width") ?? 1024, "chat");
				prompt = "Here is the picture of the camera (" + shot.width + " x " + shot.height + " pixels)";
				if(shot.has("fixture_test")) {
					names = [];
					for(f : shot.fixture_test.fixtures)
						names.push_back(f.name);
					prompt += ", taken after " + names.combine_string(", ").removesuffix(", ") + " got the test values " + std.string(test.values);
					if(shot.fixture_test.has("blackout"))
						prompt += ". " + shot.fixture_test.blackout;
				}
				return agt.inject_visual_prompt(fileio.read_file(shot.path), "png", prompt + ".");
			}
			catch(e) {
				return [ok = false, error = std.string(e)];
			}
		}
	);

	agt.add_tool(
		"vibevj_get_testarea",
		"Returns a patchview generator that you can test new generators on.",
		None,
		[](agt, args)
		{		
			engine = std.global("engine");
			
			interface = agt.env.test_interface;
			
			if(!interface) {
				testbench = engine.menu.generators_menu.add_testbench("AI Testbench");
				
				item = testbench.add_generator(testbench.area, "assets/Views/Patchview.asset");
				
				interface = testbench.item.ai_interface;
				
				agt.env.testbench = testbench;
				agt.env.test_interface = interface;
			}				
			
			engine.ai_last_interface = interface;
			
			try {				
				parent_list = [[interface=interface, file_path=interface.target.get_relative_path(), live_path=interface.target.get_live_path(), type = std.string(interface.target)]];
				
				inode = interface.target.node.parent_node();
				
				for(inode) {
					generator = inode.attr.generator;
					if(generator)
						parent_list.insert(0, [
							interface = generator.ai_interface,
							file_path = generator.get_relative_path(), 
							live_path = generator.get_live_path(),
							type = std.string(generator),
						]);
					inode = inode.parent_node();
				}
				
				agt.env.focus_path = parent_list;
	
				sanitized_focus_path = sanitize_focus_path(agt.env.focus_path);
				result = [focus_path=sanitized_focus_path];	
				src_file = interface.query("get_source_file", None, "chat");
				if(src_file.ok && src_file.value)
					result.source_file = src_file.value;
				status = interface.query("get_target_status", None, "chat");
				if(status.ok && status.value)
					result.status = status.value;
				
				result.actions = [];
				
				queries = interface.list_queries();
				for(i = 0; i < queries.size(); i++) {
					result.actions.push_back([
						action=queries[i].name,
						args=queries[i].args,
						description=queries[i].description,
					]);
				}

				return result;
			}
			catch(e) {
				std.print("BROKEN FOCUS PATH!");
				std.print(agt.env.focus_path);
				agt.env.focus_path = [];
				std.print("RESET FOCUS PATH!");
			}
		}
	);
	
	agt.add_tool(
		"test_glsl_file",
		"Compile a glsl file to catch potential compilation errors.",
		[
			path = "&string(): Path to the .glsl file",
			//context = "&string(): Context for this action",
		],
		[](agt, args)
		{		
			path = args.path;
	
			if(!fileio.is_file(path)) {
				return [
					ok = false,
					error = "Path is not a file.",
				];
			}
			
			if(!fileio.exists(path)) {
				return [
					ok = false,
					error = "File not found.",
				];
			}
			
			full_shader = shadertoy_header + "\n" + fileio.read_string(path).replace("\r","") + shadertoy_main;
			
			resolve_includes = None;
			resolve_includes = [&resolve_includes](wd, path) {
				shader_src = fileio.read_string(wd + "/" + path);
				shader_lines = shader_src.split("\n");
				shader_src = "";
				for(i = 0; i < shader_lines.size(); i++) {
					if(shader_lines[i].starts("#include"))
						include_file = shader_lines[i].removeprefix("#include").strip().extract_quotes();
						include_file = wd + "/" + include_file;
						if(fileio.exists(include_file))
							shader_src += resolve_includes(fileio.file_dir(include_file), fileio.file_name(include_file)).strip();
						else
							std.error("Cannot read include file: " + include_file);
						continue;
					shader_src += shader_lines[i] + "\n";
				}
				return shader_src;
			};
			
			if(full_shader.find("#include") >= 0) {
				include_file = path;
				full_shader = resolve_includes(fileio.file_dir(include_file), fileio.file_name(include_file)).strip();
			}
			
			ctx = nanogui.current_context() ? nanogui.current_context() : nanogui.context();
			scr = nanogui.current_screen() ? nanogui.current_screen() : ctx.screen();
			managed cnt = scr.widget().anchor(0);
			managed shader = cnt.shader().anchor(0);
			shader.render_size(vec2i(128,128));
			shader.fragment_source(full_shader);
			shader.compile();
			
			full_shader_lines = full_shader.split("\n");
			
			full_shader = "";
			
			for(i = 0; i < full_shader_lines.size(); i++)
				full_shader += (i+1) + "| " + full_shader_lines[i] + "\n";
			
			compile_error = shader.compile_error();
			
			has_compile_errors = !compile_error.empty();
			
			if(compile_error.empty()) {
				compile_error = "No compile errors.";
			}
					
			return [final_shader_with_lines = full_shader, error = compile_error];	
		}
	);
}
	