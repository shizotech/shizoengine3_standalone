
shzdocs.load_all_modules();

find_docs(path, compact) {
	res = shzdocs.get_namespace(path);
			
	if(res.found) {
		if(res.has("documentation"))
			res.erase("documentation");
		
		compact_fn_list = [];
		for(i = 0; i < res.members.functions.size(); i++) {
			compact_fn_list.push_back(res.members.functions.key(i));
		}
		res.members.functions = compact_fn_list;
		
		return res;
	}
	
	res = shzdocs.get_class(path);
	
	if(res.found) {
		if(res.has("documentation"))
			res.erase("documentation");
		if(compact) {
			compact_fn_list = [];
			for(i = 0; i < res.members.functions.size(); i++) {
				compact_fn_list.push_back(res.members.functions.key(i));
			}
			res.members.functions = compact_fn_list;
		}
		return res;
	}
	
	res = shzdocs.get_path(path);
	
	if(res.found) {
		if(res.has("documentation"))
			res.erase("documentation");
		if(res.has("owner_members"))
			res.erase("owner_members");
		return res;
	}

	return [
		found = false,
		status = "The requested path does not exist.",
	];
}

test2(agt, args)
{		
	res = [];
	if(std.is_json(args.paths)) {
		for(i = 0; i < args.paths.size(); i++) {
			res[args.paths[i]] = find_docs(args.paths[i], args.compact);
		}
	}
	else
		res[args.paths] = find_docs(args.paths, args.compact);
	return res;
}

test() {
	return test2(None, [paths=["std.thread.run"], compact=true]);
}

test();

std.input();