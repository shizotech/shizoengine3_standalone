#alias iChannel0 B

vec4 green(float x){
    return vec4(0.1 * (x-1.), 0.3*x*x, x*.05, 1);
}

vec4 blue(float x){
    return vec4(0, x*.2, x, 1);
}

void mainImage( out vec4 O, in vec2 U )
{
    vec2 r = iResolution.xy;
    vec2 uv = U/r;
    
    //O = green(pow(texture(iChannel0, uv).x, 1.));
	O = vec4(0);
    //Display FTs
    
    //Wave
    float wave = texture(iChannel0, vec2(uv.x, .5/r.y)).x;
    O += blue(abs(0.03/((wave - (uv.y-.5)*3.))));
    O = pow(O, vec4(1./2.2));
}