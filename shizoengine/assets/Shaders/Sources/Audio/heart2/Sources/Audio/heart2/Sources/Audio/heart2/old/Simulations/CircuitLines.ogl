#alias iChannel0 A
#alias iChannel1 MASK

#format float32

const float pi = 3.14159;
const uint k = 1103515245U;

// ==== Custom Uniform Controls ====
uniform float maskThreshold = [0.1, 0.0, 1.0];
uniform float spawnChance = [0.0006, 0.0, 0.01];
uniform float decay = [0.998, 0.9, 1.0];
uniform float rotationAmount = [0.5235, 0.0, 6.283]; // ~30 degrees default
uniform int rotationDirection = ["Clockwise", "Counter-clockwise"];
uniform float minStrength = [0.01, 0.0, 0.5];

vec3 hash(uvec3 x) {
    x = ((x >> 8U) ^ x.yzx) * 1103515245U;
    x = ((x >> 8U) ^ x.yzx) * 1103515245U;
    x = ((x >> 8U) ^ x.yzx) * 1103515245U;
    return vec3(x) * (1.0 / float(0xffffffffU));
}

mat2 rot(float a) {
    return mat2(cos(a), sin(a), -sin(a), cos(a));
}

float maskValue(vec2 uv) {
    return texture(iChannel1, uv).r;
}

bool isInMask(vec2 uv) {
    return maskValue(uv) > maskThreshold;
}

void mainImage(out vec4 O, vec2 U) {
    vec2 res = iResolution.xy;
    vec2 uv = U / res;
    vec3 h = hash(uvec3(U, iFrame));

    float mask = maskValue(uv);
    bool inMask = mask > maskThreshold;

    vec4 current = texelFetch(iChannel0, ivec2(U), 0);
    O = current;

    vec2 d = vec2(0.0);
    int dirCount = 0;

    // Detect incoming particles
    for (int i = 0; i < 6; i++) {
        float angle = pi * 2.0 * float(i) / 6.0;
        vec2 offset = round(rot(angle) * vec2(1.0, 0.0));
        vec4 n = texture(iChannel0, (U + offset) / res);
        if (n.xy == -offset) {
            dirCount++;
            d = offset;
        }
    }

    // Decay
    if (O.z > 0.0) {
        O.xy *= 0.0;
        O.z *= decay;
        if (O.z < minStrength) O = vec4(0);
    }

    // Spawn new particles
    if (inMask && h.x < spawnChance && O.z < minStrength) {
        int choice = int(floor(h.y * 6.0));  // 6 directions
        float angle = pi * 2.0 * float(choice) / 6.0;
        O.xy = round(vec2(1.0, 0.0) * rot(angle));
        O.z = 1.0;
    }

    // Propagation (must stay inside the mask)
    if (dirCount == 1 && inMask) {
        float sign = (rotationDirection == 0) ? 1.0 : -1.0;
        float finalAngle = rotationAmount * sign;

        // Try to rotate and move
        vec2 newDir = round(d * rot(finalAngle));
        vec2 newPos = (U + newDir) / res;

        // If the next position is out of bounds, reflect back
        if (!isInMask(newPos)) {
            newDir = -newDir;
            newPos = (U + newDir) / res;
        }

        if (isInMask(newPos)) {
            O.xy = newDir;
            O.z = 1.0;
        }
    }
}
