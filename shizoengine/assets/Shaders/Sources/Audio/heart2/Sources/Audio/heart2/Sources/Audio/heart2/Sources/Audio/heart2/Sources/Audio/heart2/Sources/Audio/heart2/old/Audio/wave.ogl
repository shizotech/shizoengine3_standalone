
#alias iChannel1 A
#format float32

const float pi = 3.14159256;
const float temporalBlend = 0.75;

// A few things you can try.

// https://soundcloud.com/ehrling/ehrling-sthlm-sunset
// https://soundcloud.com/3kliksphilip/under-the-pizza
// https://soundcloud.com/nyanara/for-a-moment-i-was-there-1?in=spacelady87/sets/various-ambient-chill-lt-dub
// https://soundcloud.com/symphonicsamples/cornfield-chase-hans-zimmer-midi-mockup
// https://soundcloud.com/dainumo/prokofiev-space-transmission-download-in-description 
// ^ This one is pretty cool at the start
// Default shadertoy tracks


float dft(float x)
{
    float c=0.,s=c;
    vec2 r = iResolution.xy;

    for(float i = 0.; i < 1.; i += 1./r.x){
    
        s += (sin(i * x * 2. * pi)
            * ((texture(iChannel0, vec2(i, 1)).x)*2.-1.)) / sqrt(r.x);
        c += (cos(i * x * 2. * pi) 
            * ((texture(iChannel0, vec2(i, 1)).x)*2.-1.)) / sqrt(r.x);
    }
    //return smoothstep(r.x / 30., r.x / 5., x)*20.;
    return max(0., length(vec2(s, c))
    *mix(log(x), sqrt(x)*pi/2., smoothstep(r.x / 30., r.x / 5., x))
    // This multiplication is SO weird, but it works to create a similar result to the builtin
    // And no, I cannot explain why it works.
    -0.025);//This subtraction is a nasty hack but it clears up the visualizer a ton
}

void mainImage( out vec4 O, in vec2 U )
{
    vec2 r = iResolution.xy;
    vec2 uv = U/r;
    
    if (int(U.y) > 3.) return;
    
    float wave = texture(iChannel0, vec2(uv.x, 1)).x * 2. - 1.;
    float fft = texture(iChannel0, vec2(uv.x, 0)).x;
    
    if (int(U.y) == 0){
        O.x = wave;
        // Waveform output bottom pixel row
    } else if (int(U.y) == 1) {
        O.x = texture(iChannel0, vec2(uv.x, 0)).x;
        // Shadertoy FFT output
    } else if (int(U.y) == 2) {
        O.x = mix(dft(U.x*.25), texture(iChannel1, uv).x, temporalBlend);
        // My DFT output
    }
}