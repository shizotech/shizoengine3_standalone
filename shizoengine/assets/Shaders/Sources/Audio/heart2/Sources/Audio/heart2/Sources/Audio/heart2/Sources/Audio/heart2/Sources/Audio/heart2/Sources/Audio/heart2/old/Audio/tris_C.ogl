#define PI 3.14159265359
#define SQ1_2 0.70710678118

#define FOV 7.

#alias iChannel0 B
#alias iChannel1 AUDIO

#define MAX_STEPS 100
#define EPS .0001
#define RENDER_DIST 5.

#define TOTAL_TIME 360.

// post processing step //

// simple hash function
float hash(vec2 uv) {
    float f = fract(sin(sin(dot(uv, vec2(.00912398, .00231233))) * 1e6) * 1e4);
    return f;
}

// 2d noise function (linear interpolation between hash of integer bounds)
float noise(vec2 uv) {
    vec2 fuv = floor(uv);
    vec4 cell0 = vec4(
        hash(fuv + vec2(0, 0)),
        hash(fuv + vec2(0, 1)),
        hash(fuv + vec2(1, 0)),
        hash(fuv + vec2(1, 1))
    );
    vec2 axis0 = mix(cell0.xz, cell0.yw, smoothstep(0., 1., fract(uv.y)));
    float val0 = mix(axis0.x, axis0.y, smoothstep(0., 1., fract(uv.x)));
    return val0;
}

// fractional brownian motion
float fbm(vec2 uv) {
    float f = 0.;
    float r = 1.;
    for (int i = 0; i < 4; ++i) {
        uv.x += iTime;
        f += noise((uv + 10.) * r) / (r *= 2.);
    }
    return f / (1. - 1. / r);
}

void mainImage (out vec4 fragColor, in vec2 fragCoord) {
    // get low, mid and high frequency values
    vec3 freq = vec3(texture(iChannel1, vec2(.1, .25)).x,
                 texture(iChannel1, vec2(.3, .25)).x,
                 texture(iChannel1, vec2(.8, .25)).x);
    
    // add glitches at specific moments during the song based on frequency intensity
    float glitchiness = smoothstep(20., 0., abs(iTime - 10.) - 5.) * 1. * freq.x;
    glitchiness += smoothstep(10., 0., abs(iTime - 55.)) * 1. * freq.z;
    glitchiness += smoothstep(40., 0., abs(iTime - 195.) - 30.) * 1. * freq.z;
    glitchiness += smoothstep(14., 0., abs(iTime - 335.)) * 2. * freq.z;
    glitchiness = smoothstep(.4, .7, glitchiness);
    
    // calculate coordinates
    vec2 uv = fragCoord/iResolution.xy;
    vec2 cell = floor(uv * 20. * iResolution.x / iResolution.y);
    
    // calculate displacemet glitches
    float glitch1 = step(fbm(cell * vec2(.02, .2)), .6);
    vec2 glitch2 = vec2(fbm(vec2(iTime * 200.)), fbm(vec2(200. + iTime * 200.)));
	vec2 glitches = (glitch2 - .5) * .1 + vec2(glitch1, 0) * .02;
    vec4 tex = texture(iChannel0, uv + glitches * glitchiness);
    
    // calculate noise glitces
    float glitchHash = step(fbm(cell.yx * vec2(.01, .7)), .4) * glitchiness;
    
    // add everything up
    fragColor = tex + hash(uv * 100. + iTime) * .2 * glitchHash;
	fragColor.a = 1.0;
}