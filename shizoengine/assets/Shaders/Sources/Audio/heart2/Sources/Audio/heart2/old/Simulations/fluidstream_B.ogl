#format float32
#alias iChannel0 A

#include fluidstream_shared.ogl

uniform float SpawnX1 = [0.8,0,1];
uniform float SpawnY1 = [0.9,0,1];
uniform float SpawnSize1 = [10,0,100];
uniform float SpawnDir1 = [0.666,0,1];
uniform float SpawnSway1 = [0.1,0,1];

uniform float SpawnX2 = [0.2,0,1];
uniform float SpawnY2 = [0.9,0,1];
uniform float SpawnSize2 = [10,0,100];
uniform float SpawnDir2 = [0.8,0,1];
uniform float SpawnSway2 = [0.1,0,1];

uniform float Speed = [1,0,10];
uniform float SwaySpeed = [1,0,10];
uniform float BorderW = [5,0,50];

void mainImage( out vec4 U, in vec2 pos )
{
    R = iResolution.xy; time = iTime; Mouse = iMouse;
    ivec2 p = ivec2(pos);
        
    vec4 data = texel(ch0, pos); 
    
    particle P = getParticle(data, pos);
    
    
    if(P.M.x != 0.) //not vacuum
    {
        Simulation(ch0, P, pos, Speed, BorderW);
    }
    
    if(length(P.X - R*vec2(SpawnX1, SpawnY1)) < SpawnSize1) 
    {
        P.X = pos;
        P.V = 0.5*Dir(PI*SpawnDir1*2 + SpawnSway1*sin(0.4*time*SwaySpeed)*PI);
        P.M = mix(P.M, vec2(fluid_rho, 1.), 0.4);
    }

    if(length(P.X - R*vec2(SpawnX2, SpawnY2)) < SpawnSize2) 
    {
        P.X = pos;
        P.V = 0.5*Dir(PI*SpawnDir2*2 + SpawnSway2*sin(0.4*time*SwaySpeed)*PI);
        P.M = mix(P.M, vec2(fluid_rho, 0.), 0.4);
    }
    
    U = saveParticle(P, pos);
}