
#format float32

#alias iChannel0 A

#include "lavalamp_shared.ogl"


//
// This shader demonstrates signed distance fields in 2 dimensions,
// doing a distance test against two wandering circles, and using that
// value to interpolate between "inside" and "outside" colors.
// We use a smooth-min (polynomial) function to create a "metaball" effect.
//

#define VIEW_DISTANCE_GRADIENT
#define MOUSE_ADDS_OIL
//#define MOUSE_SUBTRACTS_OIL
#define MOUSE_REPELS_OIL

uniform float radii_mult = [1.0,0,2];
uniform float blob_dist = [0.08,0,2];

vec3 Color_a = vec3(0.0, 0.0, 0.0);
vec3 Color_b = 1.0 * vec3(1.0, 1.0, 1.0);

#define NUM_SITES 15

vec2 fbm_warp(vec2 uv, vec2 warp_uvs, float strength)
{
    float zspeed = 0.35;
    float aspect_ratio = iResolution.x / iResolution.y;
    float x = 2.0 * fbm(vec3(warp_uvs, 1.0 + iTime * zspeed)) - 1.0;
    float y = aspect_ratio * (2.0 * fbm(vec3(warp_uvs, 0.5 + iTime * zspeed)) - 1.0);
    
    return uv + strength * vec2(x, y);
}

void mainImage( out vec4 fragColor, in vec2 fragCoord )
{
	vec2 uv = fragCoord.xy / iResolution.xy;
    float aspect_ratio = iResolution.x / iResolution.y;

#ifdef LAYER_2
    vec2 warp_uvs = 4.0 * uv + vec2(0.0, iTime * 0.06);
    
    float warp_strength = 0.1;
    uv = fbm_warp(uv, warp_uvs, warp_strength);
#endif
    
    
    vec2 sites[NUM_SITES];
    float radii[NUM_SITES];
    for(int i = 0; i < NUM_SITES; i++)
    {
        float a = float(i) / float(NUM_SITES);
        vec2 base = vec2(
            bad_random(14.7654 * a + 174.24),
            bad_random(81.9414 * a + 25.123)
        );

        float fx = mix(0.05, 0.25, bad_random(10.0 + a));
		float fy = mix(0.04, 0.22, bad_random(20.0 + a));

		float px = 6.28318 * bad_random(30.0 + a);
		float py = 6.28318 * bad_random(40.0 + a);

		vec2 drift = vec2(
			sin(iTime * fx + px),
			cos(iTime * fy + py)
		) * 0.18;

        // lava convection bias (NEW)
        vec2 flow = lava_bias(base + drift, iTime);

        // IMPORTANT: keep randomness dominant
        sites[i] = base + drift + flow * 0.15;
        
        
#if defined MOUSE_REPELS_OIL
        //repel the site from the cursor
        vec2 m = iMouse.xy / iResolution.xy;
        float mouse_dist = dist_squared_circle(sites[i], m, 0.1, aspect_ratio);
        vec2 repel_dir = normalize(sites[i] - m);
        float repel_radius = 0.2;
        float repel_strength = 1.0 - mouse_dist - repel_radius;
        repel_strength = clamp(repel_strength, 0.0, 0.18);
        sites[i] += repel_strength * repel_dir;
#endif
        
        radii[i] = mix(0.055, 0.09, bad_random(762.01 * a + 23.765)) * radii_mult;
    }
    
    float focus_level = 0.0;

    //random defocusing synced w/ spikes - this needs to be synced w/ Buf C
    focus_level = texture(iChannel2, vec2(0.03 * iTime, 0.0)).r;
    focus_level = 0.35 * clamp((pow(focus_level, 1.25) - 0.18), 0.0, 1.0);
    if(iMouse.x < 0.01 || iMouse.y < 0.01) { focus_level = 0.0; }
    
#if defined LAYER_6
    //screen shake 
    vec2 screen_shake = focus_level * SCREEN_SHAKE_STRENGTH *
            vec2(texture(iChannel1, vec2(iTime * 1.0, 0.0)).x - 0.5,
                 texture(iChannel1, vec2(iTime * 1.0, 0.5)).x - 0.5);
    
    
    uv += screen_shake;
#endif //LAYER_6
    
#if defined MOUSE_ADDS_OIL
    sites[0] = iMouse.xy / iResolution.xy;
#if defined LAYER_6
    sites[0] -= 4.0 * screen_shake;
#endif //LAYER_6
    radii[0] = 0.15;
#endif
    
    float min_dist = 100.0;
    

    
    //first one is the mouse one - make it spiky!
  	float spikiness = 1.0;
    float d = dist_squared_circle(uv, sites[0], radii[0], aspect_ratio);;
#if defined LAYER_5
    spikiness = mix(0.0, 0.4, focus_level);
    
    d -= spikes(spikiness, iTime * 5.0, sites[0], uv, radii[0], aspect_ratio);
#endif //LAYER_5
    
    
	min_dist = d;
    
    
    for(int i = 1; i < NUM_SITES; i++)
    {
    	d = dist_squared_circle(uv, sites[i], radii[i], aspect_ratio);
#if defined LAYER_1
		min_dist = poly_smin(d, min_dist, blob_dist);
#else
        min_dist = min(d, min_dist);
#endif //LAYER_1
    }
    

    float height = 0.0;
    if(min_dist > 0.0)
    {
        height = 0.0;
    }
    else
    {
        float h = -min_dist;

        // softer interior fill (lava wax)
        height = smoothstep(-0.1, 0.1, h*1.1);
        height = pow(height, 3.3) * 2.0;
    }
    
#if defined MOUSE_SUBTRACTS_OIL
    //subtract from mouse
	vec2 v = (iMouse.xy / iResolution.xy - uv);
    v.x *= iResolution.x / iResolution.y;
    float mouse_d2 = 1.0 - 0.75 * pow(v.x * v.x + v.y * v.y, 1.0);
    mouse_d2 = 1.0 - clamp(mouse_d2, 0.0, 1.0);
   
    height = clamp(poly_smin(mouse_d2, height, 0.075), 0.0, 1.0);
#endif

    vec3 final_color = vec3(height, height, height);
    
	fragColor = vec4(final_color, 1.0);
}