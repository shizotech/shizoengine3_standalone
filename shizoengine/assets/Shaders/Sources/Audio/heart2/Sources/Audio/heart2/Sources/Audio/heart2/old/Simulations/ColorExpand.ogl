#format float32

#feedback 0
#alias iChannel1 MASK

uniform float chance = [0.05,0,1];

// https://www.shadertoy.com/view/4djSRW
vec4 hash43(vec3 p)
{
	vec4 p4 = fract(vec4(p.xyzx * iTime)  * vec4(.1031, .1030, .0973, .1099));
    p4 += dot(p4, p4.wzxy+33.33);
    return fract((p4.xxyz+p4.yzzw)*p4.zywx);
}
void test(inout vec4 id, ivec2 x)
{
    if (x == ivec2(0))
        return;
    if (id.w != 0.)
        return;
    vec4 next = texelFetch(iChannel0, x, 0);
    if (next.w == 0.)
        return;
    vec3 pos = vec3(x,iTime);
    vec4 blob = hash43(pos);
    if (blob.w > chance)
        return;
    vec3 delta = .1 * (blob.xyz - .5);
    id += vec4(clamp(next.xyz + delta, vec3(0), vec3(1)), 1.0);
}
void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
	vec2 uv = fragCoord.xy / iResolution.xy;
	vec4 in_mask = texture( iChannel1, uv );
	
    if (iFrame == 0 || iMouse.w == 1.0 || in_mask[0] != 0.0)
    {
        ivec2 xy = ivec2(fragCoord.xy) - ivec2(iMouse.xy);
        fragColor = vec4(0);
        if (xy == ivec2(0,0))
            fragColor = vec4(.5, .5, .5, 1);
        return;
    }
    ivec2 x = ivec2(fragCoord);
    if (x == ivec2(0))
    {
        fragColor = iMouse;
        return;
    }
    vec4 id = texelFetch(iChannel0, x, 0);
    test(id, x+ivec2(0, 1));
    test(id, x+ivec2(1, 0));
    test(id, x-ivec2(0, 1));
    test(id, x-ivec2(1, 0));
    fragColor = id;
    vec4 lastMouse = texelFetch(iChannel0, ivec2(0), 0);
    if (lastMouse.z >= .0 && iMouse.z < .0)
        if (length(fragCoord - abs(lastMouse.zw)) < length(lastMouse.xy - abs(lastMouse.zw)))
            fragColor = vec4(0);
}