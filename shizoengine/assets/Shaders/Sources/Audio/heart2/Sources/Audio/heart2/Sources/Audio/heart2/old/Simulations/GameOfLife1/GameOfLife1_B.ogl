#alias iChannel0 C
#alias iChannel1 Col1
#alias iChannel2 Col2
#format float32

#define T(i,j) texture(iChannel0, (uv + vec2(i,j)*vec2(1.0/R) )).r 
#define R iResolution.xy
#define steps 30.0

float snoise(in vec2 co){
    return fract(sin(dot(co.xy ,vec2(12.9898,78.233))) * 43758.5453)-.25;
}

vec3 hueShift( vec3 color, float hueAdjust ){

    const vec3  kRGBToYPrime = vec3 (0.299, 0.587, 0.114);
    const vec3  kRGBToI      = vec3 (0.596, -0.275, -0.321);
    const vec3  kRGBToQ      = vec3 (0.212, -0.523, 0.311);

    const vec3  kYIQToR     = vec3 (1.0, 0.956, 0.621);
    const vec3  kYIQToG     = vec3 (1.0, -0.272, -0.647);
    const vec3  kYIQToB     = vec3 (1.0, -1.107, 1.704);

    float   YPrime  = dot (color, kRGBToYPrime);
    float   I       = dot (color, kRGBToI);
    float   Q       = dot (color, kRGBToQ);
    float   hue     = atan (Q, I);
    float   chroma  = sqrt (I * I + Q * Q);

    hue += hueAdjust;

    Q = chroma * sin (hue);
    I = chroma * cos (hue);

    vec3    yIQ   = vec3 (YPrime, I, Q);

    return vec3( dot (yIQ, kYIQToR), dot (yIQ, kYIQToG), dot (yIQ, kYIQToB) );

}

vec2 rotate(vec2 v, float a) {
    //a *= float(iFrame)/100.0;
    //a *= 1400.0;
    a += float(iFrame)/100000.0;
    a *= 1300.0 + sin(float(iFrame)/100.0*1.0);
	float s = sin(a);
	float c = cos(a);
	mat2 m = mat2(c, -s, s, c);
	return m * v;
}

float G(vec2 uv, vec2 offset, float step){
    float roff = texture(iChannel2, uv).r*.005;//snoise(uv);
    offset = rotate(offset, roff+(float(step)/steps) * 1.7);
    offset += uv;

    return T(offset.x, offset.y);
}

void mainImage( out vec4 O, in vec2 c ){
	

    
    // retrieve the texture coordinate
    vec2 uv = c.xy / R;
    
    // get the current pixel
    float o = T(0, 0);
    
    for(int i=0;i<int(steps);++i){
    	
        // cross
        float s = float(i);
        float n =      G(uv, vec2(0, i), s)
           		 + G(uv, vec2(-i, 0), s) + G(uv, vec2(i, 0), s)
            		+ G(uv, vec2(0, -i), s);
        // x
        float x = G(uv, vec2(-i, i), -s) + G(uv, vec2(i, i),-s)
            	+ G(uv, vec2(-i, -i), -s)+ G(uv, vec2(i, -i), -s);
        
        float m = (steps-float(i))/steps;
        o += n * m;//pow(m, .9);
        o += x*m;//(x-.1) * pow(m, 1.2);
        
    }
    
    //vec4 lookup = texture(iChannel2, c/R) * vec4(o*.9);
    uv *= vec2(.4);
    vec4 lookup = texture(iChannel1, vec2(uv.x+(o*.1), uv.y));// * (vec4(1.0)+vec4(o*.5));
    lookup *= vec4(mod(o, 5.0));
    
    
    //lookup.rgb = hueShift( lookup.rgb, (o*.24)+2.2 );
    
    lookup.g *= .23;
    
    lookup.rgb = hueShift( lookup.rgb, (o*.33)+1.2 );
    
    lookup.rgb *= vec3(min(o, 1.3));
    
    
    
    O = lookup;
    //O = vec4(o, o-1.0, o-1.0*-o/100.0, 1.0);

        
        
    
}