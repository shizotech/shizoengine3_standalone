#define PI 3.14159265359
#define SQ1_2 0.70710678118

#define FOV 7.

#define MAX_STEPS 100
#define EPS .0001
#define RENDER_DIST 5.

#define TOTAL_TIME 360.

// edge detection step //

#alias iChannel0 A
#alias iChannel1 B

void mainImage (out vec4 fragColor, in vec2 fragCoord) {
    vec2 uv = fragCoord/iResolution.xy;
    vec4 tex = texture(iChannel0, uv);
    vec4 b = texture(iChannel1, uv);
    
    // radius to check around current point
    vec2 o = vec2(1, iResolution.x / iResolution.y) * .001;
	
    fragColor = vec4(0);
    
    // walk in a circle around the current pixel and check the neighborhood
    for (float t = 0.; t < 2. * PI; t += .125 * PI) {
        vec4 s = texture(iChannel0, uv + vec2(cos(t),sin(t)) * o);
        if (tex.w < RENDER_DIST) {
            if (abs(tex.w - s.w) > .04 || acos(dot(tex.xyz, s.xyz)) > .2) {
                // we're at the edge of a shape
                fragColor += vec4(.15);
            }
        } else {
            if (s.w < RENDER_DIST) {
                // we're at the edge of the geometry
                fragColor += vec4(.15);
            }
        }
    }
    
    // mix with previous frame, different color channels have
    // different weights for that sweet chromatic aberation feel
    fragColor = mix(fragColor, b, vec4(.96, .97, .98, 1.)); 
}