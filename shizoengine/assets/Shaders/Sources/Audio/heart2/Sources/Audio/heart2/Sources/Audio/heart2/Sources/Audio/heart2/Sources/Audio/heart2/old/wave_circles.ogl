#type src
#format float32

#include wave_circles_shared

vec4 get_pixel(vec2 uv)
{
	return texture(iChannel1, (uv.xy / iResolution.xy));
}

void mainImage( out vec4 O, vec2 u)
{
    updateBuffer(O, u, iResolution.xy, iFrame, iMouse, iChannel0, iChannel2, true); // true for last parameter => update state, emit waves
	
	if(get_pixel(u).r > 0.5)
	{
		 O.xy += initWave(u, u, iResolution.xy);
	}
}