#alias iChannel0 A
#alias iChannel1 C
#alias iChannel2 NOISE

void mainImage( out vec4 fragColor, in vec2 fragCoord )
{   
    vec2 uv = fragCoord.xy/iResolution.xy;
    
    vec4 dirtTex = texture(iChannel2, vec2(uv.x*iResolution.x/iResolution.y, uv.y)*1.5);
    float dirt = (dirtTex.x+dirtTex.y+dirtTex.z)/3.0;
    vec4 c = clamp(texture(iChannel0, uv),0.0, 1.0);
    vec4 glow = clamp(texture(iChannel1, uv),0.0, 1.0);
    
    float vign = length(uv - vec2(0.5));
    
	fragColor = c + glow + glow*dirt*dirt*dirt*vign*2.0;
}