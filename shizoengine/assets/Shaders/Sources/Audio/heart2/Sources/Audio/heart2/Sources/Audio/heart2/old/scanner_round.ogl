#ifdef GL_ES
precision mediump float;
#endif

#define PI 3.141592653589793
#define DIRECTION - 1.0

#define COLOR vec4(0.349, 0.8314, 0.5725, 1.0)
#define thickNess 5.0/iResolution.x




float drawLine(vec2 p, vec2 a, vec2 b) {
    vec2 coords = mix(a, b, clamp(distance(a, p) / distance(a, b), 0.0, 1.0));
    
    float d = distance(coords, p);
    
    d = 1.0 - thickNess + d;
    d = floor(d);
    d = clamp(d, 0.0, 1.0);
    d = 1.0 - d;
    
    return d;
}

vec2 normalizeCoords(vec2 uv) {
    vec2 p = uv / iResolution.xy * 2.0 - 1.0;
    p.x = p.x * iResolution.x / iResolution.y;
    return p;
}

// https://www.shadertoy.com/view/McVGDW
vec4 plotAxis(vec2 uv) {
    float xAxis = step(-thickNess, uv.y) * step(uv.y, thickNess);
    float yAxis = step(-thickNess, uv.x) * step(uv.x, thickNess);
    
    uv = abs(uv);
    
    for(int i = 0; i <= 10; ++ i) {
        xAxis = xAxis +
        step(float(i) * 0.1 - thickNess, uv.x) *
        step(uv.x, float(i) * 0.1 + thickNess) *
        step(uv.y, 0.01);
        
        yAxis = yAxis +
        step(float(i) * 0.1 - thickNess, uv.y) *
        step(uv.y, float(i) * 0.1 + thickNess) *
        step(uv.x, 0.01);
    }
    
    return vec4(vec3(xAxis + yAxis), 1.0);
}

// https://www.shadertoy.com/view/4fV3WW
vec4 line(vec2 uv, float linelength) {
    
    float stroke = 0.005;
    
    vec2 start = vec2(0.0, 0.0);
    vec2 end = vec2(cos(iTime), DIRECTION * sin(iTime)) * (linelength - stroke);
    
    float l = drawLine(uv, start, end);
    
    return COLOR * l;
}


vec4 scanLine(vec2 uv, float lineLength) {
    
    //mod will %, hence restricting angle between [0, 2*PI]
    // We are subtracting angle form by uv from iTime because we want to fade away
    // as we move away from main line
    float angle = mod(iTime - DIRECTION * atan(uv.y, uv.x), 2.0 * PI);
    
    // When angle > PI/2, return 0
    // When angle < 0, return 1;
    angle = smoothstep(PI / 2.0, 0.0, angle);
    
    // Restricting scan line inside circle
    // when length(uv) < lineLength => inside circle, return 1
    // when length(uv) > lineLength => outside circle, return 0;
    // 
    // step(length(uv), lineLength) = 1.0 - step(lineLength, length(uv))
    // We can invert the area by switching the variables inside step function
    //
    angle *= step(length(uv), lineLength) * 0.5;
    
    return COLOR * clamp(angle, 0.0, 1.0);
}

void mainImage( out vec4 fragColor, in vec2 fragCoord ) {
    vec2 uv = normalizeCoords(fragCoord.xy);
    
    float circle = step(length(uv), 1.0);
    
    vec4 finalColor = vec4(0.0);
    
    vec4 l = line(uv, 2.0);
    vec4 scan = scanLine(uv, 2.0);
    
    finalColor += l;
    finalColor += scan;
    
    //finalColor += clamp(vec4(circle - 0.9), 0.0, 1.0);
    
    fragColor = finalColor;
}