#alias iChannel0 A
#format float32

void mainImage( out vec4 O, in vec2 U )
{
    vec2 r = iResolution.xy;
    vec2 uv = U/r;
    
    float wave = texture(iChannel0, vec2(uv.x, 0)).x;
    float fft = texture(iChannel0, vec2(uv.x, 1.0/r.y)).x;
    float dft = texture(iChannel0, vec2(uv.x, 2.0/r.y)).x;

    O.x = mix(fft, 
        dft,
        //pow(abs((pow(dft, 0.25)-.25)-.1), 0.8), // this is if not using *x on return in dft function
        smoothstep(.55,.45, uv.y - wave/3.)
    );

    if (int(U.y) == 0) O = vec4(wave);
}