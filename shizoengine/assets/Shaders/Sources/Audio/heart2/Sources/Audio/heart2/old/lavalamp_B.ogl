
#format float32

#alias iChannel1 A

#include "lavalamp_shared.ogl"

uniform float norm_mult = [1,0,2];
uniform float glow_mult = [1,0,2];
uniform float final_mult = [1,0,2];

uniform vec3 base = [(0.08, 0.01, 0.8), (0,0,0), (1,1,1)];
uniform vec3 hot  = [(0.8, 0.4, 0.05),(0,0,0),(1,1,1)];

uniform float k = [2,0,10];
uniform float reflect_mult = [1,0,2];

void mainImage( out vec4 fragColor, in vec2 fragCoord )
{
    vec2 uv = fragCoord.xy / iResolution.xy;
    float aspect_ratio = iResolution.x / iResolution.y;
    vec4 distance = texture(iChannel1, uv);

    vec3 n = normal_from_height_map(uv, iChannel1) * norm_mult;
    
    // add in some fresnel internal glow
    // use the height field to apply this glow more where the
    // liquid is thin (height is close to zero).
    //
    // use a different color for the mouse blob
    //
    vec2 m_pos = iMouse.xy / iResolution.xy;
    float dm = -50.0 * dist_squared_circle(uv, m_pos, 0.2, aspect_ratio);
    dm = clamp(dm, 0.0, 1.0);
    
    float beat_str = 0.35;
    
    vec3 internal_color_a = 0.12 * vec3(0.88, 0.55, 0.15);
    vec3 internal_color_b = (0.15 + beat_str) * vec3(0.8, 1.0, 0.2);
    
    vec3 internal_color = mix(internal_color_a, internal_color_b, dm);
    
    float n_dot_v = dot(n, vec3(0.0, 0.0, 1.0));
    n_dot_v = 1.0 - pow(n_dot_v, 6.0);
    vec3 glow = internal_color * (1.0 - n_dot_v);
    
    vec3 final_color = vec3(0.0, 0.0, 0.0);
    final_color = final_color - 0.15 * texture(iChannel0, 0.2 * uv).rrr;
    if(distance.g > 0.01)
    {
        vec4 reflection = min(vec4(desaturate(fakeReflection(n).rgb), 1.0) * 1.0, vec4(0.999));
        vec4 spec = min(reflection * 2.0, vec4(1.0));

        reflection = vec4(pow(reflection.r, k),
                          pow(reflection.g, k),
                          pow(reflection.b, k), 1.0);
        
        vec3 glow_color = internal_glow(n);

        final_color = mix(base, hot, pow(uv.y,0.8));
        final_color = final_color + final_color * reflection.xyz * reflect_mult + pow(spec,vec4(10.0)).xyz * 0.1;
    	final_color = contrast(vec4(final_color,1.0), 3.5).rgb * final_mult + glow * glow_color * glow_mult;
    }
    
#if defined LAYER_4
    fragColor = vec4(final_color, 1.0);
#else
#if defined LAYER_3
    fragColor = vec4(n, 1.0);
#else
    fragColor = vec4(100.0 * distance.rgb, 1.0);
#endif // LAYER_3
#endif // LAYER_4
    //fragColor = vec4(fragCoord, 0.0, 1.0);
    

    //
    //fragColor = vec4(distance.rgb, 1.0);
}