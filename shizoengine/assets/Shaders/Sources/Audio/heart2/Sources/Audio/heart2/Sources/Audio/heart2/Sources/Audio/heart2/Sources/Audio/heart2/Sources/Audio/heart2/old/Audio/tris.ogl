#define PI 3.14159265359
#define SQ1_2 0.70710678118

#define FOV 7.

#define MAX_STEPS 100
#define EPS .0001
#define RENDER_DIST 5.

#define TOTAL_TIME 360.

// raymarching step //

// a bunch of constants to set up the place and directon of the cuts
const vec3 OFF_TOP_M_RIGHT = vec3(0, -.21,0);
const vec3 DIR_TOP_M_RIGHT = normalize(vec3(.2, -.14, -.1));
const vec3 OFF_TOP_M_LEFT = vec3(-.09, 0, 0);
const vec3 DIR_TOP_M_LEFT = normalize(vec3(.2, .075, 0));
const vec3 OFF_TOP_K = vec3(-.57, 0, 0);
const vec3 DIR_TOP_K = normalize(vec3(.1, -.2, -.1));
const vec3 OFF_BOT_K = vec3(-.57, 0, 0);
const vec3 DIR_BOT_K = normalize(vec3(-.1, -.2, .1));
const vec3 OFF_BOT_R = vec3(0, 0, -.17);
const vec3 DIR_BOT_R = normalize(vec3(.1, .18, .1));
// no, they aren't random
const vec3 OFF_A = vec3(.4, 0,0);
const vec3 DIR_A = normalize(vec3(.12, -.1, .1));
const vec3 OFF_I = vec3(.3, 0, 0);
const vec3 DIR_I = normalize(vec3(.1, 0, -.2));
const vec3 OFF_M_LEFT = vec3(-.169, 0, 0);
const vec3 DIR_M_LEFT = normalize(vec3(.1, 0, 0));
const vec3 OFF_R_RIGHT = vec3(0, 0, .21);
const vec3 DIR_R_RIGHT = normalize(vec3(.1, .18, .1));
const vec3 OFF_R_LEFT = vec3(0, 0, -.165);
const vec3 DIR_R_LEFT = normalize(vec3(.1, 0, .1));
// they're actually made to resemble the logo of the band

// the displacement amount
float _amount;

// rotate 2d space with given angle
void tRotate(inout vec2 p, float angel) {
    float s = sin(angel), c = cos(angel);
	p *= mat2(c, -s, s, c);
}

// union
float opU(float a, float b) {
    return min(a, b);
}

// intersection
float opI(float a, float b) {
    return max(a, b);
}

// substraction
float opS(float a, float b) {
    return max(a, -b);
}

// split down space along a plane with normal 'amount' a the point 'offset' and pull apart in two directions
// returns the signed distance to the split
float tStretch(inout vec3 p, vec3 offset, vec3 direction, float amount) {
    float s = dot(p -= offset, direction);
    p -= direction * clamp(s, -amount, amount) - offset;
    return abs(s) - amount;
}

// signed distance to a prism
float sdPrism(vec3 p) {
    float d = abs(p.y) - .1;
    d = opS(d, -p.z);
    d = opS(d, .4 + (p.z - abs(p.x)) * SQ1_2);
    return d;
}

// distance to the bottom prism
float sdTopPrism(vec3 p, float amount) {
    p -= clamp(amount, 0., .02) * vec3(0,1, 4);
    float cut = tStretch(p, OFF_TOP_M_RIGHT, DIR_TOP_M_RIGHT, amount);                      // M right
    cut = opU(cut, tStretch(p, OFF_TOP_M_LEFT, DIR_TOP_M_LEFT, amount));                    // M left
    cut = opU(cut, tStretch(p, OFF_TOP_K * (1.+amount * 3.), DIR_TOP_K, amount));           // K
    float d = sdPrism(p - vec3(0, .1 + amount, 0));
    return opS(d, cut);
}

// distance to the bottom prism
float sdBottomPrism(vec3 p, float amount) {
    float cut = tStretch(p, OFF_BOT_K * (1.+amount * 3.), DIR_BOT_K, amount);              // K
    cut = opU(cut, tStretch(p, OFF_BOT_R, DIR_BOT_R, amount));                             // R right
    float d = sdPrism(p + vec3(0, .1 + amount, 0));
    return opS(d, cut);
}

// distance estimation of everything together
float map(vec3 p) {
    p.z -= .2;
    float cut = tStretch(p, OFF_A, DIR_A, _amount);                                        // A
    cut = opU(cut, tStretch(p, OFF_I, DIR_I, _amount));                                    // I
    cut = opU(cut, tStretch(p, OFF_M_LEFT * (1. + _amount * 15.), DIR_M_LEFT, _amount));   // M
    cut = opU(cut, tStretch(p, OFF_R_RIGHT, DIR_R_RIGHT, _amount));                        // R right
    cut = opU(cut, tStretch(p, OFF_R_LEFT * (1. + _amount * 10.), DIR_R_LEFT, _amount));   // R left
    float d = opU(sdTopPrism(p, _amount), sdBottomPrism(p, _amount));
    return opS(d, cut);
}

// trace the scene from ro (origin) to rd (direction, normalized)
// until hit or reached maxDist, outputs distance traveled and the number of steps
float trace(vec3 ro, vec3 rd, float maxDist, out float steps) {
    float total = 0.;
    steps = 0.;
    
    for (int i = 0; i < MAX_STEPS; ++i) {
        ++steps;
        float d = map(ro + rd * total);
        total += d;
        if (d < EPS || maxDist < total) break;
    }
    
    return total;
}

// calculate the normal vector
vec3 getNormal(vec3 p) {
    vec2 e = vec2(.0001, 0);
    return normalize(vec3(
        map(p + e.xyy) - map(p - e.xyy),
        map(p + e.yxy) - map(p - e.yxy),
        map(p + e.yyx) - map(p - e.yyx)
	));
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    // transform screen coordinates
	vec2 uv = fragCoord.xy / iResolution.xy * 2. - 1.;
    uv.x *= iResolution.x / iResolution.y;
    
    // transform mouse coordinates
	vec2 mouse = iMouse.xy / iResolution.xy * 2. - 1.;
    mouse.x *= iResolution.x / iResolution.y;
    mouse *= 2.;
    
    // set up camera position
    vec3 ro =  vec3(0, 0, -3);
    vec3 rd = normalize(vec3(uv, FOV));
    
    // calculate animation progress
    float progress = smoothstep(TOTAL_TIME, -TOTAL_TIME * .3, iTime);
    _amount = .003 + progress * .3;
    
    // rotate the camera around the center
    vec2 rot = vec2(-progress * 8., .3 - progress * 2.);
    tRotate(rd.yz, rot.y);
    tRotate(rd.xz, rot.x);
    tRotate(ro.yz, rot.y);
    tRotate(ro.xz, rot.x);
    
    // march
    float steps, dist = trace(ro, rd, RENDER_DIST, steps); 
    
    // calculate hit point coordinates
    vec3 p = ro + rd * dist;
    
    // calculate normal
    vec3 normal = getNormal(p);
    
    // output of this buffer is the normal and the distance marched
    fragColor = vec4(normal, dist);
}