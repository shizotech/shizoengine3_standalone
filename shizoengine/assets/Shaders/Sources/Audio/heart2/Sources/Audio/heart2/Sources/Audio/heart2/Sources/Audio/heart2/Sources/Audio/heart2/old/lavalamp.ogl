
#alias iChannel0 C

#include "lavalamp_shared.ogl"

//
// Men can never be free, because they're weak, corrupt, worthless...
// and restless. The people believe in authority. They've grown tired of
// waiting for miracle or mystery. Science is their religion - no
// greater explanation exists for them! They must never believe
// any differently if the project is to go forward.
//

vec4 chromatic_aberration(vec2 uv, float strength, float aspect_ratio)
{
    vec2 eps = strength * vec2(aspect_ratio, 0.0);
    
    float r = texture(iChannel0, uv - eps).r;
    float g = texture(iChannel0, uv + vec2(0.0, -eps)).g;
    float b = texture(iChannel0, uv + eps).b;
    
    return vec4(r, g, b, 1.0);
}

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    vec2 uv = fragCoord.xy / iResolution.xy;
    float aspect_ratio = iResolution.x / iResolution.y;
    
    float blur_strength = 1.0;

#if defined LAYER_6
    float d2 = dist_squared_circle(uv, vec2(0.5, 0.5), 0.95, aspect_ratio);
    blur_strength = 0.012 * clamp(1.0 * (d2 + 0.65), 0.0, 1.0);
    //blur_strength = 1.5 * blur_strength * texture(iChannel1, 2.0 * uv).r;
    
    //random defocusing synced w/ spikes - this needs to be synced w/ Buf C
    float focus_level = texture(iChannel2, vec2(0.03 * iTime, 0.0)).r;
    focus_level = 0.04 * clamp((pow(focus_level, 1.25) - 0.18), 0.0, 1.0);
    if(iMouse.x < 0.01 || iMouse.y < 0.01) { focus_level = 0.0; }
    
    blur_strength = max(blur_strength, focus_level);
#endif // LAYER_6
    
    fragColor = chromatic_aberration(uv, blur_strength, aspect_ratio);
}