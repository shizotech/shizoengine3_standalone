/*
Recreation of "Electric Flower" by Henrik Rydgard: https://webglsamples.org/electricflower/electricflower.html
I have no idea how he actually achieved the effect but this is what I came up with.
*/

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    fragColor = texture(iChannel0, fragCoord / iResolution.xy);
}