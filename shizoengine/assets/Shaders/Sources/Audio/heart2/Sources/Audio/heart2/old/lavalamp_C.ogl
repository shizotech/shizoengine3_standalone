
#alias iChannel0 B

#include "lavalamp_shared.ogl"

float rand(vec2 co){
    return fract(sin(dot(co.xy ,vec2(12.9898,78.233))) * 43758.5453);
}

// from anastadunbar's gaussian blur demo
// https://www.shadertoy.com/view/4lXXWn
vec3 gaussian(vec2 uv, float bluramount)
{
    vec3 r_col = vec3(1.0, 0.5, 0.0);
    vec3 b_col = vec3(0.0, 0.5, 1.0);
    
    //float dists = 5.;
    vec3 blurred_image = vec3(0.);
    #define repeats 12.0
    for (float i = 0.; i < repeats; i++) { 
        //Older:
        //vec2 q = vec2(cos(degrees((grid(i,dists)/repeats)*360.)),sin(degrees((grid(i,dists)/repeats)*360.))) * (1./(1.+mod(i,dists)));
        vec2 q = vec2(cos(degrees((i/repeats)*360.0)),
              sin(degrees((i/repeats)*360.0)));

        q *= (rand(vec2(i, uv.x+uv.y)) + bluramount);

        // lava smear bias (IMPORTANT ADDITION)
        q.y += 0.6 * bluramount;
        
        vec2 uv2 = uv+(q * bluramount);
        blurred_image += texture(iChannel0,vec2(uv2.x,uv2.y)).rgb/2.;
        
        //One more to hide the noise.
        q = vec2(cos(degrees((i/repeats)*360.)),sin(degrees((i/repeats)*360.))) *  (rand(vec2(i+2.,uv.x+uv.y+24.))+bluramount); 
        uv2 = uv+(q*bluramount);
        blurred_image += texture(iChannel0,vec2(uv2.x,uv2.y)).rgb/2.;
    }
    blurred_image /= repeats;
    return blurred_image;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    vec2 uv = fragCoord.xy / iResolution.xy;
    float aspect_ratio = iResolution.x / iResolution.y;
    
    //random defocusing
    float focus_level = texture(iChannel1, vec2(0.03 * iTime, 0.0)).r;
    focus_level = 0.5 * clamp((pow(focus_level, 1.5) - 0.15), 0.0, 1.0);
    if(iMouse.x < 0.01 || iMouse.y < 0.01) { focus_level = 0.0; }
    
    vec2 eps = vec2(1.0 / iResolution.x, 0.0);
    float d2 = dist_squared_circle(uv, vec2(0.5, 0.5), 0.75, aspect_ratio);
    
    float mask_strength = 0.5;

#if defined LAYER_6
    mask_strength = clamp(40.0 * d2, 0.0, 1.0);
#endif // LAYER_6
    
    vec3 mask_color = vec3(1.0, 1.0, 1.0) * (1.0 - mask_strength);// * mix(vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 1.0), 10.0 * d2_dx);

    float blur_strength = 0.0;

#if defined LAYER_6
    blur_strength = 3.0 * focus_level + 0.25 * clamp(1.0 * (d2 + 0.4), 0.0, 1.0);
#endif // LAYER_6
    
    vec4 oil = vec4(gaussian(uv, 0.1 * blur_strength), 1.0);
    
    fragColor = oil;
}