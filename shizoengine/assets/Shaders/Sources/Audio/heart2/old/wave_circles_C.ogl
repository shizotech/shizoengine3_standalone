#type src
#format float32

// ---------------------------------------------------------------------------------------
//	Created by fenix in 2023
//	License Creative Commons Attribution-NonCommercial-ShareAlike 3.0 Unported License.
//
//  Inspired by this video by Nils Berglund:
//
//      https://www.youtube.com/watch?v=pN-gi_omIVE
//
//  Another wave equation shader! Here are some of my other ones if you like this one:
//
//      Wave Equation           https://shadertoy.com/view/csXfRS
//      Parabolic Reflectors    https://shadertoy.com/view/DdffzB
//      Courant Noise           https://shadertoy.com/view/cslBWX
//
//  This shader shows a wavefront refracting when hitting a medium boundary. The bottom
//  half has a slower speed of light/sound than the upper half. So the bottom might be
//  water or glass while the top is air. You can see in the waves evidence of total
//  internal refraction and the fresnel equations.
//
//  Here again the incomplete absorbtion of the boundary bedevils me. Definitely
//  interested in any ideas how to improve that.
// ---------------------------------------------------------------------------------------

vec4 getColorFromHeight(float d)
{
    vec4 c = sin(d * 6e2 * vec4(9, 2, 5, 0));
    return pow(abs(c), vec4(3));
}

void mainImage( out vec4 O, vec2 u )
{
    float wh = texelFetch(iChannel0, ivec2(u), 0).x; // wave height

    O = getColorFromHeight(wh); // colorize
	O.w = 1.0;
}
