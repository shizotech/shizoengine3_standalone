// ==== Custom Uniform Controls ====

uniform float circle_thickness = [0.004, 0.001, 0.02];
uniform float frame_thickness = [0.02, 0.001, 0.1];
uniform float distortion_amount = [0.2, 0.0, 1.0];
uniform float kaleido_warp = [0.05, 0.0, 0.2];
uniform float modulation_speed = [1.0, 0.0, 3.0];
uniform float color_intensity = [1.0, 0.0, 3.0];
uniform float audio_intensity = [1.0, 0.0, 3.0];
uniform float audio_centering = [1.0, 0.0, 1.0]; // 0: no centering, 1: center audio effect

// Slime Frame
// by leon denise
// 2024/12/23

mat2 rot (float a) { float c=cos(a),s=sin(a); return mat2(c,-s,s,c); }

float smin( float d1, float d2, float k ) {
    float h = clamp( 0.5 + 0.5*(d2-d1)/k, 0.0, 1.0 );
    return mix( d2, d1, h ) - k*h*(1.0-h);
}

float spectrum(float x) {
    return texture(iChannel0, vec2(x, 0.25)).r;
}

float map(vec2 p) {
    vec2 q = p;

    float d = 100.;
    float a = 1.;
    float t = 196. + iTime / (20. / modulation_speed);

    // Audio modulation
    float bass = spectrum(0.01) * audio_intensity;
    float mid = spectrum(0.2) * audio_intensity;
    float high = spectrum(0.5) * audio_intensity;

    // break symmetry
    vec2 symmetryOffset = vec2(iResolution.x / iResolution.y, 1.);
    if (audio_centering < 0.5) {
        p += symmetryOffset;
    } else {
        p += symmetryOffset * (1.0 - bass); // reduce offset with stronger bass
    }
    p *= 0.6 + 0.3 * bass;

    // kaleidoscopic circles
    for (float i = 0.; i < 5.; ++i) {
        p = abs(p) - a;
        float b = length(p);
        float warp = kaleido_warp + high * 0.05;
        p *= rot(t / a + sin(b * 5. / a) * warp / a);
        float distortion = distortion_amount + mid * 0.3;
        p *= 1. + distortion * sin(b * 4. / a + iTime * a + i * 3.) * a;
        d = smin(d, abs(b - 1. * a), 0.07);
        a /= 1.4;
    }

    // thickness
    d -= circle_thickness;

    // frame
    q = abs(q) - vec2(iResolution.x / iResolution.y, 1.);
    float box = abs(max(q.x, q.y));
    d = smin(d, box - frame_thickness, 0.2);

    return d;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    // coordinates
    vec2 uv = fragCoord.xy / iResolution.xy;
    vec2 p = (2. * fragCoord.xy - iResolution.xy) / iResolution.y;

    // distance
    float d = map(p);

    // normal
    vec2 e = vec2(0.002 + 0.02 * length(p), 0);
    vec3 n = -normalize(vec3(d - vec3(map(p + e.xy), map(p + e.yx), 0.)));

    // lighting
    #define N(x,y,z) normalize(vec3(x,y,z))
    vec3 color = vec3(0);
    color += pow(dot(n, N(0, 2, 0.5)) * 0.5 + 0.5, 20.);
    color += vec3(0.5, 1, 0.6) * pow(dot(n, N(0, -0.5, -2.)) * 0.5 + 0.5, 0.7);
    color *= smoothstep(0.001, 0.0, d);

    color *= color_intensity;

    fragColor = vec4(color, 1);
}
