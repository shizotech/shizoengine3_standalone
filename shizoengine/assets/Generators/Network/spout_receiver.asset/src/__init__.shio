
managed image = None;
managed selector = None;
managed connect_sender = None;

dispatcher(generator, cmd, value) {
	
}

entry(generator, area) {
	area.layout(None);
	
	control_tabs = area.vscroll().anchor_left(0).anchor_top(0).anchor_bottom(25).fixed_width(150)
		.content().layout(nanogui.layout_vertical());
	
	image = area.spout_receiver();
	
	image.anchor_left(150).anchor_top(0).anchor_bottom(25).anchor_right(0);
	
	selector = control_tabs.combobox("sender_select").items(["Select"]);
	connect_sender = control_tabs.controltext("connect_sender").value("");
		
	selector.on_open([](){	
		selector.items(["Select"] + image.senders());
	});
	
	selector.on_change([](v, text) {	
		if(v == 0)
			connect_sender.value("");
			return;
			
		connect_sender.value(text);
	});
	
	size_vec = control_tabs.controlvector("Size");
	width = size_vec.controlint("Width");
	height = size_vec.controlint("Height");
	
	output = control_tabs.control("OUT");
	output.value(image);
	output.callback([output](v){ output.value(image); }); 
	
	connect_sender.callback([width, height](v) {
		if(!v)
			image.disconnect();
			return;				
		if(v == image.sender_name())
			return;
		std.print("Connect to: ", v);
		image.connect(v);
		width.value(image.sender_width());
		height.value(image.sender_height());
	});
	
	image.disconnect();
}

save_state() {
	return [
		connect_sender = connect_sender.value(),
	];
}

load_state(state) {
	if(state.connect_sender)
		connect_sender.value(state.connect_sender);
}