
class artnet_menu {

	__init__(engine, parent) {

		enable_netsync = parent.controlbutton("ArtNetSync")
			.anchor_left(0).anchor_right(0)
			.push(1)
			.hide_config_menu();
				
		enable_netsync.callback([engine](v) {
			engine.net.artnet_sync(v);
		});
		
		enable_netsync.value(1);
		
		engine.net.on_connect([this, parent](dev){	
			if(dev.type() != "artnet")
				return;

			dev_menu = parent.collapsable(dev.name() + " [" + dev.mac() + "]").content().layout(nanogui.layout_vertical());
			open_dev = dev_menu.button("Show Device");
			ip_info = dev_menu.textbox(dev.ip()).editable(false).anchor_left(0).anchor_right(0);
			mac_info = dev_menu.textbox(dev.mac()).editable(false).anchor_left(0).anchor_right(0);
		});
	}
}