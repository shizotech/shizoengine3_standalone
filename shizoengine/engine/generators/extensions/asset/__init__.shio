
load_extension(generator) {
	
	load_path = generator.path;
	
	if(fileio.is_directory(load_path)) {
		if(fileio.exists(load_path + "/src/__init__.shio"))
			load_path += "/src/__init__.shio"
		else if(fileio.exists(load_path + "/__init__.shio"))
			load_path += "/__init__.shio";
		else
			std.error("Not a valid asset (no __init__.shio found)");
			return;
	}
	
	generator.module = std.module();
	generator.module.load_file(load_path);
	
	if(generator.module.has("entry"))
		generator.module.call("entry", generator, generator.node);

}