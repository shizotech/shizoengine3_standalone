
#include "engine/generators/clipstackview"

managed stack = None;

dispatcher(generator, cmd, value) {
		
	if(cmd == "active") {
		if(value && !generator.active_btn.value())
			return None;
		
		return stack.dispatch(cmd, value);
	}
	
	return stack.dispatch(cmd, value);
}

entry(generator, area) {
	
	area.layout(None);
	
	generator.window.fixed_size([1000,700]);
	
	stack = stackview(area);
}

save_state() {
	return stack.save_state();
}

load_state(state) {
	return stack.load_state(state);
}